                        if v.renewOpen || v.renewal!=nil {pool_renew_section := View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                            View{width:Fill height:Fit flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:12 padding:Inset{left:16 right:14 top:12 bottom:12} align:Align{y:0.5}
                                mod.widgets.HagencyListText{

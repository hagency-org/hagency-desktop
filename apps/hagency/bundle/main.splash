                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyRowIcon{draw_bg.color:if creatable {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_FIELD} mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.add draw_icon.color:if creatable {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyAccentText{text:A.t("New Template","新建模板") draw_text.color:if creatable {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}
                            mod.widgets.HagencyListSubtitle{text:if creatable {A.t("Name an Agent and its role ahead of time","提前设定 Agent 的名称和角色")} else if t.pending!=nil {A.t("Finish the change above first","请先处理上面等你确认的更改")} else {A.t("Not available for this pool right now","此资源池暂时不能新建")}}
                        }
                    }

        }}}
        if H.page=="pool_device" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let d=H.pool_device
            let device=A.pool_device_state(d.board,d.state)
            let steps=A.dev_setup_summary()
            let waiting=A.dev_task_hint()
            mod.widgets.HagencyLargeTitle{text:A.t("This Computer","这台电脑")}
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.t("It publishes your pools and runs their Agents’ tasks.","它负责发布你的资源池，并运行 Agent 的任务。")}
            mod.widgets.HagencyList{
                View{width:Fill height:Fit flow:Right spacing:14 padding:Inset{left:16 right:16 top:14 bottom:14} align:Align{y:0.5}
                    if device.key=="loading" {View{width:38 height:38 align:Align{x:0.5 y:0.5} mod.widgets.HagencySpinner{width:22 height:22}}}
                    if device.key!="loading" {mod.widgets.HagencyAvatarSmall{draw_bg.color:A.local_tone_bg(device.tone) mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.device draw_icon.color:A.local_tone_fg(device.tone)}}}
                    View{width:Fill height:Fit flow:Down spacing:4

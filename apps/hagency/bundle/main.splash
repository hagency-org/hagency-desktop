                        View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Template · select to copy","模板编号 · 可选中复制")} mod.widgets.HagencyCopyText{text:row.id}}
                        mod.widgets.HagencyWrapSubtitle{text:A.template_status(row.status)}
                    }}
                }}

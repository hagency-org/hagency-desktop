let A = {}
A.t = fn(en, zh){ if mod.rinx_i18n.language() == "zh-CN" { return zh } return en }
A.state_text = fn(state){
    if state == "pending_admission" || state == "pending" { return A.t("Awaiting administrator", "等待管理员审批") }
    if state == "admitted" || state == "approved" { return A.t("Admission approved", "已批准加入") }
    if state == "rejected" { return A.t("Declined", "已拒绝") }
    if state == "revoked" { return A.t("Revoked", "已撤销") }
    if state == "expired" { return A.t("Expired", "已过期") }
    return state
}
A.connection_status = fn(connection){
    if A.connection_capacity_active(connection) {return A.t("Resource pool published","资源池已发布")}
    if connection.state == "admitted" && connection.verification != nil {
        if connection.verification.status == "verified" {return A.t("Connection verified", "连接已验证")}
        return A.t("Admission approved · check record needs updating", "已批准加入 · 检查记录待更新")
    }
    return A.state_text(connection.state)
}
A.can_resume = fn(connection){return (connection.state == "pending_admission" || connection.state == "admitted") && connection.ownerMxid == H.session.account && connection.executorDeviceId == H.session.device && connection.executorGeneration != H.session.deviceGeneration}
A.can_verify = fn(connection){return connection.state == "admitted" && connection.ownerMxid == H.session.account && connection.executorDeviceId == H.session.device && connection.executorGeneration == H.session.deviceGeneration}
A.projects_enabled = fn(){return false}

A.project_state_text = fn(state){
    if state == "pending_approval" || state == "pending" {return A.t("Awaiting project approval", "等待项目审批")}
    if state == "approved" {return A.t("Project request approved", "项目申请已批准")}
    if state == "rejected" {return A.t("Project request declined", "项目申请已拒绝")}
    if state == "revoked" {return A.t("Project request withdrawn", "项目申请已撤回")}
    if state == "expired" {return A.t("Project request expired", "项目申请已过期")}
    return state
}
A.error_text = fn(code){
    if code=="pool_agent_resource_mismatch" && H.entry_role=="owner" {return A.t("This request is above the pool’s current per-request limit, so it can’t be approved. Decline it, or raise the per-request limit first.","这个申请超过了资源池现在的每次申请上限，不能批准。可以拒绝，或先调高每次申请上限。")}
    if code == "native_resume_missing" || code == "native_resume_revoked" {return A.t("Sign in again with this Matrix account to restore Hagency access. Existing records and saved requests stay on this device.", "请使用当前 Matrix 账号重新登录以恢复 Hagency 访问。此设备上的已有记录和已保存请求会保留。")}

    if code == "invalid_project_request" {return A.t("Check the project name, purpose and requested monthly tokens before submitting again.", "请检查项目名称、用途与申请的每月 token 数量后重新提交。")}
    if code == "contribution_not_admitted" {return A.t("This resource is no longer admitted. Refresh and review the resource's latest status.", "此资源已不再获准，请刷新并查看资源的最新状态。")}
    if code == "management_administrator_required" {return A.t("Only this server's designated administrator can decide project requests.", "只有此服务器的指定管理员可以审批项目申请。")}
    if code == "project_manager_required" {return A.t("Only this project's manager or the server administrator can withdraw its request.", "只有此项目的经理或服务器管理员可以撤回申请。")}
    if code == "project_request_capacity" {return A.t("You already have the maximum number of active project requests. Review your existing requests before starting another.", "你的有效项目申请数量已达上限，请先处理已有申请。")}
    if code == "project_resource_capacity" {return A.t("This resource has reached its active project-request limit. Choose another resource or wait for an existing request to close.", "此资源的有效项目申请数量已达上限，请选择其他资源或等待已有申请关闭。")}
    if code == "management_receipt_capacity" {return A.t("This device has reached the server's saved-command limit. Ask the administrator to review storage before submitting again.", "此设备已达服务器的指令记录上限，请管理员检查存储后再提交。")}
    if code == "management_command_conflict" {return A.t("A different result already exists for this request identifier. The original request remains saved; refresh to recover its recorded result.", "此请求标识已存在其他结果，原请求仍然保留。请刷新并恢复已记录的结果。")}
    if code == "invalid_management_revision" || code == "management_operation_mismatch" {return A.t("This saved request no longer matches the record. Refresh and review its current state before trying again.", "这个保存的请求和记录对不上，请刷新后再试。")}
    if code == "management_not_configured" { return A.t("Hagency management is not enabled on this server. Ask its administrator to enable it, then retry.", "此服务器尚未启用 Hagency 管理。请管理员启用后重试。") }
    if code == "provider_connection_cancelled" { return A.t("Connection cancelled. Your provider account was not changed.", "已取消关联，模型服务账号未更改。") }
    if code == "provider_confirmation_expired" { return A.t("The confirmation expired. Open it again when you are ready.", "确认已过期，请准备好后重新打开。") }
    if code == "local_codex_account_not_signed_in" || code == "local_provider_not_signed_in" { return A.t("Sign in to the provider on this device, then connect its account here.", "请先在此设备上登录模型服务，再回来关联账号。") }
    if code == "management_model_unqualified" { return A.t("This model and reasoning setting are not qualified for shared resources. Choose another model or reasoning level.", "此模型与推理强度组合尚未获得共享资源资格，请选择其他模型或推理强度。") }
    if code == "management_revision_conflict" || code == "management_revision_changed" || code == "revision_conflict" { return A.t("This record changed. Refresh and review its latest state before trying again.", "此记录已变化，请刷新后再试。") }
    if code == "management_action_closed" { return A.t("This request has already been completed or expired. Refresh to view its latest result.", "此请求已处理或已过期，请刷新查看最新结果。") }
    if code == "contribution_already_exists" { return A.t("This resource already has a connection. Open Connections to review it.", "此资源已有关联，请打开连接列表查看。") }
    if code == "invalid_management_user" { return A.t("Sign in with the resource owner account on this server.", "请使用此服务器上的资源所有者账号登录。") }
    if code == "resource_owner_is_coordinator" {return A.t("The resource owner automatically coordinates its capacity. Refresh this resource and submit again.", "资源所有者自动协调其容量。请刷新资源后重新提交。")}
    if code == "invalid_resource_offer" { return A.t("Check the resource name before submitting again.", "请检查资源名称后重新提交。") }
    if code == "provider_account_verification_required" {return A.t("The provider account could not be verified. Sign in on this device and check its connection again.", "无法验证模型服务账号，请在此设备上登录后重新检查连接。")}
    if code == "management_executor_changed" || code == "contribution_resource_changed" {return A.t("The resource or its provider binding changed. Review the resource and request admission for the updated configuration.", "资源或它的模型服务已变化，请检查资源，再为新的配置重新申请加入服务器。")}
    if code == "contribution_executor_changed" {return A.t("The resource owner needs to reconnect their device before this request can be approved.", "资源主人需要先重新连接设备，才能批准此申请。")}
    if code == "contribution_executor_current" {return A.t("This device is already reconnected. Refresh to see its latest status.", "此设备已重新连接，请刷新查看最新状态。")}
    if code == "contribution_executor_required" {return A.t("Verify this connection from the original owner's enrolled device.", "请使用资源主人原先登记的设备验证此连接。")}
    if code == "pool_grant_already_published" {return A.t("This pool's capacity is already published for its current admission. The server accepts one grant per admission, so the per-request limit was not changed.","这个资源池加入服务器后已经发布过额度。服务器每次加入只接受一次发布，所以每次申请上限没有改变。")}
    if code == "management_outcome_unknown" { return A.t("The reply was interrupted. Your original request is saved; retry it to recover the recorded result.", "响应中断，原请求已保存。请重试原请求以恢复已记录的结果。") }
    if code == "management_permission_required" || code == "management_scope_changed" || code == "management_access_required" { return A.t("Authorization changed. Reopen Hagency from your signed-in account.", "授权已变化，请使用已登录的账号重新打开 Hagency。") }
    return A.t("The operation could not finish. Your saved request is retained. Check the connection and retry.", "操作未完成，已保存的请求会保留。请检查连接后重试。")
}
A.notice_inline = fn(){return H.page=="resources" || H.page=="resource_detail" || H.page=="pool_create"}
A.notice_text = fn(){
    if H.needs_signin && H.notice == A.error_text("native_resume_missing") {return A.t("A fresh sign-in is needed for Hagency.", "Hagency 需要重新登录。")}
    return H.notice
}
A.onboarding_reason = fn(code){
    if code=="device_setup_required" {return A.t("Set up this device before creating a provider account.","请先设置此设备，再创建模型服务账号。")}
    if code=="empty_device_history_not_empty" {return A.t("This profile already has local account or activity records. Keep those records and use their existing recovery flow; an empty setup cannot replace them.","此身份已有本机账号或活动记录。请保留这些记录并使用原有恢复流程，空设备设置不能替代它们。")}
    if code == "source_adoption_inventory_unsupported" {return A.t("This device’s resource history is not supported by the migration yet. Existing records remain available; review them in Resources and Connections. Retrying cannot bypass this requirement.", "此设备的资源历史尚不支持迁移。已有记录仍可在资源与连接中查看；重试不能绕过此条件。")}
    if code == "onboarding_unavailable" {return A.t("Shared-capacity migration is not enabled in this build. Existing resource and connection records remain available.", "此版本尚未启用共享容量迁移，仍可查看已有资源与连接记录。")}
    if code == "owner_source_adoption_required" {return A.t("Review this device's original resource migration before reserving shared capacity.", "请先在「这台电脑」里完成设置。")}
    if code == "management_scope_changed" || code == "management_access_required" {return A.t("The account or session changed. Reopen Hagency from the intended signed-in account.", "账号或会话已变化，请从所需的已登录账号重新打开 Hagency。")}
    if code == "management_outcome_unknown" {return A.t("The result is unknown. Reopen the native review to recover the original migration or grant; do not create a replacement.", "结果未知。请重新打开原来的确认窗口查看结果，不要重新创建。")}
    return A.t("The native check could not finish. Refresh or reopen the original review; existing resource and grant history is retained.", "检查没有完成。请刷新，或重新打开原来的确认窗口；已有资源和记录都会保留。")
}
A.onboarding_state = fn(state){
    if state == "legacy" {return A.t("Device setup needs review", "这台电脑需要设置")}
    if state == "recovery_required" {return A.t("Resume the original setup", "继续原始设备设置")}
    if state == "active" {return A.t("Shared resource inventory available", "共享资源清单已可用")}
    if state == "outcome_unknown" {return A.t("Result unknown · recover original", "结果未知 · 请恢复原始操作")}
    if state == "review_closed" {return A.t("Native review closed", "已关闭确认窗口")}
    if state == "blocked" {return A.t("Native requirements are incomplete", "原生条件尚不满足")}
    return A.t("Shared-capacity setup unavailable", "共享容量设置暂不可用")
}
A.onboarding_result_text = fn(data){
    let {state=nil closure=nil}=data
    if state == "recorded" && closure != nil {return A.t("Previous grant closed. Retained amounts remain committed; a new grant requires a separately approved admission.", "旧的发布已关闭；已分给 Agent 的额度仍算在已承诺里。新的发布需要重新通过加入审批。")}
    if state == "active" {return A.t("Device setup completed. Continue with accounts, resources and sharing below.", "设备设置已完成，请继续处理下方的账号、资源和共享步骤。")}
    if state == "recorded" {return A.t("Capacity is reserved. Open the saved publication to continue.", "这台电脑已记下这次发布，打开发布记录就能继续。")}
    if state == "server_observed" {return A.t("The server result was read. Reopening the original grant does not renew or reactivate it.", "已读取服务器结果。重新打开原始授权不会续期或重新激活它。")}
    if state == "rejected" || state == "declined" {return A.t("The original action was declined. Its history and any existing local reservation remain unchanged.", "原来的操作被拒绝了；记录和这台电脑上已有的发布都不变。")}
    if state == "review_expired" {return A.t("The original accounting period ended. This grant cannot move silently to another month.", "原始记账周期已结束，此授权不能自动转移到其他月份。")}
    if state == "review_required" {return A.t("The original grant needs a fresh native review.", "原来的发布需要重新确认。")}
    return A.onboarding_state(state)
}
A.onboarding_reason_code = fn(data){let {reason=nil}=data return reason}
A.onboarding_intent_label = fn(intent){
    let {resourceId=nil}=intent
    for row in H.resources {if row.id==resourceId {return A.resource_title(row)}}
    return A.t("Resource ","资源 ")+if resourceId==nil {""} else {A.resource_short_id(resourceId)}
}
A.onboarding_empty = fn(data){let {setupKind=nil}=data return setupKind=="empty_device"}
A.onboarding_connections_received = fn(data){
    H.onboarding_connections=data.items H.onboarding_after=data.nextAfter
    for connection in H.onboarding_connections {A.observe_verification(connection,data.observedAtMs)}
}
A.more_onboarding_connections = fn(){
    if H.busy || H.onboarding == nil || !H.onboarding.grantReviewAvailable || H.onboarding_after == nil {return}
    let after=H.onboarding_after H.onboarding_connections=[] H.onboarding_after=nil
    A.request("hagency.connections.list",{after:after},A.onboarding_connections_received)
}
A.onboarding_received = fn(data){
    let {state=nil,canReview=nil,grantReviewAvailable=false,grantIntents=[],setupKind=nil}=data
    if !state.is_string() || (state != "legacy" && state != "recovery_required" && state != "active" && state != "unavailable") || (canReview != true && canReview != false) || (grantReviewAvailable != true && grantReviewAvailable != false) || (!grantIntents.is_array() && !grantIntents.is_object()) {
        H.onboarding=nil H.notice=A.onboarding_reason("invalid_reply") return
    }
    H.onboarding=data H.onboarding.grantReviewAvailable=grantReviewAvailable H.onboarding.grantIntents=grantIntents H.onboarding.setupKind=setupKind
    if state == "active" && grantReviewAvailable {A.request("hagency.connections.list",{},A.onboarding_connections_received)}
}
A.open_onboarding = fn(){
    if H.busy {return}
    H.page="onboarding" H.onboarding=nil H.onboarding_connections=[] H.onboarding_after=nil
    A.request("hagency.onboarding.status",{},A.onboarding_received)
}
A.review_onboarding = fn(){
    if H.busy || H.onboarding == nil || !H.onboarding.canReview {return}
    H.onboarding_result=nil
    A.request("hagency.onboarding.review",{},fn(data){H.onboarding_result=data A.open_onboarding()})
}
A.review_grant = fn(selector){
    if H.busy || H.onboarding == nil || !H.onboarding.grantReviewAvailable {return}
    H.onboarding_result=nil
    A.request("hagency.grants.review",selector,fn(data){H.onboarding_result=data A.open_onboarding()})
}
A.readmission_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_array() && !features.is_object() {return false}
    for feature in features {if feature=="resource-readmission-v1" {return true}}
    return false
}
A.can_reoffer = fn(admission){
    if !A.readmission_enabled() || admission==nil {return false}
    let c=admission.contribution
    return c.ownerMxid==H.session.account && c.executorDeviceId==H.session.device && c.executorGeneration<=H.session.deviceGeneration && (c.state=="revoked" || c.state=="rejected" || (c.state=="pending_admission" && admission.request.state=="expired"))
}
A.readmission_error = fn(code){
    if code=="contribution_withdrawal_required" {return A.t("The current admission is still open. Withdraw it before submitting a new request.","当前的加入仍有效，请先撤回，再提交新申请。")}
    if code=="contribution_native_fence_required" {return A.t("The execution device has not finished closing its previous grants. Keep Hagency running on that device, then refresh. Retained usage remains charged.","执行设备尚未完成旧授权的关闭，请保持该设备上的 Hagency 运行，然后刷新。保留的用量仍计入账本。")}
    if code=="owner_grant_prior_intent_required" {return A.t("Open Shared capacity to resolve previous grant reviews or recover their results before submitting again.","请先在「这台电脑 › 上手步骤」里打开之前的发布记录，处理完后再提交新的申请。")}
    if code=="contribution_projects_open" {return A.t("This resource still has open project requests or allocations. Review its projects before submitting again.","此资源仍有关联的项目申请或分配，请先处理相关项目，再提交新申请。")}
    if code=="contribution_history_capacity" {return A.t("The server cannot retain another admission round for this connection. Its existing history is unchanged.","服务器不能为这个连接再保存一次加入申请，已有记录保持不变。")}
    if code=="management_revision_changed" || code=="contribution_resource_changed" {return A.t("The connection or resource changed. Reload its current details and review the new request again.","连接或资源已变化，请刷新后再提交。")}
    if code=="readmission_unavailable" {return A.t("This server does not support resource admission history and resubmission yet.","此服务器还不支持加入记录和重新申请。")}
    if code=="invalid_history_reply" {return A.t("The history response did not match this connection. Refresh to try again.","历史响应与此连接不匹配，请刷新后重试。")}
    if code=="invalid_resource_offer" || code=="invalid_management_user" {return A.t("Enter a resource name. Your signed-in account owns and coordinates it.","请输入资源名称。当前登录账号拥有并协调此资源。")}
    return A.error_text(code)
}
A.reoffer_not_applied = fn(code){
    return code=="owner_grant_prior_intent_required" || code=="contribution_native_fence_required" || code=="contribution_projects_open" || code=="contribution_withdrawal_required" || code=="contribution_history_capacity" || code=="management_revision_changed" || code=="management_revision_conflict" || code=="contribution_resource_changed" || code=="contribution_executor_required" || code=="invalid_resource_offer" || code=="invalid_management_user" || code=="invalid_management_arguments" || code=="invalid_management_revision"
}
A.history_received = fn(data){
    if data.protocol!="hagency-management-v1" || (!data.items.is_array() && !data.items.is_object()) || data.items.len()>32 {H.notice=A.readmission_error("invalid_history_reply") return}
    for item in data.items {
        let {offer=nil request=nil current=nil}=item
        if offer==nil || request==nil || (current!=true && current!=false) || offer.contributionId!=H.history_id || offer.requestId!=request.id || request.contributionId!=H.history_id {H.notice=A.readmission_error("invalid_history_reply") return}
    }
    if data.nextAfter!=nil && (!data.nextAfter.is_string() || data.nextAfter==H.history_after) {H.notice=A.readmission_error("invalid_history_reply") return}
    H.connection_history=data
}
A.open_connection_history = fn(id,after,page){
    if H.busy {return}
    if !A.readmission_enabled() {H.notice=A.readmission_error("readmission_unavailable") A.redraw() return}
    H.page="connection_history" H.history_id=id H.history_after=after H.history_page=page H.connection_history=nil H.notice=""
    let args={id:id} if after!=nil {args.after=after}
    A.request("hagency.connections.history",args,A.history_received)
}
A.begin_reoffer = fn(){
    if H.busy || H.command!=nil || !A.can_reoffer(H.selected) {return}
    let id=H.selected.contribution.id
    H.page="connection_reoffer" H.reoffer_draft=nil H.notice=""
    A.request("hagency.connections.get",{id:id},fn(data){
        let {admission=nil}=data
        if admission==nil || admission.contribution.id!=id || admission.request.id!=admission.contribution.requestId || admission.request.contributionId!=id {H.notice=A.readmission_error("invalid_history_reply") return}
        H.selected=admission
        if !A.can_reoffer(H.selected) {H.page="action" H.notice=A.readmission_error("contribution_withdrawal_required") return}
        let c=H.selected.contribution
        A.request("hagency.resources.get",{id:c.resourceId},fn(detail){
            if detail.protocol!="hagency-management-v1" || detail.resource.id!=c.resourceId {H.notice=A.readmission_error("contribution_resource_changed") return}
            H.reoffer_draft={contributionId:c.id expectedContributionRevision:c.revision requestId:c.requestId resourceId:c.resourceId expectedRevision:detail.resource.revision label:c.label coordinatorMxid:c.ownerMxid resource:detail.resource review:false}
        })
    })
}
A.reoffer_field = fn(name,value){
    if H.busy || H.command!=nil || H.reoffer_draft==nil || H.reoffer_draft.review {return}
    if name=="label" {H.reoffer_draft.label=value}
}
A.review_reoffer = fn(){
    if H.busy || H.command!=nil || H.reoffer_draft==nil || !A.can_reoffer(H.selected) {return}
    let d=H.reoffer_draft
    d.label=d.label.trim() d.coordinatorMxid=H.session.account
    if d.label=="" || d.coordinatorMxid=="" {H.notice=A.readmission_error("invalid_resource_offer") A.redraw() return}
    d.review=true H.notice="" A.redraw()
}
A.submit_reoffer = fn(){
    if H.busy || H.command!=nil || H.reoffer_draft==nil || !H.reoffer_draft.review || !A.can_reoffer(H.selected) {return}
    let d=H.reoffer_draft let c=H.selected.contribution
    if d.contributionId!=c.id || d.resourceId!=c.resourceId || d.expectedContributionRevision!=c.revision || d.requestId!=c.requestId {d.review=false H.notice=A.readmission_error("management_revision_changed") A.redraw() return}
    A.submit("hagency.connections.reoffer",{contributionId:d.contributionId expectedContributionRevision:d.expectedContributionRevision resourceId:d.resourceId expectedRevision:d.expectedRevision label:d.label coordinatorMxid:d.coordinatorMxid})
}

A.project_not_applied = fn(service, code){
    if service != "hagency.projects.request" && service != "hagency.projects.decide" && service != "hagency.projects.revoke" {return false}
    return code == "invalid_project_request" || code == "invalid_management_revision" || code == "management_administrator_required" || code == "project_manager_required" || code == "contribution_not_admitted" || code == "management_revision_changed" || code == "management_action_closed" || code == "management_operation_mismatch" || code == "project_request_capacity" || code == "project_resource_capacity" || code == "management_receipt_capacity"
}
A.restore_project_draft = fn(draft){
    if !draft.is_object() {return false}
    let {step = nil, name = nil, purpose = nil, tokens = nil, resource = nil} = draft
    if step != 0 && step != 1 && step != 2 {return false}
    if !name.is_string() || !purpose.is_string() || !tokens.is_string() {return false}
    if resource == nil {
        if step != 0 {return false}
    } else {
        if !resource.is_object() {return false}
        let {id = nil, label = nil, runtime = nil, coordinatorMxid = nil} = resource
        if !id.is_string() || !label.is_string() || !runtime.is_string() || !coordinatorMxid.is_string() {return false}
    }
    H.project_draft = {step:step resource:resource name:name purpose:purpose tokens:tokens}
    return true
}
A.clear_requested_draft = fn(project){
    let draft = H.project_draft
    if draft.resource != nil && draft.resource.id == project.contributionId && draft.name.trim() == project.name && draft.purpose.trim() == project.purpose && draft.tokens.trim().to_f64() == project.requestedTokens {
        H.project_draft = {step:0 resource:nil name:"" purpose:"" tokens:"100000"}
    }
}
A.local_name = fn(row){let {localName=nil}=row return localName}
A.resource_title = fn(row){let name=A.local_name(row) if name != nil && name.name != "" {return name.name} return row.model}
A.name_not_applied = fn(service,code){return service == "hagency.resources.rename" && (code == "management_resource_name_changed" || code == "invalid_management_arguments")}
A.name_error = fn(code){
    if code == "management_resource_name_changed" {return A.t("The local name changed. Refresh its current name before reviewing another edit.", "名称已变化，请刷新后再改。")}
    if code == "invalid_management_arguments" {return A.t("Use a single-line local name of up to 80 characters. Leave it empty to show the model name.", "本地名称须为最多 80 个字符的单行文本，留空则显示模型名称。")}
    return A.error_text(code)
}
A.edit_resource_name = fn(){
    if H.busy || H.command != nil || H.resource_detail == nil {return}
    let row=H.resource_detail.resource let name=A.local_name(row)
    if name == nil {return}
    H.resource_name_draft={resourceId:row.id expectedNameRevision:name.revision originalName:name.name name:name.name}
    H.resource_name_mode="edit" H.notice="" A.redraw()
}
A.review_resource_name = fn(){
    if H.busy || H.command != nil || H.resource_name_draft == nil {return}
    H.resource_name_draft.name=H.resource_name_draft.name.trim()
    H.resource_name_mode="review" H.notice="" A.redraw()
}
A.submit_resource_name = fn(){
    if H.busy || H.command != nil || H.resource_name_mode != "review" || H.resource_name_draft == nil || H.resource_detail == nil {return}
    let d=H.resource_name_draft let name=A.local_name(H.resource_detail.resource)
    if name == nil || d.resourceId != H.resource_detail.resource.id || d.expectedNameRevision != name.revision {H.notice=A.name_error("management_resource_name_changed") H.resource_name_mode="" H.resource_name_draft=nil A.redraw() return}
    A.submit("hagency.resources.rename",{resourceId:d.resourceId expectedNameRevision:d.expectedNameRevision name:d.name})
}
A.resource_edit_reason = fn(reason){
    if reason=="previously_offered" {return A.t("This resource has already been offered. Its server agreement must be amended before configuration changes.","此资源已贡献过。修改配置前须先变更服务器上的协议。")}
    if reason=="published" {return A.t("This resource is published locally. It cannot be changed in place here.","此资源已在本机目录登记，此处不能直接修改配置。")}
    if reason=="retained_commitments" {return A.t("This resource has retained allocations or usage commitments.","此资源仍有关联分配或用量承诺。")}
    if reason=="managed_namespace_required" {return A.t("Editing currently requires a resource enrolled from a private Codex account space.","编辑目前要求资源来自独立的 Codex 账号空间。")}
    if reason=="account_unavailable" {return A.t("The original account space is unavailable or sign-in is in progress. Check Accounts, then refresh.","原账号空间不可用或正在登录。请检查账号后刷新。")}
    if reason=="read_only" {return A.t("This mini-app session has read access only. Review its permissions to enable editing.","此小程序现在只能查看，不能修改。")}
    return A.t("This device cannot prove that the resource was never contributed. Changing it could invalidate an existing server connection.","此设备无法证明资源从未贡献过。修改配置可能使现有服务器连接失效。")
}
A.resource_default_yolo = fn(detail){
    let {executionPolicy=nil}=detail
    return executionPolicy!=nil && executionPolicy.yolo==true
}
A.resource_draft_yolo = fn(d,detail){
    let {yolo=nil}=d
    return if yolo==nil {A.resource_default_yolo(detail)}else{yolo}
}
A.choose_resource_default = fn(kind,yolo){
    if H.busy || H.command!=nil || H.resource_detail==nil || (kind!="edit" && kind!="create") || H.page!="resource_"+kind {return}
    if (yolo!=false && yolo!=true) || (yolo && H.resource_detail.resource.framework!="codex") {return}
    let d=if kind=="edit" {H.resource_edit_draft}else{H.resource_create_draft}
    if d==nil {return}
    // Full trust always asks first, with the same alert as everywhere else.
    if yolo && !d.yolo {H.create_trust_ask=kind A.redraw() return}
    d.yolo=yolo A.redraw()
}
A.confirm_resource_trust=fn(){
    let kind=H.create_trust_ask
    H.create_trust_ask=""
    if H.busy || H.command!=nil || (kind!="edit" && kind!="create") {A.redraw() return}
    let d=if kind=="edit" {H.resource_edit_draft}else{H.resource_create_draft}
    if d!=nil {d.yolo=true}
    A.redraw()
}
A.edit_resource_configuration = fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil || !H.resource_detail.editing.allowed {return}
    let detail=H.resource_detail let row=detail.resource let d=H.resource_edit_draft
    if d==nil || d.resourceId!=row.id || d.expectedRevision!=row.revision {
        let amount=nil
        if detail.ceiling!=nil {amount=detail.ceiling.tokens}
        H.resource_edit_draft={resourceId:row.id expectedRevision:row.revision yolo:A.resource_default_yolo(detail) model:row.model reasoning:row.reasoning tokens:if amount==nil {""}else{""+amount} limitMode:if amount==nil {"clear"}else{"monthly"}}
    }
    H.resource_edit_models_open=false H.page="resource_edit" H.notice="" A.redraw()
}
A.resource_edit_models = fn(){
    let models=[]
    if H.resource_detail==nil {return models}
    for choice in H.resource_detail.choices {let found=false for model in models {if model==choice.model {found=true}} if !found {models.push(choice.model)}}
    return models
}
A.choose_resource_model = fn(model){
    if H.busy || H.command!=nil || H.resource_edit_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_edit_draft let valid=false let first=nil let found=false
    for choice in H.resource_detail.choices {if choice.model==model {if !found {first=choice.reasoning found=true} if choice.reasoning==d.reasoning {valid=true}}}
    if !found {return}
    d.model=model if !valid {d.reasoning=first}
    H.resource_edit_models_open=false A.redraw()
}
A.resource_edit_error = fn(code){
    if code=="management_resource_edit_changed" {return A.t("The resource changed. Refresh its details before reviewing another edit.","资源池已变化，请刷新后再改。")}
    if code=="management_resource_edit_not_available" {return A.t("This resource can no longer be edited locally. Refresh to see its current status.","此资源目前已不能在本地编辑，请刷新查看当前状态。")}
    if code=="provider_model_changed" || code=="management_model_unqualified" {return A.t("The account no longer supports this model and reasoning choice. Refresh and choose again.","账号目前不支持此模型与推理强度组合，请刷新后重新选择。")}
    if code=="resource_namespace_required" {return A.resource_edit_reason("managed_namespace_required")}
    if code=="invalid_management_arguments" {return A.t("Choose a supported model and enter a whole monthly token limit, including zero, or explicitly clear the limit.","请选择支持的模型，输入每月 token 整数上限（可为零），或明确清除上限。")}
    if code=="management_ceiling_amendment_not_available" {return A.t("The monthly maximum can’t change here right now.","每月上限现在不能在这里调整。")}
    if code=="management_ceiling_clear_refused" || code=="management_ceiling_unchanged" || code=="management_ceiling_below_commitments" || code=="management_ceiling_usage_unsettled" {return A.ceiling_refusal(code,nil)}
    return A.error_text(code)
}
A.resource_edit_not_applied = fn(code){return code=="management_resource_edit_changed" || code=="management_resource_edit_not_available" || code=="management_model_unqualified" || code=="provider_model_changed" || code=="resource_namespace_required" || code=="provider_connection_required" || code=="invalid_management_arguments" || code=="management_ceiling_amendment_not_available" || code=="management_ceiling_clear_refused" || code=="management_ceiling_unchanged" || code=="management_ceiling_below_commitments" || code=="management_ceiling_usage_unsettled"}
A.submit_resource_configuration = fn(){
    if H.busy || H.command!=nil || H.resource_edit_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_edit_draft let detail=H.resource_detail let row=detail.resource
    if d.resourceId!=row.id || d.expectedRevision!=row.revision || !detail.editing.allowed {H.notice=A.resource_edit_error("management_resource_edit_changed") A.redraw() return}
    let qualified=false for choice in detail.choices {if choice.model==d.model && choice.reasoning==d.reasoning {qualified=true}}
    if !qualified {H.notice=A.resource_edit_error("management_model_unqualified") A.redraw() return}
    let yolo=A.resource_draft_yolo(d,detail)
    if (yolo!=false && yolo!=true) || (yolo && row.framework!="codex") {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
    let policy_changed=yolo!=A.resource_default_yolo(detail)
    let profile={kind:"preserve"}
    if d.model!=row.model || d.reasoning!=row.reasoning {profile={kind:"select" model:d.model reasoning:d.reasoning}}
    let ceiling={kind:"preserve"}
    if d.limitMode=="clear" {if detail.ceiling!=nil {ceiling={kind:"clear"}}} else if d.limitMode=="monthly" {
        let tokens=d.tokens.trim().to_f64()
        if d.tokens.trim()=="" || !(tokens>=0 && tokens<=9007199254740991) || floor(tokens)!=tokens {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
        if detail.ceiling==nil || detail.ceiling.period!="monthly" || detail.ceiling.tokens!=tokens {ceiling={kind:"monthly" tokens:tokens}}
    } else {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
    if profile.kind=="preserve" && ceiling.kind=="preserve" && !policy_changed {H.notice=A.t("No configuration changes to save.","配置没有变化，无需保存。") A.redraw() return}
    let input={resourceId:d.resourceId expectedRevision:d.expectedRevision profile:profile ceiling:ceiling}
    if policy_changed {input.executionPolicy={yolo:yolo}}
    A.submit("hagency.resources.edit",input)
}
A.create_resource_configuration = fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil || H.resource_detail.choices.len()==0 || H.resource_detail.editing.reason=="read_only" {return}
    let detail=H.resource_detail let row=detail.resource let d=H.resource_create_draft
    if d==nil || d.sourceResourceId!=row.id || d.expectedRevision!=row.revision {
        let amount=nil
        if detail.ceiling!=nil {amount=detail.ceiling.tokens}
        H.resource_create_draft={sourceResourceId:row.id expectedRevision:row.revision yolo:A.resource_default_yolo(detail) model:row.model reasoning:row.reasoning tokens:if amount==nil {""}else{""+amount} limitMode:if amount==nil {"clear"}else{"monthly"}}
    }
    H.resource_create_models_open=false H.page="resource_create" H.notice="" A.redraw()
}
A.resource_create_models = fn(){
    let models=[]
    if H.resource_detail==nil {return models}
    for choice in H.resource_detail.choices {let found=false for model in models {if model==choice.model {found=true}} if !found {models.push(choice.model)}}
    return models
}
A.choose_resource_creation_model = fn(model){
    if H.busy || H.command!=nil || H.resource_create_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_create_draft let valid=false let first=nil let found=false
    for choice in H.resource_detail.choices {if choice.model==model {if !found {first=choice.reasoning found=true} if choice.reasoning==d.reasoning {valid=true}}}
    if !found {return}
    d.model=model if !valid {d.reasoning=first}
    H.resource_create_models_open=false A.redraw()
}
A.resource_create_error = fn(code){
    if code=="management_resource_source_changed" {return A.t("The source configuration changed. Refresh its details before creating a new configuration.","源配置已变化，请刷新详情后再创建新配置。")}
    if code=="management_model_unqualified" {return A.t("This model and reasoning choice is not qualified. Refresh the source and choose again.","此模型与推理强度组合不合格，请刷新源配置后重新选择。")}
    if code=="invalid_management_arguments" {return A.resource_edit_error(code)}
    return A.error_text(code)
}
A.resource_create_not_applied = fn(code){return code=="management_resource_source_changed" || code=="management_model_unqualified" || code=="invalid_management_arguments"}
A.submit_resource_creation = fn(){
    if H.busy || H.command!=nil || H.resource_create_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_create_draft let detail=H.resource_detail let row=detail.resource
    if d.sourceResourceId!=row.id || d.expectedRevision!=row.revision || detail.choices.len()==0 || detail.editing.reason=="read_only" {H.notice=A.resource_create_error("management_resource_source_changed") A.redraw() return}
    let qualified=false for choice in detail.choices {if choice.model==d.model && choice.reasoning==d.reasoning {qualified=true}}
    if !qualified {H.notice=A.resource_create_error("management_model_unqualified") A.redraw() return}
    let yolo=A.resource_draft_yolo(d,detail)
    if (yolo!=false && yolo!=true) || (yolo && row.framework!="codex") {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
    let policy_changed=yolo!=A.resource_default_yolo(detail)
    let profile={kind:"preserve"}
    if d.model!=row.model || d.reasoning!=row.reasoning {profile={kind:"select" model:d.model reasoning:d.reasoning}}
    let ceiling={kind:"preserve"}
    if d.limitMode=="clear" {if detail.ceiling!=nil {ceiling={kind:"clear"}}} else if d.limitMode=="monthly" {
        let tokens=d.tokens.trim().to_f64()
        if d.tokens.trim()=="" || !(tokens>=0 && tokens<=9007199254740991) || floor(tokens)!=tokens {H.notice=A.resource_create_error("invalid_management_arguments") A.redraw() return}
        if detail.ceiling==nil || detail.ceiling.period!="monthly" || detail.ceiling.tokens!=tokens {ceiling={kind:"monthly" tokens:tokens}}
    } else {H.notice=A.resource_create_error("invalid_management_arguments") A.redraw() return}
    let input={sourceResourceId:d.sourceResourceId expectedRevision:d.expectedRevision profile:profile ceiling:ceiling}
    if policy_changed {input.executionPolicy={yolo:yolo}}
    A.submit("hagency.resources.create",input)
}
A.resource_error = fn(code){
    if code == "management_not_found" || code == "management_resource_unavailable" {return A.t("This resource is no longer available on this device.", "这台电脑上已经没有这个资源池了。")}
    if code == "management_scope_changed" || code == "management_access_required" || code == "management_permission_required" {return A.error_text(code)}
    return A.t("The resource could not be read. Refresh to try again.", "无法读取资源，请刷新后重试。")
}
A.open_resource = fn(id){
    if H.resource_id!=id {H.ux.resourceTools=false}
    if H.busy {return}
    H.page="resource_detail" H.resource_id=id H.resource_detail=nil H.notice="" H.resource_name_mode="" H.resource_name_draft=nil H.bar_past=false H.web.publicationReview=false H.pool_result=A.pool_take_saved(id)
    A.request("hagency.resources.get", {id:id}, fn(data){
        if data.protocol != "hagency-management-v1" || data.resource.id != H.resource_id {H.notice=A.t("The resource response did not match this page. Refresh to check again.", "资源响应与当前页面不匹配，请刷新后重新检查。") return}
        H.resource_detail=data
        A.pool_edit_sync()
        A.pool_info_load(id)
        if H.nav.anchor!="" {start_timeout(0.3,||{if H.page=="resource_detail" {A.nav_scroll()}})}
        A.pool_result_show()
    })
}
A.alert_state = fn(state){
    if state=="open" {return A.t("Open","待处理")}
    if state=="acknowledged" {return A.t("Marked Got It","已标记“知道了”")}
    if state=="assigned" {return A.t("Being handled","处理中")}
    if state=="suppressed" {return A.t("Muted","暂停提醒中")}
    if state=="resolved" {return A.t("Handled","已处理好")}
    return state
}
A.alert_action = fn(state){
    if state=="acknowledged" {return A.t("GOT IT, WITH A NOTE","知道了，加一条备注")}
    if state=="assigned" {return A.t("I’LL HANDLE IT","由我处理")}
    if state=="suppressed" {return A.t("NO REMINDERS FOR 24 HOURS","24 小时内不再提醒")}
    if state=="resolved" {return A.t("MARK IT HANDLED","标记为已处理好")}
    return A.t("REMIND ME AGAIN","继续提醒")
}
A.alert_severity = fn(value){if value=="critical"{return A.t("Critical","严重")} if value=="warning"{return A.t("Warning","警告")} return A.t("Information","提示")}
A.alert_budget = fn(row){let {budget={}}=row let {ceilingTokens=nil,drawnTokens=nil,overByTokens=nil}=budget return {ceiling:ceilingTokens drawn:drawnTokens over:overByTokens}}
A.alert_error = fn(code){
    if code=="management_revision_conflict" {return A.t("This alert changed. Refresh its latest observation before reviewing another action.","告警已变化，请刷新后再选择处理方式。")}
    if code=="management_not_found" {return A.t("This alert or resource is no longer available to this account.","当前账号已无法访问此告警或资源。")}
    return A.error_text(code)
}
// Alerts now list inside Health & Recovery; the status filter carries over.
A.open_alerts = fn(resource,after,status){
    if H.busy {return}
    H.alert_after=after H.alert_status="open" H.alert_detail=nil H.alert_draft=nil H.nav.anchor=""
    A.health_open(resource,"open","")
}
A.open_alert = fn(resource,id,after_note){
    if H.busy {return}
    H.page="resource_alert" H.alert_resource=resource H.alert_id=id H.alert_note_after=after_note H.alert_detail=nil H.alert_draft=nil H.notice=""
    A.request("hagency.alerts.get",{resourceId:resource id:id afterNote:after_note},fn(data){
        if H.page!="resource_alert" || H.alert_resource!=resource || H.alert_id!=id || H.alert_note_after!=after_note {return}
        if data.alert.resourceId!=resource || data.alert.id!=id {H.notice=A.t("The alert response did not match this resource.","告警响应与当前资源不匹配。") return}
        H.alert_detail=data
    })
}
A.choose_alert_action = fn(state){
    if H.busy || H.command!=nil || H.alert_detail==nil {return}
    let row=H.alert_detail.alert let allowed=false
    for next in row.next {if state==next {allowed=true}}
    if !allowed {return}
    H.alert_saved=nil
    H.alert_draft={resourceId:row.resourceId id:row.id expectedRevision:row.revision to:state note:"" quick:false} A.redraw()
}
A.submit_alert = fn(){
    if H.busy || H.command!=nil || H.alert_draft==nil || H.alert_detail==nil {return}
    let d=H.alert_draft let row=H.alert_detail.alert
    if d.resourceId!=H.alert_resource || d.id!=H.alert_id || d.expectedRevision!=row.revision {H.alert_draft=nil H.notice=A.alert_error("management_revision_conflict") A.redraw() return}
    A.submit("hagency.alerts.triage",{resourceId:d.resourceId id:d.id expectedRevision:d.expectedRevision to:d.to note:if d.note.trim()==""{nil}else{d.note.trim()}})
}
A.binding_error = fn(code){
    if code=="management_revision_conflict" {return A.t("This link changed. Refresh the list and review the current room before removing it.","审批聊天已变化，请刷新列表后再移除。")}
    if code=="management_not_found" {return A.t("This link is no longer available. Refresh the resource's approval rooms.","此绑定已不可用，请刷新资源的审批聊天。")}
    return A.error_text(code)
}
A.open_bindings = fn(resource,after){
    if H.busy {return}
    if resource!=H.binding_resource {H.binding_filters={agent:"",project:""} H.binding_filter_draft={agent:"",project:""}}
    let agent=H.binding_filters.agent let project=H.binding_filters.project
    H.page="approval_bindings" H.tools_resource=resource H.binding_resource=resource H.binding_after=after H.binding_page=nil H.binding_draft=nil H.binding_result=nil H.notice=""
    A.request("hagency.approval_bindings.list",{resourceId:resource after:after agent:agent project:project},fn(data){
        if H.page!="approval_bindings" || H.binding_resource!=resource || H.binding_after!=after || H.binding_filters.agent!=agent || H.binding_filters.project!=project {return}
        if data.resourceId!=resource || data.agent!=agent || data.project!=project {H.notice=A.t("The room list did not match this resource and its filters.","房间列表与当前资源或筛选条件不匹配。") return}
        for row in data.bindings {if row.resourceId!=resource {H.notice=A.t("The room list did not match this resource.","房间列表与当前资源不匹配。") return}}
        H.binding_page=data
    })
}
A.filter_bindings = fn(){
    if H.busy {return}
    H.binding_filters={agent:H.binding_filter_draft.agent.trim(),project:H.binding_filter_draft.project.trim()}
    A.open_bindings(H.binding_resource,"")
}
A.clear_binding_filters = fn(){
    if H.busy {return}
    H.binding_filters={agent:"",project:""} H.binding_filter_draft={agent:"",project:""}
    A.open_bindings(H.binding_resource,"")
}
A.review_binding = fn(row){
    if H.busy || H.command!=nil || H.binding_page==nil || row.resourceId!=H.binding_resource {return}
    let found=false
    for current in H.binding_page.bindings {if current.engagementId==row.engagementId && current.revision==row.revision {found=true}}
    if !found {return}
    H.binding_draft={resourceId:row.resourceId engagementId:row.engagementId expectedRevision:row.revision agent:row.agent roomId:row.roomId ownerMxid:row.ownerMxid projectId:row.projectId serverName:row.serverName incarnation:row.incarnation}
    H.binding_confirm=false H.page="approval_binding_review" H.notice="" H.bar_past=false A.redraw()
}
A.submit_binding = fn(){
    if H.busy || H.command!=nil || H.binding_draft==nil || H.binding_page==nil || H.page!="approval_binding_review" {return}
    let d=H.binding_draft let current=false
    if H.binding_resource==d.resourceId {for row in H.binding_page.bindings {if row.resourceId==d.resourceId && row.engagementId==d.engagementId && row.revision==d.expectedRevision {current=true}}}
    if !current {H.binding_draft=nil H.page="approval_bindings" H.notice=A.binding_error("management_revision_conflict") A.redraw() return}
    A.submit("hagency.approval_bindings.retire",{resourceId:d.resourceId engagementId:d.engagementId expectedRevision:d.expectedRevision})
}
A.binding_received = fn(data){
    if H.binding_resource!=data.binding.resourceId {H.binding_filters={agent:"",project:""} H.binding_filter_draft={agent:"",project:""} H.binding_after=""}
    H.binding_result=data H.binding_resource=data.binding.resourceId H.binding_page=nil H.binding_draft=nil H.page="approval_binding_result" H.notice=""
}
A.binding_reply = fn(command,r){
    if r.is_ok {
        if !r.data.unbound || r.data.binding.resourceId!=command.args.resourceId || r.data.binding.engagementId!=command.args.engagementId || r.data.binding.revision!=command.args.expectedRevision {H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.binding_received(r.data)
        if A.save() {A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.binding_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" {
            H.command=nil H.binding_draft=nil H.binding_page=nil H.page="approval_bindings"
            if A.save() {A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}
A.tool_error = fn(code){
    if code=="tool_approval_room_unavailable" {return A.t("The original project room is unavailable. Refresh this request to check its latest status.","原项目房间暂不可用，请刷新此请求查看最新状态。")}
    if code=="tool_approval_navigation_unavailable" {return A.t("This build cannot open approval rooms.","此版本无法打开审批聊天。")}
    if code=="management_revision_conflict" {return A.t("This permission changed. Refresh and review it again.","这项权限已变化，请刷新后再试。")}
    if code=="management_not_found" {return A.t("This request or permission is no longer available for this agent.","此 Agent 的请求或权限已不可用。")}
    return A.error_text(code)
}
A.tool_status = fn(state){
    if state=="pending" {return A.t("Awaiting tool approval","等待工具审批")}
    if state=="decided" {return A.t("Decision recorded","决定已记录")}
    if state=="applying" {return A.t("Delivering decision","正在传递决定")}
    if state=="applied" {return A.t("Decision delivered","决定已传递")}
    if state=="expired" {return A.t("Expired","已过期")}
    if state=="cancelled" {return A.t("Cancelled","已取消")}
    if state=="uncertain" {return A.t("Delivery needs checking","传递结果待确认")}
    if state=="not_applied" {return A.t("Decision not applied","决定未应用")}
    return state
}
A.tool_request_status = fn(row,observed_at){
    if row.state=="pending" && row.expiresAt<=observed_at {return A.t("Approval window ended","审批已截止")}
    return A.tool_status(row.state)
}
A.tool_subject = fn(page,engagement){
    if page==nil {return nil}
    let {subjects=[]}=page
    for subject in subjects {if subject.engagementId==engagement {return subject}}
    return nil
}
A.tool_agent = fn(subject){
    if subject==nil {return A.t("Agent information unavailable","Agent 信息暂不可用")}
    return subject.agent
}
A.tool_project = fn(subject){
    if subject==nil {return A.t("Project information unavailable","项目信息暂不可用")}
    return if subject.projectName!=nil && subject.projectName!="" {subject.projectName}else{subject.projectId}
}
A.tool_deadline = fn(row,observed_at){
    if row.expiresAt<=observed_at {return A.t("Approval deadline passed","审批期限已过")}
    return A.t("Time left at refresh: ","刷新时剩余时间：")+floor((row.expiresAt-observed_at)/1000)+A.t(" seconds"," 秒")
}
A.open_tool_request = fn(id){
    if H.busy || id=="" || H.tool_resource=="" {return}
    let resource=H.tool_resource
    H.page="tool_request" H.tool_request_id=id H.tool_selected=nil H.notice=""
    A.request("hagency.tool_approvals.get",{resourceId:resource approvalId:id},fn(data){
        if H.page!="tool_request" || H.tool_resource!=resource || H.tool_request_id!=id {return}
        if !data.is_object() {H.notice=A.t("Request information unavailable","请求信息暂不可用") return}
        let {resourceId=nil,approval=nil,subject=nil,observedAtMs=nil}=data
        if !approval.is_object() || !subject.is_object() || observedAtMs==nil {H.notice=A.t("Request information unavailable","请求信息暂不可用") return}
        if resourceId!=resource || approval.id!=id || subject.engagementId!=approval.engagementId {H.notice=A.t("The response did not match this request.","响应与当前请求不匹配。") return}
        H.tool_selected=data
    })
}
// Opens the request's approval room in the chat, without visiting its detail page first.
A.tool_open_room=fn(row){
    if H.busy || H.tool_resource=="" {return}
    A.request("hagency.tool_approvals.open",{resourceId:H.tool_resource approvalId:row.id},fn(result){
        if result.requested {H.notice=A.t("Opening the approval room…","正在打开审批聊天…")}
    })
}
A.open_tool_inbox = fn(){
    if H.busy || H.page!="tool_request" || H.tool_selected==nil {return}
    let data=H.tool_selected
    if data.resourceId!=H.tool_resource || data.approval.id!=H.tool_request_id {return}
    if data.approval.projectRoomId==nil {H.notice=A.tool_error("tool_approval_room_unavailable") A.redraw() return}
    A.request("hagency.tool_approvals.open",{resourceId:data.resourceId approvalId:data.approval.id},fn(result){
        if H.page!="tool_request" || H.tool_resource!=data.resourceId || H.tool_request_id!=data.approval.id {return}
        if result.requested {H.notice=A.t("Opening the verified approval inbox…","正在打开已验证的审批收件箱…")}
    })
}
A.tool_choice = fn(choice){
    if choice=="once" {return A.t("Allow once","允许一次")}
    if choice=="task" {return A.t("Allow for this task","此任务内允许")}
    if choice=="always" {return A.t("Saved permission","已保存权限")}
    if choice=="deny" {return A.t("Denied","已拒绝")}
    return A.t("No decision yet","尚未决定")
}
A.tool_kind = fn(kind){
    if kind=="exact_command" {return A.t("Command","命令")}
    if kind=="network_host" {return A.t("Network access","网络访问")}
    if kind=="permission_profile" {return A.t("Set of permissions","一组权限")}
    if kind=="exact_tool_call" {return A.t("Tool call","工具调用")}
    return kind
}
A.open_tools = fn(resource,engagement,after,kind){
    if H.busy || (kind!="requests" && kind!="rules") || (kind=="rules" && engagement=="") {return}
    // Saved permissions return to the page that opened them; pending requests also check Agent permission requests.
    if kind=="rules" && !A.has_page(["tool_grants","tool_grant_review","tool_grant_result"]) {H.tool_origin=H.page}
    if kind=="requests" {H.tools_resource=resource A.tools_shared_load()}
    H.page=if kind=="requests"{"tool_approvals"}else{"tool_grants"}
    H.tool_resource=resource H.tool_engagement=engagement H.tool_after=after H.tool_kind=kind H.tool_page=nil H.tool_draft=nil H.tool_result=nil H.tool_selected=nil H.tool_request_id="" H.notice=""
    let service=if kind=="requests"{"hagency.tool_approvals.list"}else{"hagency.tool_grants.list"}
    A.request(service,{resourceId:resource engagementId:engagement after:after},fn(data){
        if (H.page!="tool_approvals" && H.page!="tool_grants") || H.tool_resource!=resource || H.tool_engagement!=engagement || H.tool_after!=after || H.tool_kind!=kind {return}
        if data.resourceId!=resource || data.engagementId!=engagement {H.notice=A.t("The response did not match this resource and agent.","响应与当前资源及 Agent 不匹配。") return}
        if kind=="rules" {for row in data.grants {if row.resourceId!=resource || row.engagementId!=engagement {H.notice=A.t("The permission belongs to a different agent.","此权限属于其他 Agent。") return}}}
        if kind=="requests" && engagement!="" {for row in data.approvals {if row.engagementId!=engagement {H.notice=A.t("The request belongs to a different agent.","此请求属于其他 Agent。") return}}}
        H.tool_page=data
    })
}
A.review_tool_grant = fn(row){
    if H.busy || H.command!=nil || H.page!="tool_grants" || H.tool_page==nil || row.revoked || row.resourceId!=H.tool_resource || row.engagementId!=H.tool_engagement {return}
    let found=false
    for current in H.tool_page.grants {if current.id==row.id && current.revision==row.revision && !current.revoked {found=true}}
    if !found {return}
    H.tool_draft={id:row.id resourceId:row.resourceId engagementId:row.engagementId revision:row.revision agent:row.agent kind:row.kind mode:row.mode taskId:row.taskId details:row.details} H.page="tool_grant_review" H.notice="" A.redraw()
}
A.submit_tool_grant = fn(){
    if H.busy || H.command!=nil || H.page!="tool_grant_review" || H.tool_draft==nil || H.tool_page==nil {return}
    H.tool_last=H.tool_draft
    let d=H.tool_draft let found=false
    if d.resourceId==H.tool_resource && d.engagementId==H.tool_engagement {for row in H.tool_page.grants {if row.id==d.id && row.revision==d.revision && !row.revoked {found=true}}}
    if !found {H.tool_draft=nil H.tool_page=nil H.page="tool_grants" H.notice=A.tool_error("management_revision_conflict") A.redraw() return}
    A.submit("hagency.tool_grants.revoke",{resourceId:d.resourceId engagementId:d.engagementId grantId:d.id expectedRevision:d.revision})
}
A.valid_tool_result = fn(data,args){
    if !data.is_object() {return false}
    let {resourceId=nil,engagementId=nil,grantId=nil,reviewedRevision=nil,revoked=false}=data
    return revoked && resourceId==args.resourceId && engagementId==args.engagementId && grantId==args.grantId && reviewedRevision==args.expectedRevision
}
A.tool_grant_received = fn(data){
    H.tool_result=data H.tool_resource=data.resourceId H.tool_engagement=data.engagementId H.tool_after="" H.tool_kind="rules" H.tool_page=nil H.tool_draft=nil H.page="tool_grant_result" H.notice=""
}
A.tool_grant_reply = fn(command,r){
    if r.is_ok {
        if !A.valid_tool_result(r.data,command.args) {H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.tool_grant_received(r.data)
        if A.save() {A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.tool_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" {
            H.command=nil H.tool_draft=nil H.tool_page=nil H.page="tool_grants"
            if A.save() {A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

A.stopped_attempt_valid=fn(row,resource){
    if !row.is_object(){return false}
    let {resourceId=nil,engagementId=nil,dispatchId=nil,agent=nil,projectId=nil,fence=nil,inspectionAvailable=nil,sharedResourceAuthority=nil}=row
    return resourceId==resource && engagementId.is_string() && engagementId!="" && dispatchId.is_string() && dispatchId!="" && agent.is_string() && projectId.is_string() && fence.is_number() && fence>0 && floor(fence)==fence && (inspectionAvailable==true || inspectionAvailable==false) && (sharedResourceAuthority==true || sharedResourceAuthority==false)
}
A.stopped_valid=fn(data,args){
    if !data.is_object(){return false}
    let {attempt=nil,revision=nil,resolvable=nil,canContinue=nil,entryCount=nil,entries=nil,nextEntry=nil}=data
    if !A.stopped_attempt_valid(attempt,args.resourceId) || attempt.engagementId!=args.engagementId || attempt.dispatchId!=args.dispatchId || !revision.is_string() || revision.len()!=64 {return false}
    if (resolvable!=true && resolvable!=false) || (canContinue!=true && canContinue!=false) || (canContinue && !resolvable) || !entryCount.is_number() || entryCount<0 || entryCount>1024 || floor(entryCount)!=entryCount || (!entries.is_array() && !entries.is_object()) || entries.len()>8 {return false}
    let {entryOffset=0}=args
    if nextEntry!=nil && (!nextEntry.is_number() || nextEntry<=entryOffset || nextEntry>=entryCount || floor(nextEntry)!=nextEntry){return false}
    for entry in entries {if !entry.is_object(){return false} let {relativePath=nil,kind=nil}=entry if !relativePath.is_string() || relativePath=="" || (kind!="file" && kind!="directory" && kind!="symlink"){return false}}
    return true
}
A.stopped_error=fn(code){
    if code=="management_stopped_not_resolvable" {return A.t("This attempt cannot be resolved from the current evidence. Refresh its inspection.","当前证据不足以处理此执行，请刷新检查结果。")}
    if code=="management_stopped_review_expired" {return A.t("The review expired. Refresh and review the task again.","检查已过期，请刷新后重新检查任务。")}
    if code=="management_revision_conflict" {return A.t("The task changed after inspection. Refresh before making a decision.","任务在检查后发生变化，请刷新后再决定。")}
    return A.error_text(code)
}
A.stopped_done_title=fn(action){
    if action=="continue" {return A.t("It Will Finish the Rest","会接着做完")}
    if action=="accept_completed" {return A.t("Marked as Done","已按完成处理")}
    return A.t("Task Paused","任务已暂停")
}
A.stopped_action_label=fn(action){
    if action=="continue" {return A.t("Finish the rest","继续剩下的工作")}
    if action=="accept_completed" {return A.t("It’s done","确认已经完成")}
    return A.t("Pause the task","先暂停这个任务")
}
// One-tap answers to "did you look at what it left?", per action. The chosen
// sentence is the operator note the server records; a typed line is optional.
A.stopped_checks=fn(action){
    if action=="continue" {return [
        {key:"fine" text:A.t("No need; carry on","不用核对，接着做")},
        {key:"agent" text:A.t("Let the Agent check them first","让 Agent 先核对一遍")}
    ]}
    if action=="accept_completed" {return [
        {key:"fine" text:A.t("I checked them on this computer; it’s fine","我在电脑上看过，没问题")},
        {key:"trust" text:A.t("Accept it without checking","不核对，直接按完成处理")}
    ]}
    return [
        {key:"later" text:A.t("Haven’t checked yet; pause it","还没检查，先暂停")},
        {key:"problem" text:A.t("Found a problem; pause it","发现了问题，先暂停")}
    ]
}
A.stopped_title=fn(){
    if H.stopped_detail==nil {return ""}
    let title=A.recipient_optional(H.stopped_detail,"taskTitle")
    return if title==nil {A.t("the task","这个任务")} else {"「"+title+"」"}
}
// The instruction a continuation starts from; the owner may edit it.
A.stopped_default_instruction=fn(check){
    if check=="agent" {return A.t("First check that the files in the workspace are complete, then finish the rest of "+A.stopped_title()+".","先核对工作区里的文件是否完整，再接着完成"+A.stopped_title()+"剩下的部分。")}
    return A.t("Finish the rest of "+A.stopped_title()+".","接着完成"+A.stopped_title()+"剩下的部分。")
}
A.stopped_pick_check=fn(key){
    if !A.stopped_can_decide() || H.stopped_mode!="choose" || H.stopped_action=="" {return}
    let found={text:""}
    for c in A.stopped_checks(H.stopped_action) {if c.key==key {found.text=c.text}}
    if found.text=="" {return}
    let before=H.stopped_check
    H.stopped_check=key H.stopped_note=found.text
    if H.stopped_action=="continue" && (H.stopped_instruction=="" || H.stopped_instruction==A.stopped_default_instruction(before)) {H.stopped_instruction=A.stopped_default_instruction(key)}
    A.redraw()
}
// What the server records: the chosen answer, plus the optional typed line.
A.stopped_full_note=fn(){
    let extra=H.stopped_extra.trim()
    return if extra=="" {H.stopped_note} else {H.stopped_note+A.t(" — ","；")+extra}
}
// Interrupted tasks list inside Health & Recovery, optionally for one workspace.
A.open_stopped_tasks=fn(resource,workspace,after){
    if H.busy || resource==""{return}
    H.stopped_after=after H.stopped_list=nil H.stopped_review=nil H.stopped_detail=nil
    H.nav.anchor="health_stopped"
    A.health_open(resource,nil,if workspace==nil {""} else {workspace})
}
A.open_stopped=fn(resource,engagement,dispatch,offset){
    if H.busy{return}
    let args={resourceId:resource engagementId:engagement dispatchId:dispatch entryOffset:offset}
    H.page="stopped_task" H.stopped_resource=resource H.stopped_engagement=engagement H.stopped_dispatch=dispatch H.stopped_offset=offset H.stopped_detail=nil H.stopped_review=nil H.stopped_mode="inspect" H.stopped_result=nil H.stopped_note="" H.stopped_instruction="" H.stopped_action="" H.stopped_check="" H.stopped_extra="" H.notice=""
    A.request("hagency.stopped.get",args,fn(data){
        if H.page!="stopped_task" || H.stopped_resource!=resource || H.stopped_engagement!=engagement || H.stopped_dispatch!=dispatch || H.stopped_offset!=offset{return}
        if !A.stopped_valid(data,args){H.notice=A.error_text("management_invalid_result") return}
        H.stopped_detail=data
    })
}
A.review_stopped=fn(){
    let row=H.stopped_detail
    if H.busy || H.command!=nil || H.page!="stopped_task" || H.stopped_mode!="inspect" || row==nil || !row.resolvable || !row.attempt.sharedResourceAuthority{return}
    if row.attempt.resourceId!=H.stopped_resource || row.attempt.engagementId!=H.stopped_engagement || row.attempt.dispatchId!=H.stopped_dispatch{return}
    A.submit("hagency.stopped.review",{resourceId:H.stopped_resource engagementId:H.stopped_engagement dispatchId:H.stopped_dispatch expectedRevision:row.revision})
}
A.stopped_review_valid=fn(data,args){
    if !data.is_object(){return false}
    let {reviewCommandId=nil,inspectionId=nil,expiresAt=nil,inspection=nil}=data
    return reviewCommandId==args.commandId && inspectionId.is_string() && inspectionId!="" && expiresAt.is_number() && expiresAt>0 && A.stopped_valid(inspection,args) && inspection.resolvable && inspection.attempt.sharedResourceAuthority && inspection.revision==args.expectedRevision
}
A.stopped_result_valid=fn(data,args){
    if !data.is_object(){return false}
    let {commandId=nil,resourceId=nil,engagementId=nil,dispatchId=nil,action=nil,taskId=nil,taskStatus=nil,replacementId=nil,resolvedAt=nil}=data
    if commandId!=args.commandId || resourceId!=args.resourceId || engagementId!=args.engagementId || dispatchId!=args.dispatchId || action!=args.action || !taskId.is_string() || taskId=="" || !resolvedAt.is_number() || resolvedAt<=0{return false}
    if action=="continue" {return taskStatus=="in_progress" && replacementId.is_string() && replacementId!=""}
    return replacementId==nil && ((action=="accept_completed" && taskStatus=="done") || (action=="keep_blocked" && taskStatus=="blocked"))
}
A.stopped_review_received=fn(data){
    let row=data.inspection
    H.stopped_resource=row.attempt.resourceId H.stopped_engagement=row.attempt.engagementId H.stopped_dispatch=row.attempt.dispatchId H.stopped_review=data H.stopped_detail=row H.stopped_result=nil H.stopped_mode="choose" H.page="stopped_task" H.stopped_action="" H.stopped_note="" H.stopped_instruction="" H.stopped_check="" H.stopped_extra="" H.notice=""
}
A.stopped_result_received=fn(data){
    H.stopped_resource=data.resourceId H.stopped_engagement=data.engagementId H.stopped_dispatch=data.dispatchId H.stopped_result=data H.stopped_review=nil H.stopped_detail=nil H.stopped_mode="result" H.page="stopped_task" H.notice=""
}
A.stopped_can_decide=fn(){
    if H.busy || H.command!=nil || H.page!="stopped_task" || H.stopped_review==nil || H.stopped_detail==nil{return false}
    let r=H.stopped_review let d=H.stopped_detail
    return r.inspection.revision==d.revision && d.resolvable && d.attempt.sharedResourceAuthority && d.attempt.resourceId==H.stopped_resource && d.attempt.engagementId==H.stopped_engagement && d.attempt.dispatchId==H.stopped_dispatch
}
A.choose_stopped=fn(action){
    if !A.stopped_can_decide() || H.stopped_mode!="choose"{return}
    if action!="continue" && action!="accept_completed" && action!="keep_blocked"{return}
    if action=="continue" && !H.stopped_detail.canContinue{return}
    let changed=H.stopped_action!=action
    H.stopped_action=action
    // Each action starts from its first answer; the owner can tap the other one.
    if changed {
        let checks=A.stopped_checks(action)
        H.stopped_check=checks[0].key H.stopped_note=checks[0].text
        H.stopped_instruction=if action=="continue" {A.stopped_default_instruction(checks[0].key)} else {""}
    }
    A.redraw()
}
// What the choose step still needs, said under its button; "" when it can go on.
A.stopped_missing=fn(){
    if H.stopped_action=="" {return A.t("Choose what to do with the task first.","请先选择处理方式。")}
    if H.stopped_note.trim()=="" {return A.t("Pick one answer first.","请先选一个答案。")}
    if A.stopped_full_note().len()>2000 {return A.t("Keep the note under 2,000 characters.","说明请控制在 2000 字以内。")}
    if H.stopped_action=="continue" && H.stopped_instruction.trim()=="" {return A.t("Write down what’s left to do.","请写下还剩哪些工作。")}
    if H.stopped_action=="continue" && H.stopped_instruction.len()>8000 {return A.t("Keep what’s left under 8,000 characters.","剩余工作请控制在 8000 字以内。")}
    return ""
}
// Typing doesn't redraw the page; update the button and its reason in place.
A.stopped_form_refresh=fn(){
    if H.page!="stopped_task" || H.stopped_mode!="choose" {return}
    let why=A.stopped_missing()
    ui.stopped_confirm_review.set_enabled(A.stopped_can_decide() && why=="")
    ui.stopped_missing.set_text(why) ui.stopped_missing.set_visible(why!="")
}
A.confirm_stopped=fn(){
    if !A.stopped_can_decide() || H.stopped_mode!="choose" || H.stopped_action=="" || H.stopped_note.trim()=="" || A.stopped_full_note().len()>2000{return}
    if H.stopped_action=="continue" && (!H.stopped_detail.canContinue || H.stopped_instruction.trim()=="" || H.stopped_instruction.len()>8000){return}
    H.stopped_mode="confirm" A.redraw()
}
A.submit_stopped=fn(){
    if !A.stopped_can_decide() || H.stopped_mode!="confirm" || H.stopped_action=="" || H.stopped_note.trim()=="" || A.stopped_full_note().len()>2000{return}
    if H.stopped_action=="continue" && (!H.stopped_detail.canContinue || H.stopped_instruction.trim()=="" || H.stopped_instruction.len()>8000){return}
    if H.stopped_action!="continue" && H.stopped_action!="accept_completed" && H.stopped_action!="keep_blocked"{return}
    A.submit("hagency.stopped.resolve",{resourceId:H.stopped_resource engagementId:H.stopped_engagement dispatchId:H.stopped_dispatch reviewCommandId:H.stopped_review.reviewCommandId reviewRevision:H.stopped_review.inspection.revision action:H.stopped_action operatorNote:A.stopped_full_note() continuationInstruction:if H.stopped_action=="continue" {H.stopped_instruction}else{nil}})
}
A.stopped_reply=fn(command,r){
    if r.is_ok {
        let reviewing=command.service=="hagency.stopped.review"
        if (reviewing && !A.stopped_review_valid(r.data,command.args)) || (!reviewing && !A.stopped_result_valid(r.data,command.args)){H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil
        if reviewing {A.stopped_review_received(r.data)}else{A.stopped_result_received(r.data)}
        if A.save(){A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.stopped_error(r.error)
        if r.error=="invalid_management_arguments" || r.error=="management_not_found" || r.error=="management_revision_conflict" || r.error=="management_stopped_not_resolvable" || r.error=="management_stopped_review_expired" {
            H.command=nil H.stopped_review=nil H.stopped_detail=nil H.stopped_mode="inspect" H.page="stopped_task"
            if A.save(){A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

A.workspace_valid=fn(data,resource,workspace){
    if !data.is_object(){return false}
    let {resourceId=nil,workspaceId=nil,dirty=nil,activeLeases=nil,quarantined=nil,sharedResourceCount=nil,releaseBlock=nil,lastReleasedAt=nil,revision=nil}=data
    if resourceId!=resource || workspaceId!=workspace || !workspaceId.is_string() || workspaceId=="" || !revision.is_string() || revision.len()!=64 {return false}
    if (dirty!=true && dirty!=false) || (quarantined!=true && quarantined!=false) || !activeLeases.is_number() || activeLeases<0 || floor(activeLeases)!=activeLeases || !sharedResourceCount.is_number() || sharedResourceCount<1 || floor(sharedResourceCount)!=sharedResourceCount {return false}
    if lastReleasedAt!=nil && (!lastReleasedAt.is_number() || lastReleasedAt<0) {return false}
    if releaseBlock!=nil && releaseBlock!="inspection_required" && releaseBlock!="active_execution" && releaseBlock!="shared_resource_authority" {return false}
    if releaseBlock==nil && (activeLeases>0 || quarantined) {return false}
    return true
}
A.workspace_state=fn(row){
    if row.releaseBlock=="shared_resource_authority" {return A.t("Shared workspace · access required","共享工作区 · 需要权限")}
    if row.quarantined {return A.t("Execution outcome needs inspection","需要检查执行结果")}
    if row.activeLeases>0 {return A.t("Task running","任务运行中")}
    if row.dirty {return A.t("Workspace needs review","工作区需要你检查")}
    return A.t("Ready","就绪")
}
A.workspace_error=fn(code){
    if code=="management_workspace_inspection_required" {return A.t("An execution outcome is unresolved. Inspect the stopped task before releasing this workspace.","有执行结果尚未确认。请先检查已停止的任务，再解除工作区标记。")}
    if code=="management_workspace_active" {return A.t("A task still holds this workspace. Wait for it to finish, then refresh.","任务仍占用此工作区，请等待任务结束后刷新。")}
    if code=="management_revision_conflict" {return A.t("Workspace activity changed. Refresh and review the latest state.","工作区有新的变化，请刷新后再看。")}
    return A.error_text(code)
}
// Workspaces list inside Health & Recovery.
A.open_workspaces=fn(resource,after){
    if H.busy || resource=="" {return}
    H.workspace_after=after H.workspace_list=nil H.workspace_detail=nil H.workspace_review=nil
    H.nav.anchor="health_workspaces"
    A.health_open(resource,nil,"")
}
A.open_workspace=fn(resource,workspace){
    if H.busy || resource=="" || workspace=="" {return}
    H.page="workspace" H.workspace_resource=resource H.workspace_id=workspace H.workspace_detail=nil H.workspace_review=nil H.workspace_mode="detail" H.notice=""
    A.request("hagency.workspaces.get",{resourceId:resource workspaceId:workspace},fn(data){
        if H.page!="workspace" || H.workspace_resource!=resource || H.workspace_id!=workspace {return}
        if !A.workspace_valid(data,resource,workspace){H.notice=A.error_text("management_invalid_result") return}
        H.workspace_detail=data
    })
}
A.workspace_can_clear=fn(){
    let row=H.workspace_detail
    return !H.busy && H.command==nil && H.page=="workspace" && H.workspace_mode=="detail" && row!=nil && A.workspace_valid(row,H.workspace_resource,H.workspace_id) && row.dirty && row.releaseBlock==nil && !row.quarantined && row.activeLeases==0
}
A.review_workspace=fn(){
    if !A.workspace_can_clear(){return}
    let row=H.workspace_detail
    H.workspace_review={resourceId:row.resourceId workspaceId:row.workspaceId expectedRevision:row.revision}
    H.workspace_mode="review" A.redraw()
}
A.submit_workspace=fn(){
    if H.busy || H.command!=nil || H.page!="workspace" || H.workspace_mode!="review" || H.workspace_review==nil || H.workspace_detail==nil {return}
    let d=H.workspace_review let row=H.workspace_detail
    if !A.workspace_valid(row,H.workspace_resource,H.workspace_id) || d.resourceId!=row.resourceId || d.workspaceId!=row.workspaceId || d.expectedRevision!=row.revision || !row.dirty || row.releaseBlock!=nil || row.quarantined || row.activeLeases!=0 {return}
    A.submit("hagency.workspaces.clear_dirty",d.to_json().parse_json())
}
A.valid_workspace_result=fn(data,args){
    if !data.is_object(){return false}
    let {workspace=nil,cleared=nil}=data
    return (cleared==true || cleared==false) && A.workspace_valid(workspace,args.resourceId,args.workspaceId) && !workspace.dirty && workspace.releaseBlock==nil && workspace.lastReleasedAt!=nil
}
A.workspace_received=fn(data){
    let row=data.workspace
    H.workspace_resource=row.resourceId H.workspace_id=row.workspaceId H.workspace_detail=row H.workspace_review=nil H.workspace_list=nil H.workspace_mode="result" H.page="workspace" H.notice=""
}
A.workspace_reply=fn(command,r){
    if r.is_ok {
        if !A.valid_workspace_result(r.data,command.args){H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.workspace_received(r.data)
        if A.save(){A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.workspace_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" || r.error=="management_workspace_inspection_required" || r.error=="management_workspace_active" {
            H.command=nil H.workspace_detail=nil H.workspace_review=nil H.workspace_mode="detail" H.page="workspace"
            if A.save(){A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

H.shared_approvals=[]
A.shared_mode = fn(row){let {sharedMode=nil}=row return sharedMode}
A.policy_mode_label = fn(row){return if A.shared_mode(row)=="chat" {A.t("Chat only","仅聊天")}else{A.policy_label(row.executionPolicy.yolo)}}
A.policy_label = fn(yolo){return if yolo {A.t("Full trust (unrestricted)","完全信任（不受限）")}else{A.t("Standard permissions","标准权限")}}
A.policy_valid = fn(data,resource,engagement){
    if !data.is_object() {return false}
    let {resourceId=nil,engagementId=nil,agent=nil,projectId=nil,framework=nil,executionPolicy=nil,revision=nil,appliesTo=nil}=data
    if resourceId!=resource || engagementId!=engagement || !agent.is_string() || !projectId.is_string() || !framework.is_string() || !revision.is_string() || revision.len()!=64 || appliesTo!="next_dispatch" || !executionPolicy.is_object() {return false}
    let {yolo=nil}=executionPolicy
    return (yolo==true || yolo==false) && (!yolo || framework=="codex")
}
// Permission requests are part of the Tools & Permissions hub's Pending tab.
A.open_shared_approvals = fn(){
    if H.busy {return}
    let resource=if H.tools_resource!="" {H.tools_resource} else {H.policy_resource}
    if resource=="" {H.page="tool_approvals" H.tool_page=nil A.tools_shared_load() A.redraw() return}
    A.open_tools(resource,"","","requests")
}
A.decide_shared_approval = fn(row,decision){
    if H.busy || row.canDecide!=true || row.decision!=nil {return}
    let id=row.approval.id
    H.shared_sending=id H.shared_failed="" H.shared_failure=""
    A.sub_read("hagency.shared_approvals.decide",{id:id digest:row.digest decision:decision},fn(data){
        H.shared_sending="" A.tools_shared_load()
    },fn(code){
        H.shared_sending="" H.shared_failed=id H.shared_failure=A.shared_decide_error(code)
        if code=="approval_request_changed" || code=="management_not_found" || code=="management_action_closed" {A.tools_shared_load()}
    })
}
A.open_policies = fn(resource,after){
    if H.busy || resource=="" {return}
    H.page="execution_policies" H.tools_resource=resource H.policy_resource=resource H.policy_after=after H.policy_list=nil H.policy_detail=nil H.policy_draft=nil H.notice=""
    A.request("hagency.execution_policy.list",{resourceId:resource after:after},fn(data){
        if H.page!="execution_policies" || H.policy_resource!=resource || H.policy_after!=after {return}
        if !data.is_object() {H.notice=A.error_text("management_invalid_result") return}
        let {resourceId=nil,agents=nil,nextAfter=nil}=data
        if resourceId!=resource || (!agents.is_array() && !agents.is_object()) || agents.len()>16 || (nextAfter!=nil && (!nextAfter.is_string() || nextAfter==after)) {H.notice=A.error_text("management_invalid_result") return}
        for row in agents {if !row.is_object() {H.notice=A.error_text("management_invalid_result") return} let {engagementId=""}=row if !A.policy_valid(row,resource,engagementId) {H.notice=A.error_text("management_invalid_result") return}}
        H.policy_list=data
    })
}
A.open_policy = fn(resource,engagement){
    if H.busy || resource=="" || engagement=="" {return}
    H.page="execution_policy" H.policy_resource=resource H.policy_engagement=engagement H.policy_detail=nil H.policy_draft=nil H.policy_mode="detail" H.notice=""
    A.request("hagency.execution_policy.get",{resourceId:resource engagementId:engagement},fn(data){
        if H.page!="execution_policy" || H.policy_resource!=resource || H.policy_engagement!=engagement {return}
        if !A.policy_valid(data,resource,engagement) {H.notice=A.error_text("management_invalid_result") return}
        H.policy_detail=data
    })
}
A.open_policy_grants = fn(){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_detail==nil || (H.policy_mode!="detail" && H.policy_mode!="result") {return}
    let row=H.policy_detail
    if row.resourceId!=H.policy_resource || row.engagementId!=H.policy_engagement {return}
    if A.shared_mode(row)!=nil {A.open_shared_approvals() return}
    A.open_tools(row.resourceId,row.engagementId,"","rules")
}
A.choose_policy = fn(yolo){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_detail==nil || H.policy_mode=="result" {return}
    let row=H.policy_detail
    if yolo && row.framework!="codex" {return}
    H.policy_draft={resourceId:row.resourceId engagementId:row.engagementId expectedRevision:row.revision executionPolicy:{yolo:yolo}}
    H.policy_mode="edit" H.notice="" A.redraw()
}
A.review_policy = fn(){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_detail==nil || H.policy_draft==nil || H.policy_mode!="edit" {return}
    let d=H.policy_draft let row=H.policy_detail
    if d.resourceId!=row.resourceId || d.engagementId!=row.engagementId || d.expectedRevision!=row.revision || (d.executionPolicy.yolo==row.executionPolicy.yolo && A.shared_mode(row)!="chat") {return}
    H.policy_mode="review" A.redraw()
}
A.submit_policy = fn(){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_mode!="review" || H.policy_draft==nil || H.policy_detail==nil {return}
    let d=H.policy_draft let row=H.policy_detail
    if d.resourceId!=H.policy_resource || d.engagementId!=H.policy_engagement || d.expectedRevision!=row.revision || (d.executionPolicy.yolo && row.framework!="codex") {return}
    A.submit("hagency.execution_policy.edit",d.to_json().parse_json())
}
A.valid_policy_result = fn(data,args){return A.policy_valid(data,args.resourceId,args.engagementId) && data.executionPolicy.yolo==args.executionPolicy.yolo}
A.policy_received = fn(data){
    H.policy_resource=data.resourceId H.policy_engagement=data.engagementId H.policy_detail=data H.policy_draft=nil H.policy_list=nil H.policy_mode="result" H.page="execution_policy" H.notice=""
}
A.policy_reply = fn(command,r){
    if r.is_ok {
        if !A.valid_policy_result(r.data,command.args) {H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.policy_received(r.data)
        if A.save() {A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.tool_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" {
            H.command=nil H.policy_draft=nil H.policy_detail=nil H.policy_mode="detail" H.page="execution_policy"
            if A.save() {A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

// Resource subpages: two hubs (Tools & Permissions, Health & Recovery) and
// their detail pages share one top bar, one readable column and the states below.
A.sub_page=fn(){return (H.page=="connections" && H.entry_role=="owner") || A.has_page(["tool_approvals","shared_approvals","execution_policies","approval_bindings","tool_request","execution_policy","tool_grants","tool_grant_review","tool_grant_result","approval_binding_review","approval_binding_result","health_hub","resource_alert","stopped_task","workspace","templates","template","template_edit","template_command","web_catalog","web_catalog_command","pool_requests","default_policy"]) || (H.page=="action" && H.entry_role=="owner") || A.pool_sub_page()}
A.tools_hub_page=fn(){return A.has_page(["tool_approvals","shared_approvals","execution_policies","approval_bindings"])}
A.tools_tab=fn(){if H.page=="execution_policies" {return "agents"} if H.page=="approval_bindings" {return "rooms"} return "pending"}
// Openers for other pages: the hub shows one tab, chosen with "pending", "agents" or "rooms".
A.open_tools_hub_tab=fn(resource,tab){
    if H.busy || resource=="" {return}
    if tab=="agents" {A.open_policies(resource,"") return}
    if tab=="rooms" {A.open_bindings(resource,"") return}
    A.open_tools(resource,"","","requests")
}
A.open_tools_hub=fn(resource){A.open_tools_hub_tab(resource,"pending")}
A.open_tools_tab=fn(tab){A.open_tools_hub_tab(H.tools_resource,tab)}
A.open_health_hub=fn(resource){A.health_open(resource,nil,"")}
// Navigation for the owner's pages: a push/pop stack. An entry is plain data
// (kind, identity, title) that A.nav_reopen opens again, so back returns to the
// page it came from, and the back label is that page's title.
A.nav_entry=fn(){
    if H.entry_role!="owner" || H.session==nil {return nil}
    let p=H.page
    let e={key:"" kind:p title:A.nav_title() a:"" b:"" c:""}
    if p=="resources" || p=="inbox" {e.key=p return e}
    if p=="pool_requests" {e.key=(if A.reqs_stop_view() {"stop/"} else {"requests/"})+H.reqs.pool e.a=H.reqs.pool e.b=H.reqs.label e.c=H.reqs.hint return e}
    if p=="pool_agent" {e.key="request/"+H.reqs.agent e.a=H.reqs.agent return e}
    if p=="resource_detail" {e.key="pool/"+H.resource_id e.a=H.resource_id return e}
    if p=="resource_edit" || p=="resource_create" {e.key=p+"/"+H.resource_id e.a=H.resource_id return e}
    if A.tools_hub_page() {e.kind="tools" e.key="tools/"+H.tools_resource e.a=H.tools_resource e.b=A.tools_tab() return e}
    if p=="tool_request" {e.key="tool/"+H.tool_request_id e.a=H.tool_resource e.b=H.tool_request_id return e}
    if p=="execution_policy" {e.key="policy/"+H.policy_engagement e.a=H.policy_resource e.b=H.policy_engagement return e}
    if p=="tool_grants" || p=="tool_grant_review" || p=="tool_grant_result" {e.kind="tool_grants" e.key="grants/"+H.tool_engagement e.a=H.tool_resource e.b=H.tool_engagement return e}
    if p=="approval_binding_review" || p=="approval_binding_result" {
        let eng=if H.binding_draft!=nil {H.binding_draft.engagementId} else if H.binding_result!=nil {H.binding_result.binding.engagementId} else {""}
        e.kind="binding" e.key="binding/"+eng e.a=H.binding_resource e.b=eng return e
    }
    if p=="health_hub" {e.key="health/"+H.health.resource e.a=H.health.resource e.b=H.health.alerts.filter e.c=H.health.workspace return e}
    if p=="resource_alert" {e.key="alert/"+H.alert_id e.a=H.alert_resource e.b=H.alert_id return e}
    if p=="stopped_task" {e.key="stopped/"+H.stopped_dispatch e.a=H.stopped_resource e.b=H.stopped_engagement e.c=H.stopped_dispatch return e}
    if p=="workspace" {e.key="workspace/"+H.workspace_id e.a=H.workspace_resource e.b=H.workspace_id return e}
    if p=="templates" {e.key="templates/"+H.templates.resourceId e.a=H.templates.resourceId return e}
    if p=="template" {e.key="template/"+H.templates.id e.a=H.templates.resourceId e.b=H.templates.id return e}
    if p=="template_edit" || p=="template_command" {e.key=p+"/"+H.templates.resourceId e.a=H.templates.resourceId return e}
    if p=="web_catalog" {e.key="catalog/"+H.web.resourceId e.a=H.web.resourceId e.b=H.web.section return e}
    if p=="web_catalog_command" {e.key="catalog_change/"+H.web.resourceId e.a=H.web.resourceId return e}
    if p=="default_policy" {e.key="default_policy/"+H.dpol.resource e.a=H.dpol.resource return e}
    if p=="action" {e.key="server/"+H.ux.connectionId e.a=H.ux.connectionId return e}
    if p=="pool_device" {e.key="device" e.a=H.pool_device_from return e}
    if A.dev_page() {e.key="device/"+p e.a=H.pool_device_from return e}
    if p=="pool_who" || p=="pool_advanced" || p=="pool_glossary" {e.key=p+"/"+H.pool_sub_rid e.a=H.pool_sub_rid return e}
    return nil
}
// The title each page shows, whether or not it has scrolled under the bar.
A.nav_title=fn(){
    let p=H.page
    if p=="resources" {return A.t("Pools","资源池")}
    if p=="inbox" {return A.t("Agent Requests","Agent 申请")}
    if p=="pool_requests" {return if A.reqs_stop_view() {A.t("Stop Some Agents","停止部分 Agent")} else {A.t("Requests","申请")}}
    if p=="pool_agent" {return if H.pool_detail!=nil {H.pool_detail.definition.name} else {A.t("Request","申请")}}
    if p=="resource_detail" {let name=A.sub_pool_name(H.resource_id) return if name!="" {name} else {A.t("Pool","资源池")}}
    if p=="resource_edit" {return A.t("Model","模型")}
    if p=="resource_create" {return A.t("Another Pool","再建一个资源池")}
    if A.tools_hub_page() {return A.t("Tools & Permissions","工具与权限")}
    if p=="tool_request" {return if H.tool_selected!=nil {A.tool_agent(H.tool_selected.subject)} else {A.t("Tool Request","工具请求")}}
    if p=="execution_policy" {return if H.policy_detail!=nil {H.policy_detail.agent} else {A.t("Agent Permissions","Agent 权限")}}
    if p=="tool_grants" || p=="tool_grant_review" || p=="tool_grant_result" {return A.t("Saved Tool Permissions","已保存的工具权限")}
    if p=="approval_binding_review" || p=="approval_binding_result" {return A.t("Approval Room","审批聊天")}
    if p=="health_hub" {return A.t("Health & Recovery","健康与恢复")}
    if p=="resource_alert" {return A.t("Alert","告警")}
    if p=="stopped_task" {return A.t("Interrupted Task","中断的任务")}
    if p=="workspace" {return A.t("Workspace","工作区")}
    if p=="templates" {return A.t("Agent Templates","Agent 模板")}
    if p=="template" {return if H.templates.detail!=nil {H.templates.detail.definition.name} else {A.t("Template","模板")}}
    if p=="template_edit" {return A.t("Edit Template","编辑模板")}
    if p=="template_command" {return A.t("Review","确认更改")}
    if p=="web_catalog" {return A.t("Public Listing","对外展示")}
    if p=="web_catalog_command" && A.web_retire_review() {return A.t("Delete Pool","删除资源池")}
    if p=="web_catalog_command" {return A.t("Review","确认更改")}
    if p=="default_policy" {return A.t("New Agent Permissions","新 Agent 默认权限")}
    if p=="action" {return A.t("Server & Publishing","服务器与发布")}
    if A.pool_sub_page() {return A.pool_sub_title()}
    return ""
}
// Back labels are the previous title, shortened: the part before " · " when it fits.
A.nav_width=fn(c){let one="".to_chars() one.push(c) return if one.to_string().len()==1 {1} else {2}}
A.nav_units=fn(text){let w={n:0} for c in text.to_chars() {w.n=w.n+A.nav_width(c)} return w.n}
A.nav_short=fn(text){
    let limit=if mod.widgets.RINX_TEXT_SCALE>1.2 {12} else {18}
    if A.nav_units(text)<=limit {return text}
    let parts=text.split(" · ")
    if parts.len()>1 && A.nav_units(parts[0])<=limit {return parts[0]}
    let out="".to_chars() let w={n:0 full:false}
    for c in text.to_chars() {let cw=A.nav_width(c) if !w.full && w.n+cw<=limit-1 {out.push(c) w.n=w.n+cw} else {w.full=true}}
    return out.to_string().trim()+"…"
}
A.nav_back_title=fn(){let n=H.nav if n.stack.len()==0 {return ""} return A.nav_short(n.stack[n.stack.len()-1].title)}
A.nav_label=fn(fallback){let title=A.nav_back_title() return if title!="" {title} else {fallback}}
// Called on every redraw: a new page pushes the one it replaced, unless it is
// that page's parent coming back. A tab root, or a page outside the stack, clears it.
A.nav_track=fn(){
    // A note left on the list describes that visit only; leaving the list clears it.
    if H.page!="resources" {H.pool_list_result=nil}
    let n=H.nav
    let e=A.nav_entry()
    let key=if e==nil {""} else {e.key}
    let old=if n.here==nil {""} else {n.here.key}
    if key!=old {
        let top=if n.stack.len()>0 {n.stack[n.stack.len()-1].key} else {""}
        if key=="" || key=="resources" || key=="inbox" {n.stack=[]}
        else if top==key {n.stack.pop()}
        else if n.popping=="" && n.here!=nil {n.stack.push(n.here) if n.stack.len()>24 {n.stack.remove(0)}}
        n.popping=""
    }
    n.here=e
}
A.nav_back=fn(){
    let n=H.nav
    if H.busy || n.stack.len()==0 {return false}
    let e=n.stack.pop()
    n.popping=e.key n.anchor="" H.ux.restore=true
    A.nav_reopen(e)
    n.popping=""
    return true
}
// Pages with a server change go back through their own finish step.
// The review of deleting a pool, before it is confirmed.
A.web_retire_review=fn(){
    let w=H.web
    if H.page!="web_catalog_command" || w.pending==nil || w.phase!="saved" {return false}
    return A.recipient_optional(w.pending.change,"operation")=="retire"
}
A.nav_back_own=fn(){return (H.page=="template_command" && H.templates.pending!=nil) || (H.page=="web_catalog_command" && H.web.pending!=nil)}
A.nav_back_sub=fn(){if A.nav_back_own() {return false} return A.nav_back()}
A.nav_reopen=fn(e){
    let k=e.kind
    if k=="resources" || k=="inbox" {A.return_list(k) return}
    if k=="pool_requests" {A.reqs_reopen(e.a,e.b,e.c) return}
    if k=="pool_agent" {A.open_pool_agent(e.a) return}
    if k=="resource_detail" {A.open_resource(e.a) return}
    if k=="resource_edit" {if H.resource_edit_draft!=nil && H.resource_detail!=nil {H.page="resource_edit" H.notice="" A.redraw()} else {A.open_resource(e.a)} return}
    if k=="resource_create" {if H.resource_create_draft!=nil && H.resource_detail!=nil {H.page="resource_create" H.notice="" A.redraw()} else {A.open_resource(e.a)} return}
    if k=="tools" {A.open_tools_hub_tab(e.a,e.b) return}
    if k=="tool_request" {H.tool_resource=e.a A.open_tool_request(e.b) return}
    if k=="execution_policy" {A.open_policy(e.a,e.b) return}
    if k=="tool_grants" {A.open_tools(e.a,e.b,"","rules") return}
    if k=="binding" {if H.binding_draft!=nil && H.binding_draft.engagementId==e.b {H.binding_confirm=false H.page="approval_binding_review" H.notice="" A.redraw()} else {A.open_bindings(e.a,"")} return}
    if k=="health_hub" {A.health_open(e.a,e.b,e.c) return}
    if k=="resource_alert" {A.open_alert(e.a,e.b,0) return}
    if k=="stopped_task" {A.open_stopped(e.a,e.b,e.c,0) return}
    if k=="workspace" {A.open_workspace(e.a,e.b) return}
    if k=="templates" {A.open_templates(e.a,nil) return}
    if k=="template" {A.open_template(e.a,e.b) return}
    if k=="template_edit" {if H.templates.draft!=nil && H.templates.pending==nil {H.templates.phase="editing" H.templates.preview=nil H.page="template_edit" H.notice="" A.redraw()} else {A.open_templates(e.a,nil)} return}
    if k=="template_command" {A.open_templates(e.a,nil) return}
    if k=="web_catalog" {A.open_web_catalog(e.a,e.b,nil) return}
    if k=="web_catalog_command" {A.open_web_catalog(e.a,"settings",nil) return}
    if k=="default_policy" {A.dpol_open(e.a) return}
    if k=="action" {A.open_connection(e.a) return}
    if k=="pool_device" || k=="pool_device_setup" || k=="pool_device_move" || k=="pool_device_tasks" {A.dev_open(k,e.a) return}
    if k=="pool_who" || k=="pool_advanced" || k=="pool_glossary" {A.pool_sub_open(k,e.a) return}
    A.navigate("resources")
}
// A flow that ends on an earlier page (a discarded review, a finished change)
// drops the history above that page, so its back label is right again.
A.nav_unwind=fn(key){
    let n=H.nav
    let has={yes:false}
    for e in n.stack {if e.key==key {has.yes=true}}
    if !has.yes {return}
    for i in n.stack.len() {if n.stack.len()>0 && n.stack[n.stack.len()-1].key!=key {n.stack.pop()}}
}
// Deep links: the hub opens at the section that was tapped, once its rows are in.
A.nav_scroll=fn(){let n=H.nav if n.anchor=="" {return} let name=n.anchor n.anchor="" ui.content.scroll_to(name)}
A.read_error=fn(code){
    if code=="native_resume_missing" || code=="native_resume_revoked" {return A.t("Sign in again to continue.","需要重新登录后才能继续。")}
    if code=="management_permission_required" || code=="management_scope_changed" || code=="management_access_required" {return A.t("Your access changed. Reopen Hagency from your account.","你的访问权限已变化，请从你的账号重新打开 Hagency。")}
    if code=="management_not_found" || code=="management_resource_unavailable" {return A.t("This pool isn’t available on this device any more.","这台电脑上已经没有这个资源池了。")}
    if code=="management_busy" {return A.t("The service is busy. Try again in a moment.","服务正忙，请稍后再试。")}
    if code=="management_not_configured" {return A.t("This server hasn’t turned this feature on yet.","此服务器还没有开启这项功能。")}
    if code=="management_invalid_result" || code=="management_outcome_unknown" || code=="" {return A.t("The reply didn’t match this page. Try again.","收到的数据与此页面不符，请重试。")}
    return A.t("Couldn’t connect. Check your connection and try again.","暂时连不上，请检查网络后重试。")
}
// Reads that keep their own error state instead of the shared notice line.
A.sub_read=fn(service,args,done,fail){
    if H.busy {return false}
    H.busy=true A.redraw()
    host.request(service,args,fn(r){
        H.busy=false
        H.ux.errorCode=if r.is_ok {""} else {r.error}
        if !r.is_ok && (r.error=="native_resume_missing" || r.error=="native_resume_revoked") {H.needs_signin=true}
        if r.is_ok {done(r.data)} else {fail(r.error)}
        A.redraw()
    })
    return true
}
A.sub_pool_name=fn(resource){
    if resource=="" {return ""}
    if H.resource_detail!=nil && H.resource_detail.resource.id==resource {return A.resource_title(H.resource_detail.resource)}
    for row in H.resources {if row.id==resource {return A.resource_title(row)}}
    return ""
}
A.sub_title=fn(){
    let p=H.page
    if p=="template_edit" {return if H.templates.draft!=nil && H.templates.draft.operation=="create" {A.t("New Template","新建模板")} else {A.t("Edit Template","编辑模板")}}
    if p=="template_command" {return A.t("Review Change","确认更改")}
    if p=="web_catalog_command" && H.web.section=="trust" {return A.t("Trusted Projects","信任的项目")}
    if p=="web_catalog_command" && A.web_retire_review() {return A.t("Delete Pool","删除资源池")}
    if p=="web_catalog_command" {return A.t("Review Change","确认更改")}
    if !H.bar_past {return ""}
    if A.pool_sub_page() {return A.pool_sub_title()}
    if A.tools_hub_page() {return A.t("Tools & Permissions","工具与权限")}
    if p=="tool_request" {return if H.tool_selected!=nil {A.tool_agent(H.tool_selected.subject)} else {A.t("Tool Request","工具请求")}}
    if p=="execution_policy" {return if H.policy_detail!=nil {H.policy_detail.agent} else {A.t("Agent Permissions","Agent 权限")}}
    if p=="tool_grants" || p=="tool_grant_review" || p=="tool_grant_result" {return A.t("Saved Tool Permissions","已保存的工具权限")}
    if p=="approval_binding_review" || p=="approval_binding_result" {return A.t("Approval Room","审批聊天")}
    if p=="health_hub" {return A.t("Health & Recovery","健康与恢复")}
    if p=="resource_alert" {return A.t("Alert","告警")}
    if p=="stopped_task" {return A.t("Interrupted Task","中断的任务")}
    if p=="workspace" {return A.t("Workspace","工作区")}
    if p=="templates" {return A.t("Agent Templates","Agent 模板")}
    if p=="template" {return if H.templates.detail!=nil {H.templates.detail.definition.name} else {A.t("Template","模板")}}
    if p=="web_catalog" {return A.t("Public Listing","对外展示")}
    if p=="connections" {return A.t("Server Connections","服务器连接")}
    if p=="pool_requests" {return if A.reqs_stop_view() {A.t("Stop Some Agents","停止部分 Agent")} else {A.t("Requests","申请")}}
    if p=="default_policy" {return A.t("New Agent Permissions","新 Agent 默认权限")}
    if p=="action" {return A.t("Server & Publishing","服务器与发布")}
    if A.pool_sub_page() {return A.pool_sub_title()}
    return ""
}
A.sub_back_label=fn(){
    // Deleting a pool starts from Advanced Settings and goes back there.
    if A.web_retire_review() {return A.t("Advanced Settings","高级设置")}
    let nav=if A.nav_back_own() {""} else {A.nav_back_title()} if nav!="" {return nav}
    let p=H.page
    if A.pool_sub_page() {return A.pool_sub_back_label()}
    if p=="web_catalog_command" && H.web.section=="trust" {return A.t("Who Can Request","谁可以申请")}
    if A.tools_hub_page() || p=="health_hub" || p=="templates" || p=="web_catalog" || p=="connections" {return A.t("Pool","资源池")}
    if p=="tool_request" || p=="execution_policy" || p=="approval_binding_review" || p=="approval_binding_result" {return A.t("Tools","工具与权限")}
    if p=="tool_grants" || p=="tool_grant_review" {return if H.tool_origin=="execution_policy" {A.t("Agent","Agent 权限")} else if H.tool_origin=="approval_binding_review" || H.tool_origin=="approval_bindings" {A.t("Rooms","审批聊天")} else {A.t("Tools","工具与权限")}}
    if p=="tool_grant_result" {return A.t("Saved","已保存的工具权限")}
    if p=="resource_alert" || p=="stopped_task" || p=="workspace" {return A.t("Health","健康与恢复")}
    if p=="template" || p=="template_command" {return A.t("Templates","Agent 模板")}
    if p=="web_catalog_command" {return A.t("Listing","对外展示")}
    return A.t("Back","返回")
}
A.sub_back=fn(){
    if H.busy {return}
    if A.nav_back_sub() {return}
    let p=H.page
    if A.pool_sub_page() {A.pool_sub_back() return}
    if A.tools_hub_page() {A.open_resource(H.tools_resource) return}
    if p=="tool_request" {A.open_tools(H.tool_resource,H.tool_engagement,H.tool_after,"requests") return}
    if p=="execution_policy" {A.open_policies(H.policy_resource,H.policy_after) return}
    if p=="tool_grants" || p=="tool_grant_review" {
        if H.tool_origin=="execution_policy" && H.policy_engagement==H.tool_engagement && H.policy_resource==H.tool_resource {A.open_policy(H.policy_resource,H.policy_engagement) return}
        if (H.tool_origin=="approval_binding_review" || H.tool_origin=="approval_bindings") && H.binding_resource==H.tool_resource {A.open_bindings(H.binding_resource,H.binding_after) return}
        A.open_tools(H.tool_resource,"","","requests") return
    }
    if p=="tool_grant_result" {A.open_tools(H.tool_resource,H.tool_engagement,"","rules") return}
    if p=="approval_binding_review" || p=="approval_binding_result" {A.open_bindings(H.binding_resource,H.binding_after) return}
    if p=="health_hub" {A.open_resource(H.health.resource) return}
    if p=="resource_alert" {A.health_open(H.alert_resource,nil,nil) return}
    if p=="stopped_task" {A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,"") return}
    if p=="workspace" {A.health_open(H.workspace_resource,nil,nil) return}
    if p=="templates" {A.open_resource(H.templates.resourceId) return}
    if p=="template" {A.open_templates(H.templates.resourceId,H.templates.after) return}
    if p=="template_command" {if H.templates.pending!=nil && (H.templates.phase=="recorded" || H.templates.phase=="failed") {A.template_finish()} else {A.open_templates(H.templates.resourceId,H.templates.after)} return}
    if p=="web_catalog" {A.open_resource(H.web.resourceId) return}
    if p=="web_catalog_command" && A.web_retire_review() {A.pool_sub_open("pool_advanced",H.web.resourceId) return}
    if p=="web_catalog_command" {if H.web.pending!=nil && (H.web.phase=="recorded" || H.web.phase=="failed") {A.web_finish()} else {A.open_web_catalog(H.web.resourceId,H.web.section,nil)} return}
    if p=="connections" {if H.resource_id!="" {A.open_resource(H.resource_id)} else {A.navigate("resources")} return}
    if p=="pool_requests" {if H.resource_id!="" && H.reqs.pool!="" {A.open_resource(H.resource_id)} else {A.return_list("resources")} return}
    if p=="default_policy" {A.open_resource(H.dpol.resource) return}
    if p=="action" {if H.selected!=nil {A.open_resource(H.selected.contribution.resourceId)} else {A.navigate("resources")} return}
}
A.sub_back_enabled=fn(){
    if H.page=="template_command" {let t=H.templates return t.phase!="saving" && t.phase!="submitting" && t.phase!="cancelling"}
    if H.page=="web_catalog_command" {let w=H.web return w.phase!="saving" && w.phase!="submitting"}
    return true
}
A.template_cancel_edit=fn(){
    let t=H.templates let d=t.draft
    if H.busy || d==nil {return}
    t.phase="" t.draft=nil
    if d.operation=="create" {A.open_templates(d.resourceId,t.after)} else {A.open_template(d.resourceId,d.id)}
}
A.sub_missing=fn(){
    let p=H.page
    if p=="tool_approvals" || p=="shared_approvals" || p=="tool_grants" || p=="tool_grant_review" {return H.tool_page==nil}
    if p=="execution_policies" {return H.policy_list==nil}
    if p=="approval_bindings" {return H.binding_page==nil}
    if p=="tool_request" {return H.tool_selected==nil}
    if p=="execution_policy" {return H.policy_detail==nil}
    if p=="resource_alert" {return H.alert_detail==nil}
    if p=="stopped_task" {return H.stopped_detail==nil && H.stopped_mode!="result"}
    if p=="workspace" {return H.workspace_detail==nil}
    if p=="templates" {return H.templates.list==nil}
    if p=="template" {return H.templates.detail==nil}
    if p=="web_catalog" {return H.web.catalog==nil}
    if p=="pool_requests" {return H.reqs.items==nil}
    if p=="default_policy" {return H.dpol.detail==nil}
    if p=="action" {return H.selected==nil}
    return false
}
A.sub_join=fn(name,rest){
    let chars=(""+name).to_chars()
    if chars.len()==0 {return rest}
    let one="".to_chars() one.push(chars[chars.len()-1])
    let latin="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789)]".split(one.to_string()).len()>1
    return name+(if latin {" "} else {""})+rest
}
A.sub_times=fn(n){return if n==1 {A.t("seen once","发生 1 次")} else {A.t("seen "+n+" times","发生 "+n+" 次")}}
A.sub_plain=fn(text){
    if text==nil {return ""}
    let parts=(""+text).split("`")
    let acc={text:""}
    for i part in parts {acc.text=acc.text+(if i==0 {""} else if i%2==1 {A.t("“","「")} else {A.t("”","」")})+part}
    return acc.text
}
A.saved_kind=fn(row){
    if row.operation=="web_catalog" {return "web"}
    if A.is_template_operation(row.operation) {return "template"}
    if A.is_graph_operation(row.operation) {return "graph"}
    if A.is_task_operation(row.operation) {return "task"}
    if A.recipient_optional(row,"error")!=nil {return "error"}
    return "native"
}
A.sub_connection_status=fn(row){
    if A.connection_capacity_active(row) {return A.t("Published · ready for Agents","已发布，可以使用")}
    let {verification=nil}=row
    if row.state=="admitted" {
        if verification==nil {return A.t("Approved · connection not checked yet","已批准，连接还没检查")}
        if verification.status=="verified" {return A.t("Connected","已连接")}
        return A.t("Approved · connection needs a fresh check","已批准，连接需要重新检查")
    }
    if row.state=="pending_admission" || row.state=="pending" {return A.t("Waiting for the administrator","等待管理员批准")}
    if row.state=="rejected" {return A.t("Declined by the administrator","管理员已拒绝")}
    if row.state=="revoked" {return A.t("Closed","已关闭")}
    return A.state_text(row.state)
}
A.sub_pool_connections=fn(mine){
    let out=[]
    for row in H.connections {let {resourceId=""}=row if (H.resource_id!="" && resourceId==H.resource_id)==mine {out.push(row)}}
    return out
}
A.sub_toggle=fn(key){H.details_open=if H.details_open==key {""} else {key} A.redraw()}
// Person IDs read as names; full IDs stay under Details.
// One way to show a person everywhere: "@lisi" on your own server, the full ID elsewhere.
A.sub_person=fn(mxid){
    if H.session==nil || mxid==nil {return A.t("Unknown","未知")}
    return A.pool_person(mxid)
}
A.sub_tone=fn(severity){if severity=="critical" {return "attention"} if severity=="warning" {return "waiting"} return "elsewhere"}

// Tools & Permissions: pending requests read as sentences with the exact target.
A.sub_field=fn(obj,name,fallback){if obj==nil || !obj.is_object() {return fallback} let value=A.recipient_optional(obj,name) return if value==nil {fallback} else {value}}
A.perm_short=fn(path){
    if path==nil || !path.is_string() || path=="" {return ""}
    let parts=path.split("/")
    let n=parts.len()
    if n>=2 && parts[n-2]!="" {return parts[n-2]+"/"+parts[n-1]}
    return parts[n-1]
}
A.perm_words=fn(value){
    if value==nil {return ""}
    if value.is_string() {return value}
    let acc={text:""}
    for part in value {acc.text=acc.text+(if acc.text=="" {""} else {" "})+part}
    return acc.text
}
A.perm_info=fn(row){
    let a=row.approval
    let name=a.agentName
    if A.recipient_optional(row,"encryptedPending")==true {return {title:A.t(name+"’s request is still on its way",A.sub_join(name,"的请求还在路上")) exact:"" icon:mod.rinx_icons.lock reason:""}}
    let request=A.recipient_optional(a,"request")
    let kind=A.sub_field(request,"kind","")
    let path=A.sub_field(request,"path",nil)
    let command=A.sub_field(request,"command",nil)
    let host=A.sub_field(request,"host",nil)
    let method=A.sub_field(request,"method","")
    let params=A.sub_field(request,"params",nil)
    let reason=A.sub_field(request,"reason",nil)
    let info={title:A.t(name+" is asking for a permission",A.sub_join(name,"请求一项权限")) exact:"" icon:mod.rinx_icons.shield reason:if reason==nil {""} else {""+reason}}
    if params!=nil && params.is_object() {
        let p_command=A.recipient_optional(params,"command")
        let p_cwd=A.recipient_optional(params,"cwd")
        let p_root=A.recipient_optional(params,"grantRoot")
        let p_permissions=A.recipient_optional(params,"permissions")
        let p_reason=A.recipient_optional(params,"reason")
        if p_reason!=nil {info.reason=""+p_reason}
        if method=="item/commandExecution/requestApproval" {
            info.title=A.t(name+" wants to run a command",A.sub_join(name,"想运行一条命令")) info.exact=A.perm_words(p_command) info.icon=mod.rinx_icons.tasks
            if p_cwd!=nil {info.exact=info.exact+"\n"+A.t("in ","位置：")+p_cwd}
        }
        if method=="item/fileChange/requestApproval" {
            info.icon=mod.rinx_icons.edit
            info.title=if p_root==nil {A.t(name+" wants to change files",A.sub_join(name,"想修改文件"))} else {A.t(name+" wants to change files in "+A.perm_short(p_root),A.sub_join(name,"想修改 ")+A.perm_short(p_root)+" 中的文件")}
            if p_root!=nil {info.exact=p_root}
        }
        if method=="item/permissions/requestApproval" && p_permissions!=nil {
            let p_network=A.recipient_optional(p_permissions,"network")
            let p_files=A.recipient_optional(p_permissions,"fileSystem")
            let lines={text:"" count:0 first:""}
            if p_files!=nil {
                let p_write=A.recipient_optional(p_files,"write")
                let p_read=A.recipient_optional(p_files,"read")
                if p_write!=nil {for target in p_write {lines.text=lines.text+(if lines.text=="" {""} else {"\n"})+A.t("Write ","写入 ")+target if lines.count==0 {lines.first=A.t(name+" wants to write "+A.perm_short(target),A.sub_join(name,"想写入 ")+A.perm_short(target))} lines.count=lines.count+1}}
                if p_read!=nil {for target in p_read {lines.text=lines.text+(if lines.text=="" {""} else {"\n"})+A.t("Read ","读取 ")+target if lines.count==0 {lines.first=A.t(name+" wants to read "+A.perm_short(target),A.sub_join(name,"想读取 ")+A.perm_short(target))} lines.count=lines.count+1}}
            }
            if p_network!=nil && A.recipient_optional(p_network,"enabled")==true {lines.text=lines.text+(if lines.text=="" {""} else {"\n"})+A.t("Use the network","访问网络") if lines.count==0 {lines.first=A.t(name+" wants to use the network",A.sub_join(name,"想访问网络"))} lines.count=lines.count+1}
            info.exact=lines.text info.icon=mod.rinx_icons.lock
            if lines.count==1 {info.title=lines.first}
            if lines.count>1 {info.title=A.t(name+" wants "+lines.count+" permissions",A.sub_join(name,"想获得 ")+lines.count+" 项权限")}
        }
    }
    if kind!="" {
        let target=if path!=nil {path} else if command!=nil {A.perm_words(command)} else if host!=nil {host} else {""}
        info.exact=target
        if kind=="file_write" || kind=="write" {info.title=A.t(name+" wants to write "+A.perm_short(target),A.sub_join(name,"想写入 ")+A.perm_short(target)) info.icon=mod.rinx_icons.edit}
        if kind=="file_read" || kind=="read" {info.title=A.t(name+" wants to read "+A.perm_short(target),A.sub_join(name,"想读取 ")+A.perm_short(target)) info.icon=mod.rinx_icons.file}
        if kind=="command" || kind=="exec" {info.title=A.t(name+" wants to run a command",A.sub_join(name,"想运行一条命令")) info.icon=mod.rinx_icons.tasks}
        if kind=="network" {info.title=A.t(name+" wants to reach "+target,A.sub_join(name,"想访问 ")+target) info.icon=mod.rinx_icons.globe}
    }
    return info
}
A.shared_session=fn(row){let request=A.recipient_optional(row.approval,"request") return request!=nil && A.recipient_optional(request,"sessionAllowed")==true}
A.shared_any_session=fn(rows){for row in rows {if A.shared_session(row) {return true}} return false}
A.shared_rows=fn(decide){
    let out=[]
    for row in H.shared_approvals {let {decision=nil,canDecide=false}=row if decision==nil && (canDecide==true)==decide {out.push(row)}}
    return out
}
A.tool_rows=fn(live){
    let out=[]
    if H.tool_page==nil {return out}
    let {approvals=[],observedAtMs=0}=H.tool_page
    for row in approvals {if (row.state=="pending" && row.expiresAt>observedAtMs)==live {out.push(row)}}
    return out
}
A.tools_pending_count=fn(){return A.count_shared_decisions(H.shared_approvals)+(if H.tool_page==nil {0} else {A.tool_live_count(H.tool_page)})}
A.tools_pending_label=fn(){
    let n=if H.page=="tool_approvals" && H.tool_page!=nil {A.tools_pending_count()} else {0}
    return A.t("Pending","待处理")+if n>0 {" ("+n+")"} else {""}
}
A.tool_status_plain=fn(row,observed_at){
    if row.state=="pending" && row.expiresAt<=observed_at {return A.t("Expired before anyone decided","没人决定，已过期")}
    if row.state=="applied" {return A.t("In effect","已生效")}
    if row.state=="decided" || row.state=="applying" {return A.t("Taking effect…","正在生效")}
    if row.state=="uncertain" {return A.t("Not sure it took effect","是否生效还不确定")}
    if row.state=="not_applied" {return A.t("Didn’t take effect","没有生效")}
    if row.state=="expired" {return A.t("Expired","已过期")}
    if row.state=="cancelled" {return A.t("Cancelled","已取消")}
    return A.tool_status(row.state)
}
A.tool_left=fn(row,observed_at){
    let ms=row.expiresAt-observed_at
    if ms<=0 {return A.t("Approval window ended","审批已截止")}
    let minutes=floor(ms/60000)
    if minutes<1 {return A.t("Less than a minute left","剩不到 1 分钟")}
    return A.t("About "+minutes+" min left","还剩约 "+minutes+" 分钟")
}
A.tool_project_name=fn(subject){
    if subject==nil {return ""}
    let {projectName=nil}=subject
    return if projectName!=nil && projectName!="" {projectName} else {""}
}
A.tools_shared_load=fn(){
    H.shared_state="loading" H.shared_error=""
    host.request("hagency.shared_approvals.list",{},fn(r){
        if r.is_ok {let {approvals=[]}=r.data H.shared_approvals=approvals H.shared_state="ready"} else {H.shared_state="error" H.shared_error=r.error}
        A.redraw()
    })
}
// The auto-refresh re-reads shared requests without showing a loading row.
A.tools_shared_quiet=fn(){
    if H.shared_state=="loading" || H.shared_sending!="" {return}
    host.request("hagency.shared_approvals.list",{},fn(r){
        if r.is_ok && H.shared_sending=="" {let {approvals=[]}=r.data H.shared_approvals=approvals H.shared_state="ready" A.redraw()}
    })
}
A.shared_decide_error=fn(code){
    if code=="approval_request_changed" || code=="management_revision_conflict" {return A.t("This request changed. Check it again.","此请求已变化，请重新查看。")}
    if code=="resource_owner_required" {return A.t("Only the resource owner can decide this one.","只有资源所有者可以决定这项请求。")}
    if code=="session_approval_unavailable" {return A.t("This one can’t be allowed for the whole session.","这项请求不能按整个会话允许。")}
    if code=="management_not_found" || code=="management_action_closed" {return A.t("This request has already ended.","这项请求已经结束。")}
    return A.t("Your decision wasn’t sent. Check your connection and try again.","你的决定没有发送成功，请检查网络后重试。")
}
A.tool_grant_mode=fn(mode){
    if mode=="always" {return A.t("Always allowed","始终允许")}
    if mode=="task" {return A.t("For one task","只在一个任务里")}
    if mode=="once" {return A.t("Allowed once","允许一次")}
    return A.tool_choice(mode)
}
// A saved tool rule in plain Chinese from details.rule; the description when there is no rule.
A.tool_rule_text=fn(details){
    if details==nil {return A.t("Its original description isn’t available","原始说明不可用")}
    let rule=A.recipient_optional(details,"rule")
    let desc=A.recipient_optional(details,"description")
    let fallback=if desc==nil {A.t("Its original description isn’t available","原始说明不可用")} else {A.t("Agent’s words: ","Agent 原话：")+A.sub_plain(""+desc)}
    if rule==nil || !rule.is_object() {return fallback}
    let runtime=A.recipient_optional(rule,"runtime")
    let command=A.recipient_optional(rule,"command")
    let cwd=A.recipient_optional(rule,"cwd")
    let host=A.recipient_optional(rule,"host")
    let protocol=A.recipient_optional(rule,"protocol")
    let tool=A.recipient_optional(rule,"tool")
    let perms=A.tool_rule_perms(A.recipient_optional(rule,"permissions"))
    let where=if cwd==nil {""} else {A.t(" in "+cwd,"在 "+cwd+" 里")}
    if command!=nil {return A.t("Run "+command+where+(if perms=="" {""} else {" with "+perms}),where+"运行 "+command+(if perms=="" {""} else {"（权限："+perms+"）"}))}
    if host!=nil {return A.t("Connect to "+(if protocol==nil {""} else {protocol+"://"})+host,"连接网络地址 "+(if protocol==nil {""} else {protocol+"://"})+host)}
    if tool!=nil {return A.t("Use the tool "+tool+(if runtime=="claude" {" in Claude"} else {""}),(if runtime=="claude" {"在 Claude 里"} else {""})+"使用工具 "+tool)}
    if perms!="" {return A.t("Use "+perms+where,where+"使用这些权限："+perms)}
    return fallback
}
A.tool_rule_perms=fn(p){
    if p==nil {return ""}
    if p.is_string() {return p}
    if p.is_array() {let out={t:""} for i x in p {out.t=out.t+(if i>0 {A.t(", ","、")} else {""})+x} return out.t}
    return A.sub_plain(p.to_json())
}
A.tool_kind_icon=fn(kind){
    if kind=="network_host" {return mod.rinx_icons.globe}
    if kind=="permission_profile" {return mod.rinx_icons.lock}
    if kind=="exact_tool_call" {return mod.rinx_icons.adjust}
    return mod.rinx_icons.tasks
}
A.binding_row=fn(d){
    if H.binding_page==nil || d==nil {return nil}
    for row in H.binding_page.bindings {if row.engagementId==d.engagementId {return row}}
    return nil
}
A.policy_name=fn(yolo){return if yolo {A.t("Full trust","完全信任")} else {A.t("Standard","标准权限")}}

// Agent requests for the owner: the Agent 申请 tab (every pool, or the one it
// was filtered to) and each pool's own 申请 page. Rows decide in place behind a
// confirmation, through the same hagency.pools.agents.decide as the request page.
A.reqs_page=fn(){return H.page=="pool_requests" || (H.page=="inbox" && H.entry_role=="owner")}
A.reqs_scope=fn(){return if H.page=="pool_requests" {H.reqs.pool} else {H.owner.poolId}}
A.reqs_scope_label=fn(){return if H.page=="pool_requests" {H.reqs.label} else {H.owner.poolLabel}}
A.open_pool_requests=fn(conn){
    if H.busy {return}
    let r=H.reqs
    r.pool=if conn==nil {""} else {conn.id}
    r.label=if conn==nil {""} else {conn.label}
    r.filter="pending" r.hint=""
    A.reqs_show("pool_requests")
}
A.reqs_reopen=fn(pool,label,hint){if H.busy {return} H.reqs.pool=pool H.reqs.label=label H.reqs.hint=if hint=="stop" {"stop"} else {""} if hint=="stop" {H.reqs.filter="all"} A.reqs_show("pool_requests")}
// "Stop Some Agents": the pool's requests page showing only the Agents using it, opened from an alert.
A.reqs_stop_view=fn(){return H.page=="pool_requests" && A.recipient_optional(H.reqs,"hint")=="stop"}
A.reqs_show=fn(page){
    let r=H.reqs
    r.confirm=nil r.result=nil r.items=nil r.next=nil
    H.page=page H.notice="" H.bar_past=false
    A.reqs_load(nil)
}
A.reqs_load=fn(after){
    let r=H.reqs
    if H.session==nil {return}
    let pool=A.reqs_scope()
    let args={after:after needsMyAction:r.filter=="pending"}
    if pool!="" {args.poolId=pool}
    r.epoch=r.epoch+1
    let epoch=r.epoch
    r.state="loading" r.error=""
    if after==nil {r.items=nil r.next=nil}
    let started=A.sub_read("hagency.pools.agents.list",args,fn(v){
        if r.epoch!=epoch {return}
        let {items=nil,nextAfter=nil}=v
        if items==nil {r.state="error" r.error="management_invalid_result" return}
        let rows=if r.items==nil {[]} else {r.items}
        for q in items {let {resourceOwnerMxid=nil,poolId=nil}=q if resourceOwnerMxid==H.session.account && (pool=="" || poolId==pool) {rows.push(q)}}
        r.items=rows r.next=nextAfter r.state="ready"
        // A complete list of everything waiting is what the tab badge counts too.
        if pool=="" && args.needsMyAction==true && after==nil && nextAfter==nil {
            let n={c:0} for q in rows {if A.reqs_decidable(q) {n.c=n.c+1}}
            H.tab_requests=n.c
            if H.pool_meta!=nil {H.pool_meta.requests=items}
            ui.navigation.render()
        }
    },fn(code){if r.epoch!=epoch {return} r.state="error" r.error=code})
    if !started {r.state="error" r.error="management_busy"}
}
A.reqs_filter=fn(filter){
    let r=H.reqs
    if H.busy || r.filter==filter {return}
    r.filter=filter r.result=nil
    A.reqs_load(nil)
}
A.reqs_all_pools=fn(){if H.busy {return} H.owner.poolId="" H.owner.poolLabel="" A.reqs_load(nil)}
// "Requests 0.1 M · from applicant", read as names rather than Matrix IDs.
A.reqs_line=fn(q){return A.t("Requests ","申请 ")+A.tokens(q.requestedTokens)+A.t(" · from "," · 来自 ")+A.sub_person(q.managerMxid)}
// What the pool has left after approving, when this page knows the pool's capacity.
A.reqs_after=fn(q){
    let {poolId=nil,requestedTokens=nil}=q
    if poolId==nil || requestedTokens==nil {return ""}
    let found={rid:""}
    if H.pool_meta!=nil && H.pool_meta.conns!=nil {for c in H.pool_meta.conns {if c.id==poolId {found.rid=c.resourceId}}}
    if found.rid=="" && H.pool_info!=nil && H.pool_info.conn!=nil && H.pool_info.conn.id==poolId {found.rid=H.pool_info.rid}
    if found.rid=="" {return ""}
    let b=A.alert_live_left(found.rid)
    if b==nil || b.remaining==nil || b.ceiling==nil {return ""}
    return A.t(" Afterwards the pool has "+A.tokens(max(0,b.remaining-requestedTokens))+" left this month."," 批准后，这个资源池本月还剩 "+A.tokens(max(0,b.remaining-requestedTokens))+"。")
}
A.reqs_decidable=fn(q){let {canDecide=false,resourceOwnerMxid=nil}=q return canDecide==true && H.entry_role=="owner" && H.session!=nil && resourceOwnerMxid==H.session.account}
A.reqs_ask=fn(q,kind){
    if H.busy || H.command!=nil || !A.reqs_decidable(q) {return}
    H.reqs.confirm={row:q kind:kind} H.reqs.result=nil A.redraw()
}
// An approved Agent of your pool that you can stop from the list.
A.reqs_stoppable=fn(q){let {canStopSupply=false,resourceOwnerMxid=nil}=q return canStopSupply==true && H.entry_role=="owner" && H.session!=nil && resourceOwnerMxid==H.session.account}
A.reqs_using=fn(rows){let out=[] for q in rows {if A.reqs_stoppable(q) {out.push(q)}} return out}
A.reqs_stopped_rows=fn(rows){let out=[] for q in rows {let {state=nil,resourceOwnerMxid=nil}=q if state=="revoked" && H.session!=nil && resourceOwnerMxid==H.session.account {out.push(q)}} return out}
A.reqs_given_line=fn(q){return A.t("Given "+A.tokens(q.requestedTokens)+" · from "+A.sub_person(q.managerMxid),"已分给它 "+A.tokens(q.requestedTokens)+" · 来自 "+A.sub_person(q.managerMxid))}
// Whether the pool the stop view is about is over its monthly maximum now (from its live figures).
A.reqs_pool_over=fn(){
    let rid=A.recipient_optional(H.reqs,"rid")
    if rid==nil || rid=="" {return false}
    let b=A.alert_live_left(rid)
    return b!=nil && b.ceiling!=nil && b.remaining!=nil && b.remaining<=0
}
// Approving can't work while the pool has less left than the request: say so instead of offering it.
A.reqs_blocked=fn(q){
    let {poolId=nil,requestedTokens=nil}=q
    if poolId==nil || requestedTokens==nil {return ""}
    let rid=A.reqs_pool_rid(poolId)
    if rid=="" {return ""}
    let b=A.alert_live_left(rid)
    if b==nil || b.remaining==nil || b.ceiling==nil {return ""}
    if b.remaining<=0 {return A.t("Can’t approve for now: the pool is over its monthly maximum. Raise the maximum or stop some Agents first.","暂时不能批准：资源池超出了每月上限。先调高每月上限，或停止部分 Agent。")}
    if b.remaining<requestedTokens {return A.t("Can’t approve for now: the pool has "+A.tokens(b.remaining)+" left this month, less than the "+A.tokens(requestedTokens)+" asked for.","暂时不能批准：资源池本月只剩 "+A.tokens(b.remaining)+"，不够它申请的 "+A.tokens(requestedTokens)+"。")}
    return ""
}
A.reqs_pool_rid=fn(poolId){
    let found={rid:""}
    if H.pool_meta!=nil && H.pool_meta.conns!=nil {for c in H.pool_meta.conns {if c.id==poolId {found.rid=c.resourceId}}}
    if found.rid=="" && H.pool_info!=nil && H.pool_info.conn!=nil && H.pool_info.conn.id==poolId {found.rid=H.pool_info.rid}
    return found.rid
}
A.reqs_ask_stop=fn(q){
    if H.busy || H.command!=nil || !A.reqs_stoppable(q) {return}
    H.reqs.confirm={row:q kind:"stop"} H.reqs.result=nil A.redraw()
}
A.reqs_decide=fn(){
    let c=H.reqs.confirm
    if c==nil || H.busy || H.command!=nil {return}
    if c.kind=="stop" {
        if !A.reqs_stoppable(c.row) {return}
        H.reqs.deciding=c.row.id
        A.submit("hagency.pools.agents.stop",{requestId:c.row.id expectedRevision:c.row.revision})
        return
    }
    if !A.reqs_decidable(c.row) {return}
    H.reqs.deciding=c.row.id
    A.submit("hagency.pools.agents.decide",{requestId:c.row.id expectedRevision:c.row.revision approve:c.kind=="approve"})
}
// What a decision did, said once on the list or on the request page.
// After a decision or a stop, the counts that badge it are read again at once: the tab,
// the list's rows and "Needs you" all read the same pending requests.
A.reqs_counts_reload=fn(){
    if H.entry_role!="owner" || H.session==nil || !A.pool_enabled() {return}
    host.request("hagency.pools.agents.list",{after:nil needsMyAction:true},fn(r){
        if !r.is_ok {return}
        let {items=nil,nextAfter=nil}=r.data
        if items==nil {return}
        let n={c:0}
        for q in items {let {canDecide=false,resourceOwnerMxid=nil}=q if canDecide==true && resourceOwnerMxid==H.session.account {n.c=n.c+1}}
        H.tab_requests=n.c
        if nextAfter==nil && H.pool_meta!=nil {H.pool_meta.requests=items}
        A.redraw()
    })
}
A.reqs_decided=fn(args,request){
    let {definition=nil,requestedTokens=nil,poolLabel=""}=request
    let {approve=false}=args
    H.reqs.result={id:args.requestId approve:approve stopped:false name:if definition==nil {""} else {definition.name} tokens:requestedTokens pool:poolLabel}
}
A.reqs_stopped=fn(args,request){
    let {definition=nil,requestedTokens=nil,poolLabel=""}=request
    H.reqs.result={id:args.requestId approve:false stopped:true name:if definition==nil {""} else {definition.name} tokens:requestedTokens pool:poolLabel}
}
A.reqs_note=fn(result){
    let name=result.name
    if result.stopped {return {title:A.t("Stopped “"+name+"”","已停止「"+name+"」") text:A.t("It takes no new work from this pool. What it was given but hasn’t used goes back to the pool once it finishes up.","它不再从这个资源池接新任务；分给它但没用掉的额度，会在它收尾后回到资源池。")}}
    if result.approve {return {title:A.t("Approved “"+name+"”","已批准「"+name+"」") text:A.t("This computer holds "+A.tokens(result.tokens)+" for it by itself (keep it on and online); there’s nothing more for you to do.","这台电脑会自动分给它 "+A.tokens(result.tokens)+"（保持开机联网即可），不用你再操作。")}}
    return {title:A.t("Declined “"+name+"”","已拒绝「"+name+"」") text:A.t("The request is closed. Nothing was held from the pool.","申请已关闭，资源池没有分出额度。")}
}
A.reqs_split=fn(rows){
    let out={decide:[] other:[]}
    for q in rows {if A.reqs_decidable(q) {out.decide.push(q)} else {out.other.push(q)}}
    return out
}
A.reqs_state_line=fn(q){
    if q.state=="pending_approval" && !A.reqs_decidable(q) {return A.t("Waiting for its resource owner","等待资源所有者审批")}
    return A.local_pool_state(q)
}

// New-Agent default permission: one page for the pool's default, with the same
// full-trust alert as an Agent's own permission. Before a pool is offered it is
// part of the pool's configuration (hagency.resources.edit); once offered, it is
// the published default (hagency.web_catalog.prepare, then apply).
A.dpol_open=fn(resource){
    if H.busy || resource=="" {return}
    let d=H.dpol
    if d.resource!=resource {d.saved=nil}
    d.resource=resource d.detail=nil d.catalog=nil d.mode="" d.ask=nil d.phase="" d.error="" d.state="loading"
    d.epoch=d.epoch+1
    let epoch=d.epoch
    H.page="default_policy" H.notice="" H.bar_past=false
    let started=A.sub_read("hagency.resources.get",{id:resource},fn(v){
        if d.epoch!=epoch {return}
        let {protocol="",resource=nil}=v
        if protocol!="hagency-management-v1" || resource==nil || resource.id!=d.resource {d.state="error" d.error="management_invalid_result" return}
        d.detail=v
        let {editing={}}=v
        let {allowed=false}=editing
        if allowed==true {d.mode="resource" d.yolo=A.resource_default_yolo(v) d.state="ready" return}
        d.mode="catalog"
        A.dpol_catalog(epoch)
    },fn(code){if d.epoch!=epoch {return} d.state="error" d.error=code})
    if !started {d.state="error" d.error="management_busy"}
}
A.dpol_catalog=fn(epoch){
    let d=H.dpol
    let started=A.sub_read("hagency.web_catalog.get",{resourceId:d.resource after:nil},fn(v){
        if d.epoch!=epoch {return}
        let {resourceId="",revision=nil,defaultYolo=false}=v
        if resourceId!=d.resource || revision==nil || !revision.is_string() {d.state="error" d.error="management_invalid_result" return}
        d.catalog=v d.yolo=defaultYolo==true d.state="ready"
    },fn(code){if d.epoch!=epoch {return} d.state="error" d.error=code})
    if !started {d.state="error" d.error="management_busy"}
}
A.dpol_codex=fn(){let d=H.dpol return d.detail!=nil && d.detail.resource.framework=="codex"}
// "Use defaults" for one Agent: the listing's change flow, against the record this page read.
A.dpol_assign=fn(id){
    let d=H.dpol
    if !A.dpol_can() || d.mode!="catalog" || d.catalog==nil {return}
    let w=H.web
    w.resourceId=d.resource w.section="settings" w.after=nil w.catalog=d.catalog w.draft=nil
    A.web_prepare({operation:"assign_preset" engagementId:id})
}
A.dpol_can=fn(){let d=H.dpol return !H.busy && H.command==nil && d.state=="ready" && d.phase=="" && (d.mode=="resource" || A.web_can_edit())}
A.dpol_choose=fn(yolo){
    let d=H.dpol
    if !A.dpol_can() || yolo==d.yolo || (yolo && !A.dpol_codex()) {return}
    d.ask=yolo d.saved=nil d.error="" A.redraw()
}
A.dpol_commit=fn(){
    let d=H.dpol
    let yolo=d.ask
    if yolo==nil || !A.dpol_can() {return}
    d.ask=nil
    if d.mode=="resource" {
        let row=d.detail.resource
        A.submit("hagency.resources.edit",{resourceId:row.id expectedRevision:row.revision profile:{kind:"preserve"} ceiling:{kind:"preserve"} executionPolicy:{yolo:yolo}})
        return
    }
    // The alert was the review, so the published default is prepared and applied together.
    let args={resourceId:d.resource expectedRevision:d.catalog.revision change:{operation:"default_policy" yolo:yolo}}
    let epoch=d.epoch
    d.phase="saving" H.busy=true A.redraw()
    host.request("hagency.web_catalog.prepare",args,fn(r){
        let p=if r.is_ok && r.data.is_object() {r.data} else {nil}
        let change=if p==nil {nil} else {A.recipient_optional(p,"change")}
        let commandId=if p==nil {nil} else {A.recipient_optional(p,"commandId")}
        if p==nil || change==nil || commandId==nil || A.recipient_optional(change,"operation")!="default_policy" || A.recipient_optional(change,"yolo")!=yolo {
            H.busy=false d.phase="" d.error=if r.is_ok {"management_outcome_unknown"} else {r.error} A.redraw() return
        }
        host.request("hagency.web_catalog.command.apply",{commandId:commandId},fn(a){
            if !a.is_ok || A.recipient_optional(a.data,"commandId")!=commandId {
                // Saved but not confirmed: finish it where pending changes are handled.
                H.busy=false d.phase="" A.web_prepared(p) A.redraw() return
            }
            host.request("hagency.intent.acknowledge",{commandId:commandId},fn(k){
                H.busy=false d.phase=""
                let remaining=[] for row in H.saved_commands {if row.commandId!=commandId {remaining.push(row)}} H.saved_commands=remaining
                if d.epoch==epoch {d.yolo=yolo d.saved=yolo A.dpol_catalog(epoch)}
                A.redraw()
            })
        })
    })
}
A.dpol_saved=fn(args){let d=H.dpol let {executionPolicy=nil}=args if executionPolicy!=nil {d.saved=executionPolicy.yolo} A.dpol_open(d.resource)}
A.dpol_error=fn(code){
    if code=="management_revision_conflict" || code=="management_resource_edit_changed" {return A.t("This pool changed. Its latest setting is shown; choose again.","资源池已有变化，下面是最新的设置，请重新选择。")}
    return A.error_text(code)
}

// Server & Publishing (owner): the pool's server connection as a detail page.
// Its steps are the pool banner's: connect, the administrator's approval, publish.
A.publish_steps_text=fn(step){
    if step>3 {return A.t("All 3 steps done · Connect › Approval › Publish","3 步都已完成 · 连接服务器 › 管理员批准 › 发布额度")}
    return A.t("Step ","第 ")+step+A.t(" of 3 · Connect › Approval › Publish"," 步，共 3 步 · 连接服务器 › 管理员批准 › 发布额度")
}
A.server_name=fn(){
    if H.session==nil {return ""}
    let parts=H.session.account.split(":")
    if parts.len()<2 {return ""}
    let acc={text:""}
    for index part in parts {if index>0 {acc.text=acc.text+(if index>1 {":"} else {""})+part}}
    return acc.text
}
A.server_status=fn(c){
    let cap=H.connection_capacity
    if c.state=="pending_admission" || c.state=="pending" {return {text:A.t("Waiting for approval","等管理员批准") tone:"waiting" step:2}}
    if c.state=="rejected" {return {text:A.t("Not approved","管理员没有批准") tone:"attention" step:2}}
    if c.state=="revoked" {return {text:A.t("Connection closed","连接已关闭") tone:"" step:1}}
    if c.state!="admitted" {return {text:A.state_text(c.state) tone:"" step:1}}
    if A.can_resume(c) {return {text:A.t("Reconnect this computer","需要重新连接") tone:"attention" step:3}}
    if A.connection_capacity_active(c) {return {text:A.t("Published","已发布") tone:"running" step:4}}
    if cap.id==c.id && (cap.state=="ready" || cap.state=="missing") {return {text:A.t("Not published this month","本月未发布") tone:"waiting" step:3}}
    return {text:A.t("Connected","已连接") tone:"elsewhere" step:3}
}
A.server_runtime=fn(runtime){if runtime=="codex" {return "Codex"} if runtime=="claude" {return "Claude"} return ""+runtime}
A.server_caps=fn(caps){let acc={text:""} for cap in caps {acc.text=acc.text+(if acc.text=="" {""} else {"、"})+A.capability_label(cap)} return acc.text}
// Publishing happens on the pool page, where the per-request limit is set.
A.server_publish=fn(c){
    if H.busy {return}
    let n=H.nav
    if n.stack.len()>0 && n.stack[n.stack.len()-1].key=="pool/"+c.resourceId {A.nav_back() return}
    A.open_resource(c.resourceId)
}
A.server_next=fn(c){
    let q=H.selected.request
    if c.state=="pending_admission" || c.state=="pending" {return A.t(A.sub_person(q.approverMxid)+" is reviewing it. Once approved, set the per-request limit on the pool page and publish.",A.sub_join(A.sub_person(q.approverMxid),"正在审核。批准后，回到资源池设置每次申请上限并发布。"))}
    if c.state=="rejected" {return A.t("You can request approval again below.","可以在下方重新申请批准。")}
    if c.state=="revoked" {return A.t("Agents can’t request this pool on the server any more.","服务器上的 Agent 不能再申请这个资源池。")}
    if A.can_resume(c) {return A.t("This computer restarted. Check and reconnect it below.","这台电脑重启过，请在下方检查并重新连接。")}
    if A.connection_capacity_active(c) {return A.t("Agents can request this pool now.","Agent 现在可以申请这个资源池。")}
    return A.t("Set the per-request limit on the pool page, then publish this month’s capacity.","在资源池页面设置每次申请上限，然后发布本月额度。")
}

// Alerts: a Chinese headline for kinds the app recognises, and times on this
// device's clock ("today 16:12") when the host supplies them.
// Alerts carry a kind and its params; ceiling_overrun is the one the app words itself.
// Any other kind keeps the server's English text, under a Chinese heading.
A.alert_kind_of=fn(row){
    let kind=A.recipient_optional(row,"kind")
    if kind=="ceiling_overrun" {return "ceiling"}
    if kind!=nil {return ""}
    let id=""+row.id
    if id.strip_prefix("agent_ceiling_overrun:")!=id {return "ceiling"}
    return ""
}
A.alert_params=fn(row){
    let p=A.recipient_optional(row,"params")
    let out={ceiling:nil drawn:nil over:nil committed:nil measured:nil percent:nil period:nil start:nil end:nil}
    if p!=nil && p.is_object() {
        out.ceiling=A.recipient_optional(p,"ceilingTokens") out.drawn=A.recipient_optional(p,"drawnTokens") out.over=A.recipient_optional(p,"overByTokens")
        out.committed=A.recipient_optional(p,"committedTokens") out.measured=A.recipient_optional(p,"measuredTokens")
        out.percent=A.recipient_optional(p,"percent") out.period=A.recipient_optional(p,"period")
        out.start=A.recipient_optional(p,"periodStartMs") out.end=A.recipient_optional(p,"periodEndMs")
    }
    // Older replies carry the same figures under budget.
    let b=A.alert_budget(row)
    if out.ceiling==nil {out.ceiling=b.ceiling} if out.drawn==nil {out.drawn=b.drawn} if out.over==nil {out.over=b.over}
    if out.percent==nil && out.ceiling!=nil && out.ceiling>0 && out.drawn!=nil {out.percent=A.pool_div(out.drawn*100,out.ceiling)}
    return out
}
A.alert_headline=fn(row){
    if A.alert_kind_of(row)=="ceiling" {
        let p=A.alert_params(row)
        // With large text the percent moves to the line under the pill, so no bracket is left at a line end.
        if A.alert_recovered(row) {return A.t("Back under the monthly maximum","已回到每月上限以内")}
        return if p.percent!=nil && mod.widgets.RINX_TEXT_SCALE<=1.2 {A.t("Over the monthly maximum ("+p.percent+"%)","已超出每月上限（"+p.percent+"%）")} else {A.t("Over the monthly maximum","已超出每月上限")}
    }
    if row.severity=="information" {return A.t("A note from the server","服务器发来的提示")}
    return A.t("An alert from the server","服务器发来的告警")
}
// The server's own words for kinds the app doesn't know, shown under the Chinese heading.
A.alert_server_text=fn(row){if A.alert_kind_of(row)=="ceiling" {return ""} return ""+row.summary}
A.alert_texts=fn(row){
    let {impact="",runbook="",recoveryCondition=""}=row
    if A.alert_kind_of(row)=="ceiling" {return {impact:A.t("New Agent requests can’t be approved for now; work already approved keeps running.","暂时不能批准新的 Agent 申请；已批准的工作会继续运行。") runbook:A.t("Raise the monthly maximum, or stop some Agents, until use is back under the maximum.","调高每月上限，或停止部分 Agent，直到用量回到上限以内。") recovery:A.t("It clears by itself once use is back under the maximum.","用量回到上限以内时自动解除。") local:true}}
    return {impact:impact runbook:runbook recovery:recoveryCondition local:false}
}
// Whether this pool's monthly maximum can change here now (only known once its page was read).
A.alert_can_raise=fn(rid){
    if H.resource_detail==nil || H.resource_detail.resource.id!=rid {return false}
    return A.pool_view(H.resource_detail).maxMode!="locked"
}
A.alert_open_max=fn(rid){
    if H.busy {return}
    H.nav.anchor="pool_max_section"
    A.open_resource(rid)
}
// The pool's requests, all of them, where an approved Agent can be stopped.
A.alert_open_agents=fn(rid){
    if H.busy {return}
    let found={c:nil}
    if H.pool_info!=nil && H.pool_info.rid==rid && H.pool_info.conn!=nil {found.c=H.pool_info.conn}
    if found.c==nil && H.pool_meta!=nil && H.pool_meta.conns!=nil {for c in H.pool_meta.conns {if found.c==nil && c.resourceId==rid && A.pool_mine(c) {found.c=c}}}
    if found.c==nil {A.open_resource(rid) return}
    let r=H.reqs
    r.pool=found.c.id r.label=found.c.label r.filter="all" r.hint="stop" r.rid=rid
    A.reqs_show("pool_requests")
}
A.alert_seen_line=fn(row){
    let parts=[]
    let pct=A.alert_params(row).percent
    if A.alert_kind_of(row)=="ceiling" && pct!=nil && mod.widgets.RINX_TEXT_SCALE>1.2 {parts.push(A.t(""+pct+"% of the maximum","达到上限的 "+pct+"%"))}
    parts.push(A.t("Seen "+row.occurrences+(if row.occurrences==1 {" time"} else {" times"}),"发生 "+row.occurrences+" 次"))
    let last=A.alert_when(row,"lastSeen")
    if last!="" {parts.push(A.t("last ","最近一次 ")+last)}
    let muted=A.alert_when(row,"suppressUntil")
    if muted!="" {parts.push(A.t("muted until ","暂停提醒到 ")+muted)}
    let who=A.recipient_optional(row,"assignee")
    if who!=nil {parts.push(A.t("handled by ","处理人 ")+A.sub_person(who))}
    let out={t:""} for i p in parts {out.t=out.t+(if i>0 {" · "} else {""})+p}
    return out.t
}
A.alert_split=fn(q){
    if q.measured!=nil && q.committed!=nil {return A.t("Of this, "+A.tokens(q.measured)+" was used and "+A.tokens(q.committed)+" was given to Agents but not used yet.","其中已用 "+A.tokens(q.measured)+"，已分给 Agent，尚未用 "+A.tokens(q.committed)+"。")}
    if q.measured!=nil {return A.t("Of this, "+A.tokens(q.measured)+" was used.","其中已用 "+A.tokens(q.measured)+"。")}
    return A.t("Of this, "+A.tokens(q.committed)+" was given to Agents but not used yet.","其中已分给 Agent，尚未用 "+A.tokens(q.committed)+"。")
}
// The alert's figures are a record; say when, and how the pool stands now.
A.alert_now_line=fn(row,q,live){
    let when=A.alert_when(row,"lastSeen")
    let head=if when=="" {A.t("These are the figures recorded with the alert.","上面是告警时记录的数字。")} else {A.t("Recorded "+when+".","这是"+when+" 的记录。")}
    if live==nil || live.ceiling==nil || live.remaining==nil {return head}
    if live.remaining>0 {return head+A.t(" Now it’s back under the maximum, with "+A.tokens(live.remaining)+" left; the alert clears by itself.","现在已回到上限以内，还剩 "+A.tokens(live.remaining)+"；告警会自动解除。")}
    return head+A.t(" It’s still at or over the maximum now.","现在仍达到或超出上限。")
}
// "October" for the month an alert's figures belong to.
A.alert_period=fn(p){
    if p.start==nil {return ""}
    let c=A.pool_civil(p.start)
    if p.period=="day" {return A.t(A.pool_month_name(c.m)+" "+c.d,""+c.m+" 月 "+c.d+" 日")}
    return A.t(A.pool_month_name(c.m),""+c.m+" 月")
}
A.alert_when=fn(row,field){
    let text=A.recipient_optional(row,field)
    let local=A.recipient_optional(row,field+"Local")
    let day=A.recipient_optional(row,field+"Day")
    if local==nil || !local.is_string() || day==nil {return if text==nil {""} else {""+text}}
    let parts=local.split(" ")
    if parts.len()<2 {return local}
    let date=parts[0].split("-")
    let clock=parts[1]
    if day==0 {return A.t("Today ","今天 ")+clock}
    if day==1 {return A.t("Yesterday ","昨天 ")+clock}
    if day==-1 {return A.t("Tomorrow ","明天 ")+clock}
    if date.len()==3 {return A.t(date[1]+"/"+date[2]+" "+clock,""+date[1].to_f64()+" 月 "+date[2].to_f64()+" 日 "+clock)}
    return local
}
// The pool's live remaining capacity, to sit beside an alert's snapshot.
A.alert_live_left=fn(rid){
    let detail=H.resource_detail!=nil && H.resource_detail.resource.id==rid
    if detail && H.page!="resources" {return A.pool_budget(H.resource_detail.resource)}
    for row in H.resources {if row.id==rid {return A.pool_budget(row)}}
    if detail {return A.pool_budget(H.resource_detail.resource)}
    return nil
}
// A ceiling alert whose pool is back under its maximum now. It clears by itself,
// so it is neither counted nor worded as something the owner has to handle.
A.alert_recovered=fn(row){
    if A.alert_kind_of(row)!="ceiling" || row.status=="resolved" {return false}
    let live=A.alert_live_left(row.resourceId)
    return live!=nil && live.ceiling!=nil && live.remaining!=nil && live.remaining>0
}
// What an owner does with an alert, in one tap: no assignment (a pool has one owner),
// and "resolved" only for alerts that don't clear by themselves.
A.alert_quick_states=fn(row){
    let out=[]
    let ceiling=A.alert_kind_of(row)=="ceiling"
    let {next=[]}=row
    for state in ["acknowledged","suppressed","resolved","open"] {
        let allowed={v:false} for n in next {if n==state {allowed.v=true}}
        // An alert that has cleared (or is clearing by itself) has nothing to snooze.
        let cleared=row.status=="resolved" || A.alert_recovered(row)
        if allowed.v && !(ceiling && state=="resolved") && !(cleared && state=="suppressed") {out.push(state)}
    }
    return out
}
A.alert_quick=fn(state){
    if H.busy || H.command!=nil || H.alert_detail==nil {return}
    let row=H.alert_detail.alert let allowed={v:false}
    for next in row.next {if state==next {allowed.v=true}}
    if !allowed.v {return}
    H.alert_saved=nil
    H.alert_draft={resourceId:row.resourceId id:row.id expectedRevision:row.revision to:state note:"" quick:true}
    A.submit_alert()
}
A.alert_pill_text=fn(row){
    if A.alert_recovered(row) {return A.t("Recovered · clears by itself","已恢复 · 会自动解除")}
    return A.alert_severity(row.severity)+" · "+A.alert_state(row.status)
}
A.alert_status_line=fn(row){
    if A.alert_recovered(row) {return A.t("Recovered","已恢复")+" · "+A.sub_times(row.occurrences)}
    return A.alert_severity(row.severity)+" · "+A.alert_state(row.status)+" · "+A.sub_times(row.occurrences)
}
// When the alert's figures were recorded, for a pool that has since recovered.
A.alert_when_line=fn(row){
    let when=A.alert_when(row,"lastSeen")
    return if when=="" {A.t("These are the figures recorded with the alert.","上面是告警时记录的数字。")} else {A.t("Recorded "+when+".","这是"+when+" 的记录。")}
}
A.alert_saved_text=fn(state){
    if state=="acknowledged" {return A.t("Marked “Got It”.","已标记为“知道了”。")}
    if state=="suppressed" {return A.t("No reminders for the next 24 hours.","接下来 24 小时内不再提醒。")}
    if state=="resolved" {return A.t("Marked as handled.","已标记为处理好了。")}
    if state=="open" {return A.t("It will remind you again.","已重新打开，会继续提醒。")}
    return A.t("Saved: ","已更新：")+A.alert_state(state)
}

// Health & Recovery: alerts, interrupted tasks and workspaces of one pool.
// One count per concept, used by the hubs and by these helpers alike: what the
// 工具与权限 tab calls 待处理 (tool approvals plus Agent requests you can decide),
// and what 健康与恢复 counts (open alerts, tasks you can handle, workspaces to clear).
A.count_shared_decisions=fn(rows){let n={c:0} for row in rows {let {decision=nil,canDecide=false}=row if decision==nil && canDecide==true {n.c=n.c+1}} return n.c}
A.count_open_alerts=fn(rows){let n={c:0} for row in rows {let {status=nil}=row if status=="open" && !A.alert_recovered(row) {n.c=n.c+1}} return n.c}
A.count_stopped_ready=fn(rows){let n={c:0} for row in rows {let {inspectionAvailable=false,sharedResourceAuthority=false}=row if inspectionAvailable==true && sharedResourceAuthority==true {n.c=n.c+1}} return n.c}
A.count_workspaces_due=fn(rows){let n={c:0} for row in rows {let {dirty=false,quarantined=false,releaseBlock=nil,activeLeases=0}=row if (dirty==true || quarantined==true) && releaseBlock!="shared_resource_authority" && activeLeases==0 {n.c=n.c+1}} return n.c}
// Badge counts for other pages. They read without the shared busy lock and never
// change the page. done gets {pending tools shared complete}; parts it couldn't read are nil.
A.tools_attention=fn(resource,done){
    let n={tools:nil shared:nil}
    host.request("hagency.tool_approvals.list",{resourceId:resource engagementId:"" after:""},fn(r){
        if r.is_ok {n.tools=A.tool_live_count(r.data)}
        host.request("hagency.shared_approvals.list",{},fn(q){
            if q.is_ok {let {approvals=[]}=q.data n.shared=A.count_shared_decisions(approvals)}
            done({pending:(if n.tools==nil {0} else {n.tools})+(if n.shared==nil {0} else {n.shared}) tools:n.tools shared:n.shared complete:n.tools!=nil && n.shared!=nil})
        })
    })
}
A.tool_live_count=fn(data){
    let {approvals=[],observedAtMs=0}=data
    let n={count:0}
    for row in approvals {if row.state=="pending" && row.expiresAt>observedAtMs {n.count=n.count+1}}
    return n.count
}
// done gets {alerts stopped workspaces total stoppedAll}: stopped counts the
// interrupted tasks you can handle now, stoppedAll every one listed.
A.health_attention=fn(resource,done){
    let c={alerts:nil stopped:nil stoppedAll:nil workspaces:nil total:0 alertKind:nil}
    host.request("hagency.alerts.list",{resourceId:resource after:"" status:"open"},fn(a){
        if a.is_ok {let {alerts=[]}=a.data c.alerts=A.count_open_alerts(alerts) for row in alerts {if c.alertKind==nil && A.recipient_optional(row,"status")=="open" && !A.alert_recovered(row) {c.alertKind=A.alert_kind_of(row)}}}
        host.request("hagency.stopped.list",{resourceId:resource workspaceId:"" after:""},fn(t){
            if t.is_ok {let {dispatches=[]}=t.data c.stopped=A.count_stopped_ready(dispatches) c.stoppedAll=dispatches.len()}
            host.request("hagency.workspaces.list",{resourceId:resource after:""},fn(w){
                if w.is_ok {let {workspaces=[]}=w.data c.workspaces=A.count_workspaces_due(workspaces)}
                c.total=(if c.alerts==nil {0} else {c.alerts})+(if c.stopped==nil {0} else {c.stopped})+(if c.workspaces==nil {0} else {c.workspaces})
                done(c)
            })
        })
    })
}
A.health_part=fn(kind){let h=H.health if kind=="alerts" {return h.alerts} if kind=="stopped" {return h.stopped} return h.workspaces}
A.health_open=fn(resource,filter,workspace){
    if H.busy || resource=="" {return}
    let h=H.health
    if h.resource!=resource {h.workspace="" h.alerts.filter="all"}
    if filter!=nil {h.alerts.filter=filter}
    if workspace!=nil {h.workspace=workspace}
    h.resource=resource h.epoch=h.epoch+1
    H.page="health_hub" H.notice="" H.bar_past=false H.alert_saved=nil
    H.alert_resource=resource H.stopped_resource=resource H.stopped_workspace=h.workspace H.workspace_resource=resource
    for kind in ["alerts","stopped","workspaces"] {let part=A.health_part(kind) part.state="loading" part.error="" part.items=[] part.next=nil}
    A.health_load("alerts",h.epoch,true)
}
A.health_rows=fn(kind,data,resource,after){
    if !data.is_object() {return nil}
    if kind=="alerts" {
        let {resourceId=nil,alerts=nil,nextAfter=nil}=data
        if resourceId!=resource || (!alerts.is_array() && !alerts.is_object()) || (nextAfter!=nil && (!nextAfter.is_string() || nextAfter==after)) {return nil}
        return alerts
    }
    if kind=="stopped" {
        let {resourceId=nil,dispatches=nil,nextAfter=nil}=data
        if resourceId!=resource || (!dispatches.is_array() && !dispatches.is_object()) || dispatches.len()>16 || (nextAfter!=nil && (!nextAfter.is_string() || nextAfter==after)) {return nil}
        for row in dispatches {if !A.stopped_attempt_valid(row,resource) {return nil}}
        return dispatches
    }
    let {resourceId=nil,workspaces=nil,nextAfter=nil}=data
    if resourceId!=resource || (!workspaces.is_array() && !workspaces.is_object()) || workspaces.len()>16 || (nextAfter!=nil && (!nextAfter.is_string() || nextAfter==after)) {return nil}
    for row in workspaces {if !row.is_object() {return nil} let {workspaceId=""}=row if !A.workspace_valid(row,resource,workspaceId) {return nil}}
    return workspaces
}
A.health_next=fn(kind){
    if H.page!="health_hub" {return}
    if kind=="alerts" {A.health_load("stopped",H.health.epoch,true)}
    if kind=="stopped" {A.health_load("workspaces",H.health.epoch,true)}
    if kind=="workspaces" {A.nav_scroll()}
}
A.health_load=fn(kind,epoch,chain){
    let h=H.health
    let part=A.health_part(kind)
    let resource=h.resource
    let after=if part.next==nil {""} else {part.next}
    let q={service:"hagency.workspaces.list" args:{resourceId:resource after:after}}
    if kind=="alerts" {q.service="hagency.alerts.list" q.args={resourceId:resource after:after status:if h.alerts.filter=="open" {"open"} else {nil}}}
    if kind=="stopped" {q.service="hagency.stopped.list" q.args={resourceId:resource workspaceId:h.workspace after:after}}
    part.state="loading" part.error=""
    if after=="" {part.items=[]}
    let started=A.sub_read(q.service,q.args,fn(data){
        if h.epoch!=epoch || h.resource!=resource {return}
        let rows=A.health_rows(kind,data,resource,after)
        if rows==nil {part.state="error" part.error="management_invalid_result"} else {
            for row in rows {part.items.push(row)}
            let {nextAfter=nil}=data
            part.next=nextAfter part.state="ready"
        }
        if chain {A.health_next(kind)}
    },fn(code){
        if h.epoch!=epoch || h.resource!=resource {return}
        part.state="error" part.error=code
        if chain {A.health_next(kind)}
    })
    if !started {part.state="error" part.error="management_busy"}
}
A.health_alert_rows=fn(){
    let a=H.health.alerts
    if a.filter!="open" {return a.items}
    let out=[]
    for row in a.items {if row.status=="open" {out.push(row)}}
    return out
}
A.health_more=fn(kind){if H.busy || H.page!="health_hub" {return} A.health_load(kind,H.health.epoch,false)}
A.health_retry=fn(kind){if H.busy || H.page!="health_hub" {return} A.health_load(kind,H.health.epoch,false)}
A.health_filter=fn(filter){
    let a=H.health.alerts
    if H.busy || H.page!="health_hub" || a.filter==filter {return}
    a.filter=filter a.next=nil
    A.health_load("alerts",H.health.epoch,false)
}
A.health_all_tasks=fn(){
    let h=H.health
    if H.busy || H.page!="health_hub" {return}
    h.workspace="" H.stopped_workspace="" h.stopped.next=nil
    A.health_load("stopped",h.epoch,false)
}
A.health_counts=fn(){
    let h=H.health
    let c={alerts:A.count_open_alerts(h.alerts.items) stopped:A.count_stopped_ready(h.stopped.items) workspaces:A.count_workspaces_due(h.workspaces.items) more:false loading:false failed:false}
    for kind in ["alerts","stopped","workspaces"] {let part=A.health_part(kind) if part.state=="loading" {c.loading=true} if part.state=="error" {c.failed=true} if part.next!=nil {c.more=true}}
    c.total=c.alerts+c.stopped+c.workspaces
    return c
}
A.alert_tone=fn(row){if row.status=="resolved" {return ""} if A.alert_recovered(row) {return "running"} return A.sub_tone(row.severity)}
A.alert_next=fn(row){
    if A.alert_recovered(row) {return A.t("Back under the maximum · clears by itself, nothing to do","已回到上限以内，会自动解除，不用处理")}
    if A.alert_kind_of(row)=="ceiling" && row.status!="resolved" && row.status!="suppressed" {return A.t("Next: raise the monthly maximum, or stop some Agents","建议：调高每月上限，或停止部分 Agent")}
    if row.status=="open" {return A.t("Next: check what it affects, then decide","建议：看看影响，再决定怎么处理")}
    if row.status=="acknowledged" {return A.t("Once it’s fixed, mark it handled","处理好后，再标记「已处理好」")}
    if row.status=="assigned" {return A.t("Being handled · mark it handled when done","处理中，处理好后标记一下")}
    if row.status=="suppressed" {return A.t("Muted for now · it will remind you again","已暂时静音，到期后会再次提醒")}
    if row.status=="resolved" {return A.t("Handled · nothing to do","已处理好，无需操作")}
    return A.t("Open it to see what to do","打开查看处理建议")
}
A.alert_action_icon=fn(state){
    if state=="acknowledged" {return mod.rinx_icons.eye}
    if state=="assigned" {return mod.rinx_icons.person}
    if state=="suppressed" {return mod.rinx_icons.pause}
    if state=="resolved" {return mod.rinx_icons.check}
    return mod.rinx_icons.sync
}
A.alert_tile_label=fn(state){
    if state=="acknowledged" {return A.t("Got It","知道了")}
    if state=="assigned" {return A.t("I’ll Handle It","由我处理")}
    if state=="suppressed" {return A.t("Mute 24 Hours","24 小时不提醒")}
    if state=="resolved" {return A.t("It’s Handled","已处理好")}
    return A.t("Remind Me Again","继续提醒")
}
A.alert_action_hint=fn(state){
    if state=="acknowledged" {return A.t("Records that you’ve seen it","记下你已经看到它")}
    if state=="assigned" {return A.t("You’ll handle it","表示由你负责处理")}
    if state=="suppressed" {return A.t("No reminders for 24 hours","24 小时内不再提醒")}
    if state=="resolved" {return A.t("The problem is fixed","问题已经处理好")}
    return A.t("It will remind you again","会继续提醒你")
}
// Where an interrupted task ran, by name: its project when known, and its pool.
A.stopped_where=fn(attempt){
    let name=A.recipient_optional(attempt,"projectName")
    let pool=A.t("Pool ","资源池「")+A.sub_pool_name(attempt.resourceId)+A.t("","」")
    return if name!=nil && name!="" {A.t("Project “"+name+"” · ","项目「"+name+"」 · ")+pool} else {pool}
}
A.stopped_tone=fn(row){return if row.inspectionAvailable && row.sharedResourceAuthority {"waiting"} else {""}}
A.stopped_next=fn(row){
    if !row.sharedResourceAuthority {return A.t("Needs access to every pool that shares its workspace","需要共用此工作区的所有资源池的权限")}
    if !row.inspectionAvailable {return A.t("Its record isn’t ready yet · tap Refresh in a moment","它的记录还没准备好，过一会儿点「刷新」")}
    return A.t("Next: see where it stopped, then decide","建议：看看它停在哪里，再决定怎么处理")
}
A.workspace_tone=fn(row){
    if row.releaseBlock=="shared_resource_authority" {return ""}
    if row.quarantined {return "attention"}
    if row.activeLeases>0 {return "elsewhere"}
    if row.dirty {return "waiting"}
    return "running"
}
// Only rows with something to do open a page; the rest just say why there is nothing to do.
A.workspace_actionable=fn(row){return row.quarantined==true || (row.dirty==true && row.activeLeases==0 && row.releaseBlock!="shared_resource_authority")}
A.workspace_next=fn(row){
    if row.releaseBlock=="shared_resource_authority" {return A.t("Needs access to every pool that shares it","需要共用它的所有资源池的权限")}
    if row.quarantined {return A.t("Next: resolve the interrupted task first","建议：先处理中断的任务")}
    if row.activeLeases>0 {return A.t("Nothing to do until the task finishes","任务结束前无需操作")}
    if row.dirty {return A.t("Next: check it, then clear the marker","建议：检查后允许再次使用")}
    return A.t("Nothing to do","无需操作")
}
A.workspace_label=fn(row){
    let id=row.workspaceId
    let engagement=id.strip_prefix("work_")
    if engagement==id {return A.t("Agent workspace","Agent 工作区")}
    for item in H.health.stopped.items {if item.engagementId==engagement {return A.t(item.agent+"’s workspace",A.sub_join(item.agent,"的工作区"))}}
    if H.policy_list!=nil {for item in H.policy_list.agents {if item.engagementId==engagement {return A.t(item.agent+"’s workspace",A.sub_join(item.agent,"的工作区"))}}}
    return A.t("Agent workspace","Agent 工作区")
}
// Without an Agent name, describe how the workspace is used instead of repeating a generic label.
A.workspace_usage=fn(row){
    let name=A.workspace_label(row)
    if name!=A.t("Agent workspace","Agent 工作区") {return name}
    if row.activeLeases>0 {return A.t(""+row.activeLeases+(if row.activeLeases==1 {" task is using it"} else {" tasks are using it"}),""+row.activeLeases+" 个任务正在使用")}
    if row.sharedResourceCount>1 {return A.t("Shared with "+row.sharedResourceCount+" pools","与 "+row.sharedResourceCount+" 个资源池共用")}
    return A.t("Used by this pool only","只有此资源池使用")
}
A.stopped_entry_size=fn(entry){
    if entry.kind=="directory" {return A.t("Folder","文件夹")}
    if entry.kind=="symlink" {return A.t("Link","链接")}
    let {bytes=nil}=entry
    if bytes==nil {return ""}
    if bytes<1024 {return ""+bytes+" B"}
    if bytes<1048576 {return ""+floor(bytes/1024)+" KB"}
    return ""+floor(bytes/1048576)+" MB"
}
A.stopped_action_hint=fn(action){
    if action=="continue" {return A.t("The Agent picks up where it stopped, in the same workspace","Agent 在同一个工作区里，从停下的地方接着做")}
    if action=="accept_completed" {return A.t("Mark the task done; nothing more runs","把任务标记为已完成，不再运行")}
    return A.t("Nothing runs; you can come back to it later","先不运行，之后再决定")
}
A.tpl_old=fn(p){
    let t=H.templates
    if t.detail==nil || p==nil {return nil}
    let {definitionId=""}=p
    return if t.detail.definition.id==definitionId {t.detail.definition} else {nil}
}
A.tpl_enabled_word=fn(on){return if on {A.t("Allowed","允许")} else {A.t("Off","停用")}}
A.template_tone=fn(status){if status=="provisioned" {return "running"} if status=="reserved" {return "elsewhere"} return ""}
A.template_status_short=fn(status){if status=="provisioned" {return A.t("Has an Agent","已有 Agent")} if status=="reserved" {return A.t("Reserved","已预留")} return A.t("Not used yet","尚未使用")}
A.web_section_label=fn(section){if section=="offers" {return A.t("Roles","角色")} if section=="trust" {return A.t("Trusted","信任的项目")} return A.t("Settings","设置")}
A.web_agent_name=fn(engagement){
    let c=H.web.catalog
    if c!=nil {let {agents=[]}=c for row in agents {if row.id==engagement {return row.name}}}
    return A.t("An unconfigured Agent","未配置的 Agent")
}
A.web_amount=fn(value){return if value==nil {A.t("Not set","未设置")} else {A.tokens(value)}}
A.web_count=fn(value){return if value==nil {A.t("Not set","未设置")} else {""+value}}

A.personal_reason = fn(code){
    if code == "local_revision_conflict" || code == "personal_agent_settings_changed" {return A.t("The agent or policy changed. Refresh its settings before reviewing another edit.", "Agent 或权限已变化，请刷新后再改。")}
    if code == "personal_policy_original_device_required" {return A.t("Recover this request on the device that originally sent it. Its command identity is retained.", "请在最初发送此请求的设备上恢复，原始请求标识已保留。")}
    if code == "configuration_device_offline" || code == "configuration_device_unavailable" {return A.t("The agent’s execution device is offline. Bring it online and refresh before reviewing another request.", "运行 Agent 的电脑离线了，请让它联网后刷新再试。")}
    if code == "configuration_unsupported" {return A.t("Local-agent configuration is currently unavailable on this server. Any pending request keeps its original identity for recovery.", "此服务器当前未提供本地 Agent 配置，待处理请求会保留原始标识以便恢复。")}
    if code == "configuration_request_busy" || code == "configuration_queue_full" {return A.t("The execution device has another configuration request. Wait for it, then refresh.", "执行设备正在处理其他配置请求，请等待后刷新。")}
    if code == "invalid_personal_policy" {return A.t("Choose a policy mode and a nonnegative whole token limit within the supported range.", "请选择策略模式，并输入支持范围内的非负整数 token 上限。")}
    if code == "configuration_outcome_unknown" || code == "configuration_request_expired" || code == "management_outcome_unknown" {return A.t("The settings request outcome is unknown. Recover the original saved request; do not submit a replacement.", "设置请求结果未知，请恢复已保存的原请求，不要另建替代请求。")}
    return A.error_text(code)
}
A.personal_not_applied = fn(service,code){
    let common=code == "personal_agent_not_found" || code == "personal_agent_settings_changed" || code == "configuration_device_offline" || code == "configuration_device_unavailable" || code == "configuration_queue_full" || code == "configuration_request_busy" || code == "execution_device_required" || code == "agent_retired"
    if service == "hagency.personal_agents.observe" {return common || code == "invalid_personal_observation"}
    if service == "hagency.personal_agents.policy.save" {return common || code == "invalid_personal_policy" || code == "personal_policy_observation_required" || code == "local_revision_conflict" || code == "invalid_local_policy"}
    return false
}
A.personal_period = fn(value){
    if value == "lifetime" {return A.t("Lifetime", "累计")}
    if value == "utc_day" {return A.t("Daily (UTC)", "每日（UTC）")}
    if value == "utc_month" {return A.t("Monthly (UTC)", "每月（UTC）")}
    return value
}
A.personal_policy_mode = fn(value){
    if value == "allow" {return A.t("Allow", "允许")}
    if value == "deny" {return A.t("Deny", "拒绝")}
    if value == "ask_owner" {return A.t("Ask owner", "询问主人")}
    if value == "rules" {return A.t("Custom rules", "自定义规则")}
    if value == "unset" {return A.t("Not set", "未设置")}
    if value == "unlimited" {return A.t("Unlimited", "不限")}
    if value == "tokens" {return A.t("Token limit", "Token 上限")}
    return value
}
A.open_personal_agents = fn(after,page){
    if H.busy {return}
    // Local agents are listed on the Agent tab, above project Agents.
    if H.entry_role=="manager" {A.navigate("agent_home") return}
    H.page="personal_agents" H.personal_list=nil H.personal_after=after H.personal_page=page
    A.request("hagency.personal_agents.list",{after:after limit:16},fn(data){
        if data.protocol != "hagency-personal-settings-v1" {H.notice=A.personal_reason("personal_agent_settings_invalid") return}
        H.personal_list=data
    })
}
A.open_personal_agent = fn(id){
    if H.busy {return}
    if H.personal_id != id {H.personal_result=nil H.personal_observed=nil H.personal_config.result=nil}
    H.personal_id=id H.page="personal_agent" H.personal_detail=nil H.personal_mode="detail" H.personal_draft=nil
    A.local_status_load(id)
    A.request("hagency.personal_agents.get",{id:id},fn(data){
        if data.protocol != "hagency-personal-settings-v1" || data.agent.id != id {H.notice=A.personal_reason("personal_agent_settings_invalid") return}
        H.personal_detail=data
    })
}
A.personal_can_observe = fn(){
    if H.busy || H.command != nil || H.personal_detail == nil {return false}
    let s=H.personal_detail.settings
    return s.supported && s.online && H.personal_detail.agent.executionDeviceId != nil
}
A.review_personal_observation = fn(){
    if !A.personal_can_observe() {return}
    let row=H.personal_detail.agent
    H.personal_draft={agentId:row.id expectedGeneration:row.generation}
    H.personal_mode="observe_review" A.redraw()
}
A.submit_personal_observation = fn(){
    if !A.personal_can_observe() || H.personal_mode != "observe_review" || H.personal_draft == nil {return}
    let d=H.personal_draft
    if d.agentId != H.personal_detail.agent.id || d.expectedGeneration != H.personal_detail.agent.generation {return}
    A.submit("hagency.personal_agents.observe",{agentId:d.agentId expectedGeneration:d.expectedGeneration})
}
A.personal_observation_received = fn(data){
    H.personal_id=data.agentId H.personal_observed=data H.personal_mode="detail" H.personal_draft=nil H.personal_detail=nil H.page="personal_agent"
}
A.personal_can_edit = fn(){
    if H.busy || H.command != nil || H.personal_detail == nil {return false}
    let s=H.personal_detail.settings
    return s.supported && s.online && s.observation != nil
}
A.edit_personal_policy = fn(){
    if !A.personal_can_edit() {return}
    let row=H.personal_detail.agent
    let o=H.personal_detail.settings.observation
    H.personal_draft={agentId:row.id expectedGeneration:row.generation expectedRevision:o.policyRevision
        kind:o.budget.kind tokens:if o.budget.tokens == nil {""} else {""+o.budget.tokens} period:o.budget.period
        requests:o.requests highRiskTools:o.highRiskTools replacesRules:o.highRiskTools == "rules"}
    H.personal_mode="edit" H.local_rechecked=false A.redraw()
}
A.personal_valid = fn(){
    if H.personal_draft == nil {return false}
    let d=H.personal_draft
    if d.highRiskTools != "deny" && d.highRiskTools != "ask_owner" {return false}
    if d.kind == "tokens" {
        let value=d.tokens.trim()
        if value == "" || value.len() > 64 {return false}
        for byte in value.to_bytes() {if byte < 48 || byte > 57 {return false}}
        let n=value.to_f64()
        return n >= 0 && n <= 9007199254740991
    }
    return d.kind == "unset" || d.kind == "unlimited"
}
A.review_personal_policy = fn(){
    if !A.personal_can_edit() {return}
    if !A.personal_valid() {H.notice=A.personal_reason("invalid_personal_policy") A.redraw() return}
    H.personal_mode="review" H.notice="" A.redraw()
}
A.submit_personal_policy = fn(){
    if !A.personal_can_edit() || H.personal_mode != "review" || !A.personal_valid() {return}
    let d=H.personal_draft
    if d.agentId != H.personal_detail.agent.id || d.expectedGeneration != H.personal_detail.agent.generation {return}
    A.submit("hagency.personal_agents.policy.save",{agentId:d.agentId expectedGeneration:d.expectedGeneration expectedRevision:d.expectedRevision
        policy:{budget:{kind:d.kind tokens:if d.kind == "tokens" {d.tokens.trim().to_f64()} else {nil} period:d.period} requests:d.requests highRiskTools:d.highRiskTools}})
}
A.personal_saved = fn(data){
    H.personal_observed=nil
    H.personal_id=data.agentId H.personal_result=data H.personal_mode="detail" H.personal_draft=nil H.personal_detail=nil H.page="personal_agent"
}
A.personal_config_service=fn(service){return service=="hagency.personal_agents.model.save" || service=="hagency.personal_agents.workspace.prepare" || service=="hagency.personal_agents.rules.edit"}
A.personal_config_operation=fn(operation){return operation=="personal_agent_model" || operation=="personal_agent_workspace" || operation=="personal_agent_rules"}
A.personal_config_reason=fn(code){
    if code=="personal_configuration_cancelled" {return A.t("Settings review closed. No replacement request was sent.","已关闭设置确认，未发送替代请求。")}
    if code=="personal_execution_device_required" {return A.t("Open Hagency on this agent’s execution device to select folders or edit custom rules.","请在此 Agent 的执行设备上打开 Hagency，以选择目录或编辑自定义规则。")}
    if code=="personal_model_observation_required" || code=="personal_policy_observation_required" {return A.t("Read current settings from the execution device before editing.","编辑前请先从执行设备读取当前设置。")}
    if code=="personal_model_changed" || code=="configuration_model_unavailable" {return A.t("The model choices changed. Read current settings, then choose an available model again.","可用模型已变化，请读取当前设置后重新选择模型。")}
    if code=="invalid_personal_rules" {return A.t("Use 1–64 exact tool names and existing directories in the native rules editor.","请在确认窗口的规则编辑器里填写 1–64 个准确的工具名称和已有的目录。")}
    if code=="invalid_personal_model" {return A.t("Choose a listed model and one of its supported reasoning levels.","请选择列表中的模型及其支持的推理强度。")}
    if code=="personal_workspace_required" {return A.t("Choose the default workspace, or select a folder in the native review.","请选择默认工作区，或在确认窗口中选择目录。")}
    if code=="management_saved_command_not_found" {return A.t("No saved result is available for the original request. Keep its identity and refresh Saved commands before any new edit.","尚无原请求的保存结果，请保留原标识并刷新已保存请求，再进行其他编辑。")}
    if code=="configuration_runtime_busy" {return A.t("The agent is busy. Wait for its current work to finish before changing settings.","Agent 正在工作，请等待当前工作完成后再修改设置。")}
    return A.personal_reason(code)
}
A.open_personal_model=fn(){
    if !A.personal_can_edit(){return}
    let row=H.personal_detail.agent
    let p=H.personal_config
    p.epoch=p.epoch+1 p.choices=nil p.draft=nil p.offset=0 H.page="personal_model" H.busy=true H.notice="" H.local_effort_note=""
    let epoch=p.epoch let id=row.id let generation=row.generation
    A.redraw()
    host.request("hagency.personal_agents.model.choices",{id:id},fn(r){
        if H.personal_config.epoch!=epoch{return}
        H.busy=false
        if H.page!="personal_model" || H.personal_id!=id{A.redraw() return}
        if !r.is_ok{H.notice=A.personal_config_reason(r.error) A.redraw() return}
        let data=r.data
        if data.agentId!=id || data.generation!=generation || data.models.len()>256 {H.notice=A.personal_config_reason("personal_agent_settings_changed") A.redraw() return}
        for choice in data.models{if choice.reasoningEfforts.len()>16{H.notice=A.personal_config_reason("invalid_personal_model") A.redraw() return}}
        p.choices=data p.draft={agentId:id expectedGeneration:generation expectedProfileDigest:data.profileDigest runtime:"" model:"" reasoningEffort:"" webSearch:false workspace:if data.workspaceConfigured{"preserve"}else{"default"}}
        if data.current!=nil{
            p.draft.webSearch=data.current.webSearch
            for choice in data.models{if choice.runtime==data.current.runtime && choice.model==data.current.model{
                p.draft.runtime=choice.runtime p.draft.model=choice.model
                for effort in choice.reasoningEfforts{if effort==data.current.reasoningEffort{p.draft.reasoningEffort=effort}}
            }}
        }
        A.redraw()
    })
}
A.personal_model_choice=fn(){
    let p=H.personal_config
    if p.choices==nil || p.draft==nil{return nil}
    for row in p.choices.models{if row.runtime==p.draft.runtime && row.model==p.draft.model{return row}}
    return nil
}
A.effort_rank=fn(effort){
    if effort=="none" {return 0}
    if effort=="minimal" {return 1}
    if effort=="low" {return 2}
    if effort=="medium" {return 3}
    if effort=="high" {return 4}
    if effort=="xhigh" {return 5}
    if effort=="max" {return 6}
    if effort=="ultra" {return 7}
    return -1
}
A.personal_model_pick=fn(runtime,model){
    if H.busy || H.command!=nil || H.personal_config.choices==nil{return}
    let p=H.personal_config
    for row in p.choices.models{if row.runtime==runtime && row.model==model{
        let s={pick:"" rank:-1}
        let current=A.effort_rank(p.draft.reasoningEffort)
        for effort in row.reasoningEfforts{
            let rank=A.effort_rank(effort)
            if effort==p.draft.reasoningEffort || (s.pick!=p.draft.reasoningEffort && rank<=current && rank>s.rank) {s.pick=effort s.rank=rank}
        }
        let before=p.draft.reasoningEffort
        H.local_effort_note=if before=="" || s.pick==before {""} else if s.pick=="" {A.t(row.displayName+" doesn’t offer "+A.reasoning_label(before)+". Choose a reasoning level.",row.displayName+" 不支持"+A.reasoning_label(before)+"推理强度，请重新选择。")} else {A.t(row.displayName+" doesn’t offer "+A.reasoning_label(before)+", so it now uses "+A.reasoning_label(s.pick)+".",row.displayName+" 不支持"+A.reasoning_label(before)+"推理强度，已改为"+A.reasoning_label(s.pick)+"。")}
        p.draft.runtime=runtime p.draft.model=model p.draft.reasoningEffort=s.pick A.redraw() return
    }}
}
A.personal_model_effort=fn(value){
    if H.busy || H.command!=nil{return}
    let row=A.personal_model_choice()
    if row==nil{return}
    for effort in row.reasoningEfforts{if effort==value{H.personal_config.draft.reasoningEffort=value H.local_effort_note="" A.redraw() return}}
}
A.personal_model_valid=fn(){
    let row=A.personal_model_choice()
    if row==nil{return false}
    let d=H.personal_config.draft
    if d.workspace!="preserve" && d.workspace!="default"{return false}
    if d.workspace=="preserve" && !H.personal_config.choices.workspaceConfigured{return false}
    for effort in row.reasoningEfforts{if effort==d.reasoningEffort{return true}}
    return false
}
A.submit_personal_model=fn(){
    if H.busy || H.command!=nil || H.page!="personal_model"{return}
    if !A.personal_model_valid(){H.notice=A.personal_config_reason("invalid_personal_model") A.redraw() return}
    A.submit("hagency.personal_agents.model.save",H.personal_config.draft.to_json().parse_json())
}
A.submit_personal_native=fn(service){
    if !A.personal_can_edit() || (service!="hagency.personal_agents.workspace.prepare" && service!="hagency.personal_agents.rules.edit"){return}
    let row=H.personal_detail.agent
    A.submit(service,{agentId:row.id expectedGeneration:row.generation})
}
A.personal_config_result_valid=fn(data,commandId,agentId,operation){
    if data==nil{return false}
    let {protocol="",saved=false,workspacePrepared=false,profileDigest="",policyRevision=""}=data
    let actualId=A.recipient_optional(data,"commandId") let actualAgent=A.recipient_optional(data,"agentId")
    if protocol!="hagency-personal-settings-v1" || actualId!=commandId || (actualAgent==nil || actualAgent=="") || (agentId!="" && actualAgent!=agentId){return false}
    if operation=="personal_agent_workspace"{return workspacePrepared}
    if operation=="personal_agent_model"{return saved && profileDigest!=""}
    if operation=="personal_agent_rules"{return saved && policyRevision!=""}
    return false
}
A.personal_config_op=fn(service){
    if service=="hagency.personal_agents.model.save"{return "personal_agent_model"}
    if service=="hagency.personal_agents.workspace.prepare"{return "personal_agent_workspace"}
    return "personal_agent_rules"
}
A.personal_config_recorded=fn(data){
    H.personal_config.result=data H.personal_config.draft=nil H.personal_config.choices=nil
    H.personal_observed=nil H.personal_result=nil H.personal_id=data.agentId H.personal_mode="detail" H.personal_draft=nil H.personal_detail=nil H.page="personal_agent"
}
A.personal_config_not_applied=fn(code){
    for known in ["invalid_personal_policy","personal_agent_not_found","personal_agent_settings_changed","personal_policy_observation_required","configuration_device_offline","configuration_device_unavailable","configuration_queue_full","configuration_request_busy","execution_device_required","agent_retired","local_revision_conflict","invalid_local_policy","invalid_personal_model","personal_model_observation_required","personal_model_changed","personal_workspace_required","personal_execution_device_required","configuration_model_unavailable","configuration_runtime_busy","invalid_personal_rules"]{if code==known{return true}}
    return false
}
A.personal_config_rejected=fn(commandId,code){
    H.command=nil H.personal_config.draft=nil H.personal_config.choices=nil H.personal_detail=nil H.page="personal_agent"
    H.notice=A.personal_config_reason(code)
    if A.save(){
        host.request("hagency.intent.pending",{},fn(reply){
            if reply.is_ok{
                H.saved_commands=reply.data.commands
                for row in reply.data.commands{if row.commandId==commandId && row.hasReply{A.acknowledge(commandId)}}
            }
            A.redraw()
        })
    }
    A.redraw()
}
A.personal_config_reply=fn(command,r){
    if H.command==nil || H.command.args.commandId!=command.args.commandId{return}
    H.busy=false
    if r.is_ok && A.personal_config_result_valid(r.data,command.args.commandId,command.args.agentId,A.personal_config_op(command.service)){
        H.command=nil H.notice="" A.personal_config_recorded(r.data)
        if A.save(){A.acknowledge(command.args.commandId)} A.open_personal_agent(r.data.agentId) A.redraw() return
    }
    if !r.is_ok && A.personal_config_not_applied(r.error){A.personal_config_rejected(command.args.commandId,r.error) return}
    if !r.is_ok && (r.error=="personal_configuration_cancelled" || r.error=="provider_confirmation_expired" || r.error=="personal_confirmation_expired"){
        H.command=nil H.notice=A.personal_config_reason(r.error) A.save()
        host.request("hagency.intent.pending",{},fn(reply){if reply.is_ok{H.saved_commands=reply.data.commands} A.redraw()}) A.redraw() return
    }
    command.nativeRecover=true A.save()
    H.notice=if r.is_ok{A.personal_config_reason("management_outcome_unknown")}else{A.personal_config_reason(r.error)} A.redraw()
}
A.recover_personal_config=fn(commandId,operation,agentId){
    if H.busy{return}
    if H.command!=nil && H.command.args.commandId!=commandId{return}
    H.busy=true H.notice=A.t("Recovering the original settings request…","正在恢复原始设置请求…") A.redraw()
    host.request("hagency.intent.retry",{commandId:commandId},fn(r){
        H.busy=false
        if H.command!=nil && H.command.args.commandId!=commandId{return}
        if !r.is_ok{
            if A.personal_config_not_applied(r.error){A.personal_config_rejected(commandId,r.error) return}
            H.notice=A.personal_config_reason(r.error) A.redraw() return
        }
        if r.data.operation!=operation || !A.personal_config_result_valid(r.data.data,commandId,agentId,operation){H.notice=A.personal_config_reason("management_outcome_unknown") A.redraw() return}
        H.command=nil H.notice="" A.personal_config_recorded(r.data.data)
        if A.save(){A.acknowledge(commandId)} A.open_personal_agent(r.data.data.agentId) A.redraw()
    })
}

A.personal_state = fn(value){
    if value == "active" {return A.t("Active registration", "有效登记")}
    if value == "suspended" {return A.t("Suspended", "已暂停")}
    if value == "retired" {return A.t("Retired", "已停用")}
    if value == "creating" {return A.t("Creation pending", "待创建")}
    return value
}
A.resource_period = fn(period){
    if period == nil {return A.t("Not declared", "未填写")}
    if period == "monthly" {return A.t("Monthly", "每月")}
    if period == "daily" {return A.t("Daily", "每日")}
    return "" + period
}
A.resource_short_id = fn(id){
    let chars=id.to_chars()
    if chars.len() <= 16 {return id}
    let prefix="".to_chars()
    let suffix="".to_chars()
    for i char in chars {
        if i < 4 {prefix.push(char)}
        if i >= chars.len() - 8 {suffix.push(char)}
    }
    return prefix.to_string() + "…" + suffix.to_string()
}
A.resource_label_id = fn(id){
    let label=A.resource_short_id(id)
    for row in H.resources {
        if row.id != id && A.resource_short_id(row.id) == label {return id}
    }
    return label
}
A.redraw = fn(){
    A.nav_track()
    ui.heading.render() ui.navigation.render() ui.page_bar.render() ui.alert_layer.render() ui.notice.set_text(H.notice) ui.notice.set_visible(H.notice != "" && !H.busy && !A.notice_inline() && !A.sub_page())
    let route = H.page + if H.page == "wizard" {"/" + H.wizard.step} else if H.page == "project_wizard" {"/" + H.project_draft.step} else if H.page == "project_setup" {"/" + H.confirm} else if H.page == "agent_wizard" {"/" + H.agent_review} else if H.page == "agent_action" {"/" + H.agent_confirmation} else if H.page == "personal_agent" {"/"+H.personal_mode} else if H.page=="connection_reoffer" && H.reoffer_draft!=nil {"/"+H.reoffer_draft.review} else if H.page=="connection_history" {"/"+H.history_page} else if H.page=="stopped_task" {"/"+H.stopped_resource+"/"+H.stopped_dispatch+"/"+H.stopped_offset+"/"+H.stopped_mode} else if H.page=="stopped_tasks" {"/"+H.stopped_resource+"/"+H.stopped_workspace+"/"+H.stopped_after} else if H.page=="workspace" {"/"+H.workspace_resource+"/"+H.workspace_id+"/"+H.workspace_mode} else if H.page=="workspaces" {"/"+H.workspace_resource+"/"+H.workspace_after} else if H.page=="execution_policy" {"/"+H.policy_resource+"/"+H.policy_engagement+"/"+H.policy_mode} else if H.page=="execution_policies" {"/"+H.policy_resource+"/"+H.policy_after} else if H.page=="tool_request" {"/"+H.tool_resource+"/"+H.tool_request_id} else if H.page=="tool_approvals" || H.page=="tool_grants" {"/"+H.tool_resource+"/"+H.tool_engagement+"/"+H.tool_after+"/"+H.tool_kind} else if H.page=="approval_bindings" {"/"+H.binding_resource+"/"+H.binding_after+"/"+H.binding_filters.agent+"/"+H.binding_filters.project} else {""}
    let key=route + "/" + A.route_identity()
    if key != H.rendered_route {ui.content.remember_scroll(H.rendered_route) ui.content.reset_scroll() H.rendered_route=key}
    ui.content.body.page.render()
    if H.ux.restore && !H.busy {H.ux.restore=false ui.content.restore_scroll(key)}
}
let on_app_locale_changed = fn(locale){ A.redraw() }
A.save = fn(){
    if H.session == nil { return false }
    let bytes = {version: 1 account: H.session.account wizard: H.wizard workspace:H.entry_role resourceJourney:H.ux.resourceJourney setupAccountId:H.ux.accountId projectDraft: H.project_draft agentDraft:H.agent_draft poolDraft:H.pool_draft command: H.command}.to_json()
    fs.write("onboarding-v1.json", bytes)
    if !fs.exists("onboarding-v1.json") || fs.read("onboarding-v1.json") != bytes {
        H.notice = A.t("Could not save this page. Submitted requests remain recoverable from native storage.", "无法保存此页面；已提交的请求仍可在这台电脑上恢复。")
        return false
    }
    return true
}
A.reauthenticate = fn(){
    if H.busy || !H.needs_signin {return}
    A.request("hagency.account.reauthenticate",{},fn(data){
        if data.state == "cancelled" {H.notice=A.t("Sign-in cancelled. Your existing records and requests are unchanged.", "已取消重新登录，已有记录和请求保持不变。")}
        else {H.notice=A.t("Continue signing in with the same account in Rinx.", "请在 Rinx 中继续使用同一账号登录。")}
    })
}
A.request = fn(service, args, done){
    if H.busy { return }
    H.busy = true H.notice = A.t("Updating…", "正在更新…") A.redraw()
    host.request(service, args, fn(r){
        H.busy = false
        H.ux.errorCode=if r.is_ok{""}else{r.error}
        if !r.is_ok && H.page=="overview" {H.ux.dashboardError=true}
        if !r.is_ok && H.page=="inbox" {H.ux.inboxError=true H.ux.inboxReady=false}
        if !r.is_ok && (r.error == "native_resume_missing" || r.error == "native_resume_revoked") {H.needs_signin=true}
        if r.is_ok { H.notice = "" done(r.data) } else { H.notice = if service=="hagency.connections.history" || H.page=="connection_reoffer" {A.readmission_error(r.error)} else if service == "hagency.agents.settlement.get" {A.settlement_reason(r.error)} else if H.page == "agent_budget" || H.page == "agent_topup" {A.budget_reason(r.error)} else if H.page == "agent_control" {A.control_reason(r.error)} else if H.page == "device_execution" {A.execution_reason(r.error)} else if H.page == "onboarding" {A.onboarding_reason(r.error)} else if H.page == "project_setup" {A.setup_reason(r.error)} else if H.page == "allocations" || H.page == "allocation_action" {A.allocation_reason(r.error)} else if H.page=="stopped_task" || H.page=="stopped_tasks" {A.stopped_error(r.error)} else if H.page=="workspace" || H.page=="workspaces" {A.workspace_error(r.error)} else if H.page=="execution_policy" || H.page=="execution_policies" || H.page=="tool_request" || H.page=="tool_approvals" || H.page=="tool_grants" || H.page=="tool_grant_review" || H.page=="tool_grant_result" {A.tool_error(r.error)} else if H.page=="approval_bindings" || H.page=="approval_binding_review" || H.page=="approval_binding_result" {A.binding_error(r.error)} else if H.page=="resource_alerts" || H.page=="resource_alert" {A.alert_error(r.error)} else if H.page == "resource_detail" && service=="hagency.grants.review" {A.pool_grant_error(r.error)} else if H.page == "resource_detail" {A.resource_error(r.error)} else if H.page == "personal_agents" || H.page == "personal_agent" {A.personal_reason(r.error)} else if H.page == "agents" || H.page == "agent_action" || H.page == "agent_wizard" || H.page == "agent_status" || H.page == "agent_work" || H.page == "agent_work_list" || H.page == "agent_removals" || H.page == "agent_removal" {A.agent_reason(r.error)} else {A.error_text(r.error)} }
        A.redraw()
    })
}
A.observe_verification = fn(connection, observed_at){
    if connection.verification != nil && connection.verification.status == "verified" {
        let seconds = max(0.0, (connection.verification.freshUntilMs - observed_at) / 1000.0 - 1.0)
        if seconds == 0.0 {connection.verification.status = "stale"}
        else {start_timeout(seconds, || {connection.verification.status = "stale" A.redraw()})}
    }
}
A.connections_received = fn(data){
    H.connections = data.items H.connection_after = data.nextAfter
    for connection in H.connections {A.observe_verification(connection, data.observedAtMs)}
}
A.execution_reason = fn(code){
    if code == "shared_successors_disabled" {return A.t("Starting another process is not enabled in this build. Existing agent records and work history remain available.", "此版本尚未启用再次启动进程。已有 Agent 记录与任务历史仍可查看。")}
    if code == "owner_source_adoption_required" || code == "shared_executor_adoption_required" {return A.t("Open Shared capacity to restore this device's native resource access first.", "请先打开共享容量，恢复此设备的原生资源访问。")}
    if code == "adopted_executor_device_reauthorization_required" {return A.t("Open this assignment on its original execution device and owner account.", "请使用原执行设备和资源主人账号打开此分配。")}
    if code == "shared_successor_issuance_unavailable" {return A.t("The server does not currently allow another process. Original saved starts remain recoverable.", "服务器当前不允许启动另一进程。仍可恢复已保存的原始启动请求。")}
    return A.error_text(code)
}
A.open_execution = fn(after){
    if H.busy {return}
    H.page="device_execution" H.execution_page=nil H.execution_after=after
    let args={} if after != nil {args.after=after}
    A.request("hagency.execution.assignments",args,fn(data){H.execution_page=data})
}
A.execution_select = fn(id){
    if H.execution_page == nil || !H.execution_page.supported {return nil}
    for row in H.execution_page.items {if row.assignmentId == id {return row}}
    return nil
}
A.execution_action = fn(id,resume){
    if H.busy {return}
    let row=A.execution_select(id) if row == nil {return}
    if resume && !row.savedStart {return}
    H.execution_result=nil
    A.request(if resume {"hagency.execution.resume"} else {"hagency.execution.review"},{assignmentId:row.assignmentId},fn(data){H.execution_result=data A.open_execution(H.execution_after)})
}
A.execution_result_text = fn(data){
    if data.state == "review_closed" {return A.t("Review closed without confirming a new start.", "已关闭确认窗口，没有启动。")}
    if data.state == "outcome_unknown" {return A.t("The original start may have been submitted. Resume its saved request before considering another start.", "原启动请求可能已提交。请先恢复已保存的请求，再考虑新的启动。")}
    let {result=nil,progress=nil}=data
    if result != nil {
        if result.state == "no_saved_intent" {return A.t("No original start was saved. Resume did not create one.", "没有已保存的原始启动请求，恢复操作未创建请求。")}
        if result.state == "resumed" {progress=result.progress}
    }
    if progress != nil {
        if progress.state == "running" {return A.t("A process was active when checked. Refresh for the latest recorded observation.", "检查时有进程活动。请刷新以查看最新记录。")}
        if progress.state == "recorded" {return A.t("A native observation was recorded. Review agent status and work history for its outcome.", "已有记录，请在 Agent 状态和任务历史里查看结果。")}
        if progress.state == "stopping" {return A.t("The original process is stopping; usage and cleanup may still be unresolved.", "原进程正在停止，用量与清理可能尚未确认。")}
    }
    return A.t("No active process was confirmed. The original start remains recoverable.", "尚未确认活动进程，原启动请求仍可恢复。")
}
A.execution_state = fn(state){
    if state == "stopped" {return A.t("Stopped at last observation", "上次记录：已停止")}
    if state == "qualified" {return A.t("Qualified at last observation", "上次记录：检查通过")}
    return A.t("Current process not confirmed", "当前进程未确认")
}
A.task_status = fn(s){
    if s=="created"{return A.t("Created","已创建")} if s=="accepted"{return A.t("Accepted","已接收")}
    if s=="in_progress"{return A.t("In progress","进行中")} if s=="blocked"{return A.t("Blocked","受阻")} if s=="done"{return A.t("Done","已完成")} return s
}
A.task_write_supported = fn(data){if data==nil{return false} for index key value in data{if key.to_string()=="writeSupported"{return value}} return false}
A.task_text = fn(v){if v==nil || v=="" {return "—"} return v}
A.task_unavailable = fn(){return A.t("This profile uses migrated resource storage. Operator tasks have not been imported into it yet. The original archive is not opened by this screen.","此档案已使用迁移后的资源存储，人工任务尚未导入。此页面不会打开原归档。")}

A.is_task_operation=fn(op){for name in ["task_create","task_edit","task_delete","task_accept","task_transition","task_comment"]{if op==name{return true}} return false}
A.task_permission_list=fn(data,op){for index key value in data{if key.to_string()=="writeOperations"{for allowed in value{if allowed==op{return true}}}} return false}
A.task_permission=fn(data,op){
    if data==nil{return false}
    for index key value in data{if key.to_string()=="writeSupported" && value==true{return A.task_permission_list(data,op)}}
    return false
}
A.task_can=fn(op){if op=="create"{return A.task_permission(H.task_page,op)} return A.task_permission(H.task_detail,op)}

A.task_granularity=fn(value){if value=="epic"{return A.t("Epic","大任务")} if value=="subtask"{return A.t("Subtask","子任务")} return A.t("Task","任务")}
A.task_review_value=fn(input,key){for index name value in input{if name.to_string()==key{if value==nil || value==""{return A.t("Cleared","已清空")} return value}} return A.t("Unchanged","保持原值")}
A.task_action_name=fn(op){
    if op=="create"{return A.t("Create task","创建任务")} if op=="edit"{return A.t("Edit task","编辑任务")}
    if op=="delete"{return A.t("Delete task","删除任务")} if op=="accept"{return A.t("Accept task","接受任务")}
    if op=="transition"{return A.t("Change task status","更改任务状态")} return A.t("Add comment","添加评论")
}
A.task_unresolved=fn(){return H.task_phase=="loading" || H.task_phase=="saving" || H.task_phase=="submitting" || H.task_phase=="unknown" || H.task_phase=="saved"}
A.task_finish=fn(done){
    if H.busy{return}
    let pending=H.task_pending
    if pending==nil || (H.task_phase!="recorded" && H.task_phase!="failed"){return}
    H.busy=true H.page="operator_task_command" H.notice=A.t("Closing saved result…","正在关闭已保存的结果…") A.redraw()
    host.request("hagency.intent.acknowledge",{commandId:pending.commandId},fn(reply){
        H.busy=false
        if reply.is_ok{
            let remaining=[] for row in H.saved_commands{if row.commandId!=pending.commandId{remaining.push(row)}} H.saved_commands=remaining
            if H.task_pending!=nil && H.task_pending.commandId==pending.commandId{H.task_pending=nil H.task_phase="" H.task_draft=nil H.task_error=""}
            H.notice="" done()
        }else{
            H.page="operator_task_command" H.notice=A.t("Could not close this result. Try again.","未能关闭此结果，请重试。")
            if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}
        }
        A.redraw()
    })
}
A.task_begin=fn(op,status){
    if H.busy || H.command!=nil || A.task_unresolved() || !A.task_can(op){return}
    if H.task_pending!=nil && (H.task_phase=="recorded" || H.task_phase=="failed"){A.task_finish(fn(){A.task_begin(op,status)}) return}
    H.task_error="" H.task_pending=nil H.task_phase="editing" H.task_label_draft="" H.task_options_open=false H.task_result_details=false
    let input={title:"" description:"" priority:"p2" granularity:"task" assignee:"" parentId:"" labels:[]}
    let title=A.t("New task","新任务")
    if op!="create"{
        let d=H.task_detail if d==nil || d.task==nil || d.revision==nil{return}
        let t=d.task title=t.title input={id:t.id expectedRevision:d.revision}
        if op=="edit"{input={id:t.id expectedRevision:d.revision title:t.title description:t.description priority:t.priority granularity:t.granularity assignee:if t.assignee==nil{""}else{t.assignee} parentId:if t.parent_id==nil{""}else{t.parent_id} labels:t.labels.to_json().parse_json()}}
        if op=="transition"{let legal=false for next in d.next{if next==status{legal=true}} if !legal{return} input.status=status input.waitingReason="" input.waitingUntil=""}
        if op=="accept"{let legal=false for next in d.next{if next=="accepted"{legal=true}} if !legal{return}}
        if op=="comment"{input.text=""}
    }
    H.task_draft={operation:op title:title input:input} H.page="operator_task_edit" A.redraw()
    if op=="accept" || (op=="transition" && status!="blocked"){A.task_prepare()}
}
A.task_set=fn(key,value){if H.busy || H.task_draft==nil || H.task_phase!="editing"{return} if key=="title"{H.task_draft.input.title=value} if key=="description"{H.task_draft.input.description=value} if key=="priority"{H.task_draft.input.priority=value} if key=="granularity"{H.task_draft.input.granularity=value} if key=="assignee"{H.task_draft.input.assignee=value} if key=="parentId"{H.task_draft.input.parentId=value} if key=="text"{H.task_draft.input.text=value} if key=="waitingReason"{H.task_draft.input.waitingReason=value} if key=="waitingUntil"{H.task_draft.input.waitingUntil=value}}
A.task_add_label=fn(){if H.busy || H.task_draft==nil{return} let label=H.task_label_draft.trim() if label=="" || H.task_draft.input.labels.len()>=20{return} for old in H.task_draft.input.labels{if old==label{return}} H.task_draft.input.labels.push(label) H.task_label_draft="" A.redraw()}
A.task_remove_label=fn(label){if H.busy || H.task_draft==nil{return} let keep=[] for old in H.task_draft.input.labels{if old!=label{keep.push(old)}} H.task_draft.input.labels=keep A.redraw()}
A.task_cancel_edit=fn(){if H.busy{return} let create=H.task_draft==nil || H.task_draft.operation=="create" H.task_draft=nil H.task_phase="" if create{A.open_tasks(H.task_offset)}else{A.open_task(H.task_id,0)}}
A.task_reason=fn(code){
    if code=="management_task_revision_changed"{return A.t("This task changed before your saved edit was applied. Review its latest revision and make a new edit only if needed.","应用已保存的更改前，任务已发生变化。请查看最新版本，仅在仍有需要时另行编辑。")}
    if code=="task_history_not_migrated"{return A.task_unavailable()}
    if code=="management_not_found"{return A.t("This task no longer exists. The original request remains saved.","此任务已不存在，原请求仍然保留。")}
    if code=="invalid_management_arguments"{return A.t("The task fields or status transition could not be applied. Check the current task before making another edit.","任务字段或状态转换无法应用，请先核对当前任务再另行编辑。")}
    return A.error_text(code)
}
A.task_prepared=fn(data){H.task_pending=data H.task_phase=if data.result!=nil{"recorded"}else if data.error!=nil{"failed"}else{"saved"} H.task_error=if data.error==nil{""}else{data.error} H.page="operator_task_command"}
A.task_prepare=fn(){
    if H.busy || H.command!=nil || H.task_draft==nil || H.task_phase!="editing"{return}
    let d=H.task_draft if (d.operation=="create" || d.operation=="edit") && d.input.title.trim()==""{return}
    if d.operation=="comment" && d.input.text.trim()==""{return}
    if d.operation=="transition" && d.input.status=="blocked" && (d.input.waitingReason.trim()=="" || d.input.waitingUntil.trim()==""){return}
    H.busy=true H.task_phase="saving" H.notice=A.t("Saving…","正在保存…") A.redraw()
    host.request("hagency.tasks."+d.operation,d.input.to_json().parse_json(),fn(reply){
        H.busy=false H.notice=""
        if reply.is_ok{A.task_prepared(reply.data) if H.task_phase=="saved"{A.task_apply()}}else{H.task_phase="unknown" H.task_error=reply.error H.page="operator_task_command"}
        A.redraw()
    })
}
A.open_saved_task=fn(row){if H.busy{return} H.task_result_details=false H.page="operator_task_command" H.task_pending=nil H.task_error="" H.task_phase="loading" A.request("hagency.tasks.command.get",{commandId:row.commandId},fn(data){A.task_prepared(data)})}
A.task_apply=fn(){
    if H.task_phase!="saved" && H.task_phase!="unknown"{return}
    if H.busy || H.task_pending==nil || H.task_pending.result!=nil || H.task_pending.error!=nil{return}
    let pending=H.task_pending H.busy=true H.task_phase="submitting" H.task_error="" A.redraw()
    host.request("hagency.tasks.command.apply",{commandId:pending.commandId},fn(reply){
        H.busy=false
        if reply.is_ok{pending.result=reply.data H.task_phase="recorded" H.task_detail=nil}
        else{H.task_error=reply.error H.task_phase=if reply.error=="management_task_revision_changed" || reply.error=="invalid_management_arguments" || reply.error=="management_not_found"{"failed"}else{"unknown"}}
        A.redraw()
    })
}
A.task_current=fn(){if H.busy || H.task_pending==nil{return} let pending=H.task_pending A.task_finish(fn(){if pending.result!=nil && pending.result.deleted{A.open_tasks(H.task_offset)}else{A.open_task(pending.taskId,0)}})}
A.task_saved_refresh=fn(){if H.busy{return} if H.task_pending!=nil{A.open_saved_task(H.task_pending)}else{A.refresh()}}

A.is_graph_operation=fn(op){return op=="graph_create" || op=="graph_update_node" || op=="graph_cancel" || op=="graph_bind_recipient"}
A.flow_delivery=fn(state){if state=="suppressed"{return A.t("Dispatch suppressed","派发已抑制")} if state=="binding_saved"{return A.t("Recipient saved; delivery held","接收方已保存；投递暂缓")} return A.t("Awaiting recipient setup","等待设置接收方")}
A.flow_status=fn(state){
    if state=="active"{return A.t("Recorded active","记录为活动")}
    if state=="pending"{return A.t("Recorded pending","记录为待处理")}
    if state=="dispatched"{return A.t("Dispatch recorded; delivery held","已记录派发；投递暂缓")}
    if state=="complete"{return A.t("Recorded complete","记录为完成")}
    if state=="failed"{return A.t("Recorded failed","记录为失败")}
    if state=="skipped"{return A.t("Recorded skipped","记录为跳过")}
    if state=="cancelled"{return A.t("Recorded cancelled","记录为取消")}
    return state
}
A.flow_notice=fn(){return A.t("These graphs are saved on this device. Recipient bindings do not authorize delivery. A recorded status does not mean an agent received or ran the work.","任务图保存在此设备。接收方绑定不会授权投递，记录的状态不表示 Agent 已收到或执行工作。")}
A.flow_reason=fn(code){
    if code=="management_revision_conflict" || code=="management_graph_revision_changed" || code=="operator_graph_revision_changed"{return A.t("The graph changed. Keep this saved request and inspect the current graph before preparing another change.","任务图已变化。请保留此请求并查看当前任务图，再决定是否另行更改。")}
    if code=="invalid_management_arguments" || code=="graph_invalid"{return A.t("Check the node IDs, dependencies, status and JSON fields. The original request is retained if it was saved.","请检查节点 ID、依赖、状态和 JSON 字段。已保存的原请求仍然保留。")}
    if code=="graph_not_found" || code=="node_not_found" || code=="management_not_found"{return A.t("This graph or node is unavailable. Check the saved request without creating a replacement.","此任务图或节点暂不可用。请检查已保存的请求，不要重复创建。")}
    return A.error_text(code)
}
A.flow_read=fn(service,args,done){
    if H.busy{return} H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch let page=H.page
    H.busy=true H.notice=A.t("Reading task graphs…","正在读取任务图…") A.redraw()
    host.request(service,args,fn(reply){
        if H.flow_epoch!=epoch{return} H.busy=false
        if H.page!=page{A.redraw() return}
        if reply.is_ok{H.notice="" done(reply.data)}else{if H.page=="operator_graph_command"{H.flow_phase="unknown"} H.notice=if H.page=="operator_graph_recipient"{A.recipient_reason(reply.error)}else{A.flow_reason(reply.error)} if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}}
        A.redraw()
    })
}
A.flow_bad_reply=fn(){H.notice=A.t("The returned graph did not match this view. Refresh to read it again.","返回的任务图与当前页面不符，请刷新重读。")}
A.open_flows=fn(after){if H.busy{return} H.page="operator_graphs" H.flow_after=after H.flow_list=nil
    let filter=H.flow_filter let q={after:after} if filter!=""{q.status=filter}
    A.flow_read("hagency.graphs.list",q,fn(v){if H.flow_after!=after || H.flow_filter!=filter{return} if v==nil || v.graphs==nil || v.graphs.len()>16 || v.supported!=true{A.flow_bad_reply() return} H.flow_list=v})
}
A.open_flow=fn(id,after){if H.busy{return} H.page="operator_graph" H.flow_id=id H.flow_node_after=after H.flow_detail=nil
    A.flow_read("hagency.graphs.get",{id:id nodeAfter:after},fn(v){if H.flow_id!=id || H.flow_node_after!=after{return} if v==nil || v.graph==nil || v.graph.id!=id || v.nodes==nil || v.nodes.len()>16 || v.graph.runtimeDeliveryAuthorized!=false{A.flow_bad_reply() return} H.flow_detail=v})
}
A.open_flow_node=fn(id,node){if H.busy{return} H.page="operator_graph_node" H.flow_id=id H.flow_node_id=node H.flow_node=nil H.flow_dep_offset=0
    A.flow_read("hagency.graphs.node",{id:id nodeId:node},fn(v){if H.flow_id!=id || H.flow_node_id!=node{return} if v==nil || v.graphId!=id || v.id!=node || v.dependsOn==nil || v.dependsOn.len()>256 || !v.resultJson.is_string() || v.runtimeDeliveryAuthorized!=false{A.flow_bad_reply() return} H.flow_node=v})
}
A.flow_unresolved=fn(){return H.flow_phase=="saving" || H.flow_phase=="loading" || H.flow_phase=="saved" || H.flow_phase=="submitting" || H.flow_phase=="unknown"}
A.flow_can_edit=fn(){if H.busy || H.command!=nil || A.flow_unresolved() || H.flow_pending!=nil{return false} for row in H.saved_commands{let {hasReply=false}=row if A.is_graph_operation(row.operation) && !hasReply{return false}} return true}
A.flow_new=fn(){if !A.flow_can_edit(){return} H.flow_draft={label:"" nodes:[]} H.flow_update=nil H.flow_editor_offset=0 H.flow_error="" H.flow_phase="editing" H.page="operator_graph_edit" A.redraw()}
A.flow_edit=fn(index){if H.busy || H.flow_draft==nil || H.flow_phase!="editing"{return}
    if index<0 && H.flow_draft.nodes.len()>=256{return}
    H.flow_edit_index=index H.flow_choice_offset=0 H.flow_error=""
    H.flow_edit_node=if index<0{{id:"" assignee:"" description:"" dependsOn:[] conditionJson:""}}else{H.flow_draft.nodes[index].to_json().parse_json()}
    H.flow_edit_old_id=H.flow_edit_node.id H.page="operator_graph_edit_node" A.redraw()
}
A.flow_set_node=fn(key,text){if H.busy || H.flow_edit_node==nil || H.flow_phase!="editing"{return}
    if key=="id"{H.flow_edit_node.id=text} if key=="assignee"{H.flow_edit_node.assignee=text} if key=="description"{H.flow_edit_node.description=text} if key=="conditionJson"{H.flow_edit_node.conditionJson=text}
}
A.flow_has_dep=fn(node,id){for dep in node.dependsOn{if dep==id{return true}} return false}
A.flow_toggle_dep=fn(id){if H.busy || H.flow_edit_node==nil || id==H.flow_edit_node.id || id==H.flow_edit_old_id{return}
    let keep=[] let found=false for dep in H.flow_edit_node.dependsOn{if dep==id{found=true}else{keep.push(dep)}} if !found{keep.push(id)} H.flow_edit_node.dependsOn=keep A.redraw()
}
A.flow_save_node=fn(){if H.busy || H.flow_edit_node==nil || H.flow_draft==nil{return}
    let n=H.flow_edit_node
    if n.id.trim()=="" || n.id.to_chars().len()>255 || n.assignee.trim()=="" || n.assignee.to_chars().len()>255 || n.description.trim()=="" || n.description.to_chars().len()>4000 || n.conditionJson.len()>65536{H.flow_error=A.t("Enter a node ID, recipient name and description within the limits.","请填写长度符合限制的节点 ID、接收方名称与说明。") A.redraw() return}
    for index node in H.flow_draft.nodes{if index!=H.flow_edit_index && node.id==n.id{H.flow_error=A.t("Node IDs must be unique.","节点 ID 不可重复。") A.redraw() return}}
    if A.flow_has_dep(n,n.id){H.flow_error=A.t("A node cannot depend on itself.","节点不能依赖自身。") A.redraw() return}
    if H.flow_edit_index<0{H.flow_draft.nodes.push(n.to_json().parse_json())}else{
        let old=H.flow_edit_old_id H.flow_draft.nodes[H.flow_edit_index]=n.to_json().parse_json()
        if old!=n.id{for node in H.flow_draft.nodes{let deps=[] for dep in node.dependsOn{deps.push(if dep==old{n.id}else{dep})} node.dependsOn=deps}}
    }
    H.flow_edit_node=nil H.flow_error="" H.page="operator_graph_edit" A.redraw()
}
A.flow_remove_node=fn(index){if H.busy || H.flow_draft==nil || H.flow_phase!="editing"{return}
    let id=H.flow_draft.nodes[index].id let keep=[] for i node in H.flow_draft.nodes{if i!=index{let deps=[] for dep in node.dependsOn{if dep!=id{deps.push(dep)}} node.dependsOn=deps keep.push(node)}}
    H.flow_draft.nodes=keep if H.flow_editor_offset>=keep.len(){H.flow_editor_offset=max(0,H.flow_editor_offset-16)} A.redraw()
}
A.flow_prepared=fn(v){
    if v==nil || v.commandId==nil || v.graphId==nil || !A.is_graph_operation(v.operation) || v.change==nil || !v.changeJson.is_string() || v.runtimeDeliveryAuthorized!=false{H.flow_phase="unknown" H.flow_error=A.t("The saved request needs to be checked again.","需要重新检查已保存的请求。") return}
    if (v.operation=="graph_create" && v.change.operation!="create") || (v.operation=="graph_update_node" && v.change.operation!="update_node") || (v.operation=="graph_cancel" && v.change.operation!="cancel") || (v.operation=="graph_bind_recipient" && v.change.operation!="bind_recipient"){H.flow_phase="unknown" A.flow_bad_reply() return}
    if v.operation=="graph_bind_recipient" && (!v.change.nodeId.is_string() || v.change.snapshot==nil || v.change.snapshot.target==nil || !v.change.snapshot.identityJson.is_string() || !v.change.snapshot.account.is_string() || !v.change.snapshot.server.is_string() || v.change.snapshot.graphId!=v.graphId || v.change.snapshot.nodeId!=v.change.nodeId || v.change.snapshot.revision!=v.expectedRevision || v.change.snapshot.runtimeDeliveryAuthorized!=false){H.flow_phase="unknown" A.flow_bad_reply() return}
    if v.result!=nil && (v.result.commandId!=v.commandId || v.result.graphId!=v.graphId || v.result.runtimeDeliveryAuthorized!=false){H.flow_phase="unknown" A.flow_bad_reply() return}
    H.flow_pending=v H.flow_review_offset=0 H.flow_review_json=false H.flow_phase=if v.result!=nil{"recorded"}else if v.error!=nil{"failed"}else{"saved"} H.flow_error=if v.error==nil{""}else{v.error} H.page="operator_graph_command"
}
A.flow_prepare=fn(service,args){if H.busy || H.command!=nil || H.flow_phase!="editing" || H.flow_pending!=nil{return}
    H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch H.busy=true H.flow_phase="saving" H.flow_error="" H.page="operator_graph_command" A.redraw()
    host.request(service,args,fn(reply){
        if H.flow_epoch!=epoch{return} H.busy=false
        if H.page!="operator_graph_command"{A.redraw() return}
        if reply.is_ok{if service=="hagency.graphs.bind_recipient" && !A.recipient_prepared_matches(args,reply.data){H.flow_phase="unknown" H.flow_error="management_outcome_unknown" A.flow_bad_reply()}else{A.flow_prepared(reply.data)}}else{
            H.flow_error=reply.error
            if reply.error=="invalid_management_arguments" || reply.error=="management_not_found" || reply.error=="management_revision_conflict" || (service=="hagency.graphs.bind_recipient" && (reply.error=="management_recipient_changed" || reply.error=="management_recipient_unavailable")){H.flow_phase="editing" H.page=if service=="hagency.graphs.cancel"{"operator_graph"}else if service=="hagency.graphs.update_node"{"operator_graph_update"}else if service=="hagency.graphs.bind_recipient"{"operator_graph_recipient"}else{"operator_graph_edit"} if service=="hagency.graphs.cancel"{H.flow_phase="" H.notice=A.flow_reason(reply.error)} if service=="hagency.graphs.bind_recipient" && H.flow_recipient!=nil{H.flow_recipient.observation=nil if reply.error=="management_revision_conflict"{H.flow_recipient.stale=true}}}else{H.flow_phase="unknown"}
        }
        A.redraw()
    })
}
A.flow_prepare_create=fn(){if H.flow_draft==nil || H.flow_phase!="editing" || H.busy{return}
    let d=H.flow_draft if d.label.trim()=="" || d.label.to_chars().len()>4000 || d.nodes.len()==0 || d.nodes.len()>256{H.flow_error=A.t("Add a graph name and at least one node (maximum 256).","请填写任务图名称并添加节点（最多 256 个）。") A.redraw() return}
    let nodes={} for n in d.nodes{let item={assignee:n.assignee description:n.description dependsOn:n.dependsOn.to_json().parse_json()} if n.conditionJson.trim()!=""{item.conditionJson=n.conditionJson} nodes[n.id]=item}
    A.flow_prepare("hagency.graphs.create",{label:d.label nodes:nodes})
}
A.flow_begin_update=fn(){if !A.flow_can_edit() || H.flow_node==nil{return}
    H.flow_draft=nil let n=H.flow_node H.flow_update={id:H.flow_id expectedRevision:n.revision nodeId:n.id status:n.status changeStatus:false resultMode:"keep" resultJson:n.resultJson errorMode:"keep" error:if n.error==nil{""}else{n.error}}
    H.flow_error="" H.flow_phase="editing" H.page="operator_graph_update" A.redraw()
}
A.flow_prepare_update=fn(){if H.busy || H.flow_update==nil || H.flow_phase!="editing"{return}
    let u=H.flow_update let patch={nodeId:u.nodeId} if u.changeStatus{patch.status=u.status} if u.resultMode=="set"{if u.resultJson.trim()==""{H.flow_error=A.t("Enter valid JSON; use null to clear the result.","请填写有效 JSON；使用 null 清空结果。") A.redraw() return} patch.resultJson=u.resultJson} if u.errorMode=="set"{patch.error=if u.error==""{nil}else{u.error}}
    if !u.changeStatus && u.resultMode=="keep" && u.errorMode=="keep"{H.flow_error=A.t("Choose at least one change.","请至少选择一项更改。") A.redraw() return}
    A.flow_prepare("hagency.graphs.update_node",{id:u.id expectedRevision:u.expectedRevision patch:patch})
}
A.flow_prepare_cancel=fn(){if !A.flow_can_edit() || H.flow_detail==nil || H.flow_detail.graph.status=="cancelled"{return}
    H.flow_phase="editing" A.flow_prepare("hagency.graphs.cancel",{id:H.flow_detail.graph.id expectedRevision:H.flow_detail.graph.revision})
}
A.open_saved_graph=fn(row){if H.busy{return}
    H.flow_pending=nil H.flow_phase="loading" H.flow_error="" H.page="operator_graph_command"
    let id=row.commandId A.flow_read("hagency.graphs.command.get",{commandId:id},fn(v){if v==nil || v.commandId!=id{H.flow_phase="unknown" A.flow_bad_reply() return} A.flow_prepared(v)})
}
A.flow_apply=fn(){if H.busy || H.flow_pending==nil || (H.flow_phase!="saved" && H.flow_phase!="unknown"){return}
    let p=H.flow_pending if p.result!=nil || p.error!=nil{return}
    H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch H.busy=true H.flow_phase="submitting" H.flow_error="" A.redraw()
    host.request("hagency.graphs.command.apply",{commandId:p.commandId},fn(reply){
        if H.flow_epoch!=epoch{return} H.busy=false
        if H.page!="operator_graph_command" || H.flow_pending==nil || H.flow_pending.commandId!=p.commandId{A.redraw() return}
        if reply.is_ok && reply.data.commandId==p.commandId && reply.data.graphId==p.graphId && reply.data.runtimeDeliveryAuthorized==false{p.result=reply.data H.flow_phase="recorded"}
        else{H.flow_phase="unknown" H.flow_error=if reply.is_ok{"management_outcome_unknown"}else{reply.error}}
        A.redraw()
    })
}
A.flow_check_saved=fn(){if H.busy{return} if H.flow_pending!=nil{A.open_saved_graph(H.flow_pending)}else{A.refresh()}}
A.flow_close_result=fn(){if H.busy || H.flow_pending==nil || (H.flow_phase!="recorded" && H.flow_phase!="failed"){return}
    let p=H.flow_pending H.busy=true H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch A.redraw()
    host.request("hagency.intent.acknowledge",{commandId:p.commandId},fn(reply){
        if epoch!=H.flow_epoch{return} H.busy=false
        if H.flow_pending==nil || H.flow_pending.commandId!=p.commandId{A.redraw() return}
        if reply.is_ok{let remaining=[] for row in H.saved_commands{if row.commandId!=p.commandId{remaining.push(row)}} H.saved_commands=remaining H.flow_pending=nil H.flow_phase="" H.flow_draft=nil H.flow_update=nil H.flow_error="" A.open_flow(p.graphId,nil)}else{H.flow_error=reply.error A.redraw()}
    })
}
A.flow_review_nodes=fn(){let nodes=[] if H.flow_pending!=nil && H.flow_pending.change.operation=="create"{for index id node in H.flow_pending.change.nodes{nodes.push({id:id.to_string() data:node})}} return nodes}

A.is_template_operation=fn(op){return op=="template_create" || op=="template_update" || op=="template_delete"}
A.template_notice=fn(){return A.t("Templates name an agent and its role for future allocation. Saving a template does not create or change a running agent.","模板为未来分配的 Agent 指定名称和角色。保存模板不会创建或修改运行中的 Agent。")}
A.template_status=fn(status){if status=="provisioned"{return A.t("Agent provisioned","已创建 Agent 实例")} if status=="reserved"{return A.t("Reserved for allocation","已为分配预留")} return A.t("Defined · awaiting allocation","已定义 · 等待分配")}
A.template_enabled=fn(enabled){return if enabled{A.t("Available for future allocation","可供未来分配")}else{A.t("Future allocation disabled","已禁用未来分配")}}
A.template_reason=fn(code){
    if code=="invalid_management_arguments"{return A.t("Use a lowercase agent name (letters, numbers, _ or -, maximum 64) and select a role this resource supports.","Agent 名称须以小写字母开头，只含小写字母、数字、_ 或 -，最多 64 个字符；请选择此资源支持的角色。")}
    if code=="management_revision_conflict"{return A.t("The resource or its templates changed, or this agent name is already used. Read the current list before preparing another change.","资源或模板已变化，或 Agent 名称已被使用。请读取当前列表后再准备更改。")}
    if code=="management_resource_in_use"{return A.t("This name is reserved or already in use. Existing agents keep their identity; disable future allocation instead of removing or renaming an in-use template.","此名称已预留或正在使用。现有 Agent 保持其身份；已使用的模板可以禁用未来分配，不能移除或重命名。")}
    if code=="management_model_unqualified"{return A.t("This resource cannot supply that role. Check its model and capacity or choose an available role.","此资源无法提供该角色，请检查模型与容量，或选择可用角色。")}
    if code=="management_not_found"{return A.t("This resource or template is no longer available. Check the original saved request before making another change.","此资源或模板已不可用，请先检查已保存的原请求，再决定是否更改。")}
    if code=="management_change_cancelled"{return A.t("This change was discarded; nothing was saved.","这项更改已经放弃，没有保存。")}
    return A.error_text(code)
}
A.template_read=fn(service,args,done){if H.busy{return} let t=H.templates t.epoch=t.epoch+1 let epoch=t.epoch let page=H.page H.busy=true H.notice="" A.redraw()
    host.request(service,args,fn(reply){if t.epoch!=epoch{return} H.busy=false H.ux.errorCode=if reply.is_ok{""}else{reply.error} if H.page!=page{A.redraw() return} if reply.is_ok{done(reply.data)}else{t.error=A.template_reason(reply.error) if page=="template_command"{t.phase="unknown"} if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}} A.redraw()})
}
A.template_bad=fn(){H.templates.error=A.t("The template response did not match this view. Refresh the current record.","模板响应与此页面不符，请刷新当前记录。")}
// "Change discarded" shows once, on the page the discard returned to.
A.template_note_step=fn(t){if A.recipient_optional(t,"discardFresh")==true {t.discardFresh=false} else {t.discarded=""}}
A.open_templates=fn(resource,after){if H.busy{return} let t=H.templates A.template_note_step(t) t.resourceId=resource t.after=after t.list=nil t.error="" H.page="templates"
    A.template_read("hagency.templates.list",{resourceId:resource after:after},fn(v){if t.resourceId!=resource || t.after!=after{return} if v==nil || v.resourceId!=resource || !v.revision.is_string() || v.items==nil || v.items.len()>16 || v.roles==nil || v.roles.len()>16{A.template_bad() return} t.list=v})
}
A.open_template=fn(resource,id){if H.busy{return} let t=H.templates A.template_note_step(t) t.resourceId=resource t.id=id t.detail=nil t.error="" H.page="template"
    A.template_read("hagency.templates.get",{resourceId:resource id:id},fn(v){if t.resourceId!=resource || t.id!=id{return} if v==nil || v.resourceId!=resource || !v.revision.is_string() || v.definition==nil || v.definition.id!=id || v.roles==nil || v.roles.len()>16{A.template_bad() return} t.detail=v})
}
A.template_can_edit=fn(){let t=H.templates if H.busy || H.command!=nil || t.pending!=nil || t.phase=="saving" || t.phase=="saved" || t.phase=="loading" || t.phase=="submitting" || t.phase=="unknown"{return false} for row in H.saved_commands{let {hasReply=false}=row if A.is_template_operation(row.operation) && !hasReply{return false}} return true}
A.template_begin=fn(create){if !A.template_can_edit(){return} let t=H.templates let source=if create{t.list}else{t.detail} if source==nil || (create && !source.canCreate) || (!create && !source.canEditIdentity && !source.canToggle){return}
    let d={operation:if create{"create"}else{"update"} resourceId:t.resourceId expectedRevision:source.revision name:"" role:"" enabled:true canEditIdentity:true canToggle:true roles:source.roles.to_json().parse_json()}
    if !create{d.id=source.definition.id d.name=source.definition.name d.role=source.definition.role d.enabled=source.definition.enabled d.canEditIdentity=source.canEditIdentity d.canToggle=source.canToggle}
    t.draft=d t.phase="editing" t.error="" H.page="template_edit" A.redraw()
}
A.template_role=fn(role){let t=H.templates if H.busy || t.draft==nil || !t.draft.canEditIdentity{return} for allowed in t.draft.roles{if allowed==role{t.draft.role=role A.redraw() return}}}
A.template_prepared=fn(v){let t=H.templates
    if v==nil || !v.commandId.is_string() || !v.resourceId.is_string() || !v.definitionId.is_string() || !A.is_template_operation(v.operation) || v.change==nil || !v.expectedRevision.is_string() || (v.operation=="template_create" && v.change.operation!="create") || (v.operation=="template_update" && v.change.operation!="update") || (v.operation=="template_delete" && v.change.operation!="delete"){t.phase="unknown" A.template_bad() return}
    if v.result!=nil && (v.result.commandId!=v.commandId || v.result.resourceId!=v.resourceId || v.result.definitionId!=v.definitionId){t.phase="unknown" A.template_bad() return}
    t.pending=v t.commandId=v.commandId t.phase=if v.result!=nil{"recorded"}else if v.error!=nil{"failed"}else{"saved"} t.error=if v.error==nil{""}else{A.template_reason(v.error)} H.page="template_command"
}
A.template_prepare=fn(op,args){let t=H.templates if H.busy || H.command!=nil || t.pending!=nil || t.phase!="editing"{return}
    t.epoch=t.epoch+1 let epoch=t.epoch H.busy=true t.phase="saving" t.error="" t.late=false H.page="template_command" A.redraw()
    host.request("hagency.templates."+op,args,fn(reply){if t.epoch!=epoch{return} H.busy=false let apply=t.apply_after t.apply_after=false if H.page!="template_command"{A.redraw() return}
        if reply.is_ok{if reply.data.resourceId!=args.resourceId || reply.data.expectedRevision!=args.expectedRevision || reply.data.change.operation!=op || (op!="create" && reply.data.definitionId!=args.id){t.phase="unknown" A.template_bad()}else{A.template_prepared(reply.data) if apply && t.phase=="saved"{t.preview=nil A.template_apply() return}}}else{
            t.error=A.template_reason(reply.error)
            if reply.error=="invalid_management_arguments" || reply.error=="management_not_found" || reply.error=="management_revision_conflict" || reply.error=="management_resource_in_use" || reply.error=="management_model_unqualified"{t.phase=if op=="delete"{""}else{"editing"} H.page=if op=="delete"{"template"}else{"template_edit"}}else{t.phase="unknown"}
        } A.redraw()
    })
}
A.template_save_draft=fn(){let t=H.templates if H.busy || t.draft==nil || t.phase!="editing"{return} let d=t.draft let name=d.name.trim()
    if name=="" || name.to_chars().len()>64 || d.role==""{t.error=A.template_reason("invalid_management_arguments") A.redraw() return}
    let allowed=false for role in d.roles{if role==d.role{allowed=true}}
    let disable_existing=d.operation=="update" && !d.enabled && t.detail!=nil && t.detail.definition.id==d.id && t.detail.definition.name==name && t.detail.definition.role==d.role
    if !allowed && !disable_existing{t.error=A.template_reason("management_model_unqualified") A.redraw() return}
    let args={resourceId:d.resourceId expectedRevision:d.expectedRevision name:name role:d.role enabled:d.enabled} if d.operation=="update"{args.id=d.id}
    t.preview={op:d.operation args:args} t.phase="review" t.error="" H.page="template_command" A.redraw()
}
A.template_delete=fn(){let t=H.templates if !A.template_can_edit() || t.detail==nil || !t.detail.canDelete{return}
    t.draft=nil t.preview={op:"delete" args:{resourceId:t.resourceId id:t.detail.definition.id expectedRevision:t.detail.revision}} t.phase="review" t.error="" H.page="template_command" A.redraw()
}
// The review is local until 确认更改, so 放弃更改 leaves nothing behind.
A.template_preview=fn(){
    let t=H.templates let v=t.preview
    if v==nil {return nil}
    let a=v.args
    if v.op=="delete" {let def=if t.detail!=nil {t.detail.definition} else {{name:"" role:""}} return {resourceId:a.resourceId definitionId:a.id change:{operation:"delete" name:def.name role:def.role enabled:false}}}
    return {resourceId:a.resourceId definitionId:if v.op=="update" {a.id} else {""} change:{operation:v.op name:a.name role:a.role enabled:a.enabled}}
}
A.template_discard=fn(){let t=H.templates if H.busy || t.phase!="review" || t.preview==nil{return} let v=t.preview
    t.preview=nil t.draft=nil t.phase="" t.error="" t.discarded=if v.op=="create" {"templates"} else {"template"} t.discardFresh=true
    if v.op=="create" {A.nav_unwind("templates/"+t.resourceId) A.open_templates(t.resourceId,t.after)} else {A.nav_unwind("template/"+v.args.id) A.open_template(t.resourceId,v.args.id)}
}
A.template_confirm=fn(){let t=H.templates if H.busy || H.command!=nil || t.pending!=nil || t.phase!="review" || t.preview==nil{return} let v=t.preview
    t.phase="editing" t.apply_after=true A.template_prepare(v.op,v.args)
}
A.open_saved_template=fn(row){if H.busy{return} let t=H.templates t.pending=nil t.phase="loading" t.error="" t.late=false H.page="template_command" let id=row.commandId t.commandId=id
    A.template_read("hagency.templates.command.get",{commandId:id},fn(v){if v==nil || v.commandId!=id{t.phase="unknown" A.template_bad() return} A.template_prepared(v)})
}
A.template_apply=fn(){let t=H.templates if H.busy || t.pending==nil || t.phase!="saved"{return} let p=t.pending if p.result!=nil || p.error!=nil{return}
    t.epoch=t.epoch+1 let epoch=t.epoch H.busy=true t.phase="submitting" t.error="" A.redraw()
    host.request("hagency.templates.command.apply",{commandId:p.commandId},fn(reply){if t.epoch!=epoch{return} H.busy=false if H.page!="template_command" || t.pending==nil || t.pending.commandId!=p.commandId{A.redraw() return}
        if !reply.is_ok && reply.error=="management_change_cancelled"{A.template_withdrawn(p,epoch,"elsewhere") return}
        if reply.is_ok && reply.data.commandId==p.commandId && reply.data.resourceId==p.resourceId && reply.data.definitionId==p.definitionId{p.result=reply.data t.phase="recorded"}else{t.phase="unknown" t.error=A.template_reason(if reply.is_ok{"management_outcome_unknown"}else{reply.error})} A.redraw()
    })
}
// 放弃更改 for a change already sent: withdraw it natively, then acknowledge it.
// If it was applied meanwhile, say so; it can't be discarded any more.
A.template_cancel=fn(){let t=H.templates if H.busy || t.pending==nil || t.phase!="saved"{return} let p=t.pending
    t.epoch=t.epoch+1 let epoch=t.epoch H.busy=true t.phase="cancelling" t.error="" A.redraw()
    host.request("hagency.templates.command.cancel",{commandId:p.commandId},fn(reply){if t.epoch!=epoch{return} H.busy=false
        if t.pending==nil || t.pending.commandId!=p.commandId{A.redraw() return}
        if !reply.is_ok{t.phase="saved" t.error=A.template_reason(reply.error) A.redraw() return}
        let result=A.recipient_optional(reply.data,"result")
        let error=A.recipient_optional(reply.data,"error")
        if result!=nil{p.result=result t.phase="recorded" t.error="" t.late=true A.redraw() return}
        if error!="management_change_cancelled"{t.phase="unknown" t.error=A.template_reason(if error==nil {"management_outcome_unknown"} else {error}) A.redraw() return}
        A.template_withdrawn(p,epoch,"you")
    })
}
A.template_withdrawn=fn(p,epoch,how){let t=H.templates t.discardedHow=how H.busy=true A.redraw()
    host.request("hagency.intent.acknowledge",{commandId:p.commandId},fn(reply){if t.epoch!=epoch{return} H.busy=false
        if reply.is_ok{let keep=[] for row in H.saved_commands{if row.commandId!=p.commandId{keep.push(row)}} H.saved_commands=keep}
        let back=if p.change.operation=="create" {"templates"} else {"template"}
        t.pending=nil t.commandId="" t.phase="" t.draft=nil t.preview=nil t.error="" t.discarded=back t.discardFresh=true
        if back=="templates" {A.nav_unwind("templates/"+p.resourceId) A.open_templates(p.resourceId,t.after)} else {A.nav_unwind("template/"+p.definitionId) A.open_template(p.resourceId,p.definitionId)}
    })
}
A.template_check=fn(){if H.busy{return} let t=H.templates let saved_id=A.recipient_optional(H.templates,"commandId") if t.pending!=nil{A.open_saved_template(t.pending)}else if saved_id!=nil && saved_id!=""{A.open_saved_template({commandId:saved_id})}else{A.refresh()}}
A.template_finish=fn(){let t=H.templates if H.busy || t.pending==nil || (t.phase!="recorded" && t.phase!="failed"){return} let p=t.pending t.epoch=t.epoch+1 let epoch=t.epoch H.busy=true A.redraw()
    host.request("hagency.intent.acknowledge",{commandId:p.commandId},fn(reply){if t.epoch!=epoch{return} H.busy=false if t.pending==nil || t.pending.commandId!=p.commandId{A.redraw() return} if reply.is_ok{let keep=[] for row in H.saved_commands{if row.commandId!=p.commandId{keep.push(row)}} H.saved_commands=keep t.pending=nil t.commandId="" t.phase="" t.draft=nil A.nav_unwind("templates/"+p.resourceId) A.open_templates(p.resourceId,nil)}else{t.error=A.template_reason(reply.error) A.redraw()}})
}

A.web_title=fn(kind){
    if kind=="workforce"{return A.t("Workforce","Agent 团队")}
    if kind=="capability"{return A.t("Capabilities and offers","能力与服务报价")}
    if kind=="usage"{return A.t("Usage","用量")}
    if kind=="accounts"{return A.t("Shared account capacity","共享账号容量")}
    if kind=="alerts"{return A.t("Fleet alerts","全部告警")}
    return A.t("Terminal capture","终端快照")
}
A.web_error=fn(code){
    if code=="management_change_cancelled"{return A.t("Change cancelled. No resource settings were changed.","更改已取消，资源设置未发生变化。")}
    if code=="management_revision_conflict"{return A.t("This record changed. Refresh and review the latest values.","记录已变化，请刷新后再看。")}
    if code=="management_resource_in_use"{return A.t("This configuration is still in use. Release its allocations before removing it.","此配置仍在使用中，请先释放其分配再移除。")}
    if code=="invalid_management_arguments"{return A.t("Check the fields. Token amounts must be whole numbers within the supported range.","请检查输入，token 数量必须为支持范围内的整数。")}
    if code=="management_model_unqualified"{return A.t("This model does not qualify for the selected role.","此模型不满足所选角色的要求。")}
    return A.error_text(code)
}
A.web_read=fn(service,args,done){if H.busy{return} let w=H.web w.epoch=w.epoch+1 let epoch=w.epoch let page=H.page H.busy=true H.notice="" A.redraw()
    host.request(service,args,fn(r){if w.epoch!=epoch{return} H.busy=false H.ux.errorCode=if r.is_ok{""}else{r.error} if H.page!=page{A.redraw() return} if r.is_ok{done(r.data)}else{H.notice=A.web_error(r.error) if r.error=="native_resume_missing" || r.error=="native_resume_revoked"{H.needs_signin=true}} A.redraw()})
}
A.open_web=fn(kind,after){if H.busy{return} let w=H.web if H.page!="web_overview" || w.kind!=kind || w.after!=after{w.data=nil} w.kind=kind w.after=after H.page="web_overview"
    let q={after:after}
    if kind=="alerts"{q.status=if w.status==""{nil}else{w.status} q.severity=if w.severity==""{nil}else{w.severity} q.agent=if w.agent.trim()==""{nil}else{w.agent.trim()}}
    w.readKind=kind w.readQuery=q.to_json().parse_json()
    A.web_read("hagency.web."+kind,q,fn(v){if w.kind!=kind || w.after!=after{return} w.data=v})
}
A.open_web_account=fn(id,after){if H.busy{return} let w=H.web w.kind="accounts" w.data=nil w.after=nil H.page="web_overview"
    w.readKind="accounts" w.readQuery={id:id resourceAfter:after}
    A.web_read("hagency.web.accounts",w.readQuery,fn(v){w.data=v})
}
A.open_web_terminal=fn(id){if H.busy{return} H.web.kind="terminal" H.web.data=nil H.web.terminalId=id H.page="web_overview"
    H.web.readKind="terminal" H.web.readQuery={id:id}
    A.web_read("hagency.web.terminal",H.web.readQuery,fn(v){if v.id==id{H.web.data=v}})
}
A.web_int=fn(text,blank){let s=text.trim() if s==""{return blank} let n=s.to_f64() if !(n>=0 && n<=9007199254740991) || floor(n)!=n{return -1} return n}
A.web_can_edit=fn(){let w=H.web if H.busy || H.command!=nil || w.pending!=nil || w.phase=="saving" || w.phase=="unknown" || w.phase=="submitting"{return false} for row in H.saved_commands{let {hasReply=false}=row if row.operation=="web_catalog" && !hasReply{return false}} return true}
A.open_web_catalog=fn(resource,section,after){if H.busy{return} if section=="trust" {A.pool_sub_open("pool_who",resource) return} let w=H.web w.resourceId=resource w.section=section w.after=after w.catalog=nil w.draft=nil H.page="web_catalog"
    let service=if section=="offers"{"hagency.web_catalog.offers"}else if section=="trust"{"hagency.web_catalog.trust"}else{"hagency.web_catalog.get"}
    A.web_read(service,{resourceId:resource after:after},fn(v){if v.resourceId!=resource || !v.revision.is_string(){H.notice=A.web_error("management_outcome_unknown") return} w.catalog=v if section=="settings"{w.rate=if v.rateCapPerDay==nil{""}else{""+v.rateCapPerDay}} if H.nav.anchor!=""{start_timeout(0.3,||{if H.page=="web_catalog"{A.nav_scroll()}})}})
}
// "old → " for a listing row whose current value is known and differs; "" otherwise.
A.web_offer_before=fn(role,field,word){
    let c=H.web.catalog
    if c==nil {return ""}
    let items=A.recipient_optional(c,"items")
    if items==nil || !items.is_array() {return ""}
    let found={row:nil} for row in items {if A.recipient_optional(row,"role")==role {found.row=row}}
    if found.row==nil {return ""}
    let change=H.web.pending
    if change==nil {return ""}
    let old=A.recipient_optional(found.row,field)
    let now=A.recipient_optional(change.change,field)
    if old==now {return ""}
    return word(old)+" → "
}
A.web_change_label=fn(c){
    if c.operation=="rate_cap"{return A.t("Daily use, as stated","每天用量说明")+" · "+if c.rateCapPerDay==nil{A.t("None","没有说明")}else{A.tokens(c.rateCapPerDay)}}
    if c.operation=="retire"{return A.t("Delete this pool","删除这个资源池")}
    if c.operation=="default_policy"{return A.t("New Agent permissions","新 Agent 默认权限")+" · "+A.policy_label(c.yolo)}
    if c.operation=="assign_preset"{return A.t("Use the pool’s defaults","改用资源池的默认设置")+" · "+A.web_agent_name(c.engagementId)}
    if c.operation=="trust_add"{return A.t("Trust project","信任项目")+" · "+A.recipient_optional(c,"displayName")}
    if c.operation=="trust_remove"{return A.t("Stop trusting project","不再信任项目")}
    return A.capability_label(c.role)+" · "+if c.published{A.t("Shown publicly","对外展示")}else{A.t("Hidden","不再展示")}
}
A.web_same_change=fn(a,b){
    if a.operation!=b.operation{return false}
    for key in ["rateCapPerDay","yolo","engagementId","role","count","budgetCapPerEngagement","rateCap","published","projectRoomId","displayName"]{if A.recipient_optional(a,key)!=A.recipient_optional(b,key){return false}} return true
}
A.web_prepared=fn(v){let w=H.web
    if v==nil || !v.commandId.is_string() || !v.resourceId.is_string() || !v.expectedRevision.is_string() || v.change==nil{w.phase="unknown" H.notice=A.web_error("management_outcome_unknown") return}
    if v.result!=nil && (v.result.commandId!=v.commandId || v.result.resourceId!=v.resourceId || v.result.operation!=v.change.operation){w.phase="unknown" H.notice=A.web_error("management_outcome_unknown") return}
    w.pending=v w.commandId=v.commandId w.resourceId=v.resourceId w.phase=if v.result!=nil{"recorded"}else if v.error!=nil{"failed"}else{"saved"} H.page="web_catalog_command"
    if v.error!=nil{H.notice=A.web_error(v.error)}
}
A.web_prepare=fn(change){if !A.web_can_edit() || H.web.catalog==nil{return} let w=H.web let args={resourceId:w.resourceId expectedRevision:w.catalog.revision change:change.to_json().parse_json()}
    H.busy=true w.phase="saving" H.page="web_catalog_command" A.redraw()
    host.request("hagency.web_catalog.prepare",args,fn(r){H.busy=false
        if r.is_ok && r.data.resourceId==args.resourceId && r.data.expectedRevision==args.expectedRevision && A.web_same_change(r.data.change,args.change){A.web_prepared(r.data)}else{w.phase="unknown" H.notice=A.web_error(if r.is_ok{"management_outcome_unknown"}else{r.error})
            if !r.is_ok && (r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_resource_in_use" || r.error=="management_model_unqualified"){w.phase="" H.page="web_catalog"}
        } A.redraw()
    })
}
A.open_saved_web=fn(row){if H.busy{return} let w=H.web w.pending=nil w.commandId=row.commandId w.phase="unknown" H.page="web_catalog_command"
    A.web_read("hagency.web_catalog.command.get",{commandId:row.commandId},fn(v){if v==nil || v.commandId!=row.commandId{H.notice=A.web_error("management_outcome_unknown") return} A.web_prepared(v)})
}
A.web_apply=fn(){let w=H.web if H.busy || w.pending==nil || w.phase!="saved"{return} let p=w.pending H.busy=true w.phase="submitting" A.redraw()
    host.request("hagency.web_catalog.command.apply",{commandId:p.commandId},fn(r){H.busy=false
        if r.is_ok && r.data.commandId==p.commandId && r.data.resourceId==p.resourceId && r.data.operation==p.change.operation{p.result=r.data w.phase="recorded"}else{w.phase="unknown" H.notice=A.web_error(if r.is_ok{"management_outcome_unknown"}else{r.error})} A.redraw()
    })
}
A.web_cancel=fn(){let w=H.web if H.busy || w.pending==nil || w.phase!="saved"{return} let p=w.pending w.phase="unknown"
    A.web_read("hagency.web_catalog.command.cancel",{commandId:p.commandId},fn(v){if v==nil || v.commandId!=p.commandId || v.resourceId!=p.resourceId || v.expectedRevision!=p.expectedRevision || !A.web_same_change(v.change,p.change){w.phase="unknown" H.notice=A.web_error("management_outcome_unknown") return} A.web_prepared(v)})
}
A.web_finish=fn(){let w=H.web if H.busy || w.pending==nil || (w.phase!="recorded" && w.phase!="failed"){return} let p=w.pending
    A.web_read("hagency.intent.acknowledge",{commandId:p.commandId},fn(v){let remaining=[] for row in H.saved_commands{if row.commandId!=p.commandId{remaining.push(row)}} H.saved_commands=remaining w.pending=nil w.commandId="" w.phase="" w.draft=nil
        if p.result!=nil && p.result.retired{A.navigate("resources")}else{A.open_web_catalog(p.resourceId,w.section,nil)}
    })
}
A.web_rate=fn(){let n=A.web_int(H.web.rate,nil) if n!=nil && n<1{H.notice=A.web_error("invalid_management_arguments") A.redraw() return} A.web_prepare({operation:"rate_cap" rateCapPerDay:n})}
A.web_offer_edit=fn(row){if !A.web_can_edit(){return} H.web.draft={role:row.role count:if row.count==nil{""}else{""+row.count} budget:if row.budgetCapPerEngagement==nil{""}else{""+row.budgetCapPerEngagement} rate:if row.rateCap==nil{""}else{""+row.rateCap} published:row.published || row.catalogPublished qualified:row.qualified} A.redraw()}
A.web_offer_save=fn(){let d=H.web.draft if d==nil{return} let count=A.web_int(d.count,nil) let budget=A.web_int(d.budget,nil) let rate=A.web_int(d.rate,nil)
    if (count!=nil && count<1) || (budget!=nil && budget<1) || (rate!=nil && rate<1){H.notice=A.web_error("invalid_management_arguments") A.redraw() return}
    A.web_prepare({operation:"offer" role:d.role count:count budgetCapPerEngagement:budget rateCap:rate published:d.published})
}
A.web_trust_add=fn(){let w=H.web if !A.who_room_ok(w.trustRoom){return} A.web_prepare({operation:"trust_add" projectRoomId:w.trustRoom.trim() displayName:if w.trustName.trim()==""{nil}else{w.trustName.trim()}})}
A.web_publication=fn(){if H.resource_detail==nil || H.command!=nil || H.busy{return} let row=H.resource_detail.resource
    A.submit("hagency.resources.publish",{resourceId:row.id expectedRevision:row.revision published:!row.published})
}
// Automatic observations use a closed read-only page plan. They never call
// generic navigation/recovery, reset form fields, or acknowledge a saved command.
A.web_refresh_plan=fn(){let w=H.web let c=H.webConnection
    if H.command!=nil || w.pending!=nil || w.phase=="saving" || w.phase=="saved" || w.phase=="submitting" || w.phase=="unknown" || H.confirm!=""{return nil}
    if H.page=="web_overview"{
        if w.readKind!=w.kind || w.readQuery==nil{return nil}
        if w.kind=="alerts"{
            let q=w.readQuery
            if A.recipient_optional(q,"status")!=(if w.status==""{nil}else{w.status}) || A.recipient_optional(q,"severity")!=(if w.severity==""{nil}else{w.severity}) || A.recipient_optional(q,"agent")!=(if w.agent.trim()==""{nil}else{w.agent.trim()}){return nil}
        }
        for kind in ["workforce","capability","usage","accounts","alerts","terminal"]{if w.kind==kind{return {service:"hagency.web."+kind args:w.readQuery done:fn(v){if kind!="terminal" || A.recipient_optional(v,"id")==w.readQuery.id{w.data=v}}}}}
        return nil
    }
    if H.page=="web_connections"{return {service:"hagency.web_connections.list" args:{after:c.after} done:fn(v){c.list=v}}}
    if H.page=="web_connection" && c.detail!=nil && c.draft==nil{
        let saved=if c.detail.allocatedTokens==nil{""}else{""+c.detail.allocatedTokens}
        if c.tokens!=saved{return nil}
        return {service:"hagency.web_connections.get" args:{id:c.id} done:fn(v){if v.id==c.id{c.detail=v c.tokens=if v.allocatedTokens==nil{""}else{""+v.allocatedTokens}}}}
    }
    if H.page=="web_catalog" && w.catalog!=nil && w.draft==nil{
        if w.section=="settings" && w.rate!=(if w.catalog.rateCapPerDay==nil{""}else{""+w.catalog.rateCapPerDay}){return nil}
        if w.section=="trust" && (w.trustRoom!="" || w.trustName!=""){return nil}
        let service=if w.section=="offers"{"hagency.web_catalog.offers"}else if w.section=="trust"{"hagency.web_catalog.trust"}else{"hagency.web_catalog.get"}
        return {service:service args:{resourceId:w.resourceId after:w.after} done:fn(v){if v.resourceId==w.resourceId{w.catalog=v if w.section=="settings"{w.rate=if v.rateCapPerDay==nil{""}else{""+v.rateCapPerDay}}}}}
    }
    if H.page=="overview"{return nil}
    if H.page=="pool_agent" && H.pool_detail!=nil && H.pool_confirm==""{return {service:"hagency.pools.agents.get" args:{id:H.pool_detail.id} done:fn(v){if H.pool_detail!=nil && v.request.id==H.pool_detail.id{H.pool_detail=v.request}}}}
    if H.page=="connections" && H.connections.len()<=16{return {service:"hagency.connections.list" args:{} done:A.connections_received}}
    if H.page=="resources" && H.owner.accountId!=""{
        let id=H.owner.accountId let after=H.ux.resourceCursor let q={id:id} if after!=nil{q.after=after}
        return {service:"hagency.accounts.get" args:q done:fn(v){
            if H.owner.accountId==id && H.ux.resourceCursor==after && v.protocol=="hagency-management-v1" && v.account!=nil && v.account.id==id{H.resources=v.resources H.resource_after=v.nextAfter H.owner.poolsReady=true}
        }}
    }
    if A.reqs_page(){
        let r=H.reqs
        if r.items==nil || r.state!="ready" || r.confirm!=nil || r.next!=nil {return nil}
        let pool=A.reqs_scope()
        let q={after:nil needsMyAction:r.filter=="pending"}
        if pool!="" {q.poolId=pool}
        return {service:"hagency.pools.agents.list" args:q done:fn(v){
            let {items=nil,nextAfter=nil}=v
            if items==nil || r.confirm!=nil {return}
            let rows=[] for row in items {let {resourceOwnerMxid=nil,poolId=nil}=row if resourceOwnerMxid==H.session.account && (pool=="" || poolId==pool) {rows.push(row)}}
            r.items=rows r.next=nextAfter
        }}
    }
    if H.page=="tool_approvals" && H.tool_page!=nil && H.tool_after=="" {
        let resource=H.tool_resource let engagement=H.tool_engagement
        return {service:"hagency.tool_approvals.list" args:{resourceId:resource engagementId:engagement after:""} done:fn(v){
            if v.resourceId==resource && v.engagementId==engagement {H.tool_page=v}
            A.tools_shared_quiet()
        }}
    }
    if H.page=="pool_agents"{
        let q={after:H.owner.requestAfter needsMyAction:false}
        return {service:"hagency.pools.agents.list" args:q done:fn(v){H.pool_agents=v.items H.pool_agent_after=v.nextAfter H.ux.inboxReady=true}}
    }
    if H.page=="resources" && H.resources.len()<=16{let q={after:if H.ux.resourceCursor==nil{""}else{H.ux.resourceCursor} limit:16} if H.capability!=""{q.capability=H.capability} return {service:"hagency.resources.list" args:q done:fn(v){H.resources=v.resources H.resource_after=v.nextAfter H.owner.poolsReady=true}}}
    if H.page=="resource_detail" && H.resource_name_mode=="" && H.resource_edit_draft==nil && H.resource_create_draft==nil{return {service:"hagency.resources.get" args:{id:H.resource_id} done:fn(v){if v.protocol=="hagency-management-v1" && v.resource.id==H.resource_id{H.resource_detail=v A.pool_edit_sync()}}}}
    if H.page=="projects" && H.projects.len()<=16{return {service:"hagency.projects.list" args:{after:H.ux.projectCursor} done:fn(v){H.projects=v.items H.project_after=v.nextAfter}}}
    if H.page=="project_action" && H.project_selected!=nil{return {service:"hagency.projects.get" args:{id:H.project_selected.id} done:fn(v){if v.project.id==H.project_selected.id{H.project_selected=v.project H.ux.projectProgress=nil if v.project.state=="approved" && A.setup_enabled(){A.refresh_project_progress(v.project.id)}}}}}
    if H.page=="agent_action" && H.agent_confirmation==""{return {service:"hagency.agents.get" args:{id:H.agent_id} done:fn(v){if v.agentRequest.id==H.agent_id{H.agent_selected=v.agentRequest}}}}
    if H.page=="agent_status"{return {service:"hagency.agents.status" args:{id:H.agent_id} done:fn(v){if v.protocol=="hagency-management-v1" && v.agentRequest.id==H.agent_id{H.agent_status=v H.agent_selected=v.agentRequest H.agent_project_id=v.agentRequest.projectId}}}}
    if H.page=="agents" && H.agents.len()<=16{return {service:"hagency.agents.list" args:{after:nil needsMyAction:false projectId:H.agent_project_id} done:fn(v){H.agents=v.items H.agent_after=v.nextAfter}}}
    if H.page=="inbox" && H.inbox.len()<=16{return {service:"hagency.inbox.list" args:{after:H.ux.inboxCursor needsMyAction:H.needs_action includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()} done:fn(v){H.inbox=v.items H.inbox_after=v.nextAfter if A.agents_enabled(){A.load_agents(H.ux.agentCursor)}}}}
    if H.page=="action" && H.selected!=nil{return {service:"hagency.connections.get" args:{id:H.selected.contribution.id} done:fn(v){if v.admission.contribution.id==H.selected.contribution.id{H.selected=v.admission A.observe_verification(v.admission.contribution,v.observedAtMs) A.load_connection_capacity(v.admission.contribution)}}}}
    if H.page=="resource_alerts" && H.alert_draft==nil{return {service:"hagency.alerts.list" args:{resourceId:H.alert_resource after:H.alert_after status:H.alert_status} done:fn(v){if v.resourceId==H.alert_resource{H.alert_page=v}}}}
    if H.page=="resource_alert" && H.alert_draft==nil{return {service:"hagency.alerts.get" args:{resourceId:H.alert_resource id:H.alert_id afterNote:H.alert_note_after} done:fn(v){if v.alert.resourceId==H.alert_resource && v.alert.id==H.alert_id{H.alert_detail=v}}}}
    if H.page=="provider_accounts"{return {service:"hagency.accounts.list" args:{} done:fn(v){if v.protocol=="hagency-management-v1" && v.account==nil{if v.nextAfter==nil{H.account_inventory=v}else{A.open_accounts(nil)}}}}}
    if H.page=="provider_account"{let q={id:H.account_id} if H.account_resource_after!=nil{q.after=H.account_resource_after} return {service:"hagency.accounts.get" args:q done:fn(v){if v.protocol=="hagency-management-v1" && v.account.id==H.account_id{H.account_detail=v}}}}
    return nil
}
A.web_refresh_now=fn(){let r=H.webRefresh
    if !H.ready || H.needs_signin || !r.visible || H.busy || r.inFlight{return}
    let plan=A.web_refresh_plan() if plan==nil{return}
    let signature={page:H.page service:plan.service args:plan.args}.to_json()
    r.epoch=r.epoch+1 let epoch=r.epoch r.inFlight=true H.busy=true
    host.request(plan.service,plan.args,fn(reply){
        r.inFlight=false H.busy=false
        let current=A.web_refresh_plan()
        if r.epoch!=epoch || !r.visible || current==nil || signature!={page:H.page service:current.service args:current.args}.to_json(){return}
        if reply.is_ok{H.ux.errorCode="" plan.done(reply.data)}else{
            H.ux.errorCode=reply.error
            if H.page=="overview"{H.ux.dashboardError=true}
            if H.page=="inbox"{H.ux.inboxReady=false H.ux.inboxError=true}
            if H.notice==""{H.notice=A.web_error(reply.error)}
            if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}
        }
        A.redraw()
    })
}
A.web_visibility=fn(visible){let r=H.webRefresh
    if r.visible!=visible{r.epoch=r.epoch+1 r.visible=visible}
    if visible{A.web_refresh_now()}
}
let on_app_visibility_changed=fn(state){A.web_visibility(state=="visible")}
A.web_auto_refresh=fn(){A.web_refresh_now() start_timeout(15,||A.web_auto_refresh())}

A.web_connection_service=fn(service){return service=="hagency.web_connections.create" || service=="hagency.web_connections.allowance" || service=="hagency.web_connections.withdraw" || service=="hagency.web_connections.issue" || service=="hagency.web_connections.import" || service=="hagency.web_connections.replace" || service=="hagency.web_connections.verify"}
A.web_connections_open=fn(after){if H.busy{return} let c=H.webConnection c.after=after c.list=nil H.page="web_connections"
    A.web_read("hagency.web_connections.list",{after:after},fn(v){c.list=v})
}
A.web_connection_open=fn(id){if H.busy{return} let c=H.webConnection c.id=id c.detail=nil c.draft=nil H.page="web_connection"
    A.web_read("hagency.web_connections.get",{id:id},fn(v){if v.id!=id{H.notice=A.web_error("management_outcome_unknown") return} c.detail=v c.tokens=if v.allocatedTokens==nil{""}else{""+v.allocatedTokens}})
}
A.web_connection_new=fn(){if H.busy || H.command!=nil{return} H.webConnection.draft={id:"" label:"" origin:""} H.webConnection.probe=nil H.page="web_connection_new" A.redraw()}
A.web_connection_probe=fn(){let c=H.webConnection if H.busy || c.draft==nil{return} let d=c.draft let name=d.id.trim() let origin=d.origin.trim()
    A.web_read("hagency.web_connections.probe",{serverName:if name==""{nil}else{name} url:if origin==""{nil}else{origin}},fn(v){c.probe=v if v.reachable && d.origin.trim()==""{d.origin=v.origin}})
}
A.web_connection_create=fn(import){let d=H.webConnection.draft if d==nil || d.id.trim()=="" || d.origin.trim()=="" || d.label.trim()==""{H.notice=A.web_error("invalid_management_arguments") A.redraw() return}
    if import{A.submit("hagency.web_connections.import",{id:d.id.trim() label:d.label.trim() homeserver:d.origin.trim() expectedRevision:0})}else{A.submit("hagency.web_connections.create",{id:d.id.trim() label:d.label.trim() apiBaseUrl:d.origin.trim()})}
}
A.web_connection_edit=fn(operation){let c=H.webConnection let d=c.detail if H.busy || H.command!=nil || d==nil{return}
    let args={id:d.id expectedRevision:d.revision}
    if operation=="allowance"{let n=A.web_int(c.tokens,nil) if n!=nil && n<0{H.notice=A.web_error("invalid_management_arguments") A.redraw() return} args.allocatedTokens=n}
    if operation=="import"{args.label=d.label args.homeserver=d.apiBaseUrl}
    if operation=="issue"{if c.registrationUrl.trim()==""{H.notice=A.t("Enter the appservice callback URL.","请输入应用服务回调地址。") A.redraw() return} args.url=c.registrationUrl.trim()}
    A.submit("hagency.web_connections."+operation,args)
}
A.web_connection_operation=fn(service){
    for op in ["create","allowance","withdraw","issue","import","replace","verify"]{if service=="hagency.web_connections."+op{return op}} return ""
}
A.web_connection_reply=fn(command,r){H.busy=false
    if r.is_ok && r.data!=nil && r.data.commandId==command.args.commandId && r.data.operation==A.web_connection_operation(command.service) && r.data.connection!=nil && r.data.connection.id==command.args.id{
        H.command=nil H.notice=A.t("Connection configuration saved.","连接配置已保存。") H.webConnection.detail=r.data.connection H.webConnection.id=r.data.connection.id H.webConnection.draft=nil H.page="web_connection" A.save() A.redraw() return
    }
    if !r.is_ok && (r.error=="web_connection_cancelled" || r.error=="provider_confirmation_expired" || r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="connection_import_server_mismatch" || r.error=="invalid_connection_configuration"){
        H.command=nil A.save() H.notice=if r.error=="web_connection_cancelled"{A.t("Review cancelled. No configuration was changed.","已取消核对，没有更改配置。")}else{A.web_error(r.error)}
    }else{H.notice=A.t("The result is not confirmed. Check the saved result before retrying this request.","结果尚未确认，请先检查保存结果，再重试此请求。")}
    A.redraw()
}
A.web_connection_check=fn(){if H.busy || H.command==nil || !A.web_connection_service(H.command.service){return} let command=H.command
    A.web_read("hagency.web_connections.command.get",{commandId:command.args.commandId},fn(v){if v==nil{H.notice=A.t("No completed result is recorded. Resume the original request to review it again.","尚无完成记录，可恢复原请求再次核对。")}else{A.web_connection_reply(command,{is_ok:true data:v})}})
}
A.web_connection_download=fn(){let d=H.webConnection.detail if H.busy || d==nil || !d.registrationAvailable{return}
    A.web_read("hagency.web_connections.download",{id:d.id expectedRevision:d.revision},fn(v){H.notice=if v.saved{A.t("Private registration saved.","私密注册文件已保存。")}else{A.t("Save cancelled.","已取消保存。")}})
}

A.recipient_optional=fn(value,name){for index key field in value{if key.to_string()==name{return field}} return nil}
A.recipient_option_detail=fn(row){
    let status=A.recipient_optional(row,"status") let room_scope=A.recipient_optional(row,"scopeKind")
    if status=="approved"{return A.t("Agent request approved","Agent 申请已批准")}
    if status=="pending_approval" || status=="approved_waiting_executor" || status=="rejected" || status=="cancelled" || status=="revoked" || status=="expired"{return A.agent_state_text(status)}
    if status!=nil{return A.t("Current status unavailable","当前状态暂不可用")}
    if room_scope=="owner_direct"{return A.t("Owner’s direct room","主人的专属房间")}
    if room_scope=="project"{return A.t("Project room","项目房间")}
    if room_scope!=nil{return A.t("Room connection","房间关联")}
    return row.detail
}
A.recipient_kind=fn(kind){if kind=="shared_agent"{return A.t("Shared project agent","项目共享 Agent")} if kind=="personal_agent"{return A.t("Local agent","本地 Agent")} return A.t("Human","人员")}
A.recipient_state=fn(state){if state=="binding_saved"{return A.t("Recipient binding saved","已保存接收方绑定")} if state=="binding_stale"{return A.t("Recipient binding needs review","接收方绑定需要重新核对")} return A.t("No recipient binding","尚未绑定接收方")}
A.recipient_saved_state=fn(p){
    if p.result!=nil{return A.flow_delivery("binding_saved")}
    if p.error!=nil{return A.t("Binding request refused","绑定请求已拒绝")}
    if H.flow_phase=="unknown" || H.flow_phase=="submitting"{return A.t("Binding result not confirmed","绑定结果尚未确认")}
    return A.t("Binding request saved; awaiting confirmation","绑定请求已保存，等待确认")
}
A.recipient_notice=fn(){return A.t("Choose an identity available to your current account. The recorded name stays unchanged. Saving a recipient does not send this task.","请选择当前账号可见的身份，记录的名称保持不变。保存接收方不会发送此任务。")}
A.recipient_reason=fn(code){
    if code=="node_not_held"{return A.t("This node no longer has held work to address. Read its latest state.","此节点已没有等待设置接收方的工作，请读取最新状态。")}
    if code=="sender_not_joined"{return A.t("Your current account has not joined this room. Check its membership before choosing this recipient.","当前账号尚未加入此房间，请先检查成员身份。")}
    if code=="recipient_not_joined"{return A.t("This recipient has not joined the selected room. Choose a current member or check again later.","此接收方尚未加入所选房间，请选择现有成员或稍后重新检查。")}
    if code=="room_identity_unavailable"{return A.t("The room identity could not be verified. Refresh its current state before continuing.","无法验证此房间身份，请刷新其当前状态后继续。")}
    if code=="sender_cannot_send"{return A.t("Your current account cannot send messages in this room. Ask the room administrator to check its permissions.","当前账号不能在此房间发送消息，请房间管理员检查权限。")}
    if code=="personal_binding_inactive"{return A.t("This local agent’s room connection is inactive. Check its existing connection before choosing it.","此本地 Agent 的房间关联尚未启用，请先检查已有的关联。")}
    if code=="personal_binding_scope_unavailable"{return A.t("This room cannot be used for the selected local agent. Choose one of its supported connections.","所选本地 Agent 不能使用此房间，请选择其支持的已有房间关联。")}
    if code=="project_room_inactive"{return A.t("This project room is inactive. Check the project’s current room setup.","此项目房间尚未启用，请检查项目当前的房间设置。")}
    if code=="shared_agent_not_approved"{return A.t("This shared agent has not been approved. Review its project request before selecting it.","此共享 Agent 尚未获批，请先查看项目中的申请状态。")}
    if code=="shared_project_not_ready"{return A.t("This project is not ready. Complete its allocation and Matrix room setup before selecting an agent.","此项目尚未就绪，请先完成资源分配和 Matrix 房间设置。")}
    if code=="shared_membership_unavailable"{return A.t("This agent’s membership in the project room could not be verified. Check its latest project status.","无法验证此 Agent 的项目房间成员身份，请查看最新项目状态。")}
    if code=="project_manager_required" || code=="shared_project_manager_required"{return A.t("Only this project's manager can send shared-agent work.","只有此项目的经理可以发送共享 Agent 工作。")}
    if code=="recipient_binding_changed" || code=="graph_recipient_changed" || code=="management_recipient_changed"{return A.t("The recipient identity or its authority changed. Observe it again before preparing another binding.","接收方身份或权限已变化，请重新检查后再准备绑定。")}
    if code=="recipient_unavailable" || code=="graph_recipient_unavailable" || code=="management_recipient_unavailable"{return A.t("This recipient is not currently available. No binding has been authorized.","此接收方目前不可用，尚未授权绑定。")}
    if code=="recipient_blocked" || code=="graph_recipient_blocked"{return A.t("This identity cannot be bound in its current state. Review the reason and choose an available recipient.","此身份的当前状态不允许绑定，请核对原因并选择可用接收方。")}
    return A.flow_reason(code)
}
A.recipient_matches=fn(f,v){return v!=nil && v.graphId==f.graphId && v.nodeId==f.nodeId && v.runtimeDeliveryAuthorized==false}
A.recipient_current=fn(){if H.busy || H.flow_recipient==nil{return}
    let f=H.flow_recipient f.current=nil f.options=nil f.observation=nil f.target=nil f.query=nil f.history=[] f.kind="" f.error="" f.stale=false f.currentDetails=false f.observationDetails=false
    A.flow_read("hagency.graphs.recipient.get",{id:f.graphId nodeId:f.nodeId},fn(v){
        if H.flow_recipient!=f{return} if !A.recipient_matches(f,v) || (v.state!="unbound" && v.state!="binding_saved" && v.state!="binding_stale") || (v.state=="unbound" && v.binding!=nil) || (v.state!="unbound" && v.binding==nil){A.flow_bad_reply() return}
        if v.binding!=nil && (v.binding.graphId!=f.graphId || v.binding.nodeId!=f.nodeId || v.binding.runtimeDeliveryAuthorized!=false){A.flow_bad_reply() return}
        if v.revision!=f.revision{f.stale=true f.error=A.flow_reason("management_revision_conflict") return}
        f.current=v
    })
}
A.recipient_begin=fn(){if !A.flow_can_edit() || H.flow_node==nil{return}
    let n=H.flow_node H.flow_recipient={graphId:H.flow_id nodeId:n.id revision:n.revision assignee:n.assignee current:nil kind:"" query:nil options:nil history:[] target:nil observation:nil error:"" stale:false currentDetails:false observationDetails:false}
    H.flow_phase="editing" H.flow_error="" H.page="operator_graph_recipient" A.recipient_current()
}
A.recipient_options=fn(query,push){if H.busy || H.flow_recipient==nil{return}
    let f=H.flow_recipient if f.current==nil || f.stale || H.flow_phase!="editing"{return}
    if query.id!=f.graphId || query.nodeId!=f.nodeId || (query.kind!="shared_agent" && query.kind!="personal_agent" && query.kind!="human"){A.flow_bad_reply() return}
    if push && f.query!=nil{f.history.push(f.query)}
    f.query=query.to_json().parse_json() f.kind=query.kind f.options=nil f.observation=nil f.target=nil f.error=""
    let original=f.query.to_json()
    A.flow_read("hagency.graphs.recipient.options",f.query,fn(v){
        if H.flow_recipient!=f || f.query==nil || f.query.to_json()!=original{return}
        if !A.recipient_matches(f,v) || v.kind!=f.kind || v.items==nil || v.items.len()>16{A.flow_bad_reply() return}
        if v.revision!=f.revision{f.stale=true f.error=A.flow_reason("management_revision_conflict") return}
        for row in v.items{let {next=nil,target=nil}=row if !row.id.is_string() || !row.label.is_string() || !row.detail.is_string() || (next==nil && target==nil) || (next!=nil && target!=nil){A.flow_bad_reply() return}}
        f.options=v
    })
}
A.recipient_choose=fn(kind){if H.busy || H.flow_recipient==nil{return} let f=H.flow_recipient f.history=[] A.recipient_options({id:f.graphId nodeId:f.nodeId kind:kind},false)}
A.recipient_page=fn(after){if H.busy || H.flow_recipient==nil || H.flow_recipient.query==nil{return} let q=H.flow_recipient.query.to_json().parse_json() q.after=after A.recipient_options(q,false)}
A.recipient_parent=fn(){if H.busy || H.flow_recipient==nil{return} let f=H.flow_recipient if f.history.len()==0{A.recipient_current() return}
    let keep=[] let q=nil for index item in f.history{if index==f.history.len()-1{q=item}else{keep.push(item)}} f.history=keep A.recipient_options(q,false)
}
A.recipient_pick=fn(row){if H.busy || H.flow_recipient==nil || H.flow_recipient.options==nil{return}
    let found=false for item in H.flow_recipient.options.items{if item==row{found=true}} if !found{return}
    let {next=nil,target=nil}=row
    if next!=nil{if next.kind!=H.flow_recipient.kind{A.flow_bad_reply() return} A.recipient_options(next,true) return}
    if target!=nil{A.recipient_observe(target)}
}
A.recipient_observe=fn(target){if H.busy || H.flow_recipient==nil{return}
    let f=H.flow_recipient if f.stale || f.current==nil || H.flow_phase!="editing" || target==nil || target.kind!=f.kind{return}
    f.target=target.to_json().parse_json() f.observation=nil f.observationDetails=false f.error="" let original=f.target.to_json()
    A.flow_read("hagency.graphs.recipient.observe",{id:f.graphId nodeId:f.nodeId target:f.target},fn(v){
        if H.flow_recipient!=f || f.target==nil || f.target.to_json()!=original{return}
        if !A.recipient_matches(f,v) || v.target==nil || v.target.to_json()!=original || !v.observationDigest.is_string() || v.blockingReasons==nil || v.blockingReasons.len()>16 || !v.account.is_string() || !v.server.is_string() || (v.canBind!=true && v.canBind!=false){A.flow_bad_reply() return}
        if v.revision!=f.revision{f.stale=true f.error=A.flow_reason("management_revision_conflict") return}
        f.observation=v
    })
}
A.recipient_prepared_matches=fn(args,v){return v!=nil && v.graphId==args.id && v.expectedRevision==args.expectedRevision && v.change!=nil && v.change.operation=="bind_recipient" && v.change.nodeId==args.nodeId && v.change.snapshot!=nil && v.change.snapshot.target!=nil && v.change.snapshot.target.to_json()==args.target.to_json() && v.change.snapshot.observationDigest==args.observationDigest}
A.recipient_prepare=fn(){if H.busy || H.flow_recipient==nil || H.flow_phase!="editing"{return}
    let f=H.flow_recipient let v=f.observation
    if f.stale || v==nil || !v.canBind || v.blockingReasons.len()!=0 || v.runtimeDeliveryAuthorized!=false || v.revision!=f.revision || f.target==nil || v.target.to_json()!=f.target.to_json(){return}
    A.flow_prepare("hagency.graphs.bind_recipient",{id:f.graphId nodeId:f.nodeId expectedRevision:f.revision target:f.target.to_json().parse_json() observationDigest:v.observationDigest})
}

A.graph_state=fn(state){
    if state=="copying"{return A.t("Copy incomplete","复制未完成")}
    if state=="archived"{return A.t("Saved history","已保存的历史")}
    if state=="pending"{return A.t("Pending","待执行")}
    if state=="dispatched"{return A.t("Dispatched","已派发")}
    if state=="active"{return A.t("In progress","进行中")}
    if state=="complete"{return A.t("Completed","已完成")}
    if state=="failed"{return A.t("Failed","失败")}
    if state=="skipped"{return A.t("Skipped","已跳过")}
    if state=="cancelled"{return A.t("Cancelled","已取消")}
    return state
}
A.graph_error=fn(){H.notice=A.t("History could not be loaded. Refresh to try again.","无法读取历史记录，请刷新重试。")}
A.open_graph_archives=fn(){if H.busy{return}
    H.page="graph_archives" H.graph_archives=nil
    A.request("hagency.graph_history.archives",{},fn(v){
        if H.page!="graph_archives"{return}
        if v==nil || v.archives==nil || v.readOnly!=true || v.identityMapped!=false{A.graph_error() return}
        H.graph_archives=v
    })
}
A.open_graph_history=fn(archive,after){if H.busy{return}
    H.page="graph_history" H.graph_archive=archive H.graph_after=after H.graph_page=nil
    A.request("hagency.graph_history.list",{archiveId:archive after:after},fn(v){
        if H.page!="graph_history" || H.graph_archive!=archive || H.graph_after!=after{return}
        if v==nil || v.archiveId!=archive || v.graphs==nil{A.graph_error() return} H.graph_page=v
    })
}
A.open_history_graph=fn(archive,id,after){if H.busy{return}
    H.page="history_graph" H.graph_archive=archive H.graph_id=id H.graph_node_after=after H.graph_detail=nil
    A.request("hagency.graph_history.get",{archiveId:archive id:id after:after},fn(v){
        if H.page!="history_graph" || H.graph_archive!=archive || H.graph_id!=id || H.graph_node_after!=after{return}
        if v==nil || v.archiveId!=archive || v.graph==nil || v.graph.id!=id || v.nodes==nil{A.graph_error() return} H.graph_detail=v
    })
}
A.open_history_node=fn(archive,id,node){if H.busy{return}
    H.page="history_node" H.graph_archive=archive H.graph_id=id H.graph_node_id=node H.graph_node=nil H.graph_dep_offset=0
    A.request("hagency.graph_history.node",{archiveId:archive id:id nodeId:node},fn(v){
        if H.page!="history_node" || H.graph_archive!=archive || H.graph_id!=id || H.graph_node_id!=node{return}
        if v==nil || v.archiveId!=archive || v.graphId!=id || v.id!=node || v.dependsOn==nil{A.graph_error() return} H.graph_node=v
    })
}

A.open_tasks = fn(offset){if H.busy{return} H.page="operator_tasks" H.task_offset=offset H.task_page=nil
    let f=H.task_filters let q={offset:offset} if f.assignee!=""{q.assignee=f.assignee} if f.status!=""{q.status=f.status} if f.priority!=""{q.priority=f.priority} if f.label!=""{q.label=f.label}
    A.request("hagency.tasks.list",q,fn(v){H.task_page=v})
}
A.task_filter = fn(key,value){if H.busy{return}
    if key=="status"{H.task_filters.status=value} if key=="priority"{H.task_filters.priority=value} if key=="label"{H.task_filters.label=value}
    A.open_tasks(0)
}
A.open_task = fn(id,offset){if H.busy{return} if H.task_id!=id{H.task_details_open=false} H.page="operator_task" H.task_id=id H.task_comment_offset=offset H.task_detail=nil A.request("hagency.tasks.get",{id:id commentOffset:offset},fn(v){H.task_detail=v})}
A.open_board = fn(query){if H.busy{return} H.page="operator_board" H.task_board_query=query H.task_board=nil A.request("hagency.tasks.board",query,fn(v){H.task_board=v})}
A.agent_tasks = fn(name){if H.busy{return} H.task_filters={assignee:name status:"" priority:"" label:""} H.task_from_board=true A.open_tasks(0)}
A.refresh = fn(){
    if !H.ready { A.connect() return }
    A.request("hagency.intent.pending", {}, fn(data){H.saved_commands = data.commands A.refresh_page() A.tab_counts_load()})
}
A.refresh_page = fn(){
    if H.page=="pools" {A.load_pools(nil) return}
    if H.page=="pool_create" {A.pool_create_accounts() return}
    if A.pool_sub_page() {A.pool_sub_refresh() return}
    if H.page=="pool_apply" {A.pool_refresh() return}
    if A.reqs_page() {A.reqs_load(nil) return}
    if H.page=="default_policy" {A.dpol_open(H.dpol.resource) return}
    if H.page=="pool_agents" {A.load_pool_agents(nil) return}
    if H.page=="pool_agent" && H.pool_detail!=nil {A.open_pool_agent(H.pool_detail.id) return}
    if H.page=="overview" {A.redraw() return}
    if H.page=="agent_home" {A.load_agent_home() return}
    if H.page=="web_connections"{A.web_connections_open(H.webConnection.after) return}
    if H.page=="web_catalog" && H.web.catalog==nil {A.open_web_catalog(H.web.resourceId,H.web.section,H.web.after) return}
    if H.page=="web_connection" || H.page=="web_overview" || H.page=="web_catalog"{A.web_refresh_now() return}
    if H.page=="web_catalog_command"{if H.web.commandId!=""{A.open_saved_web({commandId:H.web.commandId})} return}
    if H.page=="templates"{A.open_templates(H.templates.resourceId,H.templates.after) return}
    if H.page=="template"{A.open_template(H.templates.resourceId,H.templates.id) return}
    if H.page=="template_command"{if H.templates.pending!=nil{A.open_saved_template(H.templates.pending)} return}
    if H.page=="operator_graphs"{A.open_flows(H.flow_after) return}
    if H.page=="operator_graph"{A.open_flow(H.flow_id,H.flow_node_after) return}
    if H.page=="operator_graph_node"{A.open_flow_node(H.flow_id,H.flow_node_id) return}
    if H.page=="operator_graph_command"{if H.flow_pending!=nil{A.open_saved_graph(H.flow_pending)} return}
    if H.page=="operator_graph_recipient"{A.recipient_current() return}
    if H.page=="graph_archives"{A.open_graph_archives() return}
    if H.page=="graph_history"{A.open_graph_history(H.graph_archive,H.graph_after) return}
    if H.page=="history_graph"{A.open_history_graph(H.graph_archive,H.graph_id,H.graph_node_after) return}
    if H.page=="history_node"{A.open_history_node(H.graph_archive,H.graph_id,H.graph_node_id) return}
    if H.page=="connection_history" {A.open_connection_history(H.history_id,H.history_after,H.history_page) return}
    if H.page=="connection_reoffer" {A.begin_reoffer() return}
    if H.page == "provider_accounts" {A.open_accounts(H.account_after) return}
    if H.page == "provider_account" {A.open_account(H.account_id,H.account_resource_after) return}
    if H.page=="health_hub" {A.health_open(H.health.resource,nil,nil) return}
    if H.page=="stopped_tasks" {A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,H.stopped_after) return}
    if H.page=="stopped_task" {A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,0) return}
    if H.page=="workspaces" {A.open_workspaces(H.workspace_resource,H.workspace_after) return}
    if H.page=="workspace" {A.open_workspace(H.workspace_resource,H.workspace_id) return}
    if H.page=="execution_policies" {A.open_policies(H.policy_resource,H.policy_after) return}
    if H.page=="execution_policy" {A.open_policy(H.policy_resource,H.policy_engagement) return}
    if H.page == "personal_agents" {A.open_personal_agents(H.personal_after,H.personal_page) return}
    if H.page == "personal_agent" {A.open_personal_agent(H.personal_id) return}
    if H.page == "agent_control" {A.open_agent_control(H.control_assignment,H.control_agent_name) return}
    if H.page == "agent_budget" {A.open_agent_budget(H.budget_request_id,H.budget_agent_name,H.budget_after,H.budget_page)} else if H.page == "agent_topup" {A.open_topup(H.budget_topup_id)} else if H.page == "operator_task_command" {if H.task_pending!=nil{A.open_saved_task(H.task_pending)}} else if H.page == "operator_tasks" {A.open_tasks(H.task_offset)} else if H.page == "operator_task" {A.open_task(H.task_id,H.task_comment_offset)} else if H.page == "operator_board" {A.open_board(H.task_board_query)} else if H.page == "device_execution" {A.open_execution(H.execution_after)} else if H.page == "allocations" {A.open_allocations(H.allocation_project,H.allocation_after,H.allocation_page)} else if H.page == "allocation_action" {A.open_allocation(H.allocation_id)} else if H.page == "onboarding" {A.open_onboarding()} else if H.page == "resources" {
        A.owner_load_pools()
    } else if H.page=="tool_request" {A.open_tool_request(H.tool_request_id)
    } else if H.page=="tool_approvals" || H.page=="tool_grants" || H.page=="tool_grant_review" || H.page=="tool_grant_result" {A.open_tools(H.tool_resource,H.tool_engagement,H.tool_after,H.tool_kind)
    } else if H.page=="approval_bindings" || H.page=="approval_binding_review" || H.page=="approval_binding_result" {A.open_bindings(H.binding_resource,H.binding_after)
    } else if H.page == "resource_alerts" {A.open_alerts(H.alert_resource,H.alert_after,H.alert_status)
    } else if H.page == "resource_alert" {A.open_alert(H.alert_resource,H.alert_id,H.alert_note_after)
    } else if (H.page == "resource_detail" || (H.page=="resource_edit" || H.page=="resource_create")) && H.resource_id != "" {
        A.open_resource(H.resource_id)
    } else if H.page == "connections" || H.page == "overview" {
        A.request("hagency.connections.list", {}, A.connections_received)
    } else if H.page == "inbox" {
        A.load_inbox()
    } else if (H.page == "agents" || H.page == "agent_wizard") && A.agents_enabled() {
        A.open_project_agents(H.agent_project_id)
    } else if H.page == "agent_removals" {A.open_removals(H.removal_project,H.removal_after,H.removal_page)
    } else if H.page == "agent_removal" {A.open_removal(H.removal_id)
    } else if H.page == "agent_work_list" {
        A.open_work_list(H.work_list_project,H.work_list_after,H.work_list_page)
    } else if H.page == "agent_work" && H.agent_id != "" {
        A.open_agent_work(H.agent_id,H.work_after,H.work_page)
    } else if H.page == "agent_status" && H.agent_id != "" && A.agents_enabled() {
        A.open_agent_status(H.agent_id)
    } else if H.page == "agent_action" && H.agent_id != "" && A.agents_enabled() {
        A.open_agent(H.agent_id)
    } else if H.page == "projects" && A.projects_enabled() {
        A.request("hagency.projects.list", {after:H.ux.projectCursor}, fn(data){H.projects=data.items H.project_after=data.nextAfter})
    } else if H.page == "project_wizard" && A.projects_enabled() {
        A.load_catalog()
    } else if H.page == "project_setup" && H.project_selected != nil && A.setup_enabled() {
        A.open_project_setup(H.project_selected.id)
    } else if H.page == "project_action" && H.project_selected != nil && A.projects_enabled() {
        A.open_project(H.project_selected.id)
    } else if H.page == "wizard" {
        if H.wizard.admission != nil { A.open_connection(H.wizard.admission.contribution.id) }
        else { A.load_providers() }
    } else if H.page == "action" && H.ux.connectionId != "" { A.open_connection(H.ux.connectionId) }
}
A.connect = fn(){
    A.request("hagency.session", {}, fn(data){
        if data.protocol != "hagency-management-v1" { H.notice = A.t("This server needs a compatible Hagency update.", "此服务器需要更新到兼容的 Hagency 版本。") return }
        H.session = data H.ready = true H.needs_signin=false
        if !H.restored {
            H.restored = true
            if fs.exists("onboarding-v1.json") {
                try {
                    let stored = fs.read("onboarding-v1.json").parse_json()
                    if stored != nil && stored.version == 1 && stored.account == data.account {
                        H.wizard = stored.wizard H.command = stored.command
                        let {projectDraft = nil,agentDraft=nil,poolDraft=nil,resourceJourney=false,setupAccountId="",workspace=""} = stored
                        if A.entry_allowed(workspace){H.entry_role=workspace}
                        if poolDraft!=nil {H.pool_draft=poolDraft}
                        H.ux.resourceJourney=resourceJourney H.ux.accountId=setupAccountId
                        if agentDraft != nil {A.restore_agent_draft(agentDraft)}
                        if projectDraft != nil {A.restore_project_draft(projectDraft)}
                        if H.wizard.admission != nil {H.wizard.admission.contribution.verification = nil}
                    }
                } {H.notice = A.t("The page draft could not be read. Saved requests are recovered from native storage.", "无法读取页面草稿；已保存的请求会从这台电脑上恢复。")}
            }
        }
        if !A.entry_allowed(H.entry_role){H.entry_role=""}
        H.entry_choosing=H.entry_role==""
        if H.entry_role=="owner" && H.page=="overview" && H.command==nil{A.open_accounts(nil)}else{A.refresh()}
    })
}
A.navigate = fn(page){
    if page=="projects" {page="pools"}
    if page=="agent_home" {page="pool_agents"}
    if H.busy {return}
    if A.local_leaving(page) {return}
    H.ux.origin="" H.ux.restore=false
    if page=="inbox" {H.ux.inboxCursor=nil H.ux.agentCursor=nil H.reqs.result=nil H.reqs.confirm=nil}
    if page=="projects" {H.ux.projectCursor=nil}
    if page=="resources" {H.ux.resourceCursor=nil H.ux.resourceJourney=false}
    H.page=page H.selected=nil H.connection_project=nil H.confirm="" H.notice="" A.redraw() A.refresh()
}
A.load_catalog = fn(){
    let args = {}
    if H.catalog_capability != "" {args.capability = H.catalog_capability}
    A.request("hagency.resources.catalog", args, fn(data){H.catalog = data.items H.catalog_after = data.nextAfter})
}
A.begin_project = fn(){
    if H.busy || H.command != nil || !A.projects_enabled() {return}
    H.page = "project_wizard" H.confirm = "" H.notice = "" A.redraw() A.load_catalog()
}
A.new_project = fn(){
    if H.busy || H.command != nil {return}
    H.project_draft = {step:0 resource:nil name:"" purpose:"" tokens:"100000"}
    H.catalog_capability = "" A.save() A.begin_project()
}
A.choose_project_resource = fn(row){
    if H.busy || H.command != nil {return}
    H.project_draft.resource = row H.project_draft.step = 1 A.save() A.redraw()
}
A.project_field = fn(name, value){
    if H.command != nil {return}
    if name == "name" {H.project_draft.name = value}
    if name == "purpose" {H.project_draft.purpose = value}
    if name == "tokens" {H.project_draft.tokens = value}
    A.save()
}
A.project_step = fn(step){
    if H.busy || H.command != nil {return}
    if step == 2 {
        let tokens = H.project_draft.tokens.trim().to_f64()
        if H.project_draft.resource == nil || H.project_draft.name.trim() == "" || H.project_draft.purpose.trim() == "" || !(tokens >= 1 && tokens <= 9007199254740991) || floor(tokens) != tokens {
            H.notice = A.t("Enter a project name, its purpose and a positive whole number of monthly tokens.", "请输入项目名称、用途与大于零的每月 token 整数数量。") A.redraw() return
        }
    }
    H.notice = "" H.project_draft.step = step A.save() A.redraw()
    if step == 0 {A.load_catalog()}
}
A.request_project = fn(){
    if H.project_draft.resource == nil {return}
    A.submit("hagency.projects.request", {contributionId:H.project_draft.resource.id name:H.project_draft.name.trim() purpose:H.project_draft.purpose.trim() requestedTokens:H.project_draft.tokens.trim().to_f64()})
}
A.refresh_project_progress=fn(id){A.request("hagency.projects.setup.progress",{projectId:id},fn(v){if H.project_selected!=nil && H.project_selected.id==id && v.readiness.projectId==id{H.ux.projectProgress=v}})}
A.open_project = fn(id){
    if H.busy {return}
    if H.project_selected==nil || H.project_selected.id!=id {H.ux.projectTools=false}
    H.ux.projectProgress=nil
    A.request("hagency.projects.get", {id:id}, fn(data){
        if data.project.id!=id {H.notice=A.t("The project changed. Open it again.","项目已变化，请重新打开。") return}
        H.project_selected=data.project H.connection_project=nil H.page="project_action" H.confirm=""
        if data.project.state=="approved" && A.setup_enabled() {
            A.request("hagency.projects.setup.progress",{projectId:id},fn(v){
                if H.project_selected!=nil && H.project_selected.id==id && v.readiness.projectId==id {H.ux.projectProgress=v}
            })
        }
    })
}
A.decide_project = fn(approve){
    if H.project_selected == nil || !H.project_selected.request.canDecide {return}
    A.submit("hagency.projects.decide", {requestId:H.project_selected.request.id expectedRevision:H.project_selected.request.revision approve:approve})
}
A.revoke_project = fn(){
    if H.project_selected == nil || !H.project_selected.canRevoke {return}
    A.submit("hagency.projects.revoke", {projectId:H.project_selected.id expectedRevision:H.project_selected.revision})
}
A.allocations_enabled = fn(){
    if A.pool_enabled(){return false}
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "project-allocation-review-v1" {return true}}
    return false
}
A.allocation_state = fn(state){
    if state == "pending_coordinator" || state == "pending" {return A.t("Awaiting resource owner decision", "等待资源所有者决定")}
    if state == "approved_waiting_executor" {return A.t("Approved · awaiting native reservation", "已批准 · 等你的电脑预留额度")}
    if state == "reserved" {return A.t("Native reservation recorded", "已在你的电脑上预留额度")}
    if state == "rejected" {return A.t("Allocation declined", "分配已拒绝")}
    if state == "refused" {return A.t("Native reservation refused", "你的电脑没有预留额度")}
    if state == "outcome_unknown" {return A.t("Native result unknown", "结果暂时未知")}
    if state == "releasing" {return A.t("Release requested · awaiting native result", "已申请释放 · 等你的电脑确认")}
    if state == "release_blocked" {return A.t("Release requires reconciliation", "释放前需要核算")}
    if state == "released" {return A.t("Release result recorded", "释放结果已记录")}
    if state == "expired" {return A.t("Allocation expired", "分配已过期")}
    return A.t("Recorded state · ", "已记录状态 · ")+state
}
A.allocation_reason = fn(code){
    if code == nil {return ""}
    if code == "resource_owner_is_coordinator" {return A.t("The resource owner automatically coordinates its capacity. Refresh this resource and submit again.", "资源所有者自动协调其容量。请刷新资源后重新提交。")}
    if code == "allocation_coordinator_required" {return A.t("Only the resource owner can decide this allocation.", "只有资源所有者可以决定此分配。")}
    if code == "allocation_release_forbidden" {return A.t("Only the project manager, resource owner or server administrator can request release.", "只有项目经理、资源主人或服务器管理员可以申请释放。")}
    if code == "allocation_exceeds_grant" {return A.t("The project request exceeds the owner's grant. The approved project amount cannot be changed here.", "项目申请超过资源所有者的授权额度，无法在此更改已批准的项目数量。")}
    if code == "project_reservations_unavailable" {return A.t("Project reservations are not enabled on this server.", "此服务器尚未启用项目预留。")}
    if code == "owner_grant_unavailable" || code == "grant_expired" || code == "grant_unavailable" || code == "grant_not_active" {return A.t("The owner grant is no longer current. Its original reservation history remains available.", "资源主人授权已不再有效，原始预留历史仍可查看。")}
    if code == "project_not_approved" || code == "project_unavailable" {return A.t("The project is no longer approved for this allocation. Refresh its latest plan before proceeding.", "项目已不再获准进行此分配，请先刷新项目计划。")}
    if code == "project_revision_changed" {return A.t("The approved project plan changed. This allocation cannot silently switch to its new revision.", "已批准的项目计划已变化，此分配不能自动改用新版本。")}
    if code == "allocation_expired" {return A.t("This allocation period expired. Review the original history; refreshing does not renew it.", "此分配周期已过期，可查看原始历史；刷新不会续期。")}
    if code == "manager_not_eligible" {return A.t("This project manager is not included in the owner's current delegation.", "此项目经理不在资源主人的当前委托范围内。")}
    if code == "executor_unavailable" {return A.t("The owner device or its admitted resource binding needs a fresh check before allocation can proceed.", "需要先重新检查主人设备或获准的资源关联，才能继续分配。")}
    if code == "self_approval_forbidden" {return A.t("This capacity grant does not allow the owner to approve a project they also manage.", "此容量授权不允许资源所有者批准其本人管理的项目申请。")}
    if code == "management_allocation_reply_invalid" {return A.t("The allocation reply could not be verified. Refresh to read the exact record again.", "无法验证分配响应，请刷新并重新读取准确记录。")}
    return A.error_text(code)
}
A.allocation_not_applied = fn(service,code){
    if service != "hagency.allocations.decide" && service != "hagency.allocations.release" {return false}
    for known in ["invalid_arguments","invalid_management_arguments","invalid_identifier","invalid_management_payload","invalid_management_revision","management_revision_changed","management_receipt_capacity","allocation_coordinator_required","management_action_closed","allocation_exceeds_grant","allocation_release_forbidden"] {if code == known {return true}}
    return false
}
A.open_allocations = fn(project_id,after,page){
    if H.busy {return}
    H.page="allocations" H.allocation_project=project_id H.allocation_after=after H.allocation_page=page H.allocation_list=nil H.allocation_confirmation=""
    if !A.allocations_enabled() {H.notice=A.allocation_reason("project_reservations_unavailable") A.redraw() return}
    A.request("hagency.allocations.list",{projectId:project_id after:after limit:16},fn(data){H.allocation_list=data})
}
A.open_allocation = fn(id){
    if H.busy {return}
    H.page="allocation_action" H.allocation_id=id H.allocation_detail=nil H.allocation_confirmation=""
    if !A.allocations_enabled() {H.notice=A.allocation_reason("project_reservations_unavailable") A.redraw() return}
    A.request("hagency.allocations.get",{id:id},fn(data){
        if data.detail.allocation.id != id {H.notice=A.allocation_reason("management_allocation_reply_invalid") return}
        H.allocation_detail=data H.allocation_project=data.detail.allocation.projectId
    })
}
A.allocation_decide = fn(approve){
    if H.busy || H.command != nil || H.allocation_detail == nil {return}
    let detail=H.allocation_detail.detail
    if !detail.allocation.canDecide || !detail.request.canDecide {return}
    A.submit("hagency.allocations.decide",{requestId:detail.request.id expectedRevision:detail.request.revision approve:approve})
}
A.allocation_release = fn(){
    if H.busy || H.command != nil || H.allocation_detail == nil {return}
    let row=H.allocation_detail.detail.allocation
    if !row.canRelease {return}
    A.submit("hagency.allocations.release",{allocationId:row.id expectedRevision:row.revision})
}
A.allocation_back = fn(){
    if H.allocation_from_inbox {A.navigate("inbox")}
    else {A.open_allocations(H.allocation_project,H.allocation_after,H.allocation_page)}
}
A.cleanup_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "agent-cleanup-v1" {return true}}
    return false
}
A.open_removals = fn(project,after,page){
    if H.busy {return}
    H.removals=nil H.removal_project=project H.removal_after=after H.removal_page=page H.page="agent_removals"
    if !A.cleanup_enabled() {A.redraw() return}
    A.request("hagency.agents.removal.list",{projectId:project after:after limit:16},fn(data){
        if data.protocol != "hagency-management-v1" {H.notice=A.agent_reason("management_agent_cleanup_invalid") return}
        H.removals=data
    })
}
A.open_removal = fn(id){
    if H.busy {return}
    H.settlement=nil
    H.removal_id=id H.removal=nil H.removal_confirmation="" H.removal_details=false H.page="agent_removal"
    if !A.cleanup_enabled() {A.redraw() return}
    A.request("hagency.agents.removal.get",{id:id},fn(data){
        if data.protocol != "hagency-management-v1" || data.removal.requestId != id {H.notice=A.agent_reason("management_agent_cleanup_invalid") return}
        if H.page != "agent_removal" || H.removal_id != id {return}
        H.removal=data
        if A.settlement_enabled() {A.open_settlement(id)}
    })
}
A.settlement_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "agent-settlement-v1" {return true}}
    return false
}
A.open_settlement = fn(id){
    if H.busy || !A.settlement_enabled() {return}
    H.settlement=nil
    A.request("hagency.agents.settlement.get",{id:id},fn(data){
        if H.page != "agent_removal" || H.removal_id != id {return}
        if data.protocol != "hagency-management-v1" || data.settlement.requestId != id {H.notice=A.settlement_reason("management_agent_settlement_invalid") return}
        H.settlement=data
    })
}
A.recheck_settlement = fn(){
    if H.busy || H.command != nil || !A.settlement_enabled() || H.settlement == nil {return}
    let s=H.settlement.settlement
    if s.requestId != H.removal_id || !s.canRequest || s.pendingCommandId != nil || s.settlementCurrent || s.fenceReceiptDigest == nil {return}
    A.submit("hagency.agents.settlement.request",{requestId:s.requestId expectedRequestRevision:s.requestRevision expectedFenceReceiptDigest:s.fenceReceiptDigest})
}
A.settlement_reason = fn(code){
    if code == "agent_settlement_changed" || code == "agent_settlement_not_ready" {return A.t("The accounting state changed before this request was accepted. Refresh its latest status.", "请求被接受前核算状态已变化，请刷新最新状态。")}
    if code == "agent_request_not_found" {return A.t("This agent is no longer visible to your current project role.", "当前项目角色已无权查看此 Agent。")}
    if code == "management_agent_settlement_invalid" {return A.t("The settlement reply could not be verified. Refresh or recover the saved request.", "无法验证结算回复，请刷新或恢复已保存的请求。")}
    return A.error_text(code)
}
A.settlement_status = fn(s){
    if s.pendingCommandId != nil {return A.t("Waiting for the original device", "等待原执行设备核算")}
    if s.settlementCurrent {return A.t("Accounting complete for recorded evidence", "已根据当前记录完成核算")}
    if s.latestReceipt != nil && s.latestReceipt.usageComplete {return A.t("Newer evidence needs reconciliation", "新记录需要重新核算")}
    if s.latestReceipt != nil {return A.t("Unresolved usage is still retained", "未核清的用量仍保留记账")}
    if s.fenceReceiptDigest == nil {return A.t("Waiting for the device cleanup receipt", "等待设备清理回执")}
    return A.t("No settlement observation yet", "还没有结算记录")
}
A.removal_number = fn(value){if value == nil {return A.t("Unknown", "未知")} return ""+value+" token"}
A.cleanup_state = fn(value){
    if value == nil {return A.t("No observation recorded", "还没有记录")}
    if value == "pending" || value == "cleanup_pending" {return A.t("Cleanup pending", "等待清理")}
    if value == "delivered" {return A.t("Command delivered", "指令已送达")}
    if value == "completed" || value == "applied" || value == "recorded" {return A.t("Result recorded", "结果已记录")}
    if value == "fenced" {return A.t("New work blocked", "已阻止新任务")}
    if value == "closed" {return A.t("Closure recorded", "已记录关闭")}
    if value == "stopped" {return A.t("Stop observed", "已记录到停止")}
    if value == "not_started" {return A.t("No process start recorded", "尚无进程启动记录")}
    if value == "live" || value == "active" {return A.t("Live at the recorded observation", "记录时仍在运行")}
    if value == "unknown" || value == "outcome_unknown" {return A.t("Outcome unknown", "结果未知")}
    if value == "cleaned" {return A.t("Cleanup recorded", "已记录清理")}
    if value == "qualified" {return A.t("Qualification recorded", "已记录资格检查")}
    if value == "failed" {return A.t("Failure recorded", "已记录失败")}
    if value == "absent_fenced" {return A.t("No reservation · new work blocked", "未创建预留 · 已阻止新任务")}
    if value == "retained" {return A.t("Liability retained", "仍保留额度责任")}
    return A.t("Recorded state · ", "已记录状态 · ")+value
}
A.matrix_cleanup_state = fn(value){
    if value == nil {return A.cleanup_state(nil)}
    if value.state == "fenced" && value.cleanupObservedAtUtc != nil {return A.t("Project-room exit observed", "已确认退出项目房间")}
    return A.cleanup_state(value.state)
}
A.cleanup_complete = fn(value){
    if value == nil {return A.t("No cleanup accounting receipt", "尚无清理核算回执")}
    if value {return A.t("Complete in the cleanup receipt", "清理回执中的核算完整")}
    return A.t("Cleanup accounting incomplete", "清理核算尚未完成")
}
A.confirm_removal = fn(){
    if H.busy || H.command != nil || !A.cleanup_enabled() || H.removal == nil {return}
    let r=H.removal.removal
    if H.removal_confirmation == "cancel" && r.canCancel {A.submit("hagency.agents.cancel",{requestId:r.requestId expectedRevision:r.requestRevision})}
    if H.removal_confirmation == "revoke" && r.canRevoke {A.submit("hagency.agents.revoke",{requestId:r.requestId expectedRevision:r.requestRevision})}
}

A.agents_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "agent-admission-v1" {return true}}
    return false
}
A.agent_state_text = fn(state){
    if state == "pending_approval" {return A.t("Awaiting resource owner approval", "等待资源 owner 批准")}
    if state == "approved_waiting_executor" {return A.t("Approved · executor setup pending", "已批准 · 等待执行设备设置")}
    if state == "rejected" {return A.t("Agent request declined", "Agent 申请已拒绝")}
    if state == "cancelled" {return A.t("Agent request cancelled", "Agent 申请已取消")}
    if state == "revoked" {return A.t("Agent request revoked", "Agent 申请已撤销")}
    if state == "expired" {return A.t("Agent request expired", "Agent 申请已过期")}
    return state
}
A.project_next_steps = fn(){
    if A.setup_enabled() && A.agents_enabled() {return A.t("Open Project setup and Project agents to review this server's current prerequisites. Capacity must be confirmed separately.", "请打开「项目设置」和「项目 Agent」查看服务器当前要求。容量需另行确认。")}
    if A.setup_enabled() {return A.t("Open Project setup to review current prerequisites. Agent requests are not enabled on this server.", "请打开「项目设置」查看当前要求。此服务器尚未启用 Agent 申请。")}
    if A.agents_enabled() {return A.t("Open Project agents to review current request prerequisites. Project setup is not enabled on this server.", "请打开「项目 Agent」查看当前申请要求。此服务器尚未启用项目设置。")}
    return A.t("This server has not enabled project setup or agent requests in this mini app.", "此服务器尚未在小程序中启用项目设置或 Agent 申请。")
}
A.agent_stage_text = fn(stage){
    if !stage.supported {return A.t("Not enabled on this server", "此服务器尚未启用")}
    if stage.record == nil {return A.t("No stage result recorded", "尚无此阶段的结果记录")}
    let state=stage.record.state
    if state == "pending_native" || state == "waiting_native" {return A.t("Waiting for executor", "等待执行设备处理")}
    if state == "authorized" {return A.t("Native check accepted · Matrix update pending", "检查已通过 · 等待 Matrix 更新")}
    if state == "matrix_verified" {return A.t("Matrix membership verified", "Matrix 成员关系已验证")}
    if state == "membership_recheck_required" {return A.t("Matrix membership needs a fresh check", "Matrix 成员关系需要重新检查")}
    if state == "qualified" {return A.t("Runtime qualification recorded", "已记录运行环境资格检查")}
    if state == "qualification_stale" {return A.t("Runtime qualification is stale", "运行环境资格检查已失效")}
    if state == "failed" {return A.t("Stage failed", "此阶段失败")}
    if state == "outcome_unknown" {return A.t("Result unknown · recovery required", "结果未知 · 需要恢复")}
    if state == "fenced" || state == "cleanup_pending" {return A.t("New work blocked · cleanup pending", "已阻止新任务 · 等待清理")}
    if state == "stopped" || state == "cleaned" {return A.t("Stop or cleanup recorded", "已记录停止或清理结果")}
    return A.t("Recorded state · ", "已记录状态 · ") + state
}
A.agent_execution = fn(status){let {execution=nil}=status return execution}
A.agent_execution_text = fn(stage){
    if stage == nil {return A.t("No shared text-execution observation in this response", "这次没有文本执行的记录")}
    if !stage.supported || stage.record == nil {return A.agent_stage_text(stage)}
    let state=stage.record.state
    if state == "pending" {return A.t("Waiting for a text-execution process", "等待文本执行进程")}
    if state == "issued" {return A.t("Process start issued", "已发出进程启动请求")}
    if state == "qualified" {return A.t("Text-execution process qualified at observation", "记录时文本执行进程已通过检查")}
    return A.agent_stage_text(stage)
}
A.control_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "shared-run-control-v1" {return true}}
    return false
}
A.control_reason = fn(code){
    if code == nil {return ""}
    if code == "management_agent_control_local_stop_pending" {return A.t("This device has recorded the pause. Server confirmation is pending.","本机已记录暂停，等待服务器确认。")}
    if code == "role_required" || code == "shared_run_control_forbidden" {return A.t("Only the project manager can enable automatic replies. The resource owner can pause execution.","只有项目经理可以启用自动回复。资源所有者可以暂停执行。")}
    if code == "intake_disabled" || code == "shared_durable_intake_unavailable" {return A.t("Automatic message intake is disabled on this server. You can still pause an existing assignment.","此服务器已关闭自动消息接收，已有分配仍可暂停。")}
    if code == "assignment_authority_changed" || code == "shared_assignment_authority_changed" {return A.t("The assignment or project authorization changed. Refresh its status before enabling replies.","分配或项目授权已变化，请刷新状态后再启用回复。")}
    if code == "shared_control_revision_changed" {return A.t("Another person changed this setting. Recover the saved request, then refresh to see the latest setting.","其他人已更改此设置。请恢复已保存的请求，再刷新查看最新设置。")}
    if code == "already_running" {return ""}
    if code == "shared_run_control_unavailable" || code == "shared_intake_disabled" {return A.t("Automatic reply controls are not supported by this client and server combination.","当前客户端与服务器组合尚不支持自动回复控制。")}
    return A.error_text(code)
}
A.control_mode_text = fn(mode){
    if mode == "running" {return A.t("Automatic replies enabled", "已启用自动回复")}
    if mode == "paused" {return A.t("Automatic replies paused", "已暂停自动回复")}
    return A.t("Automatic replies not enabled", "尚未启用自动回复")
}
A.open_agent_control = fn(assignment,name){
    if H.busy || !A.control_enabled() {return}
    H.control_assignment=assignment H.control_agent_name=name H.agent_control=nil H.page="agent_control"
    A.request("hagency.agents.control.readiness",{assignmentId:assignment},fn(data){
        if data.readiness.control.assignmentId != H.control_assignment {H.notice=A.t("The reply setting belongs to another assignment. Refresh to check again.","回复设置属于其他分配，请刷新后重试。") return}
        H.agent_control=data
    })
}
A.set_agent_control = fn(mode){
    if H.busy || H.command != nil || H.agent_control == nil || !A.control_enabled() {return}
    let r=H.agent_control.readiness
    if r.control.assignmentId != H.control_assignment {return}
    if mode == "running" {if !r.canRun {return}} else if mode == "paused" {if !r.canStop {return}} else {return}
    A.submit("hagency.agents.control.set",{assignmentId:H.control_assignment expectedRevision:r.control.revision mode:mode})
}
A.open_agent_status = fn(id){
    if H.busy || !A.agents_enabled() {return}
    H.agent_id=id H.agent_status=nil H.page="agent_status"
    A.request("hagency.agents.status",{id:id},fn(data){
        if data.protocol != "hagency-management-v1" || data.agentRequest.id != H.agent_id {H.notice=A.t("The status response did not match this agent. Refresh to check again.", "状态响应与此 Agent 不匹配，请刷新后重新检查。") return}
        H.agent_status=data H.agent_selected=data.agentRequest H.agent_project_id=data.agentRequest.projectId
    })
}
A.work_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "shared-work-history-v1" {return true}}
    return false
}
A.open_work_list = fn(project,after,page){
    if H.busy {return}
    H.work_list=nil H.work_list_project=project H.work_list_after=after H.work_list_page=page H.page="agent_work_list"
    if !A.work_enabled() {A.redraw() return}
    A.request("hagency.agents.work.list",{projectId:project after:after limit:16},fn(data){
        if data.protocol != "hagency-management-v1" {H.notice=A.agent_reason("management_agent_work_invalid") return}
        H.work_list=data
    })
}
A.open_work_entry = fn(row){
    if H.busy {return}
    H.work_context=row H.work_from_list=true
    A.open_agent_work(row.requestId,nil,1)
}
A.open_agent_work = fn(id, after, page){
    if H.busy {return}
    H.agent_id=id H.agent_work=nil H.work_after=after H.work_page=page H.page="agent_work"
    if !A.work_enabled() {A.redraw() return}
    A.request("hagency.agents.work",{id:id after:after limit:16},fn(data){
        if data.protocol != "hagency-management-v1" || data.requestId != H.agent_id {H.notice=A.t("The history response did not match this request. Refresh to check again.","历史响应与此申请不匹配，请刷新后重新检查。") return}
        H.agent_work=data
    })
}
A.work_state = fn(state){
    if state == "queued" {return A.t("Queued", "已排队")}
    if state == "acknowledged" {return A.t("Received by executor", "执行设备已接收")}
    if state == "started" {return A.t("Start recorded", "已记录开始执行")}
    if state == "completed" {return A.t("Response completed", "响应已完成")}
    if state == "failed" {return A.t("Execution failed", "执行失败")}
    if state == "unknown" {return A.t("Execution result unknown", "执行结果未知")}
    if state == "cancelled" {return A.t("Cancelled", "已取消")}
    return A.t("Recorded state · ","已记录状态 · ")+state
}
A.work_reply = fn(state){
    if state == nil {return A.t("No delivery record", "暂无发送记录")}
    if state == "pending" {return A.t("Awaiting Matrix reply", "等待发送 Matrix 回复")}
    if state == "issued" {return A.t("Reply send issued", "已发起回复发送")}
    if state == "sent" {return A.t("Reply sent", "回复已发送")}
    if state == "blocked" {return A.t("Reply blocked", "回复被阻止")}
    if state == "unknown" {return A.t("Reply delivery unknown", "回复发送结果未知")}
    return A.t("Recorded state · ","已记录状态 · ")+state
}
A.work_time = fn(value){if value == nil {return A.t("Not recorded", "尚未记录")} return value}
A.work_name = fn(){
    if H.work_from_list && H.work_context != nil && H.work_context.requestId == H.agent_id {return H.work_context.agentName+" · "+H.work_context.projectName}
    if H.agent_selected != nil && H.agent_selected.id == H.agent_id {return H.agent_selected.definition.name}
    return H.agent_id
}
A.work_back = fn(){
    if H.busy {return}
    if H.work_from_list || !A.agents_enabled() {A.open_work_list(H.work_list_project,H.work_list_after,H.work_list_page)} else {A.open_agent_status(H.agent_id)}
}
A.agent_reason = fn(code){
    if code == nil {return ""}
    if code == "agent_admission_unavailable" {return A.t("Agent requests are not enabled on this server.", "此服务器尚未启用 Agent 申请。")}
    if code == "project_manager_required" {return A.t("Only this project's manager can submit or cancel its agent request.", "只有此项目经理可以提交或取消 Agent 申请。")}
    if code == "assigned_project_administrator_required" {return A.t("Only the project manager can approve or reject this request.", "只有项目经理可以批准或拒绝此申请。")}
    if code == "agent_request_closed" || code == "agent_request_expired" {return A.t("This request is closed or expired. Refresh its latest result.", "此申请已结束或过期，请刷新查看最新结果。")}
    if code == "agent_request_binding_changed" {return A.t("The project reservation or setup changed. Review the current project before requesting an agent again.", "项目预留或设置已变化，请核对当前项目后再申请 Agent。")}
    if code == "agent_offer_unavailable" {return A.t("The requested capability or token amount is outside the project's confirmed reservation.", "申请的能力或 token 数量超出了项目已确认的预留范围。")}
    if code == "invalid_managed_agent_definition" {return A.t("Check the agent name, description and capability. Agents start with chat permissions; the resource owner can enable tools in Agent execution permissions.", "请检查 Agent 名称、描述和能力。Agent 初始仅有聊天权限；资源所有者可在 Agent 执行权限中启用工具。")}
    if code == "agent_request_capacity" {return A.t("This account has reached its saved agent-request limit.", "此账号已达到 Agent 申请记录数量上限。")}
    if code == "managed_agent_execution_unavailable" {return A.t("Approval is recorded. Executor setup is a separate step; this page does not confirm a running agent.", "审批结果已记录。执行设备设置是独立步骤；此页面不能确认 Agent 已运行。")}
    if code == "shared_execution_unavailable" {return A.t("Work history is not enabled on this server. Refresh the account status after the server is updated.","此服务器尚未启用任务历史。服务器更新后，请刷新账号状态。")}
    if code == "management_agent_cleanup_invalid" {return A.t("Cleanup status could not be verified. Refresh or recover the original request; no refund is assumed.", "无法验证清理状态，请刷新或恢复原申请；不会据此认定额度已退回。")}
    if code == "management_agent_work_invalid" {return A.t("Work history could not be verified. Refresh this page; no work was submitted.","无法验证任务历史，请刷新此页；此次操作未提交任何任务。")}
    if code == "agent_request_not_found" {return A.t("This request is unavailable to your current project role. Refresh the project or contact its manager.","当前项目角色无法访问此申请，请刷新项目或联系项目经理。")}
    if code == "management_agent_status_invalid" {return A.t("Agent status could not be verified. Refresh to read current server records.", "无法验证 Agent 状态，请刷新以读取当前服务器记录。")}
    if code == "management_agent_reply_invalid" {return A.t("The server reply could not be verified. Recover the original request before trying again.", "无法验证服务器响应，请先恢复原始申请再重试。")}
    return A.setup_reason(code)
}
A.topup_service=fn(service){return service=="hagency.agents.topups.request" || service=="hagency.agents.topups.decide" || service=="hagency.agents.topups.cancel"}
A.topup_operation=fn(op){return op=="agent_top_up_request" || op=="agent_top_up_decide" || op=="agent_top_up_cancel"}
A.budget_idle=fn(){if H.busy || H.command!=nil{return false} for row in H.saved_commands{if A.topup_operation(row.operation) && row.reply==nil{return false}} return true}
A.budget_reason=fn(code){
    if code=="project_manager_required" {return A.t("Only this Agent's manager can request additional tokens.","只有此 Agent 的管理者可以申请追加额度。")}
    if code=="agent_budget_issuance_unavailable" {return A.t("New top-ups are not enabled on this server. Existing requests can still be read or recovered.","此服务器尚未启用新额度追加，仍可查看或恢复已有申请。")}
    if code=="agent_budget_exceeds_pool" {return A.t("The requested increase exceeds this pool's available capacity.","申请追加的额度超出此资源池的可用容量。")}
    if code=="pool_resource_owner_required" {return A.t("Only this resource owner can approve the increase.","只有此资源的 owner 可以批准追加额度。")}
    if code=="agent_budget_exceeds_project" {return A.t("The requested increase exceeds the project's uncommitted reservation. Ask the resource owner to review project capacity.","申请增加的额度超出项目尚未承诺的预留量，请资源所有者核对项目容量。")}
    if code=="agent_topup_pending" {return A.t("This agent already has an unresolved top-up. Open its existing request before making another.","此 Agent 已有尚未解决的额度追加，请先打开已有申请。")}
    if code=="agent_topup_closed" {return A.t("This top-up is closed or already applied. Refresh its current result.","此额度追加已结束或已应用，请刷新查看当前结果。")}
    if code=="agent_budget_changed" || code=="management_revision_changed" {return A.t("The budget or resource authority changed. Refresh and review the current amounts.","额度或权限已变化，请刷新后再看。")}
    if code=="invalid_agent_budget" || code=="invalid_management_arguments" {return A.t("Enter a positive whole token amount and a reason for the increase.","请输入大于零的 token 整数及追加原因。")}
    if code=="management_agent_budget_invalid" {return A.t("The budget reply could not be verified. Recover the saved request before submitting another.","无法验证额度的回复，请先恢复已保存的申请，再提交其他申请。")}
    if code=="agent_budget_original_changed" || code=="agent_budget_authority_changed" {return A.t("The original agent reservation is no longer eligible. Refresh the agent's current status.","原 Agent 预留已不再符合条件，请刷新 Agent 当前状态。")}
    return A.agent_reason(code)
}
A.topup_not_applied=fn(service,code){return A.topup_service(service) && (code=="invalid_identifier" || code=="invalid_management_arguments" || code=="invalid_management_payload" || code=="invalid_agent_budget" || code=="invalid_management_revision" || code=="project_manager_required" || code=="assigned_project_administrator_required" || code=="management_revision_changed" || code=="agent_topup_pending" || code=="agent_topup_capacity" || code=="agent_topup_closed" || code=="agent_budget_changed" || code=="agent_budget_exceeds_project" || code=="agent_budget_exceeds_pool" || code=="pool_resource_owner_required" || code=="agent_budget_issuance_unavailable")}
A.topup_state=fn(state){
    if state=="pending" {return A.t("Awaiting resource owner approval", "等待资源 owner 批准")}
    if state=="approved" {return A.t("Authorized", "已授权")}
    if state=="declined" {return A.t("Declined", "已拒绝")}
    if state=="cancelled" {return A.t("Cancelled", "已取消")}
    if state=="cancellation_requested" {return A.t("Cancellation requested", "已申请取消")}
    if state=="expired" {return A.t("Expired", "已过期")}
    return A.t("Unrecognized state · refresh", "未知状态 · 请刷新")
}
A.topup_native_state=fn(state){
    if state=="applied" {return A.t("Available on execution device", "执行设备已到账")}
    if state=="rejected" {return A.t("Not applied", "未应用")}
    if state=="not_delivered" {return A.t("Not delivered to this device", "尚未送达执行设备")}
    return A.t("Application not yet confirmed", "尚未确认应用结果")
}
A.can_owner_fund=fn(value){let {canOwnerFund=false canOwnerFundDirect=false}=value return canOwnerFund && canOwnerFundDirect}
A.owner_funding_upgrade=fn(value){let {canOwnerFund=false canOwnerFundDirect=false}=value return canOwnerFund && !canOwnerFundDirect}
A.can_topup=fn(value){return A.can_owner_fund(value) || (value.canRequest && !A.owner_funding_upgrade(value))}
A.owner_funded=fn(value){let {ownerFunded=false}=value return ownerFunded}
A.open_agent_budget=fn(id,name,after,page){
    if H.busy{return} H.budget_request_id=id H.budget_agent_name=name H.budget_after=after H.budget_page=page H.agent_budget=nil H.budget_topups=nil H.budget_confirmation=nil H.budget_mode="" H.page="agent_budget"
    A.request("hagency.agents.budget.get",{id:id},fn(data){
        if data.supported && (data.budget==nil || data.budget.requestId!=id){H.notice=A.budget_reason("management_agent_budget_invalid") return}
        H.agent_budget=data
        if data.supported{A.request("hagency.agents.topups.list",{id:id after:after limit:16},fn(rows){H.budget_topups=rows})}
    })
}
A.open_topup=fn(id){if H.busy{return} H.budget_topup_id=id H.budget_topup=nil H.budget_confirmation=nil H.budget_details=false H.page="agent_topup" A.request("hagency.agents.topups.get",{id:id},fn(data){if data.topUp.id!=id{H.notice=A.budget_reason("management_agent_budget_invalid") return} H.budget_topup=data H.budget_request_id=data.topUp.requestId})}
A.begin_topup=fn(){if !A.budget_idle() || H.agent_budget==nil || !H.agent_budget.supported || !A.can_topup(H.agent_budget.budget){return} H.budget_mode="edit" H.budget_tokens="" H.budget_purpose="" H.budget_confirmation=nil A.redraw()}
A.review_topup=fn(){
    if !A.budget_idle() || H.agent_budget==nil || !H.agent_budget.supported || !A.can_topup(H.agent_budget.budget){return}
    let b=H.agent_budget.budget
    let n=H.budget_tokens.trim().to_f64()
    if !(n>=1 && n<=9007199254740991) || floor(n)!=n || (H.budget_purpose.trim()=="" && !A.can_owner_fund(b)) {H.notice=A.budget_reason("invalid_agent_budget") A.redraw() return}
    let purpose=if H.budget_purpose.trim()==""{A.t("Owner capacity increase","Owner 追加容量")}else{H.budget_purpose.trim()}
    H.budget_confirmation={service:"hagency.agents.topups.request" args:{requestId:b.requestId expectedRequestRevision:b.requestRevision expectedAssignmentGeneration:b.assignmentGeneration expectedBudgetRevision:b.budgetRevision expectedBudgetDigest:b.budgetDigest addTokens:n purpose:purpose} title:A.t("Request this budget increase?","申请增加此额度？")}
    if A.can_owner_fund(b){H.budget_confirmation.args.ownerFunded=true H.budget_confirmation.args.approveImmediately=true H.budget_confirmation.title=A.t("Fund this Agent with additional capacity?","为此 Agent 追加专用容量？")}
    H.budget_mode="review" H.notice="" A.redraw()
}
A.review_topup_action=fn(action){
    if !A.budget_idle() || H.budget_topup==nil{return} let t=H.budget_topup.topUp
    if action=="cancel" && t.canCancel{H.budget_confirmation={service:"hagency.agents.topups.cancel" args:{topUpId:t.id expectedRevision:t.revision} title:A.t("Cancel this top-up?","取消此额度追加？")}}
    else if (action=="approve" || action=="reject") && t.canDecide{H.budget_confirmation={service:"hagency.agents.topups.decide" args:{topUpId:t.id expectedRevision:t.revision expectedAuthorityRevision:t.authorityRevision approve:action=="approve"} title:if action=="approve"{A.t("Approve this top-up?","批准此额度追加？")}else{A.t("Reject this top-up?","拒绝此额度追加？")}}}else{return} A.redraw()
}
A.topup_review_hint=fn(){
    let c=H.budget_confirmation
    if c == nil {return ""}
    if c.service == "hagency.agents.topups.cancel" {return A.t("Cancellation may race application and does not prove tokens were returned. Current authority and budget revisions are checked when submitted.","取消可能和额度生效同时发生，不代表 token 已退回。提交时会再检查你的权限和额度。")}
    if c.args.approve && A.owner_funded(H.budget_topup.topUp) {return A.t("Approve this dedicated capacity increase from your resource budget. It can exceed the published pool allocation, but the device must confirm it fits the resource and account limits before use.","批准从你的额度中为此 Agent 追加专用额度。金额可以超出已发布的资源池额度，但必须由执行设备确认资源和账号总额度足够后才能使用。")}
    if c.args.approve {return A.t("Approval authorizes this increase. The execution device must confirm application before it can be used. Current resource authority and budget are checked when submitted.","批准后可以追加这些额度，运行 Agent 的电脑确认后才能使用。提交时会再检查权限和额度。")}
    return A.t("This rejects the pending increase. The agent's existing budget is unchanged.","此操作拒绝待审批的追加申请，不改变 Agent 现有的额度。")
}
A.topup_application_hint=fn(state){
    if state == "applied" {return A.t("Capacity received. This does not confirm that a task is running. Check the task status and errors in the Agent chat.","额度已到账，不代表任务已开始运行。请在 Agent 聊天中查看任务状态和错误提示。")}
    return A.t("The execution device must apply the increase and check current usage and resource access before spending it.","运行 Agent 的电脑要先应用追加的额度，确认用量和权限后才能使用这部分额度。")
}
A.apply_topup=fn(){if !A.budget_idle() || H.budget_confirmation==nil{return} let c=H.budget_confirmation H.budget_confirmation=nil A.submit(c.service,c.args)}
A.topup_received=fn(data){H.budget_topup=data H.budget_topup_id=data.topUp.id H.budget_request_id=data.topUp.requestId H.budget_confirmation=nil H.budget_mode="" H.agent_budget=nil H.page="agent_topup"}
A.agent_not_applied = fn(service, code){
    if service != "hagency.agents.request" && service != "hagency.agents.decide" && service != "hagency.agents.cancel" && service != "hagency.agents.revoke" {return false}
    return code == "invalid_managed_agent_definition" || code == "project_manager_required" || code == "assigned_project_administrator_required" || code == "agent_request_closed" || code == "agent_request_binding_changed" || code == "agent_offer_unavailable" || code == "agent_request_capacity" || code == "management_revision_changed" || code == "management_receipt_capacity" || code == "project_administrator_required" || code == "matrix_setup_required" || code == "matrix_verification_required" || code == "project_setup_changed" || code == "project_administrator_changed" || code == "live_reservation_required" || code == "project_disabled" || code == "project_matrix_not_ready" || code == "project_membership_pending" || code == "project_private_room_required" || code == "project_matrix_marker_mismatch" || code == "project_matrix_proof_missing" || code == "room_administration_denied"
}
A.restore_agent_draft = fn(draft){
    if !draft.is_object() {return false}
    let {projectId=nil,name=nil,description=nil,capability=nil,tokens=nil}=draft
    if !projectId.is_string() || !name.is_string() || !description.is_string() || !capability.is_string() || !tokens.is_string() {return false}
    H.agent_draft={projectId:projectId name:name description:description capability:capability tokens:tokens}
    return true
}
A.clear_agent_draft = fn(row){
    if H.agent_draft.projectId == row.projectId && H.agent_draft.name.trim() == row.definition.name && H.agent_draft.description.trim() == row.definition.description && H.agent_draft.capability == row.definition.capability && H.agent_draft.tokens.trim().to_f64() == row.requestedTokens {
        H.agent_draft={projectId:"" name:"" description:"" capability:"" tokens:"1000"}
    }
}
A.load_agents = fn(after){
    if A.pool_enabled(){A.request("hagency.pools.agents.list",{after:after needsMyAction:H.page=="inbox" && H.needs_action},fn(v){H.pool_agents=v.items H.pool_agent_after=v.nextAfter H.agents=[] H.ux.inboxReady=true H.ux.agentListReady=true}) return}
    H.ux.agentListReady=false
    let args={after:after needsMyAction:false}
    if H.page == "inbox" {args.needsMyAction=H.needs_action H.ux.agentCursor=after H.ux.inboxReady=false H.ux.inboxError=false H.agents=[]} else {args.projectId=H.agent_project_id}
    A.request("hagency.agents.list",args,fn(data){H.agents=data.items H.agent_after=data.nextAfter H.ux.agentListReady=true if H.page=="inbox"{H.ux.inboxReady=true}})
}
A.open_project_agents = fn(id){
    if H.busy || !A.agents_enabled() {return}
    H.agent_project_id=id H.agent_readiness=nil H.agents=[] H.agent_after=nil H.agent_selected=nil H.agent_id="" H.agent_confirmation="" H.page="agents"
    A.request("hagency.agents.readiness",{projectId:id},fn(data){
        if data.readiness.projectId != id {H.notice=A.t("The project changed. Open it again.", "项目已变化，请重新打开。") return}
        H.agent_readiness=data.readiness
        if data.readiness.canViewRequests {A.load_agents(nil)}
    })
}
A.open_agent = fn(id){
    if H.busy || !A.agents_enabled() {return}
    if H.page=="inbox" {H.ux.origin="inbox"} else if H.page=="overview" {H.ux.origin="overview"}
    H.agent_id=id H.agent_selected=nil H.agent_confirmation="" H.page="agent_action"
    A.request("hagency.agents.get",{id:id},fn(data){
        if data.agentRequest.id != id {H.notice=A.t("The request changed. Refresh its latest result.", "申请已变化，请刷新查看最新结果。") return}
        H.agent_selected=data.agentRequest H.agent_project_id=data.agentRequest.projectId
    })
}
A.agent_received = fn(row){H.agent_selected=row H.agent_id=row.id H.agent_project_id=row.projectId H.page="agent_action" H.agent_confirmation="" H.agent_readiness=nil}
A.begin_agent = fn(){
    if A.must_reopen() || H.needs_signin{return}
    if H.busy || H.command != nil || H.agent_readiness == nil || !H.agent_readiness.canRequest || H.agent_readiness.requestContext == nil {return}
    if H.agent_draft.projectId != H.agent_project_id {H.agent_draft={projectId:H.agent_project_id name:"" description:"" capability:"" tokens:"" + min(1000,H.agent_readiness.requestContext.requestedTokenLimit)}}
    H.agent_review=false H.page="agent_wizard" A.save() A.redraw()
}
A.agent_field = fn(field,value){
    if H.busy || H.command != nil {return}
    if field == "name" {H.agent_draft.name=value}
    if field == "description" {H.agent_draft.description=value}
    if field == "capability" {H.agent_draft.capability=value}
    if field == "tokens" {H.agent_draft.tokens=value}
    H.agent_review=false A.save() if field == "capability" {A.redraw()}
}
A.review_agent = fn(){
    if H.busy || H.command != nil || H.agent_readiness == nil || !H.agent_readiness.canRequest || H.agent_readiness.requestContext == nil {return}
    let d=H.agent_draft let c=H.agent_readiness.requestContext let tokens=d.tokens.trim().to_f64()
    let supported=false for capability in c.capabilities {if capability == d.capability {supported=true}}
    if d.name.trim() == "" || !supported || !(tokens >= 1 && tokens <= c.requestedTokenLimit && tokens <= 9007199254740991) || floor(tokens) != tokens {
        H.notice=A.t("Enter an agent name, select a capability and request a positive whole token amount within the project's reservation limit.", "请输入 Agent 名称、选择能力，并填写项目预留上限内大于零的 token 整数。") A.redraw() return
    }
    H.agent_review=true H.notice="" A.save() A.redraw()
}
A.submit_agent = fn(){
    if !H.agent_review || H.agent_readiness == nil || !H.agent_readiness.canRequest || H.agent_readiness.requestContext == nil {return}
    let c=H.agent_readiness.requestContext let d=H.agent_draft
    A.submit("hagency.agents.request",{projectId:H.agent_project_id request:{expectedSetupRevision:c.setupRevision expectedSetupBindingRevision:c.setupBindingRevision expectedAuthorityRevision:c.authorityRevision expectedAllocationRevision:c.allocationRevision definition:{name:d.name.trim() description:d.description.trim() capability:d.capability toolMode:"none"} requestedTokens:d.tokens.trim().to_f64()}})
}
A.decide_agent = fn(approve){
    if H.agent_selected == nil || H.command != nil {return}
    let r=H.agent_selected
    if (approve && !r.canApprove) || (!approve && !r.canReject) {return}
    A.submit("hagency.agents.decide",{requestId:r.id expectedRevision:r.revision expectedAuthorityRevision:r.authorityRevision approve:approve})
}
A.cancel_agent = fn(){
    if H.agent_selected == nil || H.command != nil || !H.agent_selected.canCancel {return}
    A.submit("hagency.agents.cancel",{requestId:H.agent_selected.id expectedRevision:H.agent_selected.revision})
}
A.setup_enabled = fn(){
    if H.session == nil {return false}
    let {features = nil} = H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "project-setup-v1" {return true}}
    return false
}
A.setup_allocation = fn(){
    if H.setup_progress == nil {return nil}
    let {eligibleAllocation = nil} = H.setup_progress.readiness
    return eligibleAllocation
}
A.setup_idle = fn(){return A.setup_enabled() && !H.busy && H.command == nil && H.setup_progress != nil && H.setup_progress.pendingCommands.len() == 0}
A.setup_can_begin = fn(){return A.setup_idle() && H.setup_progress.readiness.canBegin && H.setup_progress.readiness.administrator != nil && A.setup_allocation() != nil}
A.setup_can_continue = fn(){
    if !A.setup_idle() {return false}
    let p = H.setup_progress
    return p.localHistory && p.readiness.setup != nil && p.readiness.setup.state != "cancelled" && p.readiness.canConfirm && p.readiness.capacityReady
}
A.setup_can_rebase = fn(){return A.setup_idle() && H.setup_progress.readiness.canRebase && H.setup_progress.readiness.setup != nil && H.setup_progress.readiness.administrator != nil && A.setup_allocation() != nil}
A.setup_stage_unknown = fn(stage){return stage != nil && stage.state == "outcome_unknown"}
A.setup_stage_text = fn(stage){
    if stage == nil {return A.t("No creation history on this device", "此设备没有创建记录")}
    if stage.state == "not_issued" {return A.t("Not started on this device", "此设备尚未开始创建")}
    if stage.state == "outcome_unknown" {return A.t("Reply missing · recover the original request", "响应未收到 · 恢复原始请求")}
    if stage.state == "room_returned" {return A.t("Room ID received", "已收到房间 ID")}
    return A.t("Refresh to check progress", "请刷新查看进度")
}
A.setup_reason = fn(code){
    if code == "project_administrator_assignment_retired" || code == "project_manager_is_administrator" {return A.t("The project manager now handles project administration. Dismiss this retired assignment request and refresh project setup.", "项目管理权限现已归项目经理。请移除此已停用的管理员指定请求，并刷新项目设置。")}
    if code == nil {return ""}
    if code == "project_unavailable" {return A.t("This project is no longer approved. Saved setup history and permitted cleanup remain available.", "此项目已不再获批，仍可查看设置历史并执行获准的清理操作。")}
    if code == "project_administrator_required" {return A.t("Project manager authority is not available. Refresh project status or ask the server administrator to update the server.", "项目经理权限尚未就绪。请刷新项目状态，或联系服务器管理员更新服务器。")}
    if code == "project_administrator_changed" {return A.t("Project authority changed. Update setup requirements to use the project manager before continuing with the original rooms.", "项目权限已变化。请更新设置条件，使用项目经理权限后继续原始房间设置。")}
    if code == "live_reservation_required" {return A.t("A current verified resource reservation is required. Approval of the project request alone does not reserve capacity.", "需要当前有效且已验证的资源预留。批准项目申请本身不会预留容量。")}
    if code == "matrix_setup_required" {return A.t("The project manager can begin setup after its reservation is ready.", "资源预留就绪后，项目经理可开始设置。")}
    if code == "matrix_verification_required" {return A.t("Continue the original setup and verify the project manager and service account in both rooms.", "请继续原始设置，验证项目经理与服务账号在两个房间中的权限。")}
    if code == "project_setup_cancelled" {return A.t("Setup is cancelled. Existing rooms and resource holds remain; update requirements to resume when permitted.", "设置已取消，现有房间与资源预留仍保留。获准后可更新条件并恢复。")}
    if code == "project_membership_pending" {return A.t("The project manager and service account must be joined. Check their membership, then verify again.", "项目经理与服务账号需加入房间。请检查成员状态后重新验证。")}
    if code == "administrator_invitation_requires_review" {return A.t("Project manager membership needs review. Resolve membership in Matrix, then check again.", "项目经理成员状态需要核查。请在 Matrix 中处理后重新检查。")}
    if code == "space_creation_outcome_unknown" || code == "room_creation_outcome_unknown" || code == "setup_recovery_candidate_required" {return A.t("The creation reply was interrupted. Recover the original marked room; an existing room ID may help locate it.", "创建响应中断。请恢复带有原始标记的房间；可提供已有房间 ID 帮助定位。")}
    if code == "local_setup_history_required" {return A.t("Use the original device that began setup. This device cannot reconstruct authority to create replacement rooms.", "请使用最初开始设置的设备。此设备不能重建创建替代房间的权限。")}
    if code == "local_setup_command_pending" {return A.t("Recover the saved request below before starting another operation.", "请先恢复下方保存的请求，再执行其他操作。")}
    if code == "project_setup_allocation_required" {return A.t("This older request did not record an exact reservation. Recover its original result; do not replace an uncertain request.", "此旧请求未记录确切的资源预留。请恢复其原始结果，不要替换结果不明的请求。")}
    if code == "setup_command_not_terminal" || code == "setup_receipt_missing" {return A.t("This result is not confirmed. Keep the original request and refresh its status.", "此结果尚未确认，请保留原始请求并刷新状态。")}
    if code == "project_matrix_link_conflict" || code == "project_matrix_link_immutable" || code == "project_matrix_proof_conflict" || code == "project_matrix_marker_mismatch" {return A.t("The original room identity or links conflict. Review the existing Matrix rooms; setup will not overwrite them.", "原始房间身份或链接存在冲突，请核查已有 Matrix 房间。设置不会覆盖这些信息。")}
    return A.error_text(code)
}
A.setup_received = fn(data){
    if H.project_selected == nil || data.readiness.projectId != H.project_selected.id {H.notice=A.t("The project changed. Open its latest setup again.", "项目已变化，请重新打开最新设置。") return}
    H.setup_progress=data H.setup_recover_hint=false H.confirm="" H.setup_confirmation=nil
    H.setup_admin=if data.readiness.administrator != nil {data.readiness.administrator.mxid} else {""}
}
A.load_project_setup = fn(){
    if H.project_selected == nil || !A.setup_enabled() {return}
    A.request("hagency.projects.setup.progress", {projectId:H.project_selected.id}, A.setup_received)
}
A.open_project_setup = fn(id){
    if H.busy || !A.setup_enabled() {return}
    H.setup_progress=nil H.setup_confirmation=nil H.setup_recover_hint=false H.setup_space="" H.setup_room="" H.confirm=""
    A.request("hagency.projects.get", {id:id}, fn(data){
        H.project_selected=data.project H.connection_project=nil H.page="project_setup" A.load_project_setup()
    })
}
A.setup_prepare = fn(action, command_id){
    if H.busy || H.setup_progress == nil || H.project_selected == nil || !A.setup_enabled() {return}
    let p=H.setup_progress
    let r=p.readiness
    let args={projectId:r.projectId}
    let service=""
    let title=""
    let detail=""
    if action == "begin" && A.setup_can_begin() {
        let allocation=A.setup_allocation()
        service="hagency.projects.setup.begin"
        args={projectId:r.projectId allocationId:allocation.id expectedProjectRevision:allocation.projectRevision expectedAllocationRevision:allocation.revision expectedAuthorityRevision:r.administrator.revision}
        title=A.t("Begin project setup?", "开始项目设置吗？")
        detail=A.t("Save this reservation and project manager for setup. Room creation happens when you continue.", "为设置保存此次资源预留与项目经理。继续后将创建房间。")
    } else if action == "continue" && A.setup_can_continue() {
        service="hagency.projects.setup.continue"
        if A.setup_stage_unknown(p.space) && H.setup_space.trim() != "" {args.spaceId=H.setup_space.trim()}
        if A.setup_stage_unknown(p.room) && H.setup_room.trim() != "" {args.roomId=H.setup_room.trim()}
        title=A.t("Continue the original setup?", "继续原始设置吗？")
        detail=A.t("Check saved rooms, continue unfinished creation and verify project manager access and room links. Recover uncertain requests using their saved history.", "检查已保存的房间，继续未完成的创建，并验证项目经理权限与房间链接。通过保存的历史恢复结果不明的请求。")
    } else if action == "cancel" && A.setup_idle() && r.canCancel && r.setup != nil {
        service="hagency.projects.setup.cancel"
        args={projectId:r.projectId setupId:r.setup.id expectedRevision:r.setup.revision}
        title=A.t("Cancel project setup?", "取消项目设置吗？")
        detail=A.t("This stops later setup work. Existing or in-flight rooms and reserved capacity remain; cancellation does not delete rooms or refund capacity.", "此操作停止后续设置。已有或正在创建的房间与资源预留仍保留；取消不会删除房间或退还容量。")
    } else if action == "rebase" && A.setup_can_rebase() {
        let allocation=A.setup_allocation()
        service="hagency.projects.setup.rebase"
        args={projectId:r.projectId setupId:r.setup.id expectedRevision:r.setup.revision allocationId:allocation.id expectedProjectRevision:allocation.projectRevision expectedAllocationRevision:allocation.revision expectedAuthorityRevision:r.administrator.revision}
        title=A.t("Update setup requirements?", "更新设置条件吗？")
        detail=A.t("Use the current verified reservation and project manager while preserving the original rooms and creation history.", "使用当前已验证的资源预留与项目经理，并保留原始房间及创建历史。")
    } else if action == "retry" {
        let found=false
        for id in p.pendingCommands {if id == command_id {found=true}}
        if !found {return}
        service="hagency.projects.setup.retry" args={commandId:command_id}
        title=A.t("Recover the original request?", "恢复原始请求吗？")
        detail=A.t("Check the saved request and its latest result using the same identifier. Your current operation permission is checked again.", "用同一个请求查看保存的结果，并重新检查你现在的权限。")
    } else if action == "acknowledge" {
        let found=false
        for row in p.failedCommands {if row.commandId == command_id {found=true}}
        if !found {return}
        service="hagency.projects.setup.acknowledge" args={commandId:command_id}
        title=A.t("Dismiss the confirmed rejection?", "移除已确认的拒绝结果吗？")
        detail=A.t("Only this terminal rejected request is dismissed. Accepted setup and room creation history stay saved.", "仅移除此已终止的拒绝请求，已接受的设置与房间创建历史仍会保留。")
    }
    if service == "" {return}
    H.setup_confirmation={service:service args:args title:title detail:detail} H.confirm="project_setup" A.redraw()
}
A.setup_apply = fn(){
    if H.busy || H.setup_confirmation == nil {return}
    let confirmation=H.setup_confirmation
    H.setup_progress=nil H.setup_confirmation=nil H.confirm="" H.setup_recover_hint=true
    A.request(confirmation.service, confirmation.args, A.setup_received)
}

A.begin_setup = fn(){
    if H.busy {return}
    H.ux.resourceJourney=true A.save()
    if H.ux.accountId!="" && H.wizard.resource==nil && H.command==nil {A.open_account(H.ux.accountId,nil) return}
    if H.wizard.step == 0 && H.wizard.resource == nil && H.wizard.admission == nil && H.command == nil { A.open_accounts(nil) return }
    H.page = "wizard" H.notice = "" A.redraw()
    if H.wizard.step == 1 || H.wizard.step == 2 { A.load_providers() }
    if H.wizard.admission != nil { A.open_connection(H.wizard.admission.contribution.id) }
}
// Owner task context is a view selection, never an authority or provider identity.
A.owner_pools = fn(account){
    if H.busy{return}
    H.owner.accountId=if account==nil{""}else{account.id}
    H.owner.accountLabel=if account==nil{""}else{account.runtime+" · "+A.account_kind(account)+if account.ordinal!=nil{" #"+account.ordinal}else{""}}
    H.capability="" H.ux.resourceCursor=nil H.ux.resourceJourney=false
    A.navigate("resources")
}
A.owner_load_pools = fn(){
    H.owner.poolsReady=false H.resources=[] H.resource_after=nil
    let id=H.owner.accountId let after=H.ux.resourceCursor
    if id!=""{
        let args={id:id} if after!=nil{args.after=after}
        A.request("hagency.accounts.get",args,fn(v){
            if H.page!="resources" || H.owner.accountId!=id || H.ux.resourceCursor!=after{return}
            if v.protocol!="hagency-management-v1" || v.account==nil || v.account.id!=id{H.notice=A.t("This coding tool changed. Select it again.","此编码工具已变化，请重新选择。") return}
            H.resources=v.resources H.resource_after=v.nextAfter H.owner.poolsReady=true
            A.pool_meta_load()
        })
    }else{
        let args={after:if after==nil{""}else{after} limit:16}
        if H.capability!=""{args.capability=H.capability}
        A.request("hagency.resources.list",args,fn(v){
            if H.page!="resources" || H.owner.accountId!="" || H.ux.resourceCursor!=after{return}
            H.resources=v.resources H.resource_after=v.nextAfter H.owner.poolsReady=true
            A.pool_meta_load()
        })
    }
}
A.owner_new_pool=fn(){A.pool_create_open()}
A.owner_continue_pool=fn(){
    if H.busy || H.command!=nil || H.enrollment_draft==nil{return}
    H.page="account_enrollment" H.notice="" A.redraw()
}
A.owner_account_tab=fn(tab){
    if H.busy{return}
    H.owner.accountTab=tab A.redraw()
    start_timeout(0.05,||{
        if H.page!="provider_account" || H.owner.accountTab!=tab{return}
        if tab=="login"{ui.account_tab_login.focus()}
        if tab=="servers"{ui.account_tab_servers.focus()}
        if tab=="pools"{ui.account_tab_pools.focus()}
    })
}
A.owner_requests=fn(connection){
    if H.busy{return}
    H.owner.poolId=if connection==nil{""}else{connection.id}
    H.owner.poolLabel=if connection==nil{""}else{connection.label}
    H.needs_action=true H.pool_detail=nil H.reqs.filter="pending"
    A.navigate("inbox")
}
A.connection_capacity_active=fn(connection){
    let c=H.connection_capacity
    return c.id==connection.id && c.state=="ready" && c.pool!=nil && c.pool.publishedTokens!=nil && c.pool.grantRevision!=nil
}
A.load_connection_capacity=fn(connection){
    if H.entry_role!="owner" || H.page!="action" || connection.ownerMxid!=H.session.account{return}
    let id=connection.id let owner=connection.ownerMxid let epoch=H.connection_capacity.epoch+1
    H.connection_capacity={id:id epoch:epoch state:"loading" pool:nil}
    if !A.pool_enabled(){H.connection_capacity.state="unsupported" return}
    let read=nil
    read=fn(after,seen){host.request("hagency.pools.list",{after:after},fn(r){
        if H.page!="action" || H.entry_role!="owner" || H.selected==nil || H.selected.contribution.id!=id || H.session.account!=owner || H.connection_capacity.epoch!=epoch{return}
        let c=H.connection_capacity
        if !r.is_ok{c.state="error" A.redraw() return}
        for pool in r.data.items {if pool.id==id{
            if pool.ownerMxid!=owner{c.state="error"}else{c.pool=pool c.state="ready"}
            A.redraw() return
        }}
        let next=r.data.nextAfter
        if next==nil{c.state="missing" A.redraw() return}
        let repeated=false for cursor in seen{if cursor==next{repeated=true}}
        if repeated || seen.len()>=32{c.state="error" A.redraw() return}
        seen.push(next) read(next,seen)
    })}
    read(nil,[])
}
A.owner_grant=fn(connection){
    if H.busy || H.command!=nil || connection.ownerMxid!=H.session.account || connection.executorDeviceId!=H.session.device || connection.state!="admitted"{return}
    let c=H.connection_capacity
    if c.id!=connection.id || c.state!="ready" || c.pool==nil{return}
    let published=A.connection_capacity_active(connection) let id=connection.id
    A.request("hagency.onboarding.status",{},fn(v){
        H.onboarding=v
        if !v.grantReviewAvailable{H.notice=A.t("Open this grant on its original execution device.","请在原执行设备上查看此授权。") return}
        let selector=nil let {grantIntents=[]}=v
        for intent in grantIntents{if intent.contributionId==id{selector={intentId:intent.intentId}}}
        if selector==nil && published{H.notice=A.t("Capacity is already published. Its original grant record is unavailable on this device; no new grant was created.","容量已经发布，但此设备暂未找到原始授权记录。没有创建新授权。") return}
        if selector==nil{selector={contributionId:id}}
        A.request("hagency.grants.review",selector,fn(result){H.onboarding_result=result A.open_connection(id)})
    })
}
// Resource pools (owner). Background reads run one at a time on a queue so the
// shared busy lock stays free and the host's pending-request limit is never hit.
A.pool_queue_reset=fn(){H.pool_epoch+=1 H.pool_jobs=[] H.pool_job_at=0 H.pool_job_running=false return H.pool_epoch}
A.pool_enqueue=fn(epoch,service,args,apply){
    if epoch!=H.pool_epoch {return}
    H.pool_jobs.push({service:service args:args apply:apply run:nil})
    A.pool_pump(epoch)
}
A.pool_pump=fn(epoch){
    if epoch!=H.pool_epoch || H.pool_job_running || H.pool_job_at>=H.pool_jobs.len() {return}
    // Reads belong to the page that asked; opening that page again starts over. This
    // computer's pages count pools from the same reads.
    if H.page!="resources" && H.page!="resource_detail" && !A.dev_page() {return}
    let job=H.pool_jobs[H.pool_job_at]
    H.pool_job_at+=1 H.pool_job_running=true
    if job.run!=nil {job.run(fn(){
        if epoch!=H.pool_epoch {return}
        H.pool_job_running=false
        A.pool_pump(epoch)
        if H.page=="resources" || H.page=="resource_detail" {A.redraw()}
    }) return}
    host.request(job.service,job.args,fn(r){
        if epoch!=H.pool_epoch {return}
        H.pool_job_running=false
        if !r.is_ok && (r.error=="native_resume_missing" || r.error=="native_resume_revoked") {H.needs_signin=true}
        job.apply(r)
        A.pool_pump(epoch)
        if H.page=="resources" || H.page=="resource_detail" {A.redraw()}
    })
}
// Reads every page of a list; done(nil) on any error or a repeated cursor.
A.pool_pages=fn(epoch,service,make,pick,done){
    let rows=[] let seen=[]
    let step=nil
    step=fn(after){A.pool_enqueue(epoch,service,make(after),fn(r){
        if !r.is_ok {done(nil) return}
        let items=pick(r.data)
        if items==nil {done(nil) return}
        for item in items {rows.push(item)}
        let {nextAfter=nil}=r.data
        if nextAfter==nil {done(rows) return}
        let repeated=false for cursor in seen {if cursor==nextAfter {repeated=true}}
        if repeated || seen.len()>=32 || rows.len()>512 {done(nil) return}
        seen.push(nextAfter) step(nextAfter)
    })}
    step(nil)
}
A.pool_items=fn(d){let {items=nil}=d return items}
A.pool_published_tokens=fn(grant){
    if grant==nil {return nil}
    let {publishedTokens=nil}=grant
    return publishedTokens
}
A.pool_review_available=fn(board){
    if board==nil {return nil}
    let {grantReviewAvailable=nil}=board
    return grantReviewAvailable
}
A.pool_summary_managers=fn(summary){
    if summary==nil {return nil}
    let {eligibleManagers=nil}=summary
    return if eligibleManagers!=nil && eligibleManagers.len()>0 {eligibleManagers} else {nil}
}
A.pool_summary_expiry=fn(summary){
    if summary==nil {return nil}
    let {delegationExpiresAtMs=nil}=summary
    return delegationExpiresAtMs
}
A.pool_now=fn(d){let {observedAtMs=nil}=d return if observedAtMs!=nil && observedAtMs>0 {observedAtMs} else {nil}}
A.pool_after_args=fn(after){return {after:after}}
A.pool_count_requests=fn(r,cid){
    if !r.is_ok {return -2}
    let {items=nil}=r.data
    if items==nil {return -2}
    let n=0
    for q in items {let {poolId=nil,canDecide=false}=q if poolId==cid && canDecide==true {n=n+1}}
    return n
}
A.pool_count_alerts=fn(r,rid){
    if !r.is_ok {return -2}
    let {resourceId=nil,alerts=nil}=r.data
    if resourceId!=rid || alerts==nil {return -2}
    let n=0
    for a in alerts {let {status=nil}=a if status=="open" {n=n+1}}
    return n
}
A.pool_count_tools=fn(r,rid){
    if !r.is_ok {return -2}
    let {resourceId=nil,approvals=nil,observedAtMs=nil}=r.data
    if resourceId!=rid || approvals==nil {return -2}
    let n=0
    for a in approvals {let {state=nil,expiresAt=nil}=a if state=="pending" && (expiresAt==nil || observedAtMs==nil || expiresAt>observedAtMs) {n=n+1}}
    return n
}
A.pool_count_stopped=fn(r,rid){
    if !r.is_ok {return -2}
    let {resourceId=nil,dispatches=nil}=r.data
    if resourceId!=rid || dispatches==nil {return -2}
    return dispatches.len()
}
A.pool_count_workspaces=fn(r,rid){
    if !r.is_ok {return -2}
    let {resourceId=nil,workspaces=nil}=r.data
    if resourceId!=rid || workspaces==nil {return -2}
    let n=0
    for w in workspaces {let {dirty=false,quarantined=false}=w if dirty==true || quarantined==true {n=n+1}}
    return n
}
A.pool_count_agents=fn(r,rid){
    if !r.is_ok {return -2}
    let {resourceId=nil,agents=nil}=r.data
    if resourceId!=rid || agents==nil {return -2}
    return agents.len()
}
A.pool_mine=fn(c){return H.session!=nil && c.ownerMxid==H.session.account && c.executorDeviceId==H.session.device}
// Pool list: connection, publication, requests and attention counts per pool.
A.pool_meta_load=fn(){
    let epoch=A.pool_queue_reset()
    let old=H.pool_meta
    let m={epoch:epoch conns:nil connsError:false grants:nil grantsError:false requests:nil counts:[] now:nil board:nil boardState:"loading"}
    if old!=nil {m.conns=old.conns m.grants=old.grants m.requests=old.requests m.counts=old.counts m.now=old.now m.board=old.board m.boardState=old.boardState}
    H.pool_meta=m
    let rids=[] for row in H.resources {rids.push(row.id)}
    A.pool_enqueue(epoch,"hagency.onboarding.status",{},fn(r){if r.is_ok {m.board=r.data m.boardState="ready"} else {m.board=nil m.boardState="error"}})
    A.pool_pages(epoch,"hagency.connections.list",A.pool_after_args,fn(d){let t=A.pool_now(d) if t!=nil && m.now==nil {m.now=t} return A.pool_items(d)},fn(rows){if rows==nil {m.connsError=true m.conns=nil} else {m.conns=rows m.connsError=false}})
    if A.pool_enabled() {
        A.pool_pages(epoch,"hagency.pools.list",A.pool_after_args,fn(d){let t=A.pool_now(d) if t!=nil {m.now=t} return A.pool_items(d)},fn(rows){if rows==nil {m.grantsError=true m.grants=nil} else {m.grants=rows m.grantsError=false}})
        A.pool_pages(epoch,"hagency.pools.agents.list",fn(after){return {after:after needsMyAction:true}},A.pool_items,fn(rows){m.requests=rows})
    }
    // The same counts as the pool page's tiles: Track B's helpers, one pool at a time.
    let counts=[]
    for index item in rids {let rid=item if index<16 {
        A.pool_enqueue_run(epoch,fn(done){A.tools_attention(rid,fn(t){A.health_attention(rid,fn(c){
            // Shown together once every pool is counted, so rows don't shift one pool at a time.
            if epoch==H.pool_epoch {counts.push({rid:rid alertKind:c.alertKind tools:A.pool_tools_count(t) own:A.pool_part(t.tools) shared:A.pool_part(t.shared) alerts:A.pool_part(c.alerts) stopped:A.pool_part(c.stopped) workspaces:A.pool_part(c.workspaces)}) if counts.len()>=min(16,rids.len()) {m.counts=counts}}
            done()
        })})})
    }}
}
A.pool_low=fn(remaining,ceiling){return remaining!=nil && ceiling!=nil && ceiling>0 && remaining*10<ceiling}
A.pool_budget=fn(row){
    let {budget={},usage={}}=row
    let {pool={},seat={},remainingTokens=nil}=budget
    let {ceiling=nil,committed=0,period=nil}=pool
    let {quota=nil}=seat
    let {spent=nil,spend_period_key=nil}=usage
    return {ceiling:ceiling committed:if committed==nil {0} else {committed} period:period remaining:remainingTokens quota:quota spent:spent key:spend_period_key low:A.pool_low(remainingTokens,ceiling)}
}
A.pool_frame=fn(row){
    if row.framework=="codex" {return "Codex"}
    if row.framework=="claude" {return "Claude"}
    if row.framework=="octos" {return "Octos"}
    return ""+row.framework
}
A.pool_tool_text=fn(row){return A.pool_frame(row)+" · "+row.model}
A.pool_published=fn(conn,grant){
    if conn==nil || grant==nil || conn.state!="admitted" {return false}
    let {publishedTokens=nil,grantRevision=nil}=grant
    return publishedTokens!=nil && grantRevision!=nil
}
// Every grant lapses at the end of its UTC month, so an admitted pool without a
// live grant is unpublished for this month, whether or not it was published before.
A.pool_status=fn(conn,grant,low,known){
    if !known {return {key:"" text:"" tone:""}}
    if conn!=nil && conn.state=="pending_admission" {return {key:"pending" text:A.t("Waiting for approval","等管理员批准") tone:"waiting"}}
    if A.pool_published(conn,grant) {
        if low {return {key:"low" text:A.t("Low capacity","额度不足") tone:"attention"}}
        return {key:"published" text:A.t("Published","已发布") tone:"running"}
    }
    if conn!=nil && conn.state=="admitted" && grant!=nil {return {key:"month" text:A.t("Not published","本月未发布") tone:"waiting"}}
    return {key:"unpublished" text:A.t("Not connected","未连接服务器") tone:""}
}
A.pool_lapsed=fn(conn,grant){
    if conn==nil || grant==nil || conn.state!="admitted" {return false}
    let {publishedTokens=nil}=grant
    return publishedTokens==nil
}
// "Publish November Capacity", from the server's current UTC month when known.
A.pool_publish_label=fn(now){
    if now==nil {return A.t("Publish This Month’s Capacity","发布本月额度")}
    let c=A.pool_civil(now)
    return A.t("Publish "+A.pool_month_name(c.m)+" Capacity","发布 "+c.m+" 月额度")
}
A.pool_device_line=fn(){return A.t("You confirm it in a window on this computer (keep it on).","在这台电脑的确认窗口里确认（电脑要开着）。")}
// Held for Agents but not used yet this month; used + this + left = the maximum.
A.pool_held_unused=fn(b){
    let used=if b.spent==nil {0} else {b.spent}
    return max(0,b.committed-used)
}
A.pool_capacity_text=fn(b){
    if b.ceiling==nil {return A.t("No monthly maximum yet","尚未设置每月上限")}
    return A.t("","剩余 ")+A.tokens(b.remaining)+A.t(" left · "," · 每月 ")+A.tokens(b.ceiling)+A.t(" a month","")
}
A.pool_row=fn(row){
    let m=H.pool_meta
    let b=A.pool_budget(row)
    let s={conn:nil grant:nil badge:0 known:false requests:0 alerts:0 tools:0 stopped:0 workspaces:0 unknown:false}
    if m!=nil && m.conns!=nil {
        for c in m.conns {if s.conn==nil && c.resourceId==row.id && A.pool_mine(c) {s.conn=c}}
        if s.conn!=nil && m.grants!=nil {for g in m.grants {if s.grant==nil && g.id==s.conn.id && g.ownerMxid==H.session.account {s.grant=g}}}
        s.grant=A.pool_effective_grant(s.conn,s.grant,m.now)
        s.known=s.conn==nil || s.conn.state!="admitted" || s.grant!=nil
        if s.conn!=nil && m.requests!=nil {for q in m.requests {let {poolId=nil,canDecide=false}=q if poolId==s.conn.id && canDecide==true {s.requests+=1}}}
    }
    // The card counts what the pool page's tiles count; "Needs you" lists a chat permission request once.
    if m!=nil {for c in m.counts {if c.rid==row.id {s.alerts=c.alerts s.tools=c.tools s.stopped=c.stopped s.workspaces=c.workspaces}}}
    s.badge=A.pool_badge_sum5(s.requests,s.alerts,s.tools,s.stopped,s.workspaces)
    s.unknown=s.requests==-2 || s.alerts==-2 || s.tools==-2 || s.stopped==-2 || s.workspaces==-2
    s.status=A.pool_status(s.conn,s.grant,b.low,s.known)
    s.lapsed=A.pool_lapsed(s.conn,s.grant)
    s.low=b.low
    // Filled = used + given to Agents (what's committed), grey = left; the pool page reads the same.
    // A month that isn't published has nothing committed, so its bar stays empty.
    s.ratio=if s.lapsed || b.ceiling==nil || b.ceiling<=0 {0} else {max(0,min(1,b.committed/b.ceiling))}
    s.capacity=if s.lapsed && b.ceiling!=nil {A.pool_month_title(m.now)+A.t(" · "+A.tokens(b.remaining)+" usable once published · "+A.tokens(b.ceiling)+" a month"," · 发布后可用 "+A.tokens(b.remaining)+" · 每月 "+A.tokens(b.ceiling))} else {A.pool_capacity_text(b)}
    s.attention=A.pool_attention_text(s)
    return s
}
// Everything waiting for the owner across pools, one row per kind and pool. A permission
// request an Agent asked in chat is listed on every pool's tools page, so it counts once here.
A.pool_todo=fn(){
    let out=[]
    let m=H.pool_meta
    let device=A.pool_list_device()
    if device.key=="attention" {out.push({kind:"device" count:1 rid:"" row:nil fix:device.fix})}
    if H.enrollment_draft!=nil && H.command==nil {out.push({kind:"draft" count:0 rid:"" row:nil fix:false})}
    let pending=A.pool_pending_total()
    if pending>0 {out.push({kind:"requests" count:pending rid:"" row:nil fix:false})}
    for row in A.pool_lapsed_rows() {out.push({kind:"publish" count:1 rid:row.id row:row fix:false})}
    if m==nil {return out}
    // Per-pool rows join once every pool's counts are in, so the list doesn't grow under a finger.
    if m.counts.len()<min(16,H.resources.len()) {return out}
    let shared={n:0 rid:""}
    for row in H.resources {for c in m.counts {if c.rid==row.id {
        let own=A.recipient_optional(c,"own")
        let chat=A.recipient_optional(c,"shared")
        if own!=nil && own>0 {out.push({kind:"tools" count:own rid:row.id row:row fix:false})}
        if chat!=nil && chat>shared.n {shared.n=chat if shared.rid=="" {shared.rid=row.id}}
        if c.alerts>0 {out.push({kind:"alerts" count:c.alerts rid:row.id row:row fix:false alert:A.recipient_optional(c,"alertKind")})}
        if c.stopped>0 {out.push({kind:"stopped" count:c.stopped rid:row.id row:row fix:false})}
        if c.workspaces>0 {out.push({kind:"workspaces" count:c.workspaces rid:row.id row:row fix:false})}
    }}}
    if shared.n>0 {out.push({kind:"shared" count:shared.n rid:shared.rid row:nil fix:false})}
    return out
}
A.pool_todo_count=fn(items){let n={c:0} for item in items {n.c=n.c+max(0,item.count)} return n.c}
A.pool_todo_title=fn(item){
    let n=item.count
    if item.kind=="device" {return if item.fix {A.t("This computer isn’t set up yet","这台电脑还没设置完")} else {A.t("This computer can’t publish pools now","这台电脑现在不能发布资源池")}}
    if item.kind=="draft" {return A.t("Finish creating a pool","继续创建资源池")}
    if item.kind=="requests" {return A.pool_requests_text(n)}
    if item.kind=="publish" {return A.pool_publish_label(A.pool_list_now())}
    if item.kind=="tools" {return A.t(""+n+(if n==1 {" tool request"} else {" tool requests"})+" to decide",""+n+" 个工具请求待处理")}
    if item.kind=="shared" {return A.t(""+n+(if n==1 {" permission question"} else {" permission questions"})+" from chat",""+n+" 个聊天里的权限请求")}
    if item.kind=="alerts" && n==1 && A.recipient_optional(item,"alert")=="ceiling" {return A.t(A.resource_title(item.row)+" is over its monthly maximum",A.resource_title(item.row)+" 超出每月上限")}
    if item.kind=="alerts" {return A.t(""+n+(if n==1 {" alert"} else {" alerts"})+" to look at",""+n+" 条告警要看")}
    if item.kind=="stopped" {return A.t(""+n+(if n==1 {" task stopped"} else {" tasks stopped"})+" midway",""+n+" 个任务中断了")}
    return A.t(""+n+(if n==1 {" workspace"} else {" workspaces"})+" to check",""+n+" 个工作区要检查")
}
A.pool_todo_line=fn(item){
    if item.kind=="device" {return if item.fix {A.t("Until it is, Agents can’t get new capacity.","设置好之前，Agent 拿不到新的额度。")} else {A.t("Agents can’t get new capacity. See why and what to do.","Agent 拿不到新的额度。看看原因和办法。")}}
    if item.kind=="draft" {return H.enrollment_draft.model.label}
    if item.kind=="requests" {return A.t("Agents asking to use your pools","Agent 在申请使用你的资源池")}
    if item.kind=="publish" {return A.resource_title(item.row)+A.t(" · this month isn’t published · confirm on this computer"," · 本月还没发布 · 在这台电脑上确认")}
    if item.kind=="shared" {return A.t("Agents asking in chat whether they may do something","Agent 在聊天里问你能不能做某件事")}
    if item.kind=="alerts" && item.count==1 && A.recipient_optional(item,"alert")=="ceiling" {return A.t("Alert · raise the maximum or stop some Agents","告警 · 调高每月上限，或停止部分 Agent")}
    return A.resource_title(item.row)
}
A.pool_todo_icon=fn(kind){
    if kind=="device" {return mod.rinx_icons.device}
    if kind=="draft" {return mod.rinx_icons.add}
    if kind=="requests" {return mod.rinx_icons.inbox}
    if kind=="publish" {return mod.rinx_icons.resources}
    if kind=="tools" || kind=="shared" {return mod.rinx_icons.lock}
    if kind=="alerts" {return mod.rinx_icons.alert}
    if kind=="stopped" {return mod.rinx_icons.tasks}
    return mod.rinx_icons.folder
}
A.pool_todo_open=fn(item){
    if H.busy {return}
    if item.kind=="device" {A.dev_fix("list",if H.pool_meta==nil {nil} else {H.pool_meta.board}) return}
    if item.kind=="draft" {A.pool_create_open() return}
    if item.kind=="requests" {A.open_pool_requests(nil) return}
    if item.kind=="publish" {A.pool_publish_row(item.row) return}
    if item.kind=="tools" || item.kind=="shared" {A.open_tools(item.rid,"","","requests") return}
    if item.kind=="alerts" {A.health_open(item.rid,"open","") return}
    if item.kind=="stopped" {A.open_stopped_tasks(item.rid,"","") return}
    A.open_workspaces(item.rid,"")
}
// Requests waiting for this owner across every pool on the list.
A.pool_pending_total=fn(){
    let m=H.pool_meta
    if m==nil || m.requests==nil {return 0}
    let n=0
    for q in m.requests {let {canDecide=false,resourceOwnerMxid=nil}=q if canDecide==true && resourceOwnerMxid==H.session.account {n=n+1}}
    return n
}
A.pool_requests_text=fn(n){return if n==1 {A.t("1 Agent request to review","1 个 Agent 申请待审批")} else {A.t(""+n+" Agent requests to review",""+n+" 个 Agent 申请待审批")}}
// Pool detail: connection, publication, device check and attention counts.
A.pool_info_load=fn(rid){
    let epoch=A.pool_queue_reset()
    let old=H.pool_info
    let p={rid:rid conn:nil connState:"loading" grant:nil grantState:"loading" board:nil boardState:"loading" requests:-1 alerts:-1 tools:-1 stopped:-1 workspaces:-1 agents:-1 now:nil using:nil}
    if old!=nil && old.rid==rid {p.conn=old.conn p.connState=old.connState p.grant=old.grant p.grantState=old.grantState p.board=old.board p.boardState=old.boardState p.requests=old.requests p.alerts=old.alerts p.tools=old.tools p.stopped=old.stopped p.workspaces=old.workspaces p.agents=old.agents p.now=old.now p.using=old.using}
    H.pool_info=p
    if H.session==nil {p.connState="error" p.grantState="error" return}
    let rest=fn(){
        A.pool_enqueue(epoch,"hagency.onboarding.status",{},fn(r){if r.is_ok {p.board=r.data p.boardState="ready"} else {p.board=nil p.boardState="error"}})
        A.pool_enqueue(epoch,"hagency.execution_policy.list",{resourceId:rid after:""},fn(r){p.agents=A.pool_count_agents(r,rid)})
        A.pool_enqueue_run(epoch,fn(done){A.tools_attention(rid,fn(t){if epoch==H.pool_epoch {p.tools=A.pool_tools_count(t)} done()})})
        A.pool_enqueue_run(epoch,fn(done){A.health_attention(rid,fn(c){if epoch==H.pool_epoch {p.alerts=A.pool_part(c.alerts) p.stopped=A.pool_part(c.stopped) p.workspaces=A.pool_part(c.workspaces)} done()})})
    }
    A.pool_pages(epoch,"hagency.connections.list",A.pool_after_args,fn(d){let t=A.pool_now(d) if t!=nil && p.now==nil {p.now=t} return A.pool_items(d)},fn(rows){
        if rows==nil {p.connState="error" p.grantState="error" p.requests=-2 rest() return}
        let found=nil
        for row in rows {if found==nil && row.resourceId==rid && A.pool_mine(row) {found=row}}
        p.conn=found
        if found==nil {p.connState="none" p.grant=nil p.grantState="none" p.requests=0 rest() return}
        p.connState="ready"
        let cid=found.id
        if !A.pool_enabled() {p.grant=nil p.grantState="unsupported" p.requests=-2 rest() return}
        A.pool_pages(epoch,"hagency.pools.list",A.pool_after_args,fn(d){let t=A.pool_now(d) if t!=nil {p.now=t} return A.pool_items(d)},fn(pools){
            if pools==nil {p.grant=nil p.grantState="error"} else {
                let grant=nil
                for pool in pools {if grant==nil && pool.id==cid {grant=pool}}
                p.grant=grant
                p.grantState=if grant==nil {"missing"} else if grant.ownerMxid!=H.session.account {"error"} else {"ready"}
                if p.grantState=="error" {p.grant=nil}
            }
            A.pool_edit_sync()
            A.pool_result_show()
            A.pool_enqueue(epoch,"hagency.pools.agents.list",{after:nil needsMyAction:true poolId:cid},fn(r){p.requests=A.pool_count_requests(r,cid)})
            // The Agents running on this pool and what each was given: the per-request floor.
            A.pool_enqueue(epoch,"hagency.pools.agents.list",{after:nil poolId:cid},fn(r){p.using=A.pool_using_rows(r,cid)})
            rest()
        })
    })
}
// After the native confirmation saves a new maximum, say so on the reloaded page.
A.pool_saved_note=fn(args,data){
    let {resourceId=nil,ceiling=nil}=args
    if ceiling==nil {return nil}
    let {kind=nil,tokens=nil}=ceiling
    // The maximum before this change: the amendment's record, else what the page showed when it was sent.
    let kept=H.pool_before
    H.pool_before=nil
    let shown=if kept!=nil && kept.rid==resourceId {kept.max} else {nil}
    if kind=="clear" {return {rid:resourceId at:"max" tone:"running" text:if shown!=nil {A.t("Saved: sharing paused (monthly maximum "+A.tokens(shown)+" → none). Agents can’t request it.","已保存：暂停共享（每月上限 "+A.tokens(shown)+" → 未设置），Agent 不能申请。")} else {A.t("Saved: sharing paused (no monthly maximum). Agents can’t request it.","已保存：暂停共享（不设每月上限），Agent 不能申请。")}}}
    if kind!="monthly" || tokens==nil {return nil}
    let amended=if data==nil {nil} else {A.recipient_optional(data,"ceilingAmendment")}
    let recorded=if amended==nil {nil} else {A.recipient_optional(amended,"previousTokens")}
    let before=if recorded!=nil {recorded} else {shown}
    if before!=nil && before!=tokens {return {rid:resourceId at:"max" tone:"running" text:A.pool_saved_text("max",before,tokens) raised:tokens>before}}
    return {rid:resourceId at:"max" tone:"running" text:A.pool_saved_text("max",nil,tokens)}
}
// "Saved: monthly maximum 1 M → 2 M" / "Saved: per-request limit 0.2 M → 0.25 M": one wording for every saved change.
A.pool_saved_text=fn(what,before,after){
    let max=what=="max"
    if before==nil {return if max {A.t("Saved: monthly maximum is now "+A.tokens(after),"已保存：每月上限改为 "+A.tokens(after))} else {A.t("Saved: per-request limit is now "+A.tokens(after),"已保存：每次申请上限改为 "+A.tokens(after))}}
    return if max {A.t("Saved: monthly maximum "+A.tokens(before)+" → "+A.tokens(after),"已保存：每月上限 "+A.tokens(before)+" → "+A.tokens(after))} else {A.t("Saved: per-request limit "+A.tokens(before)+" → "+A.tokens(after),"已保存：每次申请上限 "+A.tokens(before)+" → "+A.tokens(after))}
}
A.pool_take_saved=fn(rid){
    let note=H.pool_saved
    H.pool_saved=nil
    if note==nil || note.rid!=rid {return nil}
    H.pool_result_scrolls=2
    let at=A.recipient_optional(note,"at")
    return {at:if at==nil {"top"} else {at} tone:note.tone text:note.text raised:A.recipient_optional(note,"raised")==true}
}
// One way of confirming a change on the pool page: the result sits beside the control that changed
// (the maximum, the per-request limit or publishing ahead; else the top of the capacity card).
A.pool_result_at=fn(v){
    let r=H.pool_result
    if r==nil {return ""}
    let at=A.recipient_optional(r,"at")
    if at=="max" || at=="quota" {return at}
    if at=="renew" && (v.renewOpen || v.renewal!=nil) {return at}
    return "top"
}
A.pool_result_dismiss=fn(){H.pool_result=nil H.pool_offer=nil A.redraw()}
// Scrolls the result's section into view once it is drawn: after the page loads, then again
// once its publication state is in (rows above may have moved).
A.pool_result_show=fn(){
    if H.pool_result==nil || H.page!="resource_detail" || H.pool_result_scrolls<=0 {return}
    H.pool_result_scrolls=H.pool_result_scrolls-1
    start_timeout(0.35,||{
        if H.page!="resource_detail" || H.pool_result==nil || H.resource_detail==nil {return}
        let at=A.pool_result_at(A.pool_view(H.resource_detail))
        ui.content.scroll_to(if at=="max" {"pool_max_section"} else if at=="quota" {"pool_quota_section"} else if at=="renew" {"pool_renew_section"} else {"pool_result_top"})
    })
}
// Says a result on the pool page, where it belongs, and brings it into view.
A.pool_say=fn(at,tone,text){H.pool_result={at:at tone:tone text:text} H.pool_result_scrolls=2 A.redraw() A.pool_result_show()}
// Agents running on a pool and what each was given (the per-request floor), from one read of its requests.
A.pool_using_rows=fn(r,cid){
    if !r.is_ok {return nil}
    let {items=nil}=r.data
    if items==nil {return nil}
    let out=[]
    for q in items {let {poolId=nil,state=nil,reservationState=nil,resourceOwnerMxid=nil,requestedTokens=nil}=q if poolId==cid && state=="approved_waiting_executor" && reservationState!="refused" && resourceOwnerMxid==H.session.account && requestedTokens!=nil {out.push(q)}}
    return out
}
A.pool_floor=fn(v){
    let p=H.pool_info
    if p==nil || p.rid!=v.row.id || p.using==nil {return nil}
    let n={t:0} for q in p.using {n.t=n.t+q.requestedTokens}
    return if n.t>0 {n.t} else {nil}
}
A.pool_info_retry=fn(){if H.busy || H.resource_detail==nil {return} H.pool_result=nil A.pool_info_load(H.resource_id) A.redraw()}
// A month key "2026-10" or a UTC time; the pool resets on the 1st of the next month.
A.pool_digits=fn(c,a,b){let s="".to_chars() for i ch in c {if i>=a && i<b {s.push(ch)}} return s.to_string().to_f64()}
// Whole-number division for non-negative amounts. Splash's floor() loses
// precision on large values (floor(20787.99999) is 20788); % is exact.
A.pool_div=fn(a,b){return (a-a%b)/b}
A.pool_civil=fn(ms){
    let z=A.pool_div(ms,86400000)+719468
    let era=A.pool_div(z,146097)
    let doe=z-era*146097
    let yoe=A.pool_div(doe-A.pool_div(doe,1460)+A.pool_div(doe,36524)-A.pool_div(doe,146096),365)
    let doy=doe-(365*yoe+A.pool_div(yoe,4)-A.pool_div(yoe,100))
    let mp=A.pool_div(5*doy+2,153)
    let d=doy-A.pool_div(153*mp+2,5)+1
    let m=if mp<10 {mp+3} else {mp-9}
    let y=yoe+era*400+if m<=2 {1} else {0}
    return {y:y m:m d:d}
}
A.pool_month_name=fn(m){
    let names=["January","February","March","April","May","June","July","August","September","October","November","December"]
    return names[max(0,min(11,m-1))]
}
A.pool_reset_text=fn(key,observed){
    let s={m:0}
    if observed!=nil {s.m=A.pool_civil(observed).m}
    if s.m==0 && key!=nil && key.is_string() {let c=key.to_chars() if c.len()>=7 {s.m=A.pool_digits(c,5,7)}}
    if !(s.m>=1 && s.m<=12) {return ""}
    let next=s.m%12+1
    return A.t("Resets "+A.pool_month_name(next)+" 1",""+next+" 月 1 日重置")
}
// "December 1" / "12 月 1 日": the first day of next UTC month, or "next month".
A.pool_next_month=fn(now){
    if now==nil {return A.t("the 1st of next month","下月 1 日")}
    let next=A.pool_civil(now).m%12+1
    return A.t(A.pool_month_name(next)+" 1",""+next+" 月 1 日")
}
A.pool_date=fn(ms){
    if ms==nil {return ""}
    let c=A.pool_civil(ms)
    return A.t("Until "+A.pool_month_name(c.m)+" "+c.d+", "+c.y,"至 "+c.y+" 年 "+c.m+" 月 "+c.d+" 日")
}
A.pool_grant_summary=fn(cid){
    for row in H.pool_grants {if row.id==cid {return row.summary}}
    return nil
}
A.pool_last_limit=fn(cid){return A.pool_summary_tokens(A.pool_grant_summary(cid))}
A.pool_summary_tokens=fn(summary){
    if summary==nil {return nil}
    let {allocatedTokens=nil}=summary
    return if allocatedTokens!=nil && allocatedTokens>=1 {allocatedTokens} else {nil}
}
A.pool_keep_summary=fn(cid,data){
    let {summary=nil,state=nil,serverState=nil}=data
    if summary==nil || !summary.is_object() {return}
    let {contributionId=nil}=summary
    if contributionId!=nil && contributionId!=cid {return}
    let rows=[] for row in H.pool_grants {if row.id!=cid {rows.push(row)}}
    rows.push({id:cid summary:summary live:state=="server_observed" && serverState=="active"})
    H.pool_grants=rows
}
// The grant a publication on this device just made live, until its month ends.
A.pool_live_summary=fn(cid,now){
    for row in H.pool_grants {if row.id==cid && row.live {
        let {periodEndMs=nil}=row.summary
        if periodEndMs==nil || now==nil || now<periodEndMs {return row.summary}
    }}
    return nil
}
// pools.list's grant, or the one this device just published if the list lags.
A.pool_effective_grant=fn(conn,grant,now){
    if conn==nil || grant==nil || conn.state!="admitted" {return grant}
    let {publishedTokens=nil}=grant
    if publishedTokens!=nil {return grant}
    let live=A.pool_live_summary(conn.id,now)
    if live==nil {return grant}
    return {id:grant.id ownerMxid:grant.ownerMxid publishedTokens:A.pool_summary_tokens(live) grantRevision:1 blockingReason:nil}
}
// The per-request quota defaults to a quarter of the monthly maximum.
A.pool_quota_default=fn(ceiling){
    if ceiling==nil || ceiling<=0 {return 100000}
    let q=A.pool_div(ceiling,40000)*10000
    if q>=1 {return min(q,ceiling)}
    return max(1,A.pool_div(ceiling,4))
}
A.pool_edit_sync=fn(){
    let detail=H.resource_detail
    if detail==nil {return}
    let row=detail.resource let b=A.pool_budget(row)
    let maxBase=if b.ceiling==nil {""} else {""+b.ceiling}
    let p=H.pool_info
    let mine=p!=nil && p.rid==row.id && p.conn!=nil
    let last=if mine {A.pool_last_limit(p.conn.id)} else {nil}
    let live=if mine {A.pool_published_tokens(A.pool_effective_grant(p.conn,p.grant,p.now))} else {nil}
    // The draft for the next publication: the owner's own, else this month's amount, else the last one, else a quarter of the maximum.
    let stored=A.pool_draft_get(row.id)
    if stored==nil && live!=nil {A.pool_draft_set(row.id,live)}
    let mode=A.pool_view(detail).quotaMode
    let quotaBase=""+if live!=nil && (mode=="amend" || mode=="scheduled") {live} else if stored!=nil {stored} else if live!=nil {live} else if last!=nil {last} else {A.pool_quota_default(b.ceiling)}
    let e=H.pool_edit
    if e==nil || e.rid!=row.id || e.maxBase!=maxBase {H.pool_edit={rid:row.id maxBase:maxBase max:maxBase unlimitedBase:b.ceiling==nil unlimited:b.ceiling==nil quotaBase:quotaBase quota:quotaBase} return}
    if e.quotaBase!=quotaBase && e.quota==e.quotaBase {e.quota=quotaBase}
    e.quotaBase=quotaBase
}
// A token amount as typed: digits only (the number editor stores exact integers).
A.pool_whole=fn(text){
    let chars=text.trim().to_chars()
    if chars.len()==0 || chars.len()>16 {return -1}
    let digits="0123456789".to_chars()
    for ch in chars {let found=false for d in digits {if ch==d {found=true}} if !found {return -1}}
    let value=text.trim().to_f64()
    if !(value>=0 && value<=9007199254740991) {return -1}
    return value
}
// Why the monthly maximum can't be changed here, in one sentence per case. reason is the
// configuration's editing reason; amend the detail's ceilingAmendment (nil on older versions).
A.pool_max_reason=fn(reason,amend){
    if reason=="read_only" {return A.t("You can only view this pool here.","这里只能查看，不能修改。")}
    if reason=="account_unavailable" {return A.t("Sign in to the coding tool again to change it.","请先在「编码工具」里重新登录。")}
    if reason=="published" {return A.t("It can’t change while the pool is listed in the catalogue.","列在目录中时，每月上限不能修改。")}
    if reason=="retained_commitments" {return A.t("Some of it is given to Agents, so it can’t change yet.","还有额度已分给 Agent，暂时不能修改。")}
    if amend==nil {return A.pool_lock_rule()}
    let why=A.recipient_optional(amend,"reason")
    if why=="contribution_history_not_proven" {return A.t("This computer doesn’t have the records from when the pool was offered, so the maximum can only change on the computer that offered it.","这台电脑上没有这个资源池连接服务器时的记录，只能在原来那台电脑上调整每月上限。")}
    if why=="monthly_ceiling_required" {return A.t("This pool was offered without a monthly maximum, and one can’t be added afterwards. Add another pool with a maximum instead.","这个资源池连接服务器时没有设每月上限，之后不能再加。可以再建一个设了上限的资源池。")}
    if why=="read_only" {return A.t("You can only view this pool here.","这里只能查看，不能修改。")}
    if why=="not_offered" {return A.t("Connect the pool to a server first.","请先把资源池连接到服务器。")}
    return A.pool_lock_rule()
}
// The one wording of the lock rule, used on the pool page, the glossary and alerts.
A.pool_lock_rule=fn(){return A.t("This server or this computer’s Hagency can’t change an offered pool’s monthly maximum yet, so it stays as it is for now.","这个服务器或这台电脑上的 Hagency 还不支持调整已连接服务器的资源池的每月上限，现在先保持不变。")}
// The server feature that lets a published month change, or be scheduled ahead.
A.succession_enabled=fn(){
    if H.session==nil || H.pool_no_succession {return false}
    let {features=nil}=H.session
    if !features.is_array() && !features.is_object() {return false}
    for feature in features {if feature=="pool-grant-succession-v1" {return true}}
    return false
}
A.pool_amend_allowed=fn(amend){return amend!=nil && A.recipient_optional(amend,"allowed")==true && A.recipient_optional(amend,"sequence")!=nil}
// The lowest maximum the amendment accepts; nil means it can only go up now.
A.pool_amend_min=fn(amend){
    if amend==nil {return nil}
    let n=A.recipient_optional(amend,"minimumTokens")
    return if n!=nil && n>=1 {n} else {nil}
}
// Next month's first day (UTC), when this month's grant lapses.
A.pool_month_end=fn(now){
    if now==nil {return nil}
    let c=A.pool_civil(now)
    let y=if c.m==12 {c.y+1} else {c.y}
    let m=if c.m==12 {1} else {c.m+1}
    // Days from 1970-01-01 to y-m-01 (days-from-civil).
    let yy=if m<=2 {y-1} else {y}
    let era=A.pool_div(yy,400)
    let yoe=yy-era*400
    let mp=if m>2 {m-3} else {m+9}
    let doy=A.pool_div(153*mp+2,5)
    let doe=yoe*365+A.pool_div(yoe,4)-A.pool_div(yoe,100)+doy
    return (era*146097+doe-719468)*86400000
}
// One view model for the detail page: what is shown, what can change and why not.
A.pool_view=fn(detail){
    let row=detail.resource
    let b=A.pool_budget(row)
    let p=H.pool_info
    let v={row:row b:b conn:nil grant:nil board:nil connState:"loading" grantState:"loading" boardState:"loading" requests:-1 alerts:-1 tools:-1 stopped:-1 workspaces:-1 agents:-1}
    if p!=nil && p.rid==row.id {v.conn=p.conn v.grant=p.grant v.board=p.board v.connState=p.connState v.grantState=p.grantState v.boardState=p.boardState v.requests=p.requests v.alerts=p.alerts v.tools=p.tools v.stopped=p.stopped v.workspaces=p.workspaces v.agents=p.agents}
    let {editing={},ceiling=nil,observedAtMs=nil,ceilingAmendment=nil}=detail
    let {allowed=false,reason=nil}=editing
    v.editable=allowed==true
    v.editReason=reason
    v.now=if p!=nil && p.rid==row.id && p.now!=nil {p.now} else if observedAtMs!=nil && observedAtMs>0 {observedAtMs} else {nil}
    v.grant=A.pool_effective_grant(v.conn,v.grant,v.now)
    let publishedTokens=A.pool_published_tokens(v.grant)
    v.published=A.pool_published(v.conn,v.grant)
    v.publishedTokens=publishedTokens
    let known=v.connState=="none" || (v.connState=="ready" && (v.conn.state!="admitted" || v.grant!=nil))
    v.status=A.pool_status(v.conn,v.grant,b.low,known)
    v.lapsed=A.pool_lapsed(v.conn,v.grant)
    v.reset=if b.ceiling==nil {""} else {A.pool_reset_text(b.key,v.now)}
    v.summary=if v.conn==nil {nil} else {A.pool_grant_summary(v.conn.id)}
    v.managers=A.pool_summary_managers(v.summary)
    v.expires=A.pool_summary_expiry(v.summary)
    // Monthly maximum: the configuration before the pool is first offered, the native
    // amendment after that when the detail allows it, else locked with one reason.
    v.amend=ceilingAmendment
    v.maxMode=if v.editable {"edit"} else if A.pool_amend_allowed(ceilingAmendment) {"amend"} else {"locked"}
    v.raiseOnly=v.maxMode=="amend" && A.pool_amend_min(ceilingAmendment)==nil
    v.maxMin=if v.maxMode=="amend" {if v.raiseOnly {if b.ceiling==nil {1} else {b.ceiling}} else {A.pool_amend_min(ceilingAmendment)}} else {b.committed}
    v.maxMax=if b.quota!=nil && b.quota>0 {max(b.quota,if b.ceiling==nil {0} else {b.ceiling})} else {-1}
    v.maxReason=if v.maxMode=="locked" {A.pool_max_reason(reason,ceilingAmendment)} else {""}
    v.another=v.maxMode=="locked" && detail.choices.len()>0 && reason!="read_only"
    let presets=[]
    let top=if v.maxMax>0 {v.maxMax} else {10000000}
    for amount in [100000,200000,500000,1000000,2000000,5000000,10000000,20000000,50000000,100000000] {if amount<=top && amount>=v.maxMin && amount>0 {presets.push(amount)}}
    if b.quota!=nil && b.quota>0 && b.quota>=v.maxMin {let found=false for amount in presets {if amount==b.quota {found=true}} if !found {presets.push(b.quota)}}
    let chosen=[] for index amount in presets {if index>=presets.len()-4 {chosen.push(amount)}}
    v.presets=chosen
    // Per-request quota: publish a month, change a published month, or keep a draft for the next one.
    let c=v.conn
    let grantReviewAvailable=A.pool_review_available(v.board)
    v.quotaEditable=false
    v.quotaReason=""
    if v.connState=="loading" || (v.connState=="ready" && c.state=="admitted" && v.grantState=="loading") {v.quotaReason=A.t("Checking publication…","正在读取发布状态…")}
    else if v.connState=="error" {v.quotaReason=A.t("Couldn’t read the server connection.","暂时无法读取服务器连接。")}
    else if c==nil {v.quotaReason=A.t("Connect to a server first; the limit is set when you publish.","先连接服务器，获准后在发布时设置。")}
    else if c.state=="pending_admission" {v.quotaReason=A.t("You can set it once the administrator approves.","管理员批准后即可设置。")}
    else if c.state!="admitted" {v.quotaReason=A.t("The server connection is closed. Ask to join again first.","服务器连接已关闭，请先重新连接服务器。")}
    else if v.grantState=="unsupported" {v.quotaReason=A.t("This server can’t set it from here yet.","此服务器暂不支持在这里设置。")}
    else if v.grantState!="ready" {v.quotaReason=A.t("Couldn’t confirm what is published. Try again.","暂时无法确认已发布的额度，请重试。")}
    else if publishedTokens!=nil {v.quotaReason=A.t("Published for this month. You can change it when you publish again on ","本月已发布。")+A.pool_next_month(v.now)+A.t(".","可重新发布并调整。")}
    else if v.boardState=="loading" {v.quotaReason=A.t("Checking this computer…","正在检查这台电脑…")}
    else if v.boardState!="ready" {v.quotaReason=A.t("Couldn’t check this computer. Try again.","暂时无法检查这台电脑，请重试。")}
    else if grantReviewAvailable!=true {v.quotaReason=A.t("This computer can’t publish yet. Open This Computer at the bottom of Resource Pools.","这台电脑还不能发布。请在「资源池」底部的「这台电脑」里处理。")}
    else {v.quotaEditable=true}
    v.quotaMax=if b.ceiling!=nil && b.ceiling>0 {b.ceiling} else if b.quota!=nil && b.quota>0 {b.quota} else {-1}
    v.deviceReady=grantReviewAvailable==true
    v.succession=A.succession_enabled()
    v.renewal=if v.grant==nil {nil} else {A.recipient_optional(v.grant,"renewal")}
    let end=if v.grant==nil {nil} else {A.recipient_optional(v.grant,"currentPeriodEndMs")}
    v.periodEnd=if end!=nil {end} else {A.pool_month_end(v.now)}
    v.quotaMode=if v.quotaEditable {"publish"} else if v.published && v.renewal!=nil {"scheduled"} else if v.published && v.succession && v.deviceReady {"amend"} else if v.published {"draft"} else {"locked"}
    v.renewOpen=v.published && v.succession && v.deviceReady && v.renewal==nil && v.now!=nil && v.periodEnd!=nil && v.now>=v.periodEnd-7*86400000 && v.now<v.periodEnd
    v.health=A.pool_badge_sum(v.alerts,v.stopped,v.workspaces)
    v.when=A.pool_quota_when(v)
    return v
}
A.pool_save_state=fn(){
    let s={dirty:false maxDirty:false quotaDirty:false quotaEditable:false quotaMode:"" maxMode:"" enabled:false visible:false maxError:"" quotaError:"" label:"" note:"" draft:""}
    let detail=H.resource_detail let e=H.pool_edit
    if detail==nil || e==nil || e.rid!=detail.resource.id {return s}
    let v=A.pool_view(detail)
    s.quotaEditable=v.quotaEditable
    s.quotaMode=v.quotaMode
    s.maxMode=v.maxMode
    s.maxDirty=v.maxMode!="locked" && (e.unlimited!=e.unlimitedBase || (!e.unlimited && e.max!=e.maxBase))
    let max=if s.maxDirty {if e.unlimited {-1} else {A.pool_whole(e.max)}} else {if v.b.ceiling==nil {-1} else {v.b.ceiling}}
    if s.maxDirty && !e.unlimited {
        if max<0 {s.maxError=A.t("Enter a whole amount, such as 1.5 M.","请输入有效额度，例如 1.5 M。")}
        else if max<v.maxMin {s.maxError=if v.maxMode=="amend" {if v.raiseOnly {A.t("For now it can only go up from ","现在只能从 ")+A.tokens(v.maxMin)+A.t(".","往上调。")} else {A.t("At least ","不能低于本月已承诺的 ")+A.tokens(v.maxMin)+A.t(", already promised this month.","。")}} else {A.t("At least ","不能低于已承诺的 ")+A.tokens(v.maxMin)+A.t(", already committed.","。")}}
        else if v.maxMax>=0 && max>v.maxMax {s.maxError=A.t("No more than the account limit of ","不能超过账号上限 ")+A.tokens(v.maxMax)+A.t(".","。")}
        else if v.maxMode=="amend" && v.b.ceiling!=nil && max==v.b.ceiling {s.maxError=A.t("That’s the current maximum.","和现在的每月上限一样。")}
    }
    let quota=A.pool_whole(e.quota)
    let top=if max>=0 {max} else {v.quotaMax}
    if quota<1 {s.quotaError=A.t("Enter an amount above zero.","请输入大于零的额度。")}
    else if top>=0 && quota>top {s.quotaError=A.t("No more than the monthly maximum of ","不能超过每月上限 ")+A.tokens(top)+A.t(".","。")}
    let given=if v.quotaMode=="amend" {A.pool_floor(v)} else {nil}
    if s.quotaError=="" && given!=nil && quota>=1 && quota<given && quota!=v.publishedTokens {s.quotaError=A.t("No less than the "+A.tokens(given)+" given to running Agents.","不能低于已分给正在运行的 Agent 的 "+A.tokens(given)+"。")}
    // A published month: the slider proposes a change now (amend), or keeps a draft for next month.
    s.quotaDirty=(v.quotaMode=="amend" || v.quotaMode=="draft") && quota>=1 && v.publishedTokens!=nil && quota!=v.publishedTokens
    if v.quotaMode=="draft" && s.quotaDirty && s.quotaError=="" {s.draft=A.t("Saved for "+A.pool_next_month_name(v.now)+": each request up to ","已记下："+A.pool_next_month_name(v.now)+"发布时每次最多 ")+A.tokens(quota)+A.t(".","。")}
    s.dirty=s.maxDirty || (v.quotaMode=="amend" && s.quotaDirty)
    s.visible=v.maxMode!="locked" || v.quotaEditable || v.quotaMode=="amend"
    s.label=if !s.maxDirty && v.quotaEditable {A.pool_publish_label(v.now)} else {A.t("Save Changes","保存更改")}
    s.note=if s.maxDirty && v.maxMode=="amend" {A.t("Confirm it in a window on this computer. Running Agents keep going.","在这台电脑的确认窗口里确认；正在运行的 Agent 不受影响。")} else if s.maxDirty {A.t("Confirm it in a window on this computer.","在这台电脑的确认窗口里确认。")} else if v.quotaMode=="amend" {A.t("Confirm it in a window on this computer; it applies this month right away. What running Agents were given stays.","在这台电脑的确认窗口里确认，本月立即生效；已分给正在运行的 Agent 的额度不变。")} else if v.quotaEditable {A.t("After you tap it, choose people and confirm in a window on this computer (keep it on).","点按后，在这台电脑的确认窗口里选人并确认（电脑要开着）。")} else {""}
    s.enabled=!H.busy && H.command==nil && s.maxError=="" && (s.maxDirty || (v.quotaEditable && s.quotaError=="") || (v.quotaMode=="amend" && s.quotaDirty && s.quotaError==""))
    return s
}
A.pool_next_month_name=fn(now){
    if now==nil {return A.t("next month","下个月")}
    let next=A.pool_civil(now).m%12+1
    return A.t(A.pool_month_name(next),""+next+" 月")
}
// "October isn't published", for the capacity hero of a month without a grant.
A.pool_month_title=fn(now){
    if now==nil {return A.t("Not published this month","本月尚未发布")}
    let m=A.pool_civil(now).m
    return A.t(A.pool_month_name(m)+" isn’t published",""+m+" 月尚未发布")
}
A.pool_max_floor_text=fn(v){
    let b=v.b
    if v.maxMode=="amend" {return if v.raiseOnly {A.t("For now it can only go up","现在只能调高")} else if v.maxMin<=1 {A.t("It can go up or down","可以调高，也可以调低")} else {A.t("No less than the ","不能低于已承诺的 ")+A.tokens(v.maxMin)+A.t(" committed","")}}
    return if b.committed>0 {A.t("No less than the ","不能低于已承诺的 ")+A.tokens(b.committed)+A.t(" committed","")} else {A.t("Lowest 0 (not shared)","最低 0（不共享）")}
}
// "Committed" in one sentence: what's used plus what Agents hold, the floor of the maximum.
A.pool_committed_line=fn(b){
    let used=if b.spent==nil {0} else {b.spent}
    return A.t("This month: committed "+A.tokens(b.committed)+" = used "+A.tokens(used)+" + given to Agents, not used yet "+A.tokens(A.pool_held_unused(b)),"本月：已承诺 "+A.tokens(b.committed)+" = 已用 "+A.tokens(used)+" + 已分给 Agent，尚未用 "+A.tokens(A.pool_held_unused(b)))
}
// The unsaved change, said beside the control that made it.
A.pool_unsaved=fn(){
    let out={max:"" quota:""}
    let detail=H.resource_detail let e=H.pool_edit
    if detail==nil || e==nil || e.rid!=detail.resource.id {return out}
    let v=A.pool_view(detail)
    let s=A.pool_save_state()
    let was=if v.b.ceiling==nil {A.t("not set","未设置")} else {A.tokens(v.b.ceiling)}
    if s.maxDirty && e.unlimited {out.max=A.t("Unsaved · pause sharing","未保存 · 暂停共享")}
    if s.maxDirty && !e.unlimited && A.pool_whole(e.max)>=0 {out.max=A.t("Unsaved · ","未保存 · ")+was+" → "+A.tokens(A.pool_whole(e.max))}
    if v.quotaMode=="amend" && s.quotaDirty {out.quota=A.t("Unsaved · ","未保存 · ")+A.tokens(v.publishedTokens)+" → "+A.tokens(A.pool_whole(e.quota))}
    return out
}
// The bar under the page while a pool has something to save or publish.
A.pool_footer_state=fn(){
    let out={show:false dirty:false enabled:false label:"" note:""}
    if H.page!="resource_detail" || H.resource_detail==nil || H.pool_edit==nil || H.resource_name_mode!="" {return out}
    let s=A.pool_save_state()
    if !s.visible || !(s.dirty || s.quotaEditable) {return out}
    out.show=true out.dirty=s.dirty out.label=s.label out.note=s.note
    out.enabled=s.enabled && A.alert_kind()==""
    return out
}
A.pool_max_top_text=fn(v){return if v.maxMax>0 {A.t("Account limit ","账号上限 ")+A.tokens(v.maxMax)} else {A.t("Account limit unknown","账号上限未知")}}
// What the shared account limit still has room for, beside "Add Another Pool".
A.pool_account_room=fn(row){
    let a=A.pool_account_use(row)
    if a.quota==nil {return A.t("Another pool on the same account adds capacity.","用同一账号再建一个资源池，可以增加额度。")}
    return A.t("Account limit "+A.tokens(a.quota)+"; "+A.tokens(max(0,a.quota-a.used))+" not given to pools yet.","账号上限 "+A.tokens(a.quota)+"，还可再分 "+A.tokens(max(0,a.quota-a.used))+"。")
}
// Pools on one account share its limit: the limit, and the sum of the pools' monthly maximums.
// Only pools of the same tool with the same account limit count, and only when this profile
// has one account for that tool, so different accounts are never added together.
A.pool_account_use=fn(row){
    let b=A.pool_budget(row)
    let out={quota:nil used:0 pools:0 runtime:row.framework}
    if b.quota==nil || b.quota<=0 {return out}
    let groups=A.account_groups()
    let n={c:0} for g in groups.known {if g.runtime==row.framework {n.c+=1}}
    if H.owner.accountId=="" && n.c!=1 {return out}
    out.quota=b.quota
    let rows=[]
    if H.resources.len()==0 {rows.push(row)}
    for r in H.resources {rows.push(r)}
    for r in rows {let rb=A.pool_budget(r) if r.framework==row.framework && rb.quota==b.quota && rb.ceiling!=nil {out.pools+=1 out.used+=rb.ceiling}}
    return out
}
A.pool_frame_name=fn(runtime){if runtime=="codex" {return "Codex"} if runtime=="claude" {return "Claude"} if runtime=="octos" {return "Octos"} return ""+runtime}
// One account-limit row per coding tool on the list, when the limit is known.
A.pool_account_rows=fn(){
    let out=[] let seen=[]
    for row in H.resources {
        let known={yes:false} for f in seen {if f==row.framework {known.yes=true}}
        if !known.yes {seen.push(row.framework) let a=A.pool_account_use(row) if a.quota!=nil {out.push(a)}}
    }
    return out
}
A.pool_renew_title=fn(v){
    let month=A.pool_next_month_name(v.now)
    if v.renewal!=nil {return A.t(month+" is published ahead",month+"额度已提前发布")}
    return A.t("Publish "+month+" ahead","提前发布 "+month+"额度")
}
A.pool_renew_text=fn(v){
    if v.renewal!=nil {
        let tokens=A.recipient_optional(v.renewal,"publishedTokens")
        return A.t("Per-request limit "+A.tokens(tokens)+", monthly maximum "+A.pool_carried(v)+" (same as this month), from "+A.pool_next_month(v.now)+". Running Agents carry on.","每次申请上限 "+A.tokens(tokens)+"，每月上限 "+A.pool_carried(v)+"（沿用本月），"+A.pool_next_month(v.now)+"起生效；使用中的 Agent 会接着用。")
    }
    return A.t("Per-request limit "+A.tokens(v.publishedTokens)+", monthly maximum "+A.pool_carried(v)+" (same as this month) and the same list, from "+A.pool_next_month(v.now)+". Running Agents don’t ask again. Open in the last 7 days of a month.","每次申请上限 "+A.tokens(v.publishedTokens)+"，每月上限 "+A.pool_carried(v)+"（沿用本月），名单不变，"+A.pool_next_month(v.now)+"起生效；使用中的 Agent 不用重新申请。每月最后 7 天可用。")
}
A.pool_carried=fn(v){return if v.b.ceiling==nil {A.t("none","未设置")} else {A.tokens(v.b.ceiling)}}
A.pool_renew=fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil {return}
    let v=A.pool_view(H.resource_detail)
    if !v.renewOpen || v.publishedTokens==nil {return}
    A.pool_succeed("renewal",v.publishedTokens,nil)
}
// After the monthly maximum went up: the per-request change to offer, or 0.
A.pool_offer_quota=fn(v){
    let r=H.pool_result
    if r==nil || A.recipient_optional(r,"raised")!=true || v.quotaMode!="amend" || v.publishedTokens==nil || v.b.ceiling==nil {return 0}
    let o=H.pool_offer
    let want=if o!=nil && o.rid==v.row.id {o.tokens} else {A.pool_quota_default(v.b.ceiling)}
    return if want>v.publishedTokens && want<=v.b.ceiling {want} else {0}
}
// Update the save row in place: re-rendering mid-drag would fight the slider.
A.pool_edit_refresh=fn(){
    if H.page!="resource_detail" {return}
    let s=A.pool_save_state()
    ui.pool_max_error.set_text(s.maxError) ui.pool_max_error.set_visible(s.maxError!="")
    ui.pool_quota_error.set_text(s.quotaError) ui.pool_quota_error.set_visible(s.quotaError!="")
    ui.pool_quota_draft.set_text(s.draft) ui.pool_quota_draft_row.set_visible(s.draft!="")
    let u=A.pool_unsaved()
    if s.maxMode!="locked" {ui.pool_max_unsaved.set_text(u.max) ui.pool_max_unsaved.set_visible(u.max!="") ui.pool_max_value.set_visible(u.max=="")}
    ui.pool_quota_unsaved.set_text(u.quota) ui.pool_quota_unsaved.set_visible(u.quota!="") ui.pool_quota_value.set_visible(u.quota=="")
    ui.alert_layer.render()
}
A.pool_max_changed=fn(text){let e=H.pool_edit if e==nil || H.busy || H.command!=nil {return} e.max=text e.unlimited=false H.pool_result=nil A.pool_edit_refresh()}
// The slider keeps a draft for the next publication; a month that can change now proposes instead.
A.pool_quota_changed=fn(text){
    let e=H.pool_edit
    if e==nil || H.busy || H.command!=nil {return}
    e.quota=text H.pool_result=nil
    let n=A.pool_whole(text)
    if n>=1 && A.pool_quota_drafts() {A.pool_draft_set(e.rid,n)}
    A.pool_edit_refresh()
}
A.pool_quota_drafts=fn(){
    if H.resource_detail==nil {return true}
    let mode=A.pool_view(H.resource_detail).quotaMode
    return mode!="amend" && mode!="scheduled"
}
A.pool_max_preset=fn(amount){
    let e=H.pool_edit
    if e==nil || H.busy || H.command!=nil {return}
    e.max=""+amount e.unlimited=false H.pool_result=nil A.redraw()
}
// "Pause sharing": clearing the maximum, confirmed natively like any other change.
A.pool_pause_sharing=fn(){
    let e=H.pool_edit
    if e==nil || H.busy || H.command!=nil {return}
    e.unlimited=true H.pool_result=nil A.redraw()
}
A.pool_revert=fn(){
    let e=H.pool_edit
    if e==nil || H.busy {return}
    e.max=e.maxBase e.unlimited=e.unlimitedBase H.pool_result=nil
    if H.resource_detail!=nil {let v=A.pool_view(H.resource_detail) if v.quotaMode=="amend" && v.publishedTokens!=nil {e.quota=""+v.publishedTokens}}
    A.redraw()
}
// Undo a draft for next month: back to this month's amount.
A.pool_quota_undo=fn(){
    let e=H.pool_edit
    if e==nil || H.busy || H.command!=nil || H.resource_detail==nil {return}
    let v=A.pool_view(H.resource_detail)
    if v.publishedTokens==nil {return}
    e.quota=""+v.publishedTokens e.quotaBase=e.quota
    A.pool_draft_set(e.rid,v.publishedTokens)
    H.pool_result=nil A.redraw()
}
A.pool_dirty=fn(){
    if H.page!="resource_detail" || H.resource_detail==nil {return false}
    return A.pool_save_state().dirty
}
A.pool_leaving=fn(after){
    if !A.pool_dirty() {return false}
    H.local_discard="pool" H.local_after=after A.redraw()
    return true
}
A.pool_back=fn(){if H.busy || A.pool_leaving("back") {return} if A.nav_back() {return} A.return_list("resources")}
A.pool_save=fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil || H.pool_edit==nil {return}
    let s=A.pool_save_state()
    if !s.enabled {A.pool_edit_refresh() return}
    let e=H.pool_edit
    H.pool_result=nil
    if s.maxDirty && e.unlimited {A.pool_clear_max() return}
    if s.maxDirty && s.maxMode=="amend" {A.pool_amend_max(A.pool_whole(e.max),if s.quotaMode=="amend" && s.quotaDirty {A.pool_whole(e.quota)} else {nil}) return}
    if s.maxDirty {A.pool_save_max(A.pool_whole(e.max)) return}
    if s.quotaEditable {A.pool_save_quota(A.pool_whole(e.quota)) return}
    if s.quotaMode=="amend" && s.quotaDirty {A.pool_succeed("amendment",A.pool_whole(e.quota),nil)}
}
// Monthly maximum before the pool is first offered: the configuration edit, confirmed natively.
A.pool_save_max=fn(tokens){
    if H.busy || H.command!=nil || H.resource_detail==nil {return}
    let row=H.resource_detail.resource
    let {editing={},ceiling=nil}=H.resource_detail
    let {allowed=false}=editing
    if allowed!=true {H.notice=A.resource_edit_error("management_resource_edit_not_available") A.redraw() return}
    if !(tokens>=0 && tokens<=9007199254740991) {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
    if ceiling!=nil && ceiling.period=="monthly" && ceiling.tokens==tokens {return}
    H.pool_before={rid:row.id max:if ceiling!=nil && ceiling.period=="monthly" {ceiling.tokens} else {nil}}
    A.submit("hagency.resources.edit",{resourceId:row.id expectedRevision:row.revision profile:{kind:"preserve"} ceiling:{kind:"monthly" tokens:tokens}})
}
// Monthly maximum of an offered pool: the native amendment, against the sequence the detail showed.
// quota, when set, is the per-request change to offer right after it.
A.pool_amend_max=fn(tokens,quota){
    if H.busy || H.command!=nil || H.resource_detail==nil {return}
    let row=H.resource_detail.resource
    let ceilingAmendment=A.recipient_optional(H.resource_detail,"ceilingAmendment")
    if !A.pool_amend_allowed(ceilingAmendment) {A.pool_say("max","attention",A.t("Not saved: ","没有保存：")+A.pool_max_reason(nil,ceilingAmendment)) return}
    if !(tokens>=1 && tokens<=9007199254740991) {A.pool_say("max","attention",A.t("Not saved: ","没有保存：")+A.resource_edit_error("invalid_management_arguments")) return}
    H.pool_offer=if quota==nil {nil} else {{rid:row.id tokens:quota}}
    let {ceiling=nil}=H.resource_detail
    H.pool_before={rid:row.id max:if ceiling!=nil {ceiling.tokens} else {nil}}
    A.submit("hagency.resources.edit",{resourceId:row.id expectedRevision:row.revision expectedCeilingSequence:A.recipient_optional(ceilingAmendment,"sequence") profile:{kind:"preserve"} ceiling:{kind:"monthly" tokens:tokens}})
}
// Per-request quota. A month that isn't published yet: propose the first grant's amount.
A.pool_save_quota=fn(tokens){
    let p=H.pool_info
    if p==nil || p.rid!=H.resource_id || p.grantState!="ready" {return}
    let rid=p.rid
    A.pool_propose(p.conn,p.grant,tokens,fn(cid,r){A.pool_quota_reply(rid,cid,r)})
}
// A published month: amend it now, or schedule next month in its last 7 days. The native
// panel opens pre-filled and the owner confirms there. applicants, when set, are pre-selected.
A.pool_succeed=fn(kind,tokens,applicants){
    let p=H.pool_info
    if H.busy || H.command!=nil || p==nil || p.rid!=H.resource_id || p.conn==nil || p.grantState!="ready" || H.session==nil {return}
    let c=p.conn
    if c.ownerMxid!=H.session.account || c.executorDeviceId!=H.session.device || c.state!="admitted" {return}
    if tokens!=nil && !(tokens>=1 && tokens<=9007199254740991) {return}
    let rid=p.rid let cid=c.id
    let args={contributionId:cid succession:kind}
    if tokens!=nil {args.proposedTokens=tokens}
    if applicants!=nil && applicants.len()>0 {args.applicants=applicants}
    H.pool_result=nil H.pool_offer=nil
    let before=A.pool_published_tokens(A.pool_effective_grant(c,p.grant,p.now))
    let view=if H.resource_detail==nil {nil} else {A.pool_view(H.resource_detail)}
    let given=if view==nil {nil} else {A.pool_floor(view)}
    let carried=if view==nil || view.b.ceiling==nil {nil} else {view.b.ceiling}
    let month=if view==nil {A.t("next month","下个月")} else {A.pool_next_month_name(view.now)}
    A.pool_call("hagency.grants.review",args,fn(g){A.pool_succeed_reply(rid,cid,kind,g,applicants,{before:before floor:given carried:carried month:month proposed:tokens})})
}
A.pool_succeed_reply=fn(rid,cid,kind,r,applicants,ctx){
    let note={v:nil}
    let at=if kind=="renewal" {"renew"} else {"quota"}
    if !r.is_ok {
        if r.error=="management_grant_succession_required" || r.error=="invalid_management_arguments" {H.pool_no_succession=true}
        let below=r.error=="owner_grant_below_floor" || r.error=="grant_successor_below_reserved"
        let why=if below && ctx.floor!=nil && ctx.proposed!=nil && ctx.proposed<ctx.floor {A.t("The per-request limit can’t go below the "+A.tokens(ctx.floor)+" given to running Agents.","每次申请上限不能低于已分给正在运行的 Agent 的 "+A.tokens(ctx.floor)+"。")} else if below && ctx.proposed!=nil {A.t("Running Agents were given more than "+A.tokens(ctx.proposed)+", and the per-request limit can’t go below that. The confirmation window shows the exact figure.","已分给正在运行的 Agent 的额度超过了 "+A.tokens(ctx.proposed)+"，每次申请上限不能低于它；确认窗口里有准确数字。")} else {A.pool_succession_error(r.error)}
        note.v={at:at tone:"attention" text:(if kind=="renewal" {A.t("Not published ahead: ","没有提前发布：")} else {A.t("Not saved: ","没有保存：")})+why}
    } else {
        // A renewal's summary is next month's; this month's list stays as it is.
        if kind=="amendment" {A.pool_keep_summary(cid,r.data)}
        let {state=nil,serverState=nil,summary=nil}=r.data
        let amount=if summary==nil {nil} else {A.pool_summary_tokens(summary)}
        if state=="review_closed" {note.v=nil}
        else if state=="server_observed" && serverState=="active" {note.v=if kind=="renewal" {{at:at tone:"running" text:A.t("Published ahead: "+ctx.month+", per-request limit "+A.tokens(amount)+(if ctx.carried!=nil {", monthly maximum "+A.tokens(ctx.carried)+" (same as this month)"} else {""}),"已提前发布："+ctx.month+"每次申请上限 "+A.tokens(amount)+(if ctx.carried!=nil {"，每月上限 "+A.tokens(ctx.carried)+"（沿用本月）"} else {""}))}} else {{at:at tone:"running" text:A.pool_saved_text("quota",if ctx.before!=amount {ctx.before} else {nil},amount)}}}
        else if state=="outcome_unknown" {note.v={at:at tone:"waiting" text:A.t("The result isn’t known yet. Refresh in a moment to check.","暂时无法确认结果，请稍后刷新查看。")}}
        else {note.v={at:at tone:"waiting" text:A.t("Saved on this computer; the server hasn’t confirmed it yet. Refresh in a moment.","已在这台电脑上保存，服务器还没确认。请稍后刷新。")}}
    }
    if H.resource_id!=rid {return}
    // Adding people from Who Can Request stays on that page, with its own result.
    if H.page=="pool_who" {
        if !r.is_ok && applicants!=nil {note.v={tone:"attention" text:A.t("Not added: ","没有添加：")+A.pool_succession_error(r.error)}}
        if r.is_ok && note.v!=nil && note.v.tone=="running" && applicants!=nil {
            let names={t:""} for i id in applicants {names.t=names.t+(if i>0 {A.t(", ","、")} else {""})+A.pool_person(id)}
            note.v={tone:"running" text:if applicants.len()==1 {A.t("Added who can request: "+names.t+". They can request now.","已添加可以申请的人："+names.t+"。对方现在就能申请。")} else {A.t("Added who can request: "+names.t+". They can request now.","已添加可以申请的人："+names.t+"。他们现在就能申请。")}}
            H.who.picks=[]
        }
        H.pool_result=note.v A.redraw() return
    }
    H.pool_saved=if note.v==nil {nil} else {{rid:rid at:note.v.at tone:note.v.tone text:note.v.text}}
    H.pool_edit=nil
    A.open_resource(rid)
}
// Plain words for every refusal of a change to a published month.
A.pool_succession_error=fn(code){
    if code=="management_grant_succession_required" || code=="pool_grant_succession_unavailable" {return A.t("This server can’t change a published month yet. Change the per-request limit for next month instead; it applies when you next publish.","这个服务器还不能修改已发布的月份。可以先调整下个月的每次申请上限，下次发布时生效。")}
    if code=="invalid_management_arguments" {return A.t("Hagency on this computer needs an update to change a published month. Until then, changes apply when you next publish.","这台电脑上的 Hagency 需要更新，才能修改已发布的月份。在那之前，改动在下次发布时生效。")}
    if code=="owner_grant_predecessor_required" {return A.t("This month’s publication isn’t on this computer, so it can only change on the computer that published it.","本月的发布记录不在这台电脑上，只能在原来发布的电脑上修改。")}
    if code=="owner_grant_succession_pending" {return A.t("An earlier change is still being confirmed. Try again in a moment.","上一次修改还在确认中，请稍后再试。")}
    if code=="owner_grant_successor_exists" || code=="grant_successor_exists" {return A.t("Next month is already published ahead, so this month can’t change now.","下个月的额度已经提前发布，本月不能再改。")}
    if code=="owner_grant_renewal_window_closed" || code=="grant_succession_window_closed" {return A.t("Next month can only be published ahead in the last 7 days of this month.","只有每月最后 7 天可以提前发布下个月的额度。")}
    if code=="owner_grant_below_floor" || code=="grant_successor_below_reserved" {return A.t("The per-request limit can’t go below what running Agents were given.","每次申请上限不能低于已分给正在运行的 Agent 的额度。")}
    if code=="owner_grant_manager_removed" {return A.t("Accounts can be added to the list, not removed, until the month ends.","月底前，名单只能添加账号，不能删掉已有的账号。")}
    if code=="owner_grant_capacity_unavailable" {return A.t("The monthly maximum doesn’t have room for that. Raise the monthly maximum first.","每月上限不够，请先调高每月上限。")}
    if code=="grant_predecessor_not_effective" {return A.t("This month’s publication has already ended. Publish this month again instead.","本月的发布已经结束，请重新发布本月额度。")}
    return A.pool_grant_error(code)
}
// Plain words for every refusal of a monthly-maximum change; nothing is written by any of them.
A.ceiling_refusal=fn(code,detail){
    let amend=if detail==nil {nil} else {A.recipient_optional(detail,"ceilingAmendment")}
    let least=if amend==nil {nil} else {A.recipient_optional(amend,"minimumTokens")}
    let now=if detail==nil {nil} else {A.recipient_optional(detail,"ceiling")}
    let current=if now==nil {nil} else {A.recipient_optional(now,"tokens")}
    let no=A.t("Not saved: ","没有保存：")
    if code=="management_resource_edit_changed" {return no+A.t("the pool changed a moment ago. It’s been refreshed; try again.","资源池刚刚有变化，已经刷新，请再试一次。")}
    if code=="management_ceiling_amendment_not_available" {return no+A.t("the monthly maximum can’t change here right now. The reason is shown under Monthly maximum.","现在不能在这里调整每月上限，原因写在「每月上限」下面。")}
    if code=="management_ceiling_clear_refused" {return no+(if least!=nil && least>1 {A.t("an offered pool keeps a monthly maximum. Lower it to no less than "+A.tokens(least)+", or stop some Agents.","已连接服务器的资源池不能取消每月上限。可以调低到不低于 "+A.tokens(least)+"，或停止部分 Agent。")} else {A.t("an offered pool keeps a monthly maximum. Lower it instead, or stop some Agents.","已连接服务器的资源池不能取消每月上限。可以调低它，或停止部分 Agent。")})}
    if code=="management_ceiling_unchanged" {return no+(if current!=nil {A.t("that’s the current maximum, "+A.tokens(current)+".","和现在的每月上限 "+A.tokens(current)+" 一样。")} else {A.t("that’s the current maximum.","和现在的每月上限一样。")})}
    if code=="management_ceiling_below_commitments" {return no+(if least!=nil && least>1 {A.t("the monthly maximum can’t go below the "+A.tokens(least)+" committed this month.","每月上限不能低于本月已承诺的 "+A.tokens(least)+"。")} else {A.t("the monthly maximum can’t go below what’s committed this month.","每月上限不能低于本月已承诺的额度。")})}
    if code=="management_ceiling_usage_unsettled" {return no+(if current!=nil {A.t("use is still being counted, so for now it can only go above "+A.tokens(current)+".","用量还在统计中，现在只能调到 "+A.tokens(current)+" 以上。")} else {A.t("use is still being counted, so for now it can only go up.","用量还在统计中，现在只能调高。")})}
    return no+A.resource_edit_error(code)
}
// Publishes this month's capacity for an admitted pool without a live grant:
// the native panel opens pre-filled and the owner confirms there. The checks
// are A.owner_grant's; a proposal is never sent with an intentId.
A.pool_propose=fn(c,grant,tokens,reply){
    if H.busy || H.command!=nil || c==nil || grant==nil || H.session==nil {return}
    if c.ownerMxid!=H.session.account || c.executorDeviceId!=H.session.device || c.state!="admitted" || grant.id!=c.id || grant.ownerMxid!=H.session.account {return}
    let id=c.id
    let {publishedTokens=nil}=grant
    if publishedTokens!=nil {reply(id,{is_ok:false error:"pool_grant_already_published"}) A.redraw() return}
    if !(tokens>=1 && tokens<=9007199254740991) {return}
    A.pool_call("hagency.onboarding.status",{},fn(r){
        if !r.is_ok {reply(id,r) return}
        H.onboarding=r.data
        let {grantReviewAvailable=false}=r.data
        if grantReviewAvailable!=true {reply(id,{is_ok:false error:"pool_grant_device_required"}) return}
        let args={contributionId:id proposedTokens:tokens}
        let picks=A.who_picks(c.resourceId)
        if picks!=nil {args.applicants=picks}
        A.pool_call("hagency.grants.review",args,fn(g){
            // A desktop without pre-selection refuses the field: open the window without it.
            if !g.is_ok && g.error=="invalid_management_arguments" && picks!=nil {
                H.pool_no_applicants=true
                A.pool_call("hagency.grants.review",{contributionId:id proposedTokens:tokens},fn(again){reply(id,again)})
                return
            }
            reply(id,g)
        })
    })
}
// The pool list's primary action for a pool without this month's grant.
A.pool_publish_row=fn(row){
    let m=H.pool_meta
    if H.busy || H.command!=nil || m==nil {return}
    let s=A.pool_row(row)
    if !s.lapsed {return}
    let b=A.pool_budget(row)
    let last=A.pool_last_limit(s.conn.id)
    let stored=A.pool_draft_get(row.id)
    let pick=if stored!=nil {stored} else if last!=nil {last} else {A.pool_quota_default(b.ceiling)}
    let tokens=if b.ceiling!=nil && b.ceiling>0 && pick>b.ceiling {b.ceiling} else {pick}
    let title=A.resource_title(row)
    H.pool_list_result=nil
    A.pool_propose(s.conn,s.grant,tokens,fn(cid,r){
        if H.page!="resources" {return}
        if r.is_ok {A.pool_keep_summary(cid,r.data)}
        H.pool_list_result=A.pool_publish_result(title,r)
        A.pool_meta_load()
    })
}
A.pool_publish_result=fn(title,r){
    if !r.is_ok {return {tone:"attention" text:A.t("Not published: "+title+". ","没有发布：「"+title+"」。")+A.pool_grant_error(r.error)}}
    let {state=nil,serverState=nil,summary=nil}=r.data
    if state=="review_closed" {return nil}
    if state=="server_observed" && serverState=="active" {
        let amount=if summary==nil {nil} else {summary.allocatedTokens}
        return {tone:"running" text:A.t("Published: "+title+", per-request limit "+A.tokens(amount)+". Agents can request it now.","已发布：「"+title+"」，每次申请上限 "+A.tokens(amount)+"，Agent 现在可以申请。")}
    }
    if state=="outcome_unknown" {return {tone:"waiting" text:title+A.t(": the result isn’t known yet. Refresh in a moment.","：暂时无法确认结果，请稍后刷新查看。")}}
    return {tone:"waiting" text:title+A.t(": an existing grant was shown; nothing new was published.","：已显示现有授权，没有发布新的额度。")}
}
A.pool_quota_reply=fn(rid,cid,r){
    if H.resource_id!=rid {return}
    let e=H.pool_edit
    if !r.is_ok {
        A.pool_say("quota","attention",A.t("Not published: ","没有发布：")+A.pool_grant_error(r.error))
        A.pool_info_load(rid) return
    }
    let {state=nil,serverState=nil,summary=nil}=r.data
    A.pool_keep_summary(cid,r.data)
    if state=="review_closed" {return}
    if state=="server_observed" && serverState=="active" {
        let amount=if summary==nil {nil} else {summary.allocatedTokens}
        A.pool_say("quota","running",A.t("Published: per-request limit "+A.tokens(amount)+". Agents can request it now.","已发布：每次申请上限 "+A.tokens(amount)+"，Agent 现在可以申请。"))
        A.pool_info_load(rid) return
    }
    if state=="outcome_unknown" {A.pool_say("quota","waiting",A.t("The result isn’t known yet. Refresh in a moment to check.","暂时无法确认结果，请稍后刷新查看。")) A.pool_info_load(rid) return}
    A.pool_say("quota","waiting",A.t("Not published: the existing publication was shown, and the new limit wasn’t applied.","没有发布：窗口里显示的是已有的发布，新的上限没有生效。"))
    A.pool_info_load(rid)
}
// Publishes this month with the slider's per-request limit (also behind Applicants).
A.pool_publish_quota=fn(){
    let e=H.pool_edit
    if e==nil || H.busy || H.command!=nil {return}
    let s=A.pool_save_state()
    if !s.quotaEditable || s.quotaError!="" {A.pool_edit_refresh() return}
    H.pool_result=nil
    A.pool_save_quota(A.pool_whole(e.quota))
}
// Opens this pool's publication natively without proposing an amount.
A.pool_open_grant=fn(){
    let p=H.pool_info
    if H.busy || H.command!=nil || p==nil || p.rid!=H.resource_id || p.conn==nil {return}
    let c=p.conn
    if c.ownerMxid!=H.session.account || c.executorDeviceId!=H.session.device || c.state!="admitted" || p.grantState!="ready" || p.grant==nil {return}
    let id=c.id let rid=p.rid let published=A.pool_published(c,p.grant)
    A.pool_call("hagency.onboarding.status",{},fn(r){
        if !r.is_ok {H.pool_result={tone:"attention" text:A.onboarding_reason(r.error)} return}
        H.onboarding=r.data
        let {grantReviewAvailable=false,grantIntents=[]}=r.data
        if grantReviewAvailable!=true {H.pool_result={tone:"attention" text:A.t("Open this grant on its original execution device.","请在原执行设备上查看此授权。")} return}
        let selector=nil
        for intent in grantIntents {if intent.contributionId==id {selector={intentId:intent.intentId}}}
        if selector==nil && published {H.pool_result={tone:"waiting" text:A.t("This pool is published, but its grant record isn’t on this device. Nothing was changed.","此资源池已发布，但此设备上没有它的授权记录。没有做任何更改。")} return}
        if selector==nil {selector={contributionId:id}}
        A.pool_call("hagency.grants.review",selector,fn(g){
            if H.resource_id!=rid {return}
            if !g.is_ok {H.pool_result={tone:"attention" text:A.pool_grant_error(g.error)} return}
            A.pool_keep_summary(id,g.data)
            if H.page=="resource_detail" {A.pool_info_load(rid)}
        })
    })
}
A.pool_grant_error=fn(code){
    if code=="pool_grant_already_published" {return A.error_text(code)}
    if code=="pool_grant_device_required" {return A.t("This computer can’t publish now. Open This Computer at the bottom of Resource Pools, or use the computer that published before.","这台电脑现在不能发布。请在「资源池」底部的「这台电脑」里处理，或在原来发布的电脑上操作。")}
    if code=="owner_grant_prior_intent_required" {return A.readmission_error(code)}
    if code=="owner_source_adoption_required" || code=="management_outcome_unknown" || code=="onboarding_unavailable" {return A.onboarding_reason(code)}
    return A.error_text(code)
}
// A busy request whose callback also sees failures, for pages that explain them inline.
A.pool_call=fn(service,args,done){
    if H.busy {return}
    H.busy=true H.notice="" A.redraw()
    host.request(service,args,fn(r){
        H.busy=false
        if !r.is_ok && (r.error=="native_resume_missing" || r.error=="native_resume_revoked") {H.needs_signin=true}
        done(r)
        A.redraw()
    })
}
// Where a value sits on a slider whose top is the bound, or a 10 M scale.
A.pool_slider_ratio=fn(value,top){
    if value==nil || value<=0 {return 0}
    let scale=if top!=nil && top>0 {top} else {max(10000000,value)}
    return max(0,min(1,value/scale))
}
A.pool_count_text=fn(n){return if n==-2 {A.t("Unavailable","无法读取")} else if n<0 {""} else {""+n}}
A.pool_yolo_label=fn(yolo){return if yolo {A.t("Full trust (unrestricted)","完全信任（不受限）")} else {A.t("Standard","标准权限")}}
// The segment is half a phone width: at large text the note below carries "(unrestricted)".
A.pool_yolo_segment=fn(){return if mod.widgets.RINX_TEXT_SCALE>1.2 {A.t("Full trust","完全信任")} else {A.pool_yolo_label(true)}}
A.pool_default_policy=fn(){
    if H.busy || H.resource_detail==nil {return}
    A.dpol_open(H.resource_detail.resource.id)
}
A.pool_server_text=fn(v){
    if v.connState=="loading" {return ""}
    if v.connState=="error" {return A.t("Unavailable","无法读取")}
    if v.conn==nil {return A.t("Not connected","未连接")}
    if v.conn.state=="pending_admission" {return A.t("Waiting for approval","等管理员批准")}
    if v.conn.state!="admitted" {return A.state_text(v.conn.state)}
    if v.published {return A.t("Published","已发布")}
    return A.t("Not published this month","本月未发布")
}
// Publication steps for a pool that is not live yet: connect, approval, publish.
A.pool_banner=fn(v){
    let none={kind:"" title:"" text:"" step:0 action:""}
    if v.connState=="loading" {return none}
    if v.connState=="error" {return {kind:"error" title:A.t("Couldn’t read the server connection","暂时无法读取服务器连接") text:A.t("Status and limits may be out of date.","状态和额度可能不是最新的。") step:0 action:A.t("Try Again","重试")}}
    if v.conn==nil {return {kind:"connect" title:A.t("Not connected to a server yet","还没有连接服务器") text:A.t("Connect it, wait for the administrator to approve, then publish. Agents can request it after that.","连接服务器、等管理员批准后发布，Agent 就能申请了。") step:1 action:A.t("Connect to Server","连接服务器")}}
    if v.conn.state=="pending_admission" {return {kind:"pending" title:A.t("Waiting for the administrator","等服务器管理员批准") text:A.t("Once approved, check the per-request limit below and publish.","批准后，确认下方的每次申请上限并发布。") step:2 action:A.t("View Connection","查看连接")}}
    if v.conn.state!="admitted" {return {kind:"closed" title:A.t("Server connection closed","服务器连接已关闭") text:A.t("Request admission again before publishing.","重新连接服务器后才能发布。") step:1 action:A.t("Server and Publishing","服务器与发布")}}
    if v.grantState=="loading" || v.published {return none}
    if v.grantState!="ready" {return {kind:"error" title:A.t("Couldn’t confirm what is published","暂时无法确认发布状态") text:A.t("Try again before changing the limit.","请重试后再修改额度。") step:0 action:A.t("Try Again","重试")}}
    if v.boardState=="ready" && !v.deviceReady {let dev=A.pool_device_state(v.board,"ready") return {kind:"device" title:if dev.fix {A.t("This computer isn’t set up yet","这台电脑还没设置完")} else {A.t("This computer can’t publish now","这台电脑现在不能发布")} text:if dev.fix {A.t("Finish setting it up, then publish this month’s capacity here.","设置好之后，就能在这里发布本月额度。")} else {dev.detail} step:0 action:if dev.fix {A.t("Continue Setting Up This Computer","继续设置这台电脑")} else {A.t("See Why","查看原因")}}}
    return {kind:"month" title:A.t("Not published this month","本月未发布") text:A.t("Check the per-request limit below and publish; then Agents can request it.","确认下方的每次申请上限并发布后，Agent 就能申请。") step:3 action:""}
}
A.pool_banner_action=fn(kind){
    if H.busy || H.resource_detail==nil {return}
    if kind=="error" {A.pool_info_retry() return}
    if kind=="device" {A.dev_fix("pool",if H.pool_info==nil {nil} else {H.pool_info.board}) return}
    A.resource_connection(H.resource_detail.resource)
}
// Review 3, Track A: drafts, counts, this device and the pool's own subpages.
A.pool_enqueue_run=fn(epoch,run){
    if epoch!=H.pool_epoch {return}
    H.pool_jobs.push({service:"" args:{} apply:nil run:run})
    A.pool_pump(epoch)
}
A.pool_part=fn(n){return if n==nil {-2} else {n}}
A.pool_tools_count=fn(t){return if t.complete || t.pending>0 {t.pending} else {-2}}
// A badge over parts that may be unreadable (-2): their sum, or -2 when nothing readable is waiting.
A.pool_badge_sum=fn(a,b,c){
    let n=max(0,a)+max(0,b)+max(0,c)
    return if n==0 && (a==-2 || b==-2 || c==-2) {-2} else {n}
}
A.pool_badge_sum5=fn(a,b,c,d,e){return max(0,a)+max(0,b)+max(0,c)+max(0,d)+max(0,e)}
A.pool_badge_text=fn(n){return if n==-2 {"—"} else {""+n}}
A.pool_counts_unknown=fn(v){return v.requests==-2 || v.alerts==-2 || v.stopped==-2 || v.workspaces==-2 || v.tools==-2 || v.agents==-2}
// What waits on a pool, as small pills: requests, alerts, tool approvals, tasks, workspaces.
A.pool_attention_pills=fn(s){
    let out=[]
    if s.requests>0 {out.push({text:A.t("Requests "+s.requests,"申请 "+s.requests) tone:"waiting"})}
    if s.alerts>0 {out.push({text:A.t("Alerts "+s.alerts,"告警 "+s.alerts) tone:"attention"})}
    if s.tools>0 {out.push({text:A.t("Tools "+s.tools,"工具 "+s.tools) tone:"waiting"})}
    if s.stopped>0 {out.push({text:A.t("Tasks "+s.stopped,"中断任务 "+s.stopped) tone:"waiting"})}
    if s.workspaces>0 {out.push({text:A.t("Workspaces "+s.workspaces,"工作区 "+s.workspaces) tone:"waiting"})}
    if s.unknown {out.push({text:A.t("Some unread","部分无法读取") tone:""})}
    return out
}
A.pool_attention_text=fn(s){
    let parts=[]
    if s.requests>0 {parts.push(A.t("requests ","申请 ")+s.requests)}
    if s.alerts>0 {parts.push(A.t("alerts ","告警 ")+s.alerts)}
    if s.tools>0 {parts.push(A.t("tools ","工具 ")+s.tools)}
    if s.stopped>0 {parts.push(A.t("tasks ","任务 ")+s.stopped)}
    if s.workspaces>0 {parts.push(A.t("workspaces ","工作区 ")+s.workspaces)}
    let out={t:""}
    for i part in parts {out.t=out.t+(if i>0 {" · "} else {""})+part}
    if s.badge>0 {return A.t(""+s.badge+" to handle: ",""+s.badge+" 项待处理：")+out.t+(if s.unknown {A.t(" · some couldn’t be read"," · 部分信息暂时无法读取")} else {""})}
    if s.unknown {return A.t("Some information couldn’t be read","部分信息暂时无法读取")}
    return ""
}
// This computer: it publishes pools only when its setup is active and it holds the grant record.
// fix is true when the native setup review can run now ("Continue Setting Up").
A.pool_device_state=fn(board,load){
    let s={key:"loading" text:A.t("Checking…","正在检查…") tone:"" detail:A.t("Checking whether this computer can publish pools.","正在检查这台电脑能否发布资源池。") open:0 fix:false}
    if load=="error" {s.key="error" s.text=A.t("Unavailable","无法读取") s.detail=A.t("This computer’s status couldn’t be read. Try again.","暂时无法读取这台电脑的状态，请重试。") return s}
    if load!="ready" || board==nil {return s}
    let {state=nil,grantReviewAvailable=false,grantIntents=[],canReview=false,reason=nil}=board
    s.open=grantIntents.len()
    if state=="active" && grantReviewAvailable==true {s.key="ready" s.text=A.t("Ready","已就绪") s.tone="running" s.detail=A.t("This computer can publish pools.","这台电脑可以发布资源池。") return s}
    s.key="attention" s.tone="waiting"
    s.fix=canReview==true && state!="active"
    s.text=if s.fix {A.t("Not set up","还没设置完")} else {A.t("Can’t publish","不能发布")}
    s.detail=A.t("This computer can’t publish pools right now. Quit and reopen Hagency, then check again; if it still can’t, publish from the computer that published before.","这台电脑现在不能发布资源池。退出并重新打开 Hagency 后再看一次；还不行，就在原来发布的电脑上操作。")
    if state=="legacy" {s.detail=A.t("This computer still has data from an older version. Set it up once to publish pools; your pools and records are kept.","这台电脑上还有旧版本的数据，设置一次后才能发布资源池。资源池和记录都会保留。")}
    if state=="recovery_required" {s.detail=A.t("The last setup didn’t finish. Continue it to publish pools; it picks up where it stopped.","上次的设置没有完成。继续设置后才能发布资源池，会从停下的地方接着做。")}
    if state=="unavailable" {s.detail=A.t("This version can’t set up pools on this computer. Existing pools stay as they are.","此版本还不能在这台电脑上设置资源池。已有资源池保持不变。")}
    if reason=="source_adoption_inventory_unsupported" {s.detail=A.t("This computer’s older data can’t be brought into this version yet, so it can’t publish pools. Nothing was changed.","这台电脑上的旧数据还不能转到这个版本，所以暂时不能在这里发布资源池。没有改动任何东西。")}
    if reason=="empty_device_history_not_empty" {s.detail=A.t("This computer already has accounts or records, so it can’t be set up as new. Use the computer that published before.","这台电脑上已有账号或记录，不能按新电脑设置。请在原来发布的电脑上操作。")}
    if reason=="source_adoption_platform_unqualified" {s.detail=A.t("This computer’s system can’t run pools yet.","这台电脑的系统暂时不能运行资源池。")}
    return s
}
A.pool_device_open=fn(from){A.dev_open("pool_device",from)}
A.pool_device_load=fn(){
    let d=H.pool_device
    d.state="loading" d.error=""
    let started=A.sub_read("hagency.onboarding.status",{},fn(data){d.board=data d.state="ready"},fn(code){d.state="error" d.error=code})
    if !started {d.state="error" d.error="management_busy" A.redraw()}
}
A.pool_device_migrate=fn(){A.dev_open("pool_device_move",nil)}
A.pool_device_recover=fn(){A.dev_open("pool_device_tasks",nil)}
A.pool_device_back=fn(){
    if H.busy {return}
    if H.page!="pool_device" {A.dev_open("pool_device",nil) return}
    let from=H.pool_device_from
    if from=="pool" && H.resource_id!="" {A.open_resource(H.resource_id) return}
    if from=="create" {A.pool_create_open() return}
    if from=="accounts" {A.open_accounts(nil) return}
    A.return_list("resources")
}
A.pool_device_label=fn(){
    if H.page!="pool_device" {return A.t("This Computer","这台电脑")}
    if H.pool_device_from=="create" {return A.t("New Pool","新建资源池")}
    if H.pool_device_from=="accounts" {return A.t("Coding Tools","编码工具")}
    return A.t("Pools","资源池")
}
// This computer's pages: the hub, its setup steps, moving to a new computer,
// and the work a restart or a dropped connection interrupted, across every pool.
A.dev_page=fn(){return A.has_page(["pool_device","pool_device_setup","pool_device_move","pool_device_tasks"])}
A.dev_title=fn(page){
    if page=="pool_device_setup" {return A.t("Getting Started","上手步骤")}
    if page=="pool_device_move" {return A.t("Move to a New Computer","迁移到新电脑")}
    if page=="pool_device_tasks" {return A.t("Pick Up Interrupted Tasks","接回中断的任务")}
    return A.t("This Computer","这台电脑")
}
A.dev_open=fn(page,from){
    if H.busy {return}
    if from!=nil {H.pool_device_from=from}
    if page=="pool_device" {H.dev.result=nil}
    H.page=page H.notice="" H.bar_past=false
    if page=="pool_device_tasks" {A.dev_tasks_load() A.redraw() return}
    A.dev_pools_ensure()
    A.pool_device_load()
}
// Opened from Coding Tools, the pool list may not be read yet: read it (and what is published)
// before counting pools, so the page never says there are none while they load.
A.dev_pools_ensure=fn(){
    if H.session==nil {return}
    if H.owner.poolsReady {if H.pool_meta==nil {A.pool_meta_load()} return}
    host.request("hagency.resources.list",{after:"" limit:16},fn(r){
        if !r.is_ok || H.owner.poolsReady || !A.dev_page() {return}
        let {resources=nil,nextAfter=nil}=r.data
        if resources==nil {return}
        H.resources=resources H.resource_after=nextAfter H.owner.poolsReady=true
        A.pool_meta_load()
        A.redraw()
    })
}
// Runs the native setup review directly, for "Continue Setting Up" wherever it is offered.
// origin: "list", "pool" or "hub"; the result is said on that page.
A.dev_setup=fn(origin){
    if H.busy || H.command!=nil {return}
    let say=fn(tone,text){
        let note=if text=="" {nil} else {{tone:tone text:text}}
        if origin=="list" {H.pool_list_result=note A.pool_meta_load() return}
        if origin=="pool" {H.pool_result=note if H.resource_id!="" {A.pool_info_load(H.resource_id)} return}
        H.dev.result=note A.pool_device_load()
    }
    A.pool_call("hagency.onboarding.status",{},fn(r){
        if !r.is_ok {say("attention",A.read_error(r.error)) return}
        H.pool_device.board=r.data H.pool_device.state="ready"
        let s=A.pool_device_state(r.data,"ready")
        if s.key=="ready" {say("running",A.t("This computer is set up and can publish pools.","这台电脑已经设置好，可以发布资源池。")) return}
        if !s.fix {if origin=="hub" {say("waiting",s.detail)} else {A.dev_open("pool_device",origin)} return}
        A.pool_call("hagency.onboarding.review",{},fn(g){
            if !g.is_ok {say("attention",A.dev_setup_error(g.error)) return}
            let {state=nil}=g.data
            if state=="active" {say("running",A.t("Set up. This computer can publish pools now.","设置完成。这台电脑现在可以发布资源池。")) return}
            if state=="review_closed" {say("waiting",A.t("The confirmation window was closed; nothing changed.","已关闭确认窗口，没有改动任何东西。")) return}
            if state=="outcome_unknown" {say("waiting",A.t("It isn’t known yet whether setup finished. Tap Continue Setting Up again in a moment; it won’t run twice.","暂时不知道设置是否完成。稍后再点「继续设置这台电脑」查看，不会重复设置。")) return}
            say("waiting",A.t("Setup isn’t finished yet. Tap Continue Setting Up to go on.","设置还没完成，点「继续设置这台电脑」接着做。"))
        })
    })
}
A.dev_setup_error=fn(code){
    if code=="management_scope_changed" || code=="management_access_required" {return A.t("Your account changed. Reopen Hagency from your account, then try again.","账号已变化。请从你的账号重新打开 Hagency 后再试。")}
    if code=="onboarding_unavailable" {return A.t("This version can’t set up pools on this computer.","此版本还不能在这台电脑上设置资源池。")}
    return A.read_error(code)
}
// The banners' "Continue Setting Up": run the review when it can run, else show why on the hub.
A.dev_fix=fn(origin,board){
    let s=A.pool_device_state(board,if board==nil {"loading"} else {"ready"})
    if s.fix {A.dev_setup(origin) return}
    A.dev_open("pool_device",origin)
}
// The setup steps, from what this page and the pool list already read.
A.dev_steps=fn(){
    let d=H.pool_device
    let device=A.pool_device_state(d.board,d.state)
    let m=H.pool_meta
    let s={device:device pools:H.resources.len() pending:-1 admitted:-1 unpublished:-1 published:-1 left:0 loading:!H.owner.poolsReady || m==nil || ((m.conns==nil || m.grants==nil) && !m.connsError && !m.grantsError)}
    if m!=nil && m.conns!=nil {
        s.pending=0 s.admitted=0
        for c in m.conns {if A.pool_mine(c) {if c.state=="pending_admission" {s.pending+=1} if c.state=="admitted" {s.admitted+=1}}}
    }
    if m!=nil && m.conns!=nil && m.grants!=nil {
        s.unpublished=0 s.published=0
        for row in H.resources {let r=A.pool_row(row) if r.lapsed {s.unpublished+=1} if r.status.key=="published" || r.status.key=="low" {s.published+=1}}
    }
    if device.key!="ready" {s.left+=1}
    if s.pools==0 {s.left+=1}
    if s.pending>0 {s.left+=1}
    if s.unpublished>0 {s.left+=1}
    return s
}
A.dev_step_pill=fn(done,text){return {text:text tone:if done {"running"} else {"waiting"}}}
// The getting-started row: the computer's own state first, then pools still to finish.
A.dev_setup_summary=fn(){
    let s=A.dev_steps()
    if s.device.key=="loading" || s.device.key=="error" {return {text:s.device.text tone:s.device.tone line:A.t("Coding tool, joining a server, publishing","接入编码工具、连接服务器、发布")}}
    if s.device.key!="ready" {return {text:s.device.text tone:"waiting" line:if s.device.fix {A.t("This computer isn’t set up yet","这台电脑还没设置好")} else {A.t("This computer can’t publish pools now","这台电脑现在不能发布资源池")}}}
    if s.loading {return {text:A.t("Reading…","正在读取…") tone:"" line:A.t("This computer is set up · reading your pools…","这台电脑已设置好 · 正在读取资源池…")}}
    let pools=max(0,s.pending)+max(0,s.unpublished)
    if s.pools==0 {return {text:A.t("Create a pool","新建资源池") tone:"waiting" line:A.t("This computer is set up · no pool yet","这台电脑已设置好 · 还没有资源池")}}
    if pools==0 {return {text:A.t("Done","已完成") tone:"running" line:A.t("This computer is set up · every pool is published","这台电脑已设置好 · 资源池都已发布")}}
    return {text:A.t(""+pools+(if pools==1 {" pool to finish"} else {" pools to finish"}),""+pools+" 个资源池待处理") tone:"waiting" line:A.t("This computer is set up · some pools need a step","这台电脑已设置好 · 还有资源池要处理")}
}
// Interrupted tasks of every pool on this computer, and Agents whose process can be restarted.
A.dev_tasks_load=fn(){
    let d=H.dev
    d.taskEpoch=d.taskEpoch+1
    let epoch=d.taskEpoch
    d.taskState="loading" d.taskError="" d.tasks=[] d.failed=[] d.pools=[] d.more=false d.exec=nil d.execState="loading" d.execError=""
    host.request("hagency.resources.list",{after:"" limit:16},fn(r){
        if d.taskEpoch!=epoch {return}
        if !r.is_ok {d.taskState="error" d.taskError=r.error A.redraw() A.dev_exec_load(epoch) return}
        let {resources=nil}=r.data
        if resources==nil {d.taskState="error" d.taskError="management_invalid_result" A.redraw() A.dev_exec_load(epoch) return}
        for row in resources {if d.pools.len()<16 {d.pools.push(row)}}
        A.dev_tasks_step(epoch,0)
    })
}
A.dev_tasks_step=fn(epoch,i){
    let d=H.dev
    if d.taskEpoch!=epoch {return}
    if i>=d.pools.len() {d.taskState="ready" A.redraw() A.dev_exec_load(epoch) return}
    let pool=d.pools[i]
    host.request("hagency.stopped.list",{resourceId:pool.id workspaceId:"" after:""},fn(r){
        if d.taskEpoch!=epoch {return}
        let rows=if r.is_ok {A.health_rows("stopped",r.data,pool.id,"")} else {nil}
        if rows==nil {d.failed.push(A.resource_title(pool))} else {
            for row in rows {d.tasks.push({row:row pool:A.resource_title(pool)})}
            let {nextAfter=nil}=r.data
            if nextAfter!=nil {d.more=true}
        }
        A.dev_tasks_step(epoch,i+1)
    })
}
A.dev_exec_load=fn(epoch){
    let d=H.dev
    host.request("hagency.execution.assignments",{},fn(r){
        if d.taskEpoch!=epoch {return}
        if !r.is_ok {d.execState="error" d.execError=r.error A.redraw() return}
        let {supported=false,items=[]}=r.data
        d.exec=r.data d.execState=if supported==true {"ready"} else {"unsupported"}
        A.redraw()
        // After a restart, the updated row and its result are brought into view together.
        if A.recipient_optional(d,"resultScroll")==true {d.resultScroll=false start_timeout(0.3,||{if H.page=="pool_device_tasks" && H.dev.result!=nil {ui.content.scroll_to("pool_device_runs_label")}})}
    })
}
A.dev_ready_count=fn(){let n={c:0} for t in H.dev.tasks {let {inspectionAvailable=false,sharedResourceAuthority=false}=t.row if inspectionAvailable==true && sharedResourceAuthority==true {n.c=n.c+1}} return n.c}
A.dev_exec_rows=fn(){
    let out=[]
    if H.dev.execState!="ready" || H.dev.exec==nil {return out}
    let {items=[]}=H.dev.exec
    for row in items {out.push(row)}
    return out
}
A.dev_exec_action=fn(id,resume){
    if H.busy || H.command!=nil {return}
    let found={row:nil}
    for row in A.dev_exec_rows() {if row.assignmentId==id {found.row=row}}
    let row=found.row
    if row==nil || (resume && !row.savedStart) {return}
    let name=row.agentName
    A.pool_call(if resume {"hagency.execution.resume"} else {"hagency.execution.review"},{assignmentId:id},fn(r){
        H.dev.result=if r.is_ok {A.dev_exec_result(r.data,name)} else {{tone:"attention" text:A.t(name+" wasn’t restarted: ",A.sub_join(name,"没有重新启动："))+A.execution_reason(r.error)}}
        H.dev.resultScroll=true
        A.dev_tasks_load()
    })
}
A.dev_exec_result=fn(data,name){
    let {state=nil,result=nil,progress=nil}=data
    if state=="review_closed" {return {tone:"waiting" text:A.t("The confirmation window was closed; "+name+" wasn’t started.","已关闭确认窗口，"+name+" 没有启动。")}}
    if state=="outcome_unknown" {return {tone:"waiting" text:A.t("It isn’t known yet whether "+name+" started. Refresh in a moment; if it still isn’t running, use Other Ways › Continue the last start (it won’t start twice).","暂时不知道 "+name+" 有没有启动。稍后刷新；如果还没运行，用「其他办法 › 接着上次的启动」，不会多启动一个。")}}
    let p={v:progress}
    if result!=nil {
        let rs=A.recipient_optional(result,"state")
        if rs=="no_saved_intent" {return {tone:"waiting" text:A.t("There was no earlier start to continue; "+name+" wasn’t started.","没有可以接着的上次启动，"+name+" 没有启动。")}}
        if rs=="resumed" {p.v=A.recipient_optional(result,"progress")}
    }
    if p.v!=nil {
        let ps=A.recipient_optional(p.v,"state")
        if ps=="running" {return {tone:"running" text:A.t(name+" is running again.",A.sub_join(name,"已重新运行。"))}}
        if ps=="stopping" {return {tone:"waiting" text:A.t(name+"’s earlier run is still stopping. Check again in a moment.",A.sub_join(name,"上次的运行还在停止，请稍后再看。"))}}
        if ps=="recorded" {return {tone:"running" text:A.t(name+" started. Its work shows in its task history.",A.sub_join(name,"已启动，结果会记在它的任务记录里。"))}}
    }
    return {tone:"waiting" text:A.t(name+" isn’t running yet. You can try again.",A.sub_join(name,"还没有运行，可以再试一次。"))}
}
// Agents whose last run stopped, which the page offers to restart (a running one needs nothing).
A.dev_restart_count=fn(){let n={c:0} for row in A.dev_exec_rows() {if row.processState!="running" {n.c=n.c+1}} return n.c}
A.dev_process_text=fn(state){
    if state=="running" {return A.t("Running","正在运行")}
    if state=="stopped" {return A.t("Stopped","已停止")}
    if state=="qualified" {return A.t("Ready to run","可以运行")}
    return A.t("Not known","状态未知")
}
A.dev_exec_reason=fn(data){
    let code=if data==nil {nil} else {A.recipient_optional(data,"reason")}
    if code=="shared_successors_disabled" {return A.t("This version can’t restart Agents yet. Their records stay available.","此版本还不能重新启动 Agent。已有记录仍可查看。")}
    if code=="owner_source_adoption_required" || code=="shared_executor_adoption_required" {return A.t("Finish Set Up This Computer first.","请先在「这台电脑」里完成设置。")}
    if code=="adopted_executor_device_reauthorization_required" {return A.t("Use the computer that ran this Agent before.","请在原来运行这个 Agent 的电脑上操作。")}
    if code=="shared_successor_issuance_unavailable" {return A.t("The server doesn’t allow a new start now; under Other Ways you can still continue the last start.","服务器现在不允许重新启动；在「其他办法」里还可以接着上次的启动。")}
    return A.read_error(if code==nil {""} else {code})
}
// Interrupted tasks to handle across the pool list's own counts, for the hub's badge.
A.dev_task_hint=fn(){
    let m=H.pool_meta
    if m==nil {return 0}
    let n={c:0}
    for c in m.counts {if c.stopped>0 {n.c=n.c+c.stopped}}
    return n.c
}
A.dev_intents=fn(board){let {grantReviewAvailable=false,grantIntents=[]}=board return if grantReviewAvailable==true {grantIntents} else {[]}}
A.dev_join_text=fn(s){
    if s.pending>0 && s.admitted>0 {return A.t(""+s.admitted+" joined; "+s.pending+" waiting for the server administrator.",""+s.admitted+" 个已加入；"+s.pending+" 个在等服务器管理员批准。")}
    if s.pending>0 {return A.t("Waiting for the server administrator to approve.","正在等服务器管理员批准。")}
    if s.admitted>0 {return A.t(""+s.admitted+(if s.admitted==1 {" pool has"} else {" pools have"})+" joined a server.",""+s.admitted+" 个资源池已连接服务器。")}
    if s.pools>0 && s.admitted==0 {return A.t("Open a pool and connect it to a server.","打开资源池，连接服务器。")}
    return A.t("On Resource Pools, tap ⊕ to create one, then connect it to a server.","在「资源池」里点 ⊕ 新建，再连接服务器。")
}
A.dev_publish_text=fn(s){
    if s.unpublished>0 {return A.t(""+s.unpublished+" not published this month. Publish on the pool’s page.",""+s.unpublished+" 个资源池本月还没发布，在资源池页面发布。")}
    if s.published>0 {return A.t(""+s.published+" published this month.","本月已发布 "+s.published+" 个资源池。")}
    return A.t("After approval, publish on the pool’s page; then Agents can request it.","批准后在资源池页面发布，Agent 就能申请。")
}
// Opens a saved publishing record natively; it shows the result and never publishes twice.
A.dev_open_record=fn(intent){
    if H.busy || H.command!=nil {return}
    let {intentId=nil,contributionId=nil}=intent
    if intentId==nil {return}
    A.pool_call("hagency.grants.review",{intentId:intentId},fn(r){
        if !r.is_ok {H.dev.result={tone:"attention" text:A.pool_grant_error(r.error)} return}
        if contributionId!=nil {A.pool_keep_summary(contributionId,r.data)}
        let {state=nil,serverState=nil}=r.data
        H.dev.result=if state=="server_observed" && serverState=="active" {{tone:"running" text:A.onboarding_intent_label(intent)+A.t(" is published.","已发布。")}} else if state=="review_closed" {nil} else {{tone:"waiting" text:A.onboarding_intent_label(intent)+A.t(": not finished yet. Open it again to go on.","：还没有完成，可以再次打开接着做。")}}
        A.pool_device_load()
    })
}
A.dev_account=fn(){
    if H.session==nil {return ""}
    let parts=H.session.account.split(":")
    return parts[0]
}
A.dev_move_new=fn(){return [
    {title:A.t("Install Hagency and sign in","安装 Hagency 并登录") text:A.t("Use the same account: ","用同一个账号：")+A.dev_account() go:""},
    {title:A.t("Set up the new computer","设置新电脑") text:A.t("The first time it opens, follow This Computer › Getting Started.","第一次打开时，按「这台电脑 › 上手步骤」完成设置。") go:"setup"},
    {title:A.t("Connect your coding tool","接入编码工具") text:A.t("Connect your Codex account on Coding Tools.","在「编码工具」里接入 Codex 账号。") go:"tools"},
    {title:A.t("Create pools and connect them","新建资源池并连接服务器") text:A.t("On Resource Pools, tap ⊕ New Pool, connect to a server and wait for approval.","在「资源池」里点「⊕ 新建」，连接服务器，等服务器管理员批准。") go:"create"},
    {title:A.t("Publish this month’s capacity","发布本月额度") text:A.t("Then Agents can request the new computer’s pools.","发布后，Agent 就能申请新电脑上的资源池。") go:""}
]}
A.dev_move_old=fn(){return [
    {title:A.t("Keep it on and online for now","先保持开机联网") text:A.t("Agents’ tasks run here. Until the new pools are published, these pools keep working.","Agent 的任务在这里运行。新电脑的资源池发布前，这里的资源池照常工作。") go:""},
    {title:A.t("Don’t publish next month here","下个月不在这里发布") text:A.t("Each month’s capacity ends with the month. Without a new publication, these pools give Agents nothing new.","每个月的额度到月底结束。不再发布，这里的资源池就不会再给 Agent 新额度。") go:""},
    {title:A.t("To stop now, close the connection","想马上停用，就关闭连接") text:A.t("Open the pool below, then close its connection on Server & Publishing.","打开下面的资源池，在「服务器与发布」里关闭连接。") go:""}
]}
// A migration step that is a place in this app opens it (the same place on the new computer).
A.dev_move_go=fn(go){
    if H.busy {return}
    if go=="setup" {A.dev_open("pool_device_setup",nil) return}
    if go=="tools" {A.open_accounts(nil) return}
    if go=="create" {A.pool_create_open() return}
}
A.dev_tasks_title=fn(ready,loading,partial){
    let runs=A.dev_restart_count()
    if loading {return A.t("Checking each pool…","正在查看每个资源池…")}
    if ready>0 && runs>0 {return A.t(""+ready+(if ready==1 {" task"} else {" tasks"})+" and "+runs+(if runs==1 {" Agent"} else {" Agents"})+" need you","有 "+ready+" 个任务和 "+runs+" 个 Agent 等你处理")}
    if ready>0 {return A.t(""+ready+(if ready==1 {" task needs"} else {" tasks need"})+" you","有 "+ready+" 个任务等你处理")}
    if runs>0 {return A.t(""+runs+(if runs==1 {" Agent needs"} else {" Agents need"})+" restarting","有 "+runs+" 个 Agent 需要重新启动")}
    if partial {return A.t("Some pools couldn’t be read","部分信息暂时无法读取")}
    if H.dev.tasks.len()>0 {return A.t("None can be handled yet","中断的任务暂时都不能处理")}
    if H.dev.execState=="loading" {return A.t("Checking Agents…","正在查看 Agent…")}
    return A.t("Nothing to pick up","没有需要接回的")
}
A.dev_tasks_subtitle=fn(ready,loading,partial){
    let runs=A.dev_restart_count()
    if loading {return A.t("Interrupted tasks in every pool on this computer","这台电脑上所有资源池里中断的任务")}
    if ready>0 && runs>0 {return A.t("Decide what happens to each task, and restart the Agents below.","决定每个任务怎么处理，再重新启动下面的 Agent。")}
    if ready>0 {return A.t("They’re listed below, with the pool each one belongs to.","下面列出了每个任务和它所在的资源池。")}
    if runs>0 {return A.t("No task stopped midway, but an Agent’s last run stopped. Restart it below.","没有任务中途停下，但有 Agent 上次运行停止了，可以在下方重新启动。")}
    if partial {return A.t("Try again below. Nothing was changed.","请在下方重试，没有改动任何东西。")}
    if H.dev.tasks.len()>0 {return A.t("Their records aren’t ready yet. Tap Refresh on the task in a moment.","它们的记录还没准备好，过一会儿点任务右边的「刷新」。")}
    return A.t("No task stopped midway, and no Agent needs restarting.","没有任务中途停下，也没有 Agent 需要重新启动。")
}
A.dev_tasks_failed=fn(){
    let d=H.dev
    if d.taskState=="error" {return A.t("Couldn’t read this computer’s pools","暂时无法读取这台电脑上的资源池")}
    let names={t:""}
    for i name in d.failed {names.t=names.t+(if i>0 {A.t(", ","、")} else {""})+name}
    return A.t("Couldn’t read: ","暂时无法读取：")+names.t
}
// Per-pool drafts of the next publication's per-request amount, kept on this device.
A.pool_drafts=fn(){
    if H.session==nil {return {account:"" quota:[]}}
    if H.pool_drafts!=nil && H.pool_drafts.account==H.session.account {return H.pool_drafts}
    let d={account:H.session.account quota:[]}
    H.pool_drafts=d
    if !fs.exists("pool-drafts-v1.json") {return d}
    try {
        let stored=fs.read("pool-drafts-v1.json").parse_json()
        if stored!=nil && stored.is_object() {
            let {version=0,account="",quota=[]}=stored
            if version==1 && account==H.session.account && (quota.is_array() || quota.is_object()) {for row in quota {let {rid=nil,tokens=nil}=row if rid!=nil && tokens!=nil && tokens>=1 {d.quota.push({rid:rid tokens:tokens})}}}
        }
    } {d.quota=[]}
    return d
}
A.pool_draft_get=fn(rid){for row in A.pool_drafts().quota {if row.rid==rid {return row.tokens}} return nil}
A.pool_draft_set=fn(rid,tokens){
    if H.session==nil {return}
    let d=A.pool_drafts()
    let rows=[] for row in d.quota {if row.rid!=rid && rows.len()<63 {rows.push(row)}}
    rows.push({rid:rid tokens:tokens})
    d.quota=rows
    H.pool_draft_seq+=1 let seq=H.pool_draft_seq
    start_timeout(0.4,||{if seq==H.pool_draft_seq && H.session!=nil {fs.write("pool-drafts-v1.json",{version:1 account:H.session.account quota:d.quota}.to_json())}})
}
A.pool_quota_pick=fn(amount){
    let e=H.pool_edit
    if e==nil || H.busy || H.command!=nil || amount<1 {return}
    e.quota=""+amount H.pool_result=nil
    if A.pool_quota_drafts() {A.pool_draft_set(e.rid,amount)}
    A.redraw()
}
// When the per-request value takes effect, in the owner's terms.
A.pool_quota_when=fn(v){
    if v.quotaMode=="amend" {let given=A.pool_floor(v) return if given!=nil {A.t("Applies this month once you confirm; no less than the "+A.tokens(given)+" given to running Agents","确认后本月立即生效；不能低于已分给正在运行的 Agent 的 "+A.tokens(given))} else if v.agents>0 {A.t("Applies this month once you confirm; no less than what running Agents were given","确认后本月立即生效；不能低于已分给正在运行的 Agent 的额度")} else {A.t("Applies this month once you confirm","确认后本月立即生效")}}
    if v.quotaMode=="scheduled" {return A.t(A.pool_next_month_name(v.now)+" is published ahead, so this month’s per-request limit can’t change any more",A.pool_next_month_name(v.now)+"已提前发布，本月的每次申请上限不能再改")}
    if v.published {return A.t("Applies when you next publish, from "+A.pool_next_month(v.now),"下次发布（"+A.pool_next_month(v.now)+"起）时生效")}
    if v.quotaEditable {return A.t("Applies when you tap ","点「")+A.pool_publish_label(v.now)+A.t("","」时生效")}
    if v.connState=="none" || (v.conn!=nil && v.conn.state=="pending_admission") {return A.t("Applies when you publish after approval","获准后发布时生效")}
    if v.connState=="loading" {return ""}
    if v.boardState=="ready" && !v.deviceReady && v.lapsed {return A.t("Applies when you publish, once this computer is set up","这台电脑设置好后，发布时生效")}
    return A.t("Applies when you publish","发布时生效")
}
A.pool_clear_max=fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil {return}
    let row=H.resource_detail.resource
    let {editing={},ceiling=nil}=H.resource_detail
    let {allowed=false}=editing
    if allowed!=true {H.notice=A.resource_edit_error("management_resource_edit_not_available") A.redraw() return}
    if ceiling==nil {return}
    H.pool_before={rid:row.id max:ceiling.tokens}
    A.submit("hagency.resources.edit",{resourceId:row.id expectedRevision:row.revision profile:{kind:"preserve"} ceiling:{kind:"clear"}})
}
A.pool_max_unlimited=fn(){
    let e=H.pool_edit
    if e==nil || H.busy || H.command!=nil || H.resource_detail==nil {return}
    e.unlimited=!e.unlimited
    if !e.unlimited && A.pool_whole(e.max)<0 {
        let v=A.pool_view(H.resource_detail)
        let top=if v.maxMax>0 {v.maxMax} else {10000000}
        e.max=""+max(v.maxMin,min(1000000,top))
    }
    H.pool_result=nil A.redraw()
}
A.pool_model_text=fn(row){
    let {capabilities=[],reasoning=nil}=row
    let out={t:row.model+" · "+A.t("reasoning ","推理 ")+(if reasoning==nil {A.t("default","默认")} else {A.reasoning_label(reasoning)})}
    let caps={t:""}
    for i c in capabilities {caps.t=caps.t+(if i>0 {A.t(", ","、")} else {""})+A.capability_label(c)}
    if caps.t!="" {out.t=out.t+" · "+caps.t}
    return out.t
}
A.pool_who_until=fn(v){
    if v.expires==nil {return A.t("ends this month","本月底到期")}
    let c=A.pool_civil(v.expires)
    if v.now!=nil && A.pool_civil(v.now).m==c.m && A.pool_civil(v.expires+86400000).m!=c.m {return A.t("ends this month","本月底到期")}
    return A.pool_date(v.expires)
}
A.pool_who_text=fn(v){
    if v.managers!=nil {return A.t(""+v.managers.len()+(if v.managers.len()==1 {" account"} else {" accounts"}),""+v.managers.len()+" 个账号")+" · "+A.pool_who_until(v)}
    if v.published {return A.t("Published · see the list","已发布 · 查看名单")}
    if v.connState=="loading" || v.grantState=="loading" {return ""}
    return A.t("Not published · you can pick people now","尚未发布 · 可以先选好人")
}
A.pool_sub_page=fn(){return A.has_page(["pool_device","pool_device_setup","pool_device_move","pool_device_tasks","pool_who","pool_advanced","pool_glossary"])}
A.pool_sub_open=fn(page,rid){
    if H.busy {return}
    H.pool_sub_rid=rid H.page=page H.notice="" H.bar_past=false
    if page=="pool_who" {A.who_open(rid) A.pool_who_load(nil) return}
    if page=="pool_advanced" {A.pool_adv_load(rid)}
    A.redraw()
}
// Advanced Settings: whether this pool can be deleted, from the same record the listing uses.
A.pool_adv_load=fn(rid){
    let w=H.web
    w.resourceId=rid w.section="settings" w.after=nil w.catalog=nil w.draft=nil
    H.pool_adv_state="loading"
    // A quiet read: the rest of the page stays usable while it runs.
    host.request("hagency.web_catalog.get",{resourceId:rid after:nil},fn(r){
        if H.pool_sub_rid!=rid || H.page!="pool_advanced" {return}
        if !r.is_ok {H.pool_adv_state="error" A.redraw() return}
        let {resourceId="",revision=nil,rateCapPerDay=nil}=r.data
        if resourceId!=rid || revision==nil || !revision.is_string() {H.pool_adv_state="error" A.redraw() return}
        w.catalog=r.data w.rate=if rateCapPerDay==nil {""} else {""+rateCapPerDay} H.pool_adv_state="ready"
        A.redraw()
    })
}
A.pool_adv_can_delete=fn(){
    let w=H.web
    if H.pool_adv_state!="ready" || w.catalog==nil || w.resourceId!=H.pool_sub_rid {return false}
    return A.recipient_optional(w.catalog,"canRetire")==true
}
A.pool_adv_delete_note=fn(){
    if H.pool_adv_state=="loading" {return A.t("Checking whether it can be deleted…","正在检查能不能删除…")}
    if H.pool_adv_state=="error" {return A.t("Couldn’t check whether it can be deleted. Go back and open this page again.","暂时无法确认能不能删除，请返回后再打开这一页。")}
    if A.pool_adv_can_delete() {return A.t("You review it once more before it’s deleted. Past use records are kept.","删除前会请你再确认一次；过去的使用记录会保留。")}
    return A.t("You can’t delete it while Agents are using it. Stop them first under Requests.","有 Agent 正在使用这个资源池，暂时不能删除。可以先在「申请」里停止它们。")
}
A.pool_adv_delete=fn(){
    if H.busy || H.command!=nil || !A.pool_adv_can_delete() {return}
    A.web_prepare({operation:"retire"})
}
// Trusted projects moved here from the catalogue; they use its trust list and change flow.
A.pool_who_load=fn(after){
    let w=H.web let rid=H.pool_sub_rid
    w.resourceId=rid w.section="trust" w.after=after w.catalog=nil w.draft=nil
    A.web_read("hagency.web_catalog.trust",{resourceId:rid after:after},fn(v){if v.resourceId!=rid || !v.revision.is_string() {H.notice=A.web_error("management_outcome_unknown") return} w.catalog=v})
}
A.pool_sub_title=fn(){
    let p=H.page
    if A.dev_page() {return A.dev_title(p)}
    if p=="pool_who" {return A.t("Who Can Request","谁可以申请")}
    if p=="pool_advanced" {return A.t("Advanced Settings","高级设置")}
    if p=="pool_glossary" {return A.t("What These Words Mean","这些词是什么意思？")}
    return ""
}
A.pool_sub_back_label=fn(){return A.nav_label(if A.dev_page() {A.pool_device_label()} else {A.t("Pool","资源池")})}
A.pool_sub_back=fn(){
    if H.busy {return}
    if A.nav_back() {return}
    if A.dev_page() {A.pool_device_back() return}
    if H.pool_sub_rid!="" {A.open_resource(H.pool_sub_rid) return}
    A.return_list("resources")
}
A.pool_sub_refresh=fn(){
    if H.page=="pool_device_tasks" {A.dev_tasks_load() A.redraw() return}
    if A.dev_page() {A.pool_device_load() return}
    if H.page=="pool_who" {A.pool_who_load(nil) return}
    A.redraw()
}
A.pool_tip=fn(key){H.pool_tip=if H.pool_tip==key {""} else {key} A.redraw()}
A.pool_hero_lines=fn(name){
    if mod.widgets.RINX_TEXT_SCALE<=1.2 {return [name]}
    let parts=name.split(" · ")
    return if parts.len()==2 {parts} else {[name]}
}
// The hero pill: status, and the way into Server and Publishing.
A.pool_pill_text=fn(v){
    if v.status.key=="month" {return A.t("Not published this month","本月未发布")}
    if v.status.key!="" {return v.status.text}
    if v.connState=="loading" {return A.t("Checking…","正在读取…")}
    return A.t("Server and Publishing","服务器与发布")
}
A.pool_model_lock=fn(v){
    if v.editReason=="published" {return A.t("locked while listed","列出期间锁定")}
    if v.editReason=="previously_offered" {return A.t("locked once connected","连接服务器后锁定")}
    return A.t("locked","已锁定")
}
// When the list of applicants can change, in the owner's terms.
A.pool_who_rule=fn(v){
    if v.published && v.quotaMode=="amend" {return A.t("You can add people this month; nobody already on the list can be removed until the month ends.","本月可以随时加人；月底前，已在名单里的人不能删掉。")}
    if v.published {return A.t("Chosen when this month was published; it can’t change this month. You can choose again when you next publish, from "+A.pool_next_month(v.now)+".","名单在发布本月额度时选定，本月内不能更改。下次发布（"+A.pool_next_month(v.now)+"起）时可以重新选择。")}
    if v.quotaEditable {return A.t("You confirm the list in the confirmation window when you publish. After that, people can only be added this month.","发布时在确认窗口中确认名单。发布后，本月只能加人。")}
    return A.t("Once the administrator approves, you pick people in the confirmation window when you publish.","管理员批准后，发布时在确认窗口里选人。")
}
// Who may request: pre-select people for the confirmation window. Only the native window commits.
A.who_server=fn(){
    if H.session==nil {return ""}
    let parts=H.session.account.split(":")
    let out={t:""}
    for i part in parts {if i>0 {out.t=out.t+(if i>1 {":"} else {""})+part}}
    return out.t
}
// "lisi", "@lisi" or "@lisi:server" on the owner's server, as a full Matrix ID; nil if it isn't one.
A.who_mxid=fn(text){
    let t=text.trim()
    let name=t.strip_prefix("@")
    if name=="" {return nil}
    let parts=name.split(":")
    let server=A.who_server()
    if parts.len()>1 {
        let rest={t:""} for i part in parts {if i>0 {rest.t=rest.t+(if i>1 {":"} else {""})+part}}
        if rest.t!=server {return nil}
    }
    let local=parts[0]
    if local=="" || local.len()>64 {return nil}
    let allowed="abcdefghijklmnopqrstuvwxyz0123456789._=-/".to_chars()
    for ch in local.to_chars() {let found={y:false} for c in allowed {if c==ch {found.y=true}} if !found.y {return nil}}
    return "@"+local+":"+server
}
A.who_name_hint=fn(){
    let w=H.who
    if w.name.trim()=="" {return A.t("Their username on "+A.who_server()+". Add puts them in the list above.","对方在 "+A.who_server()+" 上的用户名。点「添加」会把对方放进上面的列表。")}
    let id=A.who_mxid(w.name)
    if id==nil {return ""}
    return A.t("Add puts ","点「添加」把 ")+A.pool_person(id)+A.t(" in the list above."," 放进上面的列表。")
}
// The username typed can't be used: said in red under the field.
A.who_name_bad=fn(){
    let w=H.who
    if w.name.trim()=="" || A.who_mxid(w.name)!=nil {return ""}
    return A.t("Use a username on "+A.who_server()+": lowercase letters, digits and . _ = - /","请输入 "+A.who_server()+" 上的用户名：小写字母、数字和 . _ = - /")
}
A.who_open=fn(rid){
    let w=H.who
    if w.rid!=rid {w.rid=rid w.picks=[] w.name="" w.nameError="" w.trustOpen=false}
}
A.who_has=fn(list,mxid){if list==nil {return false} let f={y:false} for x in list {if x==mxid {f.y=true}} return f.y}
A.who_toggle=fn(mxid){
    let w=H.who
    if H.busy || H.command!=nil {return}
    let out=[] let f={y:false}
    for x in w.picks {if x==mxid {f.y=true} else {out.push(x)}}
    if !f.y && out.len()<64 {out.push(mxid)}
    w.picks=out A.redraw()
}
A.who_add=fn(){
    let w=H.who
    if H.busy || H.command!=nil {return}
    let id=A.who_mxid(w.name)
    if id==nil {return}
    if !A.who_has(w.picks,id) && w.picks.len()<64 {w.picks.push(id)}
    w.name="" A.redraw()
}
// People to choose from: those who asked for this pool, and lists of this owner's other pools.
A.who_skip=fn(v,out,id){return id==nil || id=="" || (H.session!=nil && id==H.session.account) || A.who_has(v.managers,id) || A.who_has(out,id)}
A.who_candidates=fn(v){
    let out=[]
    let cid=if v.conn==nil {""} else {v.conn.id}
    if H.pool_meta!=nil && H.pool_meta.requests!=nil {for q in H.pool_meta.requests {let {poolId=nil,managerMxid=nil}=q if poolId==cid && !A.who_skip(v,out,managerMxid) {out.push(managerMxid)}}}
    if H.reqs.items!=nil {for q in H.reqs.items {let {poolId=nil,managerMxid=nil}=q if poolId==cid && !A.who_skip(v,out,managerMxid) {out.push(managerMxid)}}}
    for g in H.pool_grants {let ids=A.pool_summary_managers(g.summary) if ids!=nil {for id in ids {if !A.who_skip(v,out,id) {out.push(id)}}}}
    for id in H.who.picks {if !A.who_skip(v,out,id) {out.push(id)}}
    return out
}
A.who_source=fn(v,mxid){
    let cid=if v.conn==nil {""} else {v.conn.id}
    let asked={y:false}
    if H.pool_meta!=nil && H.pool_meta.requests!=nil {for q in H.pool_meta.requests {let {poolId=nil,managerMxid=nil}=q if poolId==cid && managerMxid==mxid {asked.y=true}}}
    if H.reqs.items!=nil {for q in H.reqs.items {let {poolId=nil,managerMxid=nil}=q if poolId==cid && managerMxid==mxid {asked.y=true}}}
    // Until this month's list is read, anyone may already be on it: say so rather than offer them as new.
    let maybe=if v.published && v.managers==nil {A.t(" · may already be on the list"," · 可能已在名单里")} else {""}
    if asked.y {return A.t("Asked for this pool","申请过这个资源池")+maybe}
    for g in H.pool_grants {if A.who_has(A.pool_summary_managers(g.summary),mxid) {return A.t("On another pool’s list","在你其他资源池的名单里")+maybe}}
    return A.t("Added by you","你添加的")+maybe
}
// What the page's main button does with the people picked.
A.who_action=fn(v){
    let n=H.who.picks.len()
    if v.quotaEditable {return {kind:"publish" label:A.pool_publish_label(v.now) note:if n>0 {A.t(""+n+" picked in advance; confirm the list in the window on this computer.","已先选好 "+n+" 人；在这台电脑的确认窗口里确认名单。")} else {A.t("You can also add people in the confirmation window.","也可以在确认窗口里再加人。")} ready:true}}
    if v.quotaMode=="amend" {return {kind:"amend" label:A.t("Add to This Month’s List","添加到本月名单") note:if n>0 {A.t(""+n+" picked. Once you confirm in the window on this computer, they can request.","已选 "+n+" 人。在这台电脑的确认窗口里确认后，对方就能申请。")} else {A.t("Tap the people to add above; they can request once you confirm in the window.","在上面点选要加的人；在确认窗口里确认后，对方就能申请。")} ready:n>0}}
    return {kind:"" label:"" note:"" ready:false}
}
A.who_submit=fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil {return}
    let v=A.pool_view(H.resource_detail)
    let a=A.who_action(v)
    if !a.ready {return}
    if a.kind=="publish" {A.pool_publish_quota() return}
    if a.kind=="amend" && v.publishedTokens!=nil {A.pool_succeed("amendment",v.publishedTokens,H.who.picks)}
}
// Picks to pre-select on this pool's next confirmation window, when this computer can.
A.who_picks=fn(rid){
    let w=H.who
    if H.pool_no_applicants || w.rid!=rid || w.picks.len()==0 {return nil}
    let out=[] for id in w.picks {out.push(id)}
    return out
}
// Trusted projects: the room ID, checked before the change is prepared.
A.who_room_ok=fn(text){
    let t=text.trim()
    if t=="" || t.strip_prefix("!")==t {return false}
    let parts=t.split(":")
    return parts.len()>=2 && parts[0].len()>1 && parts[1]!=""
}
A.who_room_hint=fn(){
    let w=H.web
    if w.trustRoom.trim()=="" {return A.t("In Hagency, open the project’s chat › Chat information; under Room details, tap Copy Room ID, then paste it here.","在 Hagency 里打开项目的聊天 › 聊天信息，在「房间概览」里点「复制房间 ID」，再粘贴到这里。")}
    if !A.who_room_ok(w.trustRoom) {return ""}
    return A.t("Looks right. Tap Add to review it.","格式正确，点「添加」后确认。")
}
A.who_room_bad=fn(){
    let w=H.web
    if w.trustRoom.trim()=="" || A.who_room_ok(w.trustRoom) {return ""}
    return A.t("That isn’t a room ID (it starts with ! and has a colon, like !abc123:example.org). Copy it from the project’s chat › Chat information › Copy Room ID, then paste it here.","这不是房间 ID（以 ! 开头，中间有冒号，例如 !abc123:example.org）。请在项目的聊天 › 聊天信息里点「复制房间 ID」，再粘贴到这里。")
}
A.pool_glossary=fn(group){
    if group=="capacity" {return [
        {term:A.t("Monthly maximum","每月上限") text:A.t("The most this pool may use in a month. Change it with the slider on the pool’s page and confirm it in the window; when it can’t change, the page says why.","一个月最多能用掉的额度。在资源池页面用滑块调整，在确认窗口中确认；暂时不能调整时，页面上会写明原因。")},
        {term:A.t("Per-request limit","每次申请上限") text:A.t("The most one Agent gets per request. It’s set when you publish; where the server allows, it can also change during the month.","每个 Agent 每次申请最多能拿到的额度。发布时设定；服务器支持时，本月内也可以修改。")},
        {term:A.t("Left","剩余") text:A.t("What can still be given to Agents this month. It resets on the 1st.","这个月还能分给 Agent 的额度，每月 1 日重置。")},
        {term:A.t("Given to Agents","已分给 Agent") text:A.t("What the pool gives an Agent when you approve its request (“give to”). Running Agents keep what they were given; the per-request limit can’t go below it.","你批准申请后，资源池分给这个 Agent 的额度（「分给」）。正在运行的 Agent 保留已分给它的额度；每次申请上限不能低于已分给正在运行的 Agent 的额度。")},
        {term:A.t("Given to Agents, not used yet","已分给 Agent，尚未用") text:A.t("The part given to Agents that they haven’t used yet. It isn’t given to anyone else.","已分给 Agent、但它还没用掉的部分，不会再分给别人。")},
        {term:A.t("Committed","已承诺") text:A.t("Used plus given to Agents (the part not used yet). The monthly maximum can’t go below it.","已承诺 = 已用 + 已分给 Agent（尚未用的部分）。每月上限不能低于它。")},
        {term:A.t("Pause sharing","暂停共享") text:A.t("Before a pool is offered: clear its monthly maximum so Agents can’t request it. Set a maximum again to resume.","资源池连接服务器之前可用：清掉每月上限，Agent 就不能再申请；以后设一个每月上限就能恢复。")},
        {term:"1 M" text:A.t("One million tokens. Tokens are how model use is counted.","100 万 token。token 是模型用量的计算单位。")}
    ]}
    if group=="publish" {return [
        {term:A.t("Publish","发布") text:A.t("Hand this month’s capacity to the server so Agents can request it. You publish once a month.","把本月的额度交给服务器，Agent 才能申请。每个月发布一次。")},
        {term:A.t("Waiting for approval","等管理员批准") text:A.t("The pool was offered to a server; its administrator hasn’t approved it yet.","资源池已申请连接服务器，正在等服务器管理员批准。")},
        {term:A.t("Not connected","未连接服务器") text:A.t("The pool hasn’t been offered to any server, so no Agent can see it.","资源池还没有连接任何服务器，Agent 看不到它。")},
        {term:A.t("Who can request","谁可以申请") text:A.t("The accounts whose Agents may request this pool. Pick them when you publish; during the month you can add people any time, but not remove them.","能申请这个资源池的账号。发布时选好；本月内随时可以加人，但月底前不能删人。")},
        {term:A.t("Approved automatically","自动批准的项目") text:A.t("Agents from these projects are approved without asking you; the person asking must still be on the list.","这些项目里的 Agent 申请时不再问你；申请的人仍要在名单里。")},
        {term:A.t("Publish ahead","提前发布") text:A.t("In the last 7 days of a month you can publish next month; running Agents carry on without asking again.","每月最后 7 天，可以提前发布下个月的额度，使用中的 Agent 不用重新申请。")},
        {term:A.t("Catalogue (optional)","对外展示（可选）") text:A.t("Shows this pool and its offers in the catalogue. It doesn’t limit use.","在目录里展示这个资源池和报价，只是展示，不限制用量。")},
        {term:A.t("Locked","锁定") text:A.t("Once a pool is offered to a server, its model can’t change. Whether its monthly maximum can change is said on the pool’s page.","资源池连接服务器后，模型不能再改。每月上限能否调整，资源池页面上会写明。")}
    ]}
    return [
        {term:A.t("Health & Recovery","健康与恢复") text:A.t("Alerts, interrupted tasks and workspaces to check. An alert that clears by itself isn’t counted as something to handle.","告警、中断的任务和需要检查的工作区。会自动解除的告警不算待处理。")},
        {term:A.t("Needs you","需要你处理") text:A.t("The top of Resource Pools gathers everything waiting for you, across every pool.","「资源池」页面顶部，把所有资源池里等你处理的事放在一起。")},
        {term:A.t("This computer","这台电脑") text:A.t("The computer that publishes your pools and runs their Agents’ tasks. It must be on and online.","发布你的资源池、运行 Agent 任务的电脑，需要开机联网。")},
        {term:A.t("Move to a new computer","迁移到新电脑") text:A.t("A pool stays with the computer that publishes it. To switch, create pools on the new computer; the old ones work until the month ends.","资源池跟着发布它的电脑。换电脑时，在新电脑上新建资源池；旧电脑上的资源池用到月底。")},
        {term:A.t("Pick up interrupted tasks","接回中断的任务") text:A.t("Tasks that stopped after a restart or a dropped connection. You decide whether to continue, accept or pause each one.","重启或断线后停下来的任务。由你决定继续、确认完成或先暂停。")}
    ]
}
// Create a pool in a sheet on this tab: tool, model, reasoning and monthly maximum.
A.pool_create_open=fn(){
    if H.busy || H.command!=nil {return}
    H.ux.resourceJourney=false
    let keep=H.pool_create!=nil && H.enrollment_draft!=nil
    if !keep {H.pool_create_seq+=1 H.pool_create={epoch:H.pool_create_seq accounts:nil error:"" account:nil models:nil modelsError:"" loadingModels:false}}
    H.page="pool_create" H.notice="" H.bar_past=false A.redraw()
    A.pool_create_accounts()
}
A.pool_create_close=fn(){
    if H.busy {return}
    H.pool_create=nil H.enrollment_draft=nil
    A.return_list("resources")
}
A.pool_create_accounts=fn(){
    let c=H.pool_create
    if c==nil || H.busy {return}
    c.error=""
    A.pool_call("hagency.accounts.list",{},fn(r){
        if H.page!="pool_create" || H.pool_create==nil || H.pool_create.epoch!=c.epoch {return}
        if !r.is_ok {c.error=A.error_text(r.error) return}
        let {accounts=nil}=r.data
        if accounts==nil {c.error=A.t("The coding tools couldn’t be read. Try again.","暂时无法读取编码工具，请重试。") return}
        let rows=[] for row in accounts {if row.kind=="managed_namespace" && row.state=="active" {rows.push(row)}}
        c.accounts=rows
        if c.account!=nil {for row in rows {if row.id==c.account.id {c.account=row}} return}
        if H.enrollment_draft!=nil {for row in rows {if row.id==H.enrollment_draft.account.accountId {A.pool_create_account(row) return}}}
        if rows.len()==1 {A.pool_create_account(rows[0])}
    })
}
A.pool_create_account=fn(row){
    let c=H.pool_create
    if c==nil || H.busy || H.command!=nil {return}
    if c.account!=nil && c.account.id!=row.id {H.enrollment_draft=nil}
    c.account=row c.models=nil c.modelsError="" c.loadingModels=true
    A.pool_call("hagency.accounts.get",{id:row.id},fn(r){
        if H.page!="pool_create" || H.pool_create==nil || H.pool_create.epoch!=c.epoch || c.account==nil || c.account.id!=row.id {return}
        if !r.is_ok {c.loadingModels=false c.modelsError=A.account_models_error(r.error) return}
        let data=r.data
        if data.protocol!="hagency-management-v1" || data.account==nil || data.account.id!=row.id {c.loadingModels=false c.modelsError=A.t("This coding tool changed. Choose it again.","此编码工具已变化，请重新选择。") return}
        H.account_detail=data H.account_id=row.id
        A.pool_call("hagency.accounts.models",{accountId:row.id expectedRevision:row.revision},fn(m){
            if H.page!="pool_create" || H.pool_create==nil || H.pool_create.epoch!=c.epoch || c.account==nil || c.account.id!=row.id {return}
            c.loadingModels=false
            if !m.is_ok {c.modelsError=A.account_models_error(m.error) return}
            let d=m.data
            if d.protocol!="hagency-management-v1" || d.accountId!=row.id || d.revision!=row.revision || d.provider.runtime!="codex" || d.provider.connected!=true {c.modelsError=A.t("The model list doesn’t match this tool. Try again.","模型结果与此工具不匹配，请重试。") return}
            c.models=d H.account_models=d
            let draft=H.enrollment_draft
            if draft!=nil && draft.account.accountId==row.id {return}
            for model in d.provider.models {if H.enrollment_draft==nil && model.sharedReasoning.len()>0 {A.pool_create_model(model)}}
        })
    })
}
A.pool_create_model=fn(model){
    let c=H.pool_create
    if c==nil || c.account==nil || c.models==nil || H.command!=nil || model.sharedReasoning.len()==0 {return}
    let draft=H.enrollment_draft
    if draft!=nil && draft.account.accountId==c.account.id {A.enrollment_model_pick(model.model) return}
    let row=c.account
    let {resourceCount=0}=H.pool_create.account
    let resources=if H.account_detail==nil {[]} else {H.account_detail.resources}
    let d={account:{accountId:row.id expectedRevision:row.revision} model:model models:c.models.provider.models reasoning:model.sharedDefaultReasoning tokens:"1000000" sourceRequired:resourceCount>0 source:nil}
    H.enrollment_draft=d A.redraw()
    if d.sourceRequired && resources.len()>0 {
        let id=resources[0].id
        A.pool_call("hagency.resources.get",{id:id},fn(r){
            if H.page!="pool_create" || H.enrollment_draft==nil || H.enrollment_draft.account.accountId!=row.id {return}
            if !r.is_ok {H.notice=A.resource_create_error("management_resource_source_changed") return}
            let v=r.data
            if v.protocol!="hagency-management-v1" || v.resource.id!=id || v.choices.len()==0 || v.editing.reason=="read_only" {H.notice=A.resource_create_error("management_resource_source_changed") return}
            d.source={id:v.resource.id revision:v.resource.revision} H.resource_detail=v
        })
    }
}
A.pool_account_name=fn(account,many){
    let {runtime="",ordinal=nil}=account
    let name=if runtime=="codex" {"Codex"} else if runtime=="claude" {"Claude"} else {runtime}
    return if many && ordinal!=nil {name+" #"+ordinal} else {name}
}
A.pool_login_text=fn(account){
    let {readiness=nil,resourceCount=0}=account
    let login=if readiness=="subscription" {A.t("Signed in · subscription","已登录 · 订阅账号")} else if readiness=="api_key" {A.t("Signed in · API key","已登录 · API 密钥")} else {A.t("Sign-in not checked yet","尚未确认登录")}
    return login+if resourceCount>0 {A.t(" · pools: "," · 已有 ")+resourceCount+A.t(""," 个资源池")} else {""}
}
A.pool_lapsed_rows=fn(){
    let rows=[]
    for row in H.resources {if rows.len()<3 && A.pool_row(row).lapsed {rows.push(row)}}
    return rows
}
A.pool_list_now=fn(){return if H.pool_meta==nil {nil} else {H.pool_meta.now}}
A.pool_list_device=fn(){
    let m=H.pool_meta
    if m==nil {return A.pool_device_state(nil,"loading")}
    return A.pool_device_state(m.board,m.boardState)
}
A.pool_list_unknown=fn(){
    let m=H.pool_meta
    if m==nil {return false}
    if m.connsError || m.grantsError {return true}
    for row in H.resources {if A.pool_row(row).unknown {return true}}
    return false
}
A.pool_create_tokens=fn(text){if H.enrollment_draft==nil || H.busy || H.command!=nil {return} H.enrollment_draft.tokens=text ui.pool_create_submit.set_enabled(A.pool_create_valid())}
A.pool_create_preset=fn(amount){if H.enrollment_draft==nil || H.busy || H.command!=nil {return} H.enrollment_draft.tokens=""+amount A.redraw()}
A.pool_create_ready=fn(){
    if H.pool_create==nil || H.pool_create.models==nil {return false}
    let {enrollmentReady=false}=H.pool_create.models
    return enrollmentReady==true
}
A.pool_create_valid=fn(){
    let d=H.enrollment_draft
    if d==nil || H.busy || H.command!=nil || !A.pool_create_ready() {return false}
    let fine=false for effort in d.model.sharedReasoning {if effort==d.reasoning {fine=true}}
    let tokens=A.pool_whole(d.tokens)
    let {sourceRequired=false,source=nil}=H.enrollment_draft
    return fine && tokens>=1 && (!sourceRequired || source!=nil)
}
A.pool_create_submit=fn(){if !A.pool_create_valid() {return} A.enroll_account()}
A.pool_create_quota=fn(){
    if H.enrollment_draft==nil {return -1}
    let {sourceRequired=false,source=nil}=H.enrollment_draft
    if !sourceRequired || source==nil || H.resource_detail==nil || H.resource_detail.resource.id!=source.id {return -1}
    let b=A.pool_budget(H.resource_detail.resource)
    return if b.quota!=nil && b.quota>0 {b.quota} else {-1}
}
A.new_resource = fn(){
    if H.busy || H.command != nil {return}
    H.ux.resourceJourney=true H.ux.accountId="" A.save()
    A.open_accounts(nil)
}
A.step = fn(value){ if H.busy || H.command != nil { return } H.wizard.step = value A.save() A.redraw() if value == 1 || value == 2 { A.load_providers() } }
A.account_state = fn(row){
    if row.state == "linked" {return A.t("Recorded resource association", "已记录资源关联")}
    if row.state == "active" {return A.t("Login record ready", "登录记录可用")}
    if row.state == "preparing" {return A.t("Preparation in progress", "正在准备")}
    if row.state == "uncertain" {return A.t("Preparation outcome unknown", "准备结果未确认")}
    if row.state == "retired" {return A.t("Retired", "已停用")}
    return A.t("Unknown", "未知")
}
A.account_kind = fn(row){return if row.kind == "managed_namespace" {A.t("Provider login", "服务商登录")} else {A.t("Resource association", "资源关联")}}
A.account_readiness = fn(row){
    if row.readiness == "subscription" {return A.t("Subscription login observed", "已检测到订阅登录")}
    if row.readiness == "api_key" {return A.t("API-key login observed", "已检测到 API 密钥登录")}
    return A.t("Login status not verified", "登录状态未验证")
}
A.account_models_error = fn(code){
    if code=="provider_connection_required" {return A.t("Sign in to this account before checking its models.","请先登录此账号，再检查其可用模型。")}
    if code=="provider_account_changed" || code=="management_revision_conflict" {return A.t("The account changed. Refresh its details before checking again.","账号已变更，请刷新详情后重新检查。")}
    if code=="provider_identity_unavailable" || code=="provider_login_method_rejected" {return A.t("This account cannot provide a supported Codex subscription catalog.","此账号无法提供受支持的 Codex 订阅模型列表。")}
    if code=="provider_catalog_timeout" || code=="codex_provider_unavailable" || code=="codex_model_catalog_unavailable" {return A.t("Models could not be read from this account. Check its connection and try again.","无法读取此账号的模型，请检查连接后重试。")}
    if code=="native_resume_missing" || code=="native_resume_revoked" || code=="management_access_required" || code=="management_scope_changed" || code=="management_permission_required" {return A.error_text(code)}
    return A.t("Models could not be read from this account. Check its connection and try again.","无法读取此账号的模型，请检查连接后重试。")
}
A.account_can_enroll=fn(){
    if H.account_models==nil {return false}
    let {enrollmentReady=false}=H.account_models
    return enrollmentReady
}
A.choose_account_model = fn(row,model){
    if H.busy || H.command!=nil || H.account_models==nil || H.account_detail==nil || H.account_models.accountId!=row.id || H.account_models.revision!=row.revision || model.sharedReasoning.len()==0 {return}
    let {enrollmentReady=false}=H.account_models
    if !enrollmentReady {H.notice=A.t("Finish device setup before enrolling resources from this account.","请先完成设备设置，再从此账号登记资源。") A.redraw() return}
    let {resourceCount=0}=row let {resources=[]}=H.account_detail
    let d={account:{accountId:row.id expectedRevision:row.revision} model:model models:H.account_models.provider.models reasoning:model.sharedDefaultReasoning tokens:"1000000" sourceRequired:resourceCount>0 source:nil}
    H.enrollment_draft=d H.enrollment_models_open=false H.page="account_enrollment" H.notice="" A.redraw()
    if d.sourceRequired {
        if resources.len()==0{H.notice=A.t("Load this account's existing resources before creating another pool.","请先读取此账号的已有资源，再创建新资源池。") A.redraw() return}
        let id=resources[0].id
        A.request("hagency.resources.get",{id:id},fn(v){
            if H.page!="account_enrollment" || H.enrollment_draft==nil || H.enrollment_draft.account.accountId!=row.id{return}
            if v.protocol!="hagency-management-v1" || v.resource.id!=id || v.choices.len()==0 || v.editing.reason=="read_only"{H.notice=A.resource_create_error("management_resource_source_changed") return}
            d.source={id:v.resource.id revision:v.resource.revision} H.resource_detail=v
        })
    }
}
A.enrollment_existing=fn(d){let {sourceRequired=false}=d return sourceRequired}
A.enrollment_source=fn(d){let {source=nil}=d return source}
A.enrollment_models=fn(d){let {models=[]}=d return models}
A.enrollment_model_pick=fn(name){
    if H.busy || H.command!=nil || H.enrollment_draft==nil{return}
    let d=H.enrollment_draft
    let {models=[]}=H.enrollment_draft
    for model in models{if model.model==name && model.sharedReasoning.len()>0{
        let keep=false for effort in model.sharedReasoning{if effort==d.reasoning{keep=true}}
        d.model=model if !keep{d.reasoning=model.sharedDefaultReasoning}
        H.enrollment_models_open=false H.notice="" A.redraw() return
    }}
}
A.enroll_account = fn(){
    if H.busy || H.command!=nil || H.enrollment_draft==nil {return}
    let d=H.enrollment_draft let valid=false
    for effort in d.model.sharedReasoning {if effort==d.reasoning {valid=true}}
    if !valid {H.notice=A.error_text("management_model_unqualified") A.redraw() return}
    let tokens=d.tokens.trim().to_f64()
    if !(tokens>=1 && tokens<=9007199254740991) || floor(tokens)!=tokens {H.notice=A.t("Enter a whole number of tokens greater than zero.","请输入大于零的整数 token 数量。") A.redraw() return}
    let {sourceRequired=false}=H.enrollment_draft
    let {source=nil}=H.enrollment_draft
    if sourceRequired {
        if source==nil{H.notice=A.t("Return to this account and refresh its resources before confirming.","请返回账号刷新已有资源后，再确认创建。") A.redraw() return}
        A.submit("hagency.resources.create",{sourceResourceId:source.id expectedRevision:source.revision profile:{kind:"select" model:d.model.model reasoning:d.reasoning} ceiling:{kind:"monthly" tokens:tokens}})
    }else{A.submit("hagency.accounts.enroll",{account:d.account model:d.model.model reasoning:d.reasoning monthlyTokens:tokens})}
}
A.enrollment_tokens_changed=fn(text){
    if H.busy || H.command!=nil || H.enrollment_draft==nil{return}
    H.enrollment_draft.tokens=text
    if H.notice==A.t("Enter a whole number of tokens greater than zero.","请输入大于零的整数 token 数量。") {H.notice="" A.enrollment_hide_notice()}
}
A.enrollment_hide_notice=fn(){ui.notice.set_visible(false)}
A.enrollment_error=fn(code){
    if code=="provider_identity_unavailable" {return A.t("The provider did not return a supported quota-account identity. No resource can be enrolled from this account yet.","模型服务未返回受支持的额度账号标识，暂时无法从此账号登记资源。")}
    if code=="provider_account_changed" {return A.t("The provider account changed during verification. Refresh the account and review the model again.","验证期间模型服务账号发生变化，请刷新账号并重新选择模型。")}
    if code=="provider_connection_required" {return A.t("Sign in to this account before enrolling a resource.","请先登录此账号，再登记资源。")}
    return A.error_text(code)
}
A.load_account_models = fn(row){
    if H.busy || H.command!=nil || H.page!="provider_account" || H.account_id!=row.id || row.kind!="managed_namespace" || row.state!="active" {return}
    H.account_models=nil H.account_models_attempted=true H.account_models_epoch+=1
    let epoch=H.account_models_epoch let id=row.id let revision=row.revision
    H.busy=true H.notice="" A.redraw()
    host.request("hagency.accounts.models",{accountId:id expectedRevision:revision},fn(r){
        if H.account_models_epoch!=epoch {return}
        H.busy=false
        if H.page!="provider_account" || H.account_id!=id || H.account_detail==nil || H.account_detail.account.revision!=revision {A.redraw() return}
        if !r.is_ok {
            H.notice=A.account_models_error(r.error)
            if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        } else {
            let data=r.data
            if data.protocol!="hagency-management-v1" || data.accountId!=id || data.revision!=revision || data.provider.runtime!="codex" || data.provider.connected!=true {
                H.notice=A.t("The model response does not match this account. Refresh and try again.","模型结果与此账号不匹配，请刷新后重试。")
            } else {H.account_models=data H.notice=""}
        }
        A.redraw()
    })
}
A.retire_account = fn(row){
    if H.busy || H.command!=nil || H.page!="provider_account" || H.account_id!=row.id || row.kind!="managed_namespace" || row.state!="active" || row.resourceCount!=0 {return}
    H.account_models=nil H.account_models_attempted=false H.account_models_epoch+=1
    A.submit("hagency.accounts.retire",{accountId:row.id expectedRevision:row.revision})
}
A.retirement_error=fn(code){
    if code=="account_retirement_dependencies" {return A.t("This account is still associated with resources or a sign-in is in progress. Resolve those dependencies before retiring it.","此账号仍有关联资源或正在进行的登录，请先处理这些事项再停用。")}
    if code=="account_retirement_revision_changed" {return A.t("The account changed. Refresh its details before reviewing retirement again.","账号已变更，请刷新详情后重新确认停用。")}
    return A.error_text(code)
}
A.login_account = fn(row){
    if H.busy || row.kind!="managed_namespace" || row.state!="active" || row.resourceCount!=0 {return}
    if H.command!=nil {
        if H.command.service=="hagency.accounts.login" && H.command.args.accountId==row.id {A.retry_command()}
        return
    }
    H.account_models=nil H.account_models_attempted=false
    A.submit("hagency.accounts.login",{accountId:row.id expectedRevision:row.revision})
}
A.review_account_preparation = fn(){
    if H.busy || H.command!=nil {return}
    let page=H.page
    A.request("hagency.onboarding.status",{},fn(data){
        if H.page!=page || H.command!=nil {return}
        let {state=nil}=data
        if state!="active" {A.dev_open("pool_device_setup","accounts") return}
        H.page="account_prepare" H.notice="" A.redraw()
    })
}
A.submit_account_preparation = fn(){
    if H.busy || H.command!=nil || H.page!="account_prepare" {return}
    A.submit("hagency.accounts.prepare",{})
}
A.account_prepared = fn(data){
    H.page="provider_account" H.account_id=data.accountId H.account_resource_after=nil H.account_detail=nil H.ux.accountId=data.accountId A.save()
}
A.account_groups = fn(){
    let result={known:[] unconfirmed:[]}
    if H.account_inventory==nil {return result}
    for row in H.account_inventory.accounts {
        let {identityKey=nil}=row
        if identityKey==nil || identityKey=="" {result.unconfirmed.push(row)} else {
            let found=false
            for group in result.known {if group.key==identityKey && group.runtime==row.runtime {
                group.members.push(row) group.resources+=row.resourceCount found=true
            }}
            if !found {result.known.push({key:identityKey runtime:row.runtime members:[row] resources:row.resourceCount})}
        }
    }
    return result
}
A.read_account_page = fn(after,epoch,rows,pages){
    let args={} if after!=nil {args.after=after}
    A.request("hagency.accounts.list",args,fn(data){
        if H.page!="provider_accounts" || H.account_list_epoch!=epoch {return}
        if data.protocol!="hagency-management-v1" || data.account!=nil || data.accounts==nil {
            H.notice=A.t("The account list could not be read. Refresh to try again.","无法读取账号列表，请刷新重试。") return
        }
        for row in data.accounts {
            for previous in rows {if previous.id==row.id {H.notice=A.t("The account list changed. Refresh to try again.","账号列表已变更，请刷新重试。") return}}
            rows.push(row)
        }
        if rows.len()>256 {H.notice=A.t("Too many records to group safely.","记录过多，暂无法完整归组。") return}
        if data.nextAfter!=nil {
            if data.accounts.len()==0 || data.nextAfter!=data.accounts[data.accounts.len()-1].id || data.nextAfter==after || rows.len()>256 || pages>=32 {
                H.notice=A.t("The complete account list could not be read. Refresh to try again.","无法读取完整账号列表，请刷新重试。") return
            }
            A.read_account_page(data.nextAfter,epoch,rows,pages+1)
        } else {data.accounts=rows H.account_inventory=data}
    })
}
// Tab badges: what waits on each tab, from the pool list's counts or one light read of requests.
A.tab_badge=fn(tab){
    if H.entry_role!="owner" || H.session==nil {return 0}
    let m=H.pool_meta
    if tab=="inbox" {return if m!=nil && m.requests!=nil {A.pool_pending_total()} else {H.tab_requests}}
    if m==nil {return 0}
    // The same items as the list's "Needs you" section, each counted once; Agent requests
    // are the Agent 申请 tab's, so they badge that tab only.
    let items=A.pool_todo()
    let n={c:0}
    for item in items {if item.kind!="draft" && item.kind!="requests" {n.c=n.c+max(0,item.count)}}
    return n.c
}
A.tab_counts_load=fn(){
    if H.entry_role!="owner" || H.session==nil || !A.pool_enabled() {return}
    host.request("hagency.pools.agents.list",{after:nil needsMyAction:true},fn(r){
        if !r.is_ok {return}
        let {items=nil}=r.data
        if items==nil {return}
        let n={c:0}
        for q in items {let {canDecide=false,resourceOwnerMxid=nil}=q if canDecide==true && resourceOwnerMxid==H.session.account {n.c=n.c+1}}
        H.tab_requests=n.c
        ui.navigation.render()
    })
}
A.open_accounts = fn(after){
    if H.busy {return}
    H.account_list_epoch+=1
    H.page="provider_accounts" H.account_inventory=nil H.account_after=nil H.notice="" A.redraw()
    A.read_account_page(nil,H.account_list_epoch,[],0)
    A.tab_counts_load()
}
A.open_account = fn(id,after){
    if H.busy {return}
    if H.ux.resourceJourney {H.ux.accountId=id A.save()}
    if H.account_id!=id{H.owner.accountTab="login"}
    if H.owner.creatingPool{H.owner.accountTab="pools" H.owner.creatingPool=false}
    H.account_models=nil H.account_models_attempted=false
    H.page="provider_account" H.account_id=id H.account_resource_after=after H.account_detail=nil H.notice="" A.redraw()
    let args={id:id} if after!=nil {args.after=after}
    A.request("hagency.accounts.get",args,fn(data){
        if H.page!="provider_account" || H.account_id!=id || H.account_resource_after!=after {return}
        if data.protocol!="hagency-management-v1" || data.account==nil || data.account.id!=id {H.notice=A.t("The account changed or is no longer available to this profile.","账号已变更或当前身份无权查看。") return}
        H.account_detail=data
    })
}
A.load_providers = fn(){ A.request("hagency.providers.list", {}, fn(data){
    H.providers = data.providers
    if H.wizard.step == 2 && H.wizard.model != nil {
        let selected = H.wizard.model.id H.wizard.model = nil
        for provider in H.providers { if provider.runtime == H.wizard.runtime {
            for row in provider.models {if row.id == selected {H.wizard.model = row}}
        }}
    }
}) }
A.provider_selected = fn(runtime){
    if H.busy || H.command != nil { return }
    H.wizard.runtime = runtime H.wizard.model = nil H.wizard.reasoning = nil H.wizard.step = 2 A.save() A.redraw()
}
A.connect_provider = fn(runtime){
    A.request("hagency.providers.connect", {runtime: runtime}, fn(data){ A.load_providers() })
}
A.select_model = fn(row){
    if H.busy || H.command != nil { return }
    H.wizard.model = row H.wizard.reasoning = row.sharedDefaultReasoning A.save() A.redraw()
}
A.fields_changed = fn(name, value){
    if H.command != nil { return }
    if name == "tokens" { H.wizard.tokens = value }
    if name == "label" { H.wizard.label = value }
    A.save()
}
A.submit = fn(service, args){
    if H.busy || H.command != nil { return }
    H.ux.dashboard=nil
    A.request("hagency.intent.new", {}, fn(data){
        args.commandId = data.commandId
        H.command = {service: service args: args.to_json().parse_json()}
        if A.save() { A.retry_command() }
    })
}
A.acknowledge = fn(id){
    host.request("hagency.intent.acknowledge", {commandId:id}, fn(r){
        if r.is_ok {
            let remaining = []
            for row in H.saved_commands {if row.commandId != id {remaining.push(row)}}
            H.saved_commands = remaining
        } else {H.notice = A.t("The result remains saved. Refresh to recover it later.", "结果仍然保留，可刷新后恢复。")}
        A.redraw()
    })
}
A.recover_native = fn(row){
    if row.operation=="web_catalog"{A.open_saved_web(row) return}
    if A.personal_config_operation(row.operation){A.recover_personal_config(row.commandId,row.operation,"") return}
    if A.is_template_operation(row.operation){A.open_saved_template(row) return}
    if A.is_graph_operation(row.operation){A.open_saved_graph(row) return}
    if A.is_task_operation(row.operation){A.open_saved_task(row) return}
    A.request("hagency.intent.retry", {commandId:row.commandId}, fn(reply){
        let data = reply.data
        if row.operation=="revoke_tool_grant" && (reply.operation!=row.operation || !A.valid_tool_result(data,row.input)) {H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="review_stopped" && (reply.operation!=row.operation || !A.stopped_review_valid(data,row.input)){H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="resolve_stopped" && (reply.operation!=row.operation || !A.stopped_result_valid(data,row.input)){H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="clear_workspace_dirty" && (reply.operation!=row.operation || !A.valid_workspace_result(data,row.input)) {H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="edit_execution_policy" && (reply.operation!=row.operation || !A.valid_policy_result(data,row.input)) {H.notice=A.error_text("management_outcome_unknown") return}
        H.command = nil
        if reply.operation == "enroll_resource" {H.wizard.resource=data H.wizard.step=3 H.page="wizard"}
        else if reply.operation == "enroll_account_resource" {H.enrollment_draft=nil H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil}
        else if reply.operation == "retire_account" {A.account_prepared(data)}
        else if reply.operation == "prepare_account" {A.account_prepared(data)}
        else if reply.operation == "login_account" {
            A.account_prepared(data)
            if data.state=="starting" || data.state=="awaiting_authorization" || data.state=="stopping" {H.command={service:"hagency.accounts.login" args:row.input} A.save() A.open_account(H.account_id,nil) return}
        }
        else if reply.operation == "revoke_tool_grant" {A.tool_grant_received(data)}
        else if reply.operation == "review_stopped" {A.stopped_review_received(data)}
        else if reply.operation == "resolve_stopped" {A.stopped_result_received(data)}
        else if reply.operation == "clear_workspace_dirty" {A.workspace_received(data)}
        else if reply.operation == "edit_execution_policy" {A.policy_received(data)}
        else if reply.operation == "retire_approval_binding" {A.binding_received(data)}
        else if reply.operation == "triage_resource_alert" {H.page="resource_alert" H.alert_resource=data.resourceId H.alert_id=data.id H.alert_detail=nil H.alert_draft=nil}
        else if reply.operation == "edit_local_resource" {H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil H.resource_edit_draft=nil}
        else if reply.operation == "create_resource_configuration" {H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil H.resource_create_draft=nil if H.enrollment_draft!=nil{let {source=nil}=H.enrollment_draft if source!=nil && source.id==row.input.sourceResourceId{H.enrollment_draft=nil}}}
        else if reply.operation == "rename_resource" {H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil H.resource_name_mode="" H.resource_name_draft=nil}
        else if reply.operation == "personal_agent_policy" {A.personal_saved(data)}
        else if reply.operation == "personal_agent_observation" {A.personal_observation_received(data)}
        else if A.topup_operation(reply.operation) {A.topup_received(data)}
        else if reply.operation == "agent_settlement_request" {H.page="agent_removal" H.removal_id=data.requested.requestId H.removal=nil H.settlement=nil}
        else if reply.operation == "agent_run_control" {H.control_assignment=data.control.assignmentId H.agent_control=nil H.page="agent_control"}
        else if reply.operation == "configure_resource" || reply.operation == "publish_resource" {H.page="resources"}
        else if reply.operation=="pool_agent_request" || reply.operation=="pool_agent_decide" || reply.operation=="pool_agent_stop" {H.pool_detail=data.request H.pool_draft=nil H.pool_confirm="" H.page="pool_agent"}
        else if reply.operation == "project_request" || reply.operation == "project_decide" || reply.operation == "project_revoke" {
            H.project_selected=data.project H.page="project_action" H.confirm=""
            if reply.operation == "project_request" {A.clear_requested_draft(data.project)}
        }
        else if reply.operation == "allocation_decide" || reply.operation == "allocation_release" {H.allocation_id=data.allocation.id H.page="allocation_action" H.allocation_detail=nil H.allocation_confirmation=""}
        else if reply.operation == "agent_request" || reply.operation == "agent_decide" || reply.operation == "agent_cancel" || reply.operation == "agent_revoke" {
            A.agent_received(data.agentRequest)
            if reply.operation == "agent_request" {A.clear_agent_draft(data.agentRequest)}
            if A.cleanup_enabled() && (reply.operation == "agent_cancel" || reply.operation == "agent_revoke") {H.page="agent_removal" H.removal_id=data.agentRequest.id H.removal=nil}
        }
        else {H.selected=data.admission H.page="action" H.confirm="" if reply.operation=="reoffer" {H.reoffer_draft=nil}}
        if A.save() {A.acknowledge(row.commandId)}
        if H.page == "agent_topup" {A.open_topup(H.budget_topup_id)}
        if H.page == "agent_control" {A.open_agent_control(H.control_assignment,H.control_agent_name)}
        if H.page == "action" {A.open_connection(data.admission.contribution.id)}
        if H.page == "project_action" {A.open_project(data.project.id)}
        if H.page == "agent_action" {A.open_agent(data.agentRequest.id)}
        if H.page == "agent_removal" {A.open_removal(H.removal_id)}
        if H.page == "allocation_action" {A.open_allocation(data.allocation.id)}
        if H.page == "provider_account" {A.open_account(H.account_id,nil)}
        if H.page=="resource_alert" {A.open_alert(data.resourceId,data.id,0)}
        if H.page == "resource_detail" {A.open_resource(data.resourceId)}
        if H.page == "personal_agent" {A.open_personal_agent(data.agentId)}
        if H.page == "resources" {A.refresh()}
    })
}
A.saved_label = fn(operation){
    if operation=="web_catalog"{return A.t("Public listing and defaults","对外展示与默认设置")}
    if A.personal_config_operation(operation){return A.t("Local-agent model, workspace or tool rules","本地 Agent 模型、工作区或工具规则")}
    if A.is_template_operation(operation){return A.t("Saved agent template change","已保存的 Agent 模板更改")}
    if A.is_graph_operation(operation){return A.t("Saved graph change","已保存的任务图更改")}
    if A.is_task_operation(operation){return A.t("Saved task change", "已保存的任务更改")}
    if A.topup_operation(operation) {return A.t("Agent budget request", "Agent 额度申请")}
    if operation == "agent_settlement_request" {return A.t("Agent accounting recheck", "Agent 重新核算")}
    if operation == "agent_run_control" {return A.t("Automatic reply setting", "自动回复设置")}
    if operation == "login_account" {return A.t("Provider sign-in", "模型服务登录")}
    if operation == "retire_account" {return A.t("Retire account space","停用账号空间")}
    if operation == "prepare_account" {return A.t("Prepare provider account", "准备模型服务账号")}
    if operation == "revoke_tool_grant" {return A.t("Revoke tool permission","撤销工具权限")}
    if operation == "review_stopped" {return A.t("Interrupted task inspection","中断任务检查")}
    if operation == "resolve_stopped" {return A.t("Interrupted task decision","中断任务处理")}
    if operation == "clear_workspace_dirty" {return A.t("Workspace recovery","工作区恢复")}
    if operation == "edit_execution_policy" {return A.t("Agent execution permissions","Agent 执行权限")}
    if operation == "retire_approval_binding" {return A.t("Remove approval room","移除审批聊天")}
    if operation == "triage_resource_alert" {return A.t("Resource alert update","资源告警处理")}
    if operation == "edit_local_resource" {return A.t("Resource configuration", "资源配置")}
    if operation == "rename_resource" {return A.t("Local resource name", "资源本地名称")}
    if operation == "personal_agent_observation" {return A.t("Read current local-agent settings", "读取本地 Agent 当前设置")}
    if operation == "personal_agent_policy" {return A.t("Local-agent policy change", "本地 Agent 策略修改")}
    if operation == "allocation_decide" {return A.t("Project allocation decision", "项目分配决定")}
    if operation == "allocation_release" {return A.t("Project allocation release", "项目分配释放")}
    if operation == "agent_request" {return A.t("Agent request", "Agent 申请")}
    if operation == "agent_decide" {return A.t("Agent decision", "Agent 审批")}
    if operation == "agent_revoke" {return A.t("Agent revocation", "撤销 Agent")}
    if operation == "agent_cancel" {return A.t("Agent request cancellation", "取消 Agent 申请")}
    if operation == "project_request" {return A.t("Project request", "项目申请")}
    if operation == "project_decide" {return A.t("Project decision", "项目审批")}
    if operation == "project_revoke" {return A.t("Project withdrawal", "项目撤回")}
    if operation == "enroll_resource" || operation == "enroll_account_resource" {return A.t("Resource setup", "资源设置")}
    if operation == "reoffer" {return A.t("New admission request", "新加入申请")}
    if operation == "contribute" {return A.t("Admission request", "加入申请")}
    if operation == "decide" {return A.t("Admission decision", "加入决定")}
    if operation == "revoke" {return A.t("Connection revocation", "连接撤销")}
    if operation == "resume" {return A.t("Device reconnection", "设备重新连接")}
    if operation == "verify" {return A.t("Connection verification", "连接验证")}
    return A.t("Resource update", "资源更新")
}
A.retry_command = fn(){
    if H.busy || H.command == nil { return }
    let command = H.command
    if A.personal_config_service(command.service){
        if A.recipient_optional(command,"nativeRecover")==true{A.recover_personal_config(command.args.commandId,A.personal_config_op(command.service),command.args.agentId) return}
        command.nativeRecover=true
        if !A.save(){return}
    }
    H.busy = true H.notice = A.t("Submitting your saved request…", "正在提交已保存的请求…") A.redraw()
    host.request(command.service, command.args, fn(r){
        if A.web_connection_service(command.service){A.web_connection_reply(command,r) return}
        if A.personal_config_service(command.service){A.personal_config_reply(command,r) return}
        H.busy = false
        if command.service=="hagency.resources.publish" && !r.is_ok && r.error=="management_resource_in_use" {
            H.command=nil H.notice=A.t("This configuration has active allocations or another owner. Its saved definition must stay unchanged. Use the listing to control new requests.","此配置正被使用或属于其他所有者，已保存的设置不能改。可以在「对外展示」里控制新的申请。")
            if A.save(){A.acknowledge(command.args.commandId)} A.redraw() return
        }
        if command.service=="hagency.tool_grants.revoke" {A.tool_grant_reply(command,r) return}
        if command.service=="hagency.stopped.review" || command.service=="hagency.stopped.resolve" {A.stopped_reply(command,r) return}
        if command.service=="hagency.workspaces.clear_dirty" {A.workspace_reply(command,r) return}
        if command.service=="hagency.execution_policy.edit" {A.policy_reply(command,r) return}
        if command.service=="hagency.approval_bindings.retire" {A.binding_reply(command,r) return}
        if r.is_ok {
            H.command = nil H.notice = ""
            if A.topup_service(command.service) {A.topup_received(r.data)}
            if command.service == "hagency.accounts.prepare" || command.service == "hagency.accounts.login" || command.service == "hagency.accounts.retire" {A.account_prepared(r.data)}
            if command.service == "hagency.resources.edit" {H.resource_edit_draft=nil H.resource_detail=nil H.pool_edit=nil H.pool_saved=A.pool_saved_note(command.args,r.data)}
            if command.service == "hagency.resources.create" {H.resource_create_draft=nil H.resource_detail=nil H.pool_create=nil if H.enrollment_draft!=nil{let {source=nil}=H.enrollment_draft if source!=nil && source.id==command.args.sourceResourceId{H.enrollment_draft=nil}}}
            if command.service == "hagency.resources.rename" {H.resource_name_mode="" H.resource_name_draft=nil H.resource_detail=nil}
            if command.service == "hagency.personal_agents.policy.save" {A.personal_saved(r.data)}
            if command.service == "hagency.personal_agents.observe" {A.personal_observation_received(r.data)}
            if command.service=="hagency.accounts.enroll" {H.enrollment_draft=nil H.pool_create=nil H.page="resource_detail" H.resource_id=r.data.resourceId H.resource_detail=nil}
            if command.service == "hagency.resources.enroll" {H.wizard.resource = r.data H.wizard.step = 3 H.page = "wizard"}
            if command.service == "hagency.connections.create" {H.wizard.admission = r.data.admission H.wizard.step = 4 H.page = "wizard"}
            if command.service=="hagency.connections.reoffer" {H.reoffer_draft=nil}
            if command.service == "hagency.inbox.decide" || command.service == "hagency.connections.revoke" || command.service=="hagency.connections.reoffer" {H.selected = r.data.admission H.confirm = "" H.page = "action"}
            if command.service=="hagency.pools.agents.decide" {A.reqs_decided(command.args,r.data.request)}
            if command.service=="hagency.pools.agents.stop" && A.reqs_page() {A.reqs_stopped(command.args,r.data.request)}
            if A.pool_mutation(command.service) {
                // A decision made on a request list stays on that list.
                let inline=(command.service=="hagency.pools.agents.decide" || command.service=="hagency.pools.agents.stop") && A.reqs_page() && H.reqs.deciding==command.args.requestId
                H.pool_draft=nil H.pool_confirm="" H.reqs.confirm=nil H.reqs.deciding=""
                if !inline {H.pool_detail=r.data.request H.page="pool_agent"}
            }
            if command.service == "hagency.projects.request" || command.service == "hagency.projects.decide" || command.service == "hagency.projects.revoke" {
                H.project_selected = r.data.project H.page = "project_action" H.confirm = ""
                if command.service == "hagency.projects.request" {H.project_draft = {step:0 resource:nil name:"" purpose:"" tokens:"100000"}}
            }
            if command.service == "hagency.agents.request" || command.service == "hagency.agents.decide" || command.service == "hagency.agents.cancel" || command.service == "hagency.agents.revoke" {
                A.agent_received(r.data.agentRequest)
                if command.service == "hagency.agents.request" {A.clear_agent_draft(r.data.agentRequest)}
            }
            if command.service == "hagency.allocations.decide" || command.service == "hagency.allocations.release" {H.page="allocation_action" H.allocation_id=r.data.allocation.id H.allocation_detail=nil H.allocation_confirmation=""}
            if command.service == "hagency.agents.control.set" {H.control_assignment=r.data.control.assignmentId H.agent_control=nil H.page="agent_control"}
            if command.service == "hagency.agents.settlement.request" {H.page="agent_removal" H.removal_id=r.data.requested.requestId H.removal=nil H.settlement=nil}
            if A.save() && !(command.service=="hagency.accounts.login" && r.data.recorded==false) {A.acknowledge(command.args.commandId)}
            if command.service == "hagency.agents.settlement.request" {A.open_removal(H.removal_id)}
            if A.topup_service(command.service) {A.open_topup(H.budget_topup_id)}
            if command.service == "hagency.agents.control.set" {A.open_agent_control(H.control_assignment,H.control_agent_name)}
            if command.service == "hagency.accounts.prepare" || command.service == "hagency.accounts.login" || command.service == "hagency.accounts.retire" {A.open_account(H.account_id,nil)}
            if command.service=="hagency.accounts.enroll" {A.open_resource(r.data.resourceId)}
            if command.service == "hagency.alerts.triage" {H.alert_saved={id:r.data.id to:command.args.to} A.open_alert(r.data.resourceId,r.data.id,0)}
            if command.service=="hagency.resources.publish" {A.open_resource(command.args.resourceId)}
            if command.service=="hagency.resources.edit" && H.page=="default_policy" {A.dpol_saved(command.args)}
            if command.service == "hagency.resources.rename" || (command.service=="hagency.resources.edit" && H.page!="default_policy") || command.service=="hagency.resources.create" {A.open_resource(r.data.resourceId)}
            if (command.service=="hagency.pools.agents.decide" || command.service=="hagency.pools.agents.stop") && A.reqs_page() {A.reqs_load(nil)}
            if command.service=="hagency.pools.agents.decide" || command.service=="hagency.pools.agents.stop" {A.reqs_counts_reload()}
            if command.service == "hagency.personal_agents.policy.save" || command.service == "hagency.personal_agents.observe" {A.open_personal_agent(r.data.agentId)}
            if A.cleanup_enabled() && (command.service == "hagency.agents.cancel" || command.service == "hagency.agents.revoke") {A.open_removal(r.data.agentRequest.id)}
            if command.service == "hagency.allocations.decide" || command.service == "hagency.allocations.release" {A.open_allocation(r.data.allocation.id)}
            if command.service=="hagency.connections.reoffer" || command.service == "hagency.connections.create" || command.service == "hagency.inbox.decide" || command.service == "hagency.connections.revoke" || command.service == "hagency.connections.verify" || command.service == "hagency.connections.resume" { A.open_connection(r.data.admission.contribution.id) }
            if command.service == "hagency.projects.request" || command.service == "hagency.projects.decide" || command.service == "hagency.projects.revoke" {A.open_project(r.data.project.id)}
        } else {
            if A.pool_mutation(command.service) {
                H.notice=A.pool_reason(r.error) H.reqs.confirm=nil H.reqs.deciding=""
                if command.service=="hagency.pools.agents.request" && H.pool_draft!=nil {H.pool_draft.failure=r.error A.save()}
                for code in ["invalid_pool_agent_room","invalid_managed_agent_definition","invalid_management_revision","management_revision_changed","pool_capacity_unavailable","pool_not_shared_with_account","pool_agent_resource_mismatch","pool_resource_owner_required","pool_agent_request_closed","pool_agent_authority_changed","pool_agent_request_capacity","management_receipt_capacity"] {
                    if r.error==code {
                        H.command=nil
                        if command.service=="hagency.pools.agents.request" && H.pool_draft!=nil {H.pool_draft.review=false H.pool_checked=false H.page="pool_apply"}
                        if A.save(){A.acknowledge(command.args.commandId)}
                    }
                }
                A.redraw() return
            }
            if command.service=="hagency.connections.reoffer" {
                H.notice=A.readmission_error(r.error)
                if A.reoffer_not_applied(r.error) {
                    H.command=nil
                    if H.reoffer_draft!=nil {H.reoffer_draft.review=false}
                    if A.save() {A.acknowledge(command.args.commandId)}
                }
                A.redraw() return
            }
            if command.service=="hagency.resources.edit" {
                if (r.error=="resource_edit_cancelled" || r.error=="provider_confirmation_expired") && A.recipient_optional(command.args,"ceiling")!=nil && H.page=="resource_detail" && H.resource_detail!=nil && H.resource_detail.resource.id==command.args.resourceId {
                    // The maximum's window was closed before confirming: said beside the maximum, nothing changed.
                    H.command=nil H.pool_before=nil H.pool_offer=nil A.save()
                    A.pool_say("max","waiting",A.t("Not saved: the confirmation window was closed, so the monthly maximum didn’t change.","没有保存：确认窗口已关闭，每月上限没有改动。"))
                    host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                } else if r.error=="resource_edit_cancelled" || r.error=="provider_confirmation_expired" {
                    H.command=nil H.notice=A.t("Configuration review closed. Existing saved requests remain available for recovery.","已关闭配置确认，已有的保存请求仍可恢复。") A.save()
                    host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                } else if A.recipient_optional(command.args,"expectedCeilingSequence")!=nil {
                    // A monthly-maximum change of an offered pool: say why inline, beside its controls.
                    let rid=command.args.resourceId
                    H.pool_offer=nil H.pool_before=nil
                    A.pool_say("max","attention",A.ceiling_refusal(r.error,H.resource_detail))
                    if A.resource_edit_not_applied(r.error) {H.command=nil if A.save(){A.acknowledge(command.args.commandId)}}
                    if (r.error=="management_resource_edit_changed" || r.error=="management_ceiling_amendment_not_available") && H.page=="resource_detail" && H.command==nil {H.pool_saved={rid:rid at:"max" tone:"attention" text:H.pool_result.text} H.pool_edit=nil A.open_resource(rid)}
                } else if A.recipient_optional(command.args,"ceiling")!=nil && H.page=="resource_detail" {
                    // A maximum set before the pool is offered: refused beside the maximum too.
                    H.pool_before=nil
                    A.pool_say("max","attention",A.t("Not saved: ","没有保存：")+A.resource_edit_error(r.error))
                    if A.resource_edit_not_applied(r.error) {H.command=nil if A.save(){A.acknowledge(command.args.commandId)}}
                } else {
                    H.notice=A.resource_edit_error(r.error)
                    if A.resource_edit_not_applied(r.error) {H.command=nil if A.save(){A.acknowledge(command.args.commandId)}}
                }
                A.redraw() return
            }
            if command.service=="hagency.resources.create" {
                if r.error=="resource_create_cancelled" || r.error=="provider_confirmation_expired" {
                    H.command=nil H.notice=A.t("Creation review closed. Existing saved requests remain available for recovery.","已关闭创建确认，已有的保存请求仍可恢复。") A.save()
                    host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                } else {
                    H.notice=A.resource_create_error(r.error)
                    if A.resource_create_not_applied(r.error) {H.command=nil if A.save(){A.acknowledge(command.args.commandId)}}
                }
                A.redraw() return
            }
            if command.service=="hagency.accounts.retire" && (r.error=="account_retirement_cancelled" || r.error=="provider_confirmation_expired") {
                H.command=nil H.notice=A.t("Retirement review closed. Existing saved requests are unchanged.","已关闭停用确认，已有的保存请求保持不变。") A.save()
                host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                A.redraw() return
            }
            if command.service=="hagency.accounts.retire" && (r.error=="account_retirement_dependencies" || r.error=="account_retirement_revision_changed") {
                H.command=nil H.notice=A.retirement_error(r.error)
                if A.save(){A.acknowledge(command.args.commandId)} A.redraw() return
            }
            if command.service=="hagency.accounts.enroll" && (r.error=="resource_enrollment_cancelled" || r.error=="provider_confirmation_expired" || r.error=="resource_adoption_required") {
                H.command=nil H.notice=if r.error=="resource_enrollment_cancelled" {A.t("Resource review closed. Existing saved requests are unchanged.","已关闭资源确认，已有的保存请求保持不变。")}else if r.error=="resource_adoption_required" {A.t("Finish device setup before enrolling resources from this account.","请先完成设备设置，再从此账号登记资源。")}else{A.error_text(r.error)}
                A.save()
                host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                A.redraw() return
            }
            if command.service=="hagency.accounts.enroll" && (r.error=="provider_identity_unavailable" || r.error=="provider_account_changed") {
                H.command=nil H.notice=A.enrollment_error(r.error)
                if A.save(){A.acknowledge(command.args.commandId)} A.redraw() return
            }
            if r.error == "native_resume_missing" || r.error == "native_resume_revoked" {H.needs_signin=true}
            let topup_service=A.topup_service(command.service)
            let name_service=command.service == "hagency.resources.rename"
            let agent_service=command.service == "hagency.agents.request" || command.service == "hagency.agents.decide" || command.service == "hagency.agents.cancel" || command.service == "hagency.agents.revoke"
            let personal_service=command.service == "hagency.personal_agents.policy.save" || command.service == "hagency.personal_agents.observe"
            let allocation_service=command.service == "hagency.allocations.decide" || command.service == "hagency.allocations.release"
            if command.service == "hagency.agents.control.set" {H.agent_control=nil}
            if command.service == "hagency.agents.settlement.request" {H.settlement=nil}
            if command.service=="hagency.alerts.triage" {H.alert_detail=nil H.alert_draft=nil}
            H.notice = if command.service=="hagency.alerts.triage" {A.alert_error(r.error)} else if command.service=="hagency.accounts.retire" {A.retirement_error(r.error)} else if command.service=="hagency.accounts.enroll" {A.enrollment_error(r.error)} else if command.service == "hagency.agents.settlement.request" {A.settlement_reason(r.error)} else if topup_service {A.budget_reason(r.error)} else if command.service == "hagency.agents.control.set" {A.control_reason(r.error)} else if name_service {A.name_error(r.error)} else if personal_service {A.personal_reason(r.error)} else if allocation_service {A.allocation_reason(r.error)} else if agent_service {A.agent_reason(r.error)} else {A.error_text(r.error)}
            if topup_service {H.agent_budget=nil H.budget_topup=nil H.budget_confirmation=nil H.budget_mode=""}
            if name_service {H.resource_detail=nil H.resource_name_mode="" H.resource_name_draft=nil}
            let kept_draft=H.personal_draft
            if personal_service {H.personal_detail=nil H.personal_draft=nil H.personal_mode="detail"}
            let personal_refused=personal_service && A.personal_not_applied(command.service,r.error)
            if personal_refused {
                H.local_failure=command.service H.local_failure_reason=H.notice H.local_failure_code=r.error H.notice=""
                H.local_kept=if command.service=="hagency.personal_agents.policy.save" {kept_draft} else {nil}
            }
            if allocation_service {H.allocation_detail=nil H.allocation_confirmation=""}
            if agent_service {H.removal=nil H.removal_confirmation="" H.agent_readiness=nil H.agent_selected=nil H.agent_confirmation="" H.agent_review=false}
            if (command.service=="hagency.accounts.prepare" && (r.error=="device_setup_required" || r.error=="onboarding_unavailable")) || (command.service == "hagency.agents.settlement.request" && (r.error == "agent_settlement_changed" || r.error == "agent_settlement_not_ready")) || (command.service=="hagency.alerts.triage" && (r.error=="management_not_found" || r.error=="management_revision_conflict" || r.error=="invalid_management_arguments")) || A.topup_not_applied(command.service,r.error) || A.name_not_applied(command.service,r.error) || (personal_service && A.personal_not_applied(command.service,r.error)) || ((command.service == "hagency.accounts.prepare" || command.service == "hagency.accounts.login") && r.error == "invalid_management_arguments") || (!topup_service && !name_service && !personal_service && command.service != "hagency.accounts.prepare" && command.service != "hagency.accounts.login" && (A.allocation_not_applied(command.service,r.error) || A.agent_not_applied(command.service,r.error) || A.project_not_applied(command.service, r.error) || r.error == "management_model_unqualified" || r.error == "invalid_management_arguments" || r.error == "invalid_resource_selection" || r.error == "provider_model_changed" || r.error == "provider_connection_required" || r.error == "invalid_management_user" || r.error == "invalid_resource_offer" || r.error == "management_revision_changed" || r.error == "management_revision_conflict" || r.error == "management_action_closed" || r.error == "contribution_already_exists" || r.error == "management_executor_changed" || r.error == "contribution_resource_changed" || r.error == "provider_account_verification_required" || r.error == "contribution_not_admitted" || r.error == "contribution_executor_required" || r.error == "contribution_executor_current" || r.error == "contribution_executor_changed")) {
                H.command = nil
                if command.service == "hagency.agents.settlement.request" {H.page="agent_removal" H.removal_id=r.data.requested.requestId H.removal=nil H.settlement=nil}
            if A.save() {A.acknowledge(command.args.commandId)}
            }
            if personal_refused {A.open_personal_agent(command.args.agentId)}
        }
        A.redraw()
    })
}
A.enroll = fn(){
    if H.wizard.model == nil { H.notice = A.t("Choose a model first.", "请先选择模型。") A.redraw() return }
    let qualified = false
    for effort in H.wizard.model.sharedReasoning { if effort == H.wizard.reasoning {qualified = true} }
    if !qualified {H.notice = A.error_text("management_model_unqualified") A.redraw() return}
    let tokens = H.wizard.tokens.trim().to_f64()
    if !(tokens >= 1 && tokens <= 9007199254740991) || floor(tokens) != tokens {H.notice = A.t("Enter a whole number of tokens greater than zero.", "请输入大于零的整数 token 数量。") A.redraw() return}
    A.submit("hagency.resources.enroll", {runtime: H.wizard.runtime modelId: H.wizard.model.id reasoning: H.wizard.reasoning monthlyTokens: tokens})
}
A.contribute = fn(){
    H.wizard.label = H.wizard.label.trim()
    if H.wizard.label == "" { H.notice = A.t("Enter the name to show on the server.", "请填写在服务器上显示的名称。") A.redraw() return }
    A.submit("hagency.connections.create", {resourceId: H.wizard.resource.resourceId expectedRevision: H.wizard.resource.revision label: H.wizard.label coordinatorMxid: H.session.account})
}
A.resource_connection=fn(row){
    if H.busy || H.command!=nil{return}
    H.ux.resourceJourney=true A.save() A.find_resource_connection(row,nil,[])
}
A.find_resource_connection=fn(row,after,seen){
    A.request("hagency.connections.list",{after:after},fn(v){
        A.connections_received(v)
        for connection in v.items {if connection.resourceId==row.id && connection.ownerMxid==H.session.account && connection.executorDeviceId==H.session.device {A.open_connection(connection.id) return}}
        if v.nextAfter!=nil {
            let repeated=false for cursor in seen {if cursor==v.nextAfter{repeated=true}}
            if repeated || seen.len()>=32 {H.notice=A.t("Connection lookup is incomplete. Refresh before connecting this resource.","连接查询尚未完成，请刷新后再连接此资源。") return}
            seen.push(v.nextAfter) A.find_resource_connection(row,v.nextAfter,seen) return
        }
        A.connect_existing(row)
    })
}
A.connect_existing = fn(row){
    if H.busy || H.command != nil {return}
    for connection in H.connections {
        if connection.resourceId == row.id && connection.ownerMxid == H.session.account && connection.executorDeviceId == H.session.device { H.page = "action" A.open_connection(connection.id) return }
    }
    H.wizard = {step: 3 runtime: row.framework model: nil reasoning: row.reasoning tokens: "" label: A.resource_title(row) coordinator: "" resource: {resourceId: row.id revision: row.revision} admission: nil}
    H.page = "wizard" A.save() A.redraw()
}
A.open_connection = fn(id){
    let origin = if H.page == "project_action" && H.project_selected != nil && H.project_selected.contributionId == id {H.project_selected.id} else if H.page == "action" && H.selected != nil && H.selected.contribution.id == id {H.connection_project} else {nil}
    if H.busy{return}
    if H.page!="action" || H.ux.connectionId!=id {H.bar_past=false}
    H.ux.connectionId=id
    if H.page!="wizard"{H.selected=nil H.connection_project=origin H.page="action" H.confirm=""}
    A.request("hagency.connections.get", {id: id}, fn(data){
        if data.admission.contribution.id!=id{H.notice=A.t("Connection details changed. Refresh and open the resource again.","连接详情已变化，请刷新后重新打开资源。") return}
        let found = false
        for index in H.connections.len() {if H.connections[index].id == data.admission.contribution.id {H.connections[index] = data.admission.contribution found = true}}
        if !found && H.connections.len() < 32 {H.connections.push(data.admission.contribution)}
        if H.page == "wizard" {H.wizard.admission = data.admission A.save()}
        else {H.selected = data.admission H.connection_project = origin H.page = "action" H.confirm = ""}
        A.observe_verification(data.admission.contribution, data.observedAtMs)
        A.load_connection_capacity(data.admission.contribution)
    })
}
A.open_request = fn(id){
    if H.busy {return}
    if H.page=="inbox" {H.ux.origin="inbox"} else if H.page=="overview" {H.ux.origin="overview"}
    A.request("hagency.inbox.get", {id: id}, fn(data){
        if data.request.kind == "project_allocation" {H.allocation_from_inbox=true A.open_allocation(data.request.allocationId)}
        else if data.request.kind == "project_capacity" {A.open_project(data.request.projectId)}
        else {A.open_connection(data.request.contributionId)}
    })
}
A.decide = fn(approve){
    if H.selected == nil || !H.selected.request.canDecide {return}
    A.submit("hagency.inbox.decide", {requestId: H.selected.request.id expectedRevision: H.selected.request.revision approve: approve})
}
A.revoke = fn(){A.submit("hagency.connections.revoke", {contributionId: H.selected.contribution.id expectedRevision: H.selected.contribution.revision})}
A.verify = fn(connection){
    if !A.can_verify(connection) {return}
    A.submit("hagency.connections.verify", {contributionId: connection.id expectedRevision: connection.revision resourceId: connection.resourceId resourceRevision: connection.resourceRevision})
}
A.resume = fn(connection){
    if !A.can_resume(connection) {return}
    A.submit("hagency.connections.resume", {contributionId:connection.id expectedRevision:connection.revision resourceId:connection.resourceId resourceRevision:connection.resourceRevision})
}
A.more = fn(){
    if H.page == "resources" && H.resource_after != nil {
        H.ux.resourceCursor=H.resource_after
        A.owner_load_pools()
    }
    if H.page == "connections" && H.connection_after != nil {A.request("hagency.connections.list", {after:H.connection_after}, A.connections_received)}
    if H.page == "inbox" && H.inbox_after != nil {H.ux.inboxCursor=H.inbox_after A.request("hagency.inbox.list", {after:H.inbox_after needsMyAction:H.needs_action includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()}, fn(data){H.inbox=data.items H.inbox_after=data.nextAfter})}
    if H.page == "projects" && H.project_after != nil {H.ux.projectCursor=H.project_after A.request("hagency.projects.list", {after:H.project_after}, fn(data){H.projects=data.items H.project_after=data.nextAfter})}
    if H.page == "project_wizard" && H.catalog_after != nil {
        let args = {after:H.catalog_after} if H.catalog_capability != "" {args.capability=H.catalog_capability}
        A.request("hagency.resources.catalog", args, fn(data){H.catalog=data.items H.catalog_after=data.nextAfter})
    }
}
A.progress_ratio=fn(used,total){if used==nil || total==nil || total<=0{return 0.0} return max(0.0,min(1.0,used/total))}
A.tokens=fn(value){
    if value==nil{return A.t("Unknown","未知")}
    let original=(""+value).to_chars() let digits="".to_chars() let zero="0".to_chars()[0]
    for i in max(0,7-original.len()){digits.push(zero)}
    for char in original{digits.push(char)}
    let split=digits.len()-6 let whole="".to_chars() let fraction="".to_chars() let last=split-1
    for i char in digits{if i<split{whole.push(char)}else if char!=zero{last=i}}
    for i char in digits{if i>=split && i<=last{fraction.push(char)}}
    return whole.to_string()+if fraction.len()==0{" M"}else{"."+fraction.to_string()+" M"}
}
A.amount = fn(value){
    if value==nil{return A.t("Unknown","未知")}
    let text=""+value
    if value<1000 || floor(value)!=value{return text}
    let chars=text.to_chars() let result="".to_chars() let comma=",".to_chars()
    for i char in chars {if i>0 && (chars.len()-i)%3==0{result.push(comma[0])} result.push(char)}
    return result.to_string()
}

A.capability_label = fn(value){
    if value == "architect" {return A.t("Architecture", "架构")}
    if value == "review" {return A.t("Review", "评审")}
    if value == "coding" {return A.t("Coding", "编程")}
    if value == "testing" {return A.t("Testing", "测试")}
    if value == "integration" {return A.t("Integration", "集成")}
    if value == "documentation" {return A.t("Documentation", "文档")}
    return value
}
A.reasoning_label = fn(value){
    if value == nil {return A.t("Default", "默认")}
    if value == "none" {return A.t("None", "无")}
    if value == "low" {return A.t("Low", "低")}
    if value == "medium" {return A.t("Medium", "中")}
    if value == "high" {return A.t("High", "高")}
    if value == "xhigh" {return A.t("Extra high", "极高")}
    if value == "max" {return A.t("Maximum", "最大")}
    if value == "ultra" {return A.t("Ultra", "超高")}
    return value
}
A.route_identity=fn(){
    if H.page=="pool_agent" && H.pool_detail!=nil{return H.pool_detail.id}
    if H.page=="health_hub" {return H.health.resource}
    if H.page=="resource_alert" {return H.alert_id+if H.alert_saved!=nil {"/saved"} else {""}}
    if A.tools_hub_page() {return H.tools_resource}
    if H.page=="resource_detail" {return H.resource_id}
    if A.pool_sub_page() {return H.pool_sub_rid}
    if H.page=="project_action" && H.project_selected!=nil {return H.project_selected.id}
    if H.page=="action" {return H.ux.connectionId}
    if H.page=="inbox" {return H.owner.poolId+"/"+H.needs_action+"/"+H.ux.inboxCursor+"/"+H.ux.agentCursor}
    if H.page=="resources" {return H.owner.accountId+"/"+H.capability+"/"+H.ux.resourceCursor}
    if H.page=="projects" {return ""+H.ux.projectCursor}
    if H.page=="provider_account" {return H.account_id+"/"+H.owner.accountTab}
    return ""
}
A.has_page=fn(pages){for page in pages {if H.page==page{return true}} return false}
A.entry_allowed=fn(role){
    if H.session==nil{return false}
    if role=="manager" || role=="owner"{return true}
    return role=="admin" && H.session.canAdmitResources
}
A.entry_label=fn(role){
    if role=="manager"{return A.t("Agent manager","Agent 管理者")}
    if role=="owner"{return A.t("Resource owner","资源所有者")}
    if role=="admin"{return A.t("Server admin","服务器管理员")}
    return A.t("Choose a workspace","选择工作台")
}
A.entry_choose=fn(role){
    if H.busy || !A.entry_allowed(role){return}
    if role!=H.entry_role{H.needs_action=true H.ux.inboxCursor=nil H.ux.agentCursor=nil}
    H.entry_role=role H.entry_choosing=false H.page="overview" H.notice=""
    A.save() A.redraw()
    if role=="owner" && H.command==nil{A.open_accounts(nil)}
}
A.entry_switch=fn(){if H.busy{return} H.entry_choosing=true H.page="overview" H.notice="" A.redraw()}
A.entry_parent=fn(){
    if H.page=="overview"{return "overview"}
    if H.entry_role=="owner" && (H.page=="pool_agent" || H.page=="pool_requests") && H.nav.stack.len()>0 && H.nav.stack[0].key=="resources" {return "resources"}
    if H.ux.origin=="inbox" || H.page=="inbox"{return "inbox"}
    if H.entry_role=="owner" && A.has_page(["pool_agents","pool_agent","agent_budget","agent_topup"]){return "inbox"}
    if A.has_page(["provider_accounts","provider_account","account_prepare","account_enrollment"]){return "accounts"}
    if H.page=="device_execution" || H.page=="onboarding"{return if H.device_from=="pool_device" {"resources"} else {"accounts"}}
    if A.dev_page(){return if H.pool_device_from=="accounts" {"accounts"} else {"resources"}}
    if A.has_page(["connections","connection_history","connection_reoffer","web_connections","web_connection","web_connection_new"]){return if H.entry_role=="admin"{"servers"}else{"resources"}}
    if A.has_page(["tools","operator_tasks","operator_task","operator_task_edit","operator_task_command","operator_board","operator_graphs","operator_graph","operator_graph_node","operator_graph_edit","operator_graph_edit_node","operator_graph_command","operator_graph_recipient","operator_graph_update","graph_archives","graph_history","history_graph","history_node","web_overview"]){return "work"}
    return A.nav_parent()
}
A.nav_parent=fn(){
    if H.page=="pools" || H.page=="pool_apply" {return "projects"}
    if H.page=="pool_agents" || H.page=="pool_agent" {return "agents"}
    if H.ux.origin=="inbox" && A.has_page(["project_action","action","agent_action","allocation_action","agent_topup"]) {return "inbox"}
    if H.page=="inbox" {return "inbox"}
    if A.has_page(["projects","project_wizard","project_action","project_setup","allocations","allocation_action"]) {return "projects"}
    if A.has_page(["agent_home","agents","agent_wizard","agent_action","agent_status","agent_control","agent_work","agent_work_list","agent_removals","agent_removal","personal_agents","personal_agent","personal_model","agent_budget","agent_topup"]) {return "agents"}
    if A.has_page(["overview","tools","operator_tasks","operator_task","operator_task_command","operator_board","operator_graphs","operator_graph","operator_graph_node","operator_graph_command","operator_graph_recipient","graph_archives","graph_history","history_graph","history_node","web_overview"]) {return "overview"}
    return "resources"
}
A.return_list=fn(page){if H.busy{return} H.ux.origin="" H.page=page H.ux.restore=true A.refresh_page()}
A.native_open=fn(destination){A.request("hagency.navigation.open",{destination:destination},fn(v){})}
A.native_open_agent=fn(id){A.request("hagency.navigation.open",{destination:"local_agent",agentId:id},fn(v){})}
// Local agents: reads and controls that never take the shared busy lock.
A.load_local_list=fn(){
    host.request("hagency.personal_agents.list",{after:nil limit:16},fn(r){
        H.local_list=if r.is_ok && r.data.protocol=="hagency-personal-settings-v1" {r.data.items} else {[]}
        for row in H.local_list {row.local=nil
            let item=row
            host.request("hagency.personal_agents.status",{id:item.id},fn(s){if s.is_ok {item.local=s.data A.redraw()}})
        }
        A.redraw()
    })
}
A.local_status_load=fn(id){
    H.local_status=nil H.local_confirm="" H.local_error="" H.local_discard="" H.local_models=nil
    host.request("hagency.personal_agents.model.choices",{id:id},fn(r){if H.personal_id==id && r.is_ok {H.local_models=r.data.models A.redraw()}})
    host.request("hagency.personal_agents.status",{id:id},fn(r){
        if H.personal_id!=id {return}
        if r.is_ok {H.local_status=r.data} else {H.local_error="status_unavailable"}
        A.redraw()
    })
}
A.local_act=fn(service,args){
    if H.local_pending!="" {return}
    H.local_epoch=H.local_epoch+1
    let epoch=H.local_epoch
    let id=H.personal_id
    let silent=if service=="hagency.personal_agents.service" {if args.running {"local_no_response_start"} else {"local_no_response_stop"}} else {"local_no_response"}
    H.local_pending=service H.local_error="" A.redraw()
    host.request(service,args,fn(r){
        if H.local_epoch==epoch {H.local_pending=""}
        if H.personal_id==id {if r.is_ok {H.local_status=r.data H.local_error=""} else {H.local_error=r.error}}
        A.redraw()
    })
    start_timeout(15,||{if H.local_epoch==epoch && H.local_pending==service {H.local_pending="" H.local_error=silent A.redraw()}})
}
A.local_pending_text=fn(state){return if A.local_running(state) {A.t("Stopping…","正在停止…")} else {A.t("Starting…","正在启动…")}}
A.local_reason=fn(code){
    if code=="status_unavailable" {return A.t("Couldn’t read the service status.","暂时无法读取运行状态。")}
    if code=="personal_agent_not_on_this_device" {return A.t("This Agent runs on another device. Start or stop it there.","此 Agent 在其他设备上运行，请在那台设备上启动或停止。")}
    if code=="personal_agent_chat_unavailable" {return A.t("The private chat isn’t set up yet.","私聊尚未建立。")}
    if code=="local_no_response_stop" {return A.t("The device didn’t respond. The service may still be running.","没有收到设备响应，服务可能仍在运行。")}
    if code=="local_no_response_start" {return A.t("The device didn’t respond. The service may not have started.","没有收到设备响应，服务可能尚未启动。")}
    if code=="local_no_response" {return A.t("No response yet. Refresh to see the current state.","暂未收到响应，请刷新查看当前状态。")}
    if code=="personal_agent_encryption_failed" {return A.t("Couldn’t turn on encryption. Check your connection and try again.","未能开启加密，请检查网络后重试。")}
    return A.error_text(code)
}
A.local_state=fn(){if H.local_status==nil {return ""} return H.local_status.service.state}
A.local_running=fn(state){return state=="running" || state=="processing" || state=="starting" || state=="waiting" || state=="attention"}
A.local_reset_time=fn(){return if H.local_status!=nil && H.local_status.resetLocalTime!=nil {H.local_status.resetLocalTime} else {"08:00"}}
A.local_state_text=fn(state){
    if state=="offline" {return A.t("Device offline","设备离线")}
    if state=="running" {return A.t("Running","运行中")}
    if state=="processing" {return A.t("Working","正在处理")}
    if state=="starting" {return A.t("Starting","正在启动")}
    if state=="waiting" {return A.t("Waiting for your approval","等待你的批准")}
    if state=="attention" {return A.t("Needs attention","需要处理")}
    if state=="elsewhere" {return A.t("On another device","在其他设备上")}
    if state=="stopped" {return A.t("Stopped","已停止")}
    if state=="unknown" {return A.t("Status unavailable","状态不可用")}
    return A.t("Checking…","正在检查…")
}
A.local_tone_bg=fn(state){
    if state=="running" || state=="processing" {return mod.widgets.RINX_SUCCESS_BG}
    if state=="attention" {return mod.widgets.RINX_DANGER_BG}
    if state=="waiting" || state=="starting" {return mod.widgets.RINX_WARNING_BG}
    if state=="elsewhere" {return mod.widgets.RINX_INFO_BG}
    return mod.widgets.RINX_SELECTED
}
A.local_tone_fg=fn(state){
    if state=="running" || state=="processing" {return mod.widgets.RINX_SUCCESS_FG}
    if state=="attention" {return mod.widgets.RINX_DANGER_FG}
    if state=="waiting" || state=="starting" {return mod.widgets.RINX_WARNING_FG}
    if state=="elsewhere" {return mod.widgets.RINX_INFO_FG}
    return mod.widgets.RINX_MUTED
}
A.local_toggle_service=fn(){
    let s=H.local_status
    if s==nil || !s.here || H.local_pending!="" {return}
    A.local_act("hagency.personal_agents.service",{id:H.personal_id running:!A.local_running(s.service.state)})
}
A.local_open_chat=fn(){
    if H.local_status==nil || H.local_status.chat==nil {A.native_open_agent(H.personal_id) return}
    host.request("hagency.personal_agents.chat.open",{id:H.personal_id},fn(r){if !r.is_ok {H.local_error=r.error A.redraw()}})
}
A.local_encrypt=fn(){H.local_confirm="" A.local_act("hagency.personal_agents.chat.encrypt",{id:H.personal_id})}
A.local_tokens=fn(value){
    if value==nil {return A.t("Unknown","未知")}
    let en=if value>=1000000 {""+floor(value/100000)/10+"M"} else if value>=1000 {""+floor(value/100)/10+"K"} else {""+value}
    let zh=if value>=10000 {""+floor(value/1000)/10+" 万"} else {""+value}
    return A.t(en,zh)
}
A.local_mode=fn(value){
    if value=="allow" {return A.t("Run directly","直接执行")}
    if value=="ask_owner" {return A.t("Ask me first","先问我")}
    if value=="deny" {return A.t("Decline","拒绝")}
    if value=="rules" {return A.t("Custom rules","自定义规则")}
    return A.personal_policy_mode(value)
}
A.local_budget_kind=fn(value){
    if value=="unset" {return A.t("Default","跟随默认")}
    if value=="unlimited" {return A.t("No limit","不限")}
    if value=="tokens" {return A.t("Custom","自定义")}
    return value
}
A.local_period=fn(value){
    if value=="lifetime" {return A.t("No Reset","不重置")}
    if value=="utc_day" {return A.t("Daily","每日")}
    if value=="utc_month" {return A.t("Monthly","每月")}
    return value
}
A.local_on=fn(on){return if on {A.t("On","打开")} else {A.t("Off","关闭")}}
A.local_draft_budget=fn(d){
    if d.kind=="tokens" {return A.local_tokens(d.tokens.trim().to_f64())+A.t(" tokens"," token")+" · "+A.local_period(d.period)}
    return A.local_budget_kind(d.kind)
}
A.local_policy_changes=fn(){
    let changes=[]
    if H.personal_draft==nil || H.personal_detail==nil || H.personal_detail.settings.observation==nil {return changes}
    let d=H.personal_draft let o=H.personal_detail.settings.observation
    let before=A.local_budget_text(o) let after=A.local_draft_budget(d)
    if before!=after {changes.push({label:A.t("Budget","额度") before:before after:after})}
    if d.requests!=o.requests {changes.push({label:A.t("Model requests","模型请求") before:A.local_mode(o.requests) after:A.local_mode(d.requests)})}
    if d.highRiskTools!=o.highRiskTools {changes.push({label:A.t("High-risk tools","高风险工具") before:A.local_mode(o.highRiskTools) after:A.local_mode(d.highRiskTools)})}
    return changes
}
A.local_policy_changed=fn(){return A.local_policy_changes().len()>0}
A.local_cancel_edit=fn(){
    if H.personal_mode=="edit" && A.local_policy_changed() {H.local_discard="policy"} else {H.personal_mode="detail" H.personal_draft=nil}
    A.redraw()
}
A.local_model_changed=fn(){
    let p=H.personal_config
    if p.choices==nil || p.draft==nil {return false}
    let c=p.choices.current let d=p.draft
    if c==nil {return true}
    let keep=if p.choices.workspaceConfigured {"preserve"} else {"default"}
    return d.runtime!=c.runtime || d.model!=c.model || d.reasoningEffort!=c.reasoningEffort || d.webSearch!=c.webSearch || d.workspace!=keep
}
A.local_cancel_model=fn(){
    if A.local_model_changed() {H.local_discard="model" A.redraw()} else {A.open_personal_agent(H.personal_id)}
}
A.local_conflict=fn(code){return code=="local_revision_conflict" || code=="personal_agent_settings_changed"}
// Rebuild the review from the device's latest settings with the edits the device refused.
A.local_recheck=fn(){
    let kept=H.local_kept
    H.local_failure="" H.local_kept=nil
    if kept==nil || H.personal_detail==nil {A.redraw() return}
    A.edit_personal_policy()
    let d=H.personal_draft
    if d==nil {return}
    d.kind=kept.kind d.tokens=kept.tokens d.period=kept.period d.requests=kept.requests d.highRiskTools=kept.highRiskTools
    H.local_rechecked=true
    H.personal_mode=if A.local_policy_changed() && A.personal_valid() {"review"} else {"edit"}
    A.redraw()
}
A.local_agent_name=fn(){return if H.personal_detail!=nil {H.personal_detail.agent.displayName} else {"Agent"}}
A.alert_kind=fn(){
    if H.page=="personal_model" && H.local_discard=="model" {return "model"}
    if H.page=="personal_agent" && H.local_discard=="policy" {return "policy"}
    if H.page=="personal_agent" && H.local_confirm=="encrypt" {return "encrypt"}
    if H.page=="personal_agent" && H.local_confirm=="retire" {return "retire"}
    if H.page=="personal_agent" && H.local_failure!="" {return "failure"}
    if H.page=="pool_agent" && H.pool_detail!=nil && H.pool_confirm!="" {return "pool_"+H.pool_confirm}
    if A.reqs_page() && H.reqs.confirm!=nil {return "pool_"+H.reqs.confirm.kind}
    if H.page=="default_policy" && H.dpol.ask!=nil && H.command==nil {return "default_policy"}
    if (H.page=="resource_create" || H.page=="resource_edit") && H.create_trust_ask!="" && H.command==nil {return "create_trust"}
    if H.page=="action" && H.entry_role=="owner" && H.selected!=nil && (H.confirm=="revoke" || H.confirm=="approve" || H.confirm=="reject") {return "server_"+H.confirm}
    if (H.page=="resource_detail" || H.page=="pool_advanced") && H.resource_detail!=nil && H.web.publicationReview {return "resource_publish"}
    if H.page=="resource_detail" && H.local_discard=="pool" {return "pool"}
    if H.page=="execution_policy" && H.policy_detail!=nil && H.policy_draft!=nil && (H.policy_mode=="edit" || H.policy_mode=="review") && H.command==nil {return "policy_change"}
    if H.page=="tool_grant_review" && H.tool_draft!=nil && H.command==nil {return "tool_revoke"}
    if H.page=="approval_binding_review" && H.binding_draft!=nil && H.binding_confirm && H.command==nil {return "binding_remove"}
    return ""
}
A.local_leaving=fn(page){
    let s={kind:""}
    if H.page=="personal_agent" && (H.personal_mode=="edit" || H.personal_mode=="review") {if A.local_policy_changed() {s.kind="policy"}}
    if H.page=="personal_model" {if A.local_model_changed() {s.kind="model"}}
    if A.pool_dirty() {s.kind="pool"}
    if s.kind=="" {return false}
    H.local_discard=s.kind H.local_after=page A.redraw()
    return true
}
A.local_discard_changes=fn(){
    let kind=H.local_discard let after=H.local_after
    H.local_discard="" H.local_after=""
    if kind=="pool" {
        let e=H.pool_edit
        if e!=nil {e.max=e.maxBase e.unlimited=e.unlimitedBase}
        if after=="back" {if !A.nav_back() {A.return_list("resources")} return}
        if after!="" {A.navigate(after) return}
        A.redraw() return
    }
    if kind=="model" {H.personal_config.draft=nil} else {H.personal_mode="detail" H.personal_draft=nil}
    if after!="" {A.navigate(after) return}
    if kind=="model" {A.open_personal_agent(H.personal_id) return}
    A.redraw()
}
A.local_model_name=fn(id){
    if H.local_models!=nil {for row in H.local_models {if row.model==id {return row.displayName}}}
    let p=H.personal_config
    if p.choices!=nil && p.choices.agentId==H.personal_id {for row in p.choices.models {if row.model==id {return row.displayName}}}
    return id
}
A.local_pool_state=fn(r){
    if r.state=="pending_approval" {return A.t("Awaiting approval","等待审批")}
    if r.state=="rejected" {return A.t("Declined","已拒绝")}
    if r.state=="cancelled" {return A.t("Removed","已移除")}
    if r.state=="revoked" {return A.t("Stopped","已停止")}
    if r.state=="expired" {return A.t("Expired","已过期")}
    if r.reservationState=="refused" {return A.t("Not enough capacity","容量不足")}
    if r.runtimeState=="qualified" {return A.t("Ready to start","可以启动")}
    if r.membershipState=="matrix_verified" {return A.t("Approved · not started","已批准 · 待启动")}
    return A.t("Approved · setting up","已批准 · 正在准备")
}
A.page_bar_visible=fn(){return H.page=="personal_agent" || H.page=="personal_model" || H.page=="pool_agent" || H.page=="resource_detail" || (H.page=="pool_create" && H.pool_create!=nil) || (H.page=="resource_edit" && H.resource_edit_draft!=nil && H.resource_detail!=nil) || (H.page=="resource_create" && H.resource_create_draft!=nil && H.resource_detail!=nil) || A.sub_page()}
A.page_bar_mode=fn(){
    if H.page=="pool_agent" {return "pool"}
    if H.page=="resource_detail" && H.resource_name_mode!="" {return "resource_name"}
    if H.page=="resource_detail" {return "resource"}
    if H.page=="pool_create" {return "pool_create"}
    if H.page=="resource_edit" {return "resource_edit"}
    if H.page=="resource_create" {return "resource_create"}
    if H.page=="personal_model" {return "model"}
    if H.page=="template_edit" {return "template_edit"}
    if H.page=="web_catalog" && H.web.draft!=nil {return "offer_edit"}
    if A.sub_page() {return "sub"}
    if H.personal_mode=="edit" {return "edit"}
    if H.personal_mode=="review" {return "review"}
    if H.personal_mode=="observe_review" {return "observe"}
    return "detail"
}
// The compact title stays centred and clear of the back label, however long that is.
A.page_bar_side=fn(mode){
    let base=56+30*mod.widgets.RINX_TEXT_SCALE
    let label=if mode=="sub" {A.sub_back_label()} else if mode=="resource" {A.nav_label(A.t("Pools","资源池"))} else if mode=="pool" && H.entry_role=="owner" {A.nav_label(A.t("Requests","申请"))} else {""}
    return max(base,24+A.nav_units(label)*8.8*mod.widgets.RINX_TEXT_SCALE)
}
A.page_bar_title=fn(){
    let mode=A.page_bar_mode()
    if mode=="offer_edit" {return A.t("Edit Role","编辑角色")}
    if mode=="sub" || mode=="template_edit" {return A.sub_title()}
    if mode=="model" {return A.t("Model and Workspace","模型与工作区")}
    if mode=="resource_name" {return A.t("Name","名称")}
    if mode=="pool_create" {return A.t("New Resource Pool","新建资源池")}
    if mode=="resource_edit" {return A.t("Model","模型")}
    if mode=="resource_create" {return A.t("Another Pool","再建一个资源池")}
    if mode=="edit" {return A.t("Limits and Approvals","额度与审批")}
    if mode=="review" {return A.t("Review Changes","确认修改")}
    if mode=="observe" {return A.t("Sync Settings","同步设置")}
    // Like a large-title page: the hero carries the name until it scrolls under the bar.
    if mode=="detail" && H.bar_past && H.personal_detail!=nil {return H.personal_detail.agent.displayName}
    if mode=="pool" && H.bar_past && H.pool_detail!=nil {return H.pool_detail.definition.name}
    if mode=="resource" && H.bar_past && H.resource_detail!=nil {return A.resource_title(H.resource_detail.resource)}
    return ""
}
A.local_budget_text=fn(o){
    if o.budget.kind=="tokens" {return A.local_tokens(o.budget.tokens)+A.t(" tokens"," token")+" · "+A.local_period(o.budget.period)}
    return A.local_budget_kind(o.budget.kind)
}
A.local_device_text=fn(){
    if H.local_status==nil {return A.t("Checking…","正在检查…")}
    return if H.local_status.here {A.t("This device","本机")} else {A.t("Another device","其他设备")}
}
A.return_origin=fn(){
    if H.busy {return}
    let origin=H.ux.origin H.ux.origin="" H.confirm="" H.notice="" H.page=origin H.ux.restore=true
    if origin=="inbox" {if H.entry_role=="owner"{A.reqs_load(nil)}else{A.load_inbox()}} else {A.load_dashboard()}
}
A.must_reopen=fn(){return H.ux.errorCode=="management_permission_required" || H.ux.errorCode=="management_scope_changed" || H.ux.errorCode=="management_access_required"}
A.load_inbox=fn(){
    H.ux.inboxReady=false H.ux.inboxError=false H.inbox=[] H.agents=[] H.inbox_after=nil H.agent_after=nil
    A.request("hagency.inbox.list",{after:H.ux.inboxCursor needsMyAction:H.needs_action includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()},fn(v){
        H.inbox=v.items H.inbox_after=v.nextAfter
        if A.agents_enabled() && H.entry_role!="admin" {A.load_agents(H.ux.agentCursor)} else {H.agents=[] H.agent_after=nil H.ux.inboxReady=true}
    })
}
A.inbox_filter=fn(needs){if H.busy{return} H.needs_action=needs H.ux.inboxCursor=nil H.ux.agentCursor=nil if H.entry_role=="owner"{A.reqs_filter(if needs {"pending"} else {"all"})}else{A.load_inbox()}}
A.load_dashboard=fn(){
    if H.busy{return}
    H.ux.dashboard=nil H.ux.dashboardError=false
    A.request("hagency.inbox.list",{needsMyAction:true includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()},fn(v){
        H.ux.dashboard={requests:v.items requestAfter:v.nextAfter agents:[] agentAfter:nil projects:[] projectAfter:nil complete:false}
        A.dashboard_agents()
    })
}
A.dashboard_agents=fn(){
    if A.agents_enabled(){A.request("hagency.agents.list",{needsMyAction:true},fn(v){H.ux.dashboard.agents=v.items H.ux.dashboard.agentAfter=v.nextAfter A.dashboard_projects()})}
    else {A.dashboard_projects()}
}
A.dashboard_projects=fn(){
    if A.projects_enabled(){A.request("hagency.projects.list",{},fn(v){H.ux.dashboard.projects=v.items H.ux.dashboard.projectAfter=v.nextAfter A.dashboard_connections()})}
    else {A.dashboard_connections()}
}
A.dashboard_connections=fn(){A.request("hagency.connections.list",{},fn(v){A.connections_received(v) H.ux.dashboard.complete=true})}
A.queue_count=fn(){
    let d=H.ux.dashboard
    if d==nil{return ""}
    let n=d.requests.len()+d.agents.len()
    return ""+n+if d.requestAfter!=nil || d.agentAfter!=nil || !d.complete {"+"}else{""}
}
A.role_label=fn(){
    if H.session==nil{return ""}
    let manager=false let coordinator=false let owner=false
    let projects=H.projects let agents=H.agents
    if H.ux.dashboard!=nil{projects=H.ux.dashboard.projects agents=H.ux.dashboard.agents}
    for project in projects{if project.managerMxid==H.session.account{manager=true} if project.coordinatorMxid==H.session.account{coordinator=true}}
    for agent in agents{let {administratorMxid=nil}=agent let {canDecide=false}=agent if administratorMxid==H.session.account && canDecide{manager=true}}
    for row in H.connections{if row.ownerMxid==H.session.account{owner=true} if row.coordinatorMxid==H.session.account{coordinator=true}}
    let roles=[]
    if H.session.account==H.session.administrator{roles.push(A.t("Server administrator","服务器管理员"))}
    if manager{roles.push(A.t("Agent applicant","Agent 申请者"))}
    if owner || coordinator{roles.push(A.t("Resource owner","资源主人"))}
    let result="" for role in roles{if result!=""{result=result+" · "} result=result+role}
    return if result==""{A.t("Resources and Agent management","资源与 Agent 管理")}else{result}
}
A.project_capacity=fn(){
    if H.ux.projectProgress==nil{return false}
    return H.ux.projectProgress.readiness.capacityReady || A.recipient_optional(H.ux.projectProgress.readiness,"eligibleAllocation")!=nil
}
A.project_plan=fn(project){
    let plan={title:"" actor:project.managerMxid label:A.t("View progress","查看进度") target:""}
    if project.allocationStatus=="resource_unavailable" {plan.title=A.t("Choose another resource for a new request","选择其他资源，重新申请") return plan}
    if project.state=="pending_approval" || project.state=="pending" {plan.title=if project.request.canDecide{A.t("Your decision is needed","需要你审批")}else{A.t("Waiting for server administrator","等待服务器管理员")} plan.actor=project.request.approverMxid return plan}
    if project.state!="approved" {plan.title=A.t("This request is closed. Its history is retained.","此申请已结束，历史记录仍保留。") return plan}
    if H.ux.projectProgress==nil {plan.title=A.t("Check current project requirements","检查项目当前条件") plan.label=A.t("Review setup requirements","查看设置条件") plan.target=if A.setup_enabled(){"setup"}else if A.allocations_enabled(){"allocations"}else{""} return plan}
    if A.recipient_optional(H.ux.projectProgress,"pendingCommands")!=nil && H.ux.projectProgress.pendingCommands.len()>0 {plan.title=A.t("Recover the saved setup result","恢复已保存的设置结果") plan.label=A.t("Review saved setup","查看已保存的设置") plan.target="setup" return plan}
    let r=H.ux.projectProgress.readiness
    if !A.project_capacity(){
        plan.title=A.t("Review resource allocation","查看资源分配") plan.label=A.t("View allocation status","查看分配状态") plan.actor=project.coordinatorMxid plan.target=if A.allocations_enabled(){"allocations"}else{"setup"} return plan
    }
    if r.administrator==nil {plan.title=A.t("Check project manager authority","检查项目经理权限") plan.label=A.t("Review project requirements","查看项目条件") plan.actor=project.managerMxid plan.target="setup" return plan}
    if A.recipient_optional(r,"setup")!=nil && !r.capacityReady {plan.title=A.t("Review the updated allocation before continuing","继续前请查看更新后的额度分配") plan.label=A.t("Review setup requirements","查看设置条件") plan.target="setup" return plan}
    if !r.matrixReady {plan.title=A.t("Finish and verify the project workspace","完成并验证项目工作区") plan.label=if H.session.account==project.managerMxid{A.t("Continue workspace setup","继续工作区设置")}else{A.t("View workspace status","查看工作区状态")} plan.target="setup" return plan}
    plan.title=A.t("Workspace verification recorded · Check agents","已记录工作区验证 · 检查 Agent") plan.label=if A.agents_enabled(){A.t("View project agents","查看项目 Agent")}else{A.t("View workspace status","查看工作区状态")} plan.target=if A.agents_enabled(){"agents"}else{"setup"}
    return plan
}
A.project_next=fn(project){return A.project_plan(project).title}
A.project_actor=fn(project){return A.project_plan(project).actor}
A.project_continue=fn(){let p=H.project_selected if p==nil{return} let plan=A.project_plan(p)
    if plan.target=="allocations"{A.open_allocations(p.id,nil,1)}
    if plan.target=="setup"{A.open_project_setup(p.id)}
    if plan.target=="agents"{A.open_project_agents(p.id)}
}
A.load_agent_home=fn(){
    if A.agents_enabled(){A.request("hagency.agents.list",{after:nil needsMyAction:false},fn(v){H.agents=v.items H.agent_after=v.nextAfter})}
}
A.resource_stage=fn(){
    if H.page=="action" && H.selected!=nil {return if H.selected.contribution.state=="admitted"{3}else{2}}
    if H.page=="wizard" {return if H.wizard.admission!=nil && H.wizard.admission.contribution.state=="admitted"{3}else if H.wizard.step>=3{2}else{1}}
    if H.page=="account_enrollment" || H.page=="resource_detail" {return 1}
    return 0
}

A.pool_enabled=fn(){
    if H.session==nil{return false}
    for feature in H.session.features {if feature=="resource-pool-agents-v1"{return true}}
    return false
}
A.pool_mutation=fn(service){return service=="hagency.pools.agents.request" || service=="hagency.pools.agents.decide" || service=="hagency.pools.agents.stop"}
A.pool_capacity=fn(pool){return if pool.publishedTokens==nil {A.t("No quota published","尚未公布额度")} else {A.t("Up to ","每次最多 ")+A.local_tokens(pool.publishedTokens)+A.t(" tokens per request"," token")}}
// The applicant's own Agents in a pool, by name.
A.my_pool_agents=fn(id){
    let s={names:""}
    for row in H.pool_agents {if row.poolId==id && row.managerMxid==H.session.account && row.state!="cancelled" && row.state!="rejected" && row.state!="expired" && row.state!="revoked" {s.names=if s.names=="" {row.definition.name} else {s.names+"、"+row.definition.name}}}
    return s.names
}
// Owners read amounts in M, applicants in 万, matching the pages each one uses.
A.pool_amount=fn(value){return if H.entry_role=="owner" {A.tokens(value)+" token"} else {A.local_tokens(value)+A.t(" tokens"," token")}}
A.load_pools=fn(after){A.request("hagency.pools.list",{after:after},fn(v){H.pool_rows=v.items H.pool_after=v.nextAfter if after==nil && H.entry_role=="manager" {A.load_pool_agents(nil)}})}
A.load_pool_agents=fn(after){
    if H.entry_role=="manager" && H.page=="pool_agents" && after==nil {A.load_local_list()}
    H.owner.requestAfter=after
    let args={after:after needsMyAction:H.page=="inbox" && H.entry_role=="owner" && H.needs_action}
    let pool=if H.entry_role=="owner"{H.owner.poolId}else{""}
    if pool!=""{args.poolId=pool}
    H.ux.inboxReady=false
    A.request("hagency.pools.agents.list",args,fn(v){
        if H.entry_role=="owner" && H.owner.poolId!=pool{return}
        H.pool_agents=v.items H.pool_agent_after=v.nextAfter H.ux.inboxReady=true
    })
}
A.pool_agent_rows=fn(){
    let rows=[]
    for row in H.pool_agents {
        if H.entry_role=="owner" {if row.resourceOwnerMxid==H.session.account && (H.owner.poolId=="" || row.poolId==H.owner.poolId){rows.push(row)}}
        else {if row.managerMxid==H.session.account{rows.push(row)}}
    }
    return rows
}
A.open_pool_agent=fn(id){
    if H.pool_detail!=nil && H.pool_detail.id!=id {H.pool_detail=nil}
    if H.reqs.result!=nil && H.reqs.result.id!=id {H.reqs.result=nil}
    H.reqs.agent=id H.reqs.confirm=nil
    H.page="pool_agent" H.pool_confirm="" H.bar_past=false
    A.request("hagency.pools.agents.get",{id:id},fn(v){H.pool_detail=v.request})
}
A.pool_tone=fn(r){
    if r.state=="rejected" || r.reservationState=="refused" || r.blockingReason!=nil {return "attention"}
    if r.state=="cancelled" || r.state=="revoked" || r.state=="expired" {return ""}
    if r.state=="pending_approval" {return "waiting"}
    if r.runtimeState=="qualified" {return "elsewhere"}
    return "waiting"
}
// People read as "You" or @name on this server; other servers keep the full ID.
A.pool_person=fn(mxid){
    if mxid==nil || mxid=="" {return A.t("Unknown","未知")}
    if mxid==H.session.account {return A.t("Me","我")}
    let parts=mxid.split(":")
    let mine=H.session.account.split(":")
    let s={same:parts.len()>1 && parts.len()==mine.len()}
    for index part in parts {if index>0 && s.same && part!=mine[index] {s.same=false}}
    return if s.same {parts[0]} else {mxid}
}
A.pool_state=fn(r){
    if r.state=="pending_approval"{return A.t("Waiting for resource owner approval","等待资源 owner 审批")}
    if r.state=="rejected"{return A.t("Declined by resource owner","资源 owner 已拒绝")}
    if r.state=="cancelled"{return A.t("Removed by applicant · cleanup continues","申请者已移除 · 清理仍在继续")}
    if r.state=="revoked"{return A.t("Stopped using the pool · finishing up","已停止使用资源池 · 正在收尾")}
    if r.state=="expired"{return A.t("Request expired","申请已过期")}
    if r.reservationState=="refused"{return A.t("The pool couldn’t give it capacity", "资源池没能分出额度")}
    if r.blockingReason!=nil{return A.t("Resource authority changed · refresh required","资源授权已变化 · 请刷新检查")}
    if r.runtimeState=="qualified"{return A.t("Runtime qualification recorded","已记录运行时就绪结果")}
    if r.membershipState=="matrix_verified"{return A.t("Conversation verified · execution can be enabled","会话已验证 · 可启用执行")}
    if r.assignmentId!=nil{return A.t("Capacity given · verifying conversation","额度已分给它 · 正在验证会话")}
    return A.t("Approved · waiting for resource device","已批准 · 等你的电脑确认")
}
A.pool_begin=fn(pool){
    if H.busy || H.command!=nil || !pool.canRequest{return}
    if H.pool_draft!=nil {A.navigate("pool_apply") return}
    H.pool_draft={pool:pool name:"" description:"" capability:"" tokens:"1000" roomCommand:"" roomId:"" review:false}
    H.pool_checked=true
    let limit=A.pool_limit(pool) if limit!=nil {H.pool_draft.tokens=""+min(1000,limit)}
    if pool.capabilities.len()>0{H.pool_draft.capability=pool.capabilities[0]}
    H.page="pool_apply" H.notice="" A.save() A.redraw()
}
A.pool_editable=fn(){
    if H.busy || H.command!=nil{return false}
    for row in H.saved_commands {if row.operation=="pool_agent_request" && row.reply==nil{return false}}
    return true
}
A.pool_limit=fn(pool){
    if pool==nil{return nil}
    let {publishedTokens=nil,nativeAvailableTokens=nil}=pool
    if publishedTokens==nil || !(publishedTokens>=1 && publishedTokens<=9007199254740991) || floor(publishedTokens)!=publishedTokens{return nil}
    if nativeAvailableTokens!=nil {
        if !(nativeAvailableTokens>=0 && nativeAvailableTokens<=9007199254740991) || floor(nativeAvailableTokens)!=nativeAvailableTokens{return nil}
        return min(publishedTokens,nativeAvailableTokens)
    }
    return publishedTokens
}
A.pool_reason=fn(code){
    if code=="pool_agent_resource_mismatch" || code=="management_receipt_capacity" {return A.t("Application not submitted. The amount or capability exceeds this pool's authorization. Refresh its limit and edit your request.","申请未提交：额度或能力超出资源池授权范围。请刷新限额后修改申请。")}
    if code=="management_revision_changed" || code=="pool_agent_authority_changed" {return A.t("Resource authorization changed. Refresh the limit and review your request again.","资源授权已变化，请刷新限额后重新核对申请。")}
    if code=="pool_capacity_unavailable" {return A.t("This pool has no active capacity authorization. Ask its owner to publish capacity.","此资源池暂无有效容量授权，请联系 owner 发布容量。")}
    if code=="pool_not_shared_with_account" {return A.t("This pool is not shared with your account. Contact its resource owner.","此资源池未授权给你的账号，请联系资源 owner。")}
    return A.agent_reason(code)
}
A.pool_amount_error=fn(d){
    if !H.pool_checked{return A.t("Refresh the pool limit before continuing.","请刷新资源池限额后继续。")}
    if !d.pool.canRequest{return A.pool_reason(d.pool.blockingReason)}
    let limit=A.pool_limit(d.pool)
    if limit==nil{return A.t("The request limit is unavailable. Refresh before submitting.","暂时无法确认申请上限，请刷新后再提交。")}
    if limit<1{return A.t("This pool has no available capacity for a new request.","此资源池暂无可用于新申请的额度。")}
    let amount=A.web_int(d.tokens,-1)
    if amount<1{return A.t("Enter a positive whole number of tokens.","请输入大于零的 token 整数。")}
    if amount>limit{return A.t("Requested ","申请 ")+A.tokens(amount)+A.t(" tokens exceeds the limit of "," tokens，超过本次申请上限 ")+A.tokens(limit)+A.t(" tokens. Reduce the amount before submitting."," tokens。请调低额度后提交。")}
    return ""
}
A.pool_valid=fn(d){
    if d==nil || d.name.trim()=="" || A.pool_amount_error(d)!=""{return false}
    for cap in d.pool.capabilities {if cap==d.capability{return true}}
    return false
}
A.pool_refresh=fn(){A.pool_lookup(fn(){if !A.pool_valid(H.pool_draft){H.pool_draft.review=false A.save()}})}
A.pool_lookup=fn(done){
    if H.pool_draft==nil || !A.pool_editable(){return}
    let d=H.pool_draft H.pool_checked=false
    let seen=[] let load=nil
    load=fn(after){A.request("hagency.pools.list",{after:after},fn(v){
        if H.pool_draft!=d{return}
        for pool in v.items {if pool.id==d.pool.id {d.pool=pool H.pool_checked=true if A.save() && done!=nil {done()} A.redraw() return}}
        if v.nextAfter!=nil && seen.len()<64 {
            for previous in seen {if previous==v.nextAfter {H.notice=A.t("Pool lookup is incomplete. Refresh to try again.","资源池查询不完整，请刷新重试。") return}}
            seen.push(v.nextAfter) load(v.nextAfter) return
        }
        H.notice=A.t("This resource pool is no longer available to this account.","当前账号无法再访问此资源池。")
    })}
    load(nil)
}
A.pool_tokens=fn(text){
    if H.pool_draft==nil || !A.pool_editable(){return}
    H.pool_draft.tokens=text H.pool_draft.failure=nil H.pool_draft.review=false A.save() A.pool_sync_amount()
}
A.pool_ratio=fn(ratio){
    if H.pool_draft==nil || !A.pool_editable() || !H.pool_checked{return}
    let limit=A.pool_limit(H.pool_draft.pool) if limit==nil || limit<1{return}
    A.pool_tokens(""+max(1,min(limit,floor(limit*max(0,min(1,ratio))+0.5))))
}
A.pool_edit=fn(){if H.pool_draft!=nil && A.pool_editable(){H.pool_draft.review=false A.save() A.redraw()}}
A.pool_review=fn(){
    let d=H.pool_draft
    if !A.pool_editable(){return}
    if !A.pool_valid(d){H.notice=A.t("Check the highlighted fields before continuing.","请修改表单中标出的内容后继续。") A.redraw() return}
    d.failure=nil d.review=true A.save() A.redraw()
}
A.pool_send=fn(){
    if !A.pool_editable() || H.pool_draft==nil{return}
    let d=H.pool_draft let original=d.pool
    if !d.review || !A.pool_valid(d){d.review=false A.save() A.redraw() return}
    A.pool_lookup(fn(){
        if H.pool_draft!=d{return}
        if original.revision!=d.pool.revision || original.grantRevision!=d.pool.grantRevision || A.pool_limit(original)!=A.pool_limit(d.pool) || !A.pool_valid(d){
            d.review=false d.failure="management_revision_changed" A.save() A.redraw() return
        }
        A.pool_send_verified()
    })
}
A.pool_send_verified=fn(){
    if !A.pool_editable() || H.pool_draft==nil{return}
    let d=H.pool_draft
    if !d.review || !A.pool_valid(d){d.review=false H.notice=A.t("Application not submitted. Check the amount and resource limit.","申请未提交，请核对额度和资源池限额。") A.save() A.redraw() return}
    if d.roomCommand==""{
        A.request("hagency.intent.new",{},fn(v){d.roomCommand=v.commandId if A.save(){A.pool_send()}}) return
    }
    if d.roomId==""{
        A.request("hagency.pools.agents.room",{commandId:d.roomCommand name:d.name},fn(v){
            if v.creation.phase=="complete" && v.creation.roomId!=nil{d.roomId=v.creation.roomId if A.save(){A.pool_send()}}
            else{H.notice=A.t("Conversation creation is pending. Continue to recover the same request.","会话创建结果尚待确认。请继续以恢复同一请求。") A.save()}
        }) return
    }
    A.submit("hagency.pools.agents.request",{poolId:d.pool.id request:{roomId:d.roomId expectedPoolRevision:d.pool.revision expectedGrantRevision:d.pool.grantRevision definition:{name:d.name.trim() description:d.description capability:d.capability toolMode:"none"} requestedTokens:d.tokens.trim().to_f64()}})
}
A.pool_decide=fn(){
    let r=H.pool_detail if r==nil || H.busy || H.command!=nil{return}
    if H.pool_confirm!="approve" && H.pool_confirm!="reject" && H.pool_confirm!="stop"{return}
    if H.pool_confirm!="stop" && (H.entry_role!="owner" || r.resourceOwnerMxid!=H.session.account || !r.canDecide){return}
    if H.pool_confirm=="stop" && !((H.entry_role=="owner" && r.resourceOwnerMxid==H.session.account && r.canStopSupply) || (H.entry_role=="manager" && r.managerMxid==H.session.account && r.canCancel)){return}
    if H.pool_confirm=="stop"{A.submit("hagency.pools.agents.stop",{requestId:r.id expectedRevision:r.revision})}
    else{A.submit("hagency.pools.agents.decide",{requestId:r.id expectedRevision:r.revision approve:H.pool_confirm=="approve"})}
}

A.pool_sync_amount=fn(){
    let d=H.pool_draft let limit=A.pool_limit(d.pool) let amount=A.web_int(d.tokens,-1)
    let error=A.pool_amount_error(d)
    ui.pool_tokens.set_text(d.tokens)
    ui.pool_slider.set_value(if limit!=nil && limit>0{max(0,min(1,amount/limit))}else{0})
    ui.pool_amount_error.set_text(error) ui.pool_amount_error_box.set_visible(error!="")
    ui.pool_failure_box.set_visible(false)
    ui.pool_review.set_enabled(A.pool_valid(H.pool_draft))
}

A.render_page = fn(){
    loading := mod.widgets.HagencyStatus{visible:H.busy && !A.sub_page() && !A.reqs_page()
        mod.widgets.LoadingSpinner{width:20 height:20}
        mod.widgets.HagencyCopy{text:A.t("Loading current data…","正在读取最新数据…")}
    }
    if H.ready && H.page=="overview" {
        if H.entry_role=="" || H.entry_choosing {
            entry_intro := mod.widgets.HagencySection{
                mod.widgets.HagencyEyebrow{text:A.t("YOUR WORKSPACE","你的工作台")}
                mod.widgets.HagencyTitle{text:A.t("What would you like to manage?","选择这次要做的事")}
                mod.widgets.HagencyCopy{text:A.t("Choose a workspace for this account. You can switch whenever your task changes.","为当前账号选择工作台，任务变化时可随时切换。")}
                if H.session!=nil {workspace_account := mod.widgets.HagencyHint{text:A.t("Account: ","当前账号：")+H.session.account}}
            }
            entry_manager_card := mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.person}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Agent manager","Agent 管理者")}
                        mod.widgets.HagencyHint{text:A.t("Use Agents to get work done","申请 Agent，使用资源完成工作")}
                    }
                    entry_manager := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && A.entry_allowed("manager") text:A.t("Open","进入") on_click:||A.entry_choose("manager")}
                }
                mod.widgets.HagencyCopy{text:A.t("Choose a resource pool, manage your Agents, and track their work and usage.","选择资源池、管理自己的 Agent，查看任务和用量。")}
            }
            entry_owner_card := mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.resources}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Resource owner","资源 Owner")}
                        mod.widgets.HagencyHint{text:A.t("Supply and coordinate resources","提供资源，协调容量与权限")}
                    }
                    entry_owner := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && A.entry_allowed("owner") text:A.t("Open","进入") on_click:||A.entry_choose("owner")}
                }
                mod.widgets.HagencyCopy{text:A.t("Connect accounts and resources, approve capacity requests, and control execution permissions.","接入账号与资源、审批容量申请、设置执行权限。")}
            }
            entry_admin_card := mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.inbox}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Server admin","服务器 Admin")}
                        mod.widgets.HagencyHint{text:A.t("Manage admission to your server","管理谁能加入服务器")}
                    }
                    entry_admin := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && A.entry_allowed("admin") text:A.t("Open","进入") on_click:||A.entry_choose("admin")}
                }
                mod.widgets.HagencyCopy{text:A.t("Review resource admission and inspect server connections and administrative records.","审核资源的加入申请，查看服务器连接与管理记录。")}
                entry_admin_access := mod.widgets.HagencyHint{visible:!A.entry_allowed("admin") text:A.t("This account does not have server admission permission.","当前账号不能管理服务器的加入申请。")}
            }
            entry_scope := mod.widgets.HagencyHint{text:A.t("One account can use multiple workspaces. Available actions follow its current permissions.","同一账号可使用多个工作台，操作范围以当前权限为准。")}
        } else {
            workspace_hero := mod.widgets.HagencyHero{
                mod.widgets.HagencyHeroTitle{text:A.entry_label(H.entry_role)}
                mod.widgets.HagencyHeroCopy{text:if H.entry_role=="manager"{A.t("Your Agents, their resources, and the work they do.","管理你的 Agent、使用的资源与完成的工作。")}else if H.entry_role=="owner"{A.t("Your resources, capacity decisions, and execution permissions.","管理你的资源、容量审批与执行权限。")}else{A.t("Your server's resource admission and management records.","管理资源加入服务器的申请与连接记录。")}}
                mod.widgets.HagencyActions{
                    workspace_primary := mod.widgets.HagencyHeroButton{text:if H.entry_role=="manager"{A.t("My Agents","我的 Agent")}else if H.entry_role=="owner"{A.t("My resources","我的资源")}else{A.t("Review admission","审核加入申请")} enabled:!H.busy on_click:||{if H.entry_role=="manager"{A.navigate("pool_agents")}else if H.entry_role=="owner"{A.navigate("resources")}else{A.navigate("inbox")}}}
                }
            }
            manager_shortcuts := mod.widgets.HagencyCard{visible:H.entry_role=="manager"
                mod.widgets.HagencySectionTitle{text:A.t("Start or continue your work","开始或继续工作")}
                mod.widgets.HagencyCopy{text:A.t("Request an Agent directly from a resource pool. The resource owner approves its capacity.","直接从资源池申请 Agent，由资源 owner 审批容量。")}
                mod.widgets.HagencyActions{
                    workspace_pools := mod.widgets.HagencyButton{text:A.t("Browse resource pools","浏览资源池") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.projects enabled:!H.busy on_click:||A.navigate("pools")}
                    workspace_work := mod.widgets.HagencyButton{text:A.t("Tasks and activity","任务与活动") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.tasks enabled:!H.busy on_click:||A.navigate("tools")}
                    pool_continue := mod.widgets.HagencyButton{visible:H.pool_draft!=nil text:A.t("Continue saved Agent request","继续已保存的 Agent 申请") enabled:!H.busy on_click:||A.navigate("pool_apply")}
                }
            }
            owner_shortcuts := mod.widgets.HagencyCard{visible:H.entry_role=="owner"
                mod.widgets.HagencySectionTitle{text:A.t("Capacity and approvals","额度与审批")}
                mod.widgets.HagencyCopy{text:A.t("You coordinate your resources. Review applicants here, and configure permissions on the resource they use.","由你协调自己的资源。在这里审核申请，并在对应资源中设置执行权限。")}
                mod.widgets.HagencyActions{
                    workspace_supply := mod.widgets.HagencyButton{text:A.t("Connect a resource","接入资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add enabled:!H.busy on_click:||A.begin_setup()}
                    workspace_approvals := mod.widgets.HagencyButton{text:A.t("Agent requests","Agent 申请") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox enabled:!H.busy on_click:||{H.needs_action=true A.navigate("inbox")}}
                }
            }
            admin_shortcuts := mod.widgets.HagencyCard{visible:H.entry_role=="admin"
                mod.widgets.HagencySectionTitle{text:A.t("Server management","服务器管理")}
                mod.widgets.HagencyCopy{text:A.t("Admission lets a resource join this server. The resource owner controls its capacity and Agent permissions.","批准加入后，资源可以在这个服务器上使用；额度和 Agent 权限由资源所有者管理。")}
                mod.widgets.HagencyActions{
                    workspace_connections := mod.widgets.HagencyButton{text:A.t("Server connections","服务器连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection enabled:!H.busy on_click:||A.navigate("connections")}
                    workspace_console := mod.widgets.HagencyButton{text:A.t("Management console","管理控制台") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.activity enabled:!H.busy on_click:||A.navigate("tools")}
                }
            }
        }
    }

    if H.ready && A.reqs_page() {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:if H.page=="pool_requests" {18} else {0} bottom:28} mod.widgets.HagencyColumn{
        let r=H.reqs
        let tab=H.page=="inbox"
        let pool_scope=A.reqs_scope()
        let scope_label=A.reqs_scope_label()
        let rows=if r.items==nil {[]} else {r.items}
        let parts=A.reqs_split(rows)
        let can=!H.busy && H.command==nil && A.alert_kind()==""
        let stop_view=A.reqs_stop_view()
        mod.widgets.HagencyLargeTitle{text:if stop_view {A.t("Stop Some Agents","停止部分 Agent")} else if tab {A.t("Agent Requests","Agent 申请")} else {A.t("Requests","申请")}}
        mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:2} text:if pool_scope!="" {scope_label} else if tab {A.t("Agents asking to use your resource pools","申请使用你资源池的 Agent")} else {A.t("All resource pools","全部资源池")}}
        if !A.pool_enabled() {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info}}
            mod.widgets.HagencyWrapTitle{text:A.t("This server needs the resource-pool Agent update before accepting new requests.","此服务器需要更新资源池 Agent 流程后才能接受新申请。")}
        }}}
        if A.pool_enabled() {View{width:Fill height:Fit flow:Down spacing:6
            if tab && pool_scope!="" {View{width:Fill height:Fit padding:Inset{top:4} mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                owner_requests_all := mod.widgets.HagencyListTap{enabled:can on_click: || A.reqs_all_pools()}
                mod.widgets.HagencyListBody{
                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.projects}}
                    mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.t("Only ","仅显示 ")+scope_label}
                    mod.widgets.HagencyAccentText{width:Fit text:A.t("Show All","显示全部")}
                }
            }}}}
            if !stop_view {View{width:Fill height:Fit padding:Inset{top:6 bottom:6}
                mod.widgets.HagencySegments{
                    if r.filter=="pending" {owner_pending := mod.widgets.HagencyTabOn{text:A.t("To Review","待审批") enabled:can on_click: || A.reqs_filter("pending")}}
                    if r.filter!="pending" {owner_pending := mod.widgets.HagencyTab{text:A.t("To Review","待审批") enabled:can on_click: || A.reqs_filter("pending")}}
                    if r.filter=="all" {owner_history := mod.widgets.HagencyTabOn{text:A.t("All Requests","全部申请") enabled:can on_click: || A.reqs_filter("all")}}
                    if r.filter!="all" {owner_history := mod.widgets.HagencyTab{text:A.t("All Requests","全部申请") enabled:can on_click: || A.reqs_filter("all")}}
                }
            }}
            if stop_view && r.items!=nil {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:6 bottom:6}
                let using=A.reqs_using(rows)
                let stopped=A.reqs_stopped_rows(rows)
                if A.reqs_pool_over() {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("New requests can’t be approved for now","暂时不能批准新的 Agent 申请")}
                        reqs_stop_why := mod.widgets.HagencyWrapSubtitle{text:A.t("This pool is over its monthly maximum. Stopping an Agent returns what it was given but hasn’t used to the pool; the alert clears by itself once use is back under the maximum.","这个资源池超出了每月上限。停止一个 Agent 后，分给它但没用掉的额度会回到资源池；用量回到上限以内时，告警自动解除。")}
                    }
                }}}
                if r.result!=nil {View{width:Fill height:Fit padding:Inset{top:2}
                    let note=A.reqs_note(r.result)
                    mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                        View{width:Fill height:Fit flow:Down spacing:3
                            mod.widgets.HagencyWrapTitle{draw_text.text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE} text:note.title}
                            mod.widgets.HagencyWrapSubtitle{text:note.text}
                        }
                        request_result_open := mod.widgets.HagencyGetButton{text:A.t("View","查看") enabled:can on_click: || A.open_pool_agent(r.result.id)}
                    }}
                }}
                mod.widgets.HagencyListLabel{text:A.t("AGENTS USING THIS POOL","使用中的 Agent")}
                if using.len()==0 {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    mod.widgets.HagencyWrapTitle{text:A.t("No Agent is using this pool right now","现在没有 Agent 在用这个资源池")}
                }}}
                if using.len()>0 {mod.widgets.HagencyList{for index item in using {let q=item View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:64}}}
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:11 bottom:11} align:Align{y:0.5}
                        mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                        View{width:Fill height:Fit flow:Down spacing:3
                            mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:q.definition.name}
                            mod.widgets.HagencyWrapSubtitle{text:A.reqs_given_line(q)}
                        }
                        request_stop := mod.widgets.HagencyPillDanger{width:Fit padding:Inset{left:16 right:16} text:A.t("Stop","停止") enabled:can on_click: || A.reqs_ask_stop(q)}
                    }
                }}}}
                if using.len()>0 {mod.widgets.HagencyListNote{text:A.t("A stopped Agent takes no new work from this pool. Work it already finished stays.","停止后，它不再从这个资源池接新任务；已经完成的工作不受影响。")}}
                if stopped.len()>0 {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("STOPPED","已停止")}
                    mod.widgets.HagencyList{for index item in stopped {let q=item View{width:Fill height:Fit flow:Down
                        if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:64}}}
                        mod.widgets.HagencyListFit{
                            View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:11 bottom:11} align:Align{y:0.5}
                                mod.widgets.HagencyAvatarSmall{mod.widgets.HagencyAvatarSmallGlyph{draw_icon.color:mod.widgets.RINX_MUTED}}
                                View{width:Fill height:Fit flow:Down spacing:3
                                    mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:q.definition.name}
                                    request_stopped_state := mod.widgets.HagencyWrapSubtitle{text:A.t("Stopped · what it hasn’t used goes back to the pool","已停止 · 没用掉的额度会回到资源池")}
                                }
                                mod.widgets.HagencyChevron{}
                            }
                            owner_request_open := mod.widgets.HagencyListFitTap{enabled:can on_click: || A.open_pool_agent(q.id)}
                        }
                    }}}
                }}
            }}
            if r.result!=nil && !stop_view {View{width:Fill height:Fit padding:Inset{bottom:6}
                let note=A.reqs_note(r.result)
                let yes=r.result.approve
                mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                    mod.widgets.HagencyRowIcon{draw_bg.color:if yes {mod.widgets.RINX_SUCCESS_BG} else {mod.widgets.RINX_SELECTED} mod.widgets.HagencyRowGlyph{draw_icon.svg:if yes {mod.rinx_icons.check} else {mod.rinx_icons.close} draw_icon.color:if yes {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_MUTED}}}
                    View{width:Fill height:Fit flow:Down spacing:3
                        mod.widgets.HagencyWrapTitle{draw_text.text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE} text:note.title}
                        mod.widgets.HagencyWrapSubtitle{text:note.text}
                    }
                    request_result_open := mod.widgets.HagencyGetButton{text:A.t("View","查看") enabled:can on_click: || A.open_pool_agent(r.result.id)}
                }}
            }}
            if r.items==nil && r.state!="error" {mod.widgets.HagencyList{for j in [0,1] {View{width:Fill height:Fit flow:Down
                if j>0 {mod.widgets.HagencyListDivider{margin:Inset{left:64}}}
                View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:14 bottom:14} align:Align{y:0.5}
                    mod.widgets.HagencySkeleton{width:38 height:38}
                    View{width:Fill height:Fit flow:Down spacing:8 mod.widgets.HagencySkeleton{width:150 height:14} mod.widgets.HagencySkeleton{width:110 height:12}}
                }
            }}}}
            if r.items==nil && r.state=="error" {mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load requests","暂时无法读取申请")}
                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(r.error)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    requests_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.reqs_load(nil)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if r.items!=nil && rows.len()==0 && !stop_view {mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:6 align:Align{x:0.5} padding:Inset{left:16 right:16 top:22 bottom:22}
                mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                mod.widgets.HagencyListTitle{width:Fit text:if r.filter=="pending" {A.t("Nothing to review","没有等你审批的申请")} else {A.t("No requests yet","还没有申请")}}
                mod.widgets.HagencyListSubtitle{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:A.t("When an Agent asks to use your pool, it shows up here.","Agent 申请使用你的资源池时，会出现在这里。")}
            }}}
            if parts.decide.len()>0 && !stop_view {mod.widgets.HagencyListLabel{text:A.t("NEEDS YOUR DECISION","需要你决定")}}
            if !stop_view {for item in parts.decide {let q=item let blocked=A.reqs_blocked(q) View{width:Fill height:Fit flow:Down padding:Inset{bottom:6}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyListFit{
                        View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:8} align:Align{y:0.5}
                            mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                            View{width:Fill height:Fit flow:Down spacing:3
                                mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis draw_text +: {text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE}} text:q.definition.name}
                                mod.widgets.HagencyWrapSubtitle{text:A.reqs_line(q)}
                                if pool_scope=="" {mod.widgets.HagencyListSubtitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:q.poolLabel}}
                            }
                            mod.widgets.HagencyChevron{}
                        }
                        owner_request_open := mod.widgets.HagencyListFitTap{enabled:can on_click: || A.open_pool_agent(q.id)}
                    }
                    if blocked!="" {View{width:Fill height:Fit flow:Right spacing:8 padding:Inset{left:64 right:14 top:0 bottom:4} align:Align{y:0.0}
                        mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}
                        request_blocked := mod.widgets.HagencyWrapSubtitle{text:blocked draw_text.color:mod.widgets.RINX_WARNING_FG}
                    }}
                    View{width:Fill height:Fit flow:Right spacing:8 padding:Inset{left:64 right:14 top:2 bottom:12}
                        request_reject := mod.widgets.HagencyPillDanger{text:A.t("Decline","拒绝") enabled:can on_click: || A.reqs_ask(q,"reject")}
                        request_approve := mod.widgets.HagencyPillPrimary{text:A.t("Approve","批准") enabled:can && blocked=="" on_click: || A.reqs_ask(q,"approve")}
                    }
                }
            }}}
            if parts.other.len()>0 && !stop_view {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:if r.filter=="pending" {A.t("WAITING ON OTHERS","等待其他人处理")} else {A.t("HANDLED","已处理的申请")}}
                mod.widgets.HagencyList{for index item in parts.other {let q=item View{width:Fill height:Fit flow:Down
                    let tone=A.pool_tone(q)
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:64}}}
                    mod.widgets.HagencyListFit{
                        View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:11 bottom:11} align:Align{y:0.5}
                            mod.widgets.HagencyAvatarSmall{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyAvatarSmallGlyph{draw_icon.color:A.local_tone_fg(tone)}}
                            View{width:Fill height:Fit flow:Down spacing:3
                                mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:q.definition.name}
                                mod.widgets.HagencyWrapSubtitle{text:A.reqs_line(q)+(if pool_scope=="" {" · "+q.poolLabel} else {""})}
                                mod.widgets.HagencyListSubtitle{text:A.reqs_state_line(q) draw_text.color:if tone=="" {mod.widgets.RINX_MUTED} else {A.local_tone_fg(tone)}}
                            }
                            mod.widgets.HagencyChevron{}
                        }
                        owner_request_open := mod.widgets.HagencyListFitTap{enabled:can on_click: || A.open_pool_agent(q.id)}
                    }
                }}}
            }}
            if r.next!=nil {mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                requests_more := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.reqs_load(r.next)}
                mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More","显示更多")}}
            }}}
            if !stop_view {mod.widgets.HagencyListNote{padding:Inset{left:7 right:7 top:6 bottom:2} text:A.t("Approving gives that Agent the amount it asked for from the pool. Declining closes the request.","批准后，从资源池分给这个 Agent 它申请的额度；拒绝后申请会关闭。")}}
        }}
    }}}

    if H.ready && (H.page=="pools" || H.page=="pool_apply" || H.page=="pool_agents" || H.page=="pool_agent") {

    if !A.pool_enabled(){mod.widgets.HagencyCard{
        mod.widgets.HagencyTitle{text:A.t("Resource pools","资源池")}
        mod.widgets.HagencyCopy{text:A.t("This server needs the resource-pool Agent update before accepting new requests.","此服务器需要更新资源池 Agent 流程后才能接受新申请。")}
    }} else {
    if H.page=="pools"{View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{bottom:28} mod.widgets.HagencyColumn{
        mod.widgets.HagencyLargeTitle{text:A.t("Resource Pools","资源池")}
        mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:2} text:A.t("Pick a pool to request an Agent. It’s ready once the owner approves.","选择资源池申请 Agent，所有者批准后即可使用。")}
        if H.pool_rows.len()==0 {mod.widgets.HagencyList{mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:if H.busy {A.t("Loading…","正在读取…")} else {A.t("No pools are open yet.","暂时没有可用的资源池。")}}}}}}
        if H.pool_rows.len()>0 {mod.widgets.HagencyList{
            for index row in H.pool_rows {let pool=row let mine=A.my_pool_agents(pool.id) View{width:Fill height:Fit flow:Down
                if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:66}}}
                View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.0}
                    View{width:Fit height:Fit padding:Inset{top:2} mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.projects draw_icon.color:mod.widgets.RINX_INFO_FG}}}
                    View{width:Fill height:Fit flow:Down spacing:5
                        mod.widgets.HagencyListTitle{text:pool.label}
                        mod.widgets.HagencyListSubtitle{text:A.pool_person(pool.ownerMxid)+" · "+A.pool_capacity(pool)}
                        if mine!="" {mod.widgets.HagencyListSubtitle{text:A.t("My Agents: ","我的 Agent：")+mine draw_text.color:mod.widgets.RINX_ACCENT}}
                        if !pool.canRequest {mod.widgets.HagencyListSubtitle{text:if pool.blockingReason=="pool_not_shared_with_account" {A.t("Not shared with your account yet.","尚未向你的账号开放。")} else {A.t("The owner hasn’t published it yet.","所有者尚未发布。")}}}
                        if pool.capabilities.len()>0 {View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:6 padding:Inset{top:2}
                            for index capability in pool.capabilities {if index<3 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} mod.widgets.HagencyPillText{text:A.capability_label(capability)}}}}
                            if pool.capabilities.len()>3 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} mod.widgets.HagencyPillText{text:"+"+(pool.capabilities.len()-3)}}}
                        }}
                    }
                    if pool.canRequest {View{width:Fit height:Fit padding:Inset{top:4} pool_request := mod.widgets.HagencyGetButton{text:A.t("Request","申请 Agent") enabled:!H.busy && H.command==nil on_click:||A.pool_begin(pool)}}}
                    if !pool.canRequest {View{width:Fit height:Fit padding:Inset{top:10} mod.widgets.HagencyPill{mod.widgets.HagencyPillText{text:A.t("Not open","未开放")}}}}
                }
            }}
            if H.pool_after!=nil {View{width:Fill height:Fit flow:Down
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    pools_more := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.load_pools(H.pool_after)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show more","显示更多")}}
                }
            }}
        }}
    }}}
    if H.page=="pool_apply" && H.pool_draft!=nil{let d=H.pool_draft
        let editable=A.pool_editable()
        let limit=A.pool_limit(d.pool)
        let amount=A.web_int(d.tokens,-1)
        let amount_error=A.pool_amount_error(d)
        let failure=A.recipient_optional(d,"failure")
        pool_application := mod.widgets.HagencyCard{
            mod.widgets.HagencyCardHeading{
                mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.person}}
                View{width:Fill height:Fit flow:Down spacing:4
                    mod.widgets.HagencyTitle{text:A.t("Request Agent","申请 Agent")}
                    mod.widgets.HagencyHint{text:d.pool.label+" · "+d.pool.ownerMxid}
                }
            }
            pool_pending := mod.widgets.HagencyStatus{visible:H.command!=nil
                mod.widgets.HagencyCopy{text:A.t("The previous submission is unresolved. Recover that request before editing.","上次提交结果尚未确认，请先恢复原申请再修改。")}
            }
            pool_failure_box := mod.widgets.HagencyStatus{visible:failure!=nil && failure!="" flow:Down draw_bg.color:mod.widgets.RINX_DANGER_BG
                pool_failure := mod.widgets.HagencyCopy{draw_text.color:mod.widgets.RINX_DANGER_FG text:if failure!=nil && failure!=""{A.pool_reason(failure)}else{""}}
            }
            pool_editor := mod.widgets.HagencyFormGroup{visible:!d.review
                    mod.widgets.HagencyFieldLabel{text:A.t("Agent name","Agent 名称")}
                    pool_name := mod.widgets.HagencyInput{text:d.name is_read_only:!editable || d.roomCommand!="" on_change:|s|{if A.pool_editable() && d.roomCommand=="" {d.name=s A.save() ui.pool_review.set_enabled(A.pool_valid(H.pool_draft))}}}
                    mod.widgets.HagencyFieldLabel{text:A.t("Instructions","说明")}
                    pool_description := mod.widgets.HagencyInput{text:d.description is_read_only:!editable on_change:|s|{if A.pool_editable(){d.description=s A.save()}}}
                    mod.widgets.HagencyFieldLabel{text:A.t("Capability","能力")}
                    mod.widgets.HagencyActions{for value in d.pool.capabilities{let cap=value
                        mod.widgets.HagencyChoice{text:A.capability_label(cap) enabled:editable draw_bg.color:if d.capability==cap{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE}
                            draw_text.color:if d.capability==cap{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}
                            on_click:||{if A.pool_editable(){d.capability=cap d.failure=nil A.save() A.redraw()}}}
                    }}
            }
            pool_summary := mod.widgets.HagencySection{visible:d.review
                mod.widgets.HagencySectionTitle{text:d.name+" · "+d.capability}
                mod.widgets.HagencyCopy{text:d.description}
            }
            pool_allowance := mod.widgets.HagencyCard{draw_bg +: {color:mod.widgets.RINX_SELECTED border_size:0} spacing:10
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.resources}
                    mod.widgets.HagencySectionTitle{text:A.t("Token allowance","Token 额度")}
                    pool_limit_refresh := mod.widgets.HagencyIconButton{enabled:editable draw_icon.svg:mod.rinx_icons.refresh on_click:||A.pool_refresh()}
                }
                pool_limit := mod.widgets.HagencyCopy{text:A.t("Request limit: ","本次申请上限：")+if H.pool_checked && limit!=nil{A.tokens(limit)+" tokens"}else{A.t("Refresh to verify","待刷新确认")}}
                pool_amount_editor := mod.widgets.HagencyFormGroup{visible:!d.review
                    mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Requested tokens","申请 token")}
                    pool_tokens := mod.widgets.HagencyNumberInput{slider_mode:false width:Fill minimum:1 text:d.tokens is_read_only:!editable on_change:|s|A.pool_tokens(s)}
                    pool_slider := mod.widgets.RinxAmountSlider{enabled:editable && H.pool_checked && limit!=nil && limit>0
                        value:if limit!=nil && limit>0{max(0,min(1,amount/limit))}else{0}
                        on_change:|ratio|A.pool_ratio(ratio)}
                    pool_range := View{width:Fill height:Fit flow:Right
                        mod.widgets.HagencyHint{width:Fill text:"1 token"}
                        mod.widgets.HagencyHint{width:Fit text:if H.pool_checked && limit!=nil{A.tokens(limit)+" tokens"}else{"—"}}
                    }
                    pool_presets := mod.widgets.HagencyActions{
                        pool_ten := mod.widgets.HagencyButton{text:"10%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(0.1)}
                        pool_quarter := mod.widgets.HagencyButton{text:"25%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(0.25)}
                        pool_half := mod.widgets.HagencyButton{text:"50%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(0.5)}
                        pool_max := mod.widgets.HagencyButton{text:"100%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(1)}
                    }
                }
                pool_requested := mod.widgets.HagencyTitle{visible:d.review text:A.tokens(amount)+" tokens"}
                pool_amount_error_box := mod.widgets.HagencyStatus{visible:amount_error!="" flow:Down draw_bg.color:mod.widgets.RINX_DANGER_BG
                        pool_amount_error := mod.widgets.HagencyCopy{draw_text.color:mod.widgets.RINX_DANGER_FG text:amount_error}
                }
                mod.widgets.HagencyHint{text:A.t("This is the request ceiling, not a confirmed reservation. Actual available capacity is checked after owner approval.","这是申请上限，额度尚未预留；owner 批准后还需确认实际可用容量。")}
            }
            pool_room_hint := mod.widgets.HagencyHint{visible:d.roomId!="" text:A.t("The existing conversation will be reused for this application.","此申请将继续使用已创建的聊天房间。")}
            pool_actions := mod.widgets.HagencyActions{

                pool_review := mod.widgets.RinxKeyPrimaryButton{visible:!d.review text:A.t("Review request","核对申请") enabled:editable && A.pool_valid(d) on_click:||A.pool_review()}
                pool_edit := mod.widgets.HagencyButton{visible:d.review text:A.t("Edit","修改") enabled:editable on_click:||A.pool_edit()}
                pool_submit := mod.widgets.RinxKeyPrimaryButton{visible:d.review text:A.t("Submit to resource owner","提交给资源 owner") enabled:editable && A.pool_valid(d) on_click:||A.pool_send()}
                pool_discard := mod.widgets.HagencyButton{visible:d.roomCommand=="" text:A.t("Discard draft","放弃草稿") enabled:editable on_click:||{if A.pool_editable(){H.pool_draft=nil A.save() A.navigate("pools")}}}
            
            }
        }
    }
    if H.page=="pool_agents"{
        if H.entry_role=="owner"{mod.widgets.HagencyTitle{text:A.t("Agent requests","Agent 申请")}}
        else {mod.widgets.HagencyLargeTitle{text:A.t("My Agents","我的 Agent")}}
        if H.entry_role=="owner"{mod.widgets.HagencyHint{text:A.t("Review capacity requests for resources you own.","审核使用你所拥有资源的容量申请。")}}
        if H.entry_role=="manager" && H.page=="pool_agents"{View{width:Fill height:Fit flow:Down spacing:6
            mod.widgets.HagencyListLabel{text:A.t("LOCAL AGENTS","本地 Agent")}
            mod.widgets.HagencyList{
                if H.local_list==nil {mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("Loading…","正在读取…")}}}}
                if H.local_list!=nil && H.local_list.len()==0 {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("No local agents yet","还没有本地 Agent")}}}
                    mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                    mod.widgets.HagencyListRow{
                        local_add := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.native_open("local_agents")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Add Local Agent","添加本地 Agent")}}
                    }
                }}
                if H.local_list!=nil {for index row in H.local_list {View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:66}}}
                    mod.widgets.HagencyListTall{
                        local_agent_open := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_personal_agent(row.id)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyAvatarSmall{mod.widgets.HagencyAvatarSmallGlyph{}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:row.displayName}
                                mod.widgets.HagencyListSubtitle{text:if row.local==nil {A.t("Checking…","正在检查…")} else if row.local.here {A.local_state_text(row.local.service.state)+A.t(" · This device"," · 本机")} else {A.local_state_text("elsewhere")}}
                            }
                            if row.local!=nil {mod.widgets.HagencyPillDot{draw_bg.color:A.local_tone_fg(row.local.service.state)}}
                            mod.widgets.HagencyChevron{}
                        }
                    }
                }}}
            }
            mod.widgets.HagencyListNote{text:A.t("Run on your own device with your own model account.","在你自己的设备上运行，使用你自己的模型账号。")}
            mod.widgets.HagencyListLabel{text:A.t("PROJECT AGENTS","项目 Agent · 组织资源池")}
            mod.widgets.HagencyList{
                if A.pool_agent_rows().len()==0 {mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:if H.busy{A.t("Loading…","正在读取…")}else if !H.ux.inboxReady{A.t("Couldn’t load project Agents","项目 Agent 暂时无法加载")}else{A.t("No project Agents yet","还没有项目 Agent")}}}}}
                for index item in A.pool_agent_rows(){let r=item View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:66}}}
                    mod.widgets.HagencyListTall{
                        pool_agent_open := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_pool_agent(r.id)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:r.definition.name}
                                mod.widgets.HagencyListSubtitle{text:A.local_pool_state(r)}
                            }
                            mod.widgets.HagencyListValue{text:A.local_tokens(r.requestedTokens)+A.t(" tokens"," token")}
                            mod.widgets.HagencyChevron{}
                        }
                    }
                }}
                if H.pool_draft!=nil {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        pool_continue := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.navigate("pool_apply")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Continue saved application","继续未完成的申请")} mod.widgets.HagencyChevron{}}
                    }
                }}
                if H.pool_agent_after!=nil {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        pool_more := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.load_pool_agents(H.pool_agent_after)}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show more","显示更多")}}
                    }
                }}
            }
            mod.widgets.HagencyListNote{text:A.t("Capacity comes from an organization pool, approved by its owner.","额度来自组织资源池，由资源所有者审批。")}
        }}
        else {View{width:Fill height:Fit flow:Down spacing:16
            if H.entry_role=="owner" && H.owner.poolId!=""{mod.widgets.HagencyStatus{flow:Down
                mod.widgets.HagencyCopy{text:H.owner.poolLabel}
                owner_requests_all := mod.widgets.HagencyButton{text:A.t("All resource pools","全部资源池") enabled:!H.busy on_click:||A.owner_requests(nil)}
            }}
            if H.entry_role=="owner"{owner_inbox_filters := mod.widgets.HagencyActions{
                owner_pending := mod.widgets.HagencyChoice{text:A.t("Needs approval","待审批") enabled:!H.busy draw_bg.color:if H.needs_action{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||A.inbox_filter(true)}
                owner_history := mod.widgets.HagencyChoice{text:A.t("All requests","全部申请") enabled:!H.busy draw_bg.color:if !H.needs_action{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||A.inbox_filter(false)}
            }}
            if A.pool_agent_rows().len()==0{mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:if H.busy{A.t("Loading requests…","正在读取申请…")}else if !H.ux.inboxReady{A.t("Requests could not be loaded","申请暂时无法加载")}else{A.t("No matching requests","暂无符合条件的申请")}}
                mod.widgets.HagencyHint{text:A.t("Applicants choose a published pool. You approve capacity here; accepted Agents appear under All requests.","申请者选择已发布的资源池后，在此审批容量。已处理的 Agent 可在「全部申请」查看。")}
            }}
            for item in A.pool_agent_rows(){let r=item mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:r.definition.name}
                mod.widgets.HagencyCopy{text:A.pool_state(r)}
                mod.widgets.HagencyHint{text:r.poolLabel+" · "+r.resourceOwnerMxid}
                mod.widgets.HagencyHint{text:A.t("Applicant: ","申请者：")+r.managerMxid}
                mod.widgets.HagencySectionTitle{text:A.tokens(r.requestedTokens)+A.t(" tokens requested"," token 申请额度")}
                owner_request_open := mod.widgets.HagencyButton{text:if H.entry_role=="owner" && r.canDecide{A.t("Review request","审批申请")}else{A.t("View Agent","查看 Agent")} enabled:!H.busy on_click:||A.open_pool_agent(r.id)}
            }}
            if H.pool_agent_after!=nil{mod.widgets.HagencyButton{text:A.t("Next page","下一页") enabled:!H.busy on_click:||A.load_pool_agents(H.pool_agent_after)}}
        }}
    }
    if H.page=="pool_agent" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
        if H.pool_detail==nil && H.busy {View{width:Fill height:Fit flow:Down spacing:6
            View{width:Fill height:Fit flow:Down spacing:12 align:Align{x:0.5} padding:Inset{top:6 bottom:14}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_FIELD}
                mod.widgets.HagencySkeleton{width:120 height:24}
                mod.widgets.HagencySkeleton{width:80 height:18}
            }
            for i in [0,1] {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:" "}
                mod.widgets.HagencyList{for j in [0,1,2] {View{width:Fill height:Fit flow:Down
                    if j>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:140 height:14}}
                }}}
            }}
        }}
        if H.pool_detail==nil && !H.busy {mod.widgets.HagencyList{mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("Couldn’t load this Agent. Use refresh at the top to try again.","暂时无法读取此 Agent，请点右上角刷新重试。")}}}}}
        if H.pool_detail!=nil {View{width:Fill height:Fit flow:Down spacing:6
            let r=H.pool_detail
            let alert=H.pool_confirm!=""
            let tone=A.pool_tone(r)
            let owner=H.entry_role=="owner"
            let remove=H.entry_role=="manager" && r.canCancel
            let stop=owner && r.canStopSupply
            let budget=r.assignmentId!=nil
            let control=r.assignmentId!=nil && r.managerMxid==H.session.account
            let decide=owner && r.canDecide
            let refused=r.reservationReason!=nil
            let next=control && (r.membershipState=="matrix_verified" || r.runtimeState=="qualified")
            View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyAvatarGlyph{draw_icon.color:mod.widgets.RINX_INFO_FG}}
                mod.widgets.HagencyHeroName{text:r.definition.name}
                mod.widgets.HagencyPill{draw_bg.color:A.local_tone_bg(tone)
                    mod.widgets.HagencyPillDot{draw_bg.color:A.local_tone_fg(tone)}
                    mod.widgets.HagencyPillText{text:A.local_pool_state(r) draw_text.color:A.local_tone_fg(tone)}
                }
                mod.widgets.HagencyHint{width:Fit text:if owner {A.reqs_line(r)} else {A.t("Project Agent","项目 Agent")}}
                if next {View{width:Fit height:Fit padding:Inset{top:4}
                    pool_agent_start := mod.widgets.HagencyCapsule{text:A.t("Turn On Execution","开启执行") draw_icon.svg:mod.rinx_icons.power enabled:!H.busy && !alert on_click: || A.open_agent_control(r.assignmentId,r.definition.name)}
                }}
                if refused && remove {View{width:Fit height:Fit padding:Inset{top:4}
                    pool_agent_reapply := mod.widgets.HagencyCapsule{text:A.t("Request Again","重新申请") draw_icon.svg:mod.rinx_icons.add enabled:!H.busy && !alert on_click: || A.navigate("pools")}
                }}
            }
            if refused {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                mod.widgets.HagencyListText{
                    mod.widgets.HagencyListTitle{text:if r.reservationReason=="insufficient_capacity" {A.t("Not enough capacity","资源池容量不足")} else {A.t("Capacity couldn’t be given","没能分出额度")}}
                    mod.widgets.HagencyListSubtitle{text:if r.reservationReason=="insufficient_capacity" {A.t("Remove this request, then ask for less or use another pool.","可移除此申请，再以更少额度或其他资源池重新申请。")} else {A.error_text(r.reservationReason)}}
                }
            }}}
            if r.blockingReason!=nil {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                mod.widgets.HagencyListText{
                    mod.widgets.HagencyListTitle{text:A.t("Access changed","资源授权已变化")}
                    mod.widgets.HagencyListSubtitle{text:A.t("Refresh to see what changed.","请刷新查看最新情况。")}
                }
            }}}
            if owner && H.reqs.result!=nil && H.reqs.result.id==r.id {View{width:Fill height:Fit padding:Inset{bottom:4}
                let note=A.reqs_note(H.reqs.result)
                let yes=H.reqs.result.approve
                mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                    mod.widgets.HagencyRowIcon{draw_bg.color:if yes {mod.widgets.RINX_SUCCESS_BG} else {mod.widgets.RINX_SELECTED} mod.widgets.HagencyRowGlyph{draw_icon.svg:if yes {mod.rinx_icons.check} else {mod.rinx_icons.close} draw_icon.color:if yes {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_MUTED}}}
                    View{width:Fill height:Fit flow:Down spacing:3
                        mod.widgets.HagencyWrapTitle{draw_text.text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE} text:if yes {A.t("Approved","已批准")} else {A.t("Declined","已拒绝")}}
                        mod.widgets.HagencyWrapSubtitle{text:note.text}
                    }
                }}
            }}
            if decide {View{width:Fill height:Fit flow:Right spacing:8 padding:Inset{top:4 bottom:4}
                owner_reject := mod.widgets.HagencyPillDanger{text:A.t("Decline","拒绝") enabled:!H.busy && !alert on_click: || {H.pool_confirm="reject" A.redraw()}}
                owner_approve := mod.widgets.HagencyPillPrimary{text:A.t("Approve","批准") enabled:!H.busy && !alert on_click: || {H.pool_confirm="approve" A.redraw()}}
            }}
            if decide && A.reqs_after(r)!="" {owner_after := mod.widgets.HagencyListNote{align:Align{x:0.5} text:A.reqs_after(r).trim()}}
            if budget || control {mod.widgets.HagencyTiles{
                if budget {mod.widgets.HagencyTile{
                    pool_agent_budget := mod.widgets.HagencyTileTap{enabled:!H.busy && !alert on_click: || A.open_agent_budget(r.id,r.definition.name,nil,1)}
                    mod.widgets.HagencyTileBody{mod.widgets.HagencyTileGlyph{draw_icon.svg:mod.rinx_icons.gauge} mod.widgets.HagencyTileLabel{text:A.t("Budget","额度")}}
                }}
                if control {mod.widgets.HagencyTile{
                    pool_agent_control := mod.widgets.HagencyTileTap{enabled:!H.busy && !alert on_click: || A.open_agent_control(r.assignmentId,r.definition.name)}
                    mod.widgets.HagencyTileBody{mod.widgets.HagencyTileGlyph{draw_icon.svg:mod.rinx_icons.power} mod.widgets.HagencyTileLabel{text:A.t("Execution","执行设置")}}
                }}
            }}

            mod.widgets.HagencyListLabel{text:A.t("AGENT","Agent")}
            mod.widgets.HagencyList{
                View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:11 bottom:11} align:Align{y:0.5}
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:mod.widgets.RINX_INFO_FG}}
                    mod.widgets.HagencyListTitle{text:A.t("Capability","能力")}
                    mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} mod.widgets.HagencyPillText{text:A.capability_label(r.definition.capability)}}
                }
                if r.definition.description!="" {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyListTitle{text:A.t("Role","职责")}
                            mod.widgets.HagencyListSubtitle{text:r.definition.description}
                        }
                    }
                }}
            }

            mod.widgets.HagencyListLabel{text:A.t("QUOTA","额度")}
            mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.gauge draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyListTitle{text:A.t("Requested","申请额度")}
                    mod.widgets.HagencyListValue{text:if owner {A.tokens(r.requestedTokens)} else {A.pool_amount(r.requestedTokens)}}
                }
                mod.widgets.HagencyListDivider{}
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.projects}}
                    mod.widgets.HagencyListTitle{text:A.t("Resource pool","资源池")}
                    mod.widgets.HagencyListValue{text:r.poolLabel}
                }
            }

            mod.widgets.HagencyListLabel{text:A.t("PEOPLE","成员")}
            mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.person draw_icon.color:mod.widgets.RINX_INFO_FG}}
                    mod.widgets.HagencyListTitle{text:if owner {A.t("Requested by","申请人")} else {A.t("Managed by","管理者")}}
                    mod.widgets.HagencyListValue{text:if owner {A.sub_person(r.managerMxid)} else {A.pool_person(r.managerMxid)}}
                }
                mod.widgets.HagencyListDivider{}
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.person draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    mod.widgets.HagencyListTitle{text:A.t("Resource owner","资源所有者")}
                    mod.widgets.HagencyListValue{text:if owner {A.sub_person(r.resourceOwnerMxid)} else {A.pool_person(r.resourceOwnerMxid)}}
                }
            }
            if control && r.membershipState=="matrix_verified" {mod.widgets.HagencyListNote{text:A.t("Turn on auto-reply in Execution, then send it work in the “"+r.definition.name+"” chat.","在「执行设置」中开启自动回复后，即可在「"+r.definition.name+"」会话中派发任务。")}}

            if remove || stop {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:12}
                mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    pool_agent_stop := mod.widgets.HagencyListTap{enabled:!H.busy && !alert on_click: || {H.pool_confirm="stop" A.redraw()}}
                    View{width:Fill height:Fill align:Align{x:0.5 y:0.5} mod.widgets.HagencyDangerText{text:if stop {A.t("Stop Using This Pool…","停止使用这个资源池…")} else if refused {A.t("Remove Request…","移除申请…")} else {A.t("Remove Agent…","移除 Agent…")}}}
                }}
                mod.widgets.HagencyListNote{text:if stop {A.t("It stops taking new work from your pool.","此 Agent 将不再从你的资源池接收新任务。")} else {A.t("It stops taking new work.","移除后，此 Agent 不再接收新任务。")}}
            }}
        }}
    }}}

    }
    }
    if H.needs_signin {mod.widgets.HagencyCard{
        mod.widgets.HagencyTitle{text:A.t("Restore Hagency access", "恢复 Hagency 访问")}
        mod.widgets.HagencyCopy{text:A.error_text("native_resume_missing")}
        mod.widgets.HagencyActions{signin_again := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Sign in again", "重新登录") on_click: || A.reauthenticate()}}
    }}
    if !H.ready {
        mod.widgets.HagencyCard{
            mod.widgets.HagencyTitle{text: A.t("Welcome to Hagency", "欢迎使用 Hagency")}
            mod.widgets.HagencyCopy{text: A.t("Connect this device's agent resources to your Matrix server. Use your current account for every step.", "将此设备的 Agent 资源连接到 Matrix 服务器，全程使用当前账号。")}
            mod.widgets.HagencyHint{text: A.t("Resource owners publish pools and approve Agent requests. Your server administrator reviews resource admission.", "资源 owner 发布资源池并审批 Agent 申请，服务器管理员审核资源的加入申请。")}
            if !H.needs_signin {View{width:Fill height:Fit retry := mod.widgets.RinxKeyPrimaryButton{text: A.t("Connect with my account", "使用当前账号连接") on_click: || A.connect()}}}
        }
    } else {
        if H.ux.origin!="" && H.page!=H.ux.origin {mod.widgets.HagencyActions{
            origin_back := mod.widgets.HagencyButton{enabled:!H.busy text:if H.ux.origin=="inbox"{A.t("Back to Inbox","返回待办")}else{A.t("Back to overview","返回概览")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.return_origin()}
        }}
        if H.ux.resourceJourney && A.has_page(["provider_accounts","provider_account","account_prepare","account_enrollment","wizard","action"]) && !(H.page=="action" && H.entry_role=="owner") && !(H.page=="wizard" && H.wizard.step>=3) {mod.widgets.HagencySection{
    mod.widgets.HagencyEyebrow{text:A.t("PUBLISH A RESOURCE POOL","发布资源池")}
    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
        for step in [{n:0 title:A.t("Coding tool","编码工具")},{n:1 title:A.t("Pool","资源池")},{n:2 title:A.t("Admission","加入服务器")},{n:3 title:A.t("Publish","发布")}] {
            RoundedView{width:Fit height:Fit padding:Inset{left:10 right:10 top:6 bottom:6} draw_bg +: {color:if A.resource_stage()==step.n{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} border_radius:theme.corner_radius}
                mod.widgets.HagencyHint{width:Fit text:""+(step.n+1)+"  "+step.title draw_text.color:if A.resource_stage()==step.n{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
            }
        }
    }
    mod.widgets.HagencyHint{text:if A.resource_stage()==0{A.t("Choose a provider account, then sign in on the provider’s page.","选择模型服务账号，然后在服务商页面登录。")}else if A.resource_stage()==1{A.t("Choose what this device can contribute: model, capabilities and budget.","选择这台电脑提供的模型、能力和额度。")}else if A.resource_stage()==2{A.t("The server administrator reviews admission; you approve allocation of your capacity.","服务器管理员审核加入申请，由你批准自己的容量分配。")}else{A.t("Set the budget and expiry, then publish once. Published pools are ready for Agent requests.","设置额度与到期时间后，一次发布。已发布的资源池可直接审批 Agent 申请。")}}
}}
        if H.command == nil && H.saved_commands.len() > 0 && A.sub_page() {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:10} mod.widgets.HagencyColumn{
            mod.widgets.HagencyListLabel{text:A.t("UNFINISHED REQUESTS","未完成的请求")}
            mod.widgets.HagencyList{for index row in H.saved_commands {View{width:Fill height:Fit flow:Down
                let kind=A.saved_kind(row)
                let failed=A.recipient_optional(row,"error")!=nil
                if index>0 {mod.widgets.HagencyListDivider{}}
                View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:8 bottom:8} align:Align{y:0.5}
                    mod.widgets.HagencyRowIcon{draw_bg.color:if failed {mod.widgets.RINX_DANGER_BG} else {mod.widgets.RINX_WARNING_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:if failed {mod.rinx_icons.alert} else {mod.rinx_icons.sync} draw_icon.color:if failed {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_WARNING_FG}}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.saved_label(row.operation)}
                        mod.widgets.HagencyWrapSubtitle{text:if kind=="error" {A.error_text(row.error)} else {A.t("Continue it here; it won’t be sent twice.","在这里继续，不会重复提交。")}}
                    }
                    if kind=="web" {web_saved_review := mod.widgets.HagencyGetButton{text:A.t("Continue","继续") enabled:!H.busy on_click:||A.open_saved_web(row)}}
                    if kind=="template" {template_saved_review := mod.widgets.HagencyGetButton{text:A.t("Continue","继续") enabled:!H.busy on_click:||A.open_saved_template(row)}}
                    if kind=="graph" {graph_saved_review := mod.widgets.HagencyGetButton{text:A.t("Continue","继续") enabled:!H.busy on_click:||A.open_saved_graph(row)}}
                    if kind=="task" {task_saved_review := mod.widgets.HagencyGetButton{text:A.t("Continue","继续") enabled:!H.busy on_click:||A.open_saved_task(row)}}
                    if kind=="error" {dismiss_saved := mod.widgets.HagencyGetButton{text:A.t("OK","知道了") on_click: || A.acknowledge(row.commandId)}}
                    if kind=="native" {recover_native := mod.widgets.HagencyGetButton{text:if A.recipient_optional(row,"hasReply")==true {A.t("Continue","继续")} else {A.t("Retry","重试")} on_click: || A.recover_native(row)}}
                }
            }}}
        }}}
        if H.command == nil && H.saved_commands.len() > 0 && !A.sub_page() {mod.widgets.HagencyCard{
            mod.widgets.HagencyCopy{text:A.t("Saved requests", "已保存的请求")}
            mod.widgets.HagencyHint{text:A.t("Your unfinished request is saved. Resume it without submitting a duplicate.", "未完成的请求已保存，恢复时不会重复提交。")}
            for row in H.saved_commands {View{width:Fill height:Fit flow:Down spacing:8
                mod.widgets.HagencyCopy{text:A.saved_label(row.operation)}
                if row.operation=="web_catalog"{View{width:Fit height:Fit web_saved_review := mod.widgets.HagencyButton{text:A.t("Review saved resource change","查看已保存的资源更改") enabled:!H.busy on_click:||A.open_saved_web(row)}}} else if A.is_template_operation(row.operation){View{width:Fit height:Fit template_saved_review := mod.widgets.HagencyButton{text:A.t("Review saved template change","查看已保存的模板更改") enabled:!H.busy on_click:||A.open_saved_template(row)}}} else if A.is_graph_operation(row.operation) {View{width:Fit height:Fit graph_saved_review := mod.widgets.HagencyButton{text:A.t("Review saved graph change","核对已保存的任务图更改") enabled:!H.busy on_click:||A.open_saved_graph(row)}}} else if A.is_task_operation(row.operation) {View{width:Fit height:Fit task_saved_review := mod.widgets.HagencyButton{text:A.t("View saved task change","查看已保存的任务更改") enabled:!H.busy on_click:||A.open_saved_task(row)}}} else if row.error != nil {
                    mod.widgets.HagencyHint{text:A.error_text(row.error)}
                    dismiss_saved := mod.widgets.HagencyButton{text:A.t("Dismiss recorded result", "确认已查看结果") on_click: || A.acknowledge(row.commandId)}
                } else {
                    recover_native := mod.widgets.RinxKeyPrimaryButton{text:if row.hasReply {A.t("Recover recorded result", "恢复已记录的结果")} else {A.t("Retry original request", "重试原请求")} on_click: || A.recover_native(row)}
                }
            }}
        }}
        if H.command != nil && A.sub_page() {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:10} mod.widgets.HagencyColumn{
            mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:10 bottom:10} align:Align{y:0.5}
                if H.busy {View{width:(22+7*mod.widgets.RINX_TEXT_SCALE) height:(22+7*mod.widgets.RINX_TEXT_SCALE) align:Align{x:0.5 y:0.5} mod.widgets.HagencySpinner{}}}
                if !H.busy {mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.sync draw_icon.color:mod.widgets.RINX_WARNING_FG}}}
                mod.widgets.HagencyListText{
                    mod.widgets.HagencyWrapTitle{text:if H.busy {A.t("Sending your change…","正在提交你的更改…")} else {A.t("This change’s result isn’t confirmed yet","这项更改的结果还没确认")}}
                    mod.widgets.HagencyWrapSubtitle{text:if H.busy {A.t("One moment; it won’t be sent twice.","请稍候，不会重复提交。")} else {A.t("Retrying is safe; it won’t be done twice.","可以放心重试，不会重复执行。")}}
                }
                if A.web_connection_service(H.command.service){web_connection_saved_check := mod.widgets.HagencyGetButton{enabled:!H.busy text:A.t("Check","检查") on_click:||A.web_connection_check()}}
                if !H.busy {retry_saved := mod.widgets.HagencyGetButton{enabled:!H.busy text:A.t("Retry","重试") on_click: || A.retry_command()}}
            }}
        }}}
        if H.command != nil && !A.sub_page() {
            mod.widgets.HagencyCard{
                mod.widgets.HagencyCopy{text: A.t("A saved request needs its result", "有一条已保存的请求等待结果")}
                mod.widgets.HagencyHint{text: A.t("Resume this request to see its result. It cannot create a second resource or approve twice.", "恢复此请求以查看结果，不会重复创建资源或重复审批。")}
                if A.web_connection_service(H.command.service){View{width:Fit height:Fit web_connection_saved_check := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Check saved result","检查保存结果") on_click:||A.web_connection_check()}}}
                retry_saved := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text: A.t("Recover saved request", "恢复原请求") on_click: || A.retry_command()}
            }
        }
        if false && H.page=="overview" {
            mod.widgets.HagencySection{
                mod.widgets.HagencyTitle{text:A.t("Your workspace","你的工作台")}
                mod.widgets.HagencyHint{text:A.t("Your next steps, across projects and resources.","集中查看项目与资源的下一步。")}
            }
            if H.ux.dashboard==nil {mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:if H.busy{A.t("Checking your pending work…","正在检查待办…")}else{A.t("Could not load your workspace","暂时无法加载工作台")}}
                mod.widgets.HagencyHint{text:A.t("Refresh to check the latest requests. Saved work is retained.","刷新以查看最新请求，已保存的工作会保留。")}
            }}
            if H.ux.dashboard!=nil {mod.widgets.HagencyCard{
                let d=H.ux.dashboard
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.inbox}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:if d.requests.len()+d.agents.len()>0{A.t("Needs your action","需要你处理")}else if H.ux.dashboardError{A.t("Some updates could not be loaded","部分更新暂时无法加载")}else if d.complete{A.t("You’re up to date","暂无待处理事项")}else{A.t("Checking your pending work…","正在检查待办…")}}
                        mod.widgets.HagencyHint{text:if d.requests.len()+d.agents.len()>0{A.queue_count()+A.t(" pending requests found"," 条待办")}else{A.t("Requests stay in Inbox until a decision is recorded.","请求会保留在待办中，直到决定被记录。")}}
                    }
                    overview_inbox := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Open Inbox","打开待办") on_click:||{H.needs_action=true A.navigate("inbox")}}
                }
                for i in min(3,d.requests.len()) {mod.widgets.HagencyRow{
                    let row=d.requests[i] let {projectName=nil,resourceLabel=nil}=row
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:if projectName!=nil{projectName}else if resourceLabel!=nil{resourceLabel}else{A.t("Resource admission","资源加入")}}
                        mod.widgets.HagencyHint{text:if row.kind=="project_capacity"{A.t("Project approval","项目审批")}else if row.kind=="project_allocation"{A.t("Capacity allocation","容量分配")}else{A.t("Resource admission","资源加入")}}
                    }
                    overview_request := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Review","审核") on_click:||A.open_request(row.id)}
                }}
                for i in min(2,d.agents.len()) {mod.widgets.HagencyRow{
                    let row=d.agents[i]
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:row.definition.name}
                        mod.widgets.HagencyHint{text:A.t("Project agent approval","项目 Agent 审批")}
                    }
                    overview_agent := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Review","审核") on_click:||A.open_agent(row.id)}
                }}
            }}
            if H.ux.resourceJourney || H.project_draft.resource!=nil {mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:A.t("Continue where you left off","继续未完成的设置")}
                mod.widgets.HagencyActions{
                    if H.project_draft.resource!=nil {View{width:Fit height:Fit resume_project := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Continue project request","继续项目申请") on_click:||A.begin_project()}}}
                    if H.ux.resourceJourney {View{width:Fit height:Fit resume_resource := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Continue resource setup","继续资源设置") on_click:||A.begin_setup()}}}
                }
            }}
            if A.projects_enabled() {mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.projects}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Projects you can access","你可访问的项目")}
                        mod.widgets.HagencyHint{text:A.t("Decisions, capacity and agents.","审批、容量与 Agent。")}
                    }
                }
                mod.widgets.HagencyActions{begin_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Request a project","申请项目") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click:||A.begin_project()}}
                if H.ux.dashboard!=nil {View{width:Fill height:Fit flow:Down spacing:8
                    let d=H.ux.dashboard
                    if d.projects.len()==0 {mod.widgets.HagencyHint{text:A.t("Choose an available resource and describe the work. The server administrator reviews new projects.","选择可用资源并说明工作目标，新项目由服务器管理员审核。")}}
                    for i in min(3,d.projects.len()) {mod.widgets.HagencyRow{
                        let row=d.projects[i]
                        View{width:Fill height:Fit flow:Down spacing:4
                            mod.widgets.HagencySectionTitle{text:row.name}
                            mod.widgets.HagencyHint{text:A.project_state_text(row.state)}
                        }
                        overview_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View progress","查看进度") on_click:||{H.ux.origin="overview" A.open_project(row.id)}}
                    }}
                    if d.projects.len()>3 || d.projectAfter!=nil {View{width:Fit height:Fit overview_projects_all := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("All projects","全部项目") on_click:||A.navigate("projects")}}}
                }}
            }}
            mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.resources}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Contribute this device’s capacity","贡献此设备的资源")}
                        mod.widgets.HagencyHint{text:A.t("Own a provider account? Connect it, choose a model, then request server admission.","如果你拥有模型服务账号，可连接账号、选择模型，再申请加入服务器。")}
                    }
                }
                mod.widgets.HagencyActions{
                    setup := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Connect a resource","连接资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.begin_setup()}
                    overview_connections := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Server connections","服务器连接") on_click:||A.navigate("connections")}
                }
                for i in min(2,H.connections.len()) {mod.widgets.HagencyRow{
                    let row=H.connections[i]
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:row.label}
                        mod.widgets.HagencyHint{text:A.connection_status(row)}
                    }
                    open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View connection","查看连接") on_click:||A.open_connection(row.id)}
                }}
            }
            mod.widgets.HagencyRow{
                mod.widgets.HagencyHint{text:A.t("Usage, activity, tasks and advanced management","用量、活动、任务与高级管理")}
                overview_tools := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Tools & activity","工具与活动") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.activity on_click:||{H.page="tools" A.redraw()}}
            }
        }
        if H.page=="tools" {
            mod.widgets.HagencyActions{tools_back := mod.widgets.HagencyButton{text:A.t("Back to overview","返回概览") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.navigate("overview")}}
            mod.widgets.HagencyTitle{text:if H.entry_role=="admin"{A.t("Management console","管理控制台")}else if H.entry_role=="owner"{A.t("Resource activity","资源活动")}else{A.t("Tasks and activity","任务与活动")}}
            console_capabilities := mod.widgets.HagencyCard{visible:H.entry_role!="manager"
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.activity}} mod.widgets.HagencyTitle{text:A.t("Management console","管理控制台")}}
                mod.widgets.HagencyCopy{text:A.t("See your team, available capabilities, account capacity and usage together.","集中查看 Agent 团队、可用能力、账号容量与用量。")}
                mod.widgets.HagencyActions{for kind in ["workforce","capability","usage","accounts","alerts"]{View{width:Fit height:Fit web_console_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.web_title(kind) icon_walk:Walk{width:16 height:16} draw_icon.svg:if kind=="workforce" {mod.rinx_icons.person} else {if kind=="usage" {mod.rinx_icons.activity} else {if kind=="alerts" {mod.rinx_icons.inbox} else {if kind=="accounts" {mod.rinx_icons.connection} else {mod.rinx_icons.resources}}}} on_click:||A.open_web(kind,nil)}}}}
            }


            if H.entry_role=="manager" && A.cleanup_enabled() {mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.inbox}} mod.widgets.HagencyTitle{text:A.t("Agent removal and cleanup","Agent 移除与清理")}}
                mod.widgets.HagencyCopy{text:A.t("Cancel or revoke requests within your project role and follow recorded cleanup progress.", "按你的项目角色取消或撤销申请，并查看已记录的清理进度。")}
                mod.widgets.HagencyActions{overview_cleanup := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View removal status", "查看移除状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_removals(nil,nil,1)}}
            }}
            if H.entry_role=="manager" && A.work_enabled() {mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.activity}} mod.widgets.HagencyTitle{text:A.t("Agent work history","Agent 任务历史")}}
                mod.widgets.HagencyCopy{text:A.t("Read recorded work and per-call usage for projects you manage or administer.", "查看你管理或负责审批的项目任务记录与每次调用的用量。")}
                mod.widgets.HagencyActions{overview_work := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View work history", "查看任务历史") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_work_list(nil,nil,1)}}
            }}
            manager_work_tools := mod.widgets.HagencyCard{visible:H.entry_role=="manager"
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.tasks}} mod.widgets.HagencyTitle{text:A.t("Tasks and board","任务与看板")}}
                mod.widgets.HagencyCopy{text:A.t("Track tasks, comments and workflow stages. Agent execution history is recorded separately.","查看任务、评论与流程阶段；Agent 执行历史单独记录。")}
                mod.widgets.HagencyActions{
                    operator_tasks_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View tasks","查看任务") on_click:||{H.task_from_board=false A.open_tasks(0)}}
                    operator_board_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Task board","任务看板") on_click:||A.open_board({})}
                    operator_graphs_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Task graphs","任务图") on_click:||A.open_flows(nil)}
                    operator_graph_history_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Task graph history","任务图历史") on_click:||A.open_graph_archives()}
                }
            }

            manager_personal := mod.widgets.HagencyCard{visible:H.entry_role=="manager"
                mod.widgets.HagencySectionTitle{text:A.t("Local Agents","本地 Agent")}
                mod.widgets.HagencyCopy{text:A.t("Configure your own Agents and their execution-device settings.","配置你自己的 Agent 及其执行设备设置。")}
                personal_entry := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Local-agent settings","本地 Agent 设置") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.person on_click:||A.open_personal_agents(nil,1)}
            }
            mod.widgets.HagencyHint{text:A.t("Workspace: ","当前工作台：")+A.entry_label(H.entry_role)}
        }
        if H.page == "resources" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{bottom:28} mod.widgets.HagencyColumn{
            let pending=A.pool_pending_total()
            View{width:Fill height:Fit flow:Right spacing:8 align:Align{y:0.5}
                mod.widgets.HagencyLargeTitle{text:A.t("Resource Pools","资源池")}
                owner_device_shortcut := mod.widgets.HagencyBarText{padding:Inset{left:8 right:8} text:A.t("This Computer","这台电脑") enabled:!H.busy on_click:||A.pool_device_open("list")}
                owner_pool_create := mod.widgets.HagencyBackLink{width:Fit{min:44} padding:Inset{left:6 right:8} spacing:4 align:Align{x:0.5 y:0.5} icon_walk:Walk{width:(14+4*mod.widgets.RINX_TEXT_SCALE) height:(14+4*mod.widgets.RINX_TEXT_SCALE)} draw_icon.svg:mod.rinx_icons.add text:A.t("New","新建") enabled:!H.busy && H.command==nil on_click:||A.pool_create_open()}
            }
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.t("Share your coding tool’s capacity. Agents can request a pool once you publish it.","共享编码工具的额度。资源池发布后，Agent 就能申请使用。")}
            if H.notice!="" && !H.busy && H.owner.poolsReady {View{width:Fill height:Fit padding:Inset{bottom:4} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_WARNING_BG
                mod.widgets.HagencyCopy{text:A.notice_text() draw_text.color:mod.widgets.RINX_WARNING_FG}
            }}}
            let device=A.pool_list_device()
            if H.owner.accountId!="" {mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                owner_pool_all := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.owner_pools(nil)}
                mod.widgets.HagencyListBody{
                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.connection}}
                    mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.t("Only ","仅显示 ")+H.owner.accountLabel}
                    mod.widgets.HagencyAccentText{width:Fit text:A.t("Show All","显示全部")}
                }
            }}}
            if H.pool_list_result!=nil {View{width:Fill height:Fit padding:Inset{top:2 bottom:2} mod.widgets.HagencyStatus{draw_bg.color:A.local_tone_bg(H.pool_list_result.tone)
                pool_list_result_text := mod.widgets.HagencyCopy{text:H.pool_list_result.text draw_text.color:A.local_tone_fg(H.pool_list_result.tone)}
                pool_list_result_done := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || {H.pool_list_result=nil A.redraw()}}
            }}}
            let todo=A.pool_todo()
            if todo.len()>0 {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:A.t("NEEDS YOU","需要你处理")}
                mod.widgets.HagencyList{for index entry in todo {let item=entry View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:if item.kind=="alerts" || item.kind=="device" {mod.widgets.RINX_DANGER_BG} else if item.kind=="draft" {mod.widgets.RINX_INFO_BG} else {mod.widgets.RINX_WARNING_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:A.pool_todo_icon(item.kind) draw_icon.color:if item.kind=="alerts" || item.kind=="device" {mod.widgets.RINX_DANGER_FG} else if item.kind=="draft" {mod.widgets.RINX_INFO_FG} else {mod.widgets.RINX_WARNING_FG}}}
                            mod.widgets.HagencyListText{
                                if item.kind=="publish" {mod.widgets.HagencyAccentText{max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.pool_todo_title(item)}}
                                if item.kind!="publish" {mod.widgets.HagencyWrapTitle{text:A.pool_todo_title(item)}}
                                mod.widgets.HagencyWrapSubtitle{text:A.pool_todo_line(item)}
                            }
                            if item.kind=="requests" {mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:""+item.count}}}
                            if item.kind!="publish" {mod.widgets.HagencyChevron{}}
                        }
                        if item.kind=="requests" {owner_pool_requests := mod.widgets.HagencyListFitTap{enabled:!H.busy on_click:||A.pool_todo_open(item)}}
                        if item.kind=="publish" {owner_pool_publish := mod.widgets.HagencyListFitTap{enabled:!H.busy && H.command==nil on_click:||A.pool_todo_open(item)}}
                        if item.kind=="device" {pool_device_banner := mod.widgets.HagencyListFitTap{enabled:!H.busy && H.command==nil on_click:||A.pool_todo_open(item)}}
                        if item.kind=="draft" {pool_create_continue := mod.widgets.HagencyListFitTap{enabled:!H.busy on_click:||A.pool_todo_open(item)}}
                        if item.kind!="requests" && item.kind!="publish" && item.kind!="device" && item.kind!="draft" {owner_todo_open := mod.widgets.HagencyListFitTap{enabled:!H.busy on_click:||A.pool_todo_open(item)}}
                    }
                }}}
            }}
            if !H.owner.poolsReady && H.busy {mod.widgets.HagencyList{for j in [0,1,2] {View{width:Fill height:Fit flow:Down
                if j>0 {mod.widgets.HagencyListDivider{margin:Inset{left:66}}}
                View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:14 bottom:14} align:Align{y:0.5}
                    mod.widgets.HagencySkeleton{width:38 height:38}
                    View{width:Fill height:Fit flow:Down spacing:8 mod.widgets.HagencySkeleton{width:150 height:14} mod.widgets.HagencySkeleton{width:Fill height:6} mod.widgets.HagencySkeleton{width:110 height:12}}
                }
            }}}}
            if !H.owner.poolsReady && !H.busy {mod.widgets.HagencyList{
                View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyListTitle{text:A.t("Resource pools could not be loaded","资源池暂时无法加载")}
                        mod.widgets.HagencyListSubtitle{text:A.t("Check the connection, then try again.","请检查网络连接后重试。")}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                mod.widgets.HagencyListRow{
                    owner_pool_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.refresh()}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if H.owner.poolsReady && H.resources.len()==0 {mod.widgets.HagencyList{
                View{width:Fill height:Fit flow:Down spacing:8 align:Align{x:0.5} padding:Inset{left:20 right:20 top:24 bottom:20}
                    mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.resources draw_icon.color:mod.widgets.RINX_INFO_FG}}
                    mod.widgets.HagencySectionTitle{width:Fit text:A.t("No resource pools yet","还没有资源池")}
                    mod.widgets.HagencyHintCenter{text:if H.owner.accountId!="" {A.t("This coding tool has no pools yet.","这个编码工具还没有资源池。")} else {A.t("Pick a coding tool and model, then set how much it may use each month.","选择编码工具和模型，再设置每月最多可用的额度。")}}
                    View{width:Fit height:Fit padding:Inset{top:6} create := mod.widgets.HagencyCapsule{text:A.t("Create Resource Pool","创建资源池") draw_icon.svg:mod.rinx_icons.add enabled:!H.busy && H.command==nil on_click:||A.pool_create_open()}}
                }
            }}
            if H.owner.poolsReady && H.resources.len()>0 {mod.widgets.HagencyList{
                for index item in H.resources {let row=item let s=A.pool_row(row) View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:66}}}
                    mod.widgets.HagencyFitRow{
                        View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:12 top:12 bottom:12} align:Align{y:0.5}
                            mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.resources draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            View{width:Fill height:Fit flow:Down spacing:5
                                View{width:Fill height:Fit flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {4} else {8}) align:Align{y:0.5}
                                    mod.widgets.HagencyListTitle{max_lines:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {1}) text_overflow:TextOverflow.Ellipsis draw_text +: {text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE}} text:A.resource_title(row)}
                                    if s.status.key!="" {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(s.status.tone)
                                        mod.widgets.HagencyPillText{text:s.status.text draw_text.color:A.local_tone_fg(s.status.tone)}
                                    }}
                                }
                                mod.widgets.HagencyListSubtitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.pool_tool_text(row)}
                                View{width:Fill height:6 flow:Overlay
                                    RoundedView{width:Fill height:6 show_bg:true draw_bg +: {color:mod.widgets.RINX_BORDER border_radius:3.0}}
                                    if s.ratio>0 {View{width:Fill height:6 flow:Right
                                        RoundedView{width:Fill{weight:s.ratio} height:6 show_bg:true draw_bg +: {color:if s.low {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_ACCENT} border_radius:3.0}}
                                        if s.ratio<1 {View{width:Fill{weight:1-s.ratio} height:6}}
                                    }}
                                }
                                mod.widgets.HagencyWrapSubtitle{text:s.capacity draw_text.color:if s.low {mod.widgets.RINX_DANGER_FG} else if s.lapsed {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_MUTED}}
                                if s.badge>0 {View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:6
                                    for pill in A.pool_attention_pills(s) {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(pill.tone)
                                        mod.widgets.HagencyPillText{text:pill.text draw_text.color:A.local_tone_fg(pill.tone)}
                                    }}
                                }}
                                if s.badge==0 && s.attention!="" {mod.widgets.HagencyWrapSubtitle{text:s.attention draw_text.color:mod.widgets.RINX_MUTED}}
                            }
                            View{width:(20+10*mod.widgets.RINX_TEXT_SCALE) height:Fit align:Align{x:1.0 y:0.5}
                                if s.badge>0 {mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:""+s.badge}}}
                                if s.badge==0 && s.unknown {mod.widgets.HagencyMutedBadge{mod.widgets.HagencyMutedCount{text:"—"}}}
                            }
                            mod.widgets.HagencyChevron{}
                        }
                        resource_detail := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.open_resource(row.id)}
                    }
                }}
                if H.resource_after!=nil {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        more := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.more()}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More","显示更多")}}
                    }
                }}
            }}
            if H.owner.poolsReady && H.resources.len()>0 && A.pool_list_unknown() {View{width:Fill height:Fit padding:Inset{top:4} mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                owner_pool_counts_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||{A.pool_meta_load() A.redraw()}}
                mod.widgets.HagencyListBody{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.t("Some information couldn’t be read","部分信息暂时无法读取")}
                    mod.widgets.HagencyAccentText{width:Fit text:A.t("Try Again","重试")}
                }
            }}}}
            if H.owner.poolsReady && H.resources.len()>0 {View{width:Fill height:Fit flow:Down spacing:6
                let accounts=A.pool_account_rows()
                if accounts.len()>0 {View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyList{for index a in accounts {View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:16 top:12 bottom:12} align:Align{y:0.5}
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.wallet draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        View{width:Fill height:Fit flow:Down spacing:6
                            View{width:Fill height:Fit flow:Right spacing:8 align:Align{y:0.5}
                                owner_account_limit := mod.widgets.HagencyListTitle{width:Fill text:A.pool_frame_name(a.runtime)+A.t(" account limit "," 账号上限 ")+A.tokens(a.quota)}
                            }
                            View{width:Fill height:6 flow:Overlay
                                RoundedView{width:Fill height:6 show_bg:true draw_bg +: {color:mod.widgets.RINX_BORDER border_radius:3.0}}
                                if a.used>0 {View{width:Fill height:6 flow:Right
                                    RoundedView{width:Fill{weight:min(1,a.used/a.quota)} height:6 show_bg:true draw_bg +: {color:mod.widgets.RINX_INFO_FG border_radius:3.0}}
                                    if a.used<a.quota {View{width:Fill{weight:1-a.used/a.quota} height:6}}
                                }}
                            }
                            mod.widgets.HagencyWrapSubtitle{text:A.t(A.tokens(a.used)+" a month is given to "+a.pools+(if a.pools==1 {" pool with a maximum"} else {" pools with a maximum"})+"; "+A.tokens(max(0,a.quota-a.used))+" can still be given.","设了每月上限的 "+a.pools+" 个资源池合计每月 "+A.tokens(a.used)+"，还可再分 "+A.tokens(max(0,a.quota-a.used))+"。")}
                        }
                    }
                }}}}}
                mod.widgets.HagencyListNote{text:A.t("Pools on one account share its limit. 1 M is one million tokens.","同一账号下的资源池共用账号上限；1 M 即 100 万 token。")}
            }}
            if !(!H.owner.poolsReady && H.busy) {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:8}
                mod.widgets.HagencyListLabel{text:A.t("DEVICE","设备")}
                mod.widgets.HagencyList{mod.widgets.HagencyFitRow{
                    mod.widgets.HagencyRowBody{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.device draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("This Computer","这台电脑")}
                            mod.widgets.HagencyWrapSubtitle{text:A.t("Setup, moving to a new computer, interrupted tasks","设置、迁移到新电脑、接回中断的任务")}
                            if device.key!="loading" && mod.widgets.RINX_TEXT_SCALE>1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(device.tone) mod.widgets.HagencyPillText{text:device.text draw_text.color:A.local_tone_fg(device.tone)}}}
                        }
                        if device.key=="loading" {mod.widgets.HagencySpinner{}}
                        if device.key!="loading" && mod.widgets.RINX_TEXT_SCALE<=1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(device.tone)
                            mod.widgets.HagencyPillText{text:device.text draw_text.color:A.local_tone_fg(device.tone)}
                        }}
                        mod.widgets.HagencyChevron{}
                    }
                    pool_device_open := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.pool_device_open("list")}
                }}
            }}
        }}}
        if H.page == "pool_create" && H.pool_create!=nil {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let c=H.pool_create
            let d=H.enrollment_draft
            let ready=A.pool_create_ready()
            let quota=A.pool_create_quota()
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:4} text:A.t("A pool shares one coding tool and model with Agents, up to a monthly maximum.","资源池把一个编码工具和模型分享给 Agent，每月不超过你设定的上限。")}
            if H.notice!="" && !H.busy {View{width:Fill height:Fit padding:Inset{bottom:4} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_WARNING_BG
                mod.widgets.HagencyCopy{text:A.notice_text() draw_text.color:mod.widgets.RINX_WARNING_FG}
            }}}
            mod.widgets.HagencyListLabel{text:A.t("CODING TOOL","编码工具")}
            mod.widgets.HagencyList{
                if c.accounts==nil && c.error=="" {mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencySpinner{} mod.widgets.HagencyListValue{text:A.t("Reading your coding tools…","正在读取编码工具…")}}}}
                if c.error!="" {View{width:Fill height:Fit flow:Down
                    View{width:Fill height:Fit padding:Inset{left:14 right:14 top:12 bottom:12} mod.widgets.HagencyListSubtitle{text:c.error draw_text.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                    mod.widgets.HagencyListRow{
                        pool_create_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.pool_create_accounts()}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                    }
                }}
                if c.accounts!=nil && c.accounts.len()==0 {View{width:Fill height:Fit flow:Down
                    View{width:Fill height:Fit padding:Inset{left:14 right:14 top:12 bottom:12} mod.widgets.HagencyListSubtitle{text:A.t("No coding tool is connected yet. Connect Codex first; you’ll sign in on the provider’s page.","还没有接入编码工具。请先接入 Codex，会在服务商页面登录。")}}
                    mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                    mod.widgets.HagencyListRow{
                        pool_create_tools := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||{H.pool_create=nil A.open_accounts(nil)}}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Open Coding Tools","前往编码工具")} mod.widgets.HagencyChevron{}}
                    }
                }}
                if c.accounts!=nil {for index item in c.accounts {let account=item View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyListTall{
                        pool_create_account := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click:||A.pool_create_account(account)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.connection}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.pool_account_name(account,c.accounts.len()>1)}
                                mod.widgets.HagencyListSubtitle{text:A.pool_login_text(account)}
                            }
                            if c.account!=nil && c.account.id==account.id {mod.widgets.HagencyCheck{}}
                        }
                    }
                }}}
            }
            if c.account!=nil {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:A.t("MODEL","模型")}
                mod.widgets.HagencyList{
                    if c.loadingModels {mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencySpinner{} mod.widgets.HagencyListValue{text:A.t("Checking the models this tool can share…","正在检查此工具可共享的模型…")}}}}
                    if c.modelsError!="" {View{width:Fill height:Fit flow:Down
                        View{width:Fill height:Fit padding:Inset{left:14 right:14 top:12 bottom:12} mod.widgets.HagencyListSubtitle{text:c.modelsError draw_text.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                        mod.widgets.HagencyListRow{
                            pool_create_models_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.pool_create_account(c.account)}
                            mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                        }
                    }}
                    if c.models!=nil {for index item in c.models.provider.models {let model=item let usable=model.sharedReasoning.len()>0 View{width:Fill height:Fit flow:Down
                        if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:14}}}
                        mod.widgets.HagencyListTall{
                            pool_create_model := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil && usable on_click:||A.pool_create_model(model)}
                            mod.widgets.HagencyListBody{
                                mod.widgets.HagencyListText{
                                    mod.widgets.HagencyListTitle{text:model.label draw_text.color:if usable {mod.widgets.RINX_INK} else {mod.widgets.RINX_MUTED}}
                                    mod.widgets.HagencyListSubtitle{text:if usable {model.model} else {A.t("Can’t be shared","不能共享")}}
                                }
                                if d!=nil && d.model.model==model.model {mod.widgets.HagencyCheck{}}
                            }
                        }
                    }}}
                }
                if c.models!=nil && !ready {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:4}
                    mod.widgets.HagencyList{
                        View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                            mod.widgets.HagencyListSubtitle{text:A.t("This computer must finish setup before it can share a pool.","这台电脑要先设置好，才能共享资源池。")}
                        }
                        mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                        mod.widgets.HagencyListRow{
                            pool_create_setup := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.pool_device_open("create")}
                            mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Open This Computer","打开「这台电脑」")} mod.widgets.HagencyChevron{}}
                        }
                    }
                }}
            }}
            if d!=nil && c.account!=nil && d.account.accountId==c.account.id {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:A.t("REASONING","推理强度")}
                mod.widgets.HagencyList{View{width:Fill height:Fit padding:12
                    mod.widgets.HagencySegments{for effort in d.model.sharedReasoning {let value=effort View{width:Fill height:Fit
                        if d.reasoning==value {pool_create_effort := mod.widgets.HagencyTallSegmentOn{text:A.reasoning_label(value) on_click:||{d.reasoning=value A.redraw()}}}
                        if d.reasoning!=value {pool_create_effort := mod.widgets.HagencyTallSegment{text:A.reasoning_label(value) on_click:||{d.reasoning=value A.redraw()}}}
                    }}}
                }}
                mod.widgets.HagencyListNote{text:A.t("Higher reasoning thinks longer and uses more of the pool.","推理强度越高，思考越久，也更耗额度。")}
                mod.widgets.HagencyListLabel{text:A.t("MONTHLY MAXIMUM","每月上限")}
                mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:16 right:16 top:12 bottom:12}
                    pool_create_tokens := mod.widgets.HagencyNumberInput{minimum:1 maximum:quota text:d.tokens empty_text:A.t("e.g. 1.5","例如 1.5") on_change:|text| A.pool_create_tokens(text)}
                    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                        for amount in [500000,1000000,2000000,5000000] {let value=amount View{width:Fit height:Fit
                            pool_create_preset := mod.widgets.HagencyPreset{text:A.tokens(value) enabled:!H.busy && H.command==nil && (quota<0 || value<=quota) on_click:||A.pool_create_preset(value)}
                        }}
                    }
                }}
                mod.widgets.HagencyListNote{text:(if quota>0 {A.t("Pools on this account share its limit of "+A.tokens(quota)+". ","此账号的资源池共用账号上限 "+A.tokens(quota)+"；")} else {""})+A.t("Next, connect it to a server and publish it from its page.","创建后在资源池页面连接服务器并发布。")}
            }}
        }}}
        if H.page=="web_connections"{mod.widgets.HagencyDetailCard{
            let c=H.webConnection
            mod.widgets.HagencyTitle{text:A.t("External Matrix configuration","外部 Matrix 配置")}
            mod.widgets.HagencyHint{text:A.t("Discover a server, import its approved configuration, or maintain a registration. Your signed-in server’s resource admission is managed from Connections.","发现服务器、导入获批配置或维护注册信息。当前登录服务器的资源准入在「连接」页面管理。")}
            mod.widgets.HagencyActions{
                web_connections_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Connections","连接") on_click:||A.navigate("connections")}
                web_connection_new := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Add server","添加服务器") draw_icon.svg:mod.rinx_icons.add icon_walk:Walk{width:16 height:16} on_click:||A.web_connection_new()}
            }
            if c.list!=nil{View{width:Fill height:Fit flow:Down spacing:16
                if c.list.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No external server configurations yet.","暂无外部服务器配置。")}}
                for row in c.list.items{mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.label}
                    mod.widgets.HagencyCopy{text:row.id}
                    mod.widgets.HagencyHint{text:row.apiBaseUrl}
                    web_connection_details := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Connection details","连接详情") on_click:||A.web_connection_open(row.id)}
                }}
                mod.widgets.HagencyActions{
                    if c.after!=nil{View{width:Fit height:Fit web_connections_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.web_connections_open(nil)}}}
                    if c.list.nextAfter!=nil{View{width:Fit height:Fit web_connections_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.web_connections_open(c.list.nextAfter)}}}
                }
            }}
        }}
        if H.page=="web_connection_new" && H.webConnection.draft!=nil{mod.widgets.HagencyDetailCard{
            let c=H.webConnection let d=c.draft
            mod.widgets.HagencyTitle{text:A.t("Connect an external Matrix server","连接外部 Matrix 服务器")}
            mod.widgets.HagencyHint{text:A.t("1  Identify server    2  Check connection    3  Review configuration","1  指定服务器    2  检查连接    3  核对配置")}
            mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Server name","服务器名称")}
            web_server_name := mod.widgets.HagencyInput{empty_text:A.t("matrix.example.org","matrix.example.org") text:d.id on_change:|s|{if H.command==nil{d.id=s c.probe=nil}}}
            mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Display name","显示名称")}
            web_server_label := mod.widgets.HagencyInput{empty_text:A.t("Team server","团队服务器") text:d.label on_change:|s|{if H.command==nil{d.label=s}}}
            mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Homeserver URL","Homeserver 地址")}
            web_server_origin := mod.widgets.HagencyInput{empty_text:A.t("https://matrix.example.org","https://matrix.example.org") text:d.origin on_change:|s|{if H.command==nil{d.origin=s c.probe=nil}}}
            web_server_probe := mod.widgets.HagencyButton{width:Fit enabled:!H.busy && H.command==nil text:A.t("Check server","检查服务器") on_click:||A.web_connection_probe()}
            if c.probe!=nil{mod.widgets.HagencySection{
                mod.widgets.HagencyCopy{text:if c.probe.reachable{A.t("Matrix server is reachable","Matrix 服务器可连接")}else{A.t("Server check failed","服务器检查失败")}}
                mod.widgets.HagencyHint{text:c.probe.origin}
                if !c.probe.reachable{mod.widgets.HagencyHint{text:A.t("Check the address and network connection before continuing.","请检查地址与网络连接后继续。")}}
            }}
            mod.widgets.HagencyActions{
                web_server_create := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Review new connection","核对新连接") on_click:||A.web_connection_create(false)}
                web_server_import := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Import approved configuration","导入获批配置") on_click:||A.web_connection_create(true)}
                web_server_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back","返回") on_click:||A.web_connections_open(nil)}
            }
        }}
        if H.page=="web_connection" && H.webConnection.detail!=nil{mod.widgets.HagencyDetailCard{
            let c=H.webConnection let d=c.detail
            mod.widgets.HagencyActions{web_connection_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("External servers","外部服务器") on_click:||A.web_connections_open(nil)}}
            mod.widgets.HagencyTitle{text:d.label}
            mod.widgets.HagencyCopy{text:d.id}
            mod.widgets.HagencyHint{text:d.apiBaseUrl}
            mod.widgets.HagencyStatus{
                mod.widgets.HagencyCopy{text:if d.awaitingInstall{A.t("Registration awaits server installation","注册信息等待在服务器安装")}else if d.accessState=="accepted"{A.t("Connection verified","连接已验证")}else if d.hasCredential{A.t("Credentials stored; verification required","凭据已保存，等待验证")}else{A.t("No active credential","暂无有效凭据")}}
            }
            mod.widgets.HagencyHint{text:A.t("Local configuration and server admission are separate. This page does not start an agent or reserve server capacity.","本地配置与服务器准入分别管理，此页面不会启动 Agent 或预留服务器容量。")}
            mod.widgets.HagencyFormGroup{
                mod.widgets.HagencySectionTitle{text:A.t("Legacy connection allowance","旧版连接额度")}
                mod.widgets.HagencyHint{text:A.t("Kept for legacy fleet configuration. Resource-pool projects use their approved allocations; this value does not limit them.","用于保留旧版资源集群配置。资源池项目使用已审批的分配额度，不受此值限制。")}
                mod.widgets.HagencyCopy{text:A.tokens(d.allocatedTokens)+" token"}
                mod.widgets.HagencyFieldLabel{width:Fill text:A.t("New declared allowance; blank clears it","新的声明额度，留空可清除")}
                web_connection_allowance := mod.widgets.HagencyNumberInput{minimum:0 empty_text:A.t("No declared allowance","未填写额度") text:c.tokens on_change:|s|{if H.command==nil{c.tokens=s}}}
                mod.widgets.HagencyHint{text:A.t("1 M = 1 million tokens. Drag the slider or enter an exact amount, with up to six decimal places.","1 M = 100 万 tokens。拖动滑块或输入准确额度，最多六位小数，精确到 1 token。")}
                web_connection_allowance_review := mod.widgets.HagencyButton{width:Fit enabled:!H.busy && H.command==nil text:A.t("Review allowance","核对额度") on_click:||A.web_connection_edit("allowance")}
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Private credentials","私密凭据")}
                mod.widgets.HagencyHint{text:A.t("Select a JSON file in the native dialog. Its credentials stay outside this mini app.","请在原生对话框选择 JSON 文件，凭据不会进入此小程序。")}
                mod.widgets.HagencyHint{text:A.t("Imported credentials can verify the representative account. Project management uses your signed-in Matrix account; legacy fleet transport is not started here.","导入的凭据可验证代表账号。项目管理使用当前登录的 Matrix 账号，此处不会启动旧版资源集群传输。")}
                mod.widgets.HagencyActions{
                    web_connection_import := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Import approved configuration","导入获批配置") on_click:||A.web_connection_edit("import")}
                    web_connection_replace := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Replace credentials","替换凭据") on_click:||A.web_connection_edit("replace")}
                    web_connection_verify := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil && (d.hasCredential || d.awaitingInstall) text:A.t("Verify connection","验证连接") on_click:||A.web_connection_edit("verify")}
                    web_connection_withdraw := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil && (d.hasCredential || d.awaitingInstall) text:A.t("Withdraw credentials","撤回凭据") on_click:||A.web_connection_edit("withdraw")}
                }
            }
            mod.widgets.HagencyFormGroup{
                mod.widgets.HagencySectionTitle{text:A.t("Appservice registration","应用服务注册")}
                mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Appservice callback URL","应用服务回调地址")}
                web_registration_url := mod.widgets.HagencyInput{empty_text:A.t("https://agent.example.org","https://agent.example.org") text:c.registrationUrl on_change:|s|{if H.command==nil{c.registrationUrl=s}}}
                mod.widgets.HagencyActions{
                    web_registration_issue := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:if d.registrationAvailable{A.t("Review reissue","核对重新签发")}else{A.t("Review registration","核对注册信息")} on_click:||A.web_connection_edit("issue")}
                    if d.registrationAvailable{View{width:Fit height:Fit web_registration_download := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Save private registration","保存私密注册文件") on_click:||A.web_connection_download()}}}
                }
                mod.widgets.HagencyHint{text:A.t("Install the downloaded registration on the Matrix server, then verify the connection. Reissue retains the current credential until the replacement passes verification.","将下载的注册文件安装到 Matrix 服务器，再验证连接。重新签发后，替代凭据通过验证前会保留当前凭据。")}
            }
        }}

        if H.page=="operator_graphs" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                flow_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Overview","概览") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||{H.page="overview" A.redraw()}}
                flow_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_flows(H.flow_after)}
                flow_create := mod.widgets.RinxKeyPrimaryButton{enabled:A.flow_can_edit() text:A.t("New graph","新建任务图") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click:||A.flow_new()}
            }
            mod.widgets.HagencyTitle{text:A.t("Task graphs","任务图")}
            mod.widgets.HagencyHint{text:A.flow_notice()}
            mod.widgets.HagencyActions{for status in ["","active","complete","failed","cancelled"]{View{width:Fit height:Fit flow_filter := mod.widgets.HagencyButton{enabled:!H.busy text:if status==""{A.t("All","全部")}else{A.flow_status(status)} on_click:||{H.flow_filter=status A.open_flows(nil)}}}}}
            if H.flow_list==nil {mod.widgets.HagencyCopy{text:if H.busy{A.t("Reading graphs…","正在读取任务图…")}else{A.t("Graphs unavailable. Refresh to try again.","任务图暂不可用，请刷新重试。")}}}
            if H.flow_list!=nil {mod.widgets.HagencySection{
                let page=H.flow_list
                if page.graphs.len()==0{mod.widgets.HagencyCopy{text:A.t("No matching graphs on this page","本页没有匹配的任务图")}}
                for graph in page.graphs{mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:graph.label}
                    mod.widgets.HagencyCopy{text:A.flow_status(graph.status)+" · "+graph.completeCount+" / "+graph.nodeCount}
                    mod.widgets.HagencyHint{text:A.flow_delivery(graph.deliveryState)}
                    mod.widgets.HagencyActions{flow_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View nodes","查看节点") on_click:||A.open_flow(graph.id,nil)}}
                }}
                mod.widgets.HagencyActions{

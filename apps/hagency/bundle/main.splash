                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(H.ux.errorCode)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    tools_refresh := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_tools(H.tool_resource,H.tool_engagement,H.tool_after,"rules")}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if tp!=nil {View{width:Fill height:Fit flow:Down spacing:6
                if tp.grants.len()==0 {mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:6 align:Align{x:0.5} padding:Inset{left:16 right:16 top:22 bottom:22}
                    mod.widgets.HagencyAvatarSmall{mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.lock}}
                    mod.widgets.HagencyListTitle{width:Fit text:A.t("No saved tool permissions","还没有保存的工具权限")}
                    mod.widgets.HagencyListSubtitle{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:A.t("When you choose “Always allow” in chat, the permission is saved here.","在聊天里选「始终允许」的权限会保存在这里。")}
                }}}
                if tp.grants.len()>0 {mod.widgets.HagencyList{for index row in tp.grants {View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                        mod.widgets.HagencyRowIcon{draw_bg.color:if row.revoked {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_INFO_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:A.tool_kind_icon(row.kind) draw_icon.color:if row.revoked {mod.widgets.RINX_MUTED} else {mod.widgets.RINX_INFO_FG}}}
                        View{width:Fill height:Fit flow:Down spacing:3
                            mod.widgets.HagencyListTitle{text:A.tool_kind(row.kind)+" · "+A.tool_grant_mode(row.mode)}

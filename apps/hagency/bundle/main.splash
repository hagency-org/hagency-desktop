                    let effort=choice.reasoning
                    if d.reasoning==effort {resource_create_reasoning := mod.widgets.HagencyTallSegmentOn{text:A.reasoning_label(effort) enabled:!H.busy && H.command==nil on_click:||{d.reasoning=effort A.redraw()}}}
                    if d.reasoning!=effort {resource_create_reasoning := mod.widgets.HagencyTallSegment{text:A.reasoning_label(effort) enabled:!H.busy && H.command==nil on_click:||{d.reasoning=effort A.redraw()}}}
                }}}}
            }}
            mod.widgets.HagencyListLabel{text:A.t("NEW AGENT PERMISSIONS","新 Agent 默认权限")}
            mod.widgets.HagencyList{View{width:Fill height:Fit padding:12
                mod.widgets.HagencySegments{
                    View{width:Fill height:Fit
                        if !yolo {resource_create_standard := mod.widgets.HagencyTallSegmentOn{text:A.t("Standard","标准权限") enabled:!H.busy && H.command==nil on_click:||A.choose_resource_default("create",false)}}
                        if yolo {resource_create_standard := mod.widgets.HagencyTallSegment{text:A.t("Standard","标准权限") enabled:!H.busy && H.command==nil on_click:||A.choose_resource_default("create",false)}}
                    }
                    if detail.resource.framework=="codex" {View{width:Fill height:Fit
                        if yolo {resource_create_unrestricted := mod.widgets.HagencyTallSegmentOn{text:A.pool_yolo_segment() enabled:!H.busy && H.command==nil draw_text +: {color:mod.widgets.RINX_WARNING_FG color_hover:mod.widgets.RINX_WARNING_FG color_focus:mod.widgets.RINX_WARNING_FG} on_click:||A.choose_resource_default("create",true)}}
                        if !yolo {resource_create_unrestricted := mod.widgets.HagencyTallSegment{text:A.pool_yolo_segment() enabled:!H.busy && H.command==nil on_click:||A.choose_resource_default("create",true)}}
                    }}
                }
            }}
            mod.widgets.HagencyListNote{text:if yolo {A.t("Full trust: new Codex Agents run without the workspace sandbox and never ask before using tools.","完全信任：新的 Codex Agent 不使用工作区沙箱，使用工具前也不会询问。")} else {A.t("Agents created in the new pool start with standard permissions.","新资源池里创建的 Agent 默认使用标准权限。")} draw_text.color:if yolo {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_MUTED}}
            mod.widgets.HagencyListLabel{text:A.t("MONTHLY MAXIMUM","每月上限")}
            mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:10 padding:Inset{left:12 right:12 top:12 bottom:12}
                mod.widgets.HagencySegments{
                    View{width:Fill height:Fit
                        if d.limitMode=="monthly" {resource_create_monthly := mod.widgets.HagencyTallSegmentOn{text:A.t("Set a maximum","设定上限") enabled:!H.busy && H.command==nil on_click:||{d.limitMode="monthly" A.redraw()}}}
                        if d.limitMode!="monthly" {resource_create_monthly := mod.widgets.HagencyTallSegment{text:A.t("Set a maximum","设定上限") enabled:!H.busy && H.command==nil on_click:||{d.limitMode="monthly" A.redraw()}}}
                    }
                    View{width:Fill height:Fit
                        if d.limitMode=="clear" {resource_create_clear := mod.widgets.HagencyTallSegmentOn{text:A.t("Set later","以后再设") enabled:!H.busy && H.command==nil on_click:||{d.limitMode="clear" A.redraw()}}}
                        if d.limitMode!="clear" {resource_create_clear := mod.widgets.HagencyTallSegment{text:A.t("Set later","以后再设") enabled:!H.busy && H.command==nil on_click:||{d.limitMode="clear" A.redraw()}}}
                    }
                }
                if d.limitMode=="monthly" {View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:4 right:4}
                    resource_create_tokens := mod.widgets.HagencyNumberInput{minimum:0 maximum:ctop text:d.tokens on_change:|text| {if H.command==nil {d.tokens=text}}}
                    if mod.widgets.RINX_TEXT_SCALE<=1.2 {View{width:Fill height:Fit flow:Right spacing:8
                        mod.widgets.HagencyListValue{text:A.t("From 0","从 0 起")}
                        View{width:Fill height:1}
                        mod.widgets.HagencyListValue{text:if ctop>0 {A.t("Account limit ","账号上限 ")+A.tokens(ctop)} else {A.t("Account limit unknown","账号上限未知")}}
                    }}
                    if mod.widgets.RINX_TEXT_SCALE>1.2 {View{width:Fill height:Fit flow:Down spacing:2
                        mod.widgets.HagencyListValue{text:A.t("From 0","从 0 起")}
                        mod.widgets.HagencyListValue{text:if ctop>0 {A.t("Account limit ","账号上限 ")+A.tokens(ctop)} else {A.t("Account limit unknown","账号上限未知")}}
                    }}
                    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                        for amount in [500000,1000000,2000000,5000000] {let value=amount View{width:Fit height:Fit
                            resource_create_preset := mod.widgets.HagencyPreset{text:A.tokens(value) enabled:!H.busy && H.command==nil && (ctop<0 || value<=ctop) on_click:||{d.tokens=""+value A.redraw()}}
                        }}
                    }
                }}
                if d.limitMode=="clear" {mod.widgets.HagencyListSubtitle{text:A.t("Until a maximum is set, Agents can’t request this pool. You can set it later on the pool’s page.","设好每月上限之前，Agent 不能申请这个资源池。以后可以在资源池页面设置。")}}
            }}
            mod.widgets.HagencyListNote{text:A.t("1 M is one million tokens. Both pools share the account’s limit. Next, connect the new pool to a server and publish it from its page.","1 M 即 100 万 token。两个资源池共用账号上限。创建后，在新资源池页面连接服务器并发布。")}
        }}}
        if H.page=="personal_model"{View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:18 bottom:28}
            let p=H.personal_config
            View{width:Fill height:Fit flow:Down spacing:6
            if p.choices==nil {mod.widgets.HagencyList{mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:if H.busy{A.t("Loading models…","正在读取模型…")}else{A.t("Couldn’t load models. Go back and sync settings first.","暂时无法读取模型，请返回并先同步设置。")}}}}}}
            if p.choices!=nil && p.draft!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let d=p.draft
                mod.widgets.HagencyListLabel{text:A.t("ON THE EXECUTION DEVICE","执行设备上可用的模型")}
                mod.widgets.HagencyList{
                    if p.choices.models.len()==0{mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("No models reported","设备未上报可用模型")}}}}
                    for index row in p.choices.models{if index>=p.offset && index<p.offset+16{View{width:Fill height:Fit flow:Down
                        if index>p.offset {mod.widgets.HagencyListDivider{margin:Inset{left:14}}}
                        mod.widgets.HagencyListTall{
                            personal_model_choice := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || A.personal_model_pick(row.runtime,row.model)}
                            mod.widgets.HagencyListBody{
                                mod.widgets.HagencyListText{
                                    mod.widgets.HagencyListTitle{text:row.displayName}
                                    mod.widgets.HagencyListSubtitle{text:row.model}
                                }
                                if d.runtime==row.runtime && d.model==row.model {mod.widgets.HagencyCheck{}}
                            }
                        }
                    }}}
                    if p.offset+16<p.choices.models.len() {View{width:Fill height:Fit flow:Down
                        mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                        mod.widgets.HagencyListRow{
                            personal_models_next := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || {p.offset=p.offset+16 A.redraw()}}
                            mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More Models","显示更多模型")}}
                        }
                    }}
                    if p.offset>0 {View{width:Fill height:Fit flow:Down
                        mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                        mod.widgets.HagencyListRow{
                            personal_models_previous := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || {p.offset=p.offset-16 A.redraw()}}
                            mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show Previous Models","显示前面的模型")}}
                        }
                    }}
                }
                if A.personal_model_choice()!=nil{View{width:Fill height:Fit flow:Down spacing:6
                    let row=A.personal_model_choice()
                    mod.widgets.HagencyListLabel{text:A.t("REASONING","推理强度")}
                    mod.widgets.HagencyList{View{width:Fill height:Fit padding:14
                        mod.widgets.HagencySegments{for effort in row.reasoningEfforts{if d.reasoningEffort==effort {mod.widgets.HagencySegmentOn{text:A.reasoning_label(effort) enabled:!H.busy && H.command==nil on_click: || A.personal_model_effort(effort)}} else {mod.widgets.HagencySegment{text:A.reasoning_label(effort) enabled:!H.busy && H.command==nil on_click: || A.personal_model_effort(effort)}}}}
                    }}
                    mod.widgets.HagencyListNote{text:if H.local_effort_note!="" {H.local_effort_note} else if d.reasoningEffort=="" {A.t("Choose a reasoning level for this model.","请为此模型选择推理强度。")} else {A.t("Higher reasoning answers more carefully but uses more tokens.","推理强度越高，回答越仔细，但消耗更多 token。")}}
                    mod.widgets.HagencyListLabel{text:A.t("TOOLS","工具")}
                    mod.widgets.HagencyList{
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyListTitle{text:A.t("Web search","网页搜索")}
                            personal_model_search := mod.widgets.HagencySwitch{draw_bg.selected:if d.webSearch{1.0}else{0.0} enabled:!H.busy && H.command==nil on_click: || {d.webSearch=!d.webSearch A.redraw()}}
                        }
                    }
                }}
                mod.widgets.HagencyListLabel{text:A.t("WORKSPACE","工作区")}
                mod.widgets.HagencyList{
                    if p.choices.workspaceConfigured{View{width:Fill height:Fit flow:Down
                        mod.widgets.HagencyListRow{
                            personal_workspace_preserve := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || {d.workspace="preserve" A.redraw()}}
                            mod.widgets.HagencyListBody{mod.widgets.HagencyListTitle{text:A.t("Keep custom folder","保留自定义目录")} if d.workspace=="preserve" {mod.widgets.HagencyCheck{}}}
                        }
                        mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                    }}
                    mod.widgets.HagencyListRow{
                        personal_workspace_default := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || {d.workspace="default" A.redraw()}}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyListTitle{text:A.t("Default folder","默认目录")} if d.workspace=="default" {mod.widgets.HagencyCheck{}}}
                    }
                }
                mod.widgets.HagencyListNote{text:if p.choices.canChooseWorkspace{A.t("You can pick another folder when you confirm on this device. Saving doesn’t start the Agent.","在本机确认时可以选择其他目录。保存不会启动 Agent。")}else{A.t("To pick another folder, open Hagency on the execution device. Saving doesn’t start the Agent.","如需选择其他目录，请在执行设备上打开 Hagency。保存不会启动 Agent。")}}
            }}
            }
        }}
        if H.page == "personal_agents" {View{width:Fill height:Fit flow:Down spacing:6
            View{width:Fill height:Fit flow:Right align:Align{y:0.5}
                personal_home := mod.widgets.HagencyBackLink{text:A.t("Home","首页") enabled:!H.busy on_click: || A.navigate("overview")}
                View{width:Fill height:1}
                personal_refresh := mod.widgets.HagencyIconButton{enabled:!H.busy draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_personal_agents(H.personal_after,H.personal_page)}
            }
            mod.widgets.HagencyTitle{text:A.t("Local agents","本地 Agent")}
            mod.widgets.HagencyList{
                if H.personal_list == nil {mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:if H.busy {A.t("Loading…","正在读取…")} else {A.t("Couldn’t load local agents","暂时无法读取本地 Agent")}}}}}
                if H.personal_list != nil && H.personal_list.items.len() == 0 {mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("No local agents yet","还没有本地 Agent")}}}}
                if H.personal_list != nil {for index row in H.personal_list.items {View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:66}}}
                    mod.widgets.HagencyListTall{

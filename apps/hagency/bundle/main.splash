                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Edit Template","编辑模板") draw_text.color:if editable {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}}
                    }
                }
                mod.widgets.HagencyListNote{text:if row.status=="reserved" || row.status=="provisioned" {A.t("It’s in use, so its name and role stay the same. Once turned off, new Agents can’t pick it; Agents already using it aren’t affected.","模板正在使用，名称和角色不能修改。停用后，新 Agent 不能再选它；已在用的 Agent 不受影响。")} else {A.t("Saving a template doesn’t create or change a running Agent.","保存模板不会创建或修改正在运行的 Agent。")}}
                if d.canDelete {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:12}
                    mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                        template_delete := mod.widgets.HagencyListTap{enabled:A.template_can_edit() on_click: || A.template_delete()}
                        View{width:Fill height:Fill align:Align{x:0.5 y:0.5} mod.widgets.HagencyDangerText{text:A.t("Remove Template…","移除模板…")}}

                            if row.revoked {mod.widgets.HagencyListSubtitle{text:A.t("Taken back","已撤销")}}
                            if !row.revoked && !row.bindingCurrent {mod.widgets.HagencyListSubtitle{text:A.t("Its approval room isn’t available right now","它的审批聊天暂时不可用") draw_text.color:mod.widgets.RINX_WARNING_FG}}
                        }
                        if !row.revoked {tool_grant_review := mod.widgets.HagencyGetDanger{text:A.t("Take Back","撤销") enabled:!H.busy && H.command==nil && H.page=="tool_grants" on_click: || A.review_tool_grant(row)}}
                    }
                }}}}

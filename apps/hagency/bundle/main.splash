                                    mod.widgets.HagencyListTitle{width:Fill text:A.t("Monthly maximum","每月上限")}
                                    mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock draw_icon.color:mod.widgets.RINX_MUTED}
                                    pool_max_value := mod.widgets.HagencyListTitle{width:Fit draw_text +: {text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE}} text:if b.ceiling==nil {A.t("Not set","未设置")} else {A.tokens(b.ceiling)}}
                                }
                                pool_max_reason := mod.widgets.HagencyWrapSubtitle{text:v.maxReason}

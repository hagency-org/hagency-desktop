                    if f.target!=nil && f.observation==nil && !H.busy{mod.widgets.HagencyActions{recipient_observe_retry := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Check selected identity again","重新检查所选身份") on_click:||A.recipient_observe(f.target)}}}

                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock}}
                        mod.widgets.HagencyListTitle{text:A.t("Saved Tool Permissions","已保存的工具权限")}
                        mod.widgets.HagencyChevron{}
                    }
                }
            }
            mod.widgets.HagencyListNote{text:if active {A.t("Tool approvals for "+d.agent+" are sent to this private room.",A.sub_join(d.agent,"的工具审批会发到这个聊天（只有你和它）。"))} else {A.t("This room isn’t confirmed right now, so "+d.agent+"’s tool requests may not reach you. Remove it below; the Agent sets up a new room the next time it asks.","这个审批聊天目前没有确认可用，"+A.sub_join(d.agent,"的工具审批可能发不到你这里。可以在下面移除它；Agent 下次请求时会建立新的审批聊天。"))}}
            View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyList{
                mod.widgets.HagencyListRow{
                    binding_details := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle(key)}
                    mod.widgets.HagencyListBody{

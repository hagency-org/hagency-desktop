                        mod.widgets.HagencyListTitle{text:A.t("New Agents can use it","新 Agent 可以使用")}
                        mod.widgets.HagencyListValue{text:if row.enabled {A.t("Allowed","允许")} else {A.t("Off","已停用")}}
                    }

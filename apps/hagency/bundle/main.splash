                                pool_renew_lock := mod.widgets.HagencyWrapSubtitle{text:A.t("Once published ahead, this month’s per-request limit can’t change, and it can’t be withdrawn here.","提前发布后：本月的每次申请上限不能再改；这里不能撤回。") draw_text.color:mod.widgets.RINX_WARNING_FG}
                            }}

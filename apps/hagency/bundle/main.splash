notice := mod.widgets.HagencyHint{visible: H.notice != "" && !H.busy text: A.notice_text()}
content := mod.widgets.RinxPageScroll{body +: {
    padding:Inset{right:14}
    scroll_bars:mod.widgets.ScrollBars{show_scroll_x:false show_scroll_y:true
        scroll_bar_y:mod.widgets.ScrollBar{drag_scrolling:true
            draw_bg +: {color:mod.widgets.RINX_BORDER color_hover:mod.widgets.RINX_MUTED color_drag:mod.widgets.RINX_ACCENT}
        }
    }
    page +: {width:Fill{max:960} spacing:16 on_render:A.render_page}
}}

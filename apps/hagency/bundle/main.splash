                                    mod.widgets.HagencyWrapSubtitle{width:Fill text:A.t("To stop Agents requesting this pool for now:","想暂时不让 Agent 申请这个资源池：")}
                                    pool_max_pause := mod.widgets.HagencyBarText{text:A.t("Pause Sharing","暂停共享") enabled:!H.busy && H.command==nil && !locked on_click:||A.pool_pause_sharing()}
                                }}
                            }}
                            if v.maxMode=="locked" {View{width:Fill height:Fit flow:Down spacing:6

                        View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Request · select to copy","请求编号 · 可选中复制")} mod.widgets.HagencyCopyText{text:row.id}}
                        if subject!=nil {View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Project","项目编号")} mod.widgets.HagencyCopyText{text:subject.projectId}}}

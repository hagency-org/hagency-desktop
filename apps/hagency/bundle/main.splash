                let chat=A.shared_mode(row)=="chat"
                let codex=row.framework=="codex"
                let project=A.tool_project_name(row)
                let can=!H.busy && H.command==nil && H.policy_mode!="review" && H.policy_mode!="result"
                let key="policy:"+row.engagementId
                View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                    mod.widgets.HagencyAvatar{draw_bg.color:if full {mod.widgets.RINX_WARNING_BG} else {mod.widgets.RINX_INFO_BG} mod.widgets.HagencyAvatarGlyph{draw_icon.color:if full {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_INFO_FG}}}
                    mod.widgets.HagencyHeroName{text:row.agent}
                    mod.widgets.HagencyPill{draw_bg.color:if full {mod.widgets.RINX_WARNING_BG} else {mod.widgets.RINX_SUCCESS_BG}
                        mod.widgets.HagencyPillDot{draw_bg.color:if full {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_SUCCESS_FG}}
                        mod.widgets.HagencyPillText{text:if chat {A.t("Chat only","仅聊天")} else if full {A.t("Full trust (unrestricted)","完全信任（不受限）")} else {A.t("Standard permissions","标准权限")} draw_text.color:if full {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_SUCCESS_FG}}
                    }
                    if project!="" {mod.widgets.HagencyHint{width:Fit text:A.t("In project chat ","所在项目（聊天）：")+project}}
                }
                if H.policy_mode=="result" {View{width:Fill height:Fit padding:Inset{bottom:6} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_SUCCESS_BG
                    mod.widgets.HagencyCopy{text:A.t("Saved. It applies when "+row.agent+" starts its next task.","已保存，"+A.sub_join(row.agent,"的下一个任务开始时生效。")) draw_text.color:mod.widgets.RINX_SUCCESS_FG}
                    policy_result_done := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || A.open_policy(H.policy_resource,H.policy_engagement)}
                }}}
                mod.widgets.HagencyListLabel{text:A.t("WHAT IT MAY DO","执行权限")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.shield draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.t("Standard permissions","标准权限")}
                                mod.widgets.HagencyWrapSubtitle{text:if codex {A.t("Works inside its workspace; asks before doing more","在工作区内工作，超出范围前会先请求批准")} else {A.t("Keeps this runtime’s normal approval rules","沿用此运行环境的常规审批规则")}}
                            }

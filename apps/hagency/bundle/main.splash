mod.widgets.HagencyCapsule = mod.widgets.RinxKeyPrimaryButton{width:Fit height:44 margin:0 padding:Inset{left:22 right:22} spacing:6 align:Align{x:0.5 y:0.5} icon_walk:Walk{width:18 height:18}

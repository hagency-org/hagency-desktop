                            mod.widgets.HagencyListTitle{text:A.t("Time left","剩余时间")}
                            mod.widgets.HagencyListValue{text:A.tool_left(row,observed)}
                        }
                    }}
                }
                mod.widgets.HagencyListNote{text:A.t("The approval room shows the exact tool and its details. Approve or deny there; opening it doesn’t approve anything.","审批聊天里能看到具体的工具和参数，请在那里批准或拒绝。打开聊天不会自动批准。")}
                mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    tools_agent_rules := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_tools(H.tool_resource,row.engagementId,"","rules")}
                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock}}
                        mod.widgets.HagencyListTitle{text:A.t("Saved Tool Permissions","已保存的工具权限")}
                        mod.widgets.HagencyChevron{}
                    }

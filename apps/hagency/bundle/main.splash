                        policy_standard := mod.widgets.HagencyListFitTap{enabled:can && (full || chat) on_click: || A.choose_policy(false)}
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.t("Full trust (unrestricted)","完全信任（不受限）") draw_text.color:if codex {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_MUTED}}
                                mod.widgets.HagencyWrapSubtitle{text:if codex {A.t("Can use files outside its workspace and the network without asking","可使用工作区以外的文件和网络，且不再请求批准")} else {A.t("Only available for Codex Agents","仅 Codex Agent 可以使用")}}
                            }
                            if full {mod.widgets.HagencyCheck{draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                        }
                        policy_unrestricted := mod.widgets.HagencyListFitTap{enabled:can && codex && !full on_click: || A.choose_policy(true)}
                    }
                }
                mod.widgets.HagencyListNote{text:A.t("Changes apply when its next task starts; a task that is already running isn’t affected.","修改在下一个任务开始时生效，正在运行的任务不受影响。")}
                mod.widgets.HagencyListLabel{text:A.t("TOOLS","工具")}
                mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    policy_grants := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil && (H.policy_mode=="detail" || H.policy_mode=="result") on_click: || A.open_policy_grants()}
                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock}}
                        mod.widgets.HagencyListTitle{text:if A.shared_mode(row)!=nil {A.t("Pending Permission Requests","待处理的权限请求")} else {A.t("Saved Tool Permissions","已保存的工具权限")}}
                        mod.widgets.HagencyChevron{}
                    }
                }}
                mod.widgets.HagencyListNote{text:A.t("Permissions you saved for this Agent when you chose “Always allow” in chat. You can take any of them back.","你在聊天里选「始终允许」时保存的权限，都在这里，可以随时撤销。")}
                View{width:Fill height:Fit padding:Inset{top:12} mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        policy_details := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle(key)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyListSubtitle{text:A.t("IDs for your administrator","给管理员看的编号")}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.details_open==key {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if H.details_open==key {View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:2 bottom:12}
                        mod.widgets.HagencyWrapSubtitle{text:A.t("Runtime ","运行环境 ")+row.framework}
                        View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Project · select to copy","项目编号 · 可选中复制")} mod.widgets.HagencyCopyText{text:row.projectId}}
                        View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Agent link","Agent 关联")} mod.widgets.HagencyCopyText{text:row.engagementId}}
                    }}
                }}
            }}
        }}}
        if H.page=="tool_grants" || H.page=="tool_grant_review" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let tp=H.tool_page
            let agent=if H.tool_draft!=nil {H.tool_draft.agent} else if tp!=nil && tp.grants.len()>0 {tp.grants[0].agent} else if H.policy_detail!=nil && H.policy_detail.engagementId==H.tool_engagement {H.policy_detail.agent} else {""}
            mod.widgets.HagencyLargeTitle{text:A.t("Saved Tool Permissions","已保存的工具权限")}
            if agent!="" {mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.t("For ","Agent：")+agent}}
            if tp==nil && H.busy {mod.widgets.HagencyList{for j in [0,1] {View{width:Fill height:Fit flow:Down
                if j>0 {mod.widgets.HagencyListDivider{}}

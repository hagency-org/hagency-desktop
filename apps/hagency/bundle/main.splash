                if H.flow_editor_offset+16<d.nodes.len(){View{width:Fit height:Fit flow_edit_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More nodes","更多节点") on_click:||{H.flow_editor_offset=H.flow_editor_offset+16 A.redraw()}}}}

            let yolo=A.resource_draft_yolo(d,detail)
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:4} text:A.resource_title(detail.resource)+" · "+A.pool_frame(detail.resource)}
            if H.notice!="" && !H.busy {View{width:Fill height:Fit padding:Inset{bottom:4} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_WARNING_BG
                mod.widgets.HagencyCopy{text:A.notice_text() draw_text.color:mod.widgets.RINX_WARNING_FG}
            }}}
            mod.widgets.HagencyListLabel{text:A.t("MODEL","模型")}
            mod.widgets.HagencyList{
                for index item in A.resource_edit_models() {let model=item View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:14}}}
                    mod.widgets.HagencyListRow{
                        resource_config_model := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click:||A.choose_resource_model(model)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyListTitle{text:model}
                            if d.model==model {mod.widgets.HagencyCheck{}}
                        }
                    }
                }}
            }
            mod.widgets.HagencyListLabel{text:A.t("REASONING","推理强度")}
            mod.widgets.HagencyList{View{width:Fill height:Fit padding:12
                mod.widgets.HagencySegments{for choice in detail.choices {if choice.model==d.model {View{width:Fill height:Fit
                    let effort=choice.reasoning
                    if d.reasoning==effort {resource_config_reasoning := mod.widgets.HagencyTallSegmentOn{text:A.reasoning_label(effort) enabled:!H.busy && H.command==nil on_click:||{d.reasoning=effort A.redraw()}}}
                    if d.reasoning!=effort {resource_config_reasoning := mod.widgets.HagencyTallSegment{text:A.reasoning_label(effort) enabled:!H.busy && H.command==nil on_click:||{d.reasoning=effort A.redraw()}}}
                }}}}
            }}
            mod.widgets.HagencyListNote{text:A.t("Higher reasoning thinks longer and uses more of the pool. The account’s models are checked again when you save.","推理强度越高，思考越久，也更耗额度。保存时会再次检查此账号可用的模型。")}
            mod.widgets.HagencyListLabel{text:A.t("NEW AGENTS","新 Agent")}
            mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                resource_config_default_policy := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click:||A.dpol_open(detail.resource.id)}
                mod.widgets.HagencyListBody{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.adjust draw_icon.color:mod.widgets.RINX_INFO_FG}}
                    mod.widgets.HagencyListTitle{text:A.t("New Agent permissions","新 Agent 默认权限")}
                    mod.widgets.HagencyListValue{text:A.pool_yolo_label(yolo) draw_text.color:if yolo {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_MUTED}}
                    mod.widgets.HagencyChevron{}
                }
            }}
            mod.widgets.HagencyListNote{text:A.t("Saved on its own page, with a warning before full trust.","在单独的页面里设置，选择完全信任前会先提醒你。")}
            mod.widgets.HagencyListNote{text:A.t("The monthly maximum is set on the pool page. Saving starts no Agent.","每月上限在资源池页面上设置。保存不会启动任何 Agent。")}
        }}}
        if H.page=="resource_create" && H.resource_create_draft!=nil && H.resource_detail!=nil {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let d=H.resource_create_draft let detail=H.resource_detail
            let cb=A.pool_budget(detail.resource)
            let ctop=if cb.quota!=nil && cb.quota>0 {cb.quota} else {-1}
            let yolo=A.resource_draft_yolo(d,detail)
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:4} text:A.t("Uses the same account and login as ","使用与「")+A.resource_title(detail.resource)+A.t(". That pool stays as it is.","」相同的账号和登录，原资源池保持不变。")}
            if H.notice!="" && !H.busy {View{width:Fill height:Fit padding:Inset{bottom:4} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_WARNING_BG
                mod.widgets.HagencyCopy{text:A.notice_text() draw_text.color:mod.widgets.RINX_WARNING_FG}

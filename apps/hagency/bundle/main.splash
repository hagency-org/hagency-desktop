                                if v.renewal==nil {View{width:Fit height:Fit pool_renew := mod.widgets.HagencyGetButton{text:A.t("Publish Ahead","提前发布") enabled:!H.busy && H.command==nil && !locked on_click:||A.pool_renew()}}}
                            }

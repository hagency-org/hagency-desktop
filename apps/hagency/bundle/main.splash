if !mod.rinx_theme.reloading() {start_timeout(0.05, || A.connect()) start_timeout(15,||A.web_auto_refresh())}
if mod.rinx_theme.reloading() {start_timeout(0.05, || A.redraw())}

shell := View{width:Fill height:Fill flow:Down spacing:12
    heading := View{width:Fill height:Fit flow:Down spacing:0 on_render:||{
        View{width:Fill height:Fit flow:Right spacing:10 align:Align{y:0.5}
            mod.widgets.HagencyBadge{width:32 height:32 mod.widgets.HagencyGlyph{width:18 height:18 icon_walk:Walk{width:18 height:18} draw_icon.svg:mod.rinx_icons.hagency}}
            mod.widgets.HagencySectionTitle{width:Fill flow:Right max_lines:1 text_overflow:TextOverflow.Ellipsis text:if H.entry_role!="" && !H.entry_choosing{A.entry_label(H.entry_role)}else{"Hagency"}}
            entry_switch := mod.widgets.HagencyButton{visible:H.ready && H.entry_role!="" && !H.entry_choosing enabled:!H.busy text:A.t("Switch Role","切换角色") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.person on_click:||A.entry_switch()}
            refresh := mod.widgets.HagencyIconButton{enabled:!H.busy && !A.must_reopen() draw_icon.svg:mod.rinx_icons.refresh on_click:||A.refresh()}
        }
    }}
    navigation := View{width:Fill height:Fit flow:Right spacing:4 on_render:||{
        if H.ready && H.entry_role!="" && !H.entry_choosing {
            let parent=A.entry_parent()
            nav_overview := View{visible:H.entry_role!="owner" width:Fill height:Fit
                let active=parent=="overview"
                overview := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:6 top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:A.t("Home","首页")
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.home color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.navigate("overview")
                }
            }
            nav_agents := View{visible:H.entry_role=="manager" width:Fill height:Fit
                let active=parent=="agents"
                agents := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:6 top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:A.t("Agents","Agent")
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.person color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.navigate("agent_home")
                }
            }
            nav_projects := View{visible:H.entry_role=="manager" width:Fill height:Fit
                let active=parent=="projects"
                projects := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:6 top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:A.t("Pools","资源池")
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.projects color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.navigate("pools")
                }
            }
            nav_accounts := View{visible:H.entry_role=="owner" width:Fill height:Fit
                let active=parent=="accounts"
                accounts := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:6 top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:A.t("Coding tools","编码工具")
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.connection color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.open_accounts(nil)
                }
            }
            nav_resources := View{visible:H.entry_role=="owner" width:Fill height:Fit flow:Overlay
                let active=parent=="resources"
                let badge=A.tab_badge("resources")
                resources := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:(if badge>0 {(20+12*mod.widgets.RINX_TEXT_SCALE)} else {6}) top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:if badge>0 {A.t("Pools","资源池")} else {A.t("Resource pools","资源池")}
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.resources color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.navigate("resources")
                }
                if badge>0 {View{width:Fill height:Fill align:Align{x:1.0 y:(if mod.widgets.RINX_TEXT_SCALE>1.2 {0.2} else {0.5})} padding:Inset{right:(4+2*mod.widgets.RINX_TEXT_SCALE)} mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:if badge>99 {"99+"} else {""+badge}}}}}
            }
            nav_inbox := View{visible:H.entry_role!="manager" width:Fill height:Fit flow:Overlay
                let active=parent=="inbox"
                let badge=A.tab_badge("inbox")
                inbox := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:(if badge>0 {(20+12*mod.widgets.RINX_TEXT_SCALE)} else {6}) top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:if H.entry_role=="admin"{A.t("Admission","加入服务器")}else if badge>0 {A.t("Requests","Agent 申请")} else {A.t("Agent requests","Agent 申请")}
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.inbox color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.navigate("inbox")
                }
                if badge>0 {View{width:Fill height:Fill align:Align{x:1.0 y:(if mod.widgets.RINX_TEXT_SCALE>1.2 {0.2} else {0.5})} padding:Inset{right:(4+2*mod.widgets.RINX_TEXT_SCALE)} mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:if badge>99 {"99+"} else {""+badge}}}}}
            }
            nav_devices := View{visible:false width:Fill height:Fit
                let active=parent=="devices"
                devices := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:6 top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:A.t("Devices","执行")
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.device color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.open_execution(nil)
                }
            }
            nav_servers := View{visible:H.entry_role=="admin" width:Fill height:Fit
                let active=parent=="servers"
                servers := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:6 top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:A.t("Servers","连接")
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.connection color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.navigate("connections")
                }
            }
            nav_work := View{visible:H.entry_role!="owner" width:Fill height:Fit
                let active=parent=="work"
                work := mod.widgets.HagencyButton{width:Fill height:(if mod.widgets.RINX_TEXT_SCALE>1.2 {56} else {44}) flow:(if mod.widgets.RINX_TEXT_SCALE>1.2 {Flow.Down} else {Flow.Right}) spacing:(if mod.widgets.RINX_TEXT_SCALE>1.2 {2} else {6}) padding:Inset{left:6 right:6 top:0 bottom:0} align:Align{x:0.5 y:0.5} enabled:!H.busy
                    text:if H.entry_role=="admin"{A.t("Console","管理")}else{A.t("Work","工作")}
                    draw_bg +: {color:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} color_hover:mod.widgets.RINX_HOVER color_focus:if active{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE}}
                    draw_text +: {text_style:theme.font_regular{font_size:mod.widgets.RINX_META_SIZE} color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} color_hover:mod.widgets.RINX_INK color_focus:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}}
                    icon_walk:Walk{width:16 height:16} draw_icon +: {svg:mod.rinx_icons.tasks color:if active{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                    on_click:||A.navigate("tools")
                }
            }
        }
    }}
    page_bar := View{width:Fill height:Fit flow:Down clip_y:false on_render:||{
        if !A.page_bar_visible() {page_bar_none := View{width:Fill height:0}}
        if A.page_bar_visible() {page_bar_shown := View{width:Fill height:Fit flow:Down align:Align{x:0.5} margin:Inset{bottom:-12}
            let mode=A.page_bar_mode()
            View{width:Fill{max:720} height:(30+14*mod.widgets.RINX_TEXT_SCALE) flow:Overlay
                View{width:Fill height:Fill align:Align{x:0.5 y:0.5} padding:Inset{left:A.page_bar_side(mode) right:A.page_bar_side(mode)} mod.widgets.HagencyBarTitle{width:Fill align:Align{x:0.5} max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.page_bar_title()}}
                View{width:Fill height:Fill flow:Right align:Align{y:0.5}
                    if mode=="resource" {View{width:Fit height:Fit resource_back := mod.widgets.HagencyBackLink{text:A.nav_label(A.t("Pools","资源池")) enabled:!H.busy && A.alert_kind()=="" on_click: || A.pool_back()}}}
                    if mode=="resource_name" {View{width:Fit height:Fit resource_name_cancel := mod.widgets.HagencyBarText{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.resource_name_mode="" H.resource_name_draft=nil A.redraw()}}}}
                    if mode=="pool_create" {View{width:Fit height:Fit pool_create_cancel := mod.widgets.HagencyBarText{text:A.t("Cancel","取消") enabled:!H.busy on_click: || A.pool_create_close()}}}
                    if mode=="resource_edit" {View{width:Fit height:Fit resource_config_back := mod.widgets.HagencyBarText{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {let id=H.resource_edit_draft.resourceId H.resource_edit_draft=nil A.open_resource(id)}}}}
                    if mode=="resource_create" {View{width:Fit height:Fit resource_create_back := mod.widgets.HagencyBarText{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {let id=H.resource_create_draft.sourceResourceId H.resource_create_draft=nil A.open_resource(id)}}}}
                    if mode=="pool" {View{width:Fit height:Fit pool_agent_back := mod.widgets.HagencyBackLink{text:if H.entry_role=="owner" {A.nav_label(A.t("Requests","申请"))} else {A.t("My Agents","我的 Agent")} enabled:!H.busy on_click: || {if H.entry_role!="owner" || !A.nav_back() {A.navigate(if H.entry_role=="owner" {"inbox"} else {"agent_home"})}}}}}
                    if mode=="detail" {View{width:Fit height:Fit personal_back := mod.widgets.HagencyBackLink{text:A.t("My Agents","我的 Agent") enabled:!H.busy && H.local_discard=="" && H.local_confirm=="" on_click: || A.navigate("agent_home")}}}
                    if mode=="edit" {View{width:Fit height:Fit personal_edit_cancel := mod.widgets.HagencyBarText{text:A.t("Cancel","取消") enabled:!H.busy && H.local_discard=="" && H.local_confirm=="" on_click: || A.local_cancel_edit()}}}
                    if mode=="review" {View{width:Fit height:Fit personal_review_back := mod.widgets.HagencyBackLink{text:A.t("Edit","修改") enabled:!H.busy && H.local_discard=="" && H.local_confirm=="" on_click: || {H.personal_mode="edit" A.redraw()}}}}
                    if mode=="observe" {View{width:Fit height:Fit personal_observe_cancel := mod.widgets.HagencyBarText{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.personal_mode="detail" H.personal_draft=nil A.redraw()}}}}
                    if mode=="model" {View{width:Fit height:Fit personal_model_back := mod.widgets.HagencyBarText{text:A.t("Cancel","取消") enabled:!H.busy && H.local_discard=="" && H.local_confirm=="" on_click: || A.local_cancel_model()}}}
                    if mode=="sub" {View{width:Fit height:Fit sub_back := mod.widgets.HagencyBackLink{text:A.sub_back_label() enabled:!H.busy && A.sub_back_enabled() on_click: || A.sub_back()}}}
                    if mode=="offer_edit" {View{width:Fit height:Fit web_offer_cancel := mod.widgets.HagencyBarText{padding:Inset{left:10 right:10} text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.web.draft=nil A.redraw()}}}}
                    if mode=="template_edit" && H.templates.draft!=nil {View{width:Fit height:Fit template_edit_back := mod.widgets.HagencyBarText{padding:Inset{left:10 right:10} text:A.t("Cancel","取消") enabled:!H.busy on_click: || A.template_cancel_edit()}}}
                    View{width:Fill height:1}
                    if (mode=="sub" || mode=="template_edit" || mode=="offer_edit") && H.busy {View{width:Fit height:Fit padding:Inset{right:10} mod.widgets.HagencySpinner{}}}
                    if mode=="offer_edit" {View{width:Fit height:Fit web_offer_review := mod.widgets.HagencyBarDone{padding:Inset{left:10 right:10} text:A.t("Next","下一步") enabled:A.web_can_edit() on_click: || A.web_offer_save()}}}
                    if mode=="template_edit" && H.templates.draft!=nil {View{width:Fit height:Fit template_prepare := mod.widgets.HagencyBarDone{padding:Inset{left:10 right:10} text:A.t("Next","下一步") enabled:!H.busy on_click: || A.template_save_draft()}}}
                    if mode=="edit" {View{width:Fit height:Fit personal_review := mod.widgets.HagencyBarDone{text:A.t("Next","下一步") enabled:!H.busy && H.local_discard=="" && H.local_confirm=="" && H.command == nil && A.local_policy_changed() && A.personal_valid() on_click: || A.review_personal_policy()}}}
                    if mode=="review" {View{width:Fit height:Fit personal_submit := mod.widgets.HagencyBarDone{text:A.t("Save","保存") enabled:!H.busy && H.local_discard=="" && H.local_confirm=="" && H.command == nil && A.local_policy_changed() on_click: || A.submit_personal_policy()}}}
                    if mode=="resource" && H.resource_detail!=nil && A.local_name(H.resource_detail.resource)!=nil {View{width:Fit height:Fit resource_name_edit := mod.widgets.HagencyBarText{text:A.t("Rename","重命名") enabled:!H.busy && H.command==nil && A.alert_kind()=="" on_click: || A.edit_resource_name()}}}
                    if mode=="resource_name" {View{width:Fit height:Fit resource_name_save := mod.widgets.HagencyBarDone{text:A.t("Done","完成") enabled:!H.busy && H.command==nil on_click: || {A.review_resource_name() if H.resource_name_mode=="review"{A.submit_resource_name()}}}}}
                    if mode=="pool_create" {View{width:Fit height:Fit pool_create_submit := mod.widgets.HagencyBarDone{text:A.t("Create","创建") enabled:A.pool_create_valid() on_click: || A.pool_create_submit()}}}
                    if mode=="resource_edit" {View{width:Fit height:Fit resource_config_review := mod.widgets.HagencyBarDone{text:A.t("Save","保存") enabled:!H.busy && H.command==nil on_click: || A.submit_resource_configuration()}}}
                    if mode=="resource_create" {View{width:Fit height:Fit resource_create_review := mod.widgets.HagencyBarDone{text:A.t("Create","创建") enabled:!H.busy && H.command==nil on_click: || A.submit_resource_creation()}}}
                    if mode=="observe" {View{width:Fit height:Fit personal_observe_submit := mod.widgets.HagencyBarDone{text:A.t("Sync","同步") enabled:!H.busy && H.command == nil on_click: || A.submit_personal_observation()}}}
                    if mode=="model" {View{width:Fit height:Fit personal_model_submit := mod.widgets.HagencyBarDone{text:A.t("Save","保存") enabled:!H.busy && H.local_discard=="" && H.local_confirm=="" && H.command==nil && A.personal_model_valid() && A.local_model_changed() on_click: || A.submit_personal_model()}}}
                }
            }
            mod.widgets.HagencyDivider{margin:Inset{left:-20 right:-20} draw_bg.color:if H.bar_past {mod.widgets.RINX_BORDER} else {#0000}}
        }}
    }}
    notice := mod.widgets.HagencyHint{visible: H.notice != "" && !H.busy && !A.notice_inline() && !A.sub_page() text: A.notice_text()}
    content := mod.widgets.RinxPageScroll{margin:Inset{right:-20} scroll_mark:120 on_scroll_mark:|past|{H.bar_past=past ui.page_bar.render()} body +: {
        padding:Inset{right:20}
        scroll_bars:mod.widgets.ScrollBars{show_scroll_x:false show_scroll_y:true
            scroll_bar_y:mod.widgets.ScrollBar{drag_scrolling:true bar_size:4
                draw_bg +: {color:mod.widgets.RINX_BORDER color_hover:mod.widgets.RINX_MUTED color_drag:mod.widgets.RINX_ACCENT}
            }
        }
        page +: {width:Fill{max:960} spacing:16 on_render:A.render_page}
    }}
}
alert_layer := View{width:Fill height:Fill flow:Down align:Align{y:1.0} new_batch:true on_render:||{
    let kind=A.alert_kind()
    let footer=if kind=="" {A.pool_footer_state()} else {{show:false}}
    if kind=="" && !footer.show {alert_none := View{width:0 height:0}}
    // A pool's unsaved change: its consequence, Revert and Save, always in view under the page.
    if kind=="" && footer.show {pool_footer := RoundedView{width:Fill height:Fit flow:Down show_bg:true draw_bg +: {color:mod.widgets.RINX_PAGE border_radius:0.0}
        mod.widgets.HagencyDivider{}
        View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{left:20 right:20 top:10 bottom:14} mod.widgets.HagencyColumn{View{width:Fill height:Fit flow:Down spacing:6
            pool_save_note := mod.widgets.HagencyListNote{width:Fill align:Align{x:0.5} text:footer.note}
            View{width:Fill height:Fit flow:Right spacing:12
                if footer.dirty {pool_revert := mod.widgets.HagencyWideSecondary{text:A.t("Revert","还原") enabled:!H.busy on_click:||A.pool_revert()}}
                pool_save := mod.widgets.HagencyWideButton{text:footer.label enabled:footer.enabled draw_bg +: {color_disabled:mod.widgets.RINX_FIELD color_2_disabled:mod.widgets.RINX_FIELD} on_click:||A.pool_save()}
            }
        }}}
    }}
    if kind!="" {alert_scrim := mod.widgets.HagencyScrim{mod.widgets.HagencyAlert{
        if kind=="policy" || kind=="model" || kind=="pool" {View{width:Fill height:Fit flow:Down
            mod.widgets.HagencyAlertTitle{text:A.t("Discard Changes?","放弃修改？")}
            mod.widgets.HagencyAlertMessage{text:if kind=="model" {A.t("Your model and workspace changes haven’t been saved.","你对模型与工作区的修改尚未保存。")} else if kind=="pool" {A.t("Your limit changes haven’t been saved.","你对额度的修改尚未保存。")} else {A.t("Your limit and approval changes haven’t been saved.","你对额度与审批的修改尚未保存。")}}
            mod.widgets.HagencyDivider{}
            if kind!="pool" {View{width:Fill height:Fit flow:Down
                local_discard_confirm := mod.widgets.HagencyAlertDanger{text:A.t("Discard Changes","放弃修改") on_click: || A.local_discard_changes()}
                mod.widgets.HagencyDivider{}
                local_discard_keep := mod.widgets.HagencyAlertBold{text:A.t("Keep Editing","继续编辑") on_click: || {H.local_discard="" H.local_after="" A.redraw()}}
            }}
            if kind=="pool" {View{width:Fill height:44 flow:Right
                local_discard_keep := mod.widgets.HagencyAlertBold{text:A.t("Keep Editing","继续编辑") on_click: || {H.local_discard="" H.local_after="" A.redraw()}}
                mod.widgets.HagencyVDivider{}
                local_discard_confirm := mod.widgets.HagencyAlertDanger{text:A.t("Discard","放弃修改") on_click: || A.local_discard_changes()}
            }}
        }}
        if kind=="encrypt" {View{width:Fill height:Fit flow:Down
            mod.widgets.HagencyAlertTitle{text:A.t("Turn On End-to-End Encryption?","开启端到端加密？")}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} text:A.t("Only your devices and this Agent’s device will be able to read this private chat.","只有你的设备和此 Agent 的设备能读取私聊内容。")}
            mod.widgets.HagencyAlertMessage{text:A.t("This can’t be turned off later.","开启后无法关闭。")}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                local_encrypt_cancel := mod.widgets.HagencyAlertButton{text:A.t("Cancel","取消") on_click: || {H.local_confirm="" A.redraw()}}
                mod.widgets.HagencyVDivider{}
                local_encrypt_confirm := mod.widgets.HagencyAlertBold{text:A.t("Turn On","开启") enabled:H.local_pending=="" on_click: || A.local_encrypt()}
            }
        }}
        if kind=="failure" {View{width:Fill height:Fit flow:Down
            mod.widgets.HagencyAlertTitle{text:if H.local_failure=="hagency.personal_agents.observe" {A.t("Couldn’t Sync Settings","无法同步设置")} else {A.t("Couldn’t Save Changes","无法保存修改")}}
            mod.widgets.HagencyAlertMessage{text:if H.local_kept!=nil && A.local_conflict(H.local_failure_code) {A.t("Limits and approvals were changed on the execution device. Your changes weren’t saved.","执行设备上的额度与审批已被修改，你的修改没有保存。")} else {H.local_failure_reason}}
            mod.widgets.HagencyDivider{}
            if H.local_kept==nil {local_failure_ok := mod.widgets.HagencyAlertBold{text:A.t("OK","好") on_click: || {H.local_failure="" A.redraw()}}}
            if H.local_kept!=nil {View{width:Fill height:44 flow:Right
                local_failure_discard := mod.widgets.HagencyAlertDanger{text:A.t("Discard","放弃修改") on_click: || {H.local_failure="" H.local_kept=nil A.redraw()}}
                mod.widgets.HagencyVDivider{}
                local_failure_recheck := mod.widgets.HagencyAlertBold{text:A.t("Review Again","重新核对") enabled:H.personal_detail!=nil && !H.busy on_click: || A.local_recheck()}
            }}
        }}
        if kind=="retire" {View{width:Fill height:Fit flow:Down
            mod.widgets.HagencyAlertTitle{text:A.t("Retire “","要停用「")+A.local_agent_name()+A.t("”?","」吗？")}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} text:A.t("It will stop serving every room for good. This can’t be undone.","此 Agent 将永久停止在所有房间中的服务，且无法撤销。")}
            mod.widgets.HagencyAlertMessage{text:A.t("This opens the Agent’s settings in Hagency, where you confirm.","将打开 Hagency 中此 Agent 的设置页，在那里确认停用。")}
            mod.widgets.HagencyDivider{}
            local_retire_confirm := mod.widgets.HagencyAlertDanger{text:A.t("Continue to Retire","前往停用") on_click: || {H.local_confirm="" A.redraw() A.native_open_agent(H.personal_id)}}
            mod.widgets.HagencyDivider{}
            local_retire_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") on_click: || {H.local_confirm="" A.redraw()}}
        }}
        if kind=="resource_publish" {View{width:Fill height:Fit flow:Down
            let listed=H.resource_detail.resource.published
            mod.widgets.HagencyAlertTitle{text:if listed {A.t("Stop Showing in the Catalogue?","不再在目录中列出？")} else {A.t("Show in the Catalogue?","在目录中列出？")}}
            mod.widgets.HagencyAlertMessage{text:if listed {A.t("The catalogue won’t show this pool any more. Agents already running keep it.","目录里不再显示此资源池，已在运行的 Agent 不受影响。")} else {A.t("After listing, this pool’s model and monthly maximum can’t be changed. The catalogue can show it.","列出后，此资源池的模型和每月上限将不能修改，目录里可以显示它。")}}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                if !listed {resource_publish_cancel := mod.widgets.HagencyAlertButton{text:A.t("Cancel","取消") enabled:!H.busy on_click:||{H.web.publicationReview=false A.redraw()}}}
                if listed {resource_publish_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy on_click:||{H.web.publicationReview=false A.redraw()}}}
                mod.widgets.HagencyVDivider{}
                if listed {resource_publish_confirm := mod.widgets.HagencyAlertDanger{text:A.t("Stop Showing","不再列出") enabled:!H.busy && H.command==nil on_click:||{H.web.publicationReview=false A.web_publication()}}}
                if !listed {resource_publish_confirm := mod.widgets.HagencyAlertBold{text:A.t("List","列出") enabled:!H.busy && H.command==nil on_click:||{H.web.publicationReview=false A.web_publication()}}}
            }
        }}
        if kind=="pool_approve" || kind=="pool_reject" || kind=="pool_stop" {View{width:Fill height:Fit flow:Down
            let r=if H.page=="pool_agent" {H.pool_detail} else {H.reqs.confirm.row}
            let name=r.definition.name
            let owner=H.entry_role=="owner"
            mod.widgets.HagencyAlertTitle{text:if kind=="pool_approve" {A.t("Approve “"+name+"”?","批准「"+name+"」的申请？")} else if kind=="pool_reject" {A.t("Decline “"+name+"”?","拒绝「"+name+"」的申请？")} else if owner {A.t("Stop “"+name+"” using this pool?","让「"+name+"」停止使用这个资源池？")} else {A.t("Remove “"+name+"”?","要移除「"+name+"」吗？")}}
            mod.widgets.HagencyAlertMessage{text:if kind=="pool_approve" {A.t("This gives it "+A.tokens(r.requestedTokens)+" from "+r.poolLabel+".","将从 "+r.poolLabel+" 分给它 "+A.tokens(r.requestedTokens)+"。")+A.reqs_after(r)} else if kind=="pool_reject" {A.t("The request will be closed. This can’t be undone.","申请将被关闭，且无法撤销。")} else if owner {A.t("It stops taking new work from your pool. Of the "+A.tokens(r.requestedTokens)+" it was given, what it hasn’t used goes back to the pool.","它不再从你的资源池接新任务。分给它的 "+A.tokens(r.requestedTokens)+" 里没用掉的部分，会回到资源池。")+(if A.reqs_stop_view() && A.reqs_pool_over() {A.t(" The alert clears by itself once use is back under the maximum."," 用量回到每月上限以内时，告警自动解除。")} else {""})} else {A.t("It stops taking new work.","此 Agent 将不再接收新任务。")}}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                if kind=="pool_approve" {owner_decision_cancel := mod.widgets.HagencyAlertButton{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.pool_confirm="" H.reqs.confirm=nil A.redraw()}}}
                if kind!="pool_approve" {owner_decision_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.pool_confirm="" H.reqs.confirm=nil A.redraw()}}}
                mod.widgets.HagencyVDivider{}
                if kind=="pool_approve" {owner_decision_confirm := mod.widgets.HagencyAlertBold{text:A.t("Approve","批准") enabled:!H.busy && H.command==nil on_click: || {if H.page=="pool_agent" {A.pool_decide()} else {A.reqs_decide()}}}}
                if kind!="pool_approve" {owner_decision_confirm := mod.widgets.HagencyAlertDanger{text:if kind=="pool_reject" {A.t("Decline","拒绝")} else if owner {A.t("Stop Using","停止使用")} else {A.t("Remove","移除")} enabled:!H.busy && H.command==nil on_click: || {if H.page=="pool_agent" {A.pool_decide()} else {A.reqs_decide()}}}}
            }
        }}
        if kind=="policy_change" {View{width:Fill height:Fit flow:Down
            let name=H.policy_detail.agent
            let full=H.policy_draft.executionPolicy.yolo
            mod.widgets.HagencyAlertTitle{text:if full {A.t("Fully Trust “"+name+"”?","要完全信任「"+name+"」吗？")} else {A.t("Use Standard Permissions?","改为标准权限？")}}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} text:if full {A.t("It can read and change files outside its workspace and use the network, without asking you first.","它将能读写工作区以外的文件、访问网络，而且不会先请求你批准。")} else {A.t("Its next task works inside its workspace and asks before doing more.","它的下一个任务会在工作区内运行，超出范围前会先请求批准。")}}
            mod.widgets.HagencyAlertMessage{text:if full {A.t("Only do this for an Agent you trust. It applies to its next task.","请只对你信任的 Agent 开启。下一个任务开始时生效。")} else {A.t("It applies to its next task.","下一个任务开始时生效。")}}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                if full {policy_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.policy_draft=nil H.policy_mode="detail" A.redraw()}}}
                if !full {policy_cancel := mod.widgets.HagencyAlertButton{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.policy_draft=nil H.policy_mode="detail" A.redraw()}}}
                mod.widgets.HagencyVDivider{}
                if full {policy_save := mod.widgets.HagencyAlertDanger{text:A.t("Trust Fully","完全信任") enabled:!H.busy && H.command==nil on_click: || {A.review_policy() A.submit_policy()}}}
                if !full {policy_save := mod.widgets.HagencyAlertBold{text:A.t("Use Standard","改为标准") enabled:!H.busy && H.command==nil on_click: || {A.review_policy() A.submit_policy()}}}
            }
        }}
        if kind=="tool_revoke" {View{width:Fill height:Fit flow:Down
            let d=H.tool_draft
            mod.widgets.HagencyAlertTitle{text:A.t("Take Back This Permission?","撤销这项权限？")}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} flow:Flow.Right{wrap:true} max_lines:4 text_overflow:Ellipsis text:A.tool_rule_text(d.details)}
            mod.widgets.HagencyAlertMessage{text:A.t(d.agent+" will need approval again next time. Actions already started keep going.",A.sub_join(d.agent,"下次需要重新请求批准，已经开始的操作不会被取消。"))}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                tool_grant_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy && H.command==nil on_click: || {if !H.busy && H.command==nil {H.tool_draft=nil H.page="tool_grants" A.redraw()}}}
                mod.widgets.HagencyVDivider{}
                tool_grant_revoke := mod.widgets.HagencyAlertDanger{text:A.t("Take Back","撤销") enabled:!H.busy && H.command==nil on_click: || A.submit_tool_grant()}
            }
        }}
        if kind=="binding_remove" {View{width:Fill height:Fit flow:Down
            let d=H.binding_draft
            mod.widgets.HagencyAlertTitle{text:A.t("Remove “"+d.agent+"”’s Approval Room?","移除「"+d.agent+"」的审批聊天？")}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} text:A.t("Tool permissions saved in it are taken back, and its pending approvals stop working.","这个审批聊天里保存的工具权限会被撤销，待处理的审批也会失效。")}
            mod.widgets.HagencyAlertMessage{text:A.t("The Agent can get a new approval room later.","以后可以为 Agent 再建立审批聊天。")}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                binding_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy && H.command==nil on_click: || {if !H.busy && H.command==nil {H.binding_confirm=false A.redraw()}}}
                mod.widgets.HagencyVDivider{}
                binding_remove := mod.widgets.HagencyAlertDanger{text:A.t("Remove","移除") enabled:!H.busy && H.command==nil on_click: || A.submit_binding()}
            }
        }}
        if kind=="server_revoke" || kind=="server_approve" || kind=="server_reject" {View{width:Fill height:Fit flow:Down
            let danger=kind!="server_approve"
            mod.widgets.HagencyAlertTitle{text:if kind=="server_revoke" {A.t("Close the Server Connection?","关闭服务器连接？")} else if kind=="server_approve" {A.t("Let This Pool Join?","批准这个资源池加入？")} else {A.t("Decline This Pool?","拒绝这个资源池加入？")}}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} text:if kind=="server_revoke" {A.t("Agents can no longer request this pool.","Agent 将不能再申请这个资源池。")} else if kind=="server_approve" {A.t("This only lets it join.","这只批准它加入服务器。")} else {A.t("It won’t join the server.","它不会加入服务器。")}}
            mod.widgets.HagencyAlertMessage{text:if kind=="server_revoke" {A.t("You can ask to join again later.","以后可以重新申请加入。")} else if kind=="server_approve" {A.t("It gives no capacity and starts no Agent.","不会分配额度，也不会启动 Agent。")} else {A.t("Its owner can ask again later.","它的所有者以后可以重新申请。")}}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                if danger {server_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.confirm="" A.redraw()}}}
                if !danger {server_cancel := mod.widgets.HagencyAlertButton{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.confirm="" A.redraw()}}}
                mod.widgets.HagencyVDivider{}
                if kind=="server_revoke" {server_confirm := mod.widgets.HagencyAlertDanger{text:A.t("Close","关闭连接") enabled:!H.busy && H.command==nil on_click: || A.revoke()}}
                if kind=="server_reject" {server_confirm := mod.widgets.HagencyAlertDanger{text:A.t("Decline","拒绝") enabled:!H.busy && H.command==nil on_click: || A.decide(false)}}
                if kind=="server_approve" {server_confirm := mod.widgets.HagencyAlertBold{text:A.t("Approve","批准") enabled:!H.busy && H.command==nil on_click: || A.decide(true)}}
            }
        }}
        if kind=="create_trust" {View{width:Fill height:Fit flow:Down
            mod.widgets.HagencyAlertTitle{text:A.t("Fully Trust New Agents?","新 Agent 默认完全信任？")}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} text:A.t("Agents created in this pool can read and change files outside their workspace and use the network, without asking you first.","这个资源池里新建的 Agent 将能读写工作区以外的文件、访问网络，而且不会先请求你批准。")}
            mod.widgets.HagencyAlertMessage{text:A.t("Only do this if you trust everyone who can request this pool. You can change it later.","请只在你信任所有申请者时开启。以后可以再改。")}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                resource_create_trust_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.create_trust_ask="" A.redraw()}}
                mod.widgets.HagencyVDivider{}
                resource_create_trust_confirm := mod.widgets.HagencyAlertDanger{text:A.t("Trust Fully","完全信任") enabled:!H.busy && H.command==nil on_click: || A.confirm_resource_trust()}
            }
        }}
        if kind=="default_policy" {View{width:Fill height:Fit flow:Down
            let full=H.dpol.ask==true
            mod.widgets.HagencyAlertTitle{text:if full {A.t("Fully Trust New Agents?","新 Agent 默认完全信任？")} else {A.t("Use Standard Permissions?","新 Agent 改为标准权限？")}}
            mod.widgets.HagencyAlertMessage{padding:Inset{left:16 right:16 top:6 bottom:0} text:if full {A.t("Agents created from now on can read and change files outside their workspace and use the network, without asking you first.","以后新建的 Agent 将能读写工作区以外的文件、访问网络，而且不会先请求你批准。")} else {A.t("Agents created from now on work inside their workspace and ask before doing more.","以后新建的 Agent 会在工作区内运行，超出范围前会先请求批准。")}}
            mod.widgets.HagencyAlertMessage{text:if full {A.t("Only do this if you trust everyone who can request this pool. Existing Agents keep their own permissions.","请只在你信任所有申请者时开启。现有 Agent 保持各自的权限。")} else {A.t("Existing Agents keep their own permissions.","现有 Agent 保持各自的权限。")}}
            mod.widgets.HagencyDivider{}
            View{width:Fill height:44 flow:Right
                if full {default_policy_cancel := mod.widgets.HagencyAlertBold{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.dpol.ask=nil A.redraw()}}}
                if !full {default_policy_cancel := mod.widgets.HagencyAlertButton{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.dpol.ask=nil A.redraw()}}}
                mod.widgets.HagencyVDivider{}
                if full {default_policy_save := mod.widgets.HagencyAlertDanger{text:A.t("Trust Fully","完全信任") enabled:!H.busy && H.command==nil on_click: || A.dpol_commit()}}
                if !full {default_policy_save := mod.widgets.HagencyAlertBold{text:A.t("Use Standard","改为标准") enabled:!H.busy && H.command==nil on_click: || A.dpol_commit()}}
            }
        }}
    }}}
}}

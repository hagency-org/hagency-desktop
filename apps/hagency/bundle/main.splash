                            mod.widgets.HagencyListTitle{width:Fit draw_text +: {text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE}} text:A.t("This computer","这台电脑")}
                            if device.key!="loading" {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(device.tone)
                                pool_device_state := mod.widgets.HagencyPillText{text:device.text draw_text.color:A.local_tone_fg(device.tone)}
                            }}
                        }
                        mod.widgets.HagencyWrapSubtitle{text:device.detail}
                    }
                }
                if device.fix {View{width:Fill height:Fit padding:Inset{left:16 right:16 top:0 bottom:14}
                    pool_device_fix := mod.widgets.HagencyWideButton{text:A.t("Continue Setting Up","继续设置这台电脑") enabled:!H.busy && H.command==nil on_click:||A.dev_setup("hub")}
                }}
                if device.key=="attention" && !device.fix {View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:16 right:16 top:0 bottom:14}
                    mod.widgets.HagencyWrapSubtitle{text:A.t("What you can do: keep publishing from the computer that published before, or check again after Hagency updates.","你可以：继续在原来发布的电脑上发布；或者等 Hagency 更新后再检查一次。")}
                    View{width:Fill height:Fit flow:Right spacing:12
                        pool_device_recheck := mod.widgets.HagencyWideTinted{text:A.t("Check Again","再检查一次") enabled:!H.busy on_click:||A.pool_device_load()}
                        pool_device_elsewhere := mod.widgets.HagencyWideButton{text:A.t("Use Another Computer","换台电脑发布") enabled:!H.busy on_click:||A.pool_device_migrate()}
                    }
                }}
                if device.key=="error" {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        pool_device_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.pool_device_load()}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                    }
                }}
            }
            if H.dev.result!=nil {View{width:Fill height:Fit padding:Inset{top:4} mod.widgets.HagencyStatus{draw_bg.color:A.local_tone_bg(H.dev.result.tone)
                pool_device_result := mod.widgets.HagencyCopy{text:H.dev.result.text draw_text.color:A.local_tone_fg(H.dev.result.tone)}
            }}}
            View{width:Fill height:Fit padding:Inset{top:12} mod.widgets.HagencyList{
                mod.widgets.HagencyFitRow{
                    mod.widgets.HagencyRowBody{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.adjust draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Getting Started","上手步骤")}
                            mod.widgets.HagencyWrapSubtitle{text:steps.line}
                            if steps.text!="" && mod.widgets.RINX_TEXT_SCALE>1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(steps.tone) mod.widgets.HagencyPillText{text:steps.text draw_text.color:A.local_tone_fg(steps.tone)}}}
                        }
                        if steps.text!="" && mod.widgets.RINX_TEXT_SCALE<=1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(steps.tone) mod.widgets.HagencyPillText{text:steps.text draw_text.color:A.local_tone_fg(steps.tone)}}}
                        mod.widgets.HagencyChevron{}
                    }
                    pool_device_setup_open := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.dev_open("pool_device_setup",nil)}
                }
                mod.widgets.HagencyListDivider{}
                mod.widgets.HagencyFitRow{
                    mod.widgets.HagencyRowBody{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.device draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Move to a New Computer","迁移到新电脑")}
                            mod.widgets.HagencyWrapSubtitle{text:A.t("What to do on each computer","两台电脑上各要做什么")}
                        }
                        mod.widgets.HagencyChevron{}
                    }
                    pool_device_migrate := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.pool_device_migrate()}
                }
                mod.widgets.HagencyListDivider{}
                mod.widgets.HagencyFitRow{
                    mod.widgets.HagencyRowBody{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.sync draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Pick Up Interrupted Tasks","接回中断的任务")}
                            mod.widgets.HagencyWrapSubtitle{text:A.t("Tasks that stopped after a restart or a dropped connection","重启或断线后停下来的任务")}
                        }
                        if waiting>0 {mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:""+waiting}}}
                        mod.widgets.HagencyChevron{}
                    }
                    pool_device_recover := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.pool_device_recover()}
                }
            }}
            mod.widgets.HagencyListNote{text:A.t("Opening these pages changes nothing. Anything that changes this computer asks you to confirm first.","打开这些页面不会改动任何东西；会改动这台电脑的操作，都会先请你确认。")}
        }}}
        if H.page=="pool_device_setup" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let s=A.dev_steps()
            let device=s.device
            let board=H.pool_device.board
            let intents=if board!=nil && device.key=="ready" {A.dev_intents(board)} else {[]}
            mod.widgets.HagencyLargeTitle{text:A.t("Getting Started","上手步骤")}
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.t("To publish pools from this computer, finish these steps in order.","要在这台电脑上发布资源池，按顺序完成下面几步。")}
            mod.widgets.HagencyList{
                mod.widgets.HagencyFitRow{mod.widgets.HagencyRowBody{
                    if device.key=="ready" {mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}}
                    if device.key!="ready" {mod.widgets.HagencyRowIcon{mod.widgets.HagencyListValue{text:"1" draw_text.color:mod.widgets.RINX_ACCENT}}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("This computer itself","这台电脑本身")}
                        mod.widgets.HagencyWrapSubtitle{text:device.detail}
                    }
                    if device.key!="loading" && device.key!="ready" {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(device.tone) mod.widgets.HagencyPillText{text:device.text draw_text.color:A.local_tone_fg(device.tone)}}}
                }}
                if device.fix {View{width:Fill height:Fit padding:Inset{left:57 right:16 top:0 bottom:12}
                    pool_device_setup_fix := mod.widgets.HagencyGetButton{text:A.t("Continue Setting Up","继续设置这台电脑") enabled:!H.busy && H.command==nil on_click:||A.dev_setup("hub")}
                }}
                mod.widgets.HagencyListDivider{}
                mod.widgets.HagencyFitRow{
                    mod.widgets.HagencyRowBody{
                        if s.pools>0 {mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}}
                        if s.pools==0 {mod.widgets.HagencyRowIcon{mod.widgets.HagencyListValue{text:"2" draw_text.color:mod.widgets.RINX_ACCENT}}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Connect your coding tool","接入编码工具")}
                            mod.widgets.HagencyWrapSubtitle{text:if s.pools>0 {A.t("Connected. Manage its sign-in on Coding Tools.","已接入。登录在「编码工具」里管理。")} else {A.t("Connect your Codex account on Coding Tools.","在「编码工具」里接入 Codex 账号。")}}
                        }
                        mod.widgets.HagencyChevron{}
                    }
                    pool_device_step_tool := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.open_accounts(nil)}
                }
                mod.widgets.HagencyListDivider{}
                mod.widgets.HagencyFitRow{
                    mod.widgets.HagencyRowBody{
                        if s.admitted>0 && s.pending<=0 {mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}}
                        if !(s.admitted>0 && s.pending<=0) {mod.widgets.HagencyRowIcon{mod.widgets.HagencyListValue{text:"3" draw_text.color:mod.widgets.RINX_ACCENT}}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Create a pool and join a server","新建资源池并连接服务器")}
                            mod.widgets.HagencyWrapSubtitle{text:A.dev_join_text(s)}
                            if s.pending>0 && mod.widgets.RINX_TEXT_SCALE>1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg("waiting") mod.widgets.HagencyPillText{text:A.t(""+s.pending+" waiting",""+s.pending+" 个等批准") draw_text.color:A.local_tone_fg("waiting")}}}
                        }
                        if s.pending>0 && mod.widgets.RINX_TEXT_SCALE<=1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg("waiting") mod.widgets.HagencyPillText{text:A.t(""+s.pending+" waiting",""+s.pending+" 个等批准") draw_text.color:A.local_tone_fg("waiting")}}}
                        mod.widgets.HagencyChevron{}
                    }
                    pool_device_step_join := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.return_list("resources")}
                }
                mod.widgets.HagencyListDivider{}
                mod.widgets.HagencyFitRow{
                    mod.widgets.HagencyRowBody{
                        if s.published>0 && s.unpublished<=0 {mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}}
                        if !(s.published>0 && s.unpublished<=0) {mod.widgets.HagencyRowIcon{mod.widgets.HagencyListValue{text:"4" draw_text.color:mod.widgets.RINX_ACCENT}}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Publish this month’s capacity","发布本月额度")}
                            mod.widgets.HagencyWrapSubtitle{text:A.dev_publish_text(s)}
                            if s.unpublished>0 && mod.widgets.RINX_TEXT_SCALE>1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg("waiting") mod.widgets.HagencyPillText{text:A.t(""+s.unpublished+" to publish",""+s.unpublished+" 个未发布") draw_text.color:A.local_tone_fg("waiting")}}}
                        }
                        if s.unpublished>0 && mod.widgets.RINX_TEXT_SCALE<=1.2 {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg("waiting") mod.widgets.HagencyPillText{text:A.t(""+s.unpublished+" to publish",""+s.unpublished+" 个未发布") draw_text.color:A.local_tone_fg("waiting")}}}
                        mod.widgets.HagencyChevron{}
                    }
                    pool_device_step_publish := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.return_list("resources")}
                }
            }
            mod.widgets.HagencyListNote{text:A.t("A server administrator approves each pool once. After that you publish each month on the pool’s page.","每个资源池只需要服务器管理员批准一次；之后每个月在资源池页面发布额度。")}
            if H.dev.result!=nil {View{width:Fill height:Fit padding:Inset{top:4} mod.widgets.HagencyStatus{draw_bg.color:A.local_tone_bg(H.dev.result.tone)
                mod.widgets.HagencyCopy{text:H.dev.result.text draw_text.color:A.local_tone_fg(H.dev.result.tone)}
            }}}
            if intents.len()>0 {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:A.t("PUBLISHING RECORDS ON THIS COMPUTER","这台电脑上的发布记录")}
                mod.widgets.HagencyList{for index intent in intents {View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.file}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.onboarding_intent_label(intent)}
                            mod.widgets.HagencyWrapSubtitle{text:A.t("See how it went; opening it doesn’t publish again","看看结果如何；打开不会再发布一次")}
                        }
                        pool_device_record := mod.widgets.HagencyGetButton{text:A.t("Open","打开") enabled:!H.busy && H.command==nil on_click:||A.dev_open_record(intent)}
                    }
                }}}
                mod.widgets.HagencyListNote{text:A.t("If publishing stopped halfway, open its record here to see the result or finish it.","发布中途中断时，在这里打开它的记录，就能看到结果或接着完成。")}
            }}
        }}}
        if H.page=="pool_device_move" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            mod.widgets.HagencyLargeTitle{text:A.t("Move to a New Computer","迁移到新电脑")}
            mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:14 padding:Inset{left:16 right:16 top:14 bottom:14} align:Align{y:0.0}
                mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_INFO_FG}}
                View{width:Fill height:Fit flow:Down spacing:4
                    mod.widgets.HagencyWrapTitle{draw_text +: {text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE}} text:A.t("A pool stays with the computer that publishes it","资源池跟着发布它的电脑")}
                    pool_device_move_rule := mod.widgets.HagencyWrapSubtitle{text:A.t("This version can’t move a pool to another computer. Your pools stay as they are, and approved Agents keep working until the month ends. To switch computers, create new pools on the new one.","此版本还不能把资源池搬到另一台电脑。已有资源池保持不变，已批准的 Agent 可以用到月底。要换电脑，就在新电脑上新建资源池。")}
                }
            }}
            mod.widgets.HagencyListLabel{text:A.t("ON THE NEW COMPUTER","在新电脑上")}
            mod.widgets.HagencyList{
                for index step in A.dev_move_new() {let go=step.go View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyFitRow{
                        mod.widgets.HagencyRowBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyListValue{text:""+(index+1) draw_text.color:mod.widgets.RINX_ACCENT}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{text:step.title}
                                mod.widgets.HagencyWrapSubtitle{text:step.text}
                            }
                            if go!="" {mod.widgets.HagencyChevron{}}
                        }
                        if go!="" {pool_device_move_go := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.dev_move_go(go)}}
                    }
                }}
            }
            mod.widgets.HagencyListLabel{text:A.t("ON THIS COMPUTER","在这台电脑上")}
            mod.widgets.HagencyList{
                for index step in A.dev_move_old() {View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyListValue{text:""+(index+1) draw_text.color:mod.widgets.RINX_ACCENT}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:step.title}
                            mod.widgets.HagencyWrapSubtitle{text:step.text}
                        }
                    }
                }}
            }
            if H.resources.len()>0 {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:A.t("POOLS ON THIS COMPUTER","这台电脑上的资源池")}
                mod.widgets.HagencyList{for index item in H.resources {let row=item let s=A.pool_row(row) View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyFitRow{
                        mod.widgets.HagencyRowBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.resources draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.resource_title(row)}
                            if s.status.key!="" {mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:A.local_tone_bg(s.status.tone) mod.widgets.HagencyPillText{text:s.status.text draw_text.color:A.local_tone_fg(s.status.tone)}}}
                            mod.widgets.HagencyChevron{}
                        }
                        pool_device_move_pool := mod.widgets.HagencyRowCover{enabled:!H.busy on_click:||A.open_resource(row.id)}
                    }
                }}}
                mod.widgets.HagencyListNote{text:A.t("Open a pool to close its server connection when you no longer need it here.","不再需要这里的资源池时，打开它，在「服务器与发布」里关闭连接。")}
            }}
        }}}
        if H.page=="pool_device_tasks" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let d=H.dev
            let ready=A.dev_ready_count()
            let loading=d.taskState=="loading" || d.taskState=="idle"
            let partial=d.taskState=="error" || d.failed.len()>0
            let runs=A.dev_exec_rows()
            mod.widgets.HagencyLargeTitle{text:A.t("Pick Up Interrupted Tasks","接回中断的任务")}
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.t("After a restart or a dropped connection, tasks that were running stop. Decide here what happens to each one.","重启或断线后，正在执行的任务会停下来。在这里决定每个任务怎么处理。")}
            mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:14 padding:Inset{left:16 right:16 top:14 bottom:14} align:Align{y:0.5}
                if loading {View{width:38 height:38 align:Align{x:0.5 y:0.5} mod.widgets.HagencySpinner{width:22 height:22}}}
                let restarts=A.dev_restart_count()
                if !loading && ready>0 {mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.tasks draw_icon.color:mod.widgets.RINX_WARNING_FG}}}
                if !loading && ready==0 && restarts>0 {mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:mod.widgets.RINX_WARNING_FG}}}
                if !loading && ready==0 && restarts==0 && partial {mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_SELECTED mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_MUTED}}}
                if !loading && ready==0 && restarts==0 && !partial {mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}}
                View{width:Fill height:Fit flow:Down spacing:3
                    pool_device_tasks_summary := mod.widgets.HagencyWrapTitle{draw_text.text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE} text:A.dev_tasks_title(ready,loading,partial)}
                    mod.widgets.HagencyWrapSubtitle{text:A.dev_tasks_subtitle(ready,loading,partial)}
                }
            }}
            mod.widgets.HagencyListLabel{text:A.t("INTERRUPTED TASKS","中断的任务")}
            mod.widgets.HagencyList{
                if loading {mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:180 height:14}}}
                if !loading && d.tasks.len()==0 && !partial {mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    pool_device_tasks_none := mod.widgets.HagencyWrapTitle{text:A.t("No interrupted tasks","没有中断的任务")}
                }}
                for index item in d.tasks {let row=item.row View{width:Fill height:Fit flow:Down
                    let can=row.inspectionAvailable && row.sharedResourceAuthority
                    let tone=A.stopped_tone(row)
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.tasks draw_icon.color:A.local_tone_fg(tone)}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{max_lines:1 text_overflow:Ellipsis text:A.t(row.agent+"’s task stopped",A.sub_join(row.agent,"的任务中断了"))}
                                mod.widgets.HagencyWrapSubtitle{text:item.pool+" · "+(if can {A.t("Waiting for your decision","等待你决定怎么处理")} else {A.t("Can’t be handled yet","暂时不能处理")})}
                                mod.widgets.HagencyWrapSubtitle{text:A.stopped_next(row) draw_text.color:if can {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}
                            }
                            if can {mod.widgets.HagencyChevron{}}
                        }
                        pool_device_task_open := mod.widgets.HagencyListFitTap{enabled:!H.busy && can on_click: || {if row.sharedResourceAuthority && row.inspectionAvailable {A.open_stopped(row.resourceId,row.engagementId,row.dispatchId,0)}}}
                        if !row.inspectionAvailable && row.sharedResourceAuthority {View{width:Fill height:Fill align:Align{x:1.0 y:0.5} padding:Inset{right:10}
                            pool_device_task_refresh := mod.widgets.HagencyBarText{text:A.t("Refresh","刷新") enabled:!H.busy on_click: || {A.dev_tasks_load() A.redraw()}}
                        }}
                    }
                }}
                if !loading && partial {View{width:Fill height:Fit flow:Down
                    if d.tasks.len()>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.dev_tasks_failed()}
                            mod.widgets.HagencyWrapSubtitle{text:A.read_error(if d.taskError=="" {"management_busy"} else {d.taskError})}
                        }
                    }
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        pool_device_tasks_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || {A.dev_tasks_load() A.redraw()}}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                    }
                }}
            }
            mod.widgets.HagencyListNote{text:if d.more {A.t("Some pools have more; see each pool’s Health & Recovery.","有些资源池还有更多任务，请在资源池的「健康与恢复」里查看。")} else {A.t("See where a task stopped, then let it finish, accept it as done, or pause it.","看看任务停在哪里，再决定继续、确认完成或先暂停。")}}
            pool_device_runs_label := mod.widgets.HagencyListLabel{text:if A.dev_restart_count()>0 || runs.len()==0 {A.t("AGENTS TO RESTART","需要重新启动的 Agent")} else {A.t("AGENTS’ RUNS","Agent 运行情况")}}
            mod.widgets.HagencyList{
                if d.execState=="loading" {mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:160 height:14}}}
                if d.execState=="ready" && runs.len()==0 {mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    pool_device_runs_none := mod.widgets.HagencyWrapTitle{text:A.t("No Agents need restarting","没有需要重新启动的 Agent")}
                }}
                if d.execState=="unsupported" {mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_MUTED}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Restarting isn’t available here","这里暂时不能重新启动 Agent")}
                        mod.widgets.HagencyWrapSubtitle{text:A.dev_exec_reason(d.exec)}
                    }
                }}
                if d.execState=="error" {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t read Agents to restart","暂时无法读取需要重新启动的 Agent")}
                            mod.widgets.HagencyWrapSubtitle{text:A.read_error(d.execError)}
                        }
                    }
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        pool_device_runs_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || {A.dev_tasks_load() A.redraw()}}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                    }
                }}
                for index item in runs {let run=item View{width:Fill height:Fit flow:Down
                    let running=run.processState=="running"
                    let other=A.recipient_optional(H.dev,"other")==run.assignmentId
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    View{width:Fill height:Fit flow:Down spacing:10 padding:Inset{left:14 right:14 top:12 bottom:12}
                        View{width:Fill height:Fit flow:Right spacing:12 align:Align{y:0.5}
                            mod.widgets.HagencyRowIcon{draw_bg.color:if running {mod.widgets.RINX_SUCCESS_BG} else {mod.widgets.RINX_INFO_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:if running {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_INFO_FG}}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{text:run.agentName}
                                pool_device_run_state := mod.widgets.HagencyWrapSubtitle{text:if running {A.t("Running · nothing to do","正在运行 · 不用处理")} else {A.t("Last run: ","上次运行：")+A.dev_process_text(run.processState)}}
                            }
                        }
                        if !running {View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:41} align:Align{y:0.5}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{text:A.t("Suggested: restart it","建议：重新启动")}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("A new run; a confirmation window opens first","新运行一次，会先弹出确认窗口")}
                            }
                            pool_device_run_start := mod.widgets.HagencyPillTinted{width:Fit padding:Inset{left:18 right:18} text:A.t("Restart","重新启动") enabled:!H.busy && H.command==nil on_click:||A.dev_exec_action(run.assignmentId,false)}
                        }}
                        if !running && run.savedStart {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{left:41}
                            pool_device_run_other := mod.widgets.HagencyBarText{padding:Inset{left:0 right:8} text:if other {A.t("Other Ways ▴","其他办法 ▴")} else {A.t("Other Ways ▾","其他办法 ▾")} enabled:!H.busy on_click: || {H.dev.other=if A.recipient_optional(H.dev,"other")==run.assignmentId {""} else {run.assignmentId} A.redraw()}}
                            if other {View{width:Fill height:Fit flow:Right spacing:12 align:Align{y:0.5}
                                mod.widgets.HagencyListText{
                                    mod.widgets.HagencyWrapTitle{text:A.t("Tapped Start before but saw no result?","上次点了启动，但没有结果？")}
                                    mod.widgets.HagencyWrapSubtitle{text:A.t("Continue that start instead; it won’t start a second one.","可以接着上次那一次启动，不会多启动一个。")}
                                }
                                pool_device_run_resume := mod.widgets.HagencyPillTinted{width:Fit padding:Inset{left:18 right:18} text:A.t("Continue","接着启动") enabled:!H.busy && H.command==nil on_click:||A.dev_exec_action(run.assignmentId,true)}
                            }}
                        }}
                    }
                }}
            }
            if H.dev.result!=nil {View{width:Fill height:Fit padding:Inset{top:4} pool_device_tasks_result_box := mod.widgets.HagencyStatus{draw_bg.color:A.local_tone_bg(H.dev.result.tone)
                mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.dev.result.tone=="running" {mod.rinx_icons.check} else {mod.rinx_icons.info} draw_icon.color:A.local_tone_fg(H.dev.result.tone)}
                pool_device_tasks_result := mod.widgets.HagencyCopy{text:H.dev.result.text draw_text.color:A.local_tone_fg(H.dev.result.tone)}
                pool_device_tasks_result_done := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || {H.dev.result=nil A.redraw()}}
            }}}
            if A.dev_restart_count()>0 {mod.widgets.HagencyListNote{text:A.t("Restarting uses what this Agent was already given; nothing is charged twice.","重新启动用的是已分给这个 Agent 的额度，不会重复扣。")}}
        }}}
        if H.page=="pool_who" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let detail=if H.resource_detail!=nil && H.resource_detail.resource.id==H.pool_sub_rid {H.resource_detail} else {nil}
            let w=H.web
            let c=w.catalog
            let who=H.who
            mod.widgets.HagencyLargeTitle{text:A.t("Who Can Request","谁可以申请")}
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.sub_pool_name(H.pool_sub_rid)}
            if detail!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let v=A.pool_view(detail)
                let action=A.who_action(v)
                let people=A.who_candidates(v)
                mod.widgets.HagencyListLabel{text:if v.published {A.t("THIS MONTH’S LIST","本月名单")} else {A.t("ACCOUNTS THAT CAN REQUEST","可以申请的账号")}}
                mod.widgets.HagencyList{
                    if v.managers!=nil {View{width:Fill height:Fit flow:Down
                        for index mxid in v.managers {View{width:Fill height:Fit flow:Down
                            if index>0 {mod.widgets.HagencyListDivider{}}
                            mod.widgets.HagencySwitchRow{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.person draw_icon.color:mod.widgets.RINX_INFO_FG}}
                                pool_who_person := mod.widgets.HagencyWrapTitle{text:A.pool_person(mxid)}
                            }
                        }}
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock draw_icon.color:mod.widgets.RINX_MUTED}}
                            mod.widgets.HagencyListTitle{text:A.t("Valid","有效期")}
                            mod.widgets.HagencyListValue{text:A.pool_who_until(v)}
                        }
                    }}
                    if v.managers==nil && v.published {mod.widgets.HagencyFitRow{
                        mod.widgets.HagencyRowBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.file}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{text:A.t("Show This Month’s List","显示本月名单")}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Opens this month’s publication in a window on this computer to read the list. It changes nothing.","在这台电脑的窗口里打开本月的发布记录，读出名单。不会改动任何东西。")}
                            }
                            mod.widgets.HagencyChevron{}
                        }
                        pool_who_record := mod.widgets.HagencyRowCover{enabled:!H.busy && H.command==nil on_click:||A.pool_open_grant()}
                    }}
                    if v.managers==nil && !v.published {mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Not published yet","还没有发布")}
                            mod.widgets.HagencyWrapSubtitle{text:A.t("No account can request this pool yet.","现在还没有账号可以申请这个资源池。")}
                        }
                    }}
                }
                mod.widgets.HagencyListNote{text:A.pool_who_rule(v)}
                if action.kind!="" {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:if action.kind=="amend" {A.t("ADD PEOPLE","添加可以申请的人")} else {A.t("PICK PEOPLE IN ADVANCE","预先选好可以申请的人")}}
                    mod.widgets.HagencyList{
                        for index mxid in people {View{width:Fill height:Fit flow:Down
                            let picked=A.who_has(who.picks,mxid)
                            if index>0 {mod.widgets.HagencyListDivider{}}
                            mod.widgets.HagencyListFit{
                                mod.widgets.HagencyListFitBody{
                                    mod.widgets.HagencyRowIcon{draw_bg.color:if picked {mod.widgets.RINX_INFO_BG} else {mod.widgets.RINX_SELECTED} mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.person draw_icon.color:if picked {mod.widgets.RINX_INFO_FG} else {mod.widgets.RINX_MUTED}}}
                                    mod.widgets.HagencyListText{
                                        mod.widgets.HagencyWrapTitle{text:A.pool_person(mxid)}
                                        mod.widgets.HagencyListSubtitle{text:A.who_source(v,mxid)}
                                    }
                                    if picked {mod.widgets.HagencyPickOn{}}
                                    if !picked {mod.widgets.HagencyPickOff{}}
                                }
                                pool_who_pick := mod.widgets.HagencyListFitTap{enabled:!H.busy && H.command==nil on_click:||A.who_toggle(mxid)}
                            }
                        }}
                        if people.len()>0 {mod.widgets.HagencyListDivider{margin:Inset{left:16}}}
                        View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{left:14 right:14 top:10 bottom:12}
                            View{width:Fill height:Fit flow:Right spacing:10 align:Align{y:0.5}
                                pool_who_name := mod.widgets.HagencyInput{width:Fill text:who.name empty_text:A.t("Someone else? Username, e.g. lisi","其他人？输入用户名，例如 lisi") on_change:|t|{H.who.name=t ui.pool_who_add.set_enabled(A.who_mxid(t)!=nil && !H.busy && H.command==nil) ui.pool_who_name_hint.set_text(A.who_name_hint()) ui.pool_who_name_hint.set_visible(A.who_name_bad()=="") ui.pool_who_name_error.set_text(A.who_name_bad()) ui.pool_who_name_error.set_visible(A.who_name_bad()!="")}}
                                pool_who_add := mod.widgets.HagencyGetButton{text:A.t("Add","添加") enabled:A.who_mxid(who.name)!=nil && !H.busy && H.command==nil on_click:||A.who_add()}
                            }
                            pool_who_name_hint := mod.widgets.HagencyWrapSubtitle{visible:A.who_name_bad()=="" text:A.who_name_hint()}
                            pool_who_name_error := mod.widgets.HagencyWrapSubtitle{visible:A.who_name_bad()!="" text:A.who_name_bad() draw_text.color:mod.widgets.RINX_DANGER_FG}
                        }
                    }
                    let added=H.pool_result!=nil && H.pool_result.tone=="running" && who.picks.len()==0
                    if added {View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyStatus{draw_bg.color:A.local_tone_bg("running")
                        pool_who_result := mod.widgets.HagencyCopy{text:H.pool_result.text draw_text.color:A.local_tone_fg("running")}
                        pool_who_result_done := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || {H.pool_result=nil A.redraw()}}
                    }}}
                    if !added {View{width:Fill height:Fit flow:Down spacing:6
                        if H.pool_result!=nil {View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyStatus{draw_bg.color:A.local_tone_bg(H.pool_result.tone)
                            pool_who_result := mod.widgets.HagencyCopy{text:H.pool_result.text draw_text.color:A.local_tone_fg(H.pool_result.tone)}
                        }}}
                        View{width:Fill height:Fit padding:Inset{top:6}
                            pool_who_publish := mod.widgets.HagencyWideButton{text:action.label enabled:action.ready && !H.busy && H.command==nil draw_bg +: {color_disabled:mod.widgets.RINX_FIELD color_2_disabled:mod.widgets.RINX_FIELD} on_click:||A.who_submit()}
                        }
                        pool_who_note := mod.widgets.HagencyListNote{align:Align{x:0.5} text:action.note}
                    }}
                }}
            }}
            mod.widgets.HagencyListLabel{text:A.t("APPROVED AUTOMATICALLY","自动批准的项目")}
            if c==nil && H.busy {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:170 height:14}}}}
            if c==nil && !H.busy {mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load these projects","暂时无法读取这些项目")}
                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(H.ux.errorCode)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    pool_who_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.pool_who_load(nil)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if c!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let {items=[]}=c
                mod.widgets.HagencyList{
                    if items.len()==0 {mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.projects draw_icon.color:mod.widgets.RINX_MUTED}}
                        mod.widgets.HagencyWrapSubtitle{text:A.t("None yet.","还没有。")}
                    }}
                    for index row in items {View{width:Fill height:Fit flow:Down
                        let {displayName=nil}=row
                        if index>0 {mod.widgets.HagencyListDivider{}}
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.projects draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{max_lines:1 text_overflow:Ellipsis text:if displayName==nil {A.t("Unnamed project","未命名的项目")} else {displayName}}
                                if displayName==nil {mod.widgets.HagencyListSubtitle{max_lines:1 text_overflow:Ellipsis text:row.projectRoomId}}
                            }
                            web_trust_remove := mod.widgets.HagencyGetDanger{text:A.t("Remove","移除") enabled:A.web_can_edit() on_click: || A.web_prepare({operation:"trust_remove" projectRoomId:row.projectRoomId})}
                        }
                    }}
                    if c.nextAfter!=nil {View{width:Fill height:Fit flow:Down
                        mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                        mod.widgets.HagencyListRow{
                            web_trust_more := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.pool_who_load(c.nextAfter)}
                            mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More","显示更多")}}
                        }
                    }}
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        web_trust_open := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || {H.who.trustOpen=!H.who.trustOpen A.redraw()}}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.add}}
                            mod.widgets.HagencyAccentText{text:A.t("Add a Project…","添加项目…")}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if who.trustOpen {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if who.trustOpen {View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:4 bottom:14}
                        mod.widgets.HagencyListSubtitle{text:A.t("Project room ID","项目房间 ID")}
                        web_trust_room := mod.widgets.HagencyInput{width:Fill empty_text:"!abc123:example.org" text:w.trustRoom on_change:|s|{w.trustRoom=s ui.web_trust_add.set_enabled(A.who_room_ok(s) && A.web_can_edit()) ui.web_trust_hint.set_text(A.who_room_hint()) ui.web_trust_hint.set_visible(A.who_room_bad()=="") ui.web_trust_error.set_text(A.who_room_bad()) ui.web_trust_error.set_visible(A.who_room_bad()!="")}}
                        web_trust_hint := mod.widgets.HagencyWrapSubtitle{visible:A.who_room_bad()=="" text:A.who_room_hint()}
                        web_trust_error := mod.widgets.HagencyWrapSubtitle{visible:A.who_room_bad()!="" text:A.who_room_bad() draw_text.color:mod.widgets.RINX_DANGER_FG}
                        mod.widgets.HagencyListSubtitle{text:A.t("Name (optional)","名称（可选）")}
                        web_trust_name := mod.widgets.HagencyInput{width:Fill empty_text:A.t("For example: Research","例如：Research") text:w.trustName on_change:|s|{w.trustName=s}}
                        View{width:Fill height:Fit flow:Right align:Align{x:1.0}
                            web_trust_add := mod.widgets.HagencyGetButton{text:A.t("Add","添加") enabled:A.who_room_ok(w.trustRoom) && A.web_can_edit() on_click: || A.web_trust_add()}
                        }
                    }}
                }
                mod.widgets.HagencyListNote{text:A.t("Agents from these projects are approved without asking you. The person asking must still be on the list above.","这些项目里的 Agent 申请时不再问你；申请的人仍要在上面的名单里。")}
            }}
        }}}
        if H.page=="pool_advanced" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let detail=if H.resource_detail!=nil && H.resource_detail.resource.id==H.pool_sub_rid {H.resource_detail} else {nil}
            mod.widgets.HagencyLargeTitle{text:A.t("Advanced Settings","高级设置")}
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.sub_pool_name(H.pool_sub_rid)}
            if detail==nil {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                mod.widgets.HagencyWrapTitle{text:A.t("Open the pool again to see these settings.","请重新打开资源池查看这些设置。")}
            }}}
            if detail!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let row=detail.resource
                let v=A.pool_view(detail)
                let locked=A.alert_kind()!=""
                mod.widgets.HagencyListLabel{text:A.t("CATALOGUE (OPTIONAL)","对外展示（可选）")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyFitRow{
                        mod.widgets.HagencyRowBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.globe}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{text:A.t("Show in the catalogue","在目录中列出")}
                                mod.widgets.HagencyWrapSubtitle{text:if row.published {A.t("Listed · the model and monthly maximum are locked","已列出 · 模型和每月上限已锁定")} else {A.t("Listing locks the model and monthly maximum","列出后，模型和每月上限不能修改")}}
                            }
                            resource_publish_switch := mod.widgets.HagencySwitch{draw_bg.selected:if row.published {1.0} else {0.0} enabled:!H.busy && H.command==nil && !locked}
                        }
                        resource_publish_review := mod.widgets.HagencyRowCover{enabled:!H.busy && H.command==nil && !locked on_click:||{H.web.publicationReview=true A.redraw()}}
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencyFitRow{
                        mod.widgets.HagencyRowBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.usage}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{text:A.t("Public Listing","对外展示")}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Shown only; it doesn’t limit use","只是展示，不限制用量")}
                            }
                            mod.widgets.HagencyChevron{}
                        }
                        resource_web_settings := mod.widgets.HagencyRowCover{enabled:!H.busy && !locked on_click:||A.open_web_catalog(row.id,"settings",nil)}
                    }
                }
                mod.widgets.HagencyListNote{text:A.t("The catalogue is the list of pools everyone on the server can browse. Listing is optional; people on your list can request either way.","目录是服务器上所有人都能浏览的资源池列表。列不列出都可以；名单里的人照样能申请。")}
                mod.widgets.HagencyListLabel{text:A.t("AGENTS","Agent")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        resource_templates := mod.widgets.HagencyListTap{enabled:!H.busy && !locked on_click:||A.open_templates(row.id,nil)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.file}}
                            mod.widgets.HagencyListTitle{text:A.t("Agent templates","Agent 模板")}
                            mod.widgets.HagencyChevron{}
                        }
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencyListRow{
                        resource_bindings_open := mod.widgets.HagencyListTap{enabled:!H.busy && !locked on_click:||A.open_bindings(row.id,"")}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.chat}}
                            mod.widgets.HagencyListTitle{text:A.t("Approval rooms","审批聊天")}
                            mod.widgets.HagencyChevron{}
                        }
                    }
                }
                mod.widgets.HagencyListLabel{text:A.t("DETAILS","详细信息")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        pool_advanced_server := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil && !locked on_click:||A.resource_connection(row)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.connection}}
                            mod.widgets.HagencyListTitle{text:A.t("Server and publishing","服务器与发布")}
                            mod.widgets.HagencyListValue{text:A.pool_server_text(v)}
                            mod.widgets.HagencyChevron{}
                        }
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencyListRow{
                        resource_id_details := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle("pool_ids/"+row.id)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info}}
                            mod.widgets.HagencyListSubtitle{text:A.t("IDs for your administrator","给管理员看的编号")}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.details_open=="pool_ids/"+row.id {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if H.details_open=="pool_ids/"+row.id {View{width:Fill height:Fit flow:Down spacing:2 padding:Inset{left:57 right:14 top:2 bottom:12}
                        mod.widgets.HagencyListSubtitle{text:A.t("Resource ID · select to copy","资源标识 · 可选中复制")}
                        resource_id_text := mod.widgets.HagencyCopyText{text:row.id}
                    }}
                }
                View{width:Fill height:Fit padding:Inset{top:12} mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    pool_advanced_delete := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil && !locked && A.pool_adv_can_delete() on_click:||A.pool_adv_delete()}
                    View{width:Fill height:Fill align:Align{x:0.5 y:0.5} mod.widgets.HagencyDangerText{text:A.t("Delete This Pool…","删除这个资源池…") draw_text.color:if A.pool_adv_can_delete() {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_MUTED}}}
                }}}
                pool_advanced_delete_note := mod.widgets.HagencyListNote{text:A.pool_adv_delete_note()}
            }}
        }}}
        if H.page=="pool_glossary" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            mod.widgets.HagencyLargeTitle{text:A.t("What These Words Mean","这些词是什么意思？")}
            mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.t("Words you’ll see on the Resource Pools tab.","「资源池」页面上会看到的词。")}
            for group in ["capacity","publish","device"] {let key=group View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:if key=="capacity" {A.t("CAPACITY","额度")} else if key=="publish" {A.t("PUBLISHING AND REQUESTS","发布与申请")} else {A.t("STATUS AND THIS DEVICE","状态与设备")}}
                mod.widgets.HagencyList{for index item in A.pool_glossary(key) {View{width:Fill height:Fit flow:Down
                    if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:16}}}
                    View{width:Fill height:Fit flow:Down spacing:4 padding:Inset{left:16 right:16 top:11 bottom:11}
                        pool_glossary_term := mod.widgets.HagencyWrapTitle{draw_text +: {text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE}} text:item.term}
                        mod.widgets.HagencyWrapSubtitle{text:item.text}
                    }
                }}}
            }}
        }}}
        if H.page=="resource_edit" && H.resource_edit_draft!=nil && H.resource_detail!=nil {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let d=H.resource_edit_draft let detail=H.resource_detail
            let eb=A.pool_budget(detail.resource)

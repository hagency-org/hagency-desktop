                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show more","显示更多")}}
                    }
                }}
            }
            mod.widgets.HagencyListNote{text:A.t("Run on your own device with your own model account. Project Agents are under My Agents.","在你自己的设备上运行，使用你自己的模型账号。项目 Agent 在「我的 Agent」中。")}
        }}
        if H.page == "personal_agent" {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:18 bottom:28}
            if H.personal_detail == nil && H.busy {View{width:Fill height:Fit flow:Down spacing:6
                View{width:Fill height:Fit flow:Down spacing:12 align:Align{x:0.5} padding:Inset{top:6 bottom:14}
                    mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_FIELD}
                    mod.widgets.HagencySkeleton{width:120 height:24}
                    mod.widgets.HagencySkeleton{width:80 height:18}
                }
                for i in [0,1] {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:" "}
                    mod.widgets.HagencyList{for j in [0,1,2] {View{width:Fill height:Fit flow:Down
                        if j>0 {mod.widgets.HagencyListDivider{}}
                        mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:140 height:14}}
                    }}}
                }}
            }}
            if H.personal_detail == nil && !H.busy {mod.widgets.HagencyList{mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("Couldn’t load this Agent. Use refresh at the top to try again.", "暂时无法读取此 Agent，请点右上角刷新重试。")}}}}}
            if H.personal_detail != nil {View{width:Fill height:Fit flow:Down spacing:6
                let row=H.personal_detail.agent
                let s=H.personal_detail.settings
                let o=s.observation
                let st=H.local_status
                let state=if !s.online {"offline"} else if st!=nil {st.service.state} else if H.local_error=="status_unavailable" {"unknown"} else {""}
                let alert=H.local_discard!="" || H.local_confirm=="encrypt"
                let service_pending=H.local_pending=="hagency.personal_agents.service"
                let service_silent=H.local_error=="local_no_response_stop" || H.local_error=="local_no_response_start"
                let chat=if st==nil {nil} else {st.chat}
                let encrypted=chat!=nil && chat.encrypted
                View{width:Fill height:Fit flow:Down spacing:6
                if H.personal_mode == "detail" {View{width:Fill height:Fit flow:Down spacing:6
                    View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                        mod.widgets.HagencyAvatar{mod.widgets.HagencyAvatarGlyph{}}
                        mod.widgets.HagencyHeroName{text:row.displayName}
                        mod.widgets.HagencyPill{draw_bg.color:A.local_tone_bg(state)
                            if !service_pending {mod.widgets.HagencyPillDot{draw_bg.color:A.local_tone_fg(state)}}
                            if service_pending {mod.widgets.HagencySpinner{width:12 height:12 draw_bg +: {color:A.local_tone_fg(state)}}}
                            mod.widgets.HagencyPillText{text:if service_pending {A.local_pending_text(state)} else {A.local_state_text(state)} draw_text.color:A.local_tone_fg(state)}
                        }
                        if st!=nil {View{width:Fit height:Fit padding:Inset{top:4}
                            local_chat := mod.widgets.HagencyCapsule{text:if chat==nil {A.t("Set Up Private Chat","建立私聊")} else {A.t("Message","发消息")} draw_icon.svg:mod.rinx_icons.chat enabled:!alert on_click: || A.local_open_chat()}
                        }}
                        if state=="stopped" {mod.widgets.HagencyHint{width:Fit text:A.t("It replies after its service starts.","服务启动后才会回复。")}}
                        if state=="offline" {mod.widgets.HagencyHint{width:Fit text:A.t("It replies when its device is back online.","设备上线后才会回复。")}}
                    }
                    if H.local_error != "" && !service_silent {mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_DANGER_BG
                        mod.widgets.HagencyCopy{text:A.local_reason(H.local_error) draw_text.color:mod.widgets.RINX_DANGER_FG}
                        local_retry := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("Retry","重试") enabled:!H.busy && !alert on_click: || A.open_personal_agent(H.personal_id)}
                    }}
                    if H.personal_result != nil {mod.widgets.HagencyStatus{mod.widgets.HagencyCopy{text:A.t("Saved. The device applies it shortly; refresh to see it.", "已保存。设备很快会应用，刷新即可看到。")}}}
                    if H.personal_observed != nil {mod.widgets.HagencyStatus{mod.widgets.HagencyCopy{text:A.t("Sync requested. Refresh in a moment to see the latest settings.", "已请求同步，稍后刷新即可看到最新设置。")}}}
                    if H.personal_config.result != nil {mod.widgets.HagencyStatus{mod.widgets.HagencyCopy{text:A.t("Request sent. The device applies it shortly; refresh to see it.", "请求已发送。设备很快会应用，刷新即可看到。")}}}

                    mod.widgets.HagencyListLabel{text:A.t("CONVERSATION","对话")}
                    mod.widgets.HagencyList{
                        if encrypted || st==nil || chat==nil {mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            mod.widgets.HagencyListTitle{text:A.t("End-to-end encryption","端到端加密")}
                            mod.widgets.HagencyListValue{text:if encrypted {A.t("On","已打开")} else if st==nil {A.t("Unknown","未知")} else {A.t("No private chat","未建立私聊")}}
                        }}
                        else {mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.t("End-to-end encryption","端到端加密")}
                                mod.widgets.HagencyListSubtitle{text:if H.local_pending=="hagency.personal_agents.chat.encrypt" {A.t("Turning on…","正在开启…")} else {A.t("Off","未打开")}}
                            }
                            local_encrypt := mod.widgets.HagencySwitch{draw_bg.selected:if H.local_pending=="hagency.personal_agents.chat.encrypt" {1.0} else {0.0}
                                enabled:H.local_pending=="" && !alert on_click: || {H.local_confirm="encrypt" A.redraw()}}
                        }}
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencyListRow{
                            local_rooms := mod.widgets.HagencyListTap{enabled:!H.busy && !alert on_click: || A.native_open_agent(H.personal_id)}
                            mod.widgets.HagencyListBody{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.people draw_icon.color:mod.widgets.RINX_INFO_FG}}
                                mod.widgets.HagencyListTitle{text:A.t("Rooms","房间")}
                                mod.widgets.HagencyListValue{text:if st==nil {""} else {""+st.rooms.len()}}
                                mod.widgets.HagencyChevron{}
                            }
                        }
                    }
                    mod.widgets.HagencyListNote{text:if st==nil {""} else if chat==nil {A.t("The private chat isn’t set up yet.","私聊尚未建立。")} else if encrypted {A.t("Only your devices and this Agent’s device can read the private chat.","只有你的设备和此 Agent 的设备能读取私聊内容。")} else {A.t("The private chat isn’t encrypted. Once on, only your devices and this Agent’s device can read it, and it can’t be turned off.","私聊目前未加密。开启后，只有你的设备和此 Agent 的设备能读取，且无法再关闭。")}}

                    mod.widgets.HagencyListLabel{text:A.t("SERVICE","运行")}
                    mod.widgets.HagencyList{
                        if st!=nil && st.here && s.online {mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.power draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.t("Service","服务")}
                                mod.widgets.HagencyListSubtitle{text:if service_pending {A.local_pending_text(state)} else {A.local_state_text(state)}}
                            }
                            if service_pending {mod.widgets.HagencySpinner{margin:Inset{right:10}}}
                            local_service := mod.widgets.HagencySwitch{draw_bg.selected:if A.local_running(state)!=service_pending {1.0} else {0.0} enabled:H.local_pending=="" && !alert on_click: || A.local_toggle_service()}
                        }}
                        else {mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.power draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            mod.widgets.HagencyListTitle{text:A.t("Service","服务")}
                            mod.widgets.HagencyListValue{text:A.local_state_text(state)}
                        }}
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencyListRow{
                            local_device := mod.widgets.HagencyListTap{enabled:!H.busy && !alert on_click: || A.native_open_agent(H.personal_id)}
                            mod.widgets.HagencyListBody{
                                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.device}}
                                mod.widgets.HagencyListTitle{text:A.t("Execution device","执行设备")}
                                mod.widgets.HagencyListValue{text:if st==nil {A.t("Unknown","未知")} else if st.here {A.t("This device","本机")} else if st.deviceName!="" {st.deviceName} else {A.t("Another device","其他设备")}}
                                mod.widgets.HagencyChevron{}
                            }
                        }
                    }
                    if service_silent {View{width:Fill height:Fit flow:Right align:Align{y:0.5} padding:Inset{left:7}
                        mod.widgets.HagencyListNote{width:Fill text:A.local_reason(H.local_error) draw_text.color:mod.widgets.RINX_DANGER_FG}
                        local_service_retry := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("Retry","重试") enabled:!H.busy && !alert on_click: || A.open_personal_agent(H.personal_id)}
                    }}
                    if !s.online {mod.widgets.HagencyListNote{text:A.t("You can start it or change settings once the execution device is online.","执行设备上线后才能启动或修改设置。")}}
                    if s.online && st!=nil && !st.here {mod.widgets.HagencyListNote{text:A.t("It can only be started or stopped on its execution device.","只能在执行设备上启动或停止。")}}

                    if !s.supported {mod.widgets.HagencyListNote{text:A.personal_reason("configuration_unsupported")}}
                    if s.supported && o == nil {View{width:Fill height:Fit flow:Down spacing:6
                        mod.widgets.HagencyListLabel{text:A.t("MODEL AND LIMITS","模型与额度")}
                        mod.widgets.HagencyList{mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("The device hasn’t reported its settings yet. Sync below.","设备尚未上报设置，请在下方同步。")}}}}
                    }}
                    if s.supported && o != nil {View{width:Fill height:Fit flow:Down spacing:6
                        mod.widgets.HagencyListLabel{text:A.t("MODEL","模型")}
                        mod.widgets.HagencyList{
                            mod.widgets.HagencySwitchRow{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.cpu draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                                mod.widgets.HagencyListTitle{text:A.t("Model","模型")}
                                mod.widgets.HagencyListValue{text:if o.model == nil {A.t("Not set","未设置")} else {A.local_model_name(o.model.model)}}
                            }
                            if o.model != nil {View{width:Fill height:Fit flow:Down
                                mod.widgets.HagencyListDivider{}
                                mod.widgets.HagencySwitchRow{
                                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.bulb draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                                    mod.widgets.HagencyListTitle{text:A.t("Reasoning","推理强度")}
                                    mod.widgets.HagencyListValue{text:A.reasoning_label(o.model.reasoningEffort)}
                                }
                                mod.widgets.HagencyListDivider{}
                                mod.widgets.HagencySwitchRow{
                                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.globe draw_icon.color:mod.widgets.RINX_INFO_FG}}
                                    mod.widgets.HagencyListTitle{text:A.t("Web search","网页搜索")}
                                    mod.widgets.HagencyListValue{text:A.local_on(o.model.webSearch)}
                                }
                                mod.widgets.HagencyListDivider{}
                                mod.widgets.HagencySwitchRow{
                                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.folder}}
                                    mod.widgets.HagencyListTitle{text:A.t("Workspace","工作区")}
                                    mod.widgets.HagencyListValue{text:if o.model.workspaceConfigured {A.t("Custom folder","自定义目录")} else {A.t("Default folder","默认目录")}}
                                }
                            }}
                            mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                            mod.widgets.HagencyListRow{
                                personal_model_edit := mod.widgets.HagencyListTap{enabled:A.personal_can_edit() && !alert on_click: || A.open_personal_model()}
                                mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Change Model and Workspace","更改模型与工作区") draw_text.color:if A.personal_can_edit() {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}}
                            }
                        }

                        if !s.online {mod.widgets.HagencyListNote{text:A.t("The device is offline. These settings were synced ","设备离线，显示的是 ")+if s.observedAtLocal==nil {"—"} else {s.observedAtLocal}+A.t("; change them once it’s back online.", " 同步的设置，上线后才能更改。")}}
                        mod.widgets.HagencyListLabel{text:A.t("LIMITS AND APPROVALS","额度与审批")}
                        mod.widgets.HagencyList{
                            View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:11 bottom:12}
                                View{width:Fill height:Fit flow:Right spacing:12 align:Align{y:0.5}
                                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.usage draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                                    mod.widgets.HagencyListTitle{text:A.t("Used","已用")}
                                    mod.widgets.HagencyListValue{text:A.local_tokens(o.knownConsumedTokens)+if o.budget.kind=="tokens" {" / "+A.local_tokens(o.budget.tokens)} else {""}+A.t(" tokens"," token")}
                                }
                                if o.budget.kind=="tokens" {View{width:Fill height:Fit padding:Inset{left:41} mod.widgets.HagencyProgress{value:A.progress_ratio(o.knownConsumedTokens,o.budget.tokens) draw_bg +: {track_color:#x7f8b9c}}}}
                            }
                            mod.widgets.HagencyListDivider{}
                            mod.widgets.HagencySwitchRow{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.gauge draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                                mod.widgets.HagencyListTitle{text:A.t("Budget","额度")}
                                mod.widgets.HagencyListValue{text:A.local_budget_text(o)}
                            }
                            mod.widgets.HagencyListDivider{}
                            mod.widgets.HagencySwitchRow{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.shield draw_icon.color:mod.widgets.RINX_INFO_FG}}
                                mod.widgets.HagencyListTitle{text:A.t("Model requests","模型请求")}
                                mod.widgets.HagencyListValue{text:A.local_mode(o.requests)}
                            }
                            mod.widgets.HagencyListDivider{}
                            mod.widgets.HagencySwitchRow{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                                mod.widgets.HagencyListTitle{text:A.t("High-risk tools","高风险工具")}
                                mod.widgets.HagencyListValue{text:A.local_mode(o.highRiskTools)}
                            }
                            mod.widgets.HagencyListDivider{}
                            mod.widgets.HagencyListRow{
                                personal_rules := mod.widgets.HagencyListTap{enabled:A.personal_can_edit() && !alert on_click: || A.submit_personal_native("hagency.personal_agents.rules.edit")}
                                mod.widgets.HagencyListBody{
                                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.adjust}}
                                    mod.widgets.HagencyListTitle{text:A.t("Tool and Folder Rules","工具与目录规则")}
                                    mod.widgets.HagencyListValue{text:if o.highRiskTools == "rules" {""+o.toolRuleCount+" / "+o.directoryRuleCount} else {A.t("None","无")}}
                                    mod.widgets.HagencyChevron{}
                                }
                            }
                            mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                            mod.widgets.HagencyListRow{
                                personal_edit := mod.widgets.HagencyListTap{enabled:A.personal_can_edit() && !alert on_click: || A.edit_personal_policy()}
                                mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Change Limits and Approvals","更改额度与审批") draw_text.color:if A.personal_can_edit() {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}}
                            }
                        }
                        mod.widgets.HagencyListNote{text:A.t("Usage counts against this Agent’s own model account, not a project pool.","用量计入此 Agent 自己的模型账号，不占用项目资源池。")}
                    }}

                    mod.widgets.HagencyListLabel{text:A.t("DEVICE SYNC","设备同步")}
                    mod.widgets.HagencyList{
                        mod.widgets.HagencyListRow{
                            personal_observe := mod.widgets.HagencyListTap{enabled:A.personal_can_observe() && !alert on_click: || A.review_personal_observation()}
                            mod.widgets.HagencyListBody{
                                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.sync draw_icon.color:if A.personal_can_observe() {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}}
                                mod.widgets.HagencyAccentText{text:A.t("Sync Settings Now","立即同步设置") draw_text.color:if A.personal_can_observe() {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}
                            }
                        }
                    }
                    mod.widgets.HagencyListNote{text:if s.observedAtLocal == nil {A.t("Not synced yet.","尚未同步。")} else {A.t("Last synced ","上次同步：")+s.observedAtLocal}}

                    View{width:Fill height:Fit padding:Inset{top:18}
                        mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                            local_retire := mod.widgets.HagencyListTap{enabled:!H.busy && !alert on_click: || {H.local_confirm="retire" A.redraw()}}
                            View{width:Fill height:Fill align:Align{x:0.5 y:0.5} mod.widgets.HagencyDangerText{text:A.t("Retire Agent…","停用 Agent…")}}
                        }}
                    }
                    mod.widgets.HagencyListNote{text:A.t("A retired Agent permanently stops serving every room.","停用后，此 Agent 将永久停止在所有房间中的服务。")}
                }}

                else if H.personal_mode == "observe_review" && H.personal_draft != nil {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:6}
                    mod.widgets.HagencyList{View{width:Fill height:Fit padding:14 mod.widgets.HagencyCopy{text:A.t("The execution device will report its current policy, model and usage. Nothing is changed or started.","执行设备将上报当前的策略、模型与用量，不会修改设置或启动 Agent。")}}}
                }}

                else if (H.personal_mode == "edit" || H.personal_mode == "review") && H.personal_draft != nil {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:6}
                    let d=H.personal_draft
                    if H.personal_mode == "edit" {View{width:Fill height:Fit flow:Down spacing:6
                        mod.widgets.HagencyListLabel{text:A.t("BUDGET","额度")}
                        mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:12 padding:14
                            mod.widgets.HagencySegments{for kind in ["unlimited","tokens"] {if d.kind == kind || (kind=="unlimited" && d.kind=="unset") {mod.widgets.HagencySegmentOn{text:A.local_budget_kind(kind) on_click: || {d.kind=kind A.redraw()}}} else {mod.widgets.HagencySegment{text:A.local_budget_kind(kind) on_click: || {d.kind=kind A.redraw()}}}}}
                            if d.kind == "tokens" {View{width:Fill height:Fit flow:Down spacing:12
                                View{width:Fill height:Fit personal_tokens := mod.widgets.HagencyNumberInput{slider_mode:false millions:A.t(true,false) wan:A.t(false,true) step:100000 minimum:0 input +: {draw_bg +: {color:mod.widgets.RINX_SURFACE color_hover:mod.widgets.RINX_SURFACE color_focus:mod.widgets.RINX_SURFACE border_size:1.0 border_color:#7f8b9c border_color_2:#7f8b9c}} text:d.tokens empty_text:A.t("Limit in millions","上限（万 token）") on_change: |v| {d.tokens=v}}}
                                mod.widgets.HagencyListSubtitle{text:A.t("Resets","重置周期")}
                                mod.widgets.HagencySegments{for period in ["lifetime","utc_day","utc_month"] {if d.period == period {mod.widgets.HagencySegmentOn{text:A.local_period(period) on_click: || {d.period=period A.redraw()}}} else {mod.widgets.HagencySegment{text:A.local_period(period) on_click: || {d.period=period A.redraw()}}}}}
                            }}
                        }}
                        mod.widgets.HagencyListNote{text:if d.kind != "tokens" {A.t("This Agent can use your model account without a limit.","此 Agent 可不限量地使用你的模型账号。")} else if d.period == "lifetime" {A.t("The limit never resets.","额度不会自动重置。")} else if d.period == "utc_day" {A.t("Resets every day at ","每天 ")+A.local_reset_time()+A.t("."," 重置。")} else {A.t("Resets on the 1st of every month at ","每月 1 日 ")+A.local_reset_time()+A.t("."," 重置。")}}
                        mod.widgets.HagencyListLabel{text:A.t("MODEL REQUESTS","模型请求")}
                        mod.widgets.HagencyList{View{width:Fill height:Fit padding:14
                            mod.widgets.HagencySegments{for mode in ["allow","ask_owner","deny"] {if d.requests == mode {mod.widgets.HagencySegmentOn{text:A.local_mode(mode) on_click: || {d.requests=mode A.redraw()}}} else {mod.widgets.HagencySegment{text:A.local_mode(mode) on_click: || {d.requests=mode A.redraw()}}}}}
                        }}
                        mod.widgets.HagencyListNote{text:A.t("What the Agent does when a message needs a model call.","Agent 收到消息、需要调用模型时如何处理。")}
                        mod.widgets.HagencyListLabel{text:A.t("HIGH-RISK TOOLS","高风险工具")}
                        mod.widgets.HagencyList{View{width:Fill height:Fit padding:14
                            mod.widgets.HagencySegments{for risk in ["ask_owner","deny"] {if d.highRiskTools == risk {mod.widgets.HagencySegmentOn{text:A.local_mode(risk) on_click: || {d.highRiskTools=risk A.redraw()}}} else {mod.widgets.HagencySegment{text:A.local_mode(risk) on_click: || {d.highRiskTools=risk A.redraw()}}}}}
                        }}
                        mod.widgets.HagencyListNote{text:if d.replacesRules {A.t("Saving replaces the current custom tool and folder rules.","保存后将替换当前的自定义工具与目录规则。")} else {A.t("Tools that write files or run commands.","会写入文件或执行命令的工具。")}}
                    }}
                    if H.personal_mode == "review" {View{width:Fill height:Fit flow:Down spacing:6
                        let changes=A.local_policy_changes()
                        if H.local_rechecked {View{width:Fill height:Fit padding:Inset{bottom:10} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_INFO_BG
                            mod.widgets.HagencyCopy{text:A.t("Loaded the latest settings from the execution device. Review your changes again.","已载入执行设备上的最新设置，请再核对一次。") draw_text.color:mod.widgets.RINX_INFO_FG}
                        }}}
                        mod.widgets.HagencyListLabel{text:A.t("CHANGES TO SAVE","将保存以下修改")}
                        mod.widgets.HagencyList{
                            if changes.len()==0 {mod.widgets.HagencyListRow{mod.widgets.HagencyListBody{mod.widgets.HagencyListValue{text:A.t("Nothing has changed.","没有需要保存的修改。")}}}}
                            for index c in changes {View{width:Fill height:Fit flow:Down
                                if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:14}}}
                                mod.widgets.HagencyListTall{mod.widgets.HagencyListBody{mod.widgets.HagencyListText{
                                    mod.widgets.HagencyListTitle{text:c.label}
                                    mod.widgets.HagencyListSubtitle{text:c.before+"  →  "+c.after}
                                }}}
                            }}
                        }
                        mod.widgets.HagencyListNote{text:if d.replacesRules {A.t("This also replaces the current custom tool and folder rules. If the settings on the execution device change meanwhile, this save won’t apply.","这也会替换当前的自定义工具与目录规则。如果执行设备上的设置在此期间被修改，本次保存不会生效。")} else {A.t("If the settings on the execution device change meanwhile, this save won’t apply and you’ll need to review again.","如果执行设备上的设置在此期间被修改，本次保存不会生效，需要重新核对。")}}
                    }}
                }}
                }
            }}
        }}
        if H.page == "projects" && A.projects_enabled() {
            View{width:Fill height:Fit spacing:12 align:Align{y:0.5}
                mod.widgets.HagencyTitle{text:A.t("Projects", "项目")}
                new_project := mod.widgets.HagencyIconButton{draw_icon.svg:mod.rinx_icons.add on_click: || A.new_project()}
            }
            mod.widgets.HagencyHint{text:A.t("Track your requests and projects you coordinate. Only the server administrator can approve a new project.", "查看你的申请及你参与协调的项目，只有服务器管理员可以批准新项目。")}
            mod.widgets.HagencyActions{matrix_workspaces := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Matrix workspaces · Rooms and members","Matrix 工作区 · 房间与成员") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.native_open("matrix_workspaces")}}
            if H.project_draft.resource != nil {continue_project := mod.widgets.HagencyButton{text:A.t("Continue saved draft", "继续已保存的草稿") on_click: || A.begin_project()}}
            if H.projects.len() == 0 {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Your next project starts here", "从这里发起下一个项目")}
                mod.widgets.HagencyCopy{text:A.t("Select a resource, describe your project and send it for review.", "选择资源、说明项目需求，再提交审核。")}
                request_project := mod.widgets.RinxKeyPrimaryButton{text:A.t("Request a project", "申请项目") icon_walk:Walk{width:18 height:18} draw_icon.svg:mod.rinx_icons.add on_click: || A.begin_project()}
            }}
            for row in H.projects {mod.widgets.HagencyCard{
                mod.widgets.HagencyCopy{text:row.name}
                mod.widgets.HagencyHint{text:A.project_state_text(row.state)}
                mod.widgets.HagencyHint{text:row.resourceLabel + " · " + A.tokens(row.requestedTokens) + A.t(" tokens/month requested", " token/月申请额度")}
                mod.widgets.HagencyHint{text:A.t("Project manager", "项目经理") + " · " + row.managerMxid}
                if row.allocationStatus == "resource_unavailable" {mod.widgets.HagencyHint{text:A.t("The selected resource is no longer available.", "所选资源已不可用。")}}
                else if row.state == "approved" {mod.widgets.HagencyHint{text:A.t("Open progress for current allocation, workspace and agent status.","打开进度，查看最新分配、工作区与 Agent 状态。")}}
                open_project := mod.widgets.HagencyButton{text:A.t("View project request", "查看项目申请") on_click: || A.open_project(row.id)}
            }}
            if H.project_after != nil {more := mod.widgets.HagencyButton{text:A.t("Next page", "下一页") on_click: || A.more()}}
        }
        if H.page=="projects" && !A.projects_enabled() {mod.widgets.HagencyCard{
            mod.widgets.HagencyTitle{text:A.t("Matrix workspaces","Matrix 工作区")}
            mod.widgets.HagencyCopy{text:A.t("Manage Matrix Spaces, rooms and members here. Request Agents directly from resource pools.","在这里管理 Matrix Space、房间与成员。Agent 可直接从资源池申请。")}
            matrix_workspaces := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Open workspaces","打开工作区") on_click:||A.native_open("matrix_workspaces")}
        }}
        if H.page=="agent_home" {
            mod.widgets.HagencyTitle{text:A.t("Agents","Agent")}
            mod.widgets.HagencyHint{text:A.t("Project agents use approved shared capacity. Personal and local agents keep their own settings.","项目 Agent 使用已批准的共享容量，个人与本地 Agent 使用各自的设置。")}
            mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.projects}} mod.widgets.HagencySectionTitle{text:A.t("Project agents","项目 Agent")}}
                mod.widgets.HagencyHint{text:A.t("Choose a project you manage to define and approve its agents.","选择你管理的项目，定义并批准项目 Agent。")}
                mod.widgets.HagencyActions{agents_choose_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Choose a project","选择项目") on_click:||A.navigate("projects")}}
                if A.agents_enabled(){View{width:Fill height:Fit flow:Down spacing:8
                    for row in H.agents {mod.widgets.HagencyRow{

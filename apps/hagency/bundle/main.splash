                                    mod.widgets.HagencyWrapSubtitle{text:A.t("From ","从 ")+A.tokens(v.publishedTokens)+A.t(" to "," 调到 ")+A.tokens(A.pool_offer_quota(v))+A.t("; it applies this month once you confirm.","，确认后本月立即生效。")}

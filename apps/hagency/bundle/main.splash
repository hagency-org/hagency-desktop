            mod.widgets.HagencyActions{
                personal_back := mod.widgets.HagencyButton{text:A.t("Personal agents", "个人 Agent") enabled:!H.busy draw_icon.svg:mod.rinx_icons.back icon_walk:Walk{width:16 height:16} on_click: || A.open_personal_agents(H.personal_after,H.personal_page)}
                personal_reload := mod.widgets.HagencyButton{text:A.t("Refresh", "刷新") enabled:!H.busy draw_icon.svg:mod.rinx_icons.refresh icon_walk:Walk{width:16 height:16} on_click: || A.open_personal_agent(H.personal_id)}
            }
            if H.personal_config.result != nil {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Settings request recorded","已记录设置请求")}
                mod.widgets.HagencyCopy{text:A.t("The original request completed. Read current settings to obtain the execution device’s updated configuration.","原始请求已完成，请读取当前设置以获取执行设备更新后的配置。")}
            }}
            if H.personal_result != nil {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Policy change recorded", "已记录策略修改")}
                mod.widgets.HagencyCopy{text:A.t("Saved revision: ", "已保存版本：") + H.personal_result.policyRevision}
                mod.widgets.HagencyHint{text:A.t("This confirms the original request. Use Read current settings to obtain the device’s updated policy.", "这里确认原始请求已完成。请使用“读取当前设置”获取设备更新后的策略。")}
            }}
            if H.personal_observed != nil {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Device observation recorded", "设备观测已记录")}
                mod.widgets.HagencyCopy{text:A.t("The original read request completed. The timestamp below identifies the latest available observation.", "原始读取请求已完成，下方时间表示最近可用的观测。")}
            }}
            if H.personal_detail == nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading device settings…", "正在读取设备设置…")} else {A.t("Refresh to read the current device observation.", "请刷新以读取当前设备观测。")}}}
            if H.personal_detail != nil {View{width:Fill height:Fit flow:Down spacing:16
                let row=H.personal_detail.agent
                let s=H.personal_detail.settings
                mod.widgets.HagencyTitle{text:row.displayName}
                mod.widgets.HagencyHint{text:row.id}
                if !s.supported {mod.widgets.HagencyCopy{text:A.personal_reason("configuration_unsupported")}}
                if s.supported {View{width:Fill height:Fit flow:Down spacing:16
                    mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Execution-device observation", "执行设备观测")}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Device", "设备")} mod.widgets.HagencyCopy{text:if row.executionDeviceId == nil {A.t("Not assigned", "未指定")} else {row.executionDeviceId}}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Connection", "连接")} mod.widgets.HagencyCopy{text:if s.online {A.t("Online at observation", "观测时在线")} else {A.t("Offline", "离线")}}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Observed at", "观测时间")} mod.widgets.HagencyCopy{text:if s.observedAtUtc == nil {A.t("Not observed", "尚无观测")} else {s.observedAtUtc}}}
                        if s.cached {mod.widgets.HagencyHint{text:A.t("Cached observation; this is not a live agent status.", "缓存观测，不代表 Agent 的实时运行状态。")}}
                        if s.observation == nil {mod.widgets.HagencyCopy{text:A.t("The execution device has not reported its policy yet.", "执行设备尚未上报策略。")}}
                        mod.widgets.HagencyHint{text:A.t("Refresh reads the saved observation. Read current settings asks the assigned device to report again.", "刷新仅查看已保存的观测；读取当前设置会请求指定设备重新上报。")}
                        if A.personal_can_observe() && H.personal_mode == "detail" {mod.widgets.HagencyActions{personal_observe := mod.widgets.HagencyButton{text:A.t("Read current settings", "读取当前设置") on_click: || A.review_personal_observation()}}}
                    }
                    if H.personal_mode == "observe_review" && H.personal_draft != nil {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Read settings from this device?", "从此设备读取设置？")}
                        mod.widgets.HagencyCopy{text:A.t("The assigned execution device will read policy, model and usage information. This does not change the policy, start an agent or allocate capacity. Credentials and paths stay native.", "指定执行设备将读取策略、模型和用量信息，不会修改策略、启动 Agent 或分配容量。凭据和路径保留在原生端。")}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Device", "设备")} mod.widgets.HagencyCopy{text:row.executionDeviceId}}
                        mod.widgets.HagencyActions{
                            personal_observe_cancel := mod.widgets.HagencyButton{text:A.t("Cancel", "取消") enabled:!H.busy on_click: || {H.personal_mode="detail" H.personal_draft=nil A.redraw()}}
                            personal_observe_submit := mod.widgets.RinxKeyPrimaryButton{text:A.t("Read current settings", "读取当前设置") enabled:!H.busy && H.command == nil on_click: || A.submit_personal_observation()}
                        }
                    }}
                    if s.observation != nil {View{width:Fill height:Fit flow:Down spacing:16
                        let o=s.observation
                        if H.personal_mode == "detail" {View{width:Fill height:Fit flow:Down spacing:16
                            mod.widgets.HagencySection{
                                mod.widgets.HagencySectionTitle{text:A.t("Budget and approvals", "预算与审批")}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Budget", "预算")} mod.widgets.HagencyCopy{text:if o.budget.kind == "tokens" {""+o.budget.tokens+" token"} else {A.personal_policy_mode(o.budget.kind)}}}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Period", "周期")} mod.widgets.HagencyCopy{text:A.personal_period(o.budget.period)}}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Requests", "请求")} mod.widgets.HagencyCopy{text:A.personal_policy_mode(o.requests)}}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("High-risk tools", "高风险工具")} mod.widgets.HagencyCopy{text:A.personal_policy_mode(o.highRiskTools)}}
                                if o.highRiskTools == "rules" {mod.widgets.HagencyHint{text:A.t("Custom tool / directory rules: ", "自定义工具 / 目录规则：") + o.toolRuleCount + " / " + o.directoryRuleCount}}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Consumed / held", "已消耗 / 已保留")} mod.widgets.HagencyCopy{text:""+o.knownConsumedTokens+" / "+o.heldTokens+" token"}}
                                mod.widgets.HagencyHint{text:A.t("These are observed personal-policy amounts, not shared project capacity or a provider quota.", "这是个人策略的观测数值，不是共享项目容量或服务商额度。")}
                                if A.personal_can_edit() {mod.widgets.HagencyActions{
                                    personal_edit := mod.widgets.HagencyButton{text:A.t("Edit policy", "编辑策略") on_click: || A.edit_personal_policy()}
                                    personal_rules := mod.widgets.HagencyButton{text:A.t("Custom tool rules","自定义工具规则") draw_icon.svg:mod.rinx_icons.device icon_walk:Walk{width:16 height:16} on_click: || A.submit_personal_native("hagency.personal_agents.rules.edit")}
                                }}
                            }
                            mod.widgets.HagencySection{
                                mod.widgets.HagencySectionTitle{text:A.t("Model and workspace", "模型与工作区")}
                                if o.model == nil {mod.widgets.HagencyCopy{text:A.t("No model observation", "暂无模型观测")}}
                                if o.model != nil {View{width:Fill height:Fit flow:Down spacing:10
                                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Model", "模型")} mod.widgets.HagencyCopy{text:o.model.model}}
                                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Reasoning", "推理强度")} mod.widgets.HagencyCopy{text:A.reasoning_label(o.model.reasoningEffort)}}
                                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Web search", "网页搜索")} mod.widgets.HagencyCopy{text:if o.model.webSearch {A.t("Enabled", "已启用")} else {A.t("Disabled", "已关闭")}}}
                                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Workspace", "工作区")} mod.widgets.HagencyCopy{text:if o.model.workspaceConfigured {A.t("Configured on execution device", "已在执行设备配置")} else {A.t("Not configured", "未配置")}}}
                                }}
                                mod.widgets.HagencyHint{text:A.t("Model choices come from the execution device. Folder selection and custom rules are reviewed in Hagency; credentials and paths stay native.","模型选项来自执行设备。目录选择与自定义规则在 Hagency 中核对，凭据和路径保留在原生端。")}
                                if A.personal_can_edit(){mod.widgets.HagencyActions{
                                    personal_model_edit := mod.widgets.HagencyButton{text:A.t("Edit model and workspace","编辑模型与工作区") draw_icon.svg:mod.rinx_icons.device icon_walk:Walk{width:16 height:16} on_click: || A.open_personal_model()}
                                    personal_workspace := mod.widgets.HagencyButton{text:A.t("Prepare workspace","准备工作区") on_click: || A.submit_personal_native("hagency.personal_agents.workspace.prepare")}
                                }}
                            }
                        }}
                        if (H.personal_mode == "edit" || H.personal_mode == "review") && H.personal_draft != nil {View{width:Fill height:Fit flow:Down spacing:16
                            let d=H.personal_draft
                            mod.widgets.HagencySectionTitle{text:if H.personal_mode == "review" {A.t("Review policy change", "核对策略修改")} else {A.t("Edit personal policy", "编辑个人策略")}}
                            mod.widgets.HagencyHint{text:A.t("Agent generation / policy revision: ", "Agent 代次 / 策略版本：") + d.expectedGeneration + " / " + d.expectedRevision}
                            if H.personal_mode == "edit" {View{width:Fill height:Fit flow:Down spacing:16
                                mod.widgets.HagencyFieldLabel{text:A.t("Budget mode", "预算模式")}
                                mod.widgets.HagencyActions{for kind in ["unset","unlimited","tokens"] {mod.widgets.HagencyChoice{text:A.personal_policy_mode(kind) draw_bg.color:if d.kind == kind {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} on_click: || {d.kind=kind A.redraw()}}}}
                                if d.kind == "tokens" {View{width:Fill height:Fit personal_tokens := mod.widgets.HagencyNumberInput{minimum:0 text:d.tokens empty_text:A.t("Nonnegative token limit", "非负整数 token 上限") on_change: |v| {d.tokens=v}}}}
                                mod.widgets.HagencyFieldLabel{text:A.t("Budget period", "预算周期")}
                                mod.widgets.HagencyActions{for period in ["lifetime","utc_day","utc_month"] {mod.widgets.HagencyChoice{text:A.personal_period(period) draw_bg.color:if d.period == period {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} on_click: || {d.period=period A.redraw()}}}}
                                mod.widgets.HagencyFieldLabel{text:A.t("Request approval", "请求审批")}
                                mod.widgets.HagencyActions{for mode in ["allow","deny","ask_owner"] {mod.widgets.HagencyChoice{text:A.personal_policy_mode(mode) draw_bg.color:if d.requests == mode {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} on_click: || {d.requests=mode A.redraw()}}}}
                                mod.widgets.HagencyFieldLabel{text:A.t("High-risk tools", "高风险工具")}
                                if d.replacesRules {mod.widgets.HagencyHint{text:A.t("Custom rules are currently configured. Saving requires an explicit choice below and replaces those rules; cancelling preserves them.", "当前已配置自定义规则。保存前须明确选择下方模式，这将替换现有规则；取消则保留规则。")}}
                                mod.widgets.HagencyActions{for risk in ["deny","ask_owner"] {mod.widgets.HagencyChoice{text:A.personal_policy_mode(risk) draw_bg.color:if d.highRiskTools == risk {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} on_click: || {d.highRiskTools=risk A.redraw()}}}}
                            }}
                            if H.personal_mode == "review" {mod.widgets.HagencySection{
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Budget", "预算")} mod.widgets.HagencyCopy{text:if d.kind == "tokens" {d.tokens.trim()+" token"} else {A.personal_policy_mode(d.kind)}}}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Period", "周期")} mod.widgets.HagencyCopy{text:A.personal_period(d.period)}}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Requests", "请求")} mod.widgets.HagencyCopy{text:A.personal_policy_mode(d.requests)}}
                                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("High-risk tools", "高风险工具")} mod.widgets.HagencyCopy{text:A.personal_policy_mode(d.highRiskTools)}}
                                if d.replacesRules {mod.widgets.HagencyCopy{text:A.t("This replaces the existing custom tool and directory rules.", "此修改将替换现有的自定义工具与目录规则。")}}
                                mod.widgets.HagencyHint{text:A.t("The execution device applies this only if the original policy revision still matches. This does not start an agent or allocate shared resources.", "执行设备仅在原策略版本仍匹配时应用修改，此操作不会启动 Agent 或分配共享资源。")}
                            }}
                            mod.widgets.HagencyActions{
                                personal_edit_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel", "取消") on_click: || {H.personal_mode="detail" H.personal_draft=nil A.redraw()}}
                                if H.personal_mode == "edit" {View{width:Fit height:Fit personal_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command == nil text:A.t("Review changes", "核对修改") on_click: || A.review_personal_policy()}}}
                                if H.personal_mode == "review" {View{width:Fit height:Fit personal_submit := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command == nil text:A.t("Save policy", "保存策略") on_click: || A.submit_personal_policy()}}}
                            }
                        }}
                    }}
                }}
            }}
        }}
        if H.page == "projects" && A.projects_enabled() {
            View{width:Fill height:Fit spacing:12 align:Align{y:0.5}
                mod.widgets.HagencyTitle{text:A.t("Projects", "项目")}
                new_project := mod.widgets.HagencyIconButton{draw_icon.svg:mod.rinx_icons.add on_click: || A.new_project()}
            }
            mod.widgets.HagencyHint{text:A.t("Track your requests and projects you coordinate. Only the server administrator can approve a new project.", "查看你的申请及你参与协调的项目，只有服务器管理员可以批准新项目。")}
            mod.widgets.HagencyActions{matrix_workspaces := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Matrix workspaces · Rooms and members","Matrix 工作区 · 房间与成员") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.native_open("matrix_workspaces")}}
            if H.project_draft.resource != nil {continue_project := mod.widgets.HagencyButton{text:A.t("Continue saved draft", "继续已保存的草稿") on_click: || A.begin_project()}}
            if H.projects.len() == 0 {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Your next project starts here", "从这里发起下一个项目")}
                mod.widgets.HagencyCopy{text:A.t("Select a resource, describe your project and send it for review.", "选择资源、说明项目需求，再提交审核。")}
                request_project := mod.widgets.RinxKeyPrimaryButton{text:A.t("Request a project", "申请项目") icon_walk:Walk{width:18 height:18} draw_icon.svg:mod.rinx_icons.add on_click: || A.begin_project()}
            }}
            for row in H.projects {mod.widgets.HagencyCard{
                mod.widgets.HagencyCopy{text:row.name}
                mod.widgets.HagencyHint{text:A.project_state_text(row.state)}
                mod.widgets.HagencyHint{text:row.resourceLabel + " · " + A.amount(row.requestedTokens) + A.t(" tokens/month requested", " token/月申请额度")}
                mod.widgets.HagencyHint{text:A.t("Project manager", "项目经理") + " · " + row.managerMxid}
                if row.allocationStatus == "resource_unavailable" {mod.widgets.HagencyHint{text:A.t("The selected resource is no longer available.", "所选资源已不可用。")}}
                else if row.state == "approved" {mod.widgets.HagencyHint{text:A.t("Open progress for current allocation, workspace and agent status.","打开进度，查看最新分配、工作区与 Agent 状态。")}}
                open_project := mod.widgets.HagencyButton{text:A.t("View project request", "查看项目申请") on_click: || A.open_project(row.id)}
            }}
            if H.project_after != nil {more := mod.widgets.HagencyButton{text:A.t("Next page", "下一页") on_click: || A.more()}}
        }
        if H.page=="projects" && !A.projects_enabled() {mod.widgets.HagencyCard{
            mod.widgets.HagencyTitle{text:A.t("Matrix workspaces","Matrix 工作区")}
            mod.widgets.HagencyCopy{text:A.t("Project capacity requests are not enabled on this server. You can still manage Matrix rooms and membership.","此服务器尚未启用项目容量申请，仍可管理 Matrix 房间与成员。")}
            matrix_workspaces := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Open workspaces","打开工作区") on_click:||A.native_open("matrix_workspaces")}
        }}
        if H.page=="agent_home" {
            mod.widgets.HagencyTitle{text:A.t("Agents","Agent")}
            mod.widgets.HagencyHint{text:A.t("Project agents use approved shared capacity. Personal and local agents keep their own settings.","项目 Agent 使用已批准的共享容量，个人与本地 Agent 使用各自的设置。")}
            mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.projects}} mod.widgets.HagencySectionTitle{text:A.t("Project agents","项目 Agent")}}
                mod.widgets.HagencyHint{text:A.t("Choose a project you manage to define and approve its agents.","选择你管理的项目，定义并批准项目 Agent。")}
                mod.widgets.HagencyActions{agents_choose_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Choose a project","选择项目") on_click:||A.navigate("projects")}}
                if A.agents_enabled(){View{width:Fill height:Fit flow:Down spacing:8
                    for row in H.agents {mod.widgets.HagencyRow{
                        let {projectName=nil}=row
                        View{width:Fill height:Fit flow:Down spacing:4
                            mod.widgets.HagencySectionTitle{text:row.definition.name}
                            mod.widgets.HagencyHint{text:if projectName!=nil{projectName+" · "+A.agent_state_text(row.state)}else{A.agent_state_text(row.state)}}
                        }
                        agent_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View agent","查看 Agent") on_click:||A.open_agent(row.id)}
                    }}
                    if H.agents.len()==0{mod.widgets.HagencyHint{text:A.t("No project-agent requests in this view.","当前视图暂无项目 Agent 申请。")}}
                    if H.agent_after!=nil{View{width:Fit height:Fit agent_home_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More agents","更多 Agent") on_click:||A.request("hagency.agents.list",{after:H.agent_after needsMyAction:false},fn(v){H.agents=v.items H.agent_after=v.nextAfter})}}}
                }}
            }
            mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:A.t("Personal agents","个人 Agent")}
                mod.widgets.HagencyHint{text:A.t("Budgets, models, workspace and approval preferences for your own agents.","管理个人 Agent 的预算、模型、工作区与审批偏好。")}
                overview_personal := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Personal-agent settings","个人 Agent 设置") on_click:||A.open_personal_agents(nil,1)}
            }
            mod.widgets.HagencyRow{
                View{width:Fill height:Fit flow:Down spacing:4
                    mod.widgets.HagencySectionTitle{text:A.t("Local agents","本地 Agent")}
                    mod.widgets.HagencyHint{text:A.t("Create local agent definitions and connect their devices and Matrix rooms.","创建本地 Agent 定义，并连接设备与 Matrix 房间。")}
                }
                local_agents := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Manage local agents","管理本地 Agent") on_click:||A.native_open("local_agents")}
            }
        }
        if H.page == "agents" && A.agents_enabled() {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                agents_project_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to project", "返回项目") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_project(H.agent_project_id)}
                agents_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() && !H.needs_signin text:A.t("Refresh", "刷新") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_project_agents(H.agent_project_id)}
            }
            mod.widgets.HagencyTitle{text:A.t("Project agents", "项目 Agent")}
            if H.agent_readiness == nil {mod.widgets.HagencyHint{text:A.t("Check current project requirements before requesting an agent.", "申请 Agent 前请检查项目的当前条件。")}}
            if H.agent_readiness != nil {mod.widgets.HagencySection{
                let r=H.agent_readiness
                mod.widgets.HagencyStatus{flow:Down spacing:12
                    mod.widgets.HagencyEyebrow{text:A.t("NEXT STEP","下一步")}
                    mod.widgets.HagencySectionTitle{text:if A.must_reopen() || H.needs_signin{A.t("Restore access before continuing","恢复访问后再继续")}else if r.canRequest && r.requestContext!=nil{A.t("Define an agent for this project","为此项目定义 Agent")}else if r.canViewRequests{A.t("Review this project’s agent requests","审核此项目的 Agent 申请")}else{A.t("Check the project requirements","检查项目条件")}}
                    mod.widgets.HagencyHint{text:r.projectName}
                    mod.widgets.HagencyHint{text:A.t("Agent applicant","Agent 申请者")+" · "+r.managerMxid}
                    if r.blockingReason!=nil {mod.widgets.HagencyCopy{text:A.agent_reason(r.blockingReason)}}
                    if !A.must_reopen() && !H.needs_signin && !r.canRequest {View{width:Fit height:Fit agent_requirements := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("View project requirements","查看项目条件") on_click:||A.open_project(H.agent_project_id)}}}
                }
                mod.widgets.HagencyDivider{}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Project authority", "项目权限")}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project manager", "项目经理")} mod.widgets.HagencyCopy{text:r.managerMxid}}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Current access", "当前访问范围")}
                    mod.widgets.HagencyCopy{text:if A.must_reopen() || H.needs_signin{A.t("Access needs to be restored. These are the last checked project details.","需要恢复访问。这里显示的是上次检查的项目详情。")}else if !r.canViewRequests {A.t("Project information only", "仅查看项目信息")} else if r.canRequest {A.t("Agent requests available", "可以申请 Agent")} else {A.t("View existing agent requests", "查看已有 Agent 申请")}}
                    if r.blockingReason != nil {mod.widgets.HagencyCopy{text:A.agent_reason(r.blockingReason)}}
                    if !r.canViewRequests {mod.widgets.HagencyHint{text:A.t("The project manager manages agent requests and approvals. Return to the project to view resource allocation and responsibilities.", "项目经理管理 Agent 申请与审批。可返回项目查看资源分配及各方职责。")}}
                }
                if r.requestContext != nil {mod.widgets.HagencySection{
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Reservation limit", "预留上限")} mod.widgets.HagencyCopy{text:A.amount(r.requestContext.requestedTokenLimit) + " token · " + r.requestContext.periodKey}}
                    mod.widgets.HagencyHint{text:A.t("This is the project's confirmed reservation limit, not current free capacity. The executor checks availability after approval.", "这是项目已确认的预留上限，不是当前可用容量。审批后由执行设备检查实际可用额度。")}
                }}
                if !A.must_reopen() && !H.needs_signin && r.canRequest && r.requestContext != nil && H.command == nil {View{width:Fill height:Fit agent_new := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Request an agent", "申请 Agent") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click: || A.begin_agent()}}}
                if r.canViewRequests && H.agents.len() == 0 {mod.widgets.HagencyHint{text:if H.busy{A.t("Checking agent requests…","正在检查 Agent 申请…")}else if H.ux.agentListReady{A.t("No agent requests on this page", "此页暂无 Agent 申请")}else if A.must_reopen(){A.t("Reopen Hagency from Mini apps to restore access.","请从小应用重新打开 Hagency，以恢复访问。")}else if H.needs_signin{A.t("Sign in again with this Matrix account to load agent requests.","请重新登录此 Matrix 账号，以加载 Agent 申请。")}else{A.t("Agent requests could not be loaded. Try Refresh.","未能加载 Agent 申请，请刷新重试。")}}}
            }}
            for row in H.agents {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:row.definition.name}
                mod.widgets.HagencyCopy{text:A.agent_state_text(row.state)}
                mod.widgets.HagencyHint{text:A.capability_label(row.definition.capability) + " · " + row.requestedTokens + " token · " + row.periodKey}
                agent_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View agent request", "查看 Agent 申请") on_click: || A.open_agent(row.id)}
            }}
            if H.agent_after != nil {View{width:Fill height:Fit agents_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next agent requests", "下一页 Agent 申请") on_click: || A.load_agents(H.agent_after)}}}
        }}
        if H.page == "agent_wizard" && A.agents_enabled() {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{agent_wizard_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to project agents", "返回项目 Agent") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_project_agents(H.agent_project_id)}}
            mod.widgets.HagencyTitle{text:if H.agent_review {A.t("Review agent request", "核对 Agent 申请")} else {A.t("Define your agent", "定义 Agent")}}
            if H.agent_readiness == nil || H.agent_readiness.requestContext == nil {mod.widgets.HagencyHint{text:A.t("Refresh project requirements before continuing. Your draft and original command are preserved.", "请刷新项目条件后继续，草稿与原始命令会保留。")}}
            if H.agent_readiness != nil && H.agent_readiness.requestContext != nil {mod.widgets.HagencySection{
                let r=H.agent_readiness let c=r.requestContext
                mod.widgets.HagencyHint{text:r.projectName + " · " + c.periodKey}
                if !H.agent_review {mod.widgets.HagencyFormGroup{
                    mod.widgets.HagencyCopy{text:A.t("Agent name", "Agent 名称")}
                    agent_name := mod.widgets.HagencyInput{text:H.agent_draft.name on_change:|text| A.agent_field("name",text)}
                    mod.widgets.HagencyCopy{text:A.t("What should the agent do?", "Agent 需要做什么？")}
                    agent_description := mod.widgets.HagencyInput{text:H.agent_draft.description on_change:|text| A.agent_field("description",text)}
                    mod.widgets.HagencyCopy{text:A.t("Capability", "能力")}
                    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                        for capability in c.capabilities {View{width:Fit height:Fit agent_capability := mod.widgets.HagencyChoice{draw_bg.color:if H.agent_draft.capability == capability {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} text:A.capability_label(capability) on_click: || A.agent_field("capability",capability)}}}
                    }
                    mod.widgets.HagencyCopy{text:A.t("Requested tokens", "申请 token 数量")}
                    agent_tokens := mod.widgets.HagencyInput{text:H.agent_draft.tokens on_change:|text| A.agent_field("tokens",text)}
                    mod.widgets.HagencyHint{text:A.t("Project reservation limit", "项目预留上限") + " · " + A.amount(c.requestedTokenLimit) + " token"}
                    mod.widgets.HagencyHint{text:A.t("Text only · tools disabled. Approval does not start an agent or guarantee free capacity.", "仅处理文本 · 禁用工具。批准申请不会启动 Agent，也不保证当前有可用容量。")}
                    agent_review := mod.widgets.RinxKeyPrimaryButton{text:A.t("Review request", "核对申请") enabled:!H.busy && H.command == nil && r.canRequest on_click: || A.review_agent()}
                }}
                if H.agent_review {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:H.agent_draft.name}
                    mod.widgets.HagencyCopy{text:H.agent_draft.description}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Capability", "能力")} mod.widgets.HagencyCopy{text:A.capability_label(H.agent_draft.capability)}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Requested tokens", "申请 token 数量")} mod.widgets.HagencyCopy{text:H.agent_draft.tokens + " · " + c.periodKey}}
                    mod.widgets.HagencyHint{text:A.t("As project manager, you confirm this agent and its budget. Executor setup follows approval.", "由你作为项目经理确认此 Agent 及其预算。批准后将进行执行设备设置。")}
                    mod.widgets.HagencyActions{
                        agent_edit := mod.widgets.HagencyButton{text:A.t("Edit request", "修改申请") enabled:!H.busy && H.command == nil on_click: || {H.agent_review=false A.redraw()}}
                        agent_submit := mod.widgets.RinxKeyPrimaryButton{text:A.t("Submit agent request", "提交 Agent 申请") enabled:!H.busy && H.command == nil && r.canRequest on_click: || A.submit_agent()}
                    }
                }}
            }}
        }}
        if H.page == "agent_action" && A.agents_enabled() {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                agent_list_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Project agents", "项目 Agent") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_project_agents(H.agent_project_id)}
                agent_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh request", "刷新申请") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_agent(H.agent_id)}
            }
            if H.agent_selected == nil {mod.widgets.HagencyHint{text:A.t("Refresh or recover the original request to see its current result.", "请刷新或恢复原始申请，查看当前结果。")}}
            if H.agent_selected != nil {mod.widgets.HagencySection{
                let r=H.agent_selected let {projectName=nil}=r
                mod.widgets.HagencyTitle{text:r.definition.name}
                mod.widgets.HagencyStatus{mod.widgets.HagencyCopy{text:A.agent_state_text(r.state)}}
                if projectName != nil {mod.widgets.HagencyHint{text:projectName}}
                if H.agent_confirmation != "" {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:if H.agent_confirmation == "approve" {A.t("Approve this agent request?", "批准此 Agent 申请？")} else if H.agent_confirmation == "reject" {A.t("Reject this agent request?", "拒绝此 Agent 申请？")} else {A.t("Cancel this agent request?", "取消此 Agent 申请？")}}
                    mod.widgets.HagencyHint{text:if H.agent_confirmation == "cancel" {A.t("The request is fenced. Any executor cleanup is separate; cancellation does not prove that resources have been released.", "申请将被停止。执行设备的清理另行进行；取消申请不代表资源已释放。")} else {A.t("This records your decision as project manager. Agent status shows when execution is ready.", "此操作记录你作为项目经理的决定。执行就绪情况会显示在 Agent 状态中。")}}
                    mod.widgets.HagencyActions{
                        agent_dismiss := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back", "返回") on_click: || {H.agent_confirmation="" A.redraw()}}
                        agent_confirm := mod.widgets.RinxKeyPrimaryButton{text:A.t("Confirm", "确认") enabled:!H.busy && H.command == nil on_click: || {if H.agent_confirmation == "cancel" {A.cancel_agent()} else {A.decide_agent(H.agent_confirmation == "approve")}}}
                    }
                }}
                mod.widgets.HagencyCopy{text:r.definition.description}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Capability", "能力")} mod.widgets.HagencyCopy{text:A.capability_label(r.definition.capability)}}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Requested tokens", "申请 token 数量")} mod.widgets.HagencyCopy{text:A.amount(r.requestedTokens) + " · " + r.periodKey}}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project manager", "项目经理")} mod.widgets.HagencyCopy{text:r.managerMxid}}
                mod.widgets.HagencyHint{text:A.t("Text only · tools disabled. Running status and executor cleanup are not confirmed by this approval card.", "仅处理文本 · 禁用工具。此审批卡不能确认运行状态或执行设备的清理结果。")}
                mod.widgets.HagencyActions{
                    agent_budget_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Budget and top-ups", "预算与额度追加") on_click: || A.open_agent_budget(r.id,r.definition.name,nil,1)}
                    agent_status_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Agent status", "Agent 状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_agent_status(r.id)}
                }
                if r.blockingReason != nil {mod.widgets.HagencyHint{text:A.agent_reason(r.blockingReason)}}
                if H.command == nil && H.agent_confirmation == "" && (r.canApprove || r.canReject || r.canCancel) {mod.widgets.HagencyActions{
                    if r.canApprove {View{width:Fit height:Fit agent_approve := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Approve request", "批准申请") on_click: || {H.agent_confirmation="approve" A.redraw()}}}}
                    if r.canReject {View{width:Fit height:Fit agent_reject := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Reject request", "拒绝申请") on_click: || {H.agent_confirmation="reject" A.redraw()}}}}
                    if r.canCancel {View{width:Fit height:Fit agent_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel request", "取消申请") on_click: || {H.agent_confirmation="cancel" A.redraw()}}}}
                }}
            }}
            if A.cleanup_enabled() {mod.widgets.HagencyActions{agent_cleanup := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View removal status", "查看移除状态") on_click: || A.open_removal(H.agent_id)}}}
        }}
        if H.page == "agent_status" && A.agents_enabled() {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                agent_status_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to request", "返回申请") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_agent(H.agent_id)}
                agent_status_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh status", "刷新状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_agent_status(H.agent_id)}
            }
            mod.widgets.HagencyTitle{text:A.t("Agent status", "Agent 状态")}
            if H.agent_status == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading current server records…", "正在读取当前服务器记录…")} else {A.t("Status could not be read. Refresh to try again.", "未能读取状态，请刷新后重试。")}}}
            if H.agent_status != nil {mod.widgets.HagencySection{
                let status=H.agent_status
                let request=status.agentRequest
                mod.widgets.HagencySectionTitle{text:request.definition.name}
                mod.widgets.HagencyActions{status_budget_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Budget and top-ups", "预算与额度追加") on_click: || A.open_agent_budget(request.id,request.definition.name,nil,1)}}
                if A.control_enabled() && status.assignment.record != nil {mod.widgets.HagencyActions{
                    agent_control_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Automatic replies", "自动回复") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_agent_control(status.assignment.record.id,request.definition.name)}
                }}
                mod.widgets.HagencyHint{text:A.t("Stages are read separately from the server and can advance between reads. Refresh for new observations.", "各阶段分别从服务器读取，状态可能在读取期间推进。请刷新获取新的观测。")}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Agent approval", "Agent 审批")}
                    mod.widgets.HagencyCopy{text:A.agent_state_text(request.state)}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Requested tokens", "申请 token 数量")} mod.widgets.HagencyCopy{text:A.amount(request.requestedTokens) + " · " + request.periodKey}}
                }
                mod.widgets.HagencyDivider{}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Native agent reservation", "原生 Agent 预留")}
                    mod.widgets.HagencyCopy{text:A.agent_stage_text(status.assignment)}
                    if status.assignment.record != nil {mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Agent ID", "Agent 标识")}
                        mod.widgets.HagencyCopy{text:status.assignment.record.agentId}
                    }}
                    mod.widgets.HagencyHint{text:A.t("An assignment records native reservation acceptance; it does not confirm work is running or capacity has been released.", "分配记录表示原生预留已被接受，不代表任务正在运行或容量已释放。")}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Matrix presence", "Matrix 成员状态")}
                    mod.widgets.HagencyCopy{text:A.agent_stage_text(status.membership)}
                    if status.membership.record != nil {mod.widgets.HagencySection{
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Agent Matrix ID", "Agent Matrix ID")} mod.widgets.HagencyCopy{text:status.membership.record.puppetMxid}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project room", "项目房间")} mod.widgets.HagencyCopy{text:status.membership.record.roomId}}
                        if status.membership.record.blockingReason != nil {mod.widgets.HagencyHint{text:A.agent_reason(status.membership.record.blockingReason)}}
                    }}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Runtime qualification", "运行环境资格检查")}
                    mod.widgets.HagencyCopy{text:A.agent_stage_text(status.runtime)}
                    mod.widgets.HagencyHint{text:A.t("Qualification checks the provider process. It does not prove that the agent is currently online or performing work.", "资格检查用于验证模型服务进程，并不证明 Agent 当前在线或正在执行任务。")}
                }
                mod.widgets.HagencySection{
                    let execution=A.agent_execution(status)
                    mod.widgets.HagencySectionTitle{text:A.t("Shared text execution", "共享文本执行")}
                    mod.widgets.HagencyCopy{text:A.agent_execution_text(execution)}
                    if execution != nil {View{width:Fill height:Fit flow:Down spacing:10
                        if execution.observedAtUtc != nil {mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Observed at", "观测时间")} mod.widgets.HagencyCopy{text:execution.observedAtUtc}}}
                        if execution.record != nil {View{width:Fill height:Fit flow:Down spacing:10
                            let record=execution.record
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Execution policy", "执行策略")} mod.widgets.HagencyCopy{text:if record.policy == "codex_text_v1" {A.t("Codex · text only", "Codex · 仅文本")} else {record.policy}}}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Work readiness", "任务就绪状态")} mod.widgets.HagencyCopy{text:if record.workAvailable {A.t("Available when checked", "检查时可用")} else {A.t("Not available when checked", "检查时不可用")}}}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Activity expires", "活动有效期至")} mod.widgets.HagencyCopy{text:if record.activityExpiresAtUtc == nil {A.t("No current expiry observation", "暂无当前有效期观测")} else {record.activityExpiresAtUtc}}}
                        }}
                    }}
                    mod.widgets.HagencyHint{text:A.t("Readiness is a finite server observation and can change. It does not mean a task is running; refresh before relying on it.", "就绪状态是有时限的服务器观测，可能变化，并不代表有任务正在运行，请刷新后再判断。")}
                }
                mod.widgets.HagencyDivider{}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Work history and usage", "任务历史与用量")}
                    if A.work_enabled() {mod.widgets.HagencyActions{
                        agent_work_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View work history", "查看任务历史") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || {H.work_from_list=false A.open_agent_work(H.agent_id,nil,1)}}
                    }} else {mod.widgets.HagencyCopy{text:A.t("Shared-agent work records are not available in this interface yet.", "此界面暂不提供共享 Agent 的任务记录。")}}
                    mod.widgets.HagencyHint{text:A.t("No history is not zero usage. Requested tokens are not measured consumption or remaining capacity.", "暂无历史不等于零用量。申请额度不是已测量的消耗量或剩余额度。")}
                    if A.cleanup_enabled() {mod.widgets.HagencyActions{agent_status_removal := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View removal and cleanup", "查看移除与清理") on_click: || A.open_removal(H.agent_id)}}}
                    mod.widgets.HagencyHint{text:if A.cleanup_enabled() {A.t("Removal and cleanup report their own current state; they do not imply that capacity has been refunded.", "移除与清理分别报告当前状态，不代表容量已退还。")} else {A.t("Removal status is not enabled on this server.", "此服务器尚未启用移除状态查询。")}}
                    mod.widgets.HagencyHint{text:A.t("Token top-up requests are not available here yet.", "此处暂不支持追加 token 申请。")}
                }
            }}
        }}
        if H.page == "agent_budget" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                budget_back := mod.widgets.HagencyButton{text:A.t("Back", "返回") enabled:!H.busy on_click: || {if A.pool_enabled(){A.open_pool_agent(H.budget_request_id)}else if A.agents_enabled(){A.open_agent(H.budget_request_id)}else if A.cleanup_enabled(){A.open_removal(H.budget_request_id)}else{A.navigate("overview")}}}
                budget_refresh := mod.widgets.HagencyButton{text:A.t("Refresh", "刷新") enabled:!H.busy on_click: || A.open_agent_budget(H.budget_request_id,H.budget_agent_name,H.budget_after,H.budget_page)}
            }
            mod.widgets.HagencyTitle{text:A.t("Budget and top-ups", "预算与额度追加")}
            if H.budget_agent_name!="" {mod.widgets.HagencySectionTitle{text:H.budget_agent_name}}
            if H.agent_budget==nil {mod.widgets.HagencyCopy{text:if H.busy{A.t("Reading budget…", "正在读取预算…")}else{A.t("Refresh to read the current budget.", "请刷新以读取当前预算。")}}}
            if H.agent_budget!=nil {View{width:Fill height:Fit flow:Down spacing:12
                if !H.agent_budget.supported {mod.widgets.HagencyCopy{text:A.t("This server does not provide agent top-up history yet.","此服务器尚未提供 Agent 额度追加历史。")}}
                if H.agent_budget.supported {View{width:Fill height:Fit flow:Down spacing:12
                    let b=H.agent_budget.budget
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Effective ceiling", "当前账面上限")} mod.widgets.HagencyCopy{text:A.amount(b.effectiveCeilingTokens)+" token"}}
                    mod.widgets.HagencyHint{text:A.t("The execution device must apply the increase and check current usage and resource access before spending it.","执行设备需要先应用追加额度，并核对当前用量和资源权限，才能使用这部分预算。")}
                    if !A.budget_idle() && !H.busy {mod.widgets.HagencyHint{text:A.t("Recover the saved request above before making another budget change.","请先恢复上方已保存的申请，再修改预算。")}}
                    if H.budget_mode=="" && A.can_topup(b) && A.budget_idle() {mod.widgets.HagencyActions{budget_request := mod.widgets.RinxKeyPrimaryButton{text:if A.can_owner_fund(b){A.t("Add Agent capacity","为 Agent 追加额度")}else{A.t("Request more tokens", "申请追加额度")} on_click: || A.begin_topup()}}}
                    if H.budget_mode=="edit" {mod.widgets.HagencyFormGroup{
                        mod.widgets.HagencyFieldLabel{text:A.t("Additional tokens", "追加 token 数量")}
                        budget_tokens := mod.widgets.HagencyNumberInput{minimum:1 text:H.budget_tokens empty_text:A.t("Positive whole amount", "大于零的整数") on_change:|text| {H.budget_tokens=text}}
                        mod.widgets.HagencyHint{text:A.t("− / + adjusts by 100,000 tokens; type any exact amount.","− / + 每次调整 10 万 token，也可输入精确数量。")}
                        mod.widgets.HagencyFieldLabel{text:if A.can_owner_fund(b){A.t("Note (optional)","备注（可选）")}else{A.t("Reason", "原因")}}
                        budget_purpose := mod.widgets.HagencyInput{text:H.budget_purpose empty_text:A.t("Why does this agent need more budget?", "此 Agent 为什么需要追加额度？") on_change:|text| {H.budget_purpose=text}}
                        mod.widgets.HagencyActions{
                            budget_edit_cancel := mod.widgets.HagencyButton{text:A.t("Cancel", "取消") enabled:!H.busy on_click: || {H.budget_mode="" A.redraw()}}
                            budget_review := mod.widgets.RinxKeyPrimaryButton{text:if A.can_owner_fund(b){A.t("Review increase","核对追加")}else{A.t("Review request", "核对申请")} enabled:A.budget_idle() on_click: || A.review_topup()}
                        }
                    }}
                    if H.budget_confirmation!=nil {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:H.budget_confirmation.title}
                        mod.widgets.HagencyCopy{text:"+"+A.amount(H.budget_confirmation.args.addTokens)+" token · "+H.budget_confirmation.args.purpose}
                        mod.widgets.HagencyHint{text:if A.owner_funded(H.budget_confirmation.args){A.t("You are adding capacity dedicated to this Agent. The execution device checks the full resource and account budgets before applying it. Existing usage stays reserved.","你将为此 Agent 追加专用容量。执行设备会核对资源和账户总预算后应用，已有用量继续保留。")}else{A.t("The resource owner approves increases for pool Agents.","资源池 Agent 的追加额度由资源 owner 批准。")}}
                        mod.widgets.HagencyActions{
                            budget_edit := mod.widgets.HagencyButton{text:A.t("Edit", "修改") enabled:!H.busy on_click: || {H.budget_confirmation=nil H.budget_mode="edit" A.redraw()}}
                            budget_submit := mod.widgets.RinxKeyPrimaryButton{text:if A.can_owner_fund(b){A.t("Confirm increase","确认追加")}else{A.t("Submit request", "提交申请")} enabled:A.budget_idle() on_click: || A.apply_topup()}
                        }
                    }}
                    if A.owner_funding_upgrade(b) {mod.widgets.HagencyHint{text:A.t("Update the server to add owner capacity in one confirmation.","请升级服务器，以便 owner 一次确认即可追加额度。")}}
                    if b.blockingReason!=nil && !A.can_owner_fund(b) {mod.widgets.HagencyHint{text:A.budget_reason(b.blockingReason)}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Original ceiling", "原始上限")} mod.widgets.HagencyCopy{text:A.amount(b.originalCeilingTokens)}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Applied increases", "已应用的追加额度")} mod.widgets.HagencyCopy{text:A.amount(b.appliedDeltaTokens)}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Server-confirmed consumption", "服务端已确认消耗")} mod.widgets.HagencyCopy{text:A.amount(b.knownConsumedTokens)}}
                    budget_usage := View{width:Fill height:Fit visible:b.knownConsumedTokens!=nil && b.effectiveCeilingTokens!=nil && b.effectiveCeilingTokens>0
                        mod.widgets.HagencyProgress{value:A.progress_ratio(b.knownConsumedTokens,b.effectiveCeilingTokens)}
                    }
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Remaining on device", "设备剩余额度")} mod.widgets.HagencyCopy{text:if b.nativeRemainingTokens==nil{A.t("Not observed", "尚未观测")}else{A.amount(b.nativeRemainingTokens)}}}
                    mod.widgets.HagencyHint{text:A.t("Conservative commitment", "保守承诺量")+" · "+A.amount(b.conservativeCommitmentTokens)+" · "+A.t("Includes unresolved approved increases; this is not measured free capacity.","包含尚未确认的已批追加额度，不是已测量的可用容量。")}
                    mod.widgets.HagencyHint{text:A.t("Observed at", "观测时间")+" · "+H.agent_budget.observedAtUtc}
                    mod.widgets.HagencyDivider{}
                    mod.widgets.HagencySectionTitle{text:A.t("Top-up history", "额度追加历史")}
                    if H.budget_topups!=nil {View{width:Fill height:Fit flow:Down spacing:12
                        if H.budget_topups.topUps.items.len()==0 {mod.widgets.HagencyCopy{text:A.t("No top-up requests on this page.","此页暂无额度追加申请。")}}
                        for row in H.budget_topups.topUps.items {mod.widgets.HagencySection{
                            mod.widgets.HagencyCopy{text:"+"+A.amount(row.addTokens)+" · "+A.topup_state(row.state)}
                            mod.widgets.HagencyHint{text:row.purpose}
                            mod.widgets.HagencyHint{text:A.topup_native_state(row.nativeState)}
                            topup_open := mod.widgets.HagencyButton{text:A.t("View request", "查看申请") enabled:!H.busy on_click: || A.open_topup(row.id)}
                        }}
                        if H.budget_page>1 || H.budget_topups.topUps.nextAfter!=nil {mod.widgets.HagencyActions{
                            if H.budget_page>1 {View{width:Fit height:Fit topup_first := mod.widgets.HagencyButton{text:A.t("First page", "第一页") enabled:!H.busy on_click: || A.open_agent_budget(H.budget_request_id,H.budget_agent_name,nil,1)}}}
                            if H.budget_topups.topUps.nextAfter!=nil {View{width:Fit height:Fit topup_next := mod.widgets.HagencyButton{text:A.t("Next page", "下一页") enabled:!H.busy on_click: || A.open_agent_budget(H.budget_request_id,H.budget_agent_name,H.budget_topups.topUps.nextAfter,H.budget_page+1)}}}
                        }}
                    }}
                }}
            }}
        }}
        if H.page == "agent_topup" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                topup_back := mod.widgets.HagencyButton{text:A.t("Budget", "预算") enabled:!H.busy on_click: || A.open_agent_budget(H.budget_request_id,H.budget_agent_name,nil,1)}
                topup_refresh := mod.widgets.HagencyButton{text:A.t("Refresh", "刷新") enabled:!H.busy on_click: || A.open_topup(H.budget_topup_id)}
            }
            mod.widgets.HagencyTitle{text:A.t("Budget increase", "额度追加")}
            if H.budget_topup==nil {mod.widgets.HagencyCopy{text:A.t("Refresh or recover the saved request to see its current result.","请刷新或恢复已保存的申请，查看当前结果。")}}
            if H.budget_topup!=nil {View{width:Fill height:Fit flow:Down spacing:12
                let t=H.budget_topup.topUp
                mod.widgets.HagencySectionTitle{text:"+"+A.amount(t.addTokens)+" token"}
                mod.widgets.HagencyCopy{text:A.topup_state(t.state)+" · "+A.topup_native_state(t.nativeState)}
                mod.widgets.HagencyCopy{text:t.purpose}
                mod.widgets.HagencyHint{text:A.topup_application_hint(t.nativeState)}
                if H.budget_confirmation==nil && A.budget_idle() && (t.canDecide || t.canCancel) {mod.widgets.HagencyActions{
                    if t.canDecide {View{width:Fit height:Fit topup_approve := mod.widgets.RinxKeyPrimaryButton{text:A.t("Approve", "批准") on_click: || A.review_topup_action("approve")}}}
                    if t.canDecide {View{width:Fit height:Fit topup_reject := mod.widgets.HagencyButton{text:A.t("Reject", "拒绝") on_click: || A.review_topup_action("reject")}}}
                    if t.canCancel {View{width:Fit height:Fit topup_cancel := mod.widgets.HagencyButton{text:A.t("Cancel request", "取消申请") on_click: || A.review_topup_action("cancel")}}}
                }}
                if H.budget_confirmation!=nil {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:H.budget_confirmation.title}
                    mod.widgets.HagencyHint{text:A.topup_review_hint()}
                    mod.widgets.HagencyActions{
                        topup_dismiss := mod.widgets.HagencyButton{text:A.t("Back", "返回") enabled:!H.busy on_click: || {H.budget_confirmation=nil A.redraw()}}
                        topup_confirm := mod.widgets.RinxKeyPrimaryButton{text:A.t("Confirm", "确认") enabled:A.budget_idle() on_click: || A.apply_topup()}
                    }
                }}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Ceiling when requested", "申请时的上限")} mod.widgets.HagencyCopy{text:A.amount(t.expectedCeilingTokens)}}
                mod.widgets.HagencyHint{text:A.t("Observed at", "观测时间")+" · "+H.budget_topup.observedAtUtc}
                topup_details := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.budget_details{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} text:if H.budget_details{A.t("Hide details", "收起详情")}else{A.t("Details", "详情")} on_click: || {H.budget_details=!H.budget_details A.redraw()}}
                if H.budget_details {mod.widgets.HagencySection{
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Request ID", "申请标识")} mod.widgets.HagencyCopy{text:t.id}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Expires", "到期时间")} mod.widgets.HagencyCopy{text:t.expiresAtUtc}}
                }}
            }}
        }}
        if H.page == "agent_control" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                control_back := mod.widgets.HagencyButton{enabled:!H.busy text:if H.agent_id == "" {A.t("Overview", "概览")} else {A.t("Agent status", "Agent 状态")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || {if H.agent_id == "" {A.navigate("overview")} else {A.open_agent_status(H.agent_id)}}}
                control_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh setting", "刷新设置") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_agent_control(H.control_assignment,H.control_agent_name)}
            }
            mod.widgets.HagencyTitle{text:A.t("Automatic replies", "自动回复")}
            mod.widgets.HagencySectionTitle{text:if H.control_agent_name == "" {H.control_assignment} else {H.control_agent_name}}
            if H.agent_control == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading the current setting…", "正在读取当前设置…")} else {A.t("Refresh to read the current setting. A saved request must be recovered before making another change.", "请刷新读取当前设置。再次修改前，需要先恢复已保存的请求。")}}}
            if H.agent_control != nil {mod.widgets.HagencySection{
                let r=H.agent_control.readiness
                mod.widgets.HagencyCopy{text:A.control_mode_text(r.control.mode)}
                if H.agent_control.observedAtUtc != nil {mod.widgets.HagencyHint{text:A.t("Checked: ", "查询时间：")+H.agent_control.observedAtUtc}}
                if !r.intakeEnabled || !r.automaticDeliveryEnabled {mod.widgets.HagencyHint{text:A.t("Automatic processing is disabled on the server. This saved setting does not mean replies can run now.","服务器已关闭自动处理。此已保存设置不代表当前可以执行回复。")}}
                if r.runBlockingReason != nil && r.runBlockingReason != "already_running" {mod.widgets.HagencyHint{text:A.control_reason(r.runBlockingReason)}}
                if H.command == nil {mod.widgets.HagencyActions{
                    if r.canRun {View{width:Fit height:Fit control_run := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Enable automatic replies", "启用自动回复") on_click: || A.set_agent_control("running")}}}
                    if r.canStop {View{width:Fit height:Fit control_pause := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Pause automatic replies", "暂停自动回复") on_click: || A.set_agent_control("paused")}}}
                }}
                mod.widgets.HagencyHint{text:A.t("When enabled, approved messages can be processed while this mini app is closed. The executor must remain connected with available budget.","启用后，即使关闭此小程序，获准的消息仍可继续处理。执行设备需要保持连接，并有可用额度。")}
                mod.widgets.HagencyHint{text:A.t("This setting does not show whether a process is running. Check agent status and work history for recorded execution and usage.","此设置不表示进程正在运行。请查看 Agent 状态和任务历史，了解已记录的执行情况与用量。")}
            }}
        }}
        if H.page == "agent_removals" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                removals_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Overview", "概览") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.navigate("overview")}
                removals_refresh := mod.widgets.HagencyButton{enabled:!H.busy && A.cleanup_enabled() text:A.t("Refresh page", "刷新此页") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_removals(H.removal_project,H.removal_after,H.removal_page)}
            }
            mod.widgets.HagencyTitle{text:A.t("Agent removal and cleanup", "Agent 移除与清理")}
            mod.widgets.HagencyCopy{text:A.t("Project managers can cancel requests and remove approved agents. Cleanup remains accessible when new requests are disabled.", "项目经理可取消申请并移除已批准的 Agent。即使暂停新申请，仍可查看和处理清理进度。")}
            if !A.cleanup_enabled() {mod.widgets.HagencyCopy{text:A.t("Not enabled on this server", "此服务器尚未启用")}}
            if A.cleanup_enabled() {mod.widgets.HagencySection{
                if H.removals == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading cleanup records…", "正在读取清理记录…")} else {A.t("Cleanup records could not be read. Refresh to try again.", "未能读取清理记录，请刷新后重试。")}}}
                if H.removals != nil {mod.widgets.HagencySection{
                    mod.widgets.HagencyHint{text:A.t("Observed · ", "查询时间 · ")+H.removals.observedAtUtc}
                    if H.removals.requests.items.len() == 0 {mod.widgets.HagencyCopy{text:A.t("No agent requests are visible in this scope.", "当前访问范围内没有可见的 Agent 申请。")}}
                    for row in H.removals.requests.items {mod.widgets.HagencySection{
                        mod.widgets.HagencyDivider{}
                        mod.widgets.HagencySectionTitle{text:row.agentName}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project", "项目")} mod.widgets.HagencyCopy{text:row.projectName}}
                        mod.widgets.HagencyHint{text:row.requestId}
                        mod.widgets.HagencyActions{removal_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View removal status", "查看移除状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_removal(row.requestId)}}
                    }}
                    mod.widgets.HagencyActions{
                        removals_first := mod.widgets.HagencyButton{enabled:!H.busy && H.removal_after != nil text:A.t("First page", "首页") on_click: || A.open_removals(H.removal_project,nil,1)}
                        if H.removals.requests.nextAfter != nil {View{width:Fit height:Fit removals_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page", "下一页") on_click: || A.open_removals(H.removal_project,H.removals.requests.nextAfter,H.removal_page+1)}}}
                        if H.removal_project != nil {View{width:Fit height:Fit removals_all := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("All my projects", "我的全部项目") on_click: || A.open_removals(nil,nil,1)}}}
                    }
                }}
            }}
        }}
        if H.page == "agent_removal" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                removal_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to cleanup list", "返回清理列表") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_removals(H.removal_project,H.removal_after,H.removal_page)}
                removal_refresh := mod.widgets.HagencyButton{enabled:!H.busy && A.cleanup_enabled() text:A.t("Refresh status", "刷新状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_removal(H.removal_id)}
            }
            mod.widgets.HagencyTitle{text:A.t("Agent removal status", "Agent 移除状态")}
            if !A.cleanup_enabled() {mod.widgets.HagencyCopy{text:A.t("Not enabled on this server", "此服务器尚未启用")}}
            if A.cleanup_enabled() {mod.widgets.HagencySection{
                if H.removal == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading cleanup records…", "正在读取清理记录…")} else {A.t("Cleanup records could not be read. Refresh to try again.", "未能读取清理记录，请刷新后重试。")}}}
                if H.removal != nil {mod.widgets.HagencySection{
                    let r=H.removal.removal
                    mod.widgets.HagencySectionTitle{text:r.agentName}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project", "项目")} mod.widgets.HagencyCopy{text:r.projectName}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Admission", "审批")} mod.widgets.HagencyCopy{text:A.agent_state_text(r.admissionState)}}
                    if H.command == nil && H.removal_confirmation != "" {mod.widgets.HagencySection{
                        mod.widgets.HagencyDivider{}
                        mod.widgets.HagencySectionTitle{text:if H.removal_confirmation == "revoke" {A.t("Revoke this agent?", "撤销此 Agent？")} else {A.t("Cancel this request?", "取消此申请？")}}
                        mod.widgets.HagencyCopy{text:A.t("This blocks new work and requests cleanup. A running call may have an unknown result. It does not delete history or promise a token refund.", "此操作阻止新任务并请求清理。正在执行的调用可能结果未知；历史不会删除，也不保证 token 额度退回。")}
                        mod.widgets.HagencyActions{
                            removal_confirm := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Confirm", "确认") on_click: || A.confirm_removal()}
                            removal_keep := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Keep unchanged", "保持不变") on_click: || {H.removal_confirmation="" A.redraw()}}
                        }
                    }}
                    if H.command == nil && H.removal_confirmation == "" && (r.canCancel || r.canRevoke) {mod.widgets.HagencyActions{
                        if r.canCancel {View{width:Fit height:Fit removal_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel request", "取消申请") on_click: || {H.removal_confirmation="cancel" A.redraw()}}}}
                        if r.canRevoke {View{width:Fit height:Fit removal_revoke := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Revoke agent", "撤销 Agent") on_click: || {H.removal_confirmation="revoke" A.redraw()}}}}
                    }}
                    mod.widgets.HagencyDivider{}
                    mod.widgets.HagencySectionTitle{text:A.t("1  Server restriction", "1  服务器限制")}
                    mod.widgets.HagencyCopy{text:if r.centralFenced {A.t("New work is blocked by the server", "服务器已阻止新任务")} else {A.t("No server restriction recorded", "尚无服务器限制记录")}}
                    mod.widgets.HagencySectionTitle{text:A.t("2  Device and process observations", "2  设备与进程观测")}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Latest process record", "最近进程记录")} mod.widgets.HagencyCopy{text:if r.processObservation == nil {A.cleanup_state(nil)} else {A.cleanup_state(r.processObservation.state)}}}
                    mod.widgets.HagencyHint{text:A.t("These are recorded observations, not a live process monitor.", "以上为已记录的观测，不是实时进程监控。")}
                    mod.widgets.HagencySectionTitle{text:A.t("3  Matrix cleanup", "3  Matrix 清理")}
                    mod.widgets.HagencyCopy{text:A.matrix_cleanup_state(r.matrix)}
                    if r.matrix != nil {mod.widgets.HagencyHint{text:A.work_time(r.matrix.cleanupObservedAtUtc)}}
                    mod.widgets.HagencyDivider{}
                    mod.widgets.HagencySectionTitle{text:A.t("Token accounting", "Token 核算")}
                    if !A.settlement_enabled() {mod.widgets.HagencySection{
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Server-confirmed consumption", "服务端已确认消耗")} mod.widgets.HagencyCopy{text:A.removal_number(r.usage.knownConsumedTokens)}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Retained lower bound", "保留额度下限")} mod.widgets.HagencyCopy{text:A.removal_number(r.usage.retainedTokensFloor)}}
                    }}
                    if !A.settlement_enabled() {mod.widgets.HagencySection{
                        mod.widgets.HagencyCopy{text:A.cleanup_complete(r.usage.fenceUsageComplete)}
                        if r.usage.requiresReconciliation {mod.widgets.HagencyCopy{text:A.t("Later usage needs reconciliation with the cleanup receipt.", "后续用量需要与清理回执重新核算。")}}
                    }}
                    if A.settlement_enabled() {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Latest settlement", "最新结算")}
                        if H.settlement == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading settlement…", "正在读取结算…")} else {A.t("Settlement could not be read. Refresh to try again.", "未能读取结算，请刷新后重试。")}}}
                        if H.settlement != nil {mod.widgets.HagencySection{
                            let s=H.settlement.settlement
                            mod.widgets.HagencyCopy{text:A.settlement_status(s)}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Server-confirmed consumption", "服务端已确认消耗")} mod.widgets.HagencyCopy{text:A.removal_number(s.knownConsumedTokens)}}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Retained lower bound", "保留额度下限")} mod.widgets.HagencyCopy{text:A.removal_number(s.retainedTokensFloor)}}
                            if s.latestReceipt != nil {mod.widgets.HagencyDetailRow{
                                mod.widgets.HagencyFieldLabel{text:A.t("Unresolved in latest receipt", "最新回执中的未核清量")}
                                mod.widgets.HagencyCopy{text:A.removal_number(s.latestReceipt.unresolvedTokens)}
                            }}
                            if s.pendingCommandId != nil {mod.widgets.HagencyHint{text:A.t("The original owner must be signed in on the execution device. The check can finish while this mini app is closed. Refresh reads its result.", "资源主人需在原执行设备保持登录。关闭此 mini app 后仍可完成核算；刷新可读取结果。")}}
                            if !s.settlementCurrent && s.latestReceipt != nil {mod.widgets.HagencyHint{text:A.t("A stopped process alone does not resolve missing usage. Existing charges stay retained until complete evidence arrives.", "仅停止进程不能核清缺失用量。在完整记录到达前，现有记账继续保留。")}}
                            mod.widgets.HagencyActions{
                                settlement_recheck := mod.widgets.HagencyButton{enabled:!H.busy && H.command == nil && s.canRequest text:A.t("Recheck accounting", "重新核算") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.recheck_settlement()}
                            }
                            mod.widgets.HagencyHint{text:A.t("Observed · ", "查询时间 · ")+H.settlement.observedAtUtc}
                        }}
                    }}
                    mod.widgets.HagencyHint{text:A.t("Retained amounts include spent tokens and unresolved liability. They are not available capacity or a refund.", "保留记账量包括已消耗 token 与尚未核清的责任，不代表可用容量或退回额度。")}
                    mod.widgets.HagencyHint{text:A.t("Observed · ", "查询时间 · ")+H.removal.observedAtUtc}
                    mod.widgets.HagencyActions{
                        removal_details := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.removal_details{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} enabled:!H.busy text:if H.removal_details{A.t("Hide details", "收起详情")}else{A.t("Details", "详情")} on_click: || {H.removal_details=!H.removal_details A.redraw()}}
                        removal_budget_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Budget and top-ups", "预算与额度追加") on_click: || A.open_agent_budget(r.requestId,r.agentName,nil,1)}
                    }
                    if H.removal_details {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Original cleanup receipt", "原始清理回执")}
                        if A.settlement_enabled() {mod.widgets.HagencyCopy{text:A.cleanup_complete(r.usage.fenceUsageComplete)}}
                        mod.widgets.HagencyHint{text:A.t("This historical receipt is separate from later process observations. A later stop does not complete its accounting.", "此历史回执与后续进程观测分开记录。后续停止不代表该回执的核算已完成。")}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Delivery", "送达")} mod.widgets.HagencyCopy{text:if r.nativeFence == nil {A.cleanup_state(nil)} else {A.cleanup_state(r.nativeFence.deliveryState)}}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Native cleanup", "原生清理")} mod.widgets.HagencyCopy{text:if r.nativeFence == nil {A.cleanup_state(nil)} else {A.cleanup_state(r.nativeFence.nativeState)}}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Process at cleanup", "清理时进程")} mod.widgets.HagencyCopy{text:if r.nativeFence == nil {A.cleanup_state(nil)} else {A.cleanup_state(r.nativeFence.processState)}}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Request", "申请")} mod.widgets.HagencyCopy{text:r.requestId}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("UTC period", "UTC 周期")} mod.widgets.HagencyCopy{text:r.usage.periodKey}}
                    }}
                }}
            }}
        }}
        if H.page == "agent_work_list" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                work_list_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Overview", "概览") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.navigate("overview")}
                work_list_refresh := mod.widgets.HagencyButton{enabled:!H.busy && A.work_enabled() text:A.t("Refresh page", "刷新此页") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_work_list(H.work_list_project,H.work_list_after,H.work_list_page)}
            }
            mod.widgets.HagencyTitle{text:A.t("Agent work history", "Agent 任务历史")}
            mod.widgets.HagencyCopy{text:A.t("Recorded work for projects you manage or administer. History remains readable when new agent requests are disabled.", "查看你管理或负责审批的项目任务记录。即使暂停新的 Agent 申请，历史仍可查看。")}
            if !A.work_enabled() {mod.widgets.HagencyCopy{text:A.t("Not enabled on this server", "此服务器尚未启用")}} else {mod.widgets.HagencySection{
                if H.work_list == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading work records…", "正在读取任务记录…")} else {A.t("History could not be read. Refresh this page to try again.", "未能读取历史，请刷新此页重试。")}}}
                if H.work_list != nil {mod.widgets.HagencySection{
                    mod.widgets.HagencyHint{text:A.t("Observed · ","查询时间 · ")+H.work_list.observedAtUtc}
                    mod.widgets.HagencyHint{text:A.t("Page ","第 ")+H.work_list_page+A.t(" · ordered by request ID"," 页 · 按申请标识排序")}
                    if H.work_list.requests.items.len() == 0 {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("No recorded work in your current scope", "当前访问范围内暂无任务记录")}
                        mod.widgets.HagencyCopy{text:A.t("Only agent requests with recorded shared work appear here. This does not mean zero resource usage.", "此处仅显示已有共享任务记录的 Agent 申请，这不代表资源用量为零。")}
                    }}
                    for row in H.work_list.requests.items {mod.widgets.HagencySection{
                        mod.widgets.HagencyDivider{}
                        mod.widgets.HagencySectionTitle{text:row.agentName}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project", "项目")} mod.widgets.HagencyCopy{text:row.projectName}}
                        mod.widgets.HagencyHint{text:row.requestId}
                        mod.widgets.HagencyActions{work_list_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View work history", "查看任务历史") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_work_entry(row)}}
                    }}
                    mod.widgets.HagencyActions{
                        work_list_first := mod.widgets.HagencyButton{enabled:!H.busy && H.work_list_after != nil text:A.t("First page", "首页") on_click: || A.open_work_list(H.work_list_project,nil,1)}
                        if H.work_list.requests.nextAfter != nil {View{width:Fit height:Fit work_list_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page", "下一页") on_click: || A.open_work_list(H.work_list_project,H.work_list.requests.nextAfter,H.work_list_page+1)}}}
                        if H.work_list_project != nil {View{width:Fit height:Fit work_list_all := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("All my projects", "我的全部项目") on_click: || A.open_work_list(nil,nil,1)}}}
                    }
                }}
            }}
        }}
        if H.page == "agent_work" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                work_back := mod.widgets.HagencyButton{enabled:!H.busy text:if H.work_from_list || !A.agents_enabled() {A.t("Back to history list", "返回历史列表")} else {A.t("Back to agent status", "返回 Agent 状态")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.work_back()}
                work_refresh := mod.widgets.HagencyButton{enabled:!H.busy && A.work_enabled() text:A.t("Refresh page", "刷新此页") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_agent_work(H.agent_id,H.work_after,H.work_page)}
            }
            mod.widgets.HagencyTitle{text:A.t("Work history", "任务历史")}
            mod.widgets.HagencyCopy{text:A.work_name()}
            mod.widgets.HagencyHint{text:A.t("Recorded calls and Matrix reply delivery. These records do not prove the agent is currently running.", "查看已记录的调用与 Matrix 回复发送结果。这些记录不能证明 Agent 当前正在运行。")}
            if !A.work_enabled() {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Not enabled on this server", "此服务器尚未启用")}
                mod.widgets.HagencyCopy{text:A.t("This server does not advertise shared-agent work history. Existing request and status records remain separate.", "此服务器未提供共享 Agent 任务历史。申请与阶段状态仍是独立记录。")}
            }} else {mod.widgets.HagencySection{
                if H.agent_work == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading work records…", "正在读取任务记录…")} else {A.t("History could not be read. Refresh this page to try again.", "未能读取历史，请刷新此页重试。")}}}
                if H.agent_work != nil {mod.widgets.HagencySection{
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Observed", "查询时间")} mod.widgets.HagencyCopy{text:H.agent_work.observedAtUtc}}
                    mod.widgets.HagencyHint{text:A.t("Page ", "第 ")+H.work_page+A.t(" · ordered by record ID", " 页 · 按记录标识排序")}
                    if H.agent_work.work.items.len() == 0 {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("No work records on this page", "此页暂无任务记录")}
                        mod.widgets.HagencyCopy{text:A.t("No history is not zero usage. Only recorded shared-agent calls appear here.", "暂无历史不等于零用量，此处仅显示已记录的共享 Agent 调用。")}
                    }}
                    for row in H.agent_work.work.items {mod.widgets.HagencySection{
                        mod.widgets.HagencyDivider{}
                        mod.widgets.HagencySectionTitle{text:A.work_state(row.state)}
                        mod.widgets.HagencyHint{text:row.id}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Requested by", "发起人")} mod.widgets.HagencyCopy{text:row.requesterMxid}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Reply delivery", "回复发送")} mod.widgets.HagencyCopy{text:A.work_reply(row.replyState)}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Queued at", "排队时间")} mod.widgets.HagencyCopy{text:A.work_time(row.createdAtUtc)}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Started at", "开始时间")} mod.widgets.HagencyCopy{text:A.work_time(row.startedAtUtc)}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Finished at", "结束时间")} mod.widgets.HagencyCopy{text:A.work_time(row.completedAtUtc)}}
                        if row.usage == nil {mod.widgets.HagencyCopy{text:A.t("Usage not yet recorded", "用量尚未记录")}} else {mod.widgets.HagencySection{
                            mod.widgets.HagencyCopy{text:if row.usage.complete {A.t("Complete usage record", "用量记录完整")} else {A.t("Partial usage · more accounting is required", "用量记录不完整 · 仍需核算")}}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Server-confirmed consumption", "服务端已确认消耗")} mod.widgets.HagencyCopy{text:A.amount(row.usage.knownConsumedTokens)+" token"}}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Retained accounting", "保留记账量")} mod.widgets.HagencyCopy{text:if row.usage.retainedTokens == nil {A.t("Unknown", "未知")} else {A.amount(row.usage.retainedTokens)+" token"}}}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("UTC period", "UTC 记账月份")} mod.widgets.HagencyCopy{text:row.usage.periodKey}}
                        }}
                    }}
                    mod.widgets.HagencyHint{text:A.t("Amounts belong to individual calls. Retained accounting includes known consumption; it is not remaining resource capacity. A completed response does not guarantee complete usage accounting.", "以上数量仅对应单次调用。保留记账量包含已知消耗，并非资源剩余额度。响应完成不代表用量核算已完成。")}
                    mod.widgets.HagencyActions{
                        work_first := mod.widgets.HagencyButton{enabled:!H.busy && H.work_after != nil text:A.t("First page", "首页") on_click: || A.open_agent_work(H.agent_id,nil,1)}
                        if H.agent_work.work.nextAfter != nil {View{width:Fit height:Fit work_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page", "下一页") on_click: || A.open_agent_work(H.agent_id,H.agent_work.work.nextAfter,H.work_page+1)}}}
                    }
                }}
            }}
        }}
        if H.page == "allocations" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencySection{
                allocation_project_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to project", "返回项目") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_project(H.allocation_project)}
                mod.widgets.HagencyTitle{text:A.t("Project allocations", "项目分配")}
                mod.widgets.HagencyHint{text:A.t("After project approval, the resource owner decides its reservation. Their device checks the original grant and records the native result.", "项目获批后，由资源所有者决定预留，其设备检查原始授权并记录原生结果。")}
                allocation_list_refresh := mod.widgets.HagencyButton{enabled:!H.busy && A.allocations_enabled() text:A.t("Refresh", "刷新") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_allocations(H.allocation_project,H.allocation_after,H.allocation_page)}
            }
            allocation_list_state := mod.widgets.HagencySection{
                if !A.allocations_enabled() {mod.widgets.HagencyCopy{text:A.t("Project reservations are not enabled on this server.", "此服务器尚未启用项目预留。")}}
                else if H.allocation_list == nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading allocation records…", "正在读取分配记录…")} else {A.t("The records could not be read. Refresh to try again.", "未能读取记录，请刷新后重试。")}}}
                else if H.allocation_list.allocations.items.len() == 0 {mod.widgets.HagencyCopy{text:A.t("No allocations in this view", "当前视图暂无分配")}
                    mod.widgets.HagencyHint{text:A.t("A project needs server approval and a current owner grant that includes its manager. No allocation record is not a measurement of free capacity.", "项目需要服务器审批，以及包含此项目经理的有效资源主人授权。暂无分配记录不代表可用容量为零。")}}
            }
            if H.allocation_list != nil {mod.widgets.HagencySection{
                for detail in H.allocation_list.allocations.items {mod.widgets.HagencyCard{
                    mod.widgets.HagencyTitle{text:detail.projectName}
                    mod.widgets.HagencyCopy{text:detail.resourceLabel}
                    mod.widgets.HagencyCopy{text:A.allocation_state(detail.allocation.state)}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project amount", "项目额度")} mod.widgets.HagencyCopy{text:A.amount(detail.allocation.requestedTokens)+" token · "+detail.allocation.periodKey+" UTC"}}
                    mod.widgets.HagencyHint{text:A.t("Allocation", "分配")+" · "+detail.allocation.id}
                    allocation_list_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Review allocation", "查看分配") on_click: || {H.allocation_from_inbox=false A.open_allocation(detail.allocation.id)}}
                }}
                mod.widgets.HagencyHint{text:A.t("Observed", "观察时间")+" · "+H.allocation_list.observedAtUtc}
                mod.widgets.HagencyActions{
                    if H.allocation_page > 1 {View{width:Fit height:Fit allocation_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page", "第一页") on_click: || A.open_allocations(H.allocation_project,nil,1)}}}
                    if H.allocation_list.allocations.nextAfter != nil {View{width:Fit height:Fit allocation_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page", "下一页") on_click: || A.open_allocations(H.allocation_project,H.allocation_list.allocations.nextAfter,H.allocation_page+1)}}}
                }
            }}
        }}
        if H.page == "allocation_action" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencySection{
                allocation_back := mod.widgets.HagencyButton{enabled:!H.busy text:if H.allocation_from_inbox {A.t("Back to Inbox", "返回待办")} else {A.t("Back to allocations", "返回分配列表")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.allocation_back()}
                mod.widgets.HagencyTitle{text:A.t("Project allocation", "项目分配")}
                allocation_refresh := mod.widgets.HagencyButton{enabled:!H.busy && A.allocations_enabled() text:A.t("Refresh status", "刷新状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_allocation(H.allocation_id)}
            }
            if H.allocation_detail == nil {mod.widgets.HagencySection{mod.widgets.HagencyHint{text:if !A.allocations_enabled() {A.t("Project reservations are not enabled on this server.", "此服务器尚未启用项目预留。")} else if H.busy {A.t("Reading allocation records…", "正在读取分配记录…")} else {A.t("The record could not be read. Refresh or recover the original saved request.", "未能读取记录，请刷新或恢复原始保存的请求。")}}}}
            if H.allocation_detail != nil {mod.widgets.HagencySection{
                let detail=H.allocation_detail.detail
                let row=detail.allocation
                mod.widgets.HagencyTitle{text:detail.projectName}
                mod.widgets.HagencyCopy{text:detail.resourceLabel}
                mod.widgets.HagencyCopy{text:A.allocation_state(row.state)}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project amount", "项目额度")} mod.widgets.HagencyCopy{text:A.amount(row.requestedTokens)+" token"}}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Accounting period", "核算周期")} mod.widgets.HagencyCopy{text:row.periodKey+" UTC"}}
                if H.allocation_confirmation != "" && H.command == nil {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:if H.allocation_confirmation == "release" {A.t("Confirm release request", "确认申请释放")} else if H.allocation_confirmation == "approve" {A.t("Confirm this project reservation", "确认此项目预留")} else {A.t("Decline this allocation?", "拒绝此分配吗？")}}
                    mod.widgets.HagencyHint{text:if H.allocation_confirmation == "release" {A.t("The native ledger must confirm cleanup. Consumed tokens and uncertain usage stay retained; this does not promise an immediate refund.", "需要原生账本确认清理。已消耗的 token 与未知用量仍会保留，不保证立即退回额度。")} else {A.t("The approved project amount is fixed. Approval requests a native reservation within the owner's existing delegation; it does not start an agent or require another owner approval.", "已批准的项目额度固定。此批准在资源主人已有委托内申请原生预留，不会启动 Agent，也不需要主人再次审批。")}}
                    mod.widgets.HagencyActions{
                        allocation_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel", "取消") on_click: || {H.allocation_confirmation="" A.redraw()}}
                        allocation_confirm := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Confirm", "确认") on_click: || {if H.allocation_confirmation == "release" {A.allocation_release()} else {A.allocation_decide(H.allocation_confirmation == "approve")}}}
                    }
                }}
                if H.allocation_confirmation == "" && H.command == nil && (row.canDecide || row.canRelease) {mod.widgets.HagencyActions{
                    if row.canDecide && detail.request.canDecide {View{width:Fit height:Fit allocation_reject := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Decline allocation", "拒绝分配") on_click: || {H.allocation_confirmation="reject" A.redraw()}}}}
                    if row.canDecide && detail.request.canDecide {View{width:Fit height:Fit allocation_approve := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Approve reservation", "批准预留") on_click: || {H.allocation_confirmation="approve" A.redraw()}}}}
                    if row.canRelease {View{width:Fit height:Fit allocation_release := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Request release", "申请释放") on_click: || {H.allocation_confirmation="release" A.redraw()}}}}
                }}
                if row.blockingReason != nil {mod.widgets.HagencyHint{text:A.allocation_reason(row.blockingReason)}}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Owner grant", "资源主人授权")}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Grant status", "授权状态")} mod.widgets.HagencyCopy{text:if detail.grant.state == "active" {A.t("Recorded as active · native checks still apply", "记录为有效 · 仍须原生检查")} else if detail.grant.state == "revoked" {A.t("Revoked", "已撤销")} else if detail.grant.state == "expired" {A.t("Expired", "已过期")} else {A.t("Recorded state · ", "已记录状态 · ")+detail.grant.state}}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Available / total", "可用 / 总量")} mod.widgets.HagencyCopy{text:A.amount(detail.grant.nativeAvailableTokens)+" / "+A.amount(detail.grant.totalTokens)+" token"}}
                    mod.widgets.HagencyHint{text:A.t("Total is the original owner grant. Current available capacity is checked on the owner's device; this server view does not estimate it from project requests.", "总量为资源主人的原始授权额度。当前可用容量由主人设备检查，此服务器视图不会根据项目申请推算余额。")}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Period starts", "周期开始")} mod.widgets.HagencyCopy{text:detail.grant.periodStartUtc}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Period ends", "周期结束")} mod.widgets.HagencyCopy{text:detail.grant.periodEndUtc}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Delegation ends", "委托到期")} mod.widgets.HagencyCopy{text:detail.grant.delegationExpiresAtUtc}}
                }
                native_balance := mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Native ledger evidence", "原生账本记录")}
                    if row.balance == nil {mod.widgets.HagencyHint{text:A.t("No applied native balance recorded", "尚无已生效的原生余额记录")}}
                    else {mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Retained tokens", "保留 token")} mod.widgets.HagencyCopy{text:A.amount(row.balance.retainedTokens)+" token"}}
                        mod.widgets.HagencyHint{text:A.allocation_state(row.balance.state)}}
                    if row.observedUsage != nil {mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Server-confirmed consumption", "服务端已确认消耗")} mod.widgets.HagencyCopy{text:A.amount(row.observedUsage.knownConsumedTokens)+" token"}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Retained lower bound", "保留量下限")} mod.widgets.HagencyCopy{text:A.amount(row.observedUsage.retainedTokensFloor)+" token"}}
                        if row.observedUsage.requiresReconciliation {mod.widgets.HagencyHint{text:A.t("Usage requires native reconciliation", "用量需要原生核算")}}}
                    mod.widgets.HagencyHint{text:A.t("Retained tokens include spent or unresolved usage. A rejected release does not erase the last applied balance.", "保留 token 包含已消耗或未明确的用量，释放被拒绝不会清除上次已生效的余额。")}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("People and record", "人员与记录")}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project manager", "项目经理")} mod.widgets.HagencyCopy{text:row.requesterMxid}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Resource owner", "资源所有者")} mod.widgets.HagencyCopy{text:row.coordinatorMxid}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Resource owner", "资源主人")} mod.widgets.HagencyCopy{text:detail.grant.ownerMxid}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Allocation", "分配")} mod.widgets.HagencyCopy{text:row.id}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Observed", "观察时间")} mod.widgets.HagencyCopy{text:H.allocation_detail.observedAtUtc}}
                }
            }}
        }}
        if H.page == "project_wizard" && A.projects_enabled() {
            mod.widgets.HagencyHint{text:A.t("PROJECT REQUEST", "项目申请") + "  " + (H.project_draft.step + 1) + " / 3"}
            if H.project_draft.step == 0 {
                mod.widgets.HagencyCard{
                    mod.widgets.HagencyTitle{text:A.t("Choose a resource", "选择资源")}
                    mod.widgets.HagencyCopy{text:A.t("Browse resources admitted to this server and choose the capabilities your project needs.", "浏览此服务器已获准的资源，选择符合项目需求的能力。")}
                    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                        catalog_all := mod.widgets.HagencyChoice{draw_bg.color:if H.catalog_capability == "" {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} text:A.t("All", "全部") on_click: || {H.catalog_capability="" A.load_catalog()}}
                        catalog_coding := mod.widgets.HagencyChoice{draw_bg.color:if H.catalog_capability == "coding" {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} text:A.t("Coding", "编程") on_click: || {H.catalog_capability="coding" A.load_catalog()}}
                        catalog_docs := mod.widgets.HagencyChoice{draw_bg.color:if H.catalog_capability == "documentation" {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} text:A.t("Documentation", "文档") on_click: || {H.catalog_capability="documentation" A.load_catalog()}}
                        catalog_review := mod.widgets.HagencyChoice{draw_bg.color:if H.catalog_capability == "review" {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} text:A.t("Review", "评审") on_click: || {H.catalog_capability="review" A.load_catalog()}}
                        catalog_testing := mod.widgets.HagencyChoice{draw_bg.color:if H.catalog_capability == "testing" {mod.widgets.RINX_SELECTED} else {mod.widgets.RINX_SURFACE} text:A.t("Testing", "测试") on_click: || {H.catalog_capability="testing" A.load_catalog()}}
                    }
                    mod.widgets.HagencyHint{text:A.t("Capacity is confirmed during allocation. Selecting a resource does not reserve tokens.", "可用容量将在分配时确认，选择资源不会预留 token。")}
                }
                if H.catalog.len() == 0 {mod.widgets.HagencyCard{
                    mod.widgets.HagencyCopy{text:A.t("No matching admitted resources", "暂无匹配的已获准资源")}
                    mod.widgets.HagencyHint{text:A.t("Try another capability, or wait for the resource owner's admission request to be approved.", "请尝试其他能力筛选，或等待资源主人的准入申请获批。")}
                }}
                for row in H.catalog {mod.widgets.HagencyCard{
                    mod.widgets.HagencyCopy{text:row.label}
                    mod.widgets.HagencyHint{text:row.runtime + " · " + A.t("Admission approved", "准入已批准")}
                    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                        for capability in row.capabilities {mod.widgets.RinxHint{padding:0 text:A.capability_label(capability)}}
                    }
                    mod.widgets.HagencyHint{text:A.t("Resource owner", "资源所有者") + " · " + row.coordinatorMxid}
                    choose_resource := mod.widgets.RinxKeyPrimaryButton{text:A.t("Use this resource", "选择此资源") on_click: || A.choose_project_resource(row)}
                }}
                if H.catalog_after != nil {more := mod.widgets.HagencyButton{text:A.t("Next page", "下一页") on_click: || A.more()}}
            }
            if H.project_draft.step == 1 && H.project_draft.resource != nil {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Describe your project", "说明项目需求")}
                mod.widgets.HagencyHint{text:H.project_draft.resource.label + " · " + H.project_draft.resource.runtime}
                mod.widgets.HagencyCopy{text:A.t("Project name", "项目名称")}
                project_name := mod.widgets.HagencyInput{empty_text:A.t("e.g. Documentation launch","例如：文档发布项目") text:H.project_draft.name on_change:|text| A.project_field("name", text)}
                mod.widgets.HagencyCopy{text:A.t("What will the project do?", "项目计划做什么？")}
                project_purpose := mod.widgets.HagencyInput{empty_text:A.t("What should this project accomplish?","这个项目要完成什么？") text:H.project_draft.purpose on_change:|text| A.project_field("purpose", text)}
                mod.widgets.HagencyCopy{text:A.t("Requested monthly tokens", "申请的每月 token 数量")}
                project_tokens := mod.widgets.HagencyInput{text:H.project_draft.tokens on_change:|text| A.project_field("tokens", text)}
                mod.widgets.HagencyHint{text:A.t("Describe the work and capacity you need. The resource owner allocates capacity after server administrator approval.", "请说明工作内容与容量需求。服务器管理员批准后，由资源所有者分配容量。")}
                project_review := mod.widgets.RinxKeyPrimaryButton{text:A.t("Review request", "核对申请") on_click: || A.project_step(2)}
            }}
            if H.project_draft.step == 2 && H.project_draft.resource != nil {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Review your project request", "核对项目申请")}
                mod.widgets.HagencyCopy{text:H.project_draft.name}
                mod.widgets.HagencyHint{text:H.project_draft.purpose}
                RoundedView{width:Fill height:Fit flow:Down padding:16 spacing:8 draw_bg +: {color:mod.widgets.RINX_SELECTED border_radius:theme.corner_radius}
                    mod.widgets.HagencyCopy{text:H.project_draft.tokens + A.t(" tokens/month requested", " token/月申请额度")}
                    mod.widgets.HagencyHint{text:H.project_draft.resource.label}
                }
                mod.widgets.HagencyHint{text:A.t("Project manager", "项目经理") + " · " + H.session.account}
                mod.widgets.HagencyHint{text:A.t("Approver", "审批人") + " · " + H.session.administrator}
                mod.widgets.HagencyHint{text:A.t("Resource owner", "资源所有者") + " · " + H.project_draft.resource.coordinatorMxid}
                mod.widgets.HagencyHint{text:A.t("Approval records permission to proceed. It does not reserve capacity, create Matrix rooms or start an agent.", "审批记录项目的开展许可，不会预留容量、创建 Matrix 房间或启动 Agent。")}
                project_submit := mod.widgets.RinxKeyPrimaryButton{text:A.t("Submit project request", "提交项目申请") icon_walk:Walk{width:18 height:18} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.request_project()}
            }}
            if H.project_draft.step > 0 && H.command == nil {project_back := mod.widgets.HagencyButton{text:A.t("Back", "上一步") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.project_step(H.project_draft.step - 1)}}
        }
        if H.page == "project_action" && H.project_selected != nil && A.projects_enabled() {mod.widgets.HagencyDetailCard{
            let project = H.project_selected
            mod.widgets.HagencyActions{
                project_list_back := mod.widgets.HagencyButton{visible:H.ux.origin=="" enabled:!H.busy text:A.t("All projects","全部项目") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.return_list("projects")}
            }
            mod.widgets.HagencyTitle{text:project.name}
            mod.widgets.HagencyStatus{
                Icon{width:24 height:24 draw_icon +: {svg:if project.state == "approved" {mod.rinx_icons.check} else {mod.rinx_icons.inbox} color:mod.widgets.RINX_ACCENT}}
                mod.widgets.HagencyCopy{text:A.project_state_text(project.state)}
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencyEyebrow{text:A.t("NEXT STEP","下一步")}
                mod.widgets.HagencySectionTitle{text:A.project_next(project)}
                mod.widgets.HagencyHint{text:A.t("Responsible · ","负责人 · ")+A.project_actor(project)}
                if project.state=="approved" && A.project_plan(project).target!="" {View{width:Fit height:Fit
                    project_continue := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.project_plan(project).label icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.project_continue()}
                }}
            }
            View{width:Fill height:Fit flow:Down spacing:8
                let progress=H.ux.projectProgress
                let stages=[
                    {title:A.t("1 · Approval","1 · 审批") state:A.project_state_text(project.state) done:project.state=="approved"},
                    {title:A.t("2 · Capacity","2 · 容量") state:if project.state!="approved"{A.t("After approval","审批后进行")}else if progress==nil{A.t("Check required","需要检查")}else if progress.readiness.capacityReady{A.t("Reservation verified","预留已验证")}else if A.project_capacity(){A.t("Reservation available","已有可用预留")}else{A.t("Reservation needed","需要预留资源")} done:progress!=nil && progress.readiness.capacityReady},
                    {title:A.t("3 · Workspace","3 · 工作区") state:if progress!=nil && progress.readiness.matrixReady{A.t("Verification recorded","已记录验证")}else{A.t("Verification required","需要验证")} done:progress!=nil && progress.readiness.matrixReady},
                    {title:A.t("4 · Agents","4 · Agent") state:A.t("Readiness tracked in Agents","就绪状态见 Agent 页") done:false}
                ]
                for rowIndex in 2 {View{width:Fill height:Fit flow:Right spacing:8
                    for column in 2 {RoundedView{width:Fill height:Fit flow:Down spacing:6 padding:12 draw_bg +: {color:mod.widgets.RINX_PAGE border_radius:theme.corner_radius}
                    let stage=stages[rowIndex*2+column]
                    mod.widgets.HagencySectionTitle{text:stage.title}
                    mod.widgets.HagencyHint{text:stage.state draw_text.color:if stage.done{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
                }}
                }}
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Requested by", "申请人")}
                    mod.widgets.HagencyCopy{text:project.managerMxid}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Resource", "资源")}
                    mod.widgets.HagencyCopy{text:project.resourceLabel}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Purpose", "项目用途")}
                    mod.widgets.HagencyCopy{text:project.purpose}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Requested budget", "申请额度")}
                    mod.widgets.HagencyCopy{text:A.amount(project.requestedTokens) + A.t(" tokens/month requested", " token/月申请额度")}
                }
            }
            mod.widgets.HagencySection{
                if project.allocationStatus == "resource_unavailable" {
                    mod.widgets.HagencyCopy{text:A.t("The selected resource is no longer available", "所选资源已不可用")}
                    mod.widgets.HagencyHint{text:A.t("This request cannot proceed with that resource. Its history is retained; choose another resource for a new request.", "此申请无法继续使用该资源，历史记录会保留。请为新申请选择其他资源。")}
                } else if project.state == "approved" {
                    mod.widgets.HagencyHint{text:A.t("The project is approved. Capacity, Matrix verification and agent approval are tracked separately above.","项目已批准，上方分别显示容量、Matrix 验证与 Agent 审批。")}
                } else if project.state == "expired" {
                    mod.widgets.HagencyHint{text:A.t("This request expired before a decision. Submit a new request if the project is still needed.", "此申请在审批前已过期。如仍需开展项目，请重新申请。")}
                }
                if project.request.canDecide && H.command == nil && H.confirm == "" {
                    mod.widgets.HagencyCopy{text:A.t("Approve this project request?", "批准此项目申请吗？")}
                    mod.widgets.HagencyHint{text:A.t("This decision approves the project plan. It does not allocate the resource or start an agent.", "此决定批准项目计划，不会分配资源或启动 Agent。")}
                    mod.widgets.HagencyActions{
                        project_reject := mod.widgets.HagencyButton{text:A.t("Decline", "拒绝") on_click: || {H.confirm="project_reject" A.redraw()}}
                        project_approve := mod.widgets.RinxKeyPrimaryButton{text:A.t("Approve project", "批准项目") on_click: || {H.confirm="project_approve" A.redraw()}}
                    }
                }
                if H.confirm == "project_approve" || H.confirm == "project_reject" || H.confirm == "project_revoke" {
                    mod.widgets.HagencyCopy{text:if H.confirm == "project_approve" {A.t("Confirm project approval", "确认批准项目")} else if H.confirm == "project_revoke" {A.t("Withdraw this project request?", "撤回此项目申请吗？")} else {A.t("Confirm project rejection", "确认拒绝项目")}}
                    if H.confirm == "project_revoke" {mod.widgets.HagencyHint{text:A.t("The request closes and its history remains. You can submit another project request later.", "申请将关闭并保留历史记录，之后仍可提交新的项目申请。")}}
                    mod.widgets.HagencyActions{
                        project_cancel := mod.widgets.HagencyButton{text:A.t("Cancel", "取消") on_click: || {H.confirm="" A.redraw()}}
                        project_confirm := mod.widgets.RinxKeyPrimaryButton{text:A.t("Confirm", "确认") on_click: || {if H.confirm == "project_revoke" {A.revoke_project()} else {A.decide_project(H.confirm == "project_approve")}}}
                    }
                }
            }
            mod.widgets.HagencyRow{
                mod.widgets.HagencyHint{text:A.t("Resource · ","资源 · ")+project.resourceLabel}
                project_details := mod.widgets.HagencyButton{enabled:!H.busy text:if H.ux.projectTools{A.t("Hide details & tools","收起详情与工具")}else{A.t("Details & tools","详情与工具")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.activity on_click:||{H.ux.projectTools=!H.ux.projectTools A.redraw()}}
            }
            if H.ux.projectTools {mod.widgets.HagencySection{
            mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Resource connection", "资源连接")}
                mod.widgets.HagencyCopy{text:project.resourceLabel}
                if project.coordinatorMxid == H.session.account {
                    mod.widgets.HagencyHint{text:A.t("You own and coordinate this resource. Verify its executor connection from the original device.", "你拥有并协调此资源，请在原执行设备上验证连接。")}
                    mod.widgets.HagencyActions{
                        project_connection := mod.widgets.HagencyButton{text:A.t("View resource connection", "查看资源连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.open_connection(project.contributionId)}
                    }
                }
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Project responsibilities", "项目职责")}
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Project manager", "项目经理")}
                    mod.widgets.HagencyCopy{text:project.managerMxid}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Approver", "审批人")}
                    mod.widgets.HagencyCopy{text:project.request.approverMxid}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Resource owner", "资源所有者")}
                    mod.widgets.HagencyCopy{text:project.coordinatorMxid}
                }
            }
            mod.widgets.HagencyActions{
                if project.canRevoke && H.command == nil && H.confirm == "" {project_withdraw := mod.widgets.HagencyButton{text:A.t("Withdraw request", "撤回申请") on_click: || {H.confirm="project_revoke" A.redraw()}}}
                if A.allocations_enabled() {
                    View{width:Fit height:Fit
                        project_allocations := mod.widgets.HagencyButton{
                            enabled:!H.busy text:A.t("Project allocations", "项目分配")
                            icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources
                            on_click: || {H.allocation_from_inbox=false A.open_allocations(project.id,nil,1)}
                        }
                    }
                }
                if A.setup_enabled() {project_setup_open := mod.widgets.HagencyButton{text:A.t("Project setup", "项目设置") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.open_project_setup(project.id)}}
                if A.cleanup_enabled() {View{width:Fit height:Fit project_cleanup := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Agent removal and cleanup", "Agent 移除与清理") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_removals(project.id,nil,1)}}}
                if A.work_enabled() {View{width:Fit height:Fit project_work := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Project work history", "项目任务历史") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_work_list(project.id,nil,1)}}}
                if A.agents_enabled() {View{width:Fit height:Fit project_agents := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Project agents", "项目 Agent") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_project_agents(project.id)}}}
                project_update := mod.widgets.HagencyButton{text:A.t("Refresh status", "刷新状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.refresh()}
            }
            }}
        }}
        if H.page == "project_setup" && H.project_selected != nil && A.setup_enabled() {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencySection{
                setup_back := mod.widgets.HagencyButton{text:A.t("Back to project", "返回项目") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_project(H.project_selected.id)}
                mod.widgets.HagencyTitle{text:A.t("Project setup", "项目设置")}
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Project", "项目")}
                    mod.widgets.HagencyCopy{text:H.project_selected.name}
                }
            }
            if H.confirm == "project_setup" && H.setup_confirmation != nil {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:H.setup_confirmation.title}
                mod.widgets.HagencyCopy{text:H.setup_confirmation.detail}
                mod.widgets.HagencyActions{
                    setup_confirmation_cancel := mod.widgets.HagencyButton{text:A.t("Back", "返回") on_click: || {H.confirm="" H.setup_confirmation=nil A.redraw()}}
                    setup_confirmation_apply := mod.widgets.RinxKeyPrimaryButton{text:A.t("Confirm", "确认") on_click: || A.setup_apply()}
                }
            }}
            if H.setup_progress == nil {
                mod.widgets.HagencyCopy{text:if H.busy {A.t("Checking setup…", "正在检查设置…")} else {A.t("Refresh setup status to continue", "刷新设置状态后继续")}}
                if H.setup_recover_hint {mod.widgets.HagencyHint{text:A.t("The original request stays in native storage. Refresh to recover its result before starting another operation.", "原始请求保留在原生存储中。请刷新并恢复其结果，再执行其他操作。")}}
            } else {
                let p=H.setup_progress
                let r=p.readiness
                let allocation=A.setup_allocation()
                let blocker=if p.blocker != nil {p.blocker} else {r.blockingReason}
                let requirement_blocked=blocker == "live_reservation_required" || blocker == "project_administrator_required" || blocker == "project_administrator_changed"
                mod.widgets.HagencyStatus{
                    Icon{width:24 height:24 draw_icon +: {svg:if r.matrixReady {mod.rinx_icons.check} else {mod.rinx_icons.connection} color:mod.widgets.RINX_ACCENT}}
                    mod.widgets.HagencyCopy{text:if r.matrixReady {A.t("Matrix verification recorded", "已记录 Matrix 验证结果")} else if r.setup == nil {A.t("Setup not started", "设置尚未开始")} else if r.setup.state == "cancelled" {A.t("Setup cancelled", "设置已取消")} else {A.t("Setup in progress", "设置进行中")}}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Requirements", "设置条件")}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Reservation", "资源预留")}
                        mod.widgets.HagencyCopy{text:if r.capacityReady {A.t("Reservation verified at this check", "本次检查已验证资源预留")} else if allocation != nil {A.t("Replacement reservation available", "已有可用的替代资源预留")} else {A.t("No verified current reservation", "当前没有已验证的资源预留")}}
                    }
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Project manager", "项目经理")}
                        mod.widgets.HagencyCopy{text:H.project_selected.managerMxid}
                    }
                    if requirement_blocked {mod.widgets.HagencyCopy{text:A.setup_reason(blocker)}}
                    if r.setup != nil && r.setup.currentBinding != nil && r.administrator != nil && r.setup.currentBinding.administratorMxid != r.administrator.mxid {mod.widgets.HagencyHint{text:A.t("This workspace predates the combined project manager role. Update its requirements and verify access to continue.", "此工作区创建于项目经理角色合并前。请更新设置条件并验证访问权限后继续。")}}

                }
                mod.widgets.HagencyDivider{}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Matrix rooms", "Matrix 房间")}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Creation", "创建进度")}
                        mod.widgets.HagencyCopy{text:if r.setup == nil {A.t("Room creation has not begun", "尚未开始创建房间")} else if !p.localHistory {A.t("History is on the original device", "创建历史保存在原设备上")} else {A.t("Original creation history is saved", "原始创建历史已保存")}}
                    }
                    if r.setup != nil && !p.localHistory {
                        mod.widgets.HagencyHint{text:A.t("You can read the server result here. Continuing room creation requires the original device.", "可在此查看服务器结果；继续创建房间需要使用原设备。")}
                        if r.setup.spaceId != nil {mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project space", "项目空间")} mod.widgets.HagencyCopy{text:r.setup.spaceId}}}
                        if r.setup.roomId != nil {mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project room", "项目房间")} mod.widgets.HagencyCopy{text:r.setup.roomId}}}
                    }
                    if r.setup != nil && p.localHistory {
                        mod.widgets.HagencyDetailRow{
                            mod.widgets.HagencyFieldLabel{text:A.t("Project space", "项目空间")}
                            mod.widgets.HagencyCopy{text:A.setup_stage_text(p.space)}
                        }
                        if p.space != nil && p.space.roomId != nil {mod.widgets.HagencyHint{text:p.space.roomId}}
                        mod.widgets.HagencyDetailRow{
                            mod.widgets.HagencyFieldLabel{text:A.t("Project room", "项目房间")}
                            mod.widgets.HagencyCopy{text:A.setup_stage_text(p.room)}
                        }
                        if p.room != nil && p.room.roomId != nil {mod.widgets.HagencyHint{text:p.room.roomId}}
                    }
                    if r.setup != nil && p.localHistory && (A.setup_stage_unknown(p.space) || A.setup_stage_unknown(p.room)) {mod.widgets.HagencySection{
                        mod.widgets.HagencyHint{text:A.t("Optional: enter an existing room ID to locate the original marked room. These IDs cannot authorize a replacement room.", "可选：输入已有房间 ID，定位带有原始标记的房间。这些 ID 不能授权创建替代房间。")}
                        if A.setup_stage_unknown(p.space) {mod.widgets.HagencyFormGroup{
                            mod.widgets.HagencyCopy{text:A.t("Existing space ID", "已有空间 ID")}
                            setup_space_input := mod.widgets.HagencyInput{text:H.setup_space on_change:|text| {H.setup_space=text}}
                        }}
                        if A.setup_stage_unknown(p.room) {mod.widgets.HagencyFormGroup{
                            mod.widgets.HagencyCopy{text:A.t("Existing room ID", "已有房间 ID")}
                            setup_room_input := mod.widgets.HagencyInput{text:H.setup_room on_change:|text| {H.setup_room=text}}
                        }}
                    }}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Verification", "验证结果")}
                        mod.widgets.HagencyCopy{text:if r.matrixReady {A.t("Recorded by the server", "服务器已记录")} else {A.t("Not currently verified", "当前未验证")}}
                    }
                    if r.matrixReady {mod.widgets.HagencyHint{text:A.t("This is the last recorded Matrix check. Current reservation readiness is shown separately above.", "此处显示上一次已记录的 Matrix 检查，当前资源预留状态请见上方。")}}
                }
                if p.pendingCommands.len() > 0 {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Saved request", "已保存的请求")}
                    mod.widgets.HagencyHint{text:A.t("Recover the original request before starting another. Opening this page does not repeat a room-creation request.", "请先恢复原始请求再进行其他操作。打开此页面不会重复房间创建请求。")}
                    for command_id in p.pendingCommands {mod.widgets.HagencySection{
                        mod.widgets.HagencyHint{text:command_id}
                        setup_recover := mod.widgets.RinxKeyPrimaryButton{text:A.t("Recover original request", "恢复原始请求") on_click: || A.setup_prepare("retry", command_id)}
                    }}
                }}
                if p.failedCommands.len() > 0 {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Confirmed rejections", "已确认的拒绝结果")}
                    for row in p.failedCommands {mod.widgets.HagencySection{
                        mod.widgets.HagencyCopy{text:A.setup_reason(row.code)}
                        setup_dismiss := mod.widgets.HagencyButton{text:A.t("Dismiss confirmed rejection", "移除已确认的拒绝结果") on_click: || A.setup_prepare("acknowledge", row.commandId)}
                    }}
                }}
                if blocker != nil && !requirement_blocked {mod.widgets.HagencyHint{text:A.setup_reason(blocker)}}
                if H.confirm == "" && (A.setup_can_begin() || A.setup_can_continue() || A.setup_can_rebase() || (A.setup_idle() && r.canCancel && r.setup != nil)) {mod.widgets.HagencyActions{
                    if A.setup_can_begin() {View{width:Fit height:Fit setup_begin := mod.widgets.RinxKeyPrimaryButton{text:A.t("Begin setup", "开始设置") on_click: || A.setup_prepare("begin", nil)}}}
                    if A.setup_can_continue() {View{width:Fit height:Fit setup_continue := mod.widgets.RinxKeyPrimaryButton{text:if A.setup_stage_unknown(p.space) || A.setup_stage_unknown(p.room) {A.t("Recover room creation", "恢复房间创建")} else if r.matrixReady {A.t("Check Matrix setup", "检查 Matrix 设置")} else {A.t("Continue setup", "继续设置")} on_click: || A.setup_prepare("continue", nil)}}}
                    if A.setup_can_rebase() {View{width:Fit height:Fit setup_rebase := mod.widgets.HagencyButton{text:A.t("Update requirements", "更新设置条件") on_click: || A.setup_prepare("rebase", nil)}}}
                    if A.setup_idle() && r.canCancel && r.setup != nil {View{width:Fit height:Fit setup_cancel := mod.widgets.HagencyButton{text:A.t("Cancel setup", "取消设置") on_click: || A.setup_prepare("cancel", nil)}}}
                }}
                mod.widgets.HagencyHint{text:A.t("Matrix setup does not create or start an agent. Resource allocation and agent approval are separate steps.", "Matrix 设置不会创建或启动 Agent。资源分配与 Agent 审批是独立步骤。")}
            }
            setup_refresh := mod.widgets.HagencyButton{text:A.t("Refresh setup status", "刷新设置状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_project_setup(H.project_selected.id)}
        }}
        if H.page == "connections" {
            mod.widgets.HagencyActions{web_external_connections := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("External Matrix configuration","外部 Matrix 配置") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.web_connections_open(nil)}}
            mod.widgets.HagencyHint{text: A.t("Admission and connection verification are separate. Approval alone does not make an executor ready.", "准入审批与连接验证是两个步骤，获批不代表执行设备已经就绪。")}
            if H.connections.len() == 0 {mod.widgets.HagencyCard{mod.widgets.HagencyCopy{text:A.t("No connections yet", "尚无连接")} setup := mod.widgets.RinxKeyPrimaryButton{text:A.t("Connect a resource", "连接资源") on_click: || A.begin_setup()}}}
            for row in H.connections {mod.widgets.HagencyCard{
                mod.widgets.HagencyCopy{text: row.label}
                View{width:Fill height:Fit spacing:12 align:Align{y:0.5}
                    Icon{width:18 height:18 draw_icon +: {svg:mod.rinx_icons.connection color:mod.widgets.RINX_ACCENT}}
                    mod.widgets.HagencyCopy{text: A.connection_status(row)}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Owner", "主人")}
                        mod.widgets.HagencyCopy{text:row.ownerMxid}
                    }
                }
                open := mod.widgets.HagencyButton{text: A.t("View details", "查看详情") on_click: || A.open_connection(row.id)}
            }}
            if H.connection_after != nil {more := mod.widgets.HagencyButton{text:A.t("Next page", "下一页") on_click: || A.more()}}
        }
        if H.page == "inbox" && H.entry_role!="owner" {
            mod.widgets.HagencyTitle{text:if H.entry_role=="admin"{A.t("Resource admission","资源准入审批")}else{A.t("Inbox","待办")}}
            mod.widgets.HagencyHint{text:A.t("Decisions assigned to your account. Opening a request keeps it pending until you act.","这里显示分配给当前账号的审批。打开申请后，仍需明确操作才会完成。")}
            mod.widgets.HagencyActions{
                needs := mod.widgets.HagencyChoice{enabled:!H.busy draw_bg.color:if H.needs_action{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} draw_text.color:if H.needs_action{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} text:A.t("Needs my action","需要我处理") on_click:||A.inbox_filter(true)}
                history := mod.widgets.HagencyChoice{enabled:!H.busy draw_bg.color:if !H.needs_action{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} draw_text.color:if !H.needs_action{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK} text:A.t("All requests","全部请求") on_click:||A.inbox_filter(false)}
                if H.ux.inboxCursor!=nil || H.ux.agentCursor!=nil {View{width:Fit height:Fit inbox_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.inbox_filter(H.needs_action)}}}
            }
            mod.widgets.HagencyHint{text: A.t("Opening a request does not complete it. Its latest result is always shown.", "打开请求不会完成操作，详情始终显示最新结果。")}
            if H.ux.inboxReady && H.inbox.len()==0 && H.agents.len()==0 && !H.busy {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:if H.needs_action {A.t("You’re up to date","暂无待处理事项")}else{A.t("No requests on this page","此页暂无请求")}}
                mod.widgets.HagencyHint{text:A.t("New requests assigned to you will appear here, even when notification delivery is delayed.", "分配给你的新请求会出现在这里，即使通知延迟也不会丢失。")}
            }}
            if !H.ux.inboxReady {mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:if H.busy{A.t("Checking requests…","正在检查请求…")}else{if A.must_reopen(){A.t("Reopen Hagency to restore access","重新打开 Hagency 以恢复访问")}else if H.needs_signin{A.t("Sign in again to load Inbox","重新登录后加载待办")}else{A.t("Inbox could not be fully loaded","待办尚未完整加载")}}}
                mod.widgets.HagencyHint{text:if A.must_reopen(){A.t("Close this mini-app window, then open Hagency again from Mini apps. Your pending requests remain saved.","关闭此小应用窗口，然后从小应用重新打开 Hagency。待办记录仍会保留。")}else if H.needs_signin{A.t("Use Sign in again above with this same Matrix account. Pending requests remain saved.","请使用上方“重新登录”，登录同一 Matrix 账号。待办记录仍会保留。")}else{A.t("Refresh to check resource admission requests. Pending work stays saved.","刷新以检查资源准入申请，待办记录仍会保留。")}}
                if !H.busy && !A.must_reopen() && !H.needs_signin {View{width:Fit height:Fit inbox_retry := mod.widgets.RinxKeyPrimaryButton{text:A.t("Try again","重试") on_click:||A.load_inbox()}}}
            }}
            for row in H.inbox {mod.widgets.HagencyCard{
                let {projectName = nil, resourceLabel = nil} = row
                if row.kind == "project_allocation" {
                    mod.widgets.HagencyCopy{text:if projectName != nil {projectName} else {A.t("Project allocation", "项目分配")}}
                    mod.widgets.HagencyHint{text:A.t("Owner decision", "所有者决定")+" · "+A.allocation_state(row.state)}
                    if resourceLabel != nil {mod.widgets.HagencyHint{text:A.t("Resource", "资源")+" · "+resourceLabel}}
                } else if row.kind == "project_capacity" {
                    mod.widgets.HagencyCopy{text:if projectName != nil {projectName} else {A.t("Project request", "项目申请")}}
                    mod.widgets.HagencyHint{text:A.t("Project request", "项目申请") + " · " + A.project_state_text(row.state)}
                    if resourceLabel != nil {mod.widgets.HagencyHint{text:A.t("Resource", "资源") + " · " + resourceLabel}}
                } else if resourceLabel != nil {
                    mod.widgets.HagencyCopy{text:resourceLabel}
                    mod.widgets.HagencyHint{text:A.t("Resource admission", "资源准入") + " · " + A.state_text(row.state)}
                } else {
                    mod.widgets.HagencyCopy{text:if row.kind == "project_capacity" {A.t("Project request", "项目申请") + " · " + A.project_state_text(row.state)} else {A.t("Resource admission", "资源准入") + " · " + A.state_text(row.state)}}
                }
                mod.widgets.HagencyHint{text: A.t("Requested by", "申请人") + " · " + row.requesterMxid}
                mod.widgets.HagencyHint{text: A.t("Approver", "审批人") + " · " + row.approverMxid}
                open := mod.widgets.HagencyButton{text:A.t("Review request", "查看申请") on_click: || A.open_request(row.id)}
            }}
            if H.inbox_after != nil {View{width:Fit height:Fit more := mod.widgets.HagencyButton{text:A.t("Next page", "下一页") on_click: || A.more()}}}
            if A.agents_enabled() && (H.agents.len()>0 || H.agent_after!=nil) {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Agent requests", "Agent 申请")}
                if H.agents.len() == 0 {mod.widgets.HagencyHint{text:A.t("No agent requests in this view", "当前视图暂无 Agent 申请")}}
                for row in H.agents {mod.widgets.HagencyCard{
                    let {projectName=nil}=row
                    mod.widgets.HagencyCopy{text:row.definition.name}
                    if projectName != nil {mod.widgets.HagencyHint{text:projectName}}
                    mod.widgets.HagencyHint{text:A.agent_state_text(row.state)}
                    mod.widgets.HagencyHint{text:A.t("Requested by", "申请人") + " · " + row.managerMxid}
                    agent_inbox_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Review agent request", "查看 Agent 申请") on_click: || A.open_agent(row.id)}
                }}
                if H.agent_after != nil {View{width:Fill height:Fit agent_inbox_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next agent requests", "下一页 Agent 申请") on_click: || A.load_agents(H.agent_after)}}}
            }}
        }
        if H.page == "wizard" {
            mod.widgets.HagencyHint{text: A.t("SETUP", "资源设置") + "  " + (H.wizard.step + 1) + " / 5"}
            mod.widgets.HagencyProgress{value:(H.wizard.step+1)/5.0}
            if H.wizard.step == 0 {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Start with your server", "确认服务器与身份")}
                mod.widgets.HagencyCopy{text:H.session.account}
                mod.widgets.HagencyHint{text:A.t("This account owns and coordinates resources contributed from this device. The server administrator reviews admission.", "此账号拥有并协调从本设备贡献的资源，由服务器管理员审核准入。")}
                mod.widgets.HagencyHint{text:A.t("Admission approver", "准入审批人") + " · " + H.session.administrator}
                next := mod.widgets.RinxKeyPrimaryButton{text:A.t("Prepare this device", "准备此设备") on_click: || A.step(1)}
            }}
            if H.wizard.step == 1 {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Choose a provider account", "选择模型服务账号")}
                mod.widgets.HagencyHint{text:A.t("Hagency uses the provider already installed on this device. A native confirmation keeps credentials outside the mini app.", "Hagency 使用此设备上已安装的模型服务，原生确认界面会将凭据保留在小程序之外。")}
                for provider in H.providers {mod.widgets.HagencyCard{
                    mod.widgets.HagencyCopy{text: provider.runtime}
                    mod.widgets.HagencyHint{text: if provider.connected {A.t("Connected", "已关联")} else {A.t("Not connected", "未关联")}}
                    if provider.connected {
                        mod.widgets.HagencyHint{text: if provider.accountVerified {A.t("Account verified", "账号已验证")} else {A.t("Configuration found; account verification unavailable", "已发现配置，尚无法验证账号")}}
                        choose := mod.widgets.RinxKeyPrimaryButton{text:A.t("Choose models", "选择模型") on_click: || A.provider_selected(provider.runtime)}
                    } else {connect := mod.widgets.HagencyButton{text:A.t("Connect account", "关联账号") on_click: || A.connect_provider(provider.runtime)}}
                }}
                if H.providers.len() == 0 {reload := mod.widgets.HagencyButton{text:A.t("Check providers", "检测模型服务") on_click: || A.load_providers()}}
            }}
            if H.wizard.step == 2 {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Define your resource", "定义资源")}
                mod.widgets.HagencyHint{text:H.wizard.runtime + " · " + A.t("Models and reasoning levels below are available from your provider and accepted by the resource policy.", "以下模型与推理强度均来自当前模型服务目录，且符合资源策略。")}
                let choices = 0
                for provider in H.providers {if provider.runtime == H.wizard.runtime {
                    for model in provider.models {if model.sharedReasoning.len() > 0 {
                        choices += 1
                        mod.widgets.HagencyButton{width: Fill text: model.label + if H.wizard.model != nil && H.wizard.model.id == model.id {A.t(" · Selected", " · 已选择")} else {""} on_click: || A.select_model(model)}
                    }}
                }}
                if choices == 0 {mod.widgets.HagencyHint{text:A.t("No current model matches the resource policy. Choose another provider or update Hagency's model policy before continuing.", "当前模型均不符合资源策略，请选择其他模型服务，或更新 Hagency 的模型策略后继续。")}}
                if H.wizard.model != nil {
                    mod.widgets.HagencyCopy{text:A.t("Reasoning", "推理强度")}
                    View{width: Fill height: Fit flow: Flow.Right{wrap:true} spacing:8
                        for effort in H.wizard.model.sharedReasoning {mod.widgets.HagencyChoice{text: A.reasoning_label(effort) + if H.wizard.reasoning == effort {" •"} else {""} on_click: || {H.wizard.reasoning=effort A.save() A.redraw()}}}
                    }
                }
                mod.widgets.HagencyCopy{text:A.t("Monthly token limit", "每月 token 上限")}
                budget := mod.widgets.HagencyNumberInput{minimum:1 text:H.wizard.tokens on_change: |text| A.fields_changed("tokens", text)}
                mod.widgets.HagencyHint{text:A.t("− / + adjusts by 100,000 tokens; type any exact amount.","− / + 每次调整 10 万 token，也可输入精确数量。")}
                mod.widgets.HagencyHint{text:A.t("This limits the shared resource ledger. Provider enforcement and measured usage are shown separately.", "此额度限制共享资源账本，模型服务的实际限制与观测使用量会单独显示。")}
                create := mod.widgets.RinxKeyPrimaryButton{text:A.t("Save resource", "保存资源") on_click: || A.enroll()}
            }}
            if H.wizard.step == 3 {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.t("Request server admission", "申请服务器准入")}
                mod.widgets.HagencyHint{text:A.t("The resource is saved privately on this device. Choose a display name for its server connection.", "资源已私下保存在此设备上。请为服务器连接填写显示名称。")}
                mod.widgets.HagencyHint{text:A.t("After admission, signed-in applicants can see this pool and its owner. Provider credentials stay on this device; each Agent request needs your approval.", "准入获批后，已登录的申请者可以看到此资源池及其 owner。服务凭据保留在此设备，每个 Agent 的容量申请均由你审批。")}
                mod.widgets.HagencyCopy{text:A.t("Resource name", "资源名称")}
                resource_name := mod.widgets.HagencyInput{text:H.wizard.label on_change: |text| A.fields_changed("label", text)}
                mod.widgets.HagencyHint{text:A.t("You own this resource and approve Agent capacity requests.", "你是此资源的 owner，由你审批 Agent 容量申请。")}
                mod.widgets.HagencyHint{text:A.t("Admission approver", "准入审批人") + " · " + H.session.administrator}
                submit := mod.widgets.RinxKeyPrimaryButton{text:A.t("Submit admission request", "提交准入申请") on_click: || A.contribute()}
            }}
            if H.wizard.step == 4 && H.wizard.admission != nil {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text:A.connection_status(H.wizard.admission.contribution)}
                mod.widgets.HagencyCopy{text:H.wizard.admission.contribution.label}
                mod.widgets.HagencyHint{text:A.t("Approver", "审批人") + " · " + H.wizard.admission.request.approverMxid}
                mod.widgets.HagencyHint{text:A.t("Resource owner", "资源所有者") + " · " + H.wizard.admission.contribution.coordinatorMxid}
                View{width: Fill height: Fit flow: Down spacing: 12
                    let connection = H.wizard.admission.contribution
                    if A.can_resume(connection) && H.command == nil {
                        mod.widgets.HagencyCopy{text:A.t("Reconnect this device", "重新连接此设备")}
                        mod.widgets.HagencyHint{text:A.t("Check the saved resource and provider again after restarting. Your admission request and its decision stay in place.", "重启后重新检查已保存的资源和模型服务，保留原有准入申请与审批结果。")}
                        resume := mod.widgets.RinxKeyPrimaryButton{text:A.t("Check and reconnect", "检查并重新连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.resume(connection)}
                    }

                    if connection.state == "admitted" && !A.can_resume(connection) {
                        if connection.verification != nil && connection.verification.status == "verified" {
                            View{width: Fill height: Fit spacing: 12 align: Align{y: 0.5}
                                Icon{width: 24 height: 24 draw_icon +: {svg: mod.rinx_icons.check color: mod.widgets.RINX_ACCENT}}
                                mod.widgets.HagencyCopy{text:A.t("Executor and provider binding checked", "已检查执行设备与关联模型服务")}
                            }
                            mod.widgets.HagencyHint{text:A.t("This check expires after five minutes. Publish capacity so applicants can request Agents from this pool.", "本次检查五分钟后过期。发布容量后，申请者即可从此资源池申请 Agent。")}
                        } else {
                            mod.widgets.HagencyCopy{text:A.t("Next: verify the executor connection", "下一步：验证执行设备连接")}
                            mod.widgets.HagencyHint{text:A.t("Check that this device still has the admitted resource and its connected provider account.", "检查此设备是否仍保有已获准的资源及其关联的模型服务账号。")}
                        }
                        if A.can_verify(connection) && H.command == nil {
                            verify := mod.widgets.RinxKeyPrimaryButton{text:if connection.verification != nil && connection.verification.status == "verified" {A.t("Check again", "重新检查")} else {A.t("Verify connection", "验证连接")} icon_walk: Walk{width: 16 height: 16} draw_icon.svg: mod.rinx_icons.connection on_click: || A.verify(connection)}
                        } else if !A.can_verify(connection) && !A.can_resume(connection) {mod.widgets.HagencyHint{text:if connection.verification != nil && connection.verification.status == "verified" {A.t("The owner can renew this check from their enrolled device.", "资源主人可使用登记的设备重新检查连接。")} else {A.t("Waiting for the resource owner to verify from their enrolled device.", "等待资源主人使用登记的设备验证连接。")}}}
                    }
                }
                if H.wizard.admission.contribution.state != "admitted" {mod.widgets.HagencyHint{text:A.t("You can close this window. The request and its current result remain in Connections and Inbox.", "可以关闭此窗口，请求与最新结果会保留在连接列表和待办中。")}}
                update := mod.widgets.HagencyButton{text:A.t("Refresh status", "刷新状态") on_click: || A.refresh()}
            }}
            if H.wizard.step > 0 && H.wizard.step < 3 && H.command == nil {back := mod.widgets.HagencyButton{text:A.t("Back", "上一步") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.step(H.wizard.step - 1)}}
        }
        if H.page=="connection_history" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                history_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to connections","返回连接列表") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.navigate("connections")}
                history_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh page","刷新此页") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_connection_history(H.history_id,H.history_after,H.history_page)}
            }
            mod.widgets.HagencyTitle{text:A.t("Admission history","准入历史")}
            mod.widgets.HagencyHint{text:A.t("Each request keeps its own resource definition and decision. Earlier approvals do not approve later submissions.","每次申请分别保留资源定义和审批结果，早期审批不会批准后续申请。")}
            if H.connection_history==nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Loading admission history…","正在读取准入历史…")}else{A.t("History could not be read. Refresh to try again.","未能读取历史，请刷新后重试。")}}}
            else {
                mod.widgets.HagencyHint{text:A.t("Page ","第 ")+H.history_page+A.t(" · records visible to your account"," 页 · 当前账号可查看的记录")}
                if H.connection_history.items.len()==0 {mod.widgets.HagencyCopy{text:A.t("No admission records are visible on this page.","此页没有当前账号可查看的准入记录。")}}
                for entry in H.connection_history.items {mod.widgets.HagencySection{
                    mod.widgets.HagencyDivider{}
                    mod.widgets.HagencySectionTitle{text:entry.offer.label}
                    mod.widgets.HagencyCopy{text:A.state_text(entry.request.state)+if entry.current {A.t(" · Current request"," · 当前申请")}else{A.t(" · Earlier request"," · 历史申请")}}
                    if entry.offer.origin=="legacy_current" {mod.widgets.HagencyHint{text:A.t("Captured during upgrade. This is the definition available then, not a reconstructed original submission.","此定义在升级时保存，反映当时可读取的配置，未重建最初提交内容。")}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Coordinator in original request","原始请求中的协调者")} mod.widgets.HagencyCopy{text:entry.offer.coordinatorMxid}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Approver","审批人")} mod.widgets.HagencyCopy{text:entry.request.approverMxid}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Provider","模型服务")} mod.widgets.HagencyCopy{text:entry.offer.runtime}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Capabilities","能力")} View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8 for capability in entry.offer.capabilities {mod.widgets.RinxLabel{padding:0 text:A.capability_label(capability)}}}}
                    mod.widgets.HagencyHint{text:A.t("Request","申请")+" · "+entry.request.id}
                    mod.widgets.HagencyHint{text:A.t("Resource revision","资源版本")+" · "+entry.offer.resourceRevision}
                }}
                if H.history_after!=nil || H.connection_history.nextAfter!=nil {mod.widgets.HagencyActions{
                    history_first := mod.widgets.HagencyButton{enabled:!H.busy && H.history_after!=nil text:A.t("First page","第一页") on_click: || A.open_connection_history(H.history_id,nil,1)}
                    history_more := mod.widgets.HagencyButton{enabled:!H.busy && H.connection_history.nextAfter!=nil text:A.t("Next page","下一页") on_click: || {if H.connection_history.nextAfter!=nil {A.open_connection_history(H.history_id,H.connection_history.nextAfter,H.history_page+1)}}}
                }}
            }
        }}
        if H.page=="connection_reoffer" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{reoffer_back := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Back to connection","返回连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || {if H.selected!=nil {A.open_connection(H.selected.contribution.id)}}}}
            mod.widgets.HagencyTitle{text:A.t("Request admission again","重新申请准入")}
            if H.reoffer_draft==nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading the current connection and local resource…","正在读取当前连接与本机资源…")}else{A.t("Current details are unavailable. Return to the connection and try again.","当前详情不可用，请返回连接后重试。")}}}
            else {
                let d=H.reoffer_draft
                mod.widgets.HagencyHint{text:if d.review {A.t("2 / 2 · Review a new request","2 / 2 · 核对新申请")}else{A.t("1 / 2 · Confirm resource and owner","1 / 2 · 确认资源与所有者")}}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Existing local resource","已有本机资源")}
                    mod.widgets.HagencyCopy{text:d.resource.model+" · "+d.resource.framework}
                    mod.widgets.HagencyHint{text:A.t("Resource","资源")+" · "+d.resourceId}
                    mod.widgets.HagencyCopy{text:A.t("Admission approver","准入审批人")+" · "+H.session.administrator}
                    mod.widgets.HagencyHint{text:A.t("The original connection, grants and usage history remain. A new request needs a fresh administrator decision; it does not allocate capacity or start an agent.","保留原连接、授权及用量历史。新申请需要管理员重新审批，不会直接分配容量或启动 Agent。")}
                }
                if !d.review {
                    mod.widgets.HagencyCopy{text:A.t("Resource name","资源名称")}
                    reoffer_label := mod.widgets.HagencyInput{is_read_only:H.busy || H.command!=nil text:d.label on_change:|text| A.reoffer_field("label",text)}
                    mod.widgets.HagencyHint{text:A.t("The resource owner coordinates its capacity.","资源所有者负责协调容量。")}
                    mod.widgets.HagencyActions{reoffer_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Review new request","核对新申请") on_click: || A.review_reoffer()}}
                } else {
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Resource name","资源名称")} mod.widgets.HagencyCopy{text:d.label}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Resource owner","资源所有者")} mod.widgets.HagencyCopy{text:d.coordinatorMxid}}
                    mod.widgets.HagencyHint{text:A.t("Any unresolved grant or open project prevents submission. Existing retained usage is not refunded.","如有未解决的授权或仍开放的项目，将无法提交。已有保留用量不会退还。")}
                    mod.widgets.HagencyActions{
                        reoffer_edit := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Edit","修改") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || {d.review=false A.redraw()}}
                        reoffer_submit := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Submit new admission request","提交新准入申请") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.submit_reoffer()}
                    }
                }
            }
        }}

        if H.page=="action" && H.selected==nil {mod.widgets.HagencyCard{
            mod.widgets.HagencySectionTitle{text:if H.busy{A.t("Checking this connection…","正在检查此连接…")}else{A.t("Connection could not be loaded","无法加载此连接")}}
            mod.widgets.HagencyHint{text:if A.must_reopen(){A.t("Reopen Hagency from Mini apps to restore access.","请从小应用重新打开 Hagency，以恢复访问。")}else{A.t("Your resource and saved requests are retained. Retry to read this connection’s latest state.","资源与已保存的请求仍保留。重试以读取此连接的最新状态。")}}
            if !H.busy && !A.must_reopen() && H.ux.connectionId!="" {View{width:Fit height:Fit connection_retry := mod.widgets.RinxKeyPrimaryButton{text:A.t("Try again","重试") on_click:||A.open_connection(H.ux.connectionId)}}}
        }}
        if H.page == "action" && H.selected != nil {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencySection{
                if H.connection_project != nil && A.projects_enabled() {
                    mod.widgets.HagencyActions{connection_project_back := mod.widgets.HagencyButton{text:A.t("Back to project", "返回项目") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_project(H.connection_project)}}
                }
                mod.widgets.HagencyTitle{text:H.selected.contribution.label}
                if H.connection_project != nil && A.projects_enabled() {
                    if H.project_selected != nil && H.project_selected.id == H.connection_project {
                        mod.widgets.HagencyDetailRow{
                            mod.widgets.HagencyFieldLabel{text:A.t("Project", "项目")}
                            mod.widgets.HagencyCopy{text:H.project_selected.name}
                        }
                    }
                }
            }
            mod.widgets.HagencyStatus{
                Icon{width:24 height:24 draw_icon +: {svg:mod.rinx_icons.connection color:mod.widgets.RINX_ACCENT}}
                mod.widgets.HagencyCopy{text:A.connection_status(H.selected.contribution)}
            }
            if H.selected.contribution.state=="pending_admission" {mod.widgets.HagencySection{
                mod.widgets.HagencyEyebrow{text:A.t("NEXT STEP","下一步")}
                mod.widgets.HagencySectionTitle{text:if H.selected.request.canDecide{A.t("Review this resource’s admission","审核此资源的准入")}else{A.t("Waiting for server administrator","等待服务器管理员")}}
                mod.widgets.HagencyHint{text:A.t("Responsible · ","负责人 · ")+H.selected.request.approverMxid}
            }}
            if H.selected.contribution.state=="rejected" {mod.widgets.HagencySection{
                mod.widgets.HagencyEyebrow{text:A.t("NEXT STEP","下一步")}
                mod.widgets.HagencySectionTitle{text:A.t("Review the admission with your administrator","与管理员核对准入申请")}
                mod.widgets.HagencyHint{text:H.selected.request.approverMxid}
                mod.widgets.HagencyCopy{text:if A.readmission_enabled(){A.t("This request was declined. Your local resource is managed separately. Use Admission records below to review history and, when available, request admission again.","此申请已被拒绝，本机资源仍单独管理。请在下方准入记录中查看历史，并在条件允许时重新申请。")}else{A.t("This request was declined. Your local resource is managed separately. This server does not support resubmitting admission here; contact its administrator about the next request.","此申请已被拒绝，本机资源仍单独管理。此服务器暂不支持在这里重新提交准入申请，请与管理员确认后续申请方式。")}}
            }}
            mod.widgets.HagencySection{
                let connection = H.selected.contribution
                mod.widgets.HagencySectionTitle{text:A.t("Connection checks", "连接检查")}
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Server admission", "服务器准入")}
                    mod.widgets.HagencyCopy{text:A.state_text(connection.state)}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Executor check", "执行设备检查")}
                    mod.widgets.HagencyCopy{text:if connection.state != "admitted" {A.t("Requires admission", "需要先批准准入")} else if A.can_resume(connection) {A.t("Reconnect this device", "重新连接此设备")} else if connection.verification != nil && connection.verification.status == "verified" {A.t("Executor and provider binding checked", "已检查执行设备与关联模型服务")} else {A.t("Fresh check required", "需要重新检查")}}
                }
            }
            mod.widgets.HagencySection{
                let connection = H.selected.contribution
                    if A.can_resume(connection) && H.command == nil {
                        mod.widgets.HagencySectionTitle{text:A.t("Reconnect this device", "重新连接此设备")}
                        mod.widgets.HagencyHint{text:A.t("Check the saved resource and provider again after restarting. Your admission request and its decision stay in place.", "重启后重新检查已保存的资源和模型服务，保留原有准入申请与审批结果。")}
                        mod.widgets.HagencyActions{resume := mod.widgets.RinxKeyPrimaryButton{text:A.t("Check and reconnect", "检查并重新连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.resume(connection)}}
                    }

                if connection.state == "admitted" && !A.can_resume(connection) {
                    if connection.verification != nil && connection.verification.status == "verified" {
                        mod.widgets.HagencySectionTitle{text:A.t("Keep the connection current", "保持连接有效")}
                        mod.widgets.HagencyHint{text:A.t("This check expires after five minutes. Publish capacity so applicants can request Agents from this pool.", "本次检查五分钟后过期。发布容量后，申请者即可从此资源池申请 Agent。")}
                    } else {
                        mod.widgets.HagencySectionTitle{text:A.t("Next: verify the executor connection", "下一步：验证执行设备连接")}
                        mod.widgets.HagencyHint{text:A.t("Check that this device still has the admitted resource and its connected provider account.", "检查此设备是否仍保有已获准的资源及其关联的模型服务账号。")}
                    }
                    if A.can_verify(connection) && H.command == nil {
                        mod.widgets.HagencyActions{verify := mod.widgets.RinxKeyPrimaryButton{text:if connection.verification != nil && connection.verification.status == "verified" {A.t("Check again", "重新检查")} else {A.t("Verify connection", "验证连接")} icon_walk: Walk{width: 16 height: 16} draw_icon.svg: mod.rinx_icons.connection on_click: || A.verify(connection)}}
                    } else if !A.can_verify(connection) && !A.can_resume(connection) {mod.widgets.HagencyHint{text:if connection.verification != nil && connection.verification.status == "verified" {A.t("The owner can renew this check from their enrolled device.", "资源主人可使用登记的设备重新检查连接。")} else {A.t("Waiting for the resource owner to verify from their enrolled device.", "等待资源主人使用登记的设备验证连接。")}}}
                }
                }
            if H.selected.request.canDecide && H.command == nil && H.confirm == "" {
                mod.widgets.HagencyCopy{text:A.t("Allow this resource to join your server?", "允许此资源加入服务器吗？")}
                mod.widgets.HagencyHint{text:A.t("Approval admits the association. It does not allocate capacity or start an agent.", "此操作批准资源关联，不会分配容量或启动 Agent。")}
                View{width:Fill height:Fit spacing:8
                    reject := mod.widgets.HagencyButton{text:A.t("Decline", "拒绝") on_click: || {H.confirm="reject" A.redraw()}}
                    approve := mod.widgets.RinxKeyPrimaryButton{text:A.t("Approve admission", "批准准入") on_click: || {H.confirm="approve" A.redraw()}}
                }
            }
            mod.widgets.HagencyDivider{}
            mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("People and resource", "人员与资源")}
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Owner", "主人")}
                    mod.widgets.HagencyCopy{text:H.selected.contribution.ownerMxid}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Resource owner", "资源所有者")}
                    mod.widgets.HagencyCopy{text:H.selected.contribution.coordinatorMxid}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Approver", "审批人")}
                    mod.widgets.HagencyCopy{text:H.selected.request.approverMxid}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Provider", "模型服务")}
                    mod.widgets.HagencyCopy{text:H.selected.contribution.runtime}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Capabilities", "能力")}
                    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                        for capability in H.selected.contribution.capabilities {mod.widgets.RinxLabel{padding:0 text:A.capability_label(capability)}}
                    }
                }
            }
            if A.readmission_enabled() {
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Admission records","准入记录")}
                    mod.widgets.HagencyActions{
                        connection_history := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View admission history","查看准入历史") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_connection_history(H.selected.contribution.id,nil,1)}
                        if A.can_reoffer(H.selected) {connection_reoffer := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Request admission again","重新申请准入") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.begin_reoffer()}}
                    }
                }
            }
            if H.selected.contribution.state != "revoked" && !H.selected.request.canDecide && (H.selected.contribution.ownerMxid == H.session.account || H.session.canAdmitResources) && H.command == nil && H.confirm == "" {
                mod.widgets.HagencyActions{revoke := mod.widgets.HagencyButton{text:A.t("Revoke connection", "撤销连接") on_click: || {H.confirm="revoke" A.redraw()}}}
            }
            if H.confirm != "" {
                mod.widgets.HagencyCopy{text:if H.confirm == "approve" {A.t("Confirm admission approval", "确认批准准入")} else if H.confirm == "reject" {A.t("Confirm rejection", "确认拒绝")} else {A.t("Confirm revocation", "确认撤销")}}
                View{width:Fill height:Fit spacing:8
                    cancel := mod.widgets.HagencyButton{text:A.t("Cancel", "取消") on_click: || {H.confirm="" A.redraw()}}
                    confirm := mod.widgets.RinxKeyPrimaryButton{text:A.t("Confirm", "确认") on_click: || {if H.confirm == "revoke" {A.revoke()} else {A.decide(H.confirm == "approve")}}}
                }
            }
        }}
    }
}

mod.widgets.HagencyCard = RoundedView{width:Fill height:Fit flow:Down padding:(20 * mod.widgets.RINX_SPACING) spacing:12
    draw_bg +: {color:mod.widgets.RINX_SURFACE border_color:mod.widgets.RINX_BORDER border_size:0.5 border_radius:(theme.corner_radius + 4)}}
mod.widgets.HagencyButton = mod.widgets.RinxKeyButton{height:max(44,mod.widgets.RINX_CONTROL_HEIGHT) draw_bg +: {border_size:0.5 color:mod.widgets.RINX_FIELD}}
mod.widgets.HagencyIconButton = mod.widgets.HagencyButton{width:44 height:44 text:"" icon_walk:Walk{width:18 height:18}}
mod.widgets.HagencyTitle = mod.widgets.RinxPageTitle{width:Fill padding:0 flow:Flow.Right{wrap:true}}
mod.widgets.HagencyCopy = mod.widgets.RinxLabel{width:Fill padding:0 flow:Flow.Right{wrap:true}}
mod.widgets.HagencyHint = mod.widgets.RinxHint{width:Fill padding:0 flow:Flow.Right{wrap:true}}
mod.widgets.HagencyInput = mod.widgets.RinxInput{width:Fill{max:640} height:max(44,mod.widgets.RINX_CONTROL_HEIGHT) empty_text:""}
mod.widgets.HagencyNumberInput = mod.widgets.RinxNumberInput{width:Fill{max:640} empty_text:""}
mod.widgets.HagencyChoice = mod.widgets.HagencyButton{draw_bg +: {border_size:1 border_color:mod.widgets.RINX_BORDER border_radius:theme.corner_radius}}
mod.widgets.HagencyToggle = mod.widgets.RinxToggle{}
mod.widgets.HagencyDisclosure = mod.widgets.HagencyButton{draw_bg.border_size:0}
mod.widgets.HagencyFormGroup = RoundedView{width:Fill height:Fit flow:Down spacing:12 padding:16
    draw_bg +: {color:mod.widgets.RINX_FIELD border_color:mod.widgets.RINX_BORDER border_size:0.5 border_radius:theme.corner_radius}}
mod.widgets.HagencyProgress = mod.widgets.RinxProgress{}
mod.widgets.HagencyDetailCard = mod.widgets.HagencyCard{spacing:(16 * mod.widgets.RINX_SPACING)}
mod.widgets.HagencyRow = View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{top:8 bottom:8} align:Align{y:0.5}}
mod.widgets.HagencyDivider = SolidView{width:Fill height:1 draw_bg.color:mod.widgets.RINX_BORDER}
mod.widgets.HagencySection = View{width:Fill height:Fit flow:Down spacing:(8 * mod.widgets.RINX_SPACING)}
mod.widgets.HagencySectionTitle = mod.widgets.HagencyCopy{draw_text.text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE}}
mod.widgets.HagencyDetailRow = View{width:Fill height:Fit flow:Right spacing:12 align:Align{y:0.0}}
mod.widgets.HagencyFieldLabel = mod.widgets.HagencyHint{width:120}
mod.widgets.HagencyActions = View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8}
mod.widgets.HagencyStatus = RoundedView{width:Fill height:Fit flow:Right padding:12 spacing:12 align:Align{y:0.5}
    draw_bg +: {color:mod.widgets.RINX_SELECTED border_radius:theme.corner_radius}}
mod.widgets.HagencyBadge = RoundedView{width:40 height:40 align:Align{x:0.5 y:0.5}
    draw_bg +: {color:mod.widgets.RINX_SELECTED border_radius:(theme.corner_radius + 2)}}
mod.widgets.HagencyGlyph = Icon{width:20 height:20 icon_walk:Walk{width:20 height:20} draw_icon.color:mod.widgets.RINX_ACCENT}
mod.widgets.HagencyCardHeading = View{width:Fill height:Fit flow:Right spacing:12 align:Align{y:0.5}}
mod.widgets.HagencyHero = mod.widgets.HagencyCard{padding:(24 * mod.widgets.RINX_SPACING) spacing:16
    draw_bg +: {color:mod.widgets.RINX_ACCENT color_2:mod.widgets.RINX_ACCENT_DOWN gradient_fill_horizontal:1 border_size:0}}
mod.widgets.HagencyHeroTitle = mod.widgets.HagencyTitle{draw_text.color:mod.widgets.RINX_ON_ACCENT}
mod.widgets.HagencyHeroCopy = mod.widgets.HagencyCopy{draw_text.color:mod.widgets.RINX_ON_ACCENT}
mod.widgets.HagencyHeroButton = mod.widgets.RinxKeyButton{
    draw_bg +: {color:mod.widgets.RINX_ON_ACCENT color_hover:mod.widgets.RINX_ON_ACCENT color_down:mod.widgets.RINX_ON_ACCENT color_focus:mod.widgets.RINX_ON_ACCENT border_color:mod.widgets.RINX_ON_ACCENT}
    draw_text +: {color:mod.widgets.RINX_ACCENT color_hover:mod.widgets.RINX_ACCENT color_down:mod.widgets.RINX_ACCENT color_focus:mod.widgets.RINX_ACCENT}
    draw_icon.color:mod.widgets.RINX_ACCENT}
mod.widgets.HagencyStep = View{width:205 height:Fit padding:Inset{bottom:10} flow:Right spacing:10 align:Align{y:0.0}}
mod.widgets.HagencyEyebrow = mod.widgets.HagencyHint{draw_text +: {color:mod.widgets.RINX_ACCENT text_style:theme.font_bold{font_size:mod.widgets.RINX_META_SIZE}}}

if !mod.rinx_theme.reloading() {start_timeout(0.05, || A.connect()) start_timeout(15,||A.web_auto_refresh())}
if mod.rinx_theme.reloading() {start_timeout(0.05, || A.redraw())}

heading := View{width:Fill height:Fit flow:Down spacing:6 on_render:||{
    View{width:Fill height:Fit flow:Right spacing:12 align:Align{y:0.5}
        mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.hagency}}
        mod.widgets.HagencySectionTitle{text:if H.entry_role!="" && !H.entry_choosing{"Hagency · "+A.entry_label(H.entry_role)}else{"Hagency"}}
        entry_switch := mod.widgets.HagencyButton{visible:H.ready && H.entry_role!="" && !H.entry_choosing enabled:!H.busy text:A.t("Switch","切换") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.person on_click:||A.entry_switch()}
        refresh := mod.widgets.HagencyIconButton{enabled:!H.busy && !A.must_reopen() draw_icon.svg:mod.rinx_icons.refresh on_click:||A.refresh()}
    }
    workspace_account := mod.widgets.HagencyHint{text:if H.session==nil{A.t("Agents and resource pools","Agent 与资源池")}else{H.session.account}}
}}
navigation := View{width:Fill height:Fit flow:Right spacing:4 on_render:||{
    if H.ready && H.entry_role!="" && !H.entry_choosing {
        let parent=A.entry_parent()
        nav_overview := View{visible:true width:Fill height:Fit
            let active=parent=="overview"
            overview := mod.widgets.HagencyButton{width:Fill height:62 flow:Down spacing:4 padding:Inset{left:4 right:4 top:8 bottom:8} align:Align{x:0.5 y:0.5} enabled:!H.busy

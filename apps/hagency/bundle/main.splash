                    }}
                }}
            }}
        }}}
        if H.page=="execution_policy" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            if H.policy_detail==nil && H.busy {View{width:Fill height:Fit flow:Down spacing:12 align:Align{x:0.5} padding:Inset{top:6 bottom:14}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_FIELD}
                mod.widgets.HagencySkeleton{width:120 height:24}

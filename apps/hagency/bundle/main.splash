let A = {}
A.t = fn(en, zh){ if mod.rinx_i18n.language() == "zh-CN" { return zh } return en }
A.state_text = fn(state){
    if state == "pending_admission" || state == "pending" { return A.t("Awaiting administrator", "等待管理员审批") }
    if state == "admitted" || state == "approved" { return A.t("Admission approved", "准入已批准") }
    if state == "rejected" { return A.t("Declined", "已拒绝") }
    if state == "revoked" { return A.t("Revoked", "已撤销") }
    if state == "expired" { return A.t("Expired", "已过期") }
    return state
}
A.connection_status = fn(connection){
    if connection.state == "admitted" && connection.verification != nil {
        if connection.verification.status == "verified" {return A.t("Connection verified", "连接已验证")}
        return A.t("Connection needs a fresh check", "连接需要重新检查")
    }
    return A.state_text(connection.state)
}
A.can_resume = fn(connection){return (connection.state == "pending_admission" || connection.state == "admitted") && connection.ownerMxid == H.session.account && connection.executorDeviceId == H.session.device && connection.executorGeneration != H.session.deviceGeneration}
A.can_verify = fn(connection){return connection.state == "admitted" && connection.ownerMxid == H.session.account && connection.executorDeviceId == H.session.device && connection.executorGeneration == H.session.deviceGeneration}
A.projects_enabled = fn(){return false}

A.project_state_text = fn(state){
    if state == "pending_approval" || state == "pending" {return A.t("Awaiting project approval", "等待项目审批")}
    if state == "approved" {return A.t("Project request approved", "项目申请已批准")}
    if state == "rejected" {return A.t("Project request declined", "项目申请已拒绝")}
    if state == "revoked" {return A.t("Project request withdrawn", "项目申请已撤回")}
    if state == "expired" {return A.t("Project request expired", "项目申请已过期")}
    return state
}
A.error_text = fn(code){
    if code == "native_resume_missing" || code == "native_resume_revoked" {return A.t("Sign in again with this Matrix account to restore Hagency access. Existing records and saved requests stay on this device.", "请使用当前 Matrix 账号重新登录以恢复 Hagency 访问。此设备上的已有记录和已保存请求会保留。")}

    if code == "invalid_project_request" {return A.t("Check the project name, purpose and requested monthly tokens before submitting again.", "请检查项目名称、用途与申请的每月 token 数量后重新提交。")}
    if code == "contribution_not_admitted" {return A.t("This resource is no longer admitted. Refresh and review the resource's latest status.", "此资源已不再获准，请刷新并查看资源的最新状态。")}
    if code == "management_administrator_required" {return A.t("Only this server's designated administrator can decide project requests.", "只有此服务器的指定管理员可以审批项目申请。")}
    if code == "project_manager_required" {return A.t("Only this project's manager or the server administrator can withdraw its request.", "只有此项目的经理或服务器管理员可以撤回申请。")}
    if code == "project_request_capacity" {return A.t("You already have the maximum number of active project requests. Review your existing requests before starting another.", "你的有效项目申请数量已达上限，请先处理已有申请。")}
    if code == "project_resource_capacity" {return A.t("This resource has reached its active project-request limit. Choose another resource or wait for an existing request to close.", "此资源的有效项目申请数量已达上限，请选择其他资源或等待已有申请关闭。")}
    if code == "management_receipt_capacity" {return A.t("This device has reached the server's saved-command limit. Ask the administrator to review storage before submitting again.", "此设备已达服务器的指令记录上限，请管理员检查存储后再提交。")}
    if code == "management_command_conflict" {return A.t("A different result already exists for this request identifier. The original request remains saved; refresh to recover its recorded result.", "此请求标识已存在其他结果，原请求仍然保留。请刷新并恢复已记录的结果。")}
    if code == "invalid_management_revision" || code == "management_operation_mismatch" {return A.t("This saved request no longer matches the record. Refresh and review its current state before trying again.", "此保存的请求与记录不再匹配，请刷新并核对当前状态后重试。")}
    if code == "management_not_configured" { return A.t("Hagency management is not enabled on this server. Ask its administrator to enable it, then retry.", "此服务器尚未启用 Hagency 管理。请管理员启用后重试。") }
    if code == "provider_connection_cancelled" { return A.t("Connection cancelled. Your provider account was not changed.", "已取消关联，模型服务账号未更改。") }
    if code == "provider_confirmation_expired" { return A.t("The confirmation expired. Open it again when you are ready.", "确认已过期，请准备好后重新打开。") }
    if code == "local_codex_account_not_signed_in" || code == "local_provider_not_signed_in" { return A.t("Sign in to the provider on this device, then connect its account here.", "请先在此设备上登录模型服务，再回来关联账号。") }
    if code == "management_model_unqualified" { return A.t("This model and reasoning setting are not qualified for shared resources. Choose another model or reasoning level.", "此模型与推理强度组合尚未获得共享资源资格，请选择其他模型或推理强度。") }
    if code == "management_revision_conflict" || code == "management_revision_changed" || code == "revision_conflict" { return A.t("This record changed. Refresh and review its latest state before trying again.", "此记录已变化，请刷新并核对最新状态后重试。") }
    if code == "management_action_closed" { return A.t("This request has already been completed or expired. Refresh to view its latest result.", "此请求已处理或已过期，请刷新查看最新结果。") }
    if code == "contribution_already_exists" { return A.t("This resource already has a connection. Open Connections to review it.", "此资源已有关联，请打开连接列表查看。") }
    if code == "invalid_management_user" { return A.t("Sign in with the resource owner account on this server.", "请使用此服务器上的资源所有者账号登录。") }
    if code == "resource_owner_is_coordinator" {return A.t("The resource owner automatically coordinates its capacity. Refresh this resource and submit again.", "资源所有者自动协调其容量。请刷新资源后重新提交。")}
    if code == "invalid_resource_offer" { return A.t("Check the resource name before submitting again.", "请检查资源名称后重新提交。") }
    if code == "provider_account_verification_required" {return A.t("The provider account could not be verified. Sign in on this device and check its connection again.", "无法验证模型服务账号，请在此设备上登录后重新检查连接。")}
    if code == "management_executor_changed" || code == "contribution_resource_changed" {return A.t("The resource or its provider binding changed. Review the resource and request admission for the updated configuration.", "资源或其关联的模型服务已变化，请核对资源并为更新后的配置重新申请准入。")}
    if code == "contribution_executor_changed" {return A.t("The resource owner needs to reconnect their device before this request can be approved.", "资源主人需要先重新连接设备，才能批准此申请。")}
    if code == "contribution_executor_current" {return A.t("This device is already reconnected. Refresh to see its latest status.", "此设备已重新连接，请刷新查看最新状态。")}
    if code == "contribution_executor_required" {return A.t("Verify this connection from the original owner's enrolled device.", "请使用资源主人原先登记的设备验证此连接。")}
    if code == "management_outcome_unknown" { return A.t("The reply was interrupted. Your original request is saved; retry it to recover the recorded result.", "响应中断，原请求已保存。请重试原请求以恢复已记录的结果。") }
    if code == "management_permission_required" || code == "management_scope_changed" || code == "management_access_required" { return A.t("Authorization changed. Reopen Hagency from your signed-in account.", "授权已变化，请使用已登录的账号重新打开 Hagency。") }
    return A.t("The operation could not finish. Your saved request is retained. Check the connection and retry.", "操作未完成，已保存的请求会保留。请检查连接后重试。")
}
A.notice_text = fn(){
    if H.needs_signin && H.notice == A.error_text("native_resume_missing") {return A.t("A fresh sign-in is needed for Hagency.", "Hagency 需要重新登录。")}
    return H.notice
}
A.onboarding_reason = fn(code){
    if code=="device_setup_required" {return A.t("Set up this device before creating a provider account.","请先设置此设备，再创建模型服务账号。")}
    if code=="empty_device_history_not_empty" {return A.t("This profile already has local account or activity records. Keep those records and use their existing recovery flow; an empty setup cannot replace them.","此身份已有本机账号或活动记录。请保留这些记录并使用原有恢复流程，空设备设置不能替代它们。")}
    if code == "source_adoption_inventory_unsupported" {return A.t("This device’s resource history is not supported by the migration yet. Existing records remain available; review them in Resources and Connections. Retrying cannot bypass this requirement.", "此设备的资源历史尚不支持迁移。已有记录仍可在资源与连接中查看；重试不能绕过此条件。")}
    if code == "onboarding_unavailable" {return A.t("Shared-capacity migration is not enabled in this build. Existing resource and connection records remain available.", "此版本尚未启用共享容量迁移，仍可查看已有资源与连接记录。")}
    if code == "owner_source_adoption_required" {return A.t("Review this device's original resource migration before reserving shared capacity.", "预留共享容量前，请先核对此设备的原始资源迁移。")}
    if code == "management_scope_changed" || code == "management_access_required" {return A.t("The account or session changed. Reopen Hagency from the intended signed-in account.", "账号或会话已变化，请从所需的已登录账号重新打开 Hagency。")}
    if code == "management_outcome_unknown" {return A.t("The result is unknown. Reopen the native review to recover the original migration or grant; do not create a replacement.", "结果未知。请重新打开原生核对，恢复原始迁移或授权，不要另建替代操作。")}
    return A.t("The native check could not finish. Refresh or reopen the original review; existing resource and grant history is retained.", "原生检查未完成。请刷新或重新打开原始核对，已有资源与授权历史会保留。")
}
A.onboarding_state = fn(state){
    if state == "legacy" {return A.t("Device setup needs review", "需要核对设备设置")}
    if state == "recovery_required" {return A.t("Resume the original setup", "继续原始设备设置")}
    if state == "active" {return A.t("Shared resource inventory available", "共享资源清单已可用")}
    if state == "outcome_unknown" {return A.t("Result unknown · recover original", "结果未知 · 请恢复原始操作")}
    if state == "review_closed" {return A.t("Native review closed", "已关闭原生核对")}
    if state == "blocked" {return A.t("Native requirements are incomplete", "原生条件尚不满足")}
    return A.t("Shared-capacity setup unavailable", "共享容量设置暂不可用")
}
A.onboarding_result_text = fn(data){
    let {state=nil closure=nil}=data
    if state == "recorded" && closure != nil {return A.t("Previous grant closed. Retained amounts remain committed; a new grant requires a separately approved admission.", "旧授权已关闭，保留额度仍被占用。新的授权需要对应新一轮已通过的准入审批。")}
    if state == "active" {return A.t("Device setup completed. Continue with accounts, resources and sharing below.", "设备设置已完成，请继续处理下方的账号、资源和共享步骤。")}
    if state == "recorded" {return A.t("The local reservation is recorded. Reopen its original grant to review server publication.", "本地预留已记录。请重新打开原始授权，核对服务器发布。")}
    if state == "server_observed" {return A.t("The server result was read. Reopening the original grant does not renew or reactivate it.", "已读取服务器结果。重新打开原始授权不会续期或重新激活它。")}
    if state == "rejected" || state == "declined" {return A.t("The original action was declined. Its history and any existing local reservation remain unchanged.", "原始操作已被拒绝，其历史和任何已有本地预留保持不变。")}
    if state == "review_expired" {return A.t("The original accounting period ended. This grant cannot move silently to another month.", "原始记账周期已结束，此授权不能自动转移到其他月份。")}
    if state == "review_required" {return A.t("The original grant needs a fresh native review.", "原始授权需要重新进行原生核对。")}
    return A.onboarding_state(state)
}
A.onboarding_reason_code = fn(data){let {reason=nil}=data return reason}
A.onboarding_empty = fn(data){let {setupKind=nil}=data return setupKind=="empty_device"}
A.onboarding_connections_received = fn(data){
    H.onboarding_connections=data.items H.onboarding_after=data.nextAfter
    for connection in H.onboarding_connections {A.observe_verification(connection,data.observedAtMs)}
}
A.more_onboarding_connections = fn(){
    if H.busy || H.onboarding == nil || !H.onboarding.grantReviewAvailable || H.onboarding_after == nil {return}
    let after=H.onboarding_after H.onboarding_connections=[] H.onboarding_after=nil
    A.request("hagency.connections.list",{after:after},A.onboarding_connections_received)
}
A.onboarding_received = fn(data){
    let {state=nil,canReview=nil,grantReviewAvailable=false,grantIntents=[],setupKind=nil}=data
    if !state.is_string() || (state != "legacy" && state != "recovery_required" && state != "active" && state != "unavailable") || (canReview != true && canReview != false) || (grantReviewAvailable != true && grantReviewAvailable != false) || (!grantIntents.is_array() && !grantIntents.is_object()) {
        H.onboarding=nil H.notice=A.onboarding_reason("invalid_reply") return
    }
    H.onboarding=data H.onboarding.grantReviewAvailable=grantReviewAvailable H.onboarding.grantIntents=grantIntents H.onboarding.setupKind=setupKind
    if state == "active" && grantReviewAvailable {A.request("hagency.connections.list",{},A.onboarding_connections_received)}
}
A.open_onboarding = fn(){
    if H.busy {return}
    H.page="onboarding" H.onboarding=nil H.onboarding_connections=[] H.onboarding_after=nil
    A.request("hagency.onboarding.status",{},A.onboarding_received)
}
A.review_onboarding = fn(){
    if H.busy || H.onboarding == nil || !H.onboarding.canReview {return}
    H.onboarding_result=nil
    A.request("hagency.onboarding.review",{},fn(data){H.onboarding_result=data A.open_onboarding()})
}
A.review_grant = fn(selector){
    if H.busy || H.onboarding == nil || !H.onboarding.grantReviewAvailable {return}
    H.onboarding_result=nil
    A.request("hagency.grants.review",selector,fn(data){H.onboarding_result=data A.open_onboarding()})
}
A.readmission_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_array() && !features.is_object() {return false}
    for feature in features {if feature=="resource-readmission-v1" {return true}}
    return false
}
A.can_reoffer = fn(admission){
    if !A.readmission_enabled() || admission==nil {return false}
    let c=admission.contribution
    return c.ownerMxid==H.session.account && c.executorDeviceId==H.session.device && c.executorGeneration<=H.session.deviceGeneration && (c.state=="revoked" || c.state=="rejected" || (c.state=="pending_admission" && admission.request.state=="expired"))
}
A.readmission_error = fn(code){
    if code=="contribution_withdrawal_required" {return A.t("The current admission is still open. Withdraw it before submitting a new request.","当前准入仍有效，请先撤回，再提交新申请。")}
    if code=="contribution_native_fence_required" {return A.t("The execution device has not finished closing its previous grants. Keep Hagency running on that device, then refresh. Retained usage remains charged.","执行设备尚未完成旧授权的关闭，请保持该设备上的 Hagency 运行，然后刷新。保留的用量仍计入账本。")}
    if code=="owner_grant_prior_intent_required" {return A.t("Open Shared capacity to resolve previous grant reviews or recover their results before submitting again.","请打开共享容量，处理旧授权核对或恢复其结果后，再提交新申请。")}
    if code=="contribution_projects_open" {return A.t("This resource still has open project requests or allocations. Review its projects before submitting again.","此资源仍有关联的项目申请或分配，请先处理相关项目，再提交新申请。")}
    if code=="contribution_history_capacity" {return A.t("The server cannot retain another admission round for this connection. Its existing history is unchanged.","服务器无法为此连接再保存一轮准入申请，已有历史保持不变。")}
    if code=="management_revision_changed" || code=="contribution_resource_changed" {return A.t("The connection or resource changed. Reload its current details and review the new request again.","连接或资源已变化，请重新加载当前详情，并再次核对新申请。")}
    if code=="readmission_unavailable" {return A.t("This server does not support resource admission history and resubmission yet.","此服务器尚不支持资源准入历史与重新申请。")}
    if code=="invalid_history_reply" {return A.t("The history response did not match this connection. Refresh to try again.","历史响应与此连接不匹配，请刷新后重试。")}
    if code=="invalid_resource_offer" || code=="invalid_management_user" {return A.t("Enter a resource name. Your signed-in account owns and coordinates it.","请输入资源名称。当前登录账号拥有并协调此资源。")}
    return A.error_text(code)
}
A.reoffer_not_applied = fn(code){
    return code=="owner_grant_prior_intent_required" || code=="contribution_native_fence_required" || code=="contribution_projects_open" || code=="contribution_withdrawal_required" || code=="contribution_history_capacity" || code=="management_revision_changed" || code=="management_revision_conflict" || code=="contribution_resource_changed" || code=="contribution_executor_required" || code=="invalid_resource_offer" || code=="invalid_management_user" || code=="invalid_management_arguments" || code=="invalid_management_revision"
}
A.history_received = fn(data){
    if data.protocol!="hagency-management-v1" || (!data.items.is_array() && !data.items.is_object()) || data.items.len()>32 {H.notice=A.readmission_error("invalid_history_reply") return}
    for item in data.items {
        let {offer=nil request=nil current=nil}=item
        if offer==nil || request==nil || (current!=true && current!=false) || offer.contributionId!=H.history_id || offer.requestId!=request.id || request.contributionId!=H.history_id {H.notice=A.readmission_error("invalid_history_reply") return}
    }
    if data.nextAfter!=nil && (!data.nextAfter.is_string() || data.nextAfter==H.history_after) {H.notice=A.readmission_error("invalid_history_reply") return}
    H.connection_history=data
}
A.open_connection_history = fn(id,after,page){
    if H.busy {return}
    if !A.readmission_enabled() {H.notice=A.readmission_error("readmission_unavailable") A.redraw() return}
    H.page="connection_history" H.history_id=id H.history_after=after H.history_page=page H.connection_history=nil H.notice=""
    let args={id:id} if after!=nil {args.after=after}
    A.request("hagency.connections.history",args,A.history_received)
}
A.begin_reoffer = fn(){
    if H.busy || H.command!=nil || !A.can_reoffer(H.selected) {return}
    let id=H.selected.contribution.id
    H.page="connection_reoffer" H.reoffer_draft=nil H.notice=""
    A.request("hagency.connections.get",{id:id},fn(data){
        let {admission=nil}=data
        if admission==nil || admission.contribution.id!=id || admission.request.id!=admission.contribution.requestId || admission.request.contributionId!=id {H.notice=A.readmission_error("invalid_history_reply") return}
        H.selected=admission
        if !A.can_reoffer(H.selected) {H.page="action" H.notice=A.readmission_error("contribution_withdrawal_required") return}
        let c=H.selected.contribution
        A.request("hagency.resources.get",{id:c.resourceId},fn(detail){
            if detail.protocol!="hagency-management-v1" || detail.resource.id!=c.resourceId {H.notice=A.readmission_error("contribution_resource_changed") return}
            H.reoffer_draft={contributionId:c.id expectedContributionRevision:c.revision requestId:c.requestId resourceId:c.resourceId expectedRevision:detail.resource.revision label:c.label coordinatorMxid:c.ownerMxid resource:detail.resource review:false}
        })
    })
}
A.reoffer_field = fn(name,value){
    if H.busy || H.command!=nil || H.reoffer_draft==nil || H.reoffer_draft.review {return}
    if name=="label" {H.reoffer_draft.label=value}
}
A.review_reoffer = fn(){
    if H.busy || H.command!=nil || H.reoffer_draft==nil || !A.can_reoffer(H.selected) {return}
    let d=H.reoffer_draft
    d.label=d.label.trim() d.coordinatorMxid=H.session.account
    if d.label=="" || d.coordinatorMxid=="" {H.notice=A.readmission_error("invalid_resource_offer") A.redraw() return}
    d.review=true H.notice="" A.redraw()
}
A.submit_reoffer = fn(){
    if H.busy || H.command!=nil || H.reoffer_draft==nil || !H.reoffer_draft.review || !A.can_reoffer(H.selected) {return}
    let d=H.reoffer_draft let c=H.selected.contribution
    if d.contributionId!=c.id || d.resourceId!=c.resourceId || d.expectedContributionRevision!=c.revision || d.requestId!=c.requestId {d.review=false H.notice=A.readmission_error("management_revision_changed") A.redraw() return}
    A.submit("hagency.connections.reoffer",{contributionId:d.contributionId expectedContributionRevision:d.expectedContributionRevision resourceId:d.resourceId expectedRevision:d.expectedRevision label:d.label coordinatorMxid:d.coordinatorMxid})
}

A.project_not_applied = fn(service, code){
    if service != "hagency.projects.request" && service != "hagency.projects.decide" && service != "hagency.projects.revoke" {return false}
    return code == "invalid_project_request" || code == "invalid_management_revision" || code == "management_administrator_required" || code == "project_manager_required" || code == "contribution_not_admitted" || code == "management_revision_changed" || code == "management_action_closed" || code == "management_operation_mismatch" || code == "project_request_capacity" || code == "project_resource_capacity" || code == "management_receipt_capacity"
}
A.restore_project_draft = fn(draft){
    if !draft.is_object() {return false}
    let {step = nil, name = nil, purpose = nil, tokens = nil, resource = nil} = draft
    if step != 0 && step != 1 && step != 2 {return false}
    if !name.is_string() || !purpose.is_string() || !tokens.is_string() {return false}
    if resource == nil {
        if step != 0 {return false}
    } else {
        if !resource.is_object() {return false}
        let {id = nil, label = nil, runtime = nil, coordinatorMxid = nil} = resource
        if !id.is_string() || !label.is_string() || !runtime.is_string() || !coordinatorMxid.is_string() {return false}
    }
    H.project_draft = {step:step resource:resource name:name purpose:purpose tokens:tokens}
    return true
}
A.clear_requested_draft = fn(project){
    let draft = H.project_draft
    if draft.resource != nil && draft.resource.id == project.contributionId && draft.name.trim() == project.name && draft.purpose.trim() == project.purpose && draft.tokens.trim().to_f64() == project.requestedTokens {
        H.project_draft = {step:0 resource:nil name:"" purpose:"" tokens:"100000"}
    }
}
A.local_name = fn(row){let {localName=nil}=row return localName}
A.resource_title = fn(row){let name=A.local_name(row) if name != nil && name.name != "" {return name.name} return row.model}
A.name_not_applied = fn(service,code){return service == "hagency.resources.rename" && (code == "management_resource_name_changed" || code == "invalid_management_arguments")}
A.name_error = fn(code){
    if code == "management_resource_name_changed" {return A.t("The local name changed. Refresh its current name before reviewing another edit.", "本地名称已变化，请刷新当前名称后重新核对修改。")}
    if code == "invalid_management_arguments" {return A.t("Use a single-line local name of up to 80 characters. Leave it empty to show the model name.", "本地名称须为最多 80 个字符的单行文本，留空则显示模型名称。")}
    return A.error_text(code)
}
A.edit_resource_name = fn(){
    if H.busy || H.command != nil || H.resource_detail == nil {return}
    let row=H.resource_detail.resource let name=A.local_name(row)
    if name == nil {return}
    H.resource_name_draft={resourceId:row.id expectedNameRevision:name.revision originalName:name.name name:name.name}
    H.resource_name_mode="edit" H.notice="" A.redraw()
}
A.review_resource_name = fn(){
    if H.busy || H.command != nil || H.resource_name_draft == nil {return}
    H.resource_name_draft.name=H.resource_name_draft.name.trim()
    H.resource_name_mode="review" H.notice="" A.redraw()
}
A.submit_resource_name = fn(){
    if H.busy || H.command != nil || H.resource_name_mode != "review" || H.resource_name_draft == nil || H.resource_detail == nil {return}
    let d=H.resource_name_draft let name=A.local_name(H.resource_detail.resource)
    if name == nil || d.resourceId != H.resource_detail.resource.id || d.expectedNameRevision != name.revision {H.notice=A.name_error("management_resource_name_changed") H.resource_name_mode="" H.resource_name_draft=nil A.redraw() return}
    A.submit("hagency.resources.rename",{resourceId:d.resourceId expectedNameRevision:d.expectedNameRevision name:d.name})
}
A.resource_edit_reason = fn(reason){
    if reason=="previously_offered" {return A.t("This resource has already been offered. Its server agreement must be amended before configuration changes.","此资源已贡献过。修改配置前须先变更服务器上的协议。")}
    if reason=="published" {return A.t("This resource is published locally. It cannot be changed in place here.","此资源已在本地发布，此处不能直接修改配置。")}
    if reason=="retained_commitments" {return A.t("This resource has retained allocations or usage commitments.","此资源仍有关联分配或用量承诺。")}
    if reason=="managed_namespace_required" {return A.t("Editing currently requires a resource enrolled from a private Codex account space.","编辑目前要求资源来自独立的 Codex 账号空间。")}
    if reason=="account_unavailable" {return A.t("The original account space is unavailable or sign-in is in progress. Check Accounts, then refresh.","原账号空间不可用或正在登录。请检查账号后刷新。")}
    if reason=="read_only" {return A.t("This mini-app session has read access only. Review its permissions to enable editing.","此小程序会话只有读取权限。请核对权限后启用编辑。")}
    return A.t("This device cannot prove that the resource was never contributed. Changing it could invalidate an existing server connection.","此设备无法证明资源从未贡献过。修改配置可能使现有服务器连接失效。")
}
A.resource_default_yolo = fn(detail){
    let {executionPolicy=nil}=detail
    return executionPolicy!=nil && executionPolicy.yolo==true
}
A.resource_draft_yolo = fn(d,detail){
    let {yolo=nil}=d
    return if yolo==nil {A.resource_default_yolo(detail)}else{yolo}
}
A.choose_resource_default = fn(kind,yolo){
    if H.busy || H.command!=nil || H.resource_detail==nil || (kind!="edit" && kind!="create") || H.page!="resource_"+kind {return}
    if (yolo!=false && yolo!=true) || (yolo && H.resource_detail.resource.framework!="codex") {return}
    let d=if kind=="edit" {H.resource_edit_draft}else{H.resource_create_draft}
    if d==nil {return}
    d.yolo=yolo A.redraw()
}
A.edit_resource_configuration = fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil || !H.resource_detail.editing.allowed {return}
    let detail=H.resource_detail let row=detail.resource let d=H.resource_edit_draft
    if d==nil || d.resourceId!=row.id || d.expectedRevision!=row.revision {
        let amount=nil
        if detail.ceiling!=nil {amount=detail.ceiling.tokens}
        H.resource_edit_draft={resourceId:row.id expectedRevision:row.revision yolo:A.resource_default_yolo(detail) model:row.model reasoning:row.reasoning tokens:if amount==nil {""}else{""+amount} limitMode:if amount==nil {"clear"}else{"monthly"}}
    }
    H.resource_edit_models_open=false H.page="resource_edit" H.notice="" A.redraw()
}
A.resource_edit_models = fn(){
    let models=[]
    if H.resource_detail==nil {return models}
    for choice in H.resource_detail.choices {let found=false for model in models {if model==choice.model {found=true}} if !found {models.push(choice.model)}}
    return models
}
A.choose_resource_model = fn(model){
    if H.busy || H.command!=nil || H.resource_edit_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_edit_draft let valid=false let first=nil let found=false
    for choice in H.resource_detail.choices {if choice.model==model {if !found {first=choice.reasoning found=true} if choice.reasoning==d.reasoning {valid=true}}}
    if !found {return}
    d.model=model if !valid {d.reasoning=first}
    H.resource_edit_models_open=false A.redraw()
}
A.resource_edit_error = fn(code){
    if code=="management_resource_edit_changed" {return A.t("The resource changed. Refresh its details before reviewing another edit.","资源已变化，请刷新详情后重新核对修改。")}
    if code=="management_resource_edit_not_available" {return A.t("This resource can no longer be edited locally. Refresh to see its current status.","此资源目前已不能在本地编辑，请刷新查看当前状态。")}
    if code=="provider_model_changed" || code=="management_model_unqualified" {return A.t("The account no longer supports this model and reasoning choice. Refresh and choose again.","账号目前不支持此模型与推理强度组合，请刷新后重新选择。")}
    if code=="resource_namespace_required" {return A.resource_edit_reason("managed_namespace_required")}
    if code=="invalid_management_arguments" {return A.t("Choose a supported model and enter a whole monthly token limit, including zero, or explicitly clear the limit.","请选择支持的模型，输入每月 token 整数上限（可为零），或明确清除上限。")}
    return A.error_text(code)
}
A.resource_edit_not_applied = fn(code){return code=="management_resource_edit_changed" || code=="management_resource_edit_not_available" || code=="management_model_unqualified" || code=="provider_model_changed" || code=="resource_namespace_required" || code=="provider_connection_required" || code=="invalid_management_arguments"}
A.submit_resource_configuration = fn(){
    if H.busy || H.command!=nil || H.resource_edit_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_edit_draft let detail=H.resource_detail let row=detail.resource
    if d.resourceId!=row.id || d.expectedRevision!=row.revision || !detail.editing.allowed {H.notice=A.resource_edit_error("management_resource_edit_changed") A.redraw() return}
    let qualified=false for choice in detail.choices {if choice.model==d.model && choice.reasoning==d.reasoning {qualified=true}}
    if !qualified {H.notice=A.resource_edit_error("management_model_unqualified") A.redraw() return}
    let yolo=A.resource_draft_yolo(d,detail)
    if (yolo!=false && yolo!=true) || (yolo && row.framework!="codex") {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
    let policy_changed=yolo!=A.resource_default_yolo(detail)
    let profile={kind:"preserve"}
    if d.model!=row.model || d.reasoning!=row.reasoning {profile={kind:"select" model:d.model reasoning:d.reasoning}}
    let ceiling={kind:"preserve"}
    if d.limitMode=="clear" {if detail.ceiling!=nil {ceiling={kind:"clear"}}} else if d.limitMode=="monthly" {
        let tokens=d.tokens.trim().to_f64()
        if d.tokens.trim()=="" || !(tokens>=0 && tokens<=9007199254740991) || floor(tokens)!=tokens {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
        if detail.ceiling==nil || detail.ceiling.period!="monthly" || detail.ceiling.tokens!=tokens {ceiling={kind:"monthly" tokens:tokens}}
    } else {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
    if profile.kind=="preserve" && ceiling.kind=="preserve" && !policy_changed {H.notice=A.t("No configuration changes to save.","配置没有变化，无需保存。") A.redraw() return}
    let input={resourceId:d.resourceId expectedRevision:d.expectedRevision profile:profile ceiling:ceiling}
    if policy_changed {input.executionPolicy={yolo:yolo}}
    A.submit("hagency.resources.edit",input)
}
A.create_resource_configuration = fn(){
    if H.busy || H.command!=nil || H.resource_detail==nil || H.resource_detail.choices.len()==0 || H.resource_detail.editing.reason=="read_only" {return}
    let detail=H.resource_detail let row=detail.resource let d=H.resource_create_draft
    if d==nil || d.sourceResourceId!=row.id || d.expectedRevision!=row.revision {
        let amount=nil
        if detail.ceiling!=nil {amount=detail.ceiling.tokens}
        H.resource_create_draft={sourceResourceId:row.id expectedRevision:row.revision yolo:A.resource_default_yolo(detail) model:row.model reasoning:row.reasoning tokens:if amount==nil {""}else{""+amount} limitMode:if amount==nil {"clear"}else{"monthly"}}
    }
    H.resource_create_models_open=false H.page="resource_create" H.notice="" A.redraw()
}
A.resource_create_models = fn(){
    let models=[]
    if H.resource_detail==nil {return models}
    for choice in H.resource_detail.choices {let found=false for model in models {if model==choice.model {found=true}} if !found {models.push(choice.model)}}
    return models
}
A.choose_resource_creation_model = fn(model){
    if H.busy || H.command!=nil || H.resource_create_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_create_draft let valid=false let first=nil let found=false
    for choice in H.resource_detail.choices {if choice.model==model {if !found {first=choice.reasoning found=true} if choice.reasoning==d.reasoning {valid=true}}}
    if !found {return}
    d.model=model if !valid {d.reasoning=first}
    H.resource_create_models_open=false A.redraw()
}
A.resource_create_error = fn(code){
    if code=="management_resource_source_changed" {return A.t("The source configuration changed. Refresh its details before creating a new configuration.","源配置已变化，请刷新详情后再创建新配置。")}
    if code=="management_model_unqualified" {return A.t("This model and reasoning choice is not qualified. Refresh the source and choose again.","此模型与推理强度组合不合格，请刷新源配置后重新选择。")}
    if code=="invalid_management_arguments" {return A.resource_edit_error(code)}
    return A.error_text(code)
}
A.resource_create_not_applied = fn(code){return code=="management_resource_source_changed" || code=="management_model_unqualified" || code=="invalid_management_arguments"}
A.submit_resource_creation = fn(){
    if H.busy || H.command!=nil || H.resource_create_draft==nil || H.resource_detail==nil {return}
    let d=H.resource_create_draft let detail=H.resource_detail let row=detail.resource
    if d.sourceResourceId!=row.id || d.expectedRevision!=row.revision || detail.choices.len()==0 || detail.editing.reason=="read_only" {H.notice=A.resource_create_error("management_resource_source_changed") A.redraw() return}
    let qualified=false for choice in detail.choices {if choice.model==d.model && choice.reasoning==d.reasoning {qualified=true}}
    if !qualified {H.notice=A.resource_create_error("management_model_unqualified") A.redraw() return}
    let yolo=A.resource_draft_yolo(d,detail)
    if (yolo!=false && yolo!=true) || (yolo && row.framework!="codex") {H.notice=A.resource_edit_error("invalid_management_arguments") A.redraw() return}
    let policy_changed=yolo!=A.resource_default_yolo(detail)
    let profile={kind:"preserve"}
    if d.model!=row.model || d.reasoning!=row.reasoning {profile={kind:"select" model:d.model reasoning:d.reasoning}}
    let ceiling={kind:"preserve"}
    if d.limitMode=="clear" {if detail.ceiling!=nil {ceiling={kind:"clear"}}} else if d.limitMode=="monthly" {
        let tokens=d.tokens.trim().to_f64()
        if d.tokens.trim()=="" || !(tokens>=0 && tokens<=9007199254740991) || floor(tokens)!=tokens {H.notice=A.resource_create_error("invalid_management_arguments") A.redraw() return}
        if detail.ceiling==nil || detail.ceiling.period!="monthly" || detail.ceiling.tokens!=tokens {ceiling={kind:"monthly" tokens:tokens}}
    } else {H.notice=A.resource_create_error("invalid_management_arguments") A.redraw() return}
    let input={sourceResourceId:d.sourceResourceId expectedRevision:d.expectedRevision profile:profile ceiling:ceiling}
    if policy_changed {input.executionPolicy={yolo:yolo}}
    A.submit("hagency.resources.create",input)
}
A.resource_error = fn(code){
    if code == "management_not_found" || code == "management_resource_unavailable" {return A.t("This resource is no longer available on this device.", "此资源在本设备上已不可用。")}
    if code == "management_scope_changed" || code == "management_access_required" || code == "management_permission_required" {return A.error_text(code)}
    return A.t("The resource could not be read. Refresh to try again.", "无法读取资源，请刷新后重试。")
}
A.open_resource = fn(id){
    if H.resource_id!=id {H.ux.resourceTools=false}
    if H.busy {return}
    H.page="resource_detail" H.resource_id=id H.resource_detail=nil H.notice="" H.resource_name_mode="" H.resource_name_draft=nil
    A.request("hagency.resources.get", {id:id}, fn(data){
        if data.protocol != "hagency-management-v1" || data.resource.id != H.resource_id {H.notice=A.t("The resource response did not match this page. Refresh to check again.", "资源响应与当前页面不匹配，请刷新后重新检查。") return}
        H.resource_detail=data
    })
}
A.alert_state = fn(state){
    if state=="open" {return A.t("Open","待处理")}
    if state=="acknowledged" {return A.t("Acknowledged","已知悉")}
    if state=="assigned" {return A.t("Assigned","已认领")}
    if state=="suppressed" {return A.t("Suppressed","已暂时抑制")}
    if state=="resolved" {return A.t("Resolved","已解决")}
    return state
}
A.alert_action = fn(state){
    if state=="acknowledged" {return A.t("Acknowledge","标记知悉")}
    if state=="assigned" {return A.t("Assign to me","由我处理")}
    if state=="suppressed" {return A.t("Suppress for 24 hours","抑制 24 小时")}
    if state=="resolved" {return A.t("Mark resolved","标记已解决")}
    return A.t("Reopen","重新打开")
}
A.alert_severity = fn(value){if value=="critical"{return A.t("Critical","严重")} if value=="warning"{return A.t("Warning","警告")} return A.t("Information","提示")}
A.alert_budget = fn(row){let {budget={}}=row let {ceilingTokens=nil,drawnTokens=nil,overByTokens=nil}=budget return {ceiling:ceilingTokens drawn:drawnTokens over:overByTokens}}
A.alert_error = fn(code){
    if code=="management_revision_conflict" {return A.t("This alert changed. Refresh its latest observation before reviewing another action.","告警已变化，请刷新最新观测后重新核对操作。")}
    if code=="management_not_found" {return A.t("This alert or resource is no longer available to this account.","当前账号已无法访问此告警或资源。")}
    return A.error_text(code)
}
A.open_alerts = fn(resource,after,status){
    if H.busy {return}
    H.page="resource_alerts" H.alert_resource=resource H.alert_after=after H.alert_status=status H.alert_page=nil H.alert_detail=nil H.alert_draft=nil H.notice=""
    A.request("hagency.alerts.list",{resourceId:resource after:after status:status},fn(data){
        if H.page!="resource_alerts" || H.alert_resource!=resource || H.alert_after!=after || H.alert_status!=status {return}
        if data.resourceId!=resource {H.notice=A.t("The alert response did not match this resource.","告警响应与当前资源不匹配。") return}
        H.alert_page=data
    })
}
A.open_alert = fn(resource,id,after_note){
    if H.busy {return}
    H.page="resource_alert" H.alert_resource=resource H.alert_id=id H.alert_note_after=after_note H.alert_detail=nil H.alert_draft=nil H.notice=""
    A.request("hagency.alerts.get",{resourceId:resource id:id afterNote:after_note},fn(data){
        if H.page!="resource_alert" || H.alert_resource!=resource || H.alert_id!=id || H.alert_note_after!=after_note {return}
        if data.alert.resourceId!=resource || data.alert.id!=id {H.notice=A.t("The alert response did not match this resource.","告警响应与当前资源不匹配。") return}
        H.alert_detail=data
    })
}
A.choose_alert_action = fn(state){
    if H.busy || H.command!=nil || H.alert_detail==nil {return}
    let row=H.alert_detail.alert let allowed=false
    for next in row.next {if state==next {allowed=true}}
    if !allowed {return}
    H.alert_draft={resourceId:row.resourceId id:row.id expectedRevision:row.revision to:state note:""} A.redraw()
}
A.submit_alert = fn(){
    if H.busy || H.command!=nil || H.alert_draft==nil || H.alert_detail==nil {return}
    let d=H.alert_draft let row=H.alert_detail.alert
    if d.resourceId!=H.alert_resource || d.id!=H.alert_id || d.expectedRevision!=row.revision {H.alert_draft=nil H.notice=A.alert_error("management_revision_conflict") A.redraw() return}
    A.submit("hagency.alerts.triage",{resourceId:d.resourceId id:d.id expectedRevision:d.expectedRevision to:d.to note:if d.note.trim()==""{nil}else{d.note.trim()}})
}
A.binding_error = fn(code){
    if code=="management_revision_conflict" {return A.t("This link changed. Refresh the list and review the current room before removing it.","绑定已变化，请刷新列表并核对当前房间后再解除。")}
    if code=="management_not_found" {return A.t("This link is no longer available. Refresh the resource's approval rooms.","此绑定已不可用，请刷新资源的审批房间。")}
    return A.error_text(code)
}
A.open_bindings = fn(resource,after){
    if H.busy {return}
    if resource!=H.binding_resource {H.binding_filters={agent:"",project:""} H.binding_filter_draft={agent:"",project:""}}
    let agent=H.binding_filters.agent let project=H.binding_filters.project
    H.page="approval_bindings" H.binding_resource=resource H.binding_after=after H.binding_page=nil H.binding_draft=nil H.binding_result=nil H.notice=""
    A.request("hagency.approval_bindings.list",{resourceId:resource after:after agent:agent project:project},fn(data){
        if H.page!="approval_bindings" || H.binding_resource!=resource || H.binding_after!=after || H.binding_filters.agent!=agent || H.binding_filters.project!=project {return}
        if data.resourceId!=resource || data.agent!=agent || data.project!=project {H.notice=A.t("The room list did not match this resource and its filters.","房间列表与当前资源或筛选条件不匹配。") return}
        for row in data.bindings {if row.resourceId!=resource {H.notice=A.t("The room list did not match this resource.","房间列表与当前资源不匹配。") return}}
        H.binding_page=data
    })
}
A.filter_bindings = fn(){
    if H.busy {return}
    H.binding_filters={agent:H.binding_filter_draft.agent.trim(),project:H.binding_filter_draft.project.trim()}
    A.open_bindings(H.binding_resource,"")
}
A.clear_binding_filters = fn(){
    if H.busy {return}
    H.binding_filters={agent:"",project:""} H.binding_filter_draft={agent:"",project:""}
    A.open_bindings(H.binding_resource,"")
}
A.review_binding = fn(row){
    if H.busy || H.command!=nil || H.binding_page==nil || row.resourceId!=H.binding_resource {return}
    let found=false
    for current in H.binding_page.bindings {if current.engagementId==row.engagementId && current.revision==row.revision {found=true}}
    if !found {return}
    H.binding_draft={resourceId:row.resourceId engagementId:row.engagementId expectedRevision:row.revision agent:row.agent roomId:row.roomId ownerMxid:row.ownerMxid projectId:row.projectId serverName:row.serverName incarnation:row.incarnation}
    H.page="approval_binding_review" H.notice="" A.redraw()
}
A.submit_binding = fn(){
    if H.busy || H.command!=nil || H.binding_draft==nil || H.binding_page==nil || H.page!="approval_binding_review" {return}
    let d=H.binding_draft let current=false
    if H.binding_resource==d.resourceId {for row in H.binding_page.bindings {if row.resourceId==d.resourceId && row.engagementId==d.engagementId && row.revision==d.expectedRevision {current=true}}}
    if !current {H.binding_draft=nil H.page="approval_bindings" H.notice=A.binding_error("management_revision_conflict") A.redraw() return}
    A.submit("hagency.approval_bindings.retire",{resourceId:d.resourceId engagementId:d.engagementId expectedRevision:d.expectedRevision})
}
A.binding_received = fn(data){
    if H.binding_resource!=data.binding.resourceId {H.binding_filters={agent:"",project:""} H.binding_filter_draft={agent:"",project:""} H.binding_after=""}
    H.binding_result=data H.binding_resource=data.binding.resourceId H.binding_page=nil H.binding_draft=nil H.page="approval_binding_result" H.notice=""
}
A.binding_reply = fn(command,r){
    if r.is_ok {
        if !r.data.unbound || r.data.binding.resourceId!=command.args.resourceId || r.data.binding.engagementId!=command.args.engagementId || r.data.binding.revision!=command.args.expectedRevision {H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.binding_received(r.data)
        if A.save() {A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.binding_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" {
            H.command=nil H.binding_draft=nil H.binding_page=nil H.page="approval_bindings"
            if A.save() {A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}
A.tool_error = fn(code){
    if code=="tool_approval_room_unavailable" {return A.t("The original project room is unavailable. Refresh this request to check its latest status.","原项目房间暂不可用，请刷新此请求查看最新状态。")}
    if code=="tool_approval_navigation_unavailable" {return A.t("This build cannot open approval rooms.","此版本无法打开审批房间。")}
    if code=="management_revision_conflict" {return A.t("This permission changed. Refresh and review it again.","此权限已变化，请刷新后重新核对。")}
    if code=="management_not_found" {return A.t("This request or permission is no longer available for this agent.","此 Agent 的请求或权限已不可用。")}
    return A.error_text(code)
}
A.tool_status = fn(state){
    if state=="pending" {return A.t("Awaiting tool approval","等待工具审批")}
    if state=="decided" {return A.t("Decision recorded","决定已记录")}
    if state=="applying" {return A.t("Delivering decision","正在传递决定")}
    if state=="applied" {return A.t("Decision delivered","决定已传递")}
    if state=="expired" {return A.t("Expired","已过期")}
    if state=="cancelled" {return A.t("Cancelled","已取消")}
    if state=="uncertain" {return A.t("Delivery needs checking","传递结果待确认")}
    if state=="not_applied" {return A.t("Decision not applied","决定未应用")}
    return state
}
A.tool_request_status = fn(row,observed_at){
    if row.state=="pending" && row.expiresAt<=observed_at {return A.t("Approval window ended","审批已截止")}
    return A.tool_status(row.state)
}
A.tool_subject = fn(page,engagement){
    if page==nil {return nil}
    let {subjects=[]}=page
    for subject in subjects {if subject.engagementId==engagement {return subject}}
    return nil
}
A.tool_agent = fn(subject){
    if subject==nil {return A.t("Agent information unavailable","Agent 信息暂不可用")}
    return subject.agent
}
A.tool_project = fn(subject){
    if subject==nil {return A.t("Project information unavailable","项目信息暂不可用")}
    return if subject.projectName!=nil && subject.projectName!="" {subject.projectName}else{subject.projectId}
}
A.tool_deadline = fn(row,observed_at){
    if row.expiresAt<=observed_at {return A.t("Approval deadline passed","审批期限已过")}
    return A.t("Time left at refresh: ","刷新时剩余时间：")+floor((row.expiresAt-observed_at)/1000)+A.t(" seconds"," 秒")
}
A.open_tool_request = fn(id){
    if H.busy || id=="" || H.tool_resource=="" {return}
    let resource=H.tool_resource
    H.page="tool_request" H.tool_request_id=id H.tool_selected=nil H.notice=""
    A.request("hagency.tool_approvals.get",{resourceId:resource approvalId:id},fn(data){
        if H.page!="tool_request" || H.tool_resource!=resource || H.tool_request_id!=id {return}
        if !data.is_object() {H.notice=A.t("Request information unavailable","请求信息暂不可用") return}
        let {resourceId=nil,approval=nil,subject=nil,observedAtMs=nil}=data
        if !approval.is_object() || !subject.is_object() || observedAtMs==nil {H.notice=A.t("Request information unavailable","请求信息暂不可用") return}
        if resourceId!=resource || approval.id!=id || subject.engagementId!=approval.engagementId {H.notice=A.t("The response did not match this request.","响应与当前请求不匹配。") return}
        H.tool_selected=data
    })
}
A.open_tool_inbox = fn(){
    if H.busy || H.page!="tool_request" || H.tool_selected==nil {return}
    let data=H.tool_selected
    if data.resourceId!=H.tool_resource || data.approval.id!=H.tool_request_id {return}
    if data.approval.projectRoomId==nil {H.notice=A.tool_error("tool_approval_room_unavailable") A.redraw() return}
    A.request("hagency.tool_approvals.open",{resourceId:data.resourceId approvalId:data.approval.id},fn(result){
        if H.page!="tool_request" || H.tool_resource!=data.resourceId || H.tool_request_id!=data.approval.id {return}
        if result.requested {H.notice=A.t("Opening the verified approval inbox…","正在打开已验证的审批收件箱…")}
    })
}
A.tool_choice = fn(choice){
    if choice=="once" {return A.t("Allow once","允许一次")}
    if choice=="task" {return A.t("Allow for this task","此任务内允许")}
    if choice=="always" {return A.t("Saved permission","已保存权限")}
    if choice=="deny" {return A.t("Denied","已拒绝")}
    return A.t("No decision yet","尚未决定")
}
A.tool_kind = fn(kind){
    if kind=="exact_command" {return A.t("Command","命令")}
    if kind=="network_host" {return A.t("Network access","网络访问")}
    if kind=="permission_profile" {return A.t("Permission profile","权限配置")}
    if kind=="exact_tool_call" {return A.t("Tool call","工具调用")}
    return kind
}
A.open_tools = fn(resource,engagement,after,kind){
    if H.busy || (kind!="requests" && kind!="rules") || (kind=="rules" && engagement=="") {return}
    H.page=if kind=="requests"{"tool_approvals"}else{"tool_grants"}
    H.tool_resource=resource H.tool_engagement=engagement H.tool_after=after H.tool_kind=kind H.tool_page=nil H.tool_draft=nil H.tool_result=nil H.tool_selected=nil H.tool_request_id="" H.notice=""
    let service=if kind=="requests"{"hagency.tool_approvals.list"}else{"hagency.tool_grants.list"}
    A.request(service,{resourceId:resource engagementId:engagement after:after},fn(data){
        if (H.page!="tool_approvals" && H.page!="tool_grants") || H.tool_resource!=resource || H.tool_engagement!=engagement || H.tool_after!=after || H.tool_kind!=kind {return}
        if data.resourceId!=resource || data.engagementId!=engagement {H.notice=A.t("The response did not match this resource and agent.","响应与当前资源及 Agent 不匹配。") return}
        if kind=="rules" {for row in data.grants {if row.resourceId!=resource || row.engagementId!=engagement {H.notice=A.t("The permission belongs to a different agent.","此权限属于其他 Agent。") return}}}
        if kind=="requests" && engagement!="" {for row in data.approvals {if row.engagementId!=engagement {H.notice=A.t("The request belongs to a different agent.","此请求属于其他 Agent。") return}}}
        H.tool_page=data
    })
}
A.review_tool_grant = fn(row){
    if H.busy || H.command!=nil || H.page!="tool_grants" || H.tool_page==nil || row.revoked || row.resourceId!=H.tool_resource || row.engagementId!=H.tool_engagement {return}
    let found=false
    for current in H.tool_page.grants {if current.id==row.id && current.revision==row.revision && !current.revoked {found=true}}
    if !found {return}
    H.tool_draft={id:row.id resourceId:row.resourceId engagementId:row.engagementId revision:row.revision agent:row.agent kind:row.kind mode:row.mode taskId:row.taskId details:row.details} H.page="tool_grant_review" H.notice="" A.redraw()
}
A.submit_tool_grant = fn(){
    if H.busy || H.command!=nil || H.page!="tool_grant_review" || H.tool_draft==nil || H.tool_page==nil {return}
    let d=H.tool_draft let found=false
    if d.resourceId==H.tool_resource && d.engagementId==H.tool_engagement {for row in H.tool_page.grants {if row.id==d.id && row.revision==d.revision && !row.revoked {found=true}}}
    if !found {H.tool_draft=nil H.tool_page=nil H.page="tool_grants" H.notice=A.tool_error("management_revision_conflict") A.redraw() return}
    A.submit("hagency.tool_grants.revoke",{resourceId:d.resourceId engagementId:d.engagementId grantId:d.id expectedRevision:d.revision})
}
A.valid_tool_result = fn(data,args){
    if !data.is_object() {return false}
    let {resourceId=nil,engagementId=nil,grantId=nil,reviewedRevision=nil,revoked=false}=data
    return revoked && resourceId==args.resourceId && engagementId==args.engagementId && grantId==args.grantId && reviewedRevision==args.expectedRevision
}
A.tool_grant_received = fn(data){
    H.tool_result=data H.tool_resource=data.resourceId H.tool_engagement=data.engagementId H.tool_after="" H.tool_kind="rules" H.tool_page=nil H.tool_draft=nil H.page="tool_grant_result" H.notice=""
}
A.tool_grant_reply = fn(command,r){
    if r.is_ok {
        if !A.valid_tool_result(r.data,command.args) {H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.tool_grant_received(r.data)
        if A.save() {A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.tool_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" {
            H.command=nil H.tool_draft=nil H.tool_page=nil H.page="tool_grants"
            if A.save() {A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

A.stopped_attempt_valid=fn(row,resource){
    if !row.is_object(){return false}
    let {resourceId=nil,engagementId=nil,dispatchId=nil,agent=nil,projectId=nil,fence=nil,inspectionAvailable=nil,sharedResourceAuthority=nil}=row
    return resourceId==resource && engagementId.is_string() && engagementId!="" && dispatchId.is_string() && dispatchId!="" && agent.is_string() && projectId.is_string() && fence.is_number() && fence>0 && floor(fence)==fence && (inspectionAvailable==true || inspectionAvailable==false) && (sharedResourceAuthority==true || sharedResourceAuthority==false)
}
A.stopped_valid=fn(data,args){
    if !data.is_object(){return false}
    let {attempt=nil,revision=nil,resolvable=nil,canContinue=nil,entryCount=nil,entries=nil,nextEntry=nil}=data
    if !A.stopped_attempt_valid(attempt,args.resourceId) || attempt.engagementId!=args.engagementId || attempt.dispatchId!=args.dispatchId || !revision.is_string() || revision.len()!=64 {return false}
    if (resolvable!=true && resolvable!=false) || (canContinue!=true && canContinue!=false) || (canContinue && !resolvable) || !entryCount.is_number() || entryCount<0 || entryCount>1024 || floor(entryCount)!=entryCount || (!entries.is_array() && !entries.is_object()) || entries.len()>8 {return false}
    let {entryOffset=0}=args
    if nextEntry!=nil && (!nextEntry.is_number() || nextEntry<=entryOffset || nextEntry>=entryCount || floor(nextEntry)!=nextEntry){return false}
    for entry in entries {if !entry.is_object(){return false} let {relativePath=nil,kind=nil}=entry if !relativePath.is_string() || relativePath=="" || (kind!="file" && kind!="directory" && kind!="symlink"){return false}}
    return true
}
A.stopped_error=fn(code){
    if code=="management_stopped_not_resolvable" {return A.t("This attempt cannot be resolved from the current evidence. Refresh its inspection.","当前证据不足以处理此执行，请刷新检查结果。")}
    if code=="management_stopped_review_expired" {return A.t("The review expired. Refresh and review the task again.","核对已过期，请刷新并重新核对任务。")}
    if code=="management_revision_conflict" {return A.t("The task changed after inspection. Refresh before making a decision.","任务在检查后发生变化，请刷新后再决定。")}
    return A.error_text(code)
}
A.stopped_action_label=fn(action){
    if action=="continue" {return A.t("Continue remaining work","继续剩余工作")}
    if action=="accept_completed" {return A.t("Accept as completed","确认为已完成")}
    return A.t("Keep task blocked","保持任务阻塞")
}
A.open_stopped_tasks=fn(resource,workspace,after){
    if H.busy || resource==""{return}
    H.page="stopped_tasks" H.stopped_resource=resource H.stopped_workspace=workspace H.stopped_after=after H.stopped_list=nil H.stopped_review=nil H.stopped_detail=nil H.notice=""
    A.request("hagency.stopped.list",{resourceId:resource workspaceId:workspace after:after},fn(data){
        if H.page!="stopped_tasks" || H.stopped_resource!=resource || H.stopped_workspace!=workspace || H.stopped_after!=after{return}
        if !data.is_object(){H.notice=A.error_text("management_invalid_result") return}
        let {resourceId=nil,dispatches=nil,nextAfter=nil}=data
        if resourceId!=resource || (!dispatches.is_array() && !dispatches.is_object()) || dispatches.len()>16 || (nextAfter!=nil && (!nextAfter.is_string() || nextAfter==after)){H.notice=A.error_text("management_invalid_result") return}
        for row in dispatches {if !A.stopped_attempt_valid(row,resource){H.notice=A.error_text("management_invalid_result") return}}
        H.stopped_list=data
    })
}
A.open_stopped=fn(resource,engagement,dispatch,offset){
    if H.busy{return}
    let args={resourceId:resource engagementId:engagement dispatchId:dispatch entryOffset:offset}
    H.page="stopped_task" H.stopped_resource=resource H.stopped_engagement=engagement H.stopped_dispatch=dispatch H.stopped_offset=offset H.stopped_detail=nil H.stopped_review=nil H.stopped_mode="inspect" H.stopped_result=nil H.stopped_note="" H.stopped_instruction="" H.stopped_action="" H.notice=""
    A.request("hagency.stopped.get",args,fn(data){
        if H.page!="stopped_task" || H.stopped_resource!=resource || H.stopped_engagement!=engagement || H.stopped_dispatch!=dispatch || H.stopped_offset!=offset{return}
        if !A.stopped_valid(data,args){H.notice=A.error_text("management_invalid_result") return}
        H.stopped_detail=data
    })
}
A.review_stopped=fn(){
    let row=H.stopped_detail
    if H.busy || H.command!=nil || H.page!="stopped_task" || H.stopped_mode!="inspect" || row==nil || !row.resolvable || !row.attempt.sharedResourceAuthority{return}
    if row.attempt.resourceId!=H.stopped_resource || row.attempt.engagementId!=H.stopped_engagement || row.attempt.dispatchId!=H.stopped_dispatch{return}
    A.submit("hagency.stopped.review",{resourceId:H.stopped_resource engagementId:H.stopped_engagement dispatchId:H.stopped_dispatch expectedRevision:row.revision})
}
A.stopped_review_valid=fn(data,args){
    if !data.is_object(){return false}
    let {reviewCommandId=nil,inspectionId=nil,expiresAt=nil,inspection=nil}=data
    return reviewCommandId==args.commandId && inspectionId.is_string() && inspectionId!="" && expiresAt.is_number() && expiresAt>0 && A.stopped_valid(inspection,args) && inspection.resolvable && inspection.attempt.sharedResourceAuthority && inspection.revision==args.expectedRevision
}
A.stopped_result_valid=fn(data,args){
    if !data.is_object(){return false}
    let {commandId=nil,resourceId=nil,engagementId=nil,dispatchId=nil,action=nil,taskId=nil,taskStatus=nil,replacementId=nil,resolvedAt=nil}=data
    if commandId!=args.commandId || resourceId!=args.resourceId || engagementId!=args.engagementId || dispatchId!=args.dispatchId || action!=args.action || !taskId.is_string() || taskId=="" || !resolvedAt.is_number() || resolvedAt<=0{return false}
    if action=="continue" {return taskStatus=="in_progress" && replacementId.is_string() && replacementId!=""}
    return replacementId==nil && ((action=="accept_completed" && taskStatus=="done") || (action=="keep_blocked" && taskStatus=="blocked"))
}
A.stopped_review_received=fn(data){
    let row=data.inspection
    H.stopped_resource=row.attempt.resourceId H.stopped_engagement=row.attempt.engagementId H.stopped_dispatch=row.attempt.dispatchId H.stopped_review=data H.stopped_detail=row H.stopped_result=nil H.stopped_mode="choose" H.page="stopped_task" H.stopped_action="" H.stopped_note="" H.stopped_instruction="" H.notice=""
}
A.stopped_result_received=fn(data){
    H.stopped_resource=data.resourceId H.stopped_engagement=data.engagementId H.stopped_dispatch=data.dispatchId H.stopped_result=data H.stopped_review=nil H.stopped_detail=nil H.stopped_mode="result" H.page="stopped_task" H.notice=""
}
A.stopped_can_decide=fn(){
    if H.busy || H.command!=nil || H.page!="stopped_task" || H.stopped_review==nil || H.stopped_detail==nil{return false}
    let r=H.stopped_review let d=H.stopped_detail
    return r.inspection.revision==d.revision && d.resolvable && d.attempt.sharedResourceAuthority && d.attempt.resourceId==H.stopped_resource && d.attempt.engagementId==H.stopped_engagement && d.attempt.dispatchId==H.stopped_dispatch
}
A.choose_stopped=fn(action){
    if !A.stopped_can_decide() || H.stopped_mode!="choose"{return}
    if action!="continue" && action!="accept_completed" && action!="keep_blocked"{return}
    if action=="continue" && !H.stopped_detail.canContinue{return}
    H.stopped_action=action A.redraw()
}
A.confirm_stopped=fn(){
    if !A.stopped_can_decide() || H.stopped_mode!="choose" || H.stopped_action=="" || H.stopped_note.trim()=="" || H.stopped_note.len()>2000{return}
    if H.stopped_action=="continue" && (!H.stopped_detail.canContinue || H.stopped_instruction.trim()=="" || H.stopped_instruction.len()>8000){return}
    H.stopped_mode="confirm" A.redraw()
}
A.submit_stopped=fn(){
    if !A.stopped_can_decide() || H.stopped_mode!="confirm" || H.stopped_action=="" || H.stopped_note.trim()=="" || H.stopped_note.len()>2000{return}
    if H.stopped_action=="continue" && (!H.stopped_detail.canContinue || H.stopped_instruction.trim()=="" || H.stopped_instruction.len()>8000){return}
    if H.stopped_action!="continue" && H.stopped_action!="accept_completed" && H.stopped_action!="keep_blocked"{return}
    A.submit("hagency.stopped.resolve",{resourceId:H.stopped_resource engagementId:H.stopped_engagement dispatchId:H.stopped_dispatch reviewCommandId:H.stopped_review.reviewCommandId reviewRevision:H.stopped_review.inspection.revision action:H.stopped_action operatorNote:H.stopped_note continuationInstruction:if H.stopped_action=="continue" {H.stopped_instruction}else{nil}})
}
A.stopped_reply=fn(command,r){
    if r.is_ok {
        let reviewing=command.service=="hagency.stopped.review"
        if (reviewing && !A.stopped_review_valid(r.data,command.args)) || (!reviewing && !A.stopped_result_valid(r.data,command.args)){H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil
        if reviewing {A.stopped_review_received(r.data)}else{A.stopped_result_received(r.data)}
        if A.save(){A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.stopped_error(r.error)
        if r.error=="invalid_management_arguments" || r.error=="management_not_found" || r.error=="management_revision_conflict" || r.error=="management_stopped_not_resolvable" || r.error=="management_stopped_review_expired" {
            H.command=nil H.stopped_review=nil H.stopped_detail=nil H.stopped_mode="inspect" H.page="stopped_task"
            if A.save(){A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

A.workspace_valid=fn(data,resource,workspace){
    if !data.is_object(){return false}
    let {resourceId=nil,workspaceId=nil,dirty=nil,activeLeases=nil,quarantined=nil,sharedResourceCount=nil,releaseBlock=nil,lastReleasedAt=nil,revision=nil}=data
    if resourceId!=resource || workspaceId!=workspace || !workspaceId.is_string() || workspaceId=="" || !revision.is_string() || revision.len()!=64 {return false}
    if (dirty!=true && dirty!=false) || (quarantined!=true && quarantined!=false) || !activeLeases.is_number() || activeLeases<0 || floor(activeLeases)!=activeLeases || !sharedResourceCount.is_number() || sharedResourceCount<1 || floor(sharedResourceCount)!=sharedResourceCount {return false}
    if lastReleasedAt!=nil && (!lastReleasedAt.is_number() || lastReleasedAt<0) {return false}
    if releaseBlock!=nil && releaseBlock!="inspection_required" && releaseBlock!="active_execution" && releaseBlock!="shared_resource_authority" {return false}
    if releaseBlock==nil && (activeLeases>0 || quarantined) {return false}
    return true
}
A.workspace_state=fn(row){
    if row.releaseBlock=="shared_resource_authority" {return A.t("Shared workspace · access required","共享工作区 · 需要权限")}
    if row.quarantined {return A.t("Execution outcome needs inspection","需要检查执行结果")}
    if row.activeLeases>0 {return A.t("Task running","任务运行中")}
    if row.dirty {return A.t("Workspace needs review","工作区需要核对")}
    return A.t("Ready","就绪")
}
A.workspace_error=fn(code){
    if code=="management_workspace_inspection_required" {return A.t("An execution outcome is unresolved. Inspect the stopped task before releasing this workspace.","有执行结果尚未确认。请先检查已停止的任务，再解除工作区标记。")}
    if code=="management_workspace_active" {return A.t("A task still holds this workspace. Wait for it to finish, then refresh.","任务仍占用此工作区，请等待任务结束后刷新。")}
    if code=="management_revision_conflict" {return A.t("Workspace activity changed. Refresh and review the latest state.","工作区活动已变化，请刷新并核对最新状态。")}
    return A.error_text(code)
}
A.open_workspaces=fn(resource,after){
    if H.busy || resource=="" {return}
    H.page="workspaces" H.workspace_resource=resource H.workspace_after=after H.workspace_list=nil H.workspace_detail=nil H.workspace_review=nil H.notice=""
    A.request("hagency.workspaces.list",{resourceId:resource after:after},fn(data){
        if H.page!="workspaces" || H.workspace_resource!=resource || H.workspace_after!=after {return}
        if !data.is_object(){H.notice=A.error_text("management_invalid_result") return}
        let {resourceId=nil,workspaces=nil,nextAfter=nil}=data
        if resourceId!=resource || (!workspaces.is_array() && !workspaces.is_object()) || workspaces.len()>16 || (nextAfter!=nil && (!nextAfter.is_string() || nextAfter==after)) {H.notice=A.error_text("management_invalid_result") return}
        for row in workspaces {if !row.is_object(){H.notice=A.error_text("management_invalid_result") return} let {workspaceId=""}=row if !A.workspace_valid(row,resource,workspaceId){H.notice=A.error_text("management_invalid_result") return}}
        H.workspace_list=data
    })
}
A.open_workspace=fn(resource,workspace){
    if H.busy || resource=="" || workspace=="" {return}
    H.page="workspace" H.workspace_resource=resource H.workspace_id=workspace H.workspace_detail=nil H.workspace_review=nil H.workspace_mode="detail" H.notice=""
    A.request("hagency.workspaces.get",{resourceId:resource workspaceId:workspace},fn(data){
        if H.page!="workspace" || H.workspace_resource!=resource || H.workspace_id!=workspace {return}
        if !A.workspace_valid(data,resource,workspace){H.notice=A.error_text("management_invalid_result") return}
        H.workspace_detail=data
    })
}
A.workspace_can_clear=fn(){
    let row=H.workspace_detail
    return !H.busy && H.command==nil && H.page=="workspace" && H.workspace_mode=="detail" && row!=nil && A.workspace_valid(row,H.workspace_resource,H.workspace_id) && row.dirty && row.releaseBlock==nil && !row.quarantined && row.activeLeases==0
}
A.review_workspace=fn(){
    if !A.workspace_can_clear(){return}
    let row=H.workspace_detail
    H.workspace_review={resourceId:row.resourceId workspaceId:row.workspaceId expectedRevision:row.revision}
    H.workspace_mode="review" A.redraw()
}
A.submit_workspace=fn(){
    if H.busy || H.command!=nil || H.page!="workspace" || H.workspace_mode!="review" || H.workspace_review==nil || H.workspace_detail==nil {return}
    let d=H.workspace_review let row=H.workspace_detail
    if !A.workspace_valid(row,H.workspace_resource,H.workspace_id) || d.resourceId!=row.resourceId || d.workspaceId!=row.workspaceId || d.expectedRevision!=row.revision || !row.dirty || row.releaseBlock!=nil || row.quarantined || row.activeLeases!=0 {return}
    A.submit("hagency.workspaces.clear_dirty",d.to_json().parse_json())
}
A.valid_workspace_result=fn(data,args){
    if !data.is_object(){return false}
    let {workspace=nil,cleared=nil}=data
    return (cleared==true || cleared==false) && A.workspace_valid(workspace,args.resourceId,args.workspaceId) && !workspace.dirty && workspace.releaseBlock==nil && workspace.lastReleasedAt!=nil
}
A.workspace_received=fn(data){
    let row=data.workspace
    H.workspace_resource=row.resourceId H.workspace_id=row.workspaceId H.workspace_detail=row H.workspace_review=nil H.workspace_list=nil H.workspace_mode="result" H.page="workspace" H.notice=""
}
A.workspace_reply=fn(command,r){
    if r.is_ok {
        if !A.valid_workspace_result(r.data,command.args){H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.workspace_received(r.data)
        if A.save(){A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.workspace_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" || r.error=="management_workspace_inspection_required" || r.error=="management_workspace_active" {
            H.command=nil H.workspace_detail=nil H.workspace_review=nil H.workspace_mode="detail" H.page="workspace"
            if A.save(){A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

H.shared_approvals=[]
A.shared_mode = fn(row){let {sharedMode=nil}=row return sharedMode}
A.policy_mode_label = fn(row){return if A.shared_mode(row)=="chat" {A.t("Chat only","仅聊天")}else{A.policy_label(row.executionPolicy.yolo)}}
A.policy_label = fn(yolo){return if yolo {A.t("YOLO — unrestricted","YOLO — 不受限")}else{A.t("Standard permissions","标准权限")}}
A.policy_valid = fn(data,resource,engagement){
    if !data.is_object() {return false}
    let {resourceId=nil,engagementId=nil,agent=nil,projectId=nil,framework=nil,executionPolicy=nil,revision=nil,appliesTo=nil}=data
    if resourceId!=resource || engagementId!=engagement || !agent.is_string() || !projectId.is_string() || !framework.is_string() || !revision.is_string() || revision.len()!=64 || appliesTo!="next_dispatch" || !executionPolicy.is_object() {return false}
    let {yolo=nil}=executionPolicy
    return (yolo==true || yolo==false) && (!yolo || framework=="codex")
}
A.open_shared_approvals = fn(){
    if H.busy {return}
    H.page="shared_approvals" H.shared_approvals=[] H.notice=""
    A.request("hagency.shared_approvals.list",{},fn(data){
        if H.page!="shared_approvals" {return}
        let {approvals=[]}=data H.shared_approvals=approvals
    })
}
A.decide_shared_approval = fn(row,decision){
    if H.busy || row.canDecide!=true || row.decision!=nil {return}
    A.request("hagency.shared_approvals.decide",{id:row.approval.id digest:row.digest decision:decision},fn(data){A.open_shared_approvals()})
}
A.open_policies = fn(resource,after){
    if H.busy || resource=="" {return}
    H.page="execution_policies" H.policy_resource=resource H.policy_after=after H.policy_list=nil H.policy_detail=nil H.policy_draft=nil H.notice=""
    A.request("hagency.execution_policy.list",{resourceId:resource after:after},fn(data){
        if H.page!="execution_policies" || H.policy_resource!=resource || H.policy_after!=after {return}
        if !data.is_object() {H.notice=A.error_text("management_invalid_result") return}
        let {resourceId=nil,agents=nil,nextAfter=nil}=data
        if resourceId!=resource || (!agents.is_array() && !agents.is_object()) || agents.len()>16 || (nextAfter!=nil && (!nextAfter.is_string() || nextAfter==after)) {H.notice=A.error_text("management_invalid_result") return}
        for row in agents {if !row.is_object() {H.notice=A.error_text("management_invalid_result") return} let {engagementId=""}=row if !A.policy_valid(row,resource,engagementId) {H.notice=A.error_text("management_invalid_result") return}}
        H.policy_list=data
    })
}
A.open_policy = fn(resource,engagement){
    if H.busy || resource=="" || engagement=="" {return}
    H.page="execution_policy" H.policy_resource=resource H.policy_engagement=engagement H.policy_detail=nil H.policy_draft=nil H.policy_mode="detail" H.notice=""
    A.request("hagency.execution_policy.get",{resourceId:resource engagementId:engagement},fn(data){
        if H.page!="execution_policy" || H.policy_resource!=resource || H.policy_engagement!=engagement {return}
        if !A.policy_valid(data,resource,engagement) {H.notice=A.error_text("management_invalid_result") return}
        H.policy_detail=data
    })
}
A.open_policy_grants = fn(){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_detail==nil || (H.policy_mode!="detail" && H.policy_mode!="result") {return}
    let row=H.policy_detail
    if row.resourceId!=H.policy_resource || row.engagementId!=H.policy_engagement {return}
    if A.shared_mode(row)!=nil {A.open_shared_approvals() return}
    A.open_tools(row.resourceId,row.engagementId,"","rules")
}
A.choose_policy = fn(yolo){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_detail==nil || H.policy_mode=="result" {return}
    let row=H.policy_detail
    if yolo && row.framework!="codex" {return}
    H.policy_draft={resourceId:row.resourceId engagementId:row.engagementId expectedRevision:row.revision executionPolicy:{yolo:yolo}}
    H.policy_mode="edit" H.notice="" A.redraw()
}
A.review_policy = fn(){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_detail==nil || H.policy_draft==nil || H.policy_mode!="edit" {return}
    let d=H.policy_draft let row=H.policy_detail
    if d.resourceId!=row.resourceId || d.engagementId!=row.engagementId || d.expectedRevision!=row.revision || (d.executionPolicy.yolo==row.executionPolicy.yolo && A.shared_mode(row)!="chat") {return}
    H.policy_mode="review" A.redraw()
}
A.submit_policy = fn(){
    if H.busy || H.command!=nil || H.page!="execution_policy" || H.policy_mode!="review" || H.policy_draft==nil || H.policy_detail==nil {return}
    let d=H.policy_draft let row=H.policy_detail
    if d.resourceId!=H.policy_resource || d.engagementId!=H.policy_engagement || d.expectedRevision!=row.revision || (d.executionPolicy.yolo && row.framework!="codex") {return}
    A.submit("hagency.execution_policy.edit",d.to_json().parse_json())
}
A.valid_policy_result = fn(data,args){return A.policy_valid(data,args.resourceId,args.engagementId) && data.executionPolicy.yolo==args.executionPolicy.yolo}
A.policy_received = fn(data){
    H.policy_resource=data.resourceId H.policy_engagement=data.engagementId H.policy_detail=data H.policy_draft=nil H.policy_list=nil H.policy_mode="result" H.page="execution_policy" H.notice=""
}
A.policy_reply = fn(command,r){
    if r.is_ok {
        if !A.valid_policy_result(r.data,command.args) {H.notice=A.error_text("management_outcome_unknown") A.redraw() return}
        H.command=nil A.policy_received(r.data)
        if A.save() {A.acknowledge(command.args.commandId)}
    } else {
        H.notice=A.tool_error(r.error)
        if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        if r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_not_found" {
            H.command=nil H.policy_draft=nil H.policy_detail=nil H.policy_mode="detail" H.page="execution_policy"
            if A.save() {A.acknowledge(command.args.commandId)}
        }
    }
    A.redraw()
}

A.personal_reason = fn(code){
    if code == "local_revision_conflict" || code == "personal_agent_settings_changed" {return A.t("The agent or policy changed. Refresh its settings before reviewing another edit.", "Agent 或策略已变化，请刷新设置后再核对修改。")}
    if code == "personal_policy_original_device_required" {return A.t("Recover this request on the device that originally sent it. Its command identity is retained.", "请在最初发送此请求的设备上恢复，原始请求标识已保留。")}
    if code == "configuration_device_offline" || code == "configuration_device_unavailable" {return A.t("The agent’s execution device is offline. Bring it online and refresh before reviewing another request.", "Agent 的执行设备离线，请将其联网并刷新后再核对请求。")}
    if code == "configuration_unsupported" {return A.t("Personal-agent configuration is currently unavailable on this server. Any pending request keeps its original identity for recovery.", "此服务器当前未提供个人 Agent 配置，待处理请求会保留原始标识以便恢复。")}
    if code == "configuration_request_busy" || code == "configuration_queue_full" {return A.t("The execution device has another configuration request. Wait for it, then refresh.", "执行设备正在处理其他配置请求，请等待后刷新。")}
    if code == "invalid_personal_policy" {return A.t("Choose a policy mode and a nonnegative whole token limit within the supported range.", "请选择策略模式，并输入支持范围内的非负整数 token 上限。")}
    if code == "configuration_outcome_unknown" || code == "configuration_request_expired" || code == "management_outcome_unknown" {return A.t("The settings request outcome is unknown. Recover the original saved request; do not submit a replacement.", "设置请求结果未知，请恢复已保存的原请求，不要另建替代请求。")}
    return A.error_text(code)
}
A.personal_not_applied = fn(service,code){
    let common=code == "personal_agent_not_found" || code == "personal_agent_settings_changed" || code == "configuration_device_offline" || code == "configuration_device_unavailable" || code == "configuration_queue_full" || code == "configuration_request_busy" || code == "execution_device_required" || code == "agent_retired"
    if service == "hagency.personal_agents.observe" {return common || code == "invalid_personal_observation"}
    if service == "hagency.personal_agents.policy.save" {return common || code == "invalid_personal_policy" || code == "personal_policy_observation_required" || code == "local_revision_conflict" || code == "invalid_local_policy"}
    return false
}
A.personal_period = fn(value){
    if value == "lifetime" {return A.t("Lifetime", "累计")}
    if value == "utc_day" {return A.t("Daily (UTC)", "每日（UTC）")}
    if value == "utc_month" {return A.t("Monthly (UTC)", "每月（UTC）")}
    return value
}
A.personal_policy_mode = fn(value){
    if value == "allow" {return A.t("Allow", "允许")}
    if value == "deny" {return A.t("Deny", "拒绝")}
    if value == "ask_owner" {return A.t("Ask owner", "询问主人")}
    if value == "rules" {return A.t("Custom rules", "自定义规则")}
    if value == "unset" {return A.t("Not set", "未设置")}
    if value == "unlimited" {return A.t("Unlimited", "不限")}
    if value == "tokens" {return A.t("Token limit", "Token 上限")}
    return value
}
A.open_personal_agents = fn(after,page){
    if H.busy {return}
    H.page="personal_agents" H.personal_list=nil H.personal_after=after H.personal_page=page
    A.request("hagency.personal_agents.list",{after:after limit:16},fn(data){
        if data.protocol != "hagency-personal-settings-v1" {H.notice=A.personal_reason("personal_agent_settings_invalid") return}
        H.personal_list=data
    })
}
A.open_personal_agent = fn(id){
    if H.busy {return}
    if H.personal_id != id {H.personal_result=nil H.personal_observed=nil H.personal_config.result=nil}
    H.personal_id=id H.page="personal_agent" H.personal_detail=nil H.personal_mode="detail" H.personal_draft=nil
    A.request("hagency.personal_agents.get",{id:id},fn(data){
        if data.protocol != "hagency-personal-settings-v1" || data.agent.id != id {H.notice=A.personal_reason("personal_agent_settings_invalid") return}
        H.personal_detail=data
    })
}
A.personal_can_observe = fn(){
    if H.busy || H.command != nil || H.personal_detail == nil {return false}
    let s=H.personal_detail.settings
    return s.supported && s.online && H.personal_detail.agent.executionDeviceId != nil
}
A.review_personal_observation = fn(){
    if !A.personal_can_observe() {return}
    let row=H.personal_detail.agent
    H.personal_draft={agentId:row.id expectedGeneration:row.generation}
    H.personal_mode="observe_review" A.redraw()
}
A.submit_personal_observation = fn(){
    if !A.personal_can_observe() || H.personal_mode != "observe_review" || H.personal_draft == nil {return}
    let d=H.personal_draft
    if d.agentId != H.personal_detail.agent.id || d.expectedGeneration != H.personal_detail.agent.generation {return}
    A.submit("hagency.personal_agents.observe",{agentId:d.agentId expectedGeneration:d.expectedGeneration})
}
A.personal_observation_received = fn(data){
    H.personal_id=data.agentId H.personal_observed=data H.personal_mode="detail" H.personal_draft=nil H.personal_detail=nil H.page="personal_agent"
}
A.personal_can_edit = fn(){
    if H.busy || H.command != nil || H.personal_detail == nil {return false}
    let s=H.personal_detail.settings
    return s.supported && s.online && s.observation != nil
}
A.edit_personal_policy = fn(){
    if !A.personal_can_edit() {return}
    let row=H.personal_detail.agent
    let o=H.personal_detail.settings.observation
    H.personal_draft={agentId:row.id expectedGeneration:row.generation expectedRevision:o.policyRevision
        kind:o.budget.kind tokens:if o.budget.tokens == nil {""} else {""+o.budget.tokens} period:o.budget.period
        requests:o.requests highRiskTools:o.highRiskTools replacesRules:o.highRiskTools == "rules"}
    H.personal_mode="edit" A.redraw()
}
A.personal_valid = fn(){
    if H.personal_draft == nil {return false}
    let d=H.personal_draft
    if d.highRiskTools != "deny" && d.highRiskTools != "ask_owner" {return false}
    if d.kind == "tokens" {
        let value=d.tokens.trim()
        if value == "" || value.len() > 64 {return false}
        for byte in value.to_bytes() {if byte < 48 || byte > 57 {return false}}
        let n=value.to_f64()
        return n >= 0 && n <= 9007199254740991
    }
    return d.kind == "unset" || d.kind == "unlimited"
}
A.review_personal_policy = fn(){
    if !A.personal_can_edit() {return}
    if !A.personal_valid() {H.notice=A.personal_reason("invalid_personal_policy") A.redraw() return}
    H.personal_mode="review" H.notice="" A.redraw()
}
A.submit_personal_policy = fn(){
    if !A.personal_can_edit() || H.personal_mode != "review" || !A.personal_valid() {return}
    let d=H.personal_draft
    if d.agentId != H.personal_detail.agent.id || d.expectedGeneration != H.personal_detail.agent.generation {return}
    A.submit("hagency.personal_agents.policy.save",{agentId:d.agentId expectedGeneration:d.expectedGeneration expectedRevision:d.expectedRevision
        policy:{budget:{kind:d.kind tokens:if d.kind == "tokens" {d.tokens.trim().to_f64()} else {nil} period:d.period} requests:d.requests highRiskTools:d.highRiskTools}})
}
A.personal_saved = fn(data){
    H.personal_observed=nil
    H.personal_id=data.agentId H.personal_result=data H.personal_mode="detail" H.personal_draft=nil H.personal_detail=nil H.page="personal_agent"
}
A.personal_config_service=fn(service){return service=="hagency.personal_agents.model.save" || service=="hagency.personal_agents.workspace.prepare" || service=="hagency.personal_agents.rules.edit"}
A.personal_config_operation=fn(operation){return operation=="personal_agent_model" || operation=="personal_agent_workspace" || operation=="personal_agent_rules"}
A.personal_config_reason=fn(code){
    if code=="personal_configuration_cancelled" {return A.t("Settings review closed. No replacement request was sent.","已关闭设置确认，未发送替代请求。")}
    if code=="personal_execution_device_required" {return A.t("Open Hagency on this agent’s execution device to select folders or edit custom rules.","请在此 Agent 的执行设备上打开 Hagency，以选择目录或编辑自定义规则。")}
    if code=="personal_model_observation_required" || code=="personal_policy_observation_required" {return A.t("Read current settings from the execution device before editing.","编辑前请先从执行设备读取当前设置。")}
    if code=="personal_model_changed" || code=="configuration_model_unavailable" {return A.t("The model choices changed. Read current settings, then choose an available model again.","可用模型已变化，请读取当前设置后重新选择模型。")}
    if code=="invalid_personal_rules" {return A.t("Use 1–64 exact tool names and existing directories in the native rules editor.","请在原生规则编辑器中使用 1–64 个准确工具名称和现有目录。")}
    if code=="invalid_personal_model" {return A.t("Choose a listed model and one of its supported reasoning levels.","请选择列表中的模型及其支持的推理强度。")}
    if code=="personal_workspace_required" {return A.t("Choose the default workspace, or select a folder in the native review.","请选择默认工作区，或在原生确认窗口中选择目录。")}
    if code=="management_saved_command_not_found" {return A.t("No saved result is available for the original request. Keep its identity and refresh Saved commands before any new edit.","尚无原请求的保存结果，请保留原标识并刷新已保存请求，再进行其他编辑。")}
    if code=="configuration_runtime_busy" {return A.t("The agent is busy. Wait for its current work to finish before changing settings.","Agent 正在工作，请等待当前工作完成后再修改设置。")}
    return A.personal_reason(code)
}
A.open_personal_model=fn(){
    if !A.personal_can_edit(){return}
    let row=H.personal_detail.agent
    let p=H.personal_config
    p.epoch=p.epoch+1 p.choices=nil p.draft=nil p.offset=0 H.page="personal_model" H.busy=true H.notice=""
    let epoch=p.epoch let id=row.id let generation=row.generation
    A.redraw()
    host.request("hagency.personal_agents.model.choices",{id:id},fn(r){
        if H.personal_config.epoch!=epoch{return}
        H.busy=false
        if H.page!="personal_model" || H.personal_id!=id{A.redraw() return}
        if !r.is_ok{H.notice=A.personal_config_reason(r.error) A.redraw() return}
        let data=r.data
        if data.agentId!=id || data.generation!=generation || data.models.len()>256 {H.notice=A.personal_config_reason("personal_agent_settings_changed") A.redraw() return}
        for choice in data.models{if choice.reasoningEfforts.len()>16{H.notice=A.personal_config_reason("invalid_personal_model") A.redraw() return}}
        p.choices=data p.draft={agentId:id expectedGeneration:generation expectedProfileDigest:data.profileDigest runtime:"" model:"" reasoningEffort:"" webSearch:false workspace:if data.workspaceConfigured{"preserve"}else{"default"}}
        if data.current!=nil{
            p.draft.webSearch=data.current.webSearch
            for choice in data.models{if choice.runtime==data.current.runtime && choice.model==data.current.model{
                p.draft.runtime=choice.runtime p.draft.model=choice.model
                for effort in choice.reasoningEfforts{if effort==data.current.reasoningEffort{p.draft.reasoningEffort=effort}}
            }}
        }
        A.redraw()
    })
}
A.personal_model_choice=fn(){
    let p=H.personal_config
    if p.choices==nil || p.draft==nil{return nil}
    for row in p.choices.models{if row.runtime==p.draft.runtime && row.model==p.draft.model{return row}}
    return nil
}
A.personal_model_pick=fn(runtime,model){
    if H.busy || H.command!=nil || H.personal_config.choices==nil{return}
    let p=H.personal_config
    for row in p.choices.models{if row.runtime==runtime && row.model==model{
        p.draft.runtime=runtime p.draft.model=model p.draft.reasoningEffort="" A.redraw() return
    }}
}
A.personal_model_effort=fn(value){
    if H.busy || H.command!=nil{return}
    let row=A.personal_model_choice()
    if row==nil{return}
    for effort in row.reasoningEfforts{if effort==value{H.personal_config.draft.reasoningEffort=value A.redraw() return}}
}
A.personal_model_valid=fn(){
    let row=A.personal_model_choice()
    if row==nil{return false}
    let d=H.personal_config.draft
    if d.workspace!="preserve" && d.workspace!="default"{return false}
    if d.workspace=="preserve" && !H.personal_config.choices.workspaceConfigured{return false}
    for effort in row.reasoningEfforts{if effort==d.reasoningEffort{return true}}
    return false
}
A.submit_personal_model=fn(){
    if H.busy || H.command!=nil || H.page!="personal_model"{return}
    if !A.personal_model_valid(){H.notice=A.personal_config_reason("invalid_personal_model") A.redraw() return}
    A.submit("hagency.personal_agents.model.save",H.personal_config.draft.to_json().parse_json())
}
A.submit_personal_native=fn(service){
    if !A.personal_can_edit() || (service!="hagency.personal_agents.workspace.prepare" && service!="hagency.personal_agents.rules.edit"){return}
    let row=H.personal_detail.agent
    A.submit(service,{agentId:row.id expectedGeneration:row.generation})
}
A.personal_config_result_valid=fn(data,commandId,agentId,operation){
    if data==nil{return false}
    let {protocol="",saved=false,workspacePrepared=false,profileDigest="",policyRevision=""}=data
    let actualId=A.recipient_optional(data,"commandId") let actualAgent=A.recipient_optional(data,"agentId")
    if protocol!="hagency-personal-settings-v1" || actualId!=commandId || (actualAgent==nil || actualAgent=="") || (agentId!="" && actualAgent!=agentId){return false}
    if operation=="personal_agent_workspace"{return workspacePrepared}
    if operation=="personal_agent_model"{return saved && profileDigest!=""}
    if operation=="personal_agent_rules"{return saved && policyRevision!=""}
    return false
}
A.personal_config_op=fn(service){
    if service=="hagency.personal_agents.model.save"{return "personal_agent_model"}
    if service=="hagency.personal_agents.workspace.prepare"{return "personal_agent_workspace"}
    return "personal_agent_rules"
}
A.personal_config_recorded=fn(data){
    H.personal_config.result=data H.personal_config.draft=nil H.personal_config.choices=nil
    H.personal_observed=nil H.personal_result=nil H.personal_id=data.agentId H.personal_mode="detail" H.personal_draft=nil H.personal_detail=nil H.page="personal_agent"
}
A.personal_config_not_applied=fn(code){
    for known in ["invalid_personal_policy","personal_agent_not_found","personal_agent_settings_changed","personal_policy_observation_required","configuration_device_offline","configuration_device_unavailable","configuration_queue_full","configuration_request_busy","execution_device_required","agent_retired","local_revision_conflict","invalid_local_policy","invalid_personal_model","personal_model_observation_required","personal_model_changed","personal_workspace_required","personal_execution_device_required","configuration_model_unavailable","configuration_runtime_busy","invalid_personal_rules"]{if code==known{return true}}
    return false
}
A.personal_config_rejected=fn(commandId,code){
    H.command=nil H.personal_config.draft=nil H.personal_config.choices=nil H.personal_detail=nil H.page="personal_agent"
    H.notice=A.personal_config_reason(code)
    if A.save(){
        host.request("hagency.intent.pending",{},fn(reply){
            if reply.is_ok{
                H.saved_commands=reply.data.commands
                for row in reply.data.commands{if row.commandId==commandId && row.hasReply{A.acknowledge(commandId)}}
            }
            A.redraw()
        })
    }
    A.redraw()
}
A.personal_config_reply=fn(command,r){
    if H.command==nil || H.command.args.commandId!=command.args.commandId{return}
    H.busy=false
    if r.is_ok && A.personal_config_result_valid(r.data,command.args.commandId,command.args.agentId,A.personal_config_op(command.service)){
        H.command=nil H.notice="" A.personal_config_recorded(r.data)
        if A.save(){A.acknowledge(command.args.commandId)} A.open_personal_agent(r.data.agentId) A.redraw() return
    }
    if !r.is_ok && A.personal_config_not_applied(r.error){A.personal_config_rejected(command.args.commandId,r.error) return}
    if !r.is_ok && (r.error=="personal_configuration_cancelled" || r.error=="provider_confirmation_expired" || r.error=="personal_confirmation_expired"){
        H.command=nil H.notice=A.personal_config_reason(r.error) A.save()
        host.request("hagency.intent.pending",{},fn(reply){if reply.is_ok{H.saved_commands=reply.data.commands} A.redraw()}) A.redraw() return
    }
    command.nativeRecover=true A.save()
    H.notice=if r.is_ok{A.personal_config_reason("management_outcome_unknown")}else{A.personal_config_reason(r.error)} A.redraw()
}
A.recover_personal_config=fn(commandId,operation,agentId){
    if H.busy{return}
    if H.command!=nil && H.command.args.commandId!=commandId{return}
    H.busy=true H.notice=A.t("Recovering the original settings request…","正在恢复原始设置请求…") A.redraw()
    host.request("hagency.intent.retry",{commandId:commandId},fn(r){
        H.busy=false
        if H.command!=nil && H.command.args.commandId!=commandId{return}
        if !r.is_ok{
            if A.personal_config_not_applied(r.error){A.personal_config_rejected(commandId,r.error) return}
            H.notice=A.personal_config_reason(r.error) A.redraw() return
        }
        if r.data.operation!=operation || !A.personal_config_result_valid(r.data.data,commandId,agentId,operation){H.notice=A.personal_config_reason("management_outcome_unknown") A.redraw() return}
        H.command=nil H.notice="" A.personal_config_recorded(r.data.data)
        if A.save(){A.acknowledge(commandId)} A.open_personal_agent(r.data.data.agentId) A.redraw()
    })
}

A.personal_state = fn(value){
    if value == "active" {return A.t("Active registration", "有效登记")}
    if value == "suspended" {return A.t("Suspended", "已暂停")}
    if value == "retired" {return A.t("Retired", "已停用")}
    if value == "creating" {return A.t("Creation pending", "待创建")}
    return value
}
A.resource_period = fn(period){
    if period == nil {return A.t("Not declared", "未声明")}
    if period == "monthly" {return A.t("Monthly", "每月")}
    if period == "daily" {return A.t("Daily", "每日")}
    return "" + period
}
A.resource_short_id = fn(id){
    let chars=id.to_chars()
    if chars.len() <= 16 {return id}
    let prefix="".to_chars()
    let suffix="".to_chars()
    for i char in chars {
        if i < 4 {prefix.push(char)}
        if i >= chars.len() - 8 {suffix.push(char)}
    }
    return prefix.to_string() + "…" + suffix.to_string()
}
A.resource_label_id = fn(id){
    let label=A.resource_short_id(id)
    for row in H.resources {
        if row.id != id && A.resource_short_id(row.id) == label {return id}
    }
    return label
}
A.redraw = fn(){
    ui.heading.render() ui.navigation.render() ui.notice.set_text(H.notice) ui.notice.set_visible(H.notice != "" && !H.busy)
    let route = H.page + if H.page == "wizard" {"/" + H.wizard.step} else if H.page == "project_wizard" {"/" + H.project_draft.step} else if H.page == "project_setup" {"/" + H.confirm} else if H.page == "agent_wizard" {"/" + H.agent_review} else if H.page == "agent_action" {"/" + H.agent_confirmation} else if H.page == "personal_agent" {"/"+H.personal_mode} else if H.page=="connection_reoffer" && H.reoffer_draft!=nil {"/"+H.reoffer_draft.review} else if H.page=="connection_history" {"/"+H.history_page} else if H.page=="stopped_task" {"/"+H.stopped_resource+"/"+H.stopped_dispatch+"/"+H.stopped_offset+"/"+H.stopped_mode} else if H.page=="stopped_tasks" {"/"+H.stopped_resource+"/"+H.stopped_workspace+"/"+H.stopped_after} else if H.page=="workspace" {"/"+H.workspace_resource+"/"+H.workspace_id+"/"+H.workspace_mode} else if H.page=="workspaces" {"/"+H.workspace_resource+"/"+H.workspace_after} else if H.page=="execution_policy" {"/"+H.policy_resource+"/"+H.policy_engagement+"/"+H.policy_mode} else if H.page=="execution_policies" {"/"+H.policy_resource+"/"+H.policy_after} else if H.page=="tool_request" {"/"+H.tool_resource+"/"+H.tool_request_id} else if H.page=="tool_approvals" || H.page=="tool_grants" {"/"+H.tool_resource+"/"+H.tool_engagement+"/"+H.tool_after+"/"+H.tool_kind} else if H.page=="approval_bindings" {"/"+H.binding_resource+"/"+H.binding_after+"/"+H.binding_filters.agent+"/"+H.binding_filters.project} else {""}
    let key=route + "/" + A.route_identity()
    if key != H.rendered_route {ui.content.remember_scroll(H.rendered_route) ui.content.reset_scroll() H.rendered_route=key}
    ui.content.body.page.render()
    if H.ux.restore && !H.busy {H.ux.restore=false ui.content.restore_scroll(key)}
}
let on_app_locale_changed = fn(locale){ A.redraw() }
A.save = fn(){
    if H.session == nil { return false }
    let bytes = {version: 1 account: H.session.account wizard: H.wizard workspace:H.entry_role resourceJourney:H.ux.resourceJourney setupAccountId:H.ux.accountId projectDraft: H.project_draft agentDraft:H.agent_draft poolDraft:H.pool_draft command: H.command}.to_json()
    fs.write("onboarding-v1.json", bytes)
    if !fs.exists("onboarding-v1.json") || fs.read("onboarding-v1.json") != bytes {
        H.notice = A.t("Could not save this page. Submitted requests remain recoverable from native storage.", "无法保存此页面，已提交的请求仍可从原生存储中恢复。")
        return false
    }
    return true
}
A.reauthenticate = fn(){
    if H.busy || !H.needs_signin {return}
    A.request("hagency.account.reauthenticate",{},fn(data){
        if data.state == "cancelled" {H.notice=A.t("Sign-in cancelled. Your existing records and requests are unchanged.", "已取消重新登录，已有记录和请求保持不变。")}
        else {H.notice=A.t("Continue signing in with the same account in Rinx.", "请在 Rinx 中继续使用同一账号登录。")}
    })
}
A.request = fn(service, args, done){
    if H.busy { return }
    H.busy = true H.notice = A.t("Updating…", "正在更新…") A.redraw()
    host.request(service, args, fn(r){
        H.busy = false
        H.ux.errorCode=if r.is_ok{""}else{r.error}
        if !r.is_ok && H.page=="overview" {H.ux.dashboardError=true}
        if !r.is_ok && H.page=="inbox" {H.ux.inboxError=true H.ux.inboxReady=false}
        if !r.is_ok && (r.error == "native_resume_missing" || r.error == "native_resume_revoked") {H.needs_signin=true}
        if r.is_ok { H.notice = "" done(r.data) } else { H.notice = if service=="hagency.connections.history" || H.page=="connection_reoffer" {A.readmission_error(r.error)} else if service == "hagency.agents.settlement.get" {A.settlement_reason(r.error)} else if H.page == "agent_budget" || H.page == "agent_topup" {A.budget_reason(r.error)} else if H.page == "agent_control" {A.control_reason(r.error)} else if H.page == "device_execution" {A.execution_reason(r.error)} else if H.page == "onboarding" {A.onboarding_reason(r.error)} else if H.page == "project_setup" {A.setup_reason(r.error)} else if H.page == "allocations" || H.page == "allocation_action" {A.allocation_reason(r.error)} else if H.page=="stopped_task" || H.page=="stopped_tasks" {A.stopped_error(r.error)} else if H.page=="workspace" || H.page=="workspaces" {A.workspace_error(r.error)} else if H.page=="execution_policy" || H.page=="execution_policies" || H.page=="tool_request" || H.page=="tool_approvals" || H.page=="tool_grants" || H.page=="tool_grant_review" || H.page=="tool_grant_result" {A.tool_error(r.error)} else if H.page=="approval_bindings" || H.page=="approval_binding_review" || H.page=="approval_binding_result" {A.binding_error(r.error)} else if H.page=="resource_alerts" || H.page=="resource_alert" {A.alert_error(r.error)} else if H.page == "resource_detail" {A.resource_error(r.error)} else if H.page == "personal_agents" || H.page == "personal_agent" {A.personal_reason(r.error)} else if H.page == "agents" || H.page == "agent_action" || H.page == "agent_wizard" || H.page == "agent_status" || H.page == "agent_work" || H.page == "agent_work_list" || H.page == "agent_removals" || H.page == "agent_removal" {A.agent_reason(r.error)} else {A.error_text(r.error)} }
        A.redraw()
    })
}
A.observe_verification = fn(connection, observed_at){
    if connection.verification != nil && connection.verification.status == "verified" {
        let seconds = max(0.0, (connection.verification.freshUntilMs - observed_at) / 1000.0 - 1.0)
        if seconds == 0.0 {connection.verification.status = "stale"}
        else {start_timeout(seconds, || {connection.verification.status = "stale" A.redraw()})}
    }
}
A.connections_received = fn(data){
    H.connections = data.items H.connection_after = data.nextAfter
    for connection in H.connections {A.observe_verification(connection, data.observedAtMs)}
}
A.execution_reason = fn(code){
    if code == "shared_successors_disabled" {return A.t("Starting another process is not enabled in this build. Existing agent records and work history remain available.", "此版本尚未启用再次启动进程。已有 Agent 记录与任务历史仍可查看。")}
    if code == "owner_source_adoption_required" || code == "shared_executor_adoption_required" {return A.t("Open Shared capacity to restore this device's native resource access first.", "请先打开共享容量，恢复此设备的原生资源访问。")}
    if code == "adopted_executor_device_reauthorization_required" {return A.t("Open this assignment on its original execution device and owner account.", "请使用原执行设备和资源主人账号打开此分配。")}
    if code == "shared_successor_issuance_unavailable" {return A.t("The server does not currently allow another process. Original saved starts remain recoverable.", "服务器当前不允许启动另一进程。仍可恢复已保存的原始启动请求。")}
    return A.error_text(code)
}
A.open_execution = fn(after){
    if H.busy {return}
    H.page="device_execution" H.execution_page=nil H.execution_after=after
    let args={} if after != nil {args.after=after}
    A.request("hagency.execution.assignments",args,fn(data){H.execution_page=data})
}
A.execution_select = fn(id){
    if H.execution_page == nil || !H.execution_page.supported {return nil}
    for row in H.execution_page.items {if row.assignmentId == id {return row}}
    return nil
}
A.execution_action = fn(id,resume){
    if H.busy {return}
    let row=A.execution_select(id) if row == nil {return}
    if resume && !row.savedStart {return}
    H.execution_result=nil
    A.request(if resume {"hagency.execution.resume"} else {"hagency.execution.review"},{assignmentId:row.assignmentId},fn(data){H.execution_result=data A.open_execution(H.execution_after)})
}
A.execution_result_text = fn(data){
    if data.state == "review_closed" {return A.t("Review closed without confirming a new start.", "已关闭核对，未确认新的启动。")}
    if data.state == "outcome_unknown" {return A.t("The original start may have been submitted. Resume its saved request before considering another start.", "原启动请求可能已提交。请先恢复已保存的请求，再考虑新的启动。")}
    let {result=nil,progress=nil}=data
    if result != nil {
        if result.state == "no_saved_intent" {return A.t("No original start was saved. Resume did not create one.", "没有已保存的原始启动请求，恢复操作未创建请求。")}
        if result.state == "resumed" {progress=result.progress}
    }
    if progress != nil {
        if progress.state == "running" {return A.t("A process was active when checked. Refresh for the latest recorded observation.", "检查时有进程活动。请刷新以查看最新记录。")}
        if progress.state == "recorded" {return A.t("A native observation was recorded. Review agent status and work history for its outcome.", "已记录原生观测结果，请查看 Agent 状态和任务历史了解结果。")}
        if progress.state == "stopping" {return A.t("The original process is stopping; usage and cleanup may still be unresolved.", "原进程正在停止，用量与清理可能尚未确认。")}
    }
    return A.t("No active process was confirmed. The original start remains recoverable.", "尚未确认活动进程，原启动请求仍可恢复。")
}
A.execution_state = fn(state){
    if state == "stopped" {return A.t("Stopped at last observation", "上次观测已停止")}
    if state == "qualified" {return A.t("Qualified at last observation", "上次观测资格已核验")}
    return A.t("Current process not confirmed", "当前进程未确认")
}
A.task_status = fn(s){
    if s=="created"{return A.t("Created","已创建")} if s=="accepted"{return A.t("Accepted","已接收")}
    if s=="in_progress"{return A.t("In progress","进行中")} if s=="blocked"{return A.t("Blocked","受阻")} if s=="done"{return A.t("Done","已完成")} return s
}
A.task_write_supported = fn(data){if data==nil{return false} for index key value in data{if key.to_string()=="writeSupported"{return value}} return false}
A.task_text = fn(v){if v==nil || v=="" {return "—"} return v}
A.task_unavailable = fn(){return A.t("This profile uses migrated resource storage. Operator tasks have not been imported into it yet. The original archive is not opened by this screen.","此档案已使用迁移后的资源存储，人工任务尚未导入。此页面不会打开原归档。")}

A.is_task_operation=fn(op){for name in ["task_create","task_edit","task_delete","task_accept","task_transition","task_comment"]{if op==name{return true}} return false}
A.task_permission_list=fn(data,op){for index key value in data{if key.to_string()=="writeOperations"{for allowed in value{if allowed==op{return true}}}} return false}
A.task_permission=fn(data,op){
    if data==nil{return false}
    for index key value in data{if key.to_string()=="writeSupported" && value==true{return A.task_permission_list(data,op)}}
    return false
}
A.task_can=fn(op){if op=="create"{return A.task_permission(H.task_page,op)} return A.task_permission(H.task_detail,op)}

A.task_granularity=fn(value){if value=="epic"{return A.t("Epic","大任务")} if value=="subtask"{return A.t("Subtask","子任务")} return A.t("Task","任务")}
A.task_review_value=fn(input,key){for index name value in input{if name.to_string()==key{if value==nil || value==""{return A.t("Cleared","已清空")} return value}} return A.t("Unchanged","保持原值")}
A.task_action_name=fn(op){
    if op=="create"{return A.t("Create task","创建任务")} if op=="edit"{return A.t("Edit task","编辑任务")}
    if op=="delete"{return A.t("Delete task","删除任务")} if op=="accept"{return A.t("Accept task","接受任务")}
    if op=="transition"{return A.t("Change task status","更改任务状态")} return A.t("Add comment","添加评论")
}
A.task_unresolved=fn(){return H.task_phase=="loading" || H.task_phase=="saving" || H.task_phase=="submitting" || H.task_phase=="unknown" || H.task_phase=="saved"}
A.task_finish=fn(done){
    if H.busy{return}
    let pending=H.task_pending
    if pending==nil || (H.task_phase!="recorded" && H.task_phase!="failed"){return}
    H.busy=true H.page="operator_task_command" H.notice=A.t("Closing saved result…","正在关闭已保存的结果…") A.redraw()
    host.request("hagency.intent.acknowledge",{commandId:pending.commandId},fn(reply){
        H.busy=false
        if reply.is_ok{
            let remaining=[] for row in H.saved_commands{if row.commandId!=pending.commandId{remaining.push(row)}} H.saved_commands=remaining
            if H.task_pending!=nil && H.task_pending.commandId==pending.commandId{H.task_pending=nil H.task_phase="" H.task_draft=nil H.task_error=""}
            H.notice="" done()
        }else{
            H.page="operator_task_command" H.notice=A.t("Could not close this result. Try again.","未能关闭此结果，请重试。")
            if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}
        }
        A.redraw()
    })
}
A.task_begin=fn(op,status){
    if H.busy || H.command!=nil || A.task_unresolved() || !A.task_can(op){return}
    if H.task_pending!=nil && (H.task_phase=="recorded" || H.task_phase=="failed"){A.task_finish(fn(){A.task_begin(op,status)}) return}
    H.task_error="" H.task_pending=nil H.task_phase="editing" H.task_label_draft="" H.task_options_open=false H.task_result_details=false
    let input={title:"" description:"" priority:"p2" granularity:"task" assignee:"" parentId:"" labels:[]}
    let title=A.t("New task","新任务")
    if op!="create"{
        let d=H.task_detail if d==nil || d.task==nil || d.revision==nil{return}
        let t=d.task title=t.title input={id:t.id expectedRevision:d.revision}
        if op=="edit"{input={id:t.id expectedRevision:d.revision title:t.title description:t.description priority:t.priority granularity:t.granularity assignee:if t.assignee==nil{""}else{t.assignee} parentId:if t.parent_id==nil{""}else{t.parent_id} labels:t.labels.to_json().parse_json()}}
        if op=="transition"{let legal=false for next in d.next{if next==status{legal=true}} if !legal{return} input.status=status input.waitingReason="" input.waitingUntil=""}
        if op=="accept"{let legal=false for next in d.next{if next=="accepted"{legal=true}} if !legal{return}}
        if op=="comment"{input.text=""}
    }
    H.task_draft={operation:op title:title input:input} H.page="operator_task_edit" A.redraw()
    if op=="accept" || (op=="transition" && status!="blocked"){A.task_prepare()}
}
A.task_set=fn(key,value){if H.busy || H.task_draft==nil || H.task_phase!="editing"{return} if key=="title"{H.task_draft.input.title=value} if key=="description"{H.task_draft.input.description=value} if key=="priority"{H.task_draft.input.priority=value} if key=="granularity"{H.task_draft.input.granularity=value} if key=="assignee"{H.task_draft.input.assignee=value} if key=="parentId"{H.task_draft.input.parentId=value} if key=="text"{H.task_draft.input.text=value} if key=="waitingReason"{H.task_draft.input.waitingReason=value} if key=="waitingUntil"{H.task_draft.input.waitingUntil=value}}
A.task_add_label=fn(){if H.busy || H.task_draft==nil{return} let label=H.task_label_draft.trim() if label=="" || H.task_draft.input.labels.len()>=20{return} for old in H.task_draft.input.labels{if old==label{return}} H.task_draft.input.labels.push(label) H.task_label_draft="" A.redraw()}
A.task_remove_label=fn(label){if H.busy || H.task_draft==nil{return} let keep=[] for old in H.task_draft.input.labels{if old!=label{keep.push(old)}} H.task_draft.input.labels=keep A.redraw()}
A.task_cancel_edit=fn(){if H.busy{return} let create=H.task_draft==nil || H.task_draft.operation=="create" H.task_draft=nil H.task_phase="" if create{A.open_tasks(H.task_offset)}else{A.open_task(H.task_id,0)}}
A.task_reason=fn(code){
    if code=="management_task_revision_changed"{return A.t("This task changed before your saved edit was applied. Review its latest revision and make a new edit only if needed.","应用已保存的更改前，任务已发生变化。请查看最新版本，仅在仍有需要时另行编辑。")}
    if code=="task_history_not_migrated"{return A.task_unavailable()}
    if code=="management_not_found"{return A.t("This task no longer exists. The original request remains saved.","此任务已不存在，原请求仍然保留。")}
    if code=="invalid_management_arguments"{return A.t("The task fields or status transition could not be applied. Check the current task before making another edit.","任务字段或状态转换无法应用，请先核对当前任务再另行编辑。")}
    return A.error_text(code)
}
A.task_prepared=fn(data){H.task_pending=data H.task_phase=if data.result!=nil{"recorded"}else if data.error!=nil{"failed"}else{"saved"} H.task_error=if data.error==nil{""}else{data.error} H.page="operator_task_command"}
A.task_prepare=fn(){
    if H.busy || H.command!=nil || H.task_draft==nil || H.task_phase!="editing"{return}
    let d=H.task_draft if (d.operation=="create" || d.operation=="edit") && d.input.title.trim()==""{return}
    if d.operation=="comment" && d.input.text.trim()==""{return}
    if d.operation=="transition" && d.input.status=="blocked" && (d.input.waitingReason.trim()=="" || d.input.waitingUntil.trim()==""){return}
    H.busy=true H.task_phase="saving" H.notice=A.t("Saving…","正在保存…") A.redraw()
    host.request("hagency.tasks."+d.operation,d.input.to_json().parse_json(),fn(reply){
        H.busy=false H.notice=""
        if reply.is_ok{A.task_prepared(reply.data) if H.task_phase=="saved"{A.task_apply()}}else{H.task_phase="unknown" H.task_error=reply.error H.page="operator_task_command"}
        A.redraw()
    })
}
A.open_saved_task=fn(row){if H.busy{return} H.task_result_details=false H.page="operator_task_command" H.task_pending=nil H.task_error="" H.task_phase="loading" A.request("hagency.tasks.command.get",{commandId:row.commandId},fn(data){A.task_prepared(data)})}
A.task_apply=fn(){
    if H.task_phase!="saved" && H.task_phase!="unknown"{return}
    if H.busy || H.task_pending==nil || H.task_pending.result!=nil || H.task_pending.error!=nil{return}
    let pending=H.task_pending H.busy=true H.task_phase="submitting" H.task_error="" A.redraw()
    host.request("hagency.tasks.command.apply",{commandId:pending.commandId},fn(reply){
        H.busy=false
        if reply.is_ok{pending.result=reply.data H.task_phase="recorded" H.task_detail=nil}
        else{H.task_error=reply.error H.task_phase=if reply.error=="management_task_revision_changed" || reply.error=="invalid_management_arguments" || reply.error=="management_not_found"{"failed"}else{"unknown"}}
        A.redraw()
    })
}
A.task_current=fn(){if H.busy || H.task_pending==nil{return} let pending=H.task_pending A.task_finish(fn(){if pending.result!=nil && pending.result.deleted{A.open_tasks(H.task_offset)}else{A.open_task(pending.taskId,0)}})}
A.task_saved_refresh=fn(){if H.busy{return} if H.task_pending!=nil{A.open_saved_task(H.task_pending)}else{A.refresh()}}

A.is_graph_operation=fn(op){return op=="graph_create" || op=="graph_update_node" || op=="graph_cancel" || op=="graph_bind_recipient"}
A.flow_delivery=fn(state){if state=="suppressed"{return A.t("Dispatch suppressed","派发已抑制")} if state=="binding_saved"{return A.t("Recipient saved; delivery held","接收方已保存；投递暂缓")} return A.t("Awaiting recipient setup","等待设置接收方")}
A.flow_status=fn(state){
    if state=="active"{return A.t("Recorded active","记录为活动")}
    if state=="pending"{return A.t("Recorded pending","记录为待处理")}
    if state=="dispatched"{return A.t("Dispatch recorded; delivery held","已记录派发；投递暂缓")}
    if state=="complete"{return A.t("Recorded complete","记录为完成")}
    if state=="failed"{return A.t("Recorded failed","记录为失败")}
    if state=="skipped"{return A.t("Recorded skipped","记录为跳过")}
    if state=="cancelled"{return A.t("Recorded cancelled","记录为取消")}
    return state
}
A.flow_notice=fn(){return A.t("These graphs are saved on this device. Recipient bindings do not authorize delivery. A recorded status does not mean an agent received or ran the work.","任务图保存在此设备。接收方绑定不会授权投递，记录的状态不表示 Agent 已收到或执行工作。")}
A.flow_reason=fn(code){
    if code=="management_revision_conflict" || code=="management_graph_revision_changed" || code=="operator_graph_revision_changed"{return A.t("The graph changed. Keep this saved request and inspect the current graph before preparing another change.","任务图已变化。请保留此请求并查看当前任务图，再决定是否另行更改。")}
    if code=="invalid_management_arguments" || code=="graph_invalid"{return A.t("Check the node IDs, dependencies, status and JSON fields. The original request is retained if it was saved.","请检查节点 ID、依赖、状态和 JSON 字段。已保存的原请求仍然保留。")}
    if code=="graph_not_found" || code=="node_not_found" || code=="management_not_found"{return A.t("This graph or node is unavailable. Check the saved request without creating a replacement.","此任务图或节点暂不可用。请检查已保存的请求，不要重复创建。")}
    return A.error_text(code)
}
A.flow_read=fn(service,args,done){
    if H.busy{return} H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch let page=H.page
    H.busy=true H.notice=A.t("Reading task graphs…","正在读取任务图…") A.redraw()
    host.request(service,args,fn(reply){
        if H.flow_epoch!=epoch{return} H.busy=false
        if H.page!=page{A.redraw() return}
        if reply.is_ok{H.notice="" done(reply.data)}else{if H.page=="operator_graph_command"{H.flow_phase="unknown"} H.notice=if H.page=="operator_graph_recipient"{A.recipient_reason(reply.error)}else{A.flow_reason(reply.error)} if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}}
        A.redraw()
    })
}
A.flow_bad_reply=fn(){H.notice=A.t("The returned graph did not match this view. Refresh to read it again.","返回的任务图与当前页面不符，请刷新重读。")}
A.open_flows=fn(after){if H.busy{return} H.page="operator_graphs" H.flow_after=after H.flow_list=nil
    let filter=H.flow_filter let q={after:after} if filter!=""{q.status=filter}
    A.flow_read("hagency.graphs.list",q,fn(v){if H.flow_after!=after || H.flow_filter!=filter{return} if v==nil || v.graphs==nil || v.graphs.len()>16 || v.supported!=true{A.flow_bad_reply() return} H.flow_list=v})
}
A.open_flow=fn(id,after){if H.busy{return} H.page="operator_graph" H.flow_id=id H.flow_node_after=after H.flow_detail=nil
    A.flow_read("hagency.graphs.get",{id:id nodeAfter:after},fn(v){if H.flow_id!=id || H.flow_node_after!=after{return} if v==nil || v.graph==nil || v.graph.id!=id || v.nodes==nil || v.nodes.len()>16 || v.graph.runtimeDeliveryAuthorized!=false{A.flow_bad_reply() return} H.flow_detail=v})
}
A.open_flow_node=fn(id,node){if H.busy{return} H.page="operator_graph_node" H.flow_id=id H.flow_node_id=node H.flow_node=nil H.flow_dep_offset=0
    A.flow_read("hagency.graphs.node",{id:id nodeId:node},fn(v){if H.flow_id!=id || H.flow_node_id!=node{return} if v==nil || v.graphId!=id || v.id!=node || v.dependsOn==nil || v.dependsOn.len()>256 || !v.resultJson.is_string() || v.runtimeDeliveryAuthorized!=false{A.flow_bad_reply() return} H.flow_node=v})
}
A.flow_unresolved=fn(){return H.flow_phase=="saving" || H.flow_phase=="loading" || H.flow_phase=="saved" || H.flow_phase=="submitting" || H.flow_phase=="unknown"}
A.flow_can_edit=fn(){if H.busy || H.command!=nil || A.flow_unresolved() || H.flow_pending!=nil{return false} for row in H.saved_commands{let {hasReply=false}=row if A.is_graph_operation(row.operation) && !hasReply{return false}} return true}
A.flow_new=fn(){if !A.flow_can_edit(){return} H.flow_draft={label:"" nodes:[]} H.flow_update=nil H.flow_editor_offset=0 H.flow_error="" H.flow_phase="editing" H.page="operator_graph_edit" A.redraw()}
A.flow_edit=fn(index){if H.busy || H.flow_draft==nil || H.flow_phase!="editing"{return}
    if index<0 && H.flow_draft.nodes.len()>=256{return}
    H.flow_edit_index=index H.flow_choice_offset=0 H.flow_error=""
    H.flow_edit_node=if index<0{{id:"" assignee:"" description:"" dependsOn:[] conditionJson:""}}else{H.flow_draft.nodes[index].to_json().parse_json()}
    H.flow_edit_old_id=H.flow_edit_node.id H.page="operator_graph_edit_node" A.redraw()
}
A.flow_set_node=fn(key,text){if H.busy || H.flow_edit_node==nil || H.flow_phase!="editing"{return}
    if key=="id"{H.flow_edit_node.id=text} if key=="assignee"{H.flow_edit_node.assignee=text} if key=="description"{H.flow_edit_node.description=text} if key=="conditionJson"{H.flow_edit_node.conditionJson=text}
}
A.flow_has_dep=fn(node,id){for dep in node.dependsOn{if dep==id{return true}} return false}
A.flow_toggle_dep=fn(id){if H.busy || H.flow_edit_node==nil || id==H.flow_edit_node.id || id==H.flow_edit_old_id{return}
    let keep=[] let found=false for dep in H.flow_edit_node.dependsOn{if dep==id{found=true}else{keep.push(dep)}} if !found{keep.push(id)} H.flow_edit_node.dependsOn=keep A.redraw()
}
A.flow_save_node=fn(){if H.busy || H.flow_edit_node==nil || H.flow_draft==nil{return}
    let n=H.flow_edit_node
    if n.id.trim()=="" || n.id.to_chars().len()>255 || n.assignee.trim()=="" || n.assignee.to_chars().len()>255 || n.description.trim()=="" || n.description.to_chars().len()>4000 || n.conditionJson.len()>65536{H.flow_error=A.t("Enter a node ID, recipient name and description within the limits.","请填写长度符合限制的节点 ID、接收方名称与说明。") A.redraw() return}
    for index node in H.flow_draft.nodes{if index!=H.flow_edit_index && node.id==n.id{H.flow_error=A.t("Node IDs must be unique.","节点 ID 不可重复。") A.redraw() return}}
    if A.flow_has_dep(n,n.id){H.flow_error=A.t("A node cannot depend on itself.","节点不能依赖自身。") A.redraw() return}
    if H.flow_edit_index<0{H.flow_draft.nodes.push(n.to_json().parse_json())}else{
        let old=H.flow_edit_old_id H.flow_draft.nodes[H.flow_edit_index]=n.to_json().parse_json()
        if old!=n.id{for node in H.flow_draft.nodes{let deps=[] for dep in node.dependsOn{deps.push(if dep==old{n.id}else{dep})} node.dependsOn=deps}}
    }
    H.flow_edit_node=nil H.flow_error="" H.page="operator_graph_edit" A.redraw()
}
A.flow_remove_node=fn(index){if H.busy || H.flow_draft==nil || H.flow_phase!="editing"{return}
    let id=H.flow_draft.nodes[index].id let keep=[] for i node in H.flow_draft.nodes{if i!=index{let deps=[] for dep in node.dependsOn{if dep!=id{deps.push(dep)}} node.dependsOn=deps keep.push(node)}}
    H.flow_draft.nodes=keep if H.flow_editor_offset>=keep.len(){H.flow_editor_offset=max(0,H.flow_editor_offset-16)} A.redraw()
}
A.flow_prepared=fn(v){
    if v==nil || v.commandId==nil || v.graphId==nil || !A.is_graph_operation(v.operation) || v.change==nil || !v.changeJson.is_string() || v.runtimeDeliveryAuthorized!=false{H.flow_phase="unknown" H.flow_error=A.t("The saved request needs to be checked again.","需要重新检查已保存的请求。") return}
    if (v.operation=="graph_create" && v.change.operation!="create") || (v.operation=="graph_update_node" && v.change.operation!="update_node") || (v.operation=="graph_cancel" && v.change.operation!="cancel") || (v.operation=="graph_bind_recipient" && v.change.operation!="bind_recipient"){H.flow_phase="unknown" A.flow_bad_reply() return}
    if v.operation=="graph_bind_recipient" && (!v.change.nodeId.is_string() || v.change.snapshot==nil || v.change.snapshot.target==nil || !v.change.snapshot.identityJson.is_string() || !v.change.snapshot.account.is_string() || !v.change.snapshot.server.is_string() || v.change.snapshot.graphId!=v.graphId || v.change.snapshot.nodeId!=v.change.nodeId || v.change.snapshot.revision!=v.expectedRevision || v.change.snapshot.runtimeDeliveryAuthorized!=false){H.flow_phase="unknown" A.flow_bad_reply() return}
    if v.result!=nil && (v.result.commandId!=v.commandId || v.result.graphId!=v.graphId || v.result.runtimeDeliveryAuthorized!=false){H.flow_phase="unknown" A.flow_bad_reply() return}
    H.flow_pending=v H.flow_review_offset=0 H.flow_review_json=false H.flow_phase=if v.result!=nil{"recorded"}else if v.error!=nil{"failed"}else{"saved"} H.flow_error=if v.error==nil{""}else{v.error} H.page="operator_graph_command"
}
A.flow_prepare=fn(service,args){if H.busy || H.command!=nil || H.flow_phase!="editing" || H.flow_pending!=nil{return}
    H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch H.busy=true H.flow_phase="saving" H.flow_error="" H.page="operator_graph_command" A.redraw()
    host.request(service,args,fn(reply){
        if H.flow_epoch!=epoch{return} H.busy=false
        if H.page!="operator_graph_command"{A.redraw() return}
        if reply.is_ok{if service=="hagency.graphs.bind_recipient" && !A.recipient_prepared_matches(args,reply.data){H.flow_phase="unknown" H.flow_error="management_outcome_unknown" A.flow_bad_reply()}else{A.flow_prepared(reply.data)}}else{
            H.flow_error=reply.error
            if reply.error=="invalid_management_arguments" || reply.error=="management_not_found" || reply.error=="management_revision_conflict" || (service=="hagency.graphs.bind_recipient" && (reply.error=="management_recipient_changed" || reply.error=="management_recipient_unavailable")){H.flow_phase="editing" H.page=if service=="hagency.graphs.cancel"{"operator_graph"}else if service=="hagency.graphs.update_node"{"operator_graph_update"}else if service=="hagency.graphs.bind_recipient"{"operator_graph_recipient"}else{"operator_graph_edit"} if service=="hagency.graphs.cancel"{H.flow_phase="" H.notice=A.flow_reason(reply.error)} if service=="hagency.graphs.bind_recipient" && H.flow_recipient!=nil{H.flow_recipient.observation=nil if reply.error=="management_revision_conflict"{H.flow_recipient.stale=true}}}else{H.flow_phase="unknown"}
        }
        A.redraw()
    })
}
A.flow_prepare_create=fn(){if H.flow_draft==nil || H.flow_phase!="editing" || H.busy{return}
    let d=H.flow_draft if d.label.trim()=="" || d.label.to_chars().len()>4000 || d.nodes.len()==0 || d.nodes.len()>256{H.flow_error=A.t("Add a graph name and at least one node (maximum 256).","请填写任务图名称并添加节点（最多 256 个）。") A.redraw() return}
    let nodes={} for n in d.nodes{let item={assignee:n.assignee description:n.description dependsOn:n.dependsOn.to_json().parse_json()} if n.conditionJson.trim()!=""{item.conditionJson=n.conditionJson} nodes[n.id]=item}
    A.flow_prepare("hagency.graphs.create",{label:d.label nodes:nodes})
}
A.flow_begin_update=fn(){if !A.flow_can_edit() || H.flow_node==nil{return}
    H.flow_draft=nil let n=H.flow_node H.flow_update={id:H.flow_id expectedRevision:n.revision nodeId:n.id status:n.status changeStatus:false resultMode:"keep" resultJson:n.resultJson errorMode:"keep" error:if n.error==nil{""}else{n.error}}
    H.flow_error="" H.flow_phase="editing" H.page="operator_graph_update" A.redraw()
}
A.flow_prepare_update=fn(){if H.busy || H.flow_update==nil || H.flow_phase!="editing"{return}
    let u=H.flow_update let patch={nodeId:u.nodeId} if u.changeStatus{patch.status=u.status} if u.resultMode=="set"{if u.resultJson.trim()==""{H.flow_error=A.t("Enter valid JSON; use null to clear the result.","请填写有效 JSON；使用 null 清空结果。") A.redraw() return} patch.resultJson=u.resultJson} if u.errorMode=="set"{patch.error=if u.error==""{nil}else{u.error}}
    if !u.changeStatus && u.resultMode=="keep" && u.errorMode=="keep"{H.flow_error=A.t("Choose at least one change.","请至少选择一项更改。") A.redraw() return}
    A.flow_prepare("hagency.graphs.update_node",{id:u.id expectedRevision:u.expectedRevision patch:patch})
}
A.flow_prepare_cancel=fn(){if !A.flow_can_edit() || H.flow_detail==nil || H.flow_detail.graph.status=="cancelled"{return}
    H.flow_phase="editing" A.flow_prepare("hagency.graphs.cancel",{id:H.flow_detail.graph.id expectedRevision:H.flow_detail.graph.revision})
}
A.open_saved_graph=fn(row){if H.busy{return}
    H.flow_pending=nil H.flow_phase="loading" H.flow_error="" H.page="operator_graph_command"
    let id=row.commandId A.flow_read("hagency.graphs.command.get",{commandId:id},fn(v){if v==nil || v.commandId!=id{H.flow_phase="unknown" A.flow_bad_reply() return} A.flow_prepared(v)})
}
A.flow_apply=fn(){if H.busy || H.flow_pending==nil || (H.flow_phase!="saved" && H.flow_phase!="unknown"){return}
    let p=H.flow_pending if p.result!=nil || p.error!=nil{return}
    H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch H.busy=true H.flow_phase="submitting" H.flow_error="" A.redraw()
    host.request("hagency.graphs.command.apply",{commandId:p.commandId},fn(reply){
        if H.flow_epoch!=epoch{return} H.busy=false
        if H.page!="operator_graph_command" || H.flow_pending==nil || H.flow_pending.commandId!=p.commandId{A.redraw() return}
        if reply.is_ok && reply.data.commandId==p.commandId && reply.data.graphId==p.graphId && reply.data.runtimeDeliveryAuthorized==false{p.result=reply.data H.flow_phase="recorded"}
        else{H.flow_phase="unknown" H.flow_error=if reply.is_ok{"management_outcome_unknown"}else{reply.error}}
        A.redraw()
    })
}
A.flow_check_saved=fn(){if H.busy{return} if H.flow_pending!=nil{A.open_saved_graph(H.flow_pending)}else{A.refresh()}}
A.flow_close_result=fn(){if H.busy || H.flow_pending==nil || (H.flow_phase!="recorded" && H.flow_phase!="failed"){return}
    let p=H.flow_pending H.busy=true H.flow_epoch=H.flow_epoch+1 let epoch=H.flow_epoch A.redraw()
    host.request("hagency.intent.acknowledge",{commandId:p.commandId},fn(reply){
        if epoch!=H.flow_epoch{return} H.busy=false
        if H.flow_pending==nil || H.flow_pending.commandId!=p.commandId{A.redraw() return}
        if reply.is_ok{let remaining=[] for row in H.saved_commands{if row.commandId!=p.commandId{remaining.push(row)}} H.saved_commands=remaining H.flow_pending=nil H.flow_phase="" H.flow_draft=nil H.flow_update=nil H.flow_error="" A.open_flow(p.graphId,nil)}else{H.flow_error=reply.error A.redraw()}
    })
}
A.flow_review_nodes=fn(){let nodes=[] if H.flow_pending!=nil && H.flow_pending.change.operation=="create"{for index id node in H.flow_pending.change.nodes{nodes.push({id:id.to_string() data:node})}} return nodes}

A.is_template_operation=fn(op){return op=="template_create" || op=="template_update" || op=="template_delete"}
A.template_notice=fn(){return A.t("Templates name an agent and its role for future allocation. Saving a template does not create or change a running agent.","模板为未来分配的 Agent 指定名称和角色。保存模板不会创建或修改运行中的 Agent。")}
A.template_status=fn(status){if status=="provisioned"{return A.t("Agent provisioned","已创建 Agent 实例")} if status=="reserved"{return A.t("Reserved for allocation","已为分配预留")} return A.t("Defined · awaiting allocation","已定义 · 等待分配")}
A.template_enabled=fn(enabled){return if enabled{A.t("Available for future allocation","可供未来分配")}else{A.t("Future allocation disabled","已禁用未来分配")}}
A.template_reason=fn(code){
    if code=="invalid_management_arguments"{return A.t("Use a lowercase agent name (letters, numbers, _ or -, maximum 64) and select a role this resource supports.","Agent 名称须以小写字母开头，只含小写字母、数字、_ 或 -，最多 64 个字符；请选择此资源支持的角色。")}
    if code=="management_revision_conflict"{return A.t("The resource or its templates changed, or this agent name is already used. Read the current list before preparing another change.","资源或模板已变化，或 Agent 名称已被使用。请读取当前列表后再准备更改。")}
    if code=="management_resource_in_use"{return A.t("This name is reserved or already in use. Existing agents keep their identity; disable future allocation instead of removing or renaming an in-use template.","此名称已预留或正在使用。现有 Agent 保持其身份；已使用的模板可以禁用未来分配，不能移除或重命名。")}
    if code=="management_model_unqualified"{return A.t("This resource cannot supply that role. Check its model and capacity or choose an available role.","此资源无法提供该角色，请检查模型与容量，或选择可用角色。")}
    if code=="management_not_found"{return A.t("This resource or template is no longer available. Check the original saved request before making another change.","此资源或模板已不可用，请先检查已保存的原请求，再决定是否更改。")}
    return A.error_text(code)
}
A.template_read=fn(service,args,done){if H.busy{return} let t=H.templates t.epoch=t.epoch+1 let epoch=t.epoch let page=H.page H.busy=true H.notice="" A.redraw()
    host.request(service,args,fn(reply){if t.epoch!=epoch{return} H.busy=false if H.page!=page{A.redraw() return} if reply.is_ok{done(reply.data)}else{t.error=A.template_reason(reply.error) if page=="template_command"{t.phase="unknown"} if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}} A.redraw()})
}
A.template_bad=fn(){H.templates.error=A.t("The template response did not match this view. Refresh the current record.","模板响应与此页面不符，请刷新当前记录。")}
A.open_templates=fn(resource,after){if H.busy{return} let t=H.templates t.resourceId=resource t.after=after t.list=nil t.error="" H.page="templates"
    A.template_read("hagency.templates.list",{resourceId:resource after:after},fn(v){if t.resourceId!=resource || t.after!=after{return} if v==nil || v.resourceId!=resource || !v.revision.is_string() || v.items==nil || v.items.len()>16 || v.roles==nil || v.roles.len()>16{A.template_bad() return} t.list=v})
}
A.open_template=fn(resource,id){if H.busy{return} let t=H.templates t.resourceId=resource t.id=id t.detail=nil t.error="" H.page="template"
    A.template_read("hagency.templates.get",{resourceId:resource id:id},fn(v){if t.resourceId!=resource || t.id!=id{return} if v==nil || v.resourceId!=resource || !v.revision.is_string() || v.definition==nil || v.definition.id!=id || v.roles==nil || v.roles.len()>16{A.template_bad() return} t.detail=v})
}
A.template_can_edit=fn(){let t=H.templates if H.busy || H.command!=nil || t.pending!=nil || t.phase=="saving" || t.phase=="saved" || t.phase=="loading" || t.phase=="submitting" || t.phase=="unknown"{return false} for row in H.saved_commands{let {hasReply=false}=row if A.is_template_operation(row.operation) && !hasReply{return false}} return true}
A.template_begin=fn(create){if !A.template_can_edit(){return} let t=H.templates let source=if create{t.list}else{t.detail} if source==nil || (create && !source.canCreate) || (!create && !source.canEditIdentity && !source.canToggle){return}
    let d={operation:if create{"create"}else{"update"} resourceId:t.resourceId expectedRevision:source.revision name:"" role:"" enabled:true canEditIdentity:true canToggle:true roles:source.roles.to_json().parse_json()}
    if !create{d.id=source.definition.id d.name=source.definition.name d.role=source.definition.role d.enabled=source.definition.enabled d.canEditIdentity=source.canEditIdentity d.canToggle=source.canToggle}
    t.draft=d t.phase="editing" t.error="" H.page="template_edit" A.redraw()
}
A.template_role=fn(role){let t=H.templates if H.busy || t.draft==nil || !t.draft.canEditIdentity{return} for allowed in t.draft.roles{if allowed==role{t.draft.role=role A.redraw() return}}}
A.template_prepared=fn(v){let t=H.templates
    if v==nil || !v.commandId.is_string() || !v.resourceId.is_string() || !v.definitionId.is_string() || !A.is_template_operation(v.operation) || v.change==nil || !v.expectedRevision.is_string() || (v.operation=="template_create" && v.change.operation!="create") || (v.operation=="template_update" && v.change.operation!="update") || (v.operation=="template_delete" && v.change.operation!="delete"){t.phase="unknown" A.template_bad() return}
    if v.result!=nil && (v.result.commandId!=v.commandId || v.result.resourceId!=v.resourceId || v.result.definitionId!=v.definitionId){t.phase="unknown" A.template_bad() return}
    t.pending=v t.commandId=v.commandId t.phase=if v.result!=nil{"recorded"}else if v.error!=nil{"failed"}else{"saved"} t.error=if v.error==nil{""}else{A.template_reason(v.error)} H.page="template_command"
}
A.template_prepare=fn(op,args){let t=H.templates if H.busy || H.command!=nil || t.pending!=nil || t.phase!="editing"{return}
    t.epoch=t.epoch+1 let epoch=t.epoch H.busy=true t.phase="saving" t.error="" H.page="template_command" A.redraw()
    host.request("hagency.templates."+op,args,fn(reply){if t.epoch!=epoch{return} H.busy=false if H.page!="template_command"{A.redraw() return}
        if reply.is_ok{if reply.data.resourceId!=args.resourceId || reply.data.expectedRevision!=args.expectedRevision || reply.data.change.operation!=op || (op!="create" && reply.data.definitionId!=args.id){t.phase="unknown" A.template_bad()}else{A.template_prepared(reply.data)}}else{
            t.error=A.template_reason(reply.error)
            if reply.error=="invalid_management_arguments" || reply.error=="management_not_found" || reply.error=="management_revision_conflict" || reply.error=="management_resource_in_use" || reply.error=="management_model_unqualified"{t.phase=if op=="delete"{""}else{"editing"} H.page=if op=="delete"{"template"}else{"template_edit"}}else{t.phase="unknown"}
        } A.redraw()
    })
}
A.template_save_draft=fn(){let t=H.templates if H.busy || t.draft==nil || t.phase!="editing"{return} let d=t.draft let name=d.name.trim()
    if name=="" || name.to_chars().len()>64 || d.role==""{t.error=A.template_reason("invalid_management_arguments") A.redraw() return}
    let allowed=false for role in d.roles{if role==d.role{allowed=true}}
    let disable_existing=d.operation=="update" && !d.enabled && t.detail!=nil && t.detail.definition.id==d.id && t.detail.definition.name==name && t.detail.definition.role==d.role
    if !allowed && !disable_existing{t.error=A.template_reason("management_model_unqualified") A.redraw() return}
    let args={resourceId:d.resourceId expectedRevision:d.expectedRevision name:name role:d.role enabled:d.enabled} if d.operation=="update"{args.id=d.id}
    A.template_prepare(d.operation,args)
}
A.template_delete=fn(){let t=H.templates if !A.template_can_edit() || t.detail==nil || !t.detail.canDelete{return} t.phase="editing" A.template_prepare("delete",{resourceId:t.resourceId id:t.detail.definition.id expectedRevision:t.detail.revision})}
A.open_saved_template=fn(row){if H.busy{return} let t=H.templates t.pending=nil t.phase="loading" t.error="" H.page="template_command" let id=row.commandId t.commandId=id
    A.template_read("hagency.templates.command.get",{commandId:id},fn(v){if v==nil || v.commandId!=id{t.phase="unknown" A.template_bad() return} A.template_prepared(v)})
}
A.template_apply=fn(){let t=H.templates if H.busy || t.pending==nil || t.phase!="saved"{return} let p=t.pending if p.result!=nil || p.error!=nil{return}
    t.epoch=t.epoch+1 let epoch=t.epoch H.busy=true t.phase="submitting" t.error="" A.redraw()
    host.request("hagency.templates.command.apply",{commandId:p.commandId},fn(reply){if t.epoch!=epoch{return} H.busy=false if H.page!="template_command" || t.pending==nil || t.pending.commandId!=p.commandId{A.redraw() return}
        if reply.is_ok && reply.data.commandId==p.commandId && reply.data.resourceId==p.resourceId && reply.data.definitionId==p.definitionId{p.result=reply.data t.phase="recorded"}else{t.phase="unknown" t.error=A.template_reason(if reply.is_ok{"management_outcome_unknown"}else{reply.error})} A.redraw()
    })
}
A.template_check=fn(){if H.busy{return} let t=H.templates let saved_id=A.recipient_optional(H.templates,"commandId") if t.pending!=nil{A.open_saved_template(t.pending)}else if saved_id!=nil && saved_id!=""{A.open_saved_template({commandId:saved_id})}else{A.refresh()}}
A.template_finish=fn(){let t=H.templates if H.busy || t.pending==nil || (t.phase!="recorded" && t.phase!="failed"){return} let p=t.pending t.epoch=t.epoch+1 let epoch=t.epoch H.busy=true A.redraw()
    host.request("hagency.intent.acknowledge",{commandId:p.commandId},fn(reply){if t.epoch!=epoch{return} H.busy=false if t.pending==nil || t.pending.commandId!=p.commandId{A.redraw() return} if reply.is_ok{let keep=[] for row in H.saved_commands{if row.commandId!=p.commandId{keep.push(row)}} H.saved_commands=keep t.pending=nil t.commandId="" t.phase="" t.draft=nil A.open_templates(p.resourceId,nil)}else{t.error=A.template_reason(reply.error) A.redraw()}})
}

A.web_title=fn(kind){
    if kind=="workforce"{return A.t("Workforce","Agent 团队")}
    if kind=="capability"{return A.t("Capabilities and offers","能力与服务报价")}
    if kind=="usage"{return A.t("Usage","用量")}
    if kind=="accounts"{return A.t("Shared account capacity","共享账号容量")}
    if kind=="alerts"{return A.t("Fleet alerts","全部告警")}
    return A.t("Terminal capture","终端快照")
}
A.web_error=fn(code){
    if code=="management_change_cancelled"{return A.t("Change cancelled. No resource settings were changed.","更改已取消，资源设置未发生变化。")}
    if code=="management_revision_conflict"{return A.t("This record changed. Refresh and review the latest values.","记录已更改，请刷新并核对最新值。")}
    if code=="management_resource_in_use"{return A.t("This configuration is still in use. Release its allocations before removing it.","此配置仍在使用中，请先释放其分配再移除。")}
    if code=="invalid_management_arguments"{return A.t("Check the fields. Token amounts must be whole numbers within the supported range.","请检查输入，token 数量必须为支持范围内的整数。")}
    if code=="management_model_unqualified"{return A.t("This model does not qualify for the selected role.","此模型不满足所选角色的要求。")}
    return A.error_text(code)
}
A.web_read=fn(service,args,done){if H.busy{return} let w=H.web w.epoch=w.epoch+1 let epoch=w.epoch let page=H.page H.busy=true H.notice="" A.redraw()
    host.request(service,args,fn(r){if w.epoch!=epoch{return} H.busy=false if H.page!=page{A.redraw() return} if r.is_ok{done(r.data)}else{H.notice=A.web_error(r.error) if r.error=="native_resume_missing" || r.error=="native_resume_revoked"{H.needs_signin=true}} A.redraw()})
}
A.open_web=fn(kind,after){if H.busy{return} let w=H.web if H.page!="web_overview" || w.kind!=kind || w.after!=after{w.data=nil} w.kind=kind w.after=after H.page="web_overview"
    let q={after:after}
    if kind=="alerts"{q.status=if w.status==""{nil}else{w.status} q.severity=if w.severity==""{nil}else{w.severity} q.agent=if w.agent.trim()==""{nil}else{w.agent.trim()}}
    w.readKind=kind w.readQuery=q.to_json().parse_json()
    A.web_read("hagency.web."+kind,q,fn(v){if w.kind!=kind || w.after!=after{return} w.data=v})
}
A.open_web_account=fn(id,after){if H.busy{return} let w=H.web w.kind="accounts" w.data=nil w.after=nil H.page="web_overview"
    w.readKind="accounts" w.readQuery={id:id resourceAfter:after}
    A.web_read("hagency.web.accounts",w.readQuery,fn(v){w.data=v})
}
A.open_web_terminal=fn(id){if H.busy{return} H.web.kind="terminal" H.web.data=nil H.web.terminalId=id H.page="web_overview"
    H.web.readKind="terminal" H.web.readQuery={id:id}
    A.web_read("hagency.web.terminal",H.web.readQuery,fn(v){if v.id==id{H.web.data=v}})
}
A.web_int=fn(text,blank){let s=text.trim() if s==""{return blank} let n=s.to_f64() if !(n>=0 && n<=9007199254740991) || floor(n)!=n{return -1} return n}
A.web_can_edit=fn(){let w=H.web if H.busy || H.command!=nil || w.pending!=nil || w.phase=="saving" || w.phase=="unknown" || w.phase=="submitting"{return false} for row in H.saved_commands{let {hasReply=false}=row if row.operation=="web_catalog" && !hasReply{return false}} return true}
A.open_web_catalog=fn(resource,section,after){if H.busy{return} let w=H.web w.resourceId=resource w.section=section w.after=after w.catalog=nil w.draft=nil H.page="web_catalog"
    let service=if section=="offers"{"hagency.web_catalog.offers"}else if section=="trust"{"hagency.web_catalog.trust"}else{"hagency.web_catalog.get"}
    A.web_read(service,{resourceId:resource after:after},fn(v){if v.resourceId!=resource || !v.revision.is_string(){H.notice=A.web_error("management_outcome_unknown") return} w.catalog=v if section=="settings"{w.rate=if v.rateCapPerDay==nil{""}else{""+v.rateCapPerDay}}})
}
A.web_change_label=fn(c){
    if c.operation=="rate_cap"{return A.t("Daily token rate","每日 token 速率")+" · "+if c.rateCapPerDay==nil{A.t("Not declared","未声明")}else{A.amount(c.rateCapPerDay)}}
    if c.operation=="retire"{return A.t("Remove this unused configuration","移除此未使用的配置")}
    if c.operation=="default_policy"{return A.t("Default permissions for future agents","未来 Agent 的默认权限")+" · "+A.policy_label(c.yolo)}
    if c.operation=="assign_preset"{return A.t("Assign this preset","分配此预设")+" · "+c.engagementId}
    if c.operation=="trust_add"{return A.t("Trust project","信任项目")+" · "+c.projectRoomId}
    if c.operation=="trust_remove"{return A.t("Remove project trust","移除项目信任")+" · "+c.projectRoomId}
    return A.capability_label(c.role)+" · "+if c.published{A.t("Publish offer","发布服务报价")}else{A.t("Withdraw offer","撤回服务报价")}
}
A.web_same_change=fn(a,b){
    if a.operation!=b.operation{return false}
    for key in ["rateCapPerDay","yolo","engagementId","role","count","budgetCapPerEngagement","rateCap","published","projectRoomId","displayName"]{if A.recipient_optional(a,key)!=A.recipient_optional(b,key){return false}} return true
}
A.web_prepared=fn(v){let w=H.web
    if v==nil || !v.commandId.is_string() || !v.resourceId.is_string() || !v.expectedRevision.is_string() || v.change==nil{w.phase="unknown" H.notice=A.web_error("management_outcome_unknown") return}
    if v.result!=nil && (v.result.commandId!=v.commandId || v.result.resourceId!=v.resourceId || v.result.operation!=v.change.operation){w.phase="unknown" H.notice=A.web_error("management_outcome_unknown") return}
    w.pending=v w.commandId=v.commandId w.resourceId=v.resourceId w.phase=if v.result!=nil{"recorded"}else if v.error!=nil{"failed"}else{"saved"} H.page="web_catalog_command"
    if v.error!=nil{H.notice=A.web_error(v.error)}
}
A.web_prepare=fn(change){if !A.web_can_edit() || H.web.catalog==nil{return} let w=H.web let args={resourceId:w.resourceId expectedRevision:w.catalog.revision change:change.to_json().parse_json()}
    H.busy=true w.phase="saving" H.page="web_catalog_command" A.redraw()
    host.request("hagency.web_catalog.prepare",args,fn(r){H.busy=false
        if r.is_ok && r.data.resourceId==args.resourceId && r.data.expectedRevision==args.expectedRevision && A.web_same_change(r.data.change,args.change){A.web_prepared(r.data)}else{w.phase="unknown" H.notice=A.web_error(if r.is_ok{"management_outcome_unknown"}else{r.error})
            if !r.is_ok && (r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="management_resource_in_use" || r.error=="management_model_unqualified"){w.phase="" H.page="web_catalog"}
        } A.redraw()
    })
}
A.open_saved_web=fn(row){if H.busy{return} let w=H.web w.pending=nil w.commandId=row.commandId w.phase="unknown" H.page="web_catalog_command"
    A.web_read("hagency.web_catalog.command.get",{commandId:row.commandId},fn(v){if v==nil || v.commandId!=row.commandId{H.notice=A.web_error("management_outcome_unknown") return} A.web_prepared(v)})
}
A.web_apply=fn(){let w=H.web if H.busy || w.pending==nil || w.phase!="saved"{return} let p=w.pending H.busy=true w.phase="submitting" A.redraw()
    host.request("hagency.web_catalog.command.apply",{commandId:p.commandId},fn(r){H.busy=false
        if r.is_ok && r.data.commandId==p.commandId && r.data.resourceId==p.resourceId && r.data.operation==p.change.operation{p.result=r.data w.phase="recorded"}else{w.phase="unknown" H.notice=A.web_error(if r.is_ok{"management_outcome_unknown"}else{r.error})} A.redraw()
    })
}
A.web_cancel=fn(){let w=H.web if H.busy || w.pending==nil || w.phase!="saved"{return} let p=w.pending w.phase="unknown"
    A.web_read("hagency.web_catalog.command.cancel",{commandId:p.commandId},fn(v){if v==nil || v.commandId!=p.commandId || v.resourceId!=p.resourceId || v.expectedRevision!=p.expectedRevision || !A.web_same_change(v.change,p.change){w.phase="unknown" H.notice=A.web_error("management_outcome_unknown") return} A.web_prepared(v)})
}
A.web_finish=fn(){let w=H.web if H.busy || w.pending==nil || (w.phase!="recorded" && w.phase!="failed"){return} let p=w.pending
    A.web_read("hagency.intent.acknowledge",{commandId:p.commandId},fn(v){let remaining=[] for row in H.saved_commands{if row.commandId!=p.commandId{remaining.push(row)}} H.saved_commands=remaining w.pending=nil w.commandId="" w.phase="" w.draft=nil
        if p.result!=nil && p.result.retired{A.navigate("resources")}else{A.open_web_catalog(p.resourceId,w.section,nil)}
    })
}
A.web_rate=fn(){let n=A.web_int(H.web.rate,nil) if n!=nil && n<1{H.notice=A.web_error("invalid_management_arguments") A.redraw() return} A.web_prepare({operation:"rate_cap" rateCapPerDay:n})}
A.web_offer_edit=fn(row){if !A.web_can_edit(){return} H.web.draft={role:row.role count:if row.count==nil{""}else{""+row.count} budget:if row.budgetCapPerEngagement==nil{""}else{""+row.budgetCapPerEngagement} rate:if row.rateCap==nil{""}else{""+row.rateCap} published:row.published || row.catalogPublished qualified:row.qualified} A.redraw()}
A.web_offer_save=fn(){let d=H.web.draft if d==nil{return} let count=A.web_int(d.count,nil) let budget=A.web_int(d.budget,nil) let rate=A.web_int(d.rate,nil)
    if (count!=nil && count<1) || (budget!=nil && budget<1) || (rate!=nil && rate<1){H.notice=A.web_error("invalid_management_arguments") A.redraw() return}
    A.web_prepare({operation:"offer" role:d.role count:count budgetCapPerEngagement:budget rateCap:rate published:d.published})
}
A.web_trust_add=fn(){let w=H.web if w.trustRoom.trim()==""{return} A.web_prepare({operation:"trust_add" projectRoomId:w.trustRoom.trim() displayName:if w.trustName.trim()==""{nil}else{w.trustName.trim()}})}
A.web_publication=fn(){if H.resource_detail==nil || H.command!=nil || H.busy{return} let row=H.resource_detail.resource
    A.submit("hagency.resources.publish",{resourceId:row.id expectedRevision:row.revision published:!row.published})
}
// Automatic observations use a closed read-only page plan. They never call
// generic navigation/recovery, reset form fields, or acknowledge a saved command.
A.web_refresh_plan=fn(){let w=H.web let c=H.webConnection
    if H.command!=nil || w.pending!=nil || w.phase=="saving" || w.phase=="saved" || w.phase=="submitting" || w.phase=="unknown" || H.confirm!=""{return nil}
    if H.page=="web_overview"{
        if w.readKind!=w.kind || w.readQuery==nil{return nil}
        if w.kind=="alerts"{
            let q=w.readQuery
            if A.recipient_optional(q,"status")!=(if w.status==""{nil}else{w.status}) || A.recipient_optional(q,"severity")!=(if w.severity==""{nil}else{w.severity}) || A.recipient_optional(q,"agent")!=(if w.agent.trim()==""{nil}else{w.agent.trim()}){return nil}
        }
        for kind in ["workforce","capability","usage","accounts","alerts","terminal"]{if w.kind==kind{return {service:"hagency.web."+kind args:w.readQuery done:fn(v){if kind!="terminal" || A.recipient_optional(v,"id")==w.readQuery.id{w.data=v}}}}}
        return nil
    }
    if H.page=="web_connections"{return {service:"hagency.web_connections.list" args:{after:c.after} done:fn(v){c.list=v}}}
    if H.page=="web_connection" && c.detail!=nil && c.draft==nil{
        let saved=if c.detail.allocatedTokens==nil{""}else{""+c.detail.allocatedTokens}
        if c.tokens!=saved{return nil}
        return {service:"hagency.web_connections.get" args:{id:c.id} done:fn(v){if v.id==c.id{c.detail=v c.tokens=if v.allocatedTokens==nil{""}else{""+v.allocatedTokens}}}}
    }
    if H.page=="web_catalog" && w.catalog!=nil && w.draft==nil{
        if w.section=="settings" && w.rate!=(if w.catalog.rateCapPerDay==nil{""}else{""+w.catalog.rateCapPerDay}){return nil}
        if w.section=="trust" && (w.trustRoom!="" || w.trustName!=""){return nil}
        let service=if w.section=="offers"{"hagency.web_catalog.offers"}else if w.section=="trust"{"hagency.web_catalog.trust"}else{"hagency.web_catalog.get"}
        return {service:service args:{resourceId:w.resourceId after:w.after} done:fn(v){if v.resourceId==w.resourceId{w.catalog=v if w.section=="settings"{w.rate=if v.rateCapPerDay==nil{""}else{""+v.rateCapPerDay}}}}}
    }
    if H.page=="overview"{return nil}
    if H.page=="pool_agent" && H.pool_detail!=nil && H.pool_confirm==""{return {service:"hagency.pools.agents.get" args:{id:H.pool_detail.id} done:fn(v){if H.pool_detail!=nil && v.request.id==H.pool_detail.id{H.pool_detail=v.request}}}}
    if H.page=="connections" && H.connections.len()<=16{return {service:"hagency.connections.list" args:{} done:A.connections_received}}
    if H.page=="resources" && H.resources.len()<=16{let q={after:if H.ux.resourceCursor==nil{""}else{H.ux.resourceCursor} limit:16} if H.capability!=""{q.capability=H.capability} return {service:"hagency.resources.list" args:q done:fn(v){H.resources=v.resources H.resource_after=v.nextAfter}}}
    if H.page=="resource_detail" && H.resource_name_mode=="" && H.resource_edit_draft==nil && H.resource_create_draft==nil{return {service:"hagency.resources.get" args:{id:H.resource_id} done:fn(v){if v.protocol=="hagency-management-v1" && v.resource.id==H.resource_id{H.resource_detail=v}}}}
    if H.page=="projects" && H.projects.len()<=16{return {service:"hagency.projects.list" args:{after:H.ux.projectCursor} done:fn(v){H.projects=v.items H.project_after=v.nextAfter}}}
    if H.page=="project_action" && H.project_selected!=nil{return {service:"hagency.projects.get" args:{id:H.project_selected.id} done:fn(v){if v.project.id==H.project_selected.id{H.project_selected=v.project H.ux.projectProgress=nil if v.project.state=="approved" && A.setup_enabled(){A.refresh_project_progress(v.project.id)}}}}}
    if H.page=="agent_action" && H.agent_confirmation==""{return {service:"hagency.agents.get" args:{id:H.agent_id} done:fn(v){if v.agentRequest.id==H.agent_id{H.agent_selected=v.agentRequest}}}}
    if H.page=="agent_status"{return {service:"hagency.agents.status" args:{id:H.agent_id} done:fn(v){if v.protocol=="hagency-management-v1" && v.agentRequest.id==H.agent_id{H.agent_status=v H.agent_selected=v.agentRequest H.agent_project_id=v.agentRequest.projectId}}}}
    if H.page=="agents" && H.agents.len()<=16{return {service:"hagency.agents.list" args:{after:nil needsMyAction:false projectId:H.agent_project_id} done:fn(v){H.agents=v.items H.agent_after=v.nextAfter}}}
    if H.page=="inbox" && H.inbox.len()<=16{return {service:"hagency.inbox.list" args:{after:H.ux.inboxCursor needsMyAction:H.needs_action includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()} done:fn(v){H.inbox=v.items H.inbox_after=v.nextAfter if A.agents_enabled(){A.load_agents(H.ux.agentCursor)}}}}
    if H.page=="action" && H.selected!=nil{return {service:"hagency.connections.get" args:{id:H.selected.contribution.id} done:fn(v){if v.admission.contribution.id==H.selected.contribution.id{H.selected=v.admission A.observe_verification(v.admission.contribution,v.observedAtMs)}}}}
    if H.page=="resource_alerts" && H.alert_draft==nil{return {service:"hagency.alerts.list" args:{resourceId:H.alert_resource after:H.alert_after status:H.alert_status} done:fn(v){if v.resourceId==H.alert_resource{H.alert_page=v}}}}
    if H.page=="resource_alert" && H.alert_draft==nil{return {service:"hagency.alerts.get" args:{resourceId:H.alert_resource id:H.alert_id afterNote:H.alert_note_after} done:fn(v){if v.alert.resourceId==H.alert_resource && v.alert.id==H.alert_id{H.alert_detail=v}}}}
    if H.page=="provider_accounts"{return {service:"hagency.accounts.list" args:{} done:fn(v){if v.protocol=="hagency-management-v1" && v.account==nil{if v.nextAfter==nil{H.account_inventory=v}else{A.open_accounts(nil)}}}}}
    if H.page=="provider_account"{let q={id:H.account_id} if H.account_resource_after!=nil{q.after=H.account_resource_after} return {service:"hagency.accounts.get" args:q done:fn(v){if v.protocol=="hagency-management-v1" && v.account.id==H.account_id{H.account_detail=v}}}}
    return nil
}
A.web_refresh_now=fn(){let r=H.webRefresh
    if !H.ready || H.needs_signin || !r.visible || H.busy || r.inFlight{return}
    let plan=A.web_refresh_plan() if plan==nil{return}
    let signature={page:H.page service:plan.service args:plan.args}.to_json()
    r.epoch=r.epoch+1 let epoch=r.epoch r.inFlight=true H.busy=true
    host.request(plan.service,plan.args,fn(reply){
        r.inFlight=false H.busy=false
        let current=A.web_refresh_plan()
        if r.epoch!=epoch || !r.visible || current==nil || signature!={page:H.page service:current.service args:current.args}.to_json(){return}
        if reply.is_ok{H.ux.errorCode="" plan.done(reply.data)}else{
            H.ux.errorCode=reply.error
            if H.page=="overview"{H.ux.dashboardError=true}
            if H.page=="inbox"{H.ux.inboxReady=false H.ux.inboxError=true}
            if H.notice==""{H.notice=A.web_error(reply.error)}
            if reply.error=="native_resume_missing" || reply.error=="native_resume_revoked"{H.needs_signin=true}
        }
        A.redraw()
    })
}
A.web_visibility=fn(visible){let r=H.webRefresh
    if r.visible!=visible{r.epoch=r.epoch+1 r.visible=visible}
    if visible{A.web_refresh_now()}
}
let on_app_visibility_changed=fn(state){A.web_visibility(state=="visible")}
A.web_auto_refresh=fn(){A.web_refresh_now() start_timeout(15,||A.web_auto_refresh())}

A.web_connection_service=fn(service){return service=="hagency.web_connections.create" || service=="hagency.web_connections.allowance" || service=="hagency.web_connections.withdraw" || service=="hagency.web_connections.issue" || service=="hagency.web_connections.import" || service=="hagency.web_connections.replace" || service=="hagency.web_connections.verify"}
A.web_connections_open=fn(after){if H.busy{return} let c=H.webConnection c.after=after c.list=nil H.page="web_connections"
    A.web_read("hagency.web_connections.list",{after:after},fn(v){c.list=v})
}
A.web_connection_open=fn(id){if H.busy{return} let c=H.webConnection c.id=id c.detail=nil c.draft=nil H.page="web_connection"
    A.web_read("hagency.web_connections.get",{id:id},fn(v){if v.id!=id{H.notice=A.web_error("management_outcome_unknown") return} c.detail=v c.tokens=if v.allocatedTokens==nil{""}else{""+v.allocatedTokens}})
}
A.web_connection_new=fn(){if H.busy || H.command!=nil{return} H.webConnection.draft={id:"" label:"" origin:""} H.webConnection.probe=nil H.page="web_connection_new" A.redraw()}
A.web_connection_probe=fn(){let c=H.webConnection if H.busy || c.draft==nil{return} let d=c.draft let name=d.id.trim() let origin=d.origin.trim()
    A.web_read("hagency.web_connections.probe",{serverName:if name==""{nil}else{name} url:if origin==""{nil}else{origin}},fn(v){c.probe=v if v.reachable && d.origin.trim()==""{d.origin=v.origin}})
}
A.web_connection_create=fn(import){let d=H.webConnection.draft if d==nil || d.id.trim()=="" || d.origin.trim()=="" || d.label.trim()==""{H.notice=A.web_error("invalid_management_arguments") A.redraw() return}
    if import{A.submit("hagency.web_connections.import",{id:d.id.trim() label:d.label.trim() homeserver:d.origin.trim() expectedRevision:0})}else{A.submit("hagency.web_connections.create",{id:d.id.trim() label:d.label.trim() apiBaseUrl:d.origin.trim()})}
}
A.web_connection_edit=fn(operation){let c=H.webConnection let d=c.detail if H.busy || H.command!=nil || d==nil{return}
    let args={id:d.id expectedRevision:d.revision}
    if operation=="allowance"{let n=A.web_int(c.tokens,nil) if n!=nil && n<0{H.notice=A.web_error("invalid_management_arguments") A.redraw() return} args.allocatedTokens=n}
    if operation=="import"{args.label=d.label args.homeserver=d.apiBaseUrl}
    if operation=="issue"{if c.registrationUrl.trim()==""{H.notice=A.t("Enter the appservice callback URL.","请输入应用服务回调地址。") A.redraw() return} args.url=c.registrationUrl.trim()}
    A.submit("hagency.web_connections."+operation,args)
}
A.web_connection_operation=fn(service){
    for op in ["create","allowance","withdraw","issue","import","replace","verify"]{if service=="hagency.web_connections."+op{return op}} return ""
}
A.web_connection_reply=fn(command,r){H.busy=false
    if r.is_ok && r.data!=nil && r.data.commandId==command.args.commandId && r.data.operation==A.web_connection_operation(command.service) && r.data.connection!=nil && r.data.connection.id==command.args.id{
        H.command=nil H.notice=A.t("Connection configuration saved.","连接配置已保存。") H.webConnection.detail=r.data.connection H.webConnection.id=r.data.connection.id H.webConnection.draft=nil H.page="web_connection" A.save() A.redraw() return
    }
    if !r.is_ok && (r.error=="web_connection_cancelled" || r.error=="provider_confirmation_expired" || r.error=="invalid_management_arguments" || r.error=="management_revision_conflict" || r.error=="connection_import_server_mismatch" || r.error=="invalid_connection_configuration"){
        H.command=nil A.save() H.notice=if r.error=="web_connection_cancelled"{A.t("Review cancelled. No configuration was changed.","已取消核对，没有更改配置。")}else{A.web_error(r.error)}
    }else{H.notice=A.t("The result is not confirmed. Check the saved result before retrying this request.","结果尚未确认，请先检查保存结果，再重试此请求。")}
    A.redraw()
}
A.web_connection_check=fn(){if H.busy || H.command==nil || !A.web_connection_service(H.command.service){return} let command=H.command
    A.web_read("hagency.web_connections.command.get",{commandId:command.args.commandId},fn(v){if v==nil{H.notice=A.t("No completed result is recorded. Resume the original request to review it again.","尚无完成记录，可恢复原请求再次核对。")}else{A.web_connection_reply(command,{is_ok:true data:v})}})
}
A.web_connection_download=fn(){let d=H.webConnection.detail if H.busy || d==nil || !d.registrationAvailable{return}
    A.web_read("hagency.web_connections.download",{id:d.id expectedRevision:d.revision},fn(v){H.notice=if v.saved{A.t("Private registration saved.","私密注册文件已保存。")}else{A.t("Save cancelled.","已取消保存。")}})
}

A.recipient_optional=fn(value,name){for index key field in value{if key.to_string()==name{return field}} return nil}
A.recipient_option_detail=fn(row){
    let status=A.recipient_optional(row,"status") let room_scope=A.recipient_optional(row,"scopeKind")
    if status=="approved"{return A.t("Agent request approved","Agent 申请已批准")}
    if status=="pending_approval" || status=="approved_waiting_executor" || status=="rejected" || status=="cancelled" || status=="revoked" || status=="expired"{return A.agent_state_text(status)}
    if status!=nil{return A.t("Current status unavailable","当前状态暂不可用")}
    if room_scope=="owner_direct"{return A.t("Owner’s direct room","主人的专属房间")}
    if room_scope=="project"{return A.t("Project room","项目房间")}
    if room_scope!=nil{return A.t("Room connection","房间关联")}
    return row.detail
}
A.recipient_kind=fn(kind){if kind=="shared_agent"{return A.t("Shared project agent","项目共享 Agent")} if kind=="personal_agent"{return A.t("Personal agent","个人 Agent")} return A.t("Human","人员")}
A.recipient_state=fn(state){if state=="binding_saved"{return A.t("Recipient binding saved","已保存接收方绑定")} if state=="binding_stale"{return A.t("Recipient binding needs review","接收方绑定需要重新核对")} return A.t("No recipient binding","尚未绑定接收方")}
A.recipient_saved_state=fn(p){
    if p.result!=nil{return A.flow_delivery("binding_saved")}
    if p.error!=nil{return A.t("Binding request refused","绑定请求已拒绝")}
    if H.flow_phase=="unknown" || H.flow_phase=="submitting"{return A.t("Binding result not confirmed","绑定结果尚未确认")}
    return A.t("Binding request saved; awaiting confirmation","绑定请求已保存，等待确认")
}
A.recipient_notice=fn(){return A.t("Choose an identity available to your current account. The recorded name stays unchanged. Saving a recipient does not send this task.","请选择当前账号可见的身份，记录的名称保持不变。保存接收方不会发送此任务。")}
A.recipient_reason=fn(code){
    if code=="node_not_held"{return A.t("This node no longer has held work to address. Read its latest state.","此节点已没有等待设置接收方的工作，请读取最新状态。")}
    if code=="sender_not_joined"{return A.t("Your current account has not joined this room. Check its membership before choosing this recipient.","当前账号尚未加入此房间，请先检查成员身份。")}
    if code=="recipient_not_joined"{return A.t("This recipient has not joined the selected room. Choose a current member or check again later.","此接收方尚未加入所选房间，请选择现有成员或稍后重新检查。")}
    if code=="room_identity_unavailable"{return A.t("The room identity could not be verified. Refresh its current state before continuing.","无法验证此房间身份，请刷新其当前状态后继续。")}
    if code=="sender_cannot_send"{return A.t("Your current account cannot send messages in this room. Ask the room administrator to check its permissions.","当前账号不能在此房间发送消息，请房间管理员检查权限。")}
    if code=="personal_binding_inactive"{return A.t("This personal agent’s room connection is inactive. Check its existing connection before choosing it.","此个人 Agent 的房间关联尚未启用，请先检查已有的关联。")}
    if code=="personal_binding_scope_unavailable"{return A.t("This room cannot be used for the selected personal agent. Choose one of its supported connections.","所选个人 Agent 不能使用此房间，请选择其支持的已有房间关联。")}
    if code=="project_room_inactive"{return A.t("This project room is inactive. Check the project’s current room setup.","此项目房间尚未启用，请检查项目当前的房间设置。")}
    if code=="shared_agent_not_approved"{return A.t("This shared agent has not been approved. Review its project request before selecting it.","此共享 Agent 尚未获批，请先查看项目中的申请状态。")}
    if code=="shared_project_not_ready"{return A.t("This project is not ready. Complete its allocation and Matrix room setup before selecting an agent.","此项目尚未就绪，请先完成资源分配和 Matrix 房间设置。")}
    if code=="shared_membership_unavailable"{return A.t("This agent’s membership in the project room could not be verified. Check its latest project status.","无法验证此 Agent 的项目房间成员身份，请查看最新项目状态。")}
    if code=="project_manager_required" || code=="shared_project_manager_required"{return A.t("Only this project's manager can send shared-agent work.","只有此项目的经理可以发送共享 Agent 工作。")}
    if code=="recipient_binding_changed" || code=="graph_recipient_changed" || code=="management_recipient_changed"{return A.t("The recipient identity or its authority changed. Observe it again before preparing another binding.","接收方身份或权限已变化，请重新检查后再准备绑定。")}
    if code=="recipient_unavailable" || code=="graph_recipient_unavailable" || code=="management_recipient_unavailable"{return A.t("This recipient is not currently available. No binding has been authorized.","此接收方目前不可用，尚未授权绑定。")}
    if code=="recipient_blocked" || code=="graph_recipient_blocked"{return A.t("This identity cannot be bound in its current state. Review the reason and choose an available recipient.","此身份的当前状态不允许绑定，请核对原因并选择可用接收方。")}
    return A.flow_reason(code)
}
A.recipient_matches=fn(f,v){return v!=nil && v.graphId==f.graphId && v.nodeId==f.nodeId && v.runtimeDeliveryAuthorized==false}
A.recipient_current=fn(){if H.busy || H.flow_recipient==nil{return}
    let f=H.flow_recipient f.current=nil f.options=nil f.observation=nil f.target=nil f.query=nil f.history=[] f.kind="" f.error="" f.stale=false f.currentDetails=false f.observationDetails=false
    A.flow_read("hagency.graphs.recipient.get",{id:f.graphId nodeId:f.nodeId},fn(v){
        if H.flow_recipient!=f{return} if !A.recipient_matches(f,v) || (v.state!="unbound" && v.state!="binding_saved" && v.state!="binding_stale") || (v.state=="unbound" && v.binding!=nil) || (v.state!="unbound" && v.binding==nil){A.flow_bad_reply() return}
        if v.binding!=nil && (v.binding.graphId!=f.graphId || v.binding.nodeId!=f.nodeId || v.binding.runtimeDeliveryAuthorized!=false){A.flow_bad_reply() return}
        if v.revision!=f.revision{f.stale=true f.error=A.flow_reason("management_revision_conflict") return}
        f.current=v
    })
}
A.recipient_begin=fn(){if !A.flow_can_edit() || H.flow_node==nil{return}
    let n=H.flow_node H.flow_recipient={graphId:H.flow_id nodeId:n.id revision:n.revision assignee:n.assignee current:nil kind:"" query:nil options:nil history:[] target:nil observation:nil error:"" stale:false currentDetails:false observationDetails:false}
    H.flow_phase="editing" H.flow_error="" H.page="operator_graph_recipient" A.recipient_current()
}
A.recipient_options=fn(query,push){if H.busy || H.flow_recipient==nil{return}
    let f=H.flow_recipient if f.current==nil || f.stale || H.flow_phase!="editing"{return}
    if query.id!=f.graphId || query.nodeId!=f.nodeId || (query.kind!="shared_agent" && query.kind!="personal_agent" && query.kind!="human"){A.flow_bad_reply() return}
    if push && f.query!=nil{f.history.push(f.query)}
    f.query=query.to_json().parse_json() f.kind=query.kind f.options=nil f.observation=nil f.target=nil f.error=""
    let original=f.query.to_json()
    A.flow_read("hagency.graphs.recipient.options",f.query,fn(v){
        if H.flow_recipient!=f || f.query==nil || f.query.to_json()!=original{return}
        if !A.recipient_matches(f,v) || v.kind!=f.kind || v.items==nil || v.items.len()>16{A.flow_bad_reply() return}
        if v.revision!=f.revision{f.stale=true f.error=A.flow_reason("management_revision_conflict") return}
        for row in v.items{let {next=nil,target=nil}=row if !row.id.is_string() || !row.label.is_string() || !row.detail.is_string() || (next==nil && target==nil) || (next!=nil && target!=nil){A.flow_bad_reply() return}}
        f.options=v
    })
}
A.recipient_choose=fn(kind){if H.busy || H.flow_recipient==nil{return} let f=H.flow_recipient f.history=[] A.recipient_options({id:f.graphId nodeId:f.nodeId kind:kind},false)}
A.recipient_page=fn(after){if H.busy || H.flow_recipient==nil || H.flow_recipient.query==nil{return} let q=H.flow_recipient.query.to_json().parse_json() q.after=after A.recipient_options(q,false)}
A.recipient_parent=fn(){if H.busy || H.flow_recipient==nil{return} let f=H.flow_recipient if f.history.len()==0{A.recipient_current() return}
    let keep=[] let q=nil for index item in f.history{if index==f.history.len()-1{q=item}else{keep.push(item)}} f.history=keep A.recipient_options(q,false)
}
A.recipient_pick=fn(row){if H.busy || H.flow_recipient==nil || H.flow_recipient.options==nil{return}
    let found=false for item in H.flow_recipient.options.items{if item==row{found=true}} if !found{return}
    let {next=nil,target=nil}=row
    if next!=nil{if next.kind!=H.flow_recipient.kind{A.flow_bad_reply() return} A.recipient_options(next,true) return}
    if target!=nil{A.recipient_observe(target)}
}
A.recipient_observe=fn(target){if H.busy || H.flow_recipient==nil{return}
    let f=H.flow_recipient if f.stale || f.current==nil || H.flow_phase!="editing" || target==nil || target.kind!=f.kind{return}
    f.target=target.to_json().parse_json() f.observation=nil f.observationDetails=false f.error="" let original=f.target.to_json()
    A.flow_read("hagency.graphs.recipient.observe",{id:f.graphId nodeId:f.nodeId target:f.target},fn(v){
        if H.flow_recipient!=f || f.target==nil || f.target.to_json()!=original{return}
        if !A.recipient_matches(f,v) || v.target==nil || v.target.to_json()!=original || !v.observationDigest.is_string() || v.blockingReasons==nil || v.blockingReasons.len()>16 || !v.account.is_string() || !v.server.is_string() || (v.canBind!=true && v.canBind!=false){A.flow_bad_reply() return}
        if v.revision!=f.revision{f.stale=true f.error=A.flow_reason("management_revision_conflict") return}
        f.observation=v
    })
}
A.recipient_prepared_matches=fn(args,v){return v!=nil && v.graphId==args.id && v.expectedRevision==args.expectedRevision && v.change!=nil && v.change.operation=="bind_recipient" && v.change.nodeId==args.nodeId && v.change.snapshot!=nil && v.change.snapshot.target!=nil && v.change.snapshot.target.to_json()==args.target.to_json() && v.change.snapshot.observationDigest==args.observationDigest}
A.recipient_prepare=fn(){if H.busy || H.flow_recipient==nil || H.flow_phase!="editing"{return}
    let f=H.flow_recipient let v=f.observation
    if f.stale || v==nil || !v.canBind || v.blockingReasons.len()!=0 || v.runtimeDeliveryAuthorized!=false || v.revision!=f.revision || f.target==nil || v.target.to_json()!=f.target.to_json(){return}
    A.flow_prepare("hagency.graphs.bind_recipient",{id:f.graphId nodeId:f.nodeId expectedRevision:f.revision target:f.target.to_json().parse_json() observationDigest:v.observationDigest})
}

A.graph_state=fn(state){
    if state=="copying"{return A.t("Copy incomplete","复制未完成")}
    if state=="archived"{return A.t("Saved history","已保存的历史")}
    if state=="pending"{return A.t("Pending","待执行")}
    if state=="dispatched"{return A.t("Dispatched","已派发")}
    if state=="active"{return A.t("In progress","进行中")}
    if state=="complete"{return A.t("Completed","已完成")}
    if state=="failed"{return A.t("Failed","失败")}
    if state=="skipped"{return A.t("Skipped","已跳过")}
    if state=="cancelled"{return A.t("Cancelled","已取消")}
    return state
}
A.graph_error=fn(){H.notice=A.t("History could not be loaded. Refresh to try again.","无法读取历史记录，请刷新重试。")}
A.open_graph_archives=fn(){if H.busy{return}
    H.page="graph_archives" H.graph_archives=nil
    A.request("hagency.graph_history.archives",{},fn(v){
        if H.page!="graph_archives"{return}
        if v==nil || v.archives==nil || v.readOnly!=true || v.identityMapped!=false{A.graph_error() return}
        H.graph_archives=v
    })
}
A.open_graph_history=fn(archive,after){if H.busy{return}
    H.page="graph_history" H.graph_archive=archive H.graph_after=after H.graph_page=nil
    A.request("hagency.graph_history.list",{archiveId:archive after:after},fn(v){
        if H.page!="graph_history" || H.graph_archive!=archive || H.graph_after!=after{return}
        if v==nil || v.archiveId!=archive || v.graphs==nil{A.graph_error() return} H.graph_page=v
    })
}
A.open_history_graph=fn(archive,id,after){if H.busy{return}
    H.page="history_graph" H.graph_archive=archive H.graph_id=id H.graph_node_after=after H.graph_detail=nil
    A.request("hagency.graph_history.get",{archiveId:archive id:id after:after},fn(v){
        if H.page!="history_graph" || H.graph_archive!=archive || H.graph_id!=id || H.graph_node_after!=after{return}
        if v==nil || v.archiveId!=archive || v.graph==nil || v.graph.id!=id || v.nodes==nil{A.graph_error() return} H.graph_detail=v
    })
}
A.open_history_node=fn(archive,id,node){if H.busy{return}
    H.page="history_node" H.graph_archive=archive H.graph_id=id H.graph_node_id=node H.graph_node=nil H.graph_dep_offset=0
    A.request("hagency.graph_history.node",{archiveId:archive id:id nodeId:node},fn(v){
        if H.page!="history_node" || H.graph_archive!=archive || H.graph_id!=id || H.graph_node_id!=node{return}
        if v==nil || v.archiveId!=archive || v.graphId!=id || v.id!=node || v.dependsOn==nil{A.graph_error() return} H.graph_node=v
    })
}

A.open_tasks = fn(offset){if H.busy{return} H.page="operator_tasks" H.task_offset=offset H.task_page=nil
    let f=H.task_filters let q={offset:offset} if f.assignee!=""{q.assignee=f.assignee} if f.status!=""{q.status=f.status} if f.priority!=""{q.priority=f.priority} if f.label!=""{q.label=f.label}
    A.request("hagency.tasks.list",q,fn(v){H.task_page=v})
}
A.task_filter = fn(key,value){if H.busy{return}
    if key=="status"{H.task_filters.status=value} if key=="priority"{H.task_filters.priority=value} if key=="label"{H.task_filters.label=value}
    A.open_tasks(0)
}
A.open_task = fn(id,offset){if H.busy{return} if H.task_id!=id{H.task_details_open=false} H.page="operator_task" H.task_id=id H.task_comment_offset=offset H.task_detail=nil A.request("hagency.tasks.get",{id:id commentOffset:offset},fn(v){H.task_detail=v})}
A.open_board = fn(query){if H.busy{return} H.page="operator_board" H.task_board_query=query H.task_board=nil A.request("hagency.tasks.board",query,fn(v){H.task_board=v})}
A.agent_tasks = fn(name){if H.busy{return} H.task_filters={assignee:name status:"" priority:"" label:""} H.task_from_board=true A.open_tasks(0)}
A.refresh = fn(){
    if !H.ready { A.connect() return }
    A.request("hagency.intent.pending", {}, fn(data){H.saved_commands = data.commands A.refresh_page()})
}
A.refresh_page = fn(){
    if H.page=="pools" {A.load_pools(nil) return}
    if H.page=="pool_apply" {A.pool_refresh() return}
    if H.page=="pool_agents" || (H.page=="inbox" && H.entry_role=="owner"){A.load_pool_agents(nil) return}
    if H.page=="pool_agent" && H.pool_detail!=nil {A.open_pool_agent(H.pool_detail.id) return}
    if H.page=="overview" {A.redraw() return}
    if H.page=="agent_home" {A.load_agent_home() return}
    if H.page=="web_connections"{A.web_connections_open(H.webConnection.after) return}
    if H.page=="web_connection" || H.page=="web_overview" || H.page=="web_catalog"{A.web_refresh_now() return}
    if H.page=="web_catalog_command"{if H.web.commandId!=""{A.open_saved_web({commandId:H.web.commandId})} return}
    if H.page=="templates"{A.open_templates(H.templates.resourceId,H.templates.after) return}
    if H.page=="template"{A.open_template(H.templates.resourceId,H.templates.id) return}
    if H.page=="template_command"{if H.templates.pending!=nil{A.open_saved_template(H.templates.pending)} return}
    if H.page=="operator_graphs"{A.open_flows(H.flow_after) return}
    if H.page=="operator_graph"{A.open_flow(H.flow_id,H.flow_node_after) return}
    if H.page=="operator_graph_node"{A.open_flow_node(H.flow_id,H.flow_node_id) return}
    if H.page=="operator_graph_command"{if H.flow_pending!=nil{A.open_saved_graph(H.flow_pending)} return}
    if H.page=="operator_graph_recipient"{A.recipient_current() return}
    if H.page=="graph_archives"{A.open_graph_archives() return}
    if H.page=="graph_history"{A.open_graph_history(H.graph_archive,H.graph_after) return}
    if H.page=="history_graph"{A.open_history_graph(H.graph_archive,H.graph_id,H.graph_node_after) return}
    if H.page=="history_node"{A.open_history_node(H.graph_archive,H.graph_id,H.graph_node_id) return}
    if H.page=="connection_history" {A.open_connection_history(H.history_id,H.history_after,H.history_page) return}
    if H.page=="connection_reoffer" {A.begin_reoffer() return}
    if H.page == "provider_accounts" {A.open_accounts(H.account_after) return}
    if H.page == "provider_account" {A.open_account(H.account_id,H.account_resource_after) return}
    if H.page=="stopped_tasks" {A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,H.stopped_after) return}
    if H.page=="stopped_task" {A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,0) return}
    if H.page=="workspaces" {A.open_workspaces(H.workspace_resource,H.workspace_after) return}
    if H.page=="workspace" {A.open_workspace(H.workspace_resource,H.workspace_id) return}
    if H.page=="execution_policies" {A.open_policies(H.policy_resource,H.policy_after) return}
    if H.page=="execution_policy" {A.open_policy(H.policy_resource,H.policy_engagement) return}
    if H.page == "personal_agents" {A.open_personal_agents(H.personal_after,H.personal_page) return}
    if H.page == "personal_agent" {A.open_personal_agent(H.personal_id) return}
    if H.page == "agent_control" {A.open_agent_control(H.control_assignment,H.control_agent_name) return}
    if H.page == "agent_budget" {A.open_agent_budget(H.budget_request_id,H.budget_agent_name,H.budget_after,H.budget_page)} else if H.page == "agent_topup" {A.open_topup(H.budget_topup_id)} else if H.page == "operator_task_command" {if H.task_pending!=nil{A.open_saved_task(H.task_pending)}} else if H.page == "operator_tasks" {A.open_tasks(H.task_offset)} else if H.page == "operator_task" {A.open_task(H.task_id,H.task_comment_offset)} else if H.page == "operator_board" {A.open_board(H.task_board_query)} else if H.page == "device_execution" {A.open_execution(H.execution_after)} else if H.page == "allocations" {A.open_allocations(H.allocation_project,H.allocation_after,H.allocation_page)} else if H.page == "allocation_action" {A.open_allocation(H.allocation_id)} else if H.page == "onboarding" {A.open_onboarding()} else if H.page == "resources" {
        let args = {after:if H.ux.resourceCursor==nil{""}else{H.ux.resourceCursor} limit:16}
        if H.capability != "" { args.capability = H.capability }
        A.request("hagency.resources.list", args, fn(data){H.resources = data.resources H.resource_after = data.nextAfter})
    } else if H.page=="tool_request" {A.open_tool_request(H.tool_request_id)
    } else if H.page=="tool_approvals" || H.page=="tool_grants" || H.page=="tool_grant_review" || H.page=="tool_grant_result" {A.open_tools(H.tool_resource,H.tool_engagement,H.tool_after,H.tool_kind)
    } else if H.page=="approval_bindings" || H.page=="approval_binding_review" || H.page=="approval_binding_result" {A.open_bindings(H.binding_resource,H.binding_after)
    } else if H.page == "resource_alerts" {A.open_alerts(H.alert_resource,H.alert_after,H.alert_status)
    } else if H.page == "resource_alert" {A.open_alert(H.alert_resource,H.alert_id,H.alert_note_after)
    } else if (H.page == "resource_detail" || (H.page=="resource_edit" || H.page=="resource_create")) && H.resource_id != "" {
        A.open_resource(H.resource_id)
    } else if H.page == "connections" || H.page == "overview" {
        A.request("hagency.connections.list", {}, A.connections_received)
    } else if H.page == "inbox" {
        A.load_inbox()
    } else if (H.page == "agents" || H.page == "agent_wizard") && A.agents_enabled() {
        A.open_project_agents(H.agent_project_id)
    } else if H.page == "agent_removals" {A.open_removals(H.removal_project,H.removal_after,H.removal_page)
    } else if H.page == "agent_removal" {A.open_removal(H.removal_id)
    } else if H.page == "agent_work_list" {
        A.open_work_list(H.work_list_project,H.work_list_after,H.work_list_page)
    } else if H.page == "agent_work" && H.agent_id != "" {
        A.open_agent_work(H.agent_id,H.work_after,H.work_page)
    } else if H.page == "agent_status" && H.agent_id != "" && A.agents_enabled() {
        A.open_agent_status(H.agent_id)
    } else if H.page == "agent_action" && H.agent_id != "" && A.agents_enabled() {
        A.open_agent(H.agent_id)
    } else if H.page == "projects" && A.projects_enabled() {
        A.request("hagency.projects.list", {after:H.ux.projectCursor}, fn(data){H.projects=data.items H.project_after=data.nextAfter})
    } else if H.page == "project_wizard" && A.projects_enabled() {
        A.load_catalog()
    } else if H.page == "project_setup" && H.project_selected != nil && A.setup_enabled() {
        A.open_project_setup(H.project_selected.id)
    } else if H.page == "project_action" && H.project_selected != nil && A.projects_enabled() {
        A.open_project(H.project_selected.id)
    } else if H.page == "wizard" {
        if H.wizard.admission != nil { A.open_connection(H.wizard.admission.contribution.id) }
        else { A.load_providers() }
    } else if H.page == "action" && H.ux.connectionId != "" { A.open_connection(H.ux.connectionId) }
}
A.connect = fn(){
    A.request("hagency.session", {}, fn(data){
        if data.protocol != "hagency-management-v1" { H.notice = A.t("This server needs a compatible Hagency update.", "此服务器需要更新到兼容的 Hagency 版本。") return }
        H.session = data H.ready = true H.needs_signin=false
        if !H.restored {
            H.restored = true
            if fs.exists("onboarding-v1.json") {
                try {
                    let stored = fs.read("onboarding-v1.json").parse_json()
                    if stored != nil && stored.version == 1 && stored.account == data.account {
                        H.wizard = stored.wizard H.command = stored.command
                        let {projectDraft = nil,agentDraft=nil,poolDraft=nil,resourceJourney=false,setupAccountId="",workspace=""} = stored
                        if A.entry_allowed(workspace){H.entry_role=workspace}
                        if poolDraft!=nil {H.pool_draft=poolDraft}
                        H.ux.resourceJourney=resourceJourney H.ux.accountId=setupAccountId
                        if agentDraft != nil {A.restore_agent_draft(agentDraft)}
                        if projectDraft != nil {A.restore_project_draft(projectDraft)}
                        if H.wizard.admission != nil {H.wizard.admission.contribution.verification = nil}
                    }
                } {H.notice = A.t("The page draft could not be read. Saved requests are recovered from native storage.", "无法读取页面草稿，已保存的请求将从原生存储恢复。")}
            }
        }
        if !A.entry_allowed(H.entry_role){H.entry_role=""}
        H.entry_choosing=H.entry_role==""
        A.refresh()
    })
}
A.navigate = fn(page){
    if page=="projects" {page="pools"}
    if page=="agent_home" {page="pool_agents"}
    if H.busy {return}
    H.ux.origin="" H.ux.restore=false
    if page=="inbox" {H.ux.inboxCursor=nil H.ux.agentCursor=nil}
    if page=="projects" {H.ux.projectCursor=nil}
    if page=="resources" {H.ux.resourceCursor=nil H.ux.resourceJourney=false}
    H.page=page H.selected=nil H.connection_project=nil H.confirm="" H.notice="" A.redraw() A.refresh()
}
A.load_catalog = fn(){
    let args = {}
    if H.catalog_capability != "" {args.capability = H.catalog_capability}
    A.request("hagency.resources.catalog", args, fn(data){H.catalog = data.items H.catalog_after = data.nextAfter})
}
A.begin_project = fn(){
    if H.busy || H.command != nil || !A.projects_enabled() {return}
    H.page = "project_wizard" H.confirm = "" H.notice = "" A.redraw() A.load_catalog()
}
A.new_project = fn(){
    if H.busy || H.command != nil {return}
    H.project_draft = {step:0 resource:nil name:"" purpose:"" tokens:"100000"}
    H.catalog_capability = "" A.save() A.begin_project()
}
A.choose_project_resource = fn(row){
    if H.busy || H.command != nil {return}
    H.project_draft.resource = row H.project_draft.step = 1 A.save() A.redraw()
}
A.project_field = fn(name, value){
    if H.command != nil {return}
    if name == "name" {H.project_draft.name = value}
    if name == "purpose" {H.project_draft.purpose = value}
    if name == "tokens" {H.project_draft.tokens = value}
    A.save()
}
A.project_step = fn(step){
    if H.busy || H.command != nil {return}
    if step == 2 {
        let tokens = H.project_draft.tokens.trim().to_f64()
        if H.project_draft.resource == nil || H.project_draft.name.trim() == "" || H.project_draft.purpose.trim() == "" || !(tokens >= 1 && tokens <= 9007199254740991) || floor(tokens) != tokens {
            H.notice = A.t("Enter a project name, its purpose and a positive whole number of monthly tokens.", "请输入项目名称、用途与大于零的每月 token 整数数量。") A.redraw() return
        }
    }
    H.notice = "" H.project_draft.step = step A.save() A.redraw()
    if step == 0 {A.load_catalog()}
}
A.request_project = fn(){
    if H.project_draft.resource == nil {return}
    A.submit("hagency.projects.request", {contributionId:H.project_draft.resource.id name:H.project_draft.name.trim() purpose:H.project_draft.purpose.trim() requestedTokens:H.project_draft.tokens.trim().to_f64()})
}
A.refresh_project_progress=fn(id){A.request("hagency.projects.setup.progress",{projectId:id},fn(v){if H.project_selected!=nil && H.project_selected.id==id && v.readiness.projectId==id{H.ux.projectProgress=v}})}
A.open_project = fn(id){
    if H.busy {return}
    if H.project_selected==nil || H.project_selected.id!=id {H.ux.projectTools=false}
    H.ux.projectProgress=nil
    A.request("hagency.projects.get", {id:id}, fn(data){
        if data.project.id!=id {H.notice=A.t("The project changed. Open it again.","项目已变化，请重新打开。") return}
        H.project_selected=data.project H.connection_project=nil H.page="project_action" H.confirm=""
        if data.project.state=="approved" && A.setup_enabled() {
            A.request("hagency.projects.setup.progress",{projectId:id},fn(v){
                if H.project_selected!=nil && H.project_selected.id==id && v.readiness.projectId==id {H.ux.projectProgress=v}
            })
        }
    })
}
A.decide_project = fn(approve){
    if H.project_selected == nil || !H.project_selected.request.canDecide {return}
    A.submit("hagency.projects.decide", {requestId:H.project_selected.request.id expectedRevision:H.project_selected.request.revision approve:approve})
}
A.revoke_project = fn(){
    if H.project_selected == nil || !H.project_selected.canRevoke {return}
    A.submit("hagency.projects.revoke", {projectId:H.project_selected.id expectedRevision:H.project_selected.revision})
}
A.allocations_enabled = fn(){
    if A.pool_enabled(){return false}
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "project-allocation-review-v1" {return true}}
    return false
}
A.allocation_state = fn(state){
    if state == "pending_coordinator" || state == "pending" {return A.t("Awaiting resource owner decision", "等待资源所有者决定")}
    if state == "approved_waiting_executor" {return A.t("Approved · awaiting native reservation", "已批准 · 等待原生预留")}
    if state == "reserved" {return A.t("Native reservation recorded", "原生预留已记录")}
    if state == "rejected" {return A.t("Allocation declined", "分配已拒绝")}
    if state == "refused" {return A.t("Native reservation refused", "原生预留已拒绝")}
    if state == "outcome_unknown" {return A.t("Native result unknown", "原生结果未知")}
    if state == "releasing" {return A.t("Release requested · awaiting native result", "已申请释放 · 等待原生结果")}
    if state == "release_blocked" {return A.t("Release requires reconciliation", "释放前需要核算")}
    if state == "released" {return A.t("Release result recorded", "释放结果已记录")}
    if state == "expired" {return A.t("Allocation expired", "分配已过期")}
    return A.t("Recorded state · ", "已记录状态 · ")+state
}
A.allocation_reason = fn(code){
    if code == nil {return ""}
    if code == "resource_owner_is_coordinator" {return A.t("The resource owner automatically coordinates its capacity. Refresh this resource and submit again.", "资源所有者自动协调其容量。请刷新资源后重新提交。")}
    if code == "allocation_coordinator_required" {return A.t("Only the resource owner can decide this allocation.", "只有资源所有者可以决定此分配。")}
    if code == "allocation_release_forbidden" {return A.t("Only the project manager, resource owner or server administrator can request release.", "只有项目经理、资源主人或服务器管理员可以申请释放。")}
    if code == "allocation_exceeds_grant" {return A.t("The project request exceeds the owner's grant. The approved project amount cannot be changed here.", "项目申请超过资源所有者的授权额度，无法在此更改已批准的项目数量。")}
    if code == "project_reservations_unavailable" {return A.t("Project reservations are not enabled on this server.", "此服务器尚未启用项目预留。")}
    if code == "owner_grant_unavailable" || code == "grant_expired" || code == "grant_unavailable" || code == "grant_not_active" {return A.t("The owner grant is no longer current. Its original reservation history remains available.", "资源主人授权已不再有效，原始预留历史仍可查看。")}
    if code == "project_not_approved" || code == "project_unavailable" {return A.t("The project is no longer approved for this allocation. Refresh its latest plan before proceeding.", "项目已不再获准进行此分配，请先刷新项目计划。")}
    if code == "project_revision_changed" {return A.t("The approved project plan changed. This allocation cannot silently switch to its new revision.", "已批准的项目计划已变化，此分配不能自动改用新版本。")}
    if code == "allocation_expired" {return A.t("This allocation period expired. Review the original history; refreshing does not renew it.", "此分配周期已过期，可查看原始历史；刷新不会续期。")}
    if code == "manager_not_eligible" {return A.t("This project manager is not included in the owner's current delegation.", "此项目经理不在资源主人的当前委托范围内。")}
    if code == "executor_unavailable" {return A.t("The owner device or its admitted resource binding needs a fresh check before allocation can proceed.", "需要先重新检查主人设备或获准的资源关联，才能继续分配。")}
    if code == "self_approval_forbidden" {return A.t("This capacity grant does not allow the owner to approve a project they also manage.", "此容量授权不允许资源所有者批准其本人管理的项目申请。")}
    if code == "management_allocation_reply_invalid" {return A.t("The allocation reply could not be verified. Refresh to read the exact record again.", "无法验证分配响应，请刷新并重新读取准确记录。")}
    return A.error_text(code)
}
A.allocation_not_applied = fn(service,code){
    if service != "hagency.allocations.decide" && service != "hagency.allocations.release" {return false}
    for known in ["invalid_arguments","invalid_management_arguments","invalid_identifier","invalid_management_payload","invalid_management_revision","management_revision_changed","management_receipt_capacity","allocation_coordinator_required","management_action_closed","allocation_exceeds_grant","allocation_release_forbidden"] {if code == known {return true}}
    return false
}
A.open_allocations = fn(project_id,after,page){
    if H.busy {return}
    H.page="allocations" H.allocation_project=project_id H.allocation_after=after H.allocation_page=page H.allocation_list=nil H.allocation_confirmation=""
    if !A.allocations_enabled() {H.notice=A.allocation_reason("project_reservations_unavailable") A.redraw() return}
    A.request("hagency.allocations.list",{projectId:project_id after:after limit:16},fn(data){H.allocation_list=data})
}
A.open_allocation = fn(id){
    if H.busy {return}
    H.page="allocation_action" H.allocation_id=id H.allocation_detail=nil H.allocation_confirmation=""
    if !A.allocations_enabled() {H.notice=A.allocation_reason("project_reservations_unavailable") A.redraw() return}
    A.request("hagency.allocations.get",{id:id},fn(data){
        if data.detail.allocation.id != id {H.notice=A.allocation_reason("management_allocation_reply_invalid") return}
        H.allocation_detail=data H.allocation_project=data.detail.allocation.projectId
    })
}
A.allocation_decide = fn(approve){
    if H.busy || H.command != nil || H.allocation_detail == nil {return}
    let detail=H.allocation_detail.detail
    if !detail.allocation.canDecide || !detail.request.canDecide {return}
    A.submit("hagency.allocations.decide",{requestId:detail.request.id expectedRevision:detail.request.revision approve:approve})
}
A.allocation_release = fn(){
    if H.busy || H.command != nil || H.allocation_detail == nil {return}
    let row=H.allocation_detail.detail.allocation
    if !row.canRelease {return}
    A.submit("hagency.allocations.release",{allocationId:row.id expectedRevision:row.revision})
}
A.allocation_back = fn(){
    if H.allocation_from_inbox {A.navigate("inbox")}
    else {A.open_allocations(H.allocation_project,H.allocation_after,H.allocation_page)}
}
A.cleanup_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "agent-cleanup-v1" {return true}}
    return false
}
A.open_removals = fn(project,after,page){
    if H.busy {return}
    H.removals=nil H.removal_project=project H.removal_after=after H.removal_page=page H.page="agent_removals"
    if !A.cleanup_enabled() {A.redraw() return}
    A.request("hagency.agents.removal.list",{projectId:project after:after limit:16},fn(data){
        if data.protocol != "hagency-management-v1" {H.notice=A.agent_reason("management_agent_cleanup_invalid") return}
        H.removals=data
    })
}
A.open_removal = fn(id){
    if H.busy {return}
    H.settlement=nil
    H.removal_id=id H.removal=nil H.removal_confirmation="" H.removal_details=false H.page="agent_removal"
    if !A.cleanup_enabled() {A.redraw() return}
    A.request("hagency.agents.removal.get",{id:id},fn(data){
        if data.protocol != "hagency-management-v1" || data.removal.requestId != id {H.notice=A.agent_reason("management_agent_cleanup_invalid") return}
        if H.page != "agent_removal" || H.removal_id != id {return}
        H.removal=data
        if A.settlement_enabled() {A.open_settlement(id)}
    })
}
A.settlement_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "agent-settlement-v1" {return true}}
    return false
}
A.open_settlement = fn(id){
    if H.busy || !A.settlement_enabled() {return}
    H.settlement=nil
    A.request("hagency.agents.settlement.get",{id:id},fn(data){
        if H.page != "agent_removal" || H.removal_id != id {return}
        if data.protocol != "hagency-management-v1" || data.settlement.requestId != id {H.notice=A.settlement_reason("management_agent_settlement_invalid") return}
        H.settlement=data
    })
}
A.recheck_settlement = fn(){
    if H.busy || H.command != nil || !A.settlement_enabled() || H.settlement == nil {return}
    let s=H.settlement.settlement
    if s.requestId != H.removal_id || !s.canRequest || s.pendingCommandId != nil || s.settlementCurrent || s.fenceReceiptDigest == nil {return}
    A.submit("hagency.agents.settlement.request",{requestId:s.requestId expectedRequestRevision:s.requestRevision expectedFenceReceiptDigest:s.fenceReceiptDigest})
}
A.settlement_reason = fn(code){
    if code == "agent_settlement_changed" || code == "agent_settlement_not_ready" {return A.t("The accounting state changed before this request was accepted. Refresh its latest status.", "请求被接受前核算状态已变化，请刷新最新状态。")}
    if code == "agent_request_not_found" {return A.t("This agent is no longer visible to your current project role.", "当前项目角色已无权查看此 Agent。")}
    if code == "management_agent_settlement_invalid" {return A.t("The settlement reply could not be verified. Refresh or recover the saved request.", "无法验证结算回复，请刷新或恢复已保存的请求。")}
    return A.error_text(code)
}
A.settlement_status = fn(s){
    if s.pendingCommandId != nil {return A.t("Waiting for the original device", "等待原执行设备核算")}
    if s.settlementCurrent {return A.t("Accounting complete for recorded evidence", "已根据当前记录完成核算")}
    if s.latestReceipt != nil && s.latestReceipt.usageComplete {return A.t("Newer evidence needs reconciliation", "新记录需要重新核算")}
    if s.latestReceipt != nil {return A.t("Unresolved usage is still retained", "未核清的用量仍保留记账")}
    if s.fenceReceiptDigest == nil {return A.t("Waiting for the device cleanup receipt", "等待设备清理回执")}
    return A.t("No settlement observation yet", "尚无结算观测")
}
A.removal_number = fn(value){if value == nil {return A.t("Unknown", "未知")} return ""+value+" token"}
A.cleanup_state = fn(value){
    if value == nil {return A.t("No observation recorded", "尚无观测记录")}
    if value == "pending" || value == "cleanup_pending" {return A.t("Cleanup pending", "等待清理")}
    if value == "delivered" {return A.t("Command delivered", "指令已送达")}
    if value == "completed" || value == "applied" || value == "recorded" {return A.t("Result recorded", "结果已记录")}
    if value == "fenced" {return A.t("New work blocked", "已阻止新任务")}
    if value == "closed" {return A.t("Closure recorded", "已记录关闭")}
    if value == "stopped" {return A.t("Stop observed", "已观测到停止")}
    if value == "not_started" {return A.t("No process start recorded", "尚无进程启动记录")}
    if value == "live" || value == "active" {return A.t("Live at the recorded observation", "记录观测时仍在运行")}
    if value == "unknown" || value == "outcome_unknown" {return A.t("Outcome unknown", "结果未知")}
    if value == "cleaned" {return A.t("Cleanup recorded", "已记录清理")}
    if value == "qualified" {return A.t("Qualification recorded", "已记录资格检查")}
    if value == "failed" {return A.t("Failure recorded", "已记录失败")}
    if value == "absent_fenced" {return A.t("No reservation · new work blocked", "未创建预留 · 已阻止新任务")}
    if value == "retained" {return A.t("Liability retained", "仍保留额度责任")}
    return A.t("Recorded state · ", "已记录状态 · ")+value
}
A.matrix_cleanup_state = fn(value){
    if value == nil {return A.cleanup_state(nil)}
    if value.state == "fenced" && value.cleanupObservedAtUtc != nil {return A.t("Project-room exit observed", "已确认退出项目房间")}
    return A.cleanup_state(value.state)
}
A.cleanup_complete = fn(value){
    if value == nil {return A.t("No cleanup accounting receipt", "尚无清理核算回执")}
    if value {return A.t("Complete in the cleanup receipt", "清理回执中的核算完整")}
    return A.t("Cleanup accounting incomplete", "清理核算尚未完成")
}
A.confirm_removal = fn(){
    if H.busy || H.command != nil || !A.cleanup_enabled() || H.removal == nil {return}
    let r=H.removal.removal
    if H.removal_confirmation == "cancel" && r.canCancel {A.submit("hagency.agents.cancel",{requestId:r.requestId expectedRevision:r.requestRevision})}
    if H.removal_confirmation == "revoke" && r.canRevoke {A.submit("hagency.agents.revoke",{requestId:r.requestId expectedRevision:r.requestRevision})}
}

A.agents_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "agent-admission-v1" {return true}}
    return false
}
A.agent_state_text = fn(state){
    if state == "pending_approval" {return A.t("Awaiting resource owner approval", "等待资源 owner 批准")}
    if state == "approved_waiting_executor" {return A.t("Approved · executor setup pending", "已批准 · 等待执行设备设置")}
    if state == "rejected" {return A.t("Agent request declined", "Agent 申请已拒绝")}
    if state == "cancelled" {return A.t("Agent request cancelled", "Agent 申请已取消")}
    if state == "revoked" {return A.t("Agent request revoked", "Agent 申请已撤销")}
    if state == "expired" {return A.t("Agent request expired", "Agent 申请已过期")}
    return state
}
A.project_next_steps = fn(){
    if A.setup_enabled() && A.agents_enabled() {return A.t("Open Project setup and Project agents to review this server's current prerequisites. Capacity must be confirmed separately.", "请打开“项目设置”和“项目 Agent”查看服务器当前要求。容量需另行确认。")}
    if A.setup_enabled() {return A.t("Open Project setup to review current prerequisites. Agent requests are not enabled on this server.", "请打开“项目设置”查看当前要求。此服务器尚未启用 Agent 申请。")}
    if A.agents_enabled() {return A.t("Open Project agents to review current request prerequisites. Project setup is not enabled on this server.", "请打开“项目 Agent”查看当前申请要求。此服务器尚未启用项目设置。")}
    return A.t("This server has not enabled project setup or agent requests in this mini app.", "此服务器尚未在小程序中启用项目设置或 Agent 申请。")
}
A.agent_stage_text = fn(stage){
    if !stage.supported {return A.t("Not enabled on this server", "此服务器尚未启用")}
    if stage.record == nil {return A.t("No stage result recorded", "尚无此阶段的结果记录")}
    let state=stage.record.state
    if state == "pending_native" || state == "waiting_native" {return A.t("Waiting for executor", "等待执行设备处理")}
    if state == "authorized" {return A.t("Native check accepted · Matrix update pending", "原生检查已接受 · 等待 Matrix 更新")}
    if state == "matrix_verified" {return A.t("Matrix membership verified", "Matrix 成员关系已验证")}
    if state == "membership_recheck_required" {return A.t("Matrix membership needs a fresh check", "Matrix 成员关系需要重新检查")}
    if state == "qualified" {return A.t("Runtime qualification recorded", "已记录运行环境资格检查")}
    if state == "qualification_stale" {return A.t("Runtime qualification is stale", "运行环境资格检查已失效")}
    if state == "failed" {return A.t("Stage failed", "此阶段失败")}
    if state == "outcome_unknown" {return A.t("Result unknown · recovery required", "结果未知 · 需要恢复")}
    if state == "fenced" || state == "cleanup_pending" {return A.t("New work blocked · cleanup pending", "已阻止新任务 · 等待清理")}
    if state == "stopped" || state == "cleaned" {return A.t("Stop or cleanup recorded", "已记录停止或清理结果")}
    return A.t("Recorded state · ", "已记录状态 · ") + state
}
A.agent_execution = fn(status){let {execution=nil}=status return execution}
A.agent_execution_text = fn(stage){
    if stage == nil {return A.t("No shared text-execution observation in this response", "此响应暂无共享文本执行观测")}
    if !stage.supported || stage.record == nil {return A.agent_stage_text(stage)}
    let state=stage.record.state
    if state == "pending" {return A.t("Waiting for a text-execution process", "等待文本执行进程")}
    if state == "issued" {return A.t("Process start issued", "已发出进程启动请求")}
    if state == "qualified" {return A.t("Text-execution process qualified at observation", "观测时文本执行进程已通过检查")}
    return A.agent_stage_text(stage)
}
A.control_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "shared-run-control-v1" {return true}}
    return false
}
A.control_reason = fn(code){
    if code == nil {return ""}
    if code == "management_agent_control_local_stop_pending" {return A.t("This device has recorded the pause. Server confirmation is pending.","本机已记录暂停，等待服务器确认。")}
    if code == "role_required" || code == "shared_run_control_forbidden" {return A.t("Only the project manager can enable automatic replies. The resource owner can pause execution.","只有项目经理可以启用自动回复。资源所有者可以暂停执行。")}
    if code == "intake_disabled" || code == "shared_durable_intake_unavailable" {return A.t("Automatic message intake is disabled on this server. You can still pause an existing assignment.","此服务器已关闭自动消息接收，已有分配仍可暂停。")}
    if code == "assignment_authority_changed" || code == "shared_assignment_authority_changed" {return A.t("The assignment or project authorization changed. Refresh its status before enabling replies.","分配或项目授权已变化，请刷新状态后再启用回复。")}
    if code == "shared_control_revision_changed" {return A.t("Another person changed this setting. Recover the saved request, then refresh to see the latest setting.","其他人已更改此设置。请恢复已保存的请求，再刷新查看最新设置。")}
    if code == "already_running" {return ""}
    if code == "shared_run_control_unavailable" || code == "shared_intake_disabled" {return A.t("Automatic reply controls are not supported by this client and server combination.","当前客户端与服务器组合尚不支持自动回复控制。")}
    return A.error_text(code)
}
A.control_mode_text = fn(mode){
    if mode == "running" {return A.t("Automatic replies enabled", "已启用自动回复")}
    if mode == "paused" {return A.t("Automatic replies paused", "已暂停自动回复")}
    return A.t("Automatic replies not enabled", "尚未启用自动回复")
}
A.open_agent_control = fn(assignment,name){
    if H.busy || !A.control_enabled() {return}
    H.control_assignment=assignment H.control_agent_name=name H.agent_control=nil H.page="agent_control"
    A.request("hagency.agents.control.readiness",{assignmentId:assignment},fn(data){
        if data.readiness.control.assignmentId != H.control_assignment {H.notice=A.t("The reply setting belongs to another assignment. Refresh to check again.","回复设置属于其他分配，请刷新后重试。") return}
        H.agent_control=data
    })
}
A.set_agent_control = fn(mode){
    if H.busy || H.command != nil || H.agent_control == nil || !A.control_enabled() {return}
    let r=H.agent_control.readiness
    if r.control.assignmentId != H.control_assignment {return}
    if mode == "running" {if !r.canRun {return}} else if mode == "paused" {if !r.canStop {return}} else {return}
    A.submit("hagency.agents.control.set",{assignmentId:H.control_assignment expectedRevision:r.control.revision mode:mode})
}
A.open_agent_status = fn(id){
    if H.busy || !A.agents_enabled() {return}
    H.agent_id=id H.agent_status=nil H.page="agent_status"
    A.request("hagency.agents.status",{id:id},fn(data){
        if data.protocol != "hagency-management-v1" || data.agentRequest.id != H.agent_id {H.notice=A.t("The status response did not match this agent. Refresh to check again.", "状态响应与此 Agent 不匹配，请刷新后重新检查。") return}
        H.agent_status=data H.agent_selected=data.agentRequest H.agent_project_id=data.agentRequest.projectId
    })
}
A.work_enabled = fn(){
    if H.session == nil {return false}
    let {features=nil}=H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "shared-work-history-v1" {return true}}
    return false
}
A.open_work_list = fn(project,after,page){
    if H.busy {return}
    H.work_list=nil H.work_list_project=project H.work_list_after=after H.work_list_page=page H.page="agent_work_list"
    if !A.work_enabled() {A.redraw() return}
    A.request("hagency.agents.work.list",{projectId:project after:after limit:16},fn(data){
        if data.protocol != "hagency-management-v1" {H.notice=A.agent_reason("management_agent_work_invalid") return}
        H.work_list=data
    })
}
A.open_work_entry = fn(row){
    if H.busy {return}
    H.work_context=row H.work_from_list=true
    A.open_agent_work(row.requestId,nil,1)
}
A.open_agent_work = fn(id, after, page){
    if H.busy {return}
    H.agent_id=id H.agent_work=nil H.work_after=after H.work_page=page H.page="agent_work"
    if !A.work_enabled() {A.redraw() return}
    A.request("hagency.agents.work",{id:id after:after limit:16},fn(data){
        if data.protocol != "hagency-management-v1" || data.requestId != H.agent_id {H.notice=A.t("The history response did not match this request. Refresh to check again.","历史响应与此申请不匹配，请刷新后重新检查。") return}
        H.agent_work=data
    })
}
A.work_state = fn(state){
    if state == "queued" {return A.t("Queued", "已排队")}
    if state == "acknowledged" {return A.t("Received by executor", "执行设备已接收")}
    if state == "started" {return A.t("Start recorded", "已记录开始执行")}
    if state == "completed" {return A.t("Response completed", "响应已完成")}
    if state == "failed" {return A.t("Execution failed", "执行失败")}
    if state == "unknown" {return A.t("Execution result unknown", "执行结果未知")}
    if state == "cancelled" {return A.t("Cancelled", "已取消")}
    return A.t("Recorded state · ","已记录状态 · ")+state
}
A.work_reply = fn(state){
    if state == nil {return A.t("No delivery record", "暂无发送记录")}
    if state == "pending" {return A.t("Awaiting Matrix reply", "等待发送 Matrix 回复")}
    if state == "issued" {return A.t("Reply send issued", "已发起回复发送")}
    if state == "sent" {return A.t("Reply sent", "回复已发送")}
    if state == "blocked" {return A.t("Reply blocked", "回复被阻止")}
    if state == "unknown" {return A.t("Reply delivery unknown", "回复发送结果未知")}
    return A.t("Recorded state · ","已记录状态 · ")+state
}
A.work_time = fn(value){if value == nil {return A.t("Not recorded", "尚未记录")} return value}
A.work_name = fn(){
    if H.work_from_list && H.work_context != nil && H.work_context.requestId == H.agent_id {return H.work_context.agentName+" · "+H.work_context.projectName}
    if H.agent_selected != nil && H.agent_selected.id == H.agent_id {return H.agent_selected.definition.name}
    return H.agent_id
}
A.work_back = fn(){
    if H.busy {return}
    if H.work_from_list || !A.agents_enabled() {A.open_work_list(H.work_list_project,H.work_list_after,H.work_list_page)} else {A.open_agent_status(H.agent_id)}
}
A.agent_reason = fn(code){
    if code == nil {return ""}
    if code == "agent_admission_unavailable" {return A.t("Agent requests are not enabled on this server.", "此服务器尚未启用 Agent 申请。")}
    if code == "project_manager_required" {return A.t("Only this project's manager can submit or cancel its agent request.", "只有此项目经理可以提交或取消 Agent 申请。")}
    if code == "assigned_project_administrator_required" {return A.t("Only the project manager can approve or reject this request.", "只有项目经理可以批准或拒绝此申请。")}
    if code == "agent_request_closed" || code == "agent_request_expired" {return A.t("This request is closed or expired. Refresh its latest result.", "此申请已结束或过期，请刷新查看最新结果。")}
    if code == "agent_request_binding_changed" {return A.t("The project reservation or setup changed. Review the current project before requesting an agent again.", "项目预留或设置已变化，请核对当前项目后再申请 Agent。")}
    if code == "agent_offer_unavailable" {return A.t("The requested capability or token amount is outside the project's confirmed reservation.", "申请的能力或 token 数量超出了项目已确认的预留范围。")}
    if code == "invalid_managed_agent_definition" {return A.t("Check the agent name, description and capability. Agents start with chat permissions; the resource owner can enable tools in Agent execution permissions.", "请检查 Agent 名称、描述和能力。Agent 初始仅有聊天权限；资源所有者可在 Agent 执行权限中启用工具。")}
    if code == "agent_request_capacity" {return A.t("This account has reached its saved agent-request limit.", "此账号已达到 Agent 申请记录数量上限。")}
    if code == "managed_agent_execution_unavailable" {return A.t("Approval is recorded. Executor setup is a separate step; this page does not confirm a running agent.", "审批结果已记录。执行设备设置是独立步骤；此页面不能确认 Agent 已运行。")}
    if code == "shared_execution_unavailable" {return A.t("Work history is not enabled on this server. Refresh the account status after the server is updated.","此服务器尚未启用任务历史。服务器更新后，请刷新账号状态。")}
    if code == "management_agent_cleanup_invalid" {return A.t("Cleanup status could not be verified. Refresh or recover the original request; no refund is assumed.", "无法验证清理状态，请刷新或恢复原申请；不会据此认定额度已退回。")}
    if code == "management_agent_work_invalid" {return A.t("Work history could not be verified. Refresh this page; no work was submitted.","无法验证任务历史，请刷新此页；此次操作未提交任何任务。")}
    if code == "agent_request_not_found" {return A.t("This request is unavailable to your current project role. Refresh the project or contact its manager.","当前项目角色无法访问此申请，请刷新项目或联系项目经理。")}
    if code == "management_agent_status_invalid" {return A.t("Agent status could not be verified. Refresh to read current server records.", "无法验证 Agent 状态，请刷新以读取当前服务器记录。")}
    if code == "management_agent_reply_invalid" {return A.t("The server reply could not be verified. Recover the original request before trying again.", "无法验证服务器响应，请先恢复原始申请再重试。")}
    return A.setup_reason(code)
}
A.topup_service=fn(service){return service=="hagency.agents.topups.request" || service=="hagency.agents.topups.decide" || service=="hagency.agents.topups.cancel"}
A.topup_operation=fn(op){return op=="agent_top_up_request" || op=="agent_top_up_decide" || op=="agent_top_up_cancel"}
A.budget_idle=fn(){if H.busy || H.command!=nil{return false} for row in H.saved_commands{if A.topup_operation(row.operation) && row.reply==nil{return false}} return true}
A.budget_reason=fn(code){
    if code=="project_manager_required" {return A.t("Only this Agent's manager can request additional tokens.","只有此 Agent 的管理者可以申请追加额度。")}
    if code=="agent_budget_issuance_unavailable" {return A.t("New top-ups are not enabled on this server. Existing requests can still be read or recovered.","此服务器尚未启用新额度追加，仍可查看或恢复已有申请。")}
    if code=="agent_budget_exceeds_pool" {return A.t("The requested increase exceeds this pool's available capacity.","申请追加的额度超出此资源池的可用容量。")}
    if code=="pool_resource_owner_required" {return A.t("Only this resource owner can approve the increase.","只有此资源的 owner 可以批准追加额度。")}
    if code=="agent_budget_exceeds_project" {return A.t("The requested increase exceeds the project's uncommitted reservation. Ask the resource owner to review project capacity.","申请增加的额度超出项目尚未承诺的预留量，请资源所有者核对项目容量。")}
    if code=="agent_topup_pending" {return A.t("This agent already has an unresolved top-up. Open its existing request before making another.","此 Agent 已有尚未解决的额度追加，请先打开已有申请。")}
    if code=="agent_topup_closed" {return A.t("This top-up is closed or already applied. Refresh its current result.","此额度追加已结束或已应用，请刷新查看当前结果。")}
    if code=="agent_budget_changed" || code=="management_revision_changed" {return A.t("The budget or resource authority changed. Refresh and review the current amounts.","预算或资源权限已变化，请刷新并核对当前额度。")}
    if code=="invalid_agent_budget" || code=="invalid_management_arguments" {return A.t("Enter a positive whole token amount and a reason for the increase.","请输入大于零的 token 整数及追加原因。")}
    if code=="management_agent_budget_invalid" {return A.t("The budget reply could not be verified. Recover the saved request before submitting another.","无法验证预算响应，请先恢复已保存的申请，再提交其他申请。")}
    if code=="agent_budget_original_changed" || code=="agent_budget_authority_changed" {return A.t("The original agent reservation is no longer eligible. Refresh the agent's current status.","原 Agent 预留已不再符合条件，请刷新 Agent 当前状态。")}
    return A.agent_reason(code)
}
A.topup_not_applied=fn(service,code){return A.topup_service(service) && (code=="invalid_identifier" || code=="invalid_management_arguments" || code=="invalid_management_payload" || code=="invalid_agent_budget" || code=="invalid_management_revision" || code=="project_manager_required" || code=="assigned_project_administrator_required" || code=="management_revision_changed" || code=="agent_topup_pending" || code=="agent_topup_capacity" || code=="agent_topup_closed" || code=="agent_budget_changed" || code=="agent_budget_exceeds_project" || code=="agent_budget_exceeds_pool" || code=="pool_resource_owner_required" || code=="agent_budget_issuance_unavailable")}
A.topup_state=fn(state){
    if state=="pending" {return A.t("Awaiting resource owner approval", "等待资源 owner 批准")}
    if state=="approved" {return A.t("Authorized", "已授权")}
    if state=="declined" {return A.t("Declined", "已拒绝")}
    if state=="cancelled" {return A.t("Cancelled", "已取消")}
    if state=="cancellation_requested" {return A.t("Cancellation requested", "已申请取消")}
    if state=="expired" {return A.t("Expired", "已过期")}
    return A.t("Unrecognized state · refresh", "未知状态 · 请刷新")
}
A.topup_native_state=fn(state){
    if state=="applied" {return A.t("Available on execution device", "执行设备已到账")}
    if state=="rejected" {return A.t("Not applied", "未应用")}
    if state=="not_delivered" {return A.t("Not delivered to this device", "尚未送达执行设备")}
    return A.t("Application not yet confirmed", "尚未确认应用结果")
}
A.can_owner_fund=fn(value){let {canOwnerFund=false canOwnerFundDirect=false}=value return canOwnerFund && canOwnerFundDirect}
A.owner_funding_upgrade=fn(value){let {canOwnerFund=false canOwnerFundDirect=false}=value return canOwnerFund && !canOwnerFundDirect}
A.can_topup=fn(value){return A.can_owner_fund(value) || (value.canRequest && !A.owner_funding_upgrade(value))}
A.owner_funded=fn(value){let {ownerFunded=false}=value return ownerFunded}
A.open_agent_budget=fn(id,name,after,page){
    if H.busy{return} H.budget_request_id=id H.budget_agent_name=name H.budget_after=after H.budget_page=page H.agent_budget=nil H.budget_topups=nil H.budget_confirmation=nil H.budget_mode="" H.page="agent_budget"
    A.request("hagency.agents.budget.get",{id:id},fn(data){
        if data.supported && (data.budget==nil || data.budget.requestId!=id){H.notice=A.budget_reason("management_agent_budget_invalid") return}
        H.agent_budget=data
        if data.supported{A.request("hagency.agents.topups.list",{id:id after:after limit:16},fn(rows){H.budget_topups=rows})}
    })
}
A.open_topup=fn(id){if H.busy{return} H.budget_topup_id=id H.budget_topup=nil H.budget_confirmation=nil H.budget_details=false H.page="agent_topup" A.request("hagency.agents.topups.get",{id:id},fn(data){if data.topUp.id!=id{H.notice=A.budget_reason("management_agent_budget_invalid") return} H.budget_topup=data H.budget_request_id=data.topUp.requestId})}
A.begin_topup=fn(){if !A.budget_idle() || H.agent_budget==nil || !H.agent_budget.supported || !A.can_topup(H.agent_budget.budget){return} H.budget_mode="edit" H.budget_tokens="" H.budget_purpose="" H.budget_confirmation=nil A.redraw()}
A.review_topup=fn(){
    if !A.budget_idle() || H.agent_budget==nil || !H.agent_budget.supported || !A.can_topup(H.agent_budget.budget){return}
    let b=H.agent_budget.budget
    let n=H.budget_tokens.trim().to_f64()
    if !(n>=1 && n<=9007199254740991) || floor(n)!=n || (H.budget_purpose.trim()=="" && !A.can_owner_fund(b)) {H.notice=A.budget_reason("invalid_agent_budget") A.redraw() return}
    let purpose=if H.budget_purpose.trim()==""{A.t("Owner capacity increase","Owner 追加容量")}else{H.budget_purpose.trim()}
    H.budget_confirmation={service:"hagency.agents.topups.request" args:{requestId:b.requestId expectedRequestRevision:b.requestRevision expectedAssignmentGeneration:b.assignmentGeneration expectedBudgetRevision:b.budgetRevision expectedBudgetDigest:b.budgetDigest addTokens:n purpose:purpose} title:A.t("Request this budget increase?","申请增加此额度？")}
    if A.can_owner_fund(b){H.budget_confirmation.args.ownerFunded=true H.budget_confirmation.args.approveImmediately=true H.budget_confirmation.title=A.t("Fund this Agent with additional capacity?","为此 Agent 追加专用容量？")}
    H.budget_mode="review" H.notice="" A.redraw()
}
A.review_topup_action=fn(action){
    if !A.budget_idle() || H.budget_topup==nil{return} let t=H.budget_topup.topUp
    if action=="cancel" && t.canCancel{H.budget_confirmation={service:"hagency.agents.topups.cancel" args:{topUpId:t.id expectedRevision:t.revision} title:A.t("Cancel this top-up?","取消此额度追加？")}}
    else if (action=="approve" || action=="reject") && t.canDecide{H.budget_confirmation={service:"hagency.agents.topups.decide" args:{topUpId:t.id expectedRevision:t.revision expectedAuthorityRevision:t.authorityRevision approve:action=="approve"} title:if action=="approve"{A.t("Approve this top-up?","批准此额度追加？")}else{A.t("Reject this top-up?","拒绝此额度追加？")}}}else{return} A.redraw()
}
A.topup_review_hint=fn(){
    let c=H.budget_confirmation
    if c == nil {return ""}
    if c.service == "hagency.agents.topups.cancel" {return A.t("Cancellation may race application and does not prove tokens were returned. Current authority and budget revisions are checked when submitted.","取消可能与额度应用同时发生，不代表 token 已退回。提交时会核对当前权限及预算版本。")}
    if c.args.approve && A.owner_funded(H.budget_topup.topUp) {return A.t("Approve this dedicated capacity increase from your resource budget. It can exceed the published pool allocation, but the device must confirm it fits the resource and account limits before use.","批准从你的资源预算中为此 Agent 追加专用容量。金额可以超出已发布的资源池额度，但必须由执行设备确认资源和账户总预算足够后才能使用。")}
    if c.args.approve {return A.t("Approval authorizes this increase. The execution device must confirm application before it can be used. Current resource authority and budget are checked when submitted.","批准后允许追加此额度，执行设备确认应用后才能使用。提交时会核对当前资源权限与预算。")}
    return A.t("This rejects the pending increase. The agent's existing budget is unchanged.","此操作拒绝待审批的追加申请，不改变 Agent 的现有预算。")
}
A.topup_application_hint=fn(state){
    if state == "applied" {return A.t("Capacity received. This does not confirm that a task is running. Check the task status and errors in the Agent chat.","额度已到账，不代表任务已开始运行。请在 Agent 聊天中查看任务状态和错误提示。")}
    return A.t("The execution device must apply the increase and check current usage and resource access before spending it.","执行设备需要先应用追加额度，并核对当前用量和资源权限，才能使用这部分预算。")
}
A.apply_topup=fn(){if !A.budget_idle() || H.budget_confirmation==nil{return} let c=H.budget_confirmation H.budget_confirmation=nil A.submit(c.service,c.args)}
A.topup_received=fn(data){H.budget_topup=data H.budget_topup_id=data.topUp.id H.budget_request_id=data.topUp.requestId H.budget_confirmation=nil H.budget_mode="" H.agent_budget=nil H.page="agent_topup"}
A.agent_not_applied = fn(service, code){
    if service != "hagency.agents.request" && service != "hagency.agents.decide" && service != "hagency.agents.cancel" && service != "hagency.agents.revoke" {return false}
    return code == "invalid_managed_agent_definition" || code == "project_manager_required" || code == "assigned_project_administrator_required" || code == "agent_request_closed" || code == "agent_request_binding_changed" || code == "agent_offer_unavailable" || code == "agent_request_capacity" || code == "management_revision_changed" || code == "management_receipt_capacity" || code == "project_administrator_required" || code == "matrix_setup_required" || code == "matrix_verification_required" || code == "project_setup_changed" || code == "project_administrator_changed" || code == "live_reservation_required" || code == "project_disabled" || code == "project_matrix_not_ready" || code == "project_membership_pending" || code == "project_private_room_required" || code == "project_matrix_marker_mismatch" || code == "project_matrix_proof_missing" || code == "room_administration_denied"
}
A.restore_agent_draft = fn(draft){
    if !draft.is_object() {return false}
    let {projectId=nil,name=nil,description=nil,capability=nil,tokens=nil}=draft
    if !projectId.is_string() || !name.is_string() || !description.is_string() || !capability.is_string() || !tokens.is_string() {return false}
    H.agent_draft={projectId:projectId name:name description:description capability:capability tokens:tokens}
    return true
}
A.clear_agent_draft = fn(row){
    if H.agent_draft.projectId == row.projectId && H.agent_draft.name.trim() == row.definition.name && H.agent_draft.description.trim() == row.definition.description && H.agent_draft.capability == row.definition.capability && H.agent_draft.tokens.trim().to_f64() == row.requestedTokens {
        H.agent_draft={projectId:"" name:"" description:"" capability:"" tokens:"1000"}
    }
}
A.load_agents = fn(after){
    if A.pool_enabled(){A.request("hagency.pools.agents.list",{after:after needsMyAction:H.page=="inbox" && H.needs_action},fn(v){H.pool_agents=v.items H.pool_agent_after=v.nextAfter H.agents=[] H.ux.inboxReady=true H.ux.agentListReady=true}) return}
    H.ux.agentListReady=false
    let args={after:after needsMyAction:false}
    if H.page == "inbox" {args.needsMyAction=H.needs_action H.ux.agentCursor=after H.ux.inboxReady=false H.ux.inboxError=false H.agents=[]} else {args.projectId=H.agent_project_id}
    A.request("hagency.agents.list",args,fn(data){H.agents=data.items H.agent_after=data.nextAfter H.ux.agentListReady=true if H.page=="inbox"{H.ux.inboxReady=true}})
}
A.open_project_agents = fn(id){
    if H.busy || !A.agents_enabled() {return}
    H.agent_project_id=id H.agent_readiness=nil H.agents=[] H.agent_after=nil H.agent_selected=nil H.agent_id="" H.agent_confirmation="" H.page="agents"
    A.request("hagency.agents.readiness",{projectId:id},fn(data){
        if data.readiness.projectId != id {H.notice=A.t("The project changed. Open it again.", "项目已变化，请重新打开。") return}
        H.agent_readiness=data.readiness
        if data.readiness.canViewRequests {A.load_agents(nil)}
    })
}
A.open_agent = fn(id){
    if H.busy || !A.agents_enabled() {return}
    if H.page=="inbox" {H.ux.origin="inbox"} else if H.page=="overview" {H.ux.origin="overview"}
    H.agent_id=id H.agent_selected=nil H.agent_confirmation="" H.page="agent_action"
    A.request("hagency.agents.get",{id:id},fn(data){
        if data.agentRequest.id != id {H.notice=A.t("The request changed. Refresh its latest result.", "申请已变化，请刷新查看最新结果。") return}
        H.agent_selected=data.agentRequest H.agent_project_id=data.agentRequest.projectId
    })
}
A.agent_received = fn(row){H.agent_selected=row H.agent_id=row.id H.agent_project_id=row.projectId H.page="agent_action" H.agent_confirmation="" H.agent_readiness=nil}
A.begin_agent = fn(){
    if A.must_reopen() || H.needs_signin{return}
    if H.busy || H.command != nil || H.agent_readiness == nil || !H.agent_readiness.canRequest || H.agent_readiness.requestContext == nil {return}
    if H.agent_draft.projectId != H.agent_project_id {H.agent_draft={projectId:H.agent_project_id name:"" description:"" capability:"" tokens:"" + min(1000,H.agent_readiness.requestContext.requestedTokenLimit)}}
    H.agent_review=false H.page="agent_wizard" A.save() A.redraw()
}
A.agent_field = fn(field,value){
    if H.busy || H.command != nil {return}
    if field == "name" {H.agent_draft.name=value}
    if field == "description" {H.agent_draft.description=value}
    if field == "capability" {H.agent_draft.capability=value}
    if field == "tokens" {H.agent_draft.tokens=value}
    H.agent_review=false A.save() if field == "capability" {A.redraw()}
}
A.review_agent = fn(){
    if H.busy || H.command != nil || H.agent_readiness == nil || !H.agent_readiness.canRequest || H.agent_readiness.requestContext == nil {return}
    let d=H.agent_draft let c=H.agent_readiness.requestContext let tokens=d.tokens.trim().to_f64()
    let supported=false for capability in c.capabilities {if capability == d.capability {supported=true}}
    if d.name.trim() == "" || !supported || !(tokens >= 1 && tokens <= c.requestedTokenLimit && tokens <= 9007199254740991) || floor(tokens) != tokens {
        H.notice=A.t("Enter an agent name, select a capability and request a positive whole token amount within the project's reservation limit.", "请输入 Agent 名称、选择能力，并填写项目预留上限内大于零的 token 整数。") A.redraw() return
    }
    H.agent_review=true H.notice="" A.save() A.redraw()
}
A.submit_agent = fn(){
    if !H.agent_review || H.agent_readiness == nil || !H.agent_readiness.canRequest || H.agent_readiness.requestContext == nil {return}
    let c=H.agent_readiness.requestContext let d=H.agent_draft
    A.submit("hagency.agents.request",{projectId:H.agent_project_id request:{expectedSetupRevision:c.setupRevision expectedSetupBindingRevision:c.setupBindingRevision expectedAuthorityRevision:c.authorityRevision expectedAllocationRevision:c.allocationRevision definition:{name:d.name.trim() description:d.description.trim() capability:d.capability toolMode:"none"} requestedTokens:d.tokens.trim().to_f64()}})
}
A.decide_agent = fn(approve){
    if H.agent_selected == nil || H.command != nil {return}
    let r=H.agent_selected
    if (approve && !r.canApprove) || (!approve && !r.canReject) {return}
    A.submit("hagency.agents.decide",{requestId:r.id expectedRevision:r.revision expectedAuthorityRevision:r.authorityRevision approve:approve})
}
A.cancel_agent = fn(){
    if H.agent_selected == nil || H.command != nil || !H.agent_selected.canCancel {return}
    A.submit("hagency.agents.cancel",{requestId:H.agent_selected.id expectedRevision:H.agent_selected.revision})
}
A.setup_enabled = fn(){
    if H.session == nil {return false}
    let {features = nil} = H.session
    if !features.is_object() && !features.is_array() {return false}
    for feature in features {if feature == "project-setup-v1" {return true}}
    return false
}
A.setup_allocation = fn(){
    if H.setup_progress == nil {return nil}
    let {eligibleAllocation = nil} = H.setup_progress.readiness
    return eligibleAllocation
}
A.setup_idle = fn(){return A.setup_enabled() && !H.busy && H.command == nil && H.setup_progress != nil && H.setup_progress.pendingCommands.len() == 0}
A.setup_can_begin = fn(){return A.setup_idle() && H.setup_progress.readiness.canBegin && H.setup_progress.readiness.administrator != nil && A.setup_allocation() != nil}
A.setup_can_continue = fn(){
    if !A.setup_idle() {return false}
    let p = H.setup_progress
    return p.localHistory && p.readiness.setup != nil && p.readiness.setup.state != "cancelled" && p.readiness.canConfirm && p.readiness.capacityReady
}
A.setup_can_rebase = fn(){return A.setup_idle() && H.setup_progress.readiness.canRebase && H.setup_progress.readiness.setup != nil && H.setup_progress.readiness.administrator != nil && A.setup_allocation() != nil}
A.setup_stage_unknown = fn(stage){return stage != nil && stage.state == "outcome_unknown"}
A.setup_stage_text = fn(stage){
    if stage == nil {return A.t("No creation history on this device", "此设备没有创建记录")}
    if stage.state == "not_issued" {return A.t("Not started on this device", "此设备尚未开始创建")}
    if stage.state == "outcome_unknown" {return A.t("Reply missing · recover the original request", "响应未收到 · 恢复原始请求")}
    if stage.state == "room_returned" {return A.t("Room ID received", "已收到房间 ID")}
    return A.t("Refresh to check progress", "请刷新查看进度")
}
A.setup_reason = fn(code){
    if code == "project_administrator_assignment_retired" || code == "project_manager_is_administrator" {return A.t("The project manager now handles project administration. Dismiss this retired assignment request and refresh project setup.", "项目管理权限现已归项目经理。请移除此已停用的管理员指定请求，并刷新项目设置。")}
    if code == nil {return ""}
    if code == "project_unavailable" {return A.t("This project is no longer approved. Saved setup history and permitted cleanup remain available.", "此项目已不再获批，仍可查看设置历史并执行获准的清理操作。")}
    if code == "project_administrator_required" {return A.t("Project manager authority is not available. Refresh project status or ask the server administrator to update the server.", "项目经理权限尚未就绪。请刷新项目状态，或联系服务器管理员更新服务器。")}
    if code == "project_administrator_changed" {return A.t("Project authority changed. Update setup requirements to use the project manager before continuing with the original rooms.", "项目权限已变化。请更新设置条件，使用项目经理权限后继续原始房间设置。")}
    if code == "live_reservation_required" {return A.t("A current verified resource reservation is required. Approval of the project request alone does not reserve capacity.", "需要当前有效且已验证的资源预留。批准项目申请本身不会预留容量。")}
    if code == "matrix_setup_required" {return A.t("The project manager can begin setup after its reservation is ready.", "资源预留就绪后，项目经理可开始设置。")}
    if code == "matrix_verification_required" {return A.t("Continue the original setup and verify the project manager and service account in both rooms.", "请继续原始设置，验证项目经理与服务账号在两个房间中的权限。")}
    if code == "project_setup_cancelled" {return A.t("Setup is cancelled. Existing rooms and resource holds remain; update requirements to resume when permitted.", "设置已取消，现有房间与资源预留仍保留。获准后可更新条件并恢复。")}
    if code == "project_membership_pending" {return A.t("The project manager and service account must be joined. Check their membership, then verify again.", "项目经理与服务账号需加入房间。请检查成员状态后重新验证。")}
    if code == "administrator_invitation_requires_review" {return A.t("Project manager membership needs review. Resolve membership in Matrix, then check again.", "项目经理成员状态需要核查。请在 Matrix 中处理后重新检查。")}
    if code == "space_creation_outcome_unknown" || code == "room_creation_outcome_unknown" || code == "setup_recovery_candidate_required" {return A.t("The creation reply was interrupted. Recover the original marked room; an existing room ID may help locate it.", "创建响应中断。请恢复带有原始标记的房间；可提供已有房间 ID 帮助定位。")}
    if code == "local_setup_history_required" {return A.t("Use the original device that began setup. This device cannot reconstruct authority to create replacement rooms.", "请使用最初开始设置的设备。此设备不能重建创建替代房间的权限。")}
    if code == "local_setup_command_pending" {return A.t("Recover the saved request below before starting another operation.", "请先恢复下方保存的请求，再执行其他操作。")}
    if code == "project_setup_allocation_required" {return A.t("This older request did not record an exact reservation. Recover its original result; do not replace an uncertain request.", "此旧请求未记录确切的资源预留。请恢复其原始结果，不要替换结果不明的请求。")}
    if code == "setup_command_not_terminal" || code == "setup_receipt_missing" {return A.t("This result is not confirmed. Keep the original request and refresh its status.", "此结果尚未确认，请保留原始请求并刷新状态。")}
    if code == "project_matrix_link_conflict" || code == "project_matrix_link_immutable" || code == "project_matrix_proof_conflict" || code == "project_matrix_marker_mismatch" {return A.t("The original room identity or links conflict. Review the existing Matrix rooms; setup will not overwrite them.", "原始房间身份或链接存在冲突，请核查已有 Matrix 房间。设置不会覆盖这些信息。")}
    return A.error_text(code)
}
A.setup_received = fn(data){
    if H.project_selected == nil || data.readiness.projectId != H.project_selected.id {H.notice=A.t("The project changed. Open its latest setup again.", "项目已变化，请重新打开最新设置。") return}
    H.setup_progress=data H.setup_recover_hint=false H.confirm="" H.setup_confirmation=nil
    H.setup_admin=if data.readiness.administrator != nil {data.readiness.administrator.mxid} else {""}
}
A.load_project_setup = fn(){
    if H.project_selected == nil || !A.setup_enabled() {return}
    A.request("hagency.projects.setup.progress", {projectId:H.project_selected.id}, A.setup_received)
}
A.open_project_setup = fn(id){
    if H.busy || !A.setup_enabled() {return}
    H.setup_progress=nil H.setup_confirmation=nil H.setup_recover_hint=false H.setup_space="" H.setup_room="" H.confirm=""
    A.request("hagency.projects.get", {id:id}, fn(data){
        H.project_selected=data.project H.connection_project=nil H.page="project_setup" A.load_project_setup()
    })
}
A.setup_prepare = fn(action, command_id){
    if H.busy || H.setup_progress == nil || H.project_selected == nil || !A.setup_enabled() {return}
    let p=H.setup_progress
    let r=p.readiness
    let args={projectId:r.projectId}
    let service=""
    let title=""
    let detail=""
    if action == "begin" && A.setup_can_begin() {
        let allocation=A.setup_allocation()
        service="hagency.projects.setup.begin"
        args={projectId:r.projectId allocationId:allocation.id expectedProjectRevision:allocation.projectRevision expectedAllocationRevision:allocation.revision expectedAuthorityRevision:r.administrator.revision}
        title=A.t("Begin project setup?", "开始项目设置吗？")
        detail=A.t("Save this reservation and project manager for setup. Room creation happens when you continue.", "为设置保存此次资源预留与项目经理。继续后将创建房间。")
    } else if action == "continue" && A.setup_can_continue() {
        service="hagency.projects.setup.continue"
        if A.setup_stage_unknown(p.space) && H.setup_space.trim() != "" {args.spaceId=H.setup_space.trim()}
        if A.setup_stage_unknown(p.room) && H.setup_room.trim() != "" {args.roomId=H.setup_room.trim()}
        title=A.t("Continue the original setup?", "继续原始设置吗？")
        detail=A.t("Check saved rooms, continue unfinished creation and verify project manager access and room links. Recover uncertain requests using their saved history.", "检查已保存的房间，继续未完成的创建，并验证项目经理权限与房间链接。通过保存的历史恢复结果不明的请求。")
    } else if action == "cancel" && A.setup_idle() && r.canCancel && r.setup != nil {
        service="hagency.projects.setup.cancel"
        args={projectId:r.projectId setupId:r.setup.id expectedRevision:r.setup.revision}
        title=A.t("Cancel project setup?", "取消项目设置吗？")
        detail=A.t("This stops later setup work. Existing or in-flight rooms and reserved capacity remain; cancellation does not delete rooms or refund capacity.", "此操作停止后续设置。已有或正在创建的房间与资源预留仍保留；取消不会删除房间或退还容量。")
    } else if action == "rebase" && A.setup_can_rebase() {
        let allocation=A.setup_allocation()
        service="hagency.projects.setup.rebase"
        args={projectId:r.projectId setupId:r.setup.id expectedRevision:r.setup.revision allocationId:allocation.id expectedProjectRevision:allocation.projectRevision expectedAllocationRevision:allocation.revision expectedAuthorityRevision:r.administrator.revision}
        title=A.t("Update setup requirements?", "更新设置条件吗？")
        detail=A.t("Use the current verified reservation and project manager while preserving the original rooms and creation history.", "使用当前已验证的资源预留与项目经理，并保留原始房间及创建历史。")
    } else if action == "retry" {
        let found=false
        for id in p.pendingCommands {if id == command_id {found=true}}
        if !found {return}
        service="hagency.projects.setup.retry" args={commandId:command_id}
        title=A.t("Recover the original request?", "恢复原始请求吗？")
        detail=A.t("Check the saved request and its latest result using the same identifier. Your current operation permission is checked again.", "使用相同标识检查已保存的请求及最新结果，并重新核对当前操作权限。")
    } else if action == "acknowledge" {
        let found=false
        for row in p.failedCommands {if row.commandId == command_id {found=true}}
        if !found {return}
        service="hagency.projects.setup.acknowledge" args={commandId:command_id}
        title=A.t("Dismiss the confirmed rejection?", "移除已确认的拒绝结果吗？")
        detail=A.t("Only this terminal rejected request is dismissed. Accepted setup and room creation history stay saved.", "仅移除此已终止的拒绝请求，已接受的设置与房间创建历史仍会保留。")
    }
    if service == "" {return}
    H.setup_confirmation={service:service args:args title:title detail:detail} H.confirm="project_setup" A.redraw()
}
A.setup_apply = fn(){
    if H.busy || H.setup_confirmation == nil {return}
    let confirmation=H.setup_confirmation
    H.setup_progress=nil H.setup_confirmation=nil H.confirm="" H.setup_recover_hint=true
    A.request(confirmation.service, confirmation.args, A.setup_received)
}

A.begin_setup = fn(){
    if H.busy {return}
    H.ux.resourceJourney=true A.save()
    if H.ux.accountId!="" && H.wizard.resource==nil && H.command==nil {A.open_account(H.ux.accountId,nil) return}
    if H.wizard.step == 0 && H.wizard.resource == nil && H.wizard.admission == nil && H.command == nil { A.open_accounts(nil) return }
    H.page = "wizard" H.notice = "" A.redraw()
    if H.wizard.step == 1 || H.wizard.step == 2 { A.load_providers() }
    if H.wizard.admission != nil { A.open_connection(H.wizard.admission.contribution.id) }
}
A.new_resource = fn(){
    if H.busy || H.command != nil {return}
    H.ux.resourceJourney=true H.ux.accountId="" A.save()
    A.open_accounts(nil)
}
A.step = fn(value){ if H.busy || H.command != nil { return } H.wizard.step = value A.save() A.redraw() if value == 1 || value == 2 { A.load_providers() } }
A.account_state = fn(row){
    if row.state == "linked" {return A.t("Recorded resource association", "已记录资源关联")}
    if row.state == "active" {return A.t("Login record ready", "登录记录可用")}
    if row.state == "preparing" {return A.t("Preparation in progress", "正在准备")}
    if row.state == "uncertain" {return A.t("Preparation outcome unknown", "准备结果未确认")}
    if row.state == "retired" {return A.t("Retired", "已停用")}
    return A.t("Unknown", "未知")
}
A.account_kind = fn(row){return if row.kind == "managed_namespace" {A.t("Provider login", "服务商登录")} else {A.t("Resource association", "资源关联")}}
A.account_readiness = fn(row){
    if row.readiness == "subscription" {return A.t("Subscription login observed", "已观测到订阅登录")}
    if row.readiness == "api_key" {return A.t("API-key login observed", "已观测到 API 密钥登录")}
    return A.t("Login status not verified", "登录状态未验证")
}
A.account_models_error = fn(code){
    if code=="provider_connection_required" {return A.t("Sign in to this account before checking its models.","请先登录此账号，再检查其可用模型。")}
    if code=="provider_account_changed" || code=="management_revision_conflict" {return A.t("The account changed. Refresh its details before checking again.","账号已变更，请刷新详情后重新检查。")}
    if code=="provider_identity_unavailable" || code=="provider_login_method_rejected" {return A.t("This account cannot provide a supported Codex subscription catalog.","此账号无法提供受支持的 Codex 订阅模型列表。")}
    if code=="provider_catalog_timeout" || code=="codex_provider_unavailable" || code=="codex_model_catalog_unavailable" {return A.t("Models could not be read from this account. Check its connection and try again.","无法读取此账号的模型，请检查连接后重试。")}
    if code=="native_resume_missing" || code=="native_resume_revoked" || code=="management_access_required" || code=="management_scope_changed" || code=="management_permission_required" {return A.error_text(code)}
    return A.t("Models could not be read from this account. Check its connection and try again.","无法读取此账号的模型，请检查连接后重试。")
}
A.account_can_enroll=fn(){
    if H.account_models==nil {return false}
    let {enrollmentReady=false}=H.account_models
    return enrollmentReady
}
A.choose_account_model = fn(row,model){
    if H.busy || H.command!=nil || H.account_models==nil || H.account_detail==nil || H.account_models.accountId!=row.id || H.account_models.revision!=row.revision || model.sharedReasoning.len()==0 {return}
    let {enrollmentReady=false}=H.account_models
    if !enrollmentReady {H.notice=A.t("Finish device setup before enrolling resources from this account.","请先完成设备设置，再从此账号登记资源。") A.redraw() return}
    H.enrollment_draft={account:{accountId:row.id expectedRevision:row.revision} model:model reasoning:model.sharedDefaultReasoning tokens:"1000000"}
    H.page="account_enrollment" H.notice="" A.redraw()
}
A.enroll_account = fn(){
    if H.busy || H.command!=nil || H.enrollment_draft==nil {return}
    let d=H.enrollment_draft let valid=false
    for effort in d.model.sharedReasoning {if effort==d.reasoning {valid=true}}
    if !valid {H.notice=A.error_text("management_model_unqualified") A.redraw() return}
    let tokens=d.tokens.trim().to_f64()
    if !(tokens>=1 && tokens<=9007199254740991) || floor(tokens)!=tokens {H.notice=A.t("Enter a whole number of tokens greater than zero.","请输入大于零的整数 token 数量。") A.redraw() return}
    A.submit("hagency.accounts.enroll",{account:d.account model:d.model.model reasoning:d.reasoning monthlyTokens:tokens})
}
A.enrollment_tokens_changed=fn(text){
    if H.busy || H.command!=nil || H.enrollment_draft==nil{return}
    H.enrollment_draft.tokens=text
    if H.notice==A.t("Enter a whole number of tokens greater than zero.","请输入大于零的整数 token 数量。") {H.notice="" A.enrollment_hide_notice()}
}
A.enrollment_hide_notice=fn(){ui.notice.set_visible(false)}
A.enrollment_error=fn(code){
    if code=="provider_identity_unavailable" {return A.t("The provider did not return a supported quota-account identity. No resource can be enrolled from this account yet.","模型服务未返回受支持的额度账号标识，暂时无法从此账号登记资源。")}
    if code=="provider_account_changed" {return A.t("The provider account changed during verification. Refresh the account and review the model again.","验证期间模型服务账号发生变化，请刷新账号并重新选择模型。")}
    if code=="provider_connection_required" {return A.t("Sign in to this account before enrolling a resource.","请先登录此账号，再登记资源。")}
    return A.error_text(code)
}
A.load_account_models = fn(row){
    if H.busy || H.command!=nil || H.page!="provider_account" || H.account_id!=row.id || row.kind!="managed_namespace" || row.state!="active" {return}
    H.account_models=nil H.account_models_attempted=true H.account_models_epoch+=1
    let epoch=H.account_models_epoch let id=row.id let revision=row.revision
    H.busy=true H.notice="" A.redraw()
    host.request("hagency.accounts.models",{accountId:id expectedRevision:revision},fn(r){
        if H.account_models_epoch!=epoch {return}
        H.busy=false
        if H.page!="provider_account" || H.account_id!=id || H.account_detail==nil || H.account_detail.account.revision!=revision {A.redraw() return}
        if !r.is_ok {
            H.notice=A.account_models_error(r.error)
            if r.error=="native_resume_missing" || r.error=="native_resume_revoked" {H.needs_signin=true}
        } else {
            let data=r.data
            if data.protocol!="hagency-management-v1" || data.accountId!=id || data.revision!=revision || data.provider.runtime!="codex" || data.provider.connected!=true {
                H.notice=A.t("The model response does not match this account. Refresh and try again.","模型结果与此账号不匹配，请刷新后重试。")
            } else {H.account_models=data H.notice=""}
        }
        A.redraw()
    })
}
A.retire_account = fn(row){
    if H.busy || H.command!=nil || H.page!="provider_account" || H.account_id!=row.id || row.kind!="managed_namespace" || row.state!="active" || row.resourceCount!=0 {return}
    H.account_models=nil H.account_models_attempted=false H.account_models_epoch+=1
    A.submit("hagency.accounts.retire",{accountId:row.id expectedRevision:row.revision})
}
A.retirement_error=fn(code){
    if code=="account_retirement_dependencies" {return A.t("This account is still associated with resources or a sign-in is in progress. Resolve those dependencies before retiring it.","此账号仍有关联资源或正在进行的登录，请先处理这些事项再停用。")}
    if code=="account_retirement_revision_changed" {return A.t("The account changed. Refresh its details before reviewing retirement again.","账号已变更，请刷新详情后重新确认停用。")}
    return A.error_text(code)
}
A.login_account = fn(row){
    if H.busy || row.kind!="managed_namespace" || row.state!="active" || row.resourceCount!=0 {return}
    if H.command!=nil {
        if H.command.service=="hagency.accounts.login" && H.command.args.accountId==row.id {A.retry_command()}
        return
    }
    H.account_models=nil H.account_models_attempted=false
    A.submit("hagency.accounts.login",{accountId:row.id expectedRevision:row.revision})
}
A.review_account_preparation = fn(){
    if H.busy || H.command!=nil {return}
    let page=H.page
    A.request("hagency.onboarding.status",{},fn(data){
        if H.page!=page || H.command!=nil {return}
        let {state=nil}=data
        if state!="active" {A.open_onboarding() return}
        H.page="account_prepare" H.notice="" A.redraw()
    })
}
A.submit_account_preparation = fn(){
    if H.busy || H.command!=nil || H.page!="account_prepare" {return}
    A.submit("hagency.accounts.prepare",{})
}
A.account_prepared = fn(data){
    H.page="provider_account" H.account_id=data.accountId H.account_resource_after=nil H.account_detail=nil H.ux.accountId=data.accountId A.save()
}
A.account_groups = fn(){
    let result={known:[] unconfirmed:[]}
    if H.account_inventory==nil {return result}
    for row in H.account_inventory.accounts {
        let {identityKey=nil}=row
        if identityKey==nil || identityKey=="" {result.unconfirmed.push(row)} else {
            let found=false
            for group in result.known {if group.key==identityKey && group.runtime==row.runtime {
                group.members.push(row) group.resources+=row.resourceCount found=true
            }}
            if !found {result.known.push({key:identityKey runtime:row.runtime members:[row] resources:row.resourceCount})}
        }
    }
    return result
}
A.read_account_page = fn(after,epoch,rows,pages){
    let args={} if after!=nil {args.after=after}
    A.request("hagency.accounts.list",args,fn(data){
        if H.page!="provider_accounts" || H.account_list_epoch!=epoch {return}
        if data.protocol!="hagency-management-v1" || data.account!=nil || data.accounts==nil {
            H.notice=A.t("The account list could not be read. Refresh to try again.","无法读取账号列表，请刷新重试。") return
        }
        for row in data.accounts {
            for previous in rows {if previous.id==row.id {H.notice=A.t("The account list changed. Refresh to try again.","账号列表已变更，请刷新重试。") return}}
            rows.push(row)
        }
        if rows.len()>256 {H.notice=A.t("Too many records to group safely.","记录过多，暂无法完整归组。") return}
        if data.nextAfter!=nil {
            if data.accounts.len()==0 || data.nextAfter!=data.accounts[data.accounts.len()-1].id || data.nextAfter==after || rows.len()>256 || pages>=32 {
                H.notice=A.t("The complete account list could not be read. Refresh to try again.","无法读取完整账号列表，请刷新重试。") return
            }
            A.read_account_page(data.nextAfter,epoch,rows,pages+1)
        } else {data.accounts=rows H.account_inventory=data}
    })
}
A.open_accounts = fn(after){
    if H.busy {return}
    H.account_list_epoch+=1
    H.page="provider_accounts" H.account_inventory=nil H.account_after=nil H.notice="" A.redraw()
    A.read_account_page(nil,H.account_list_epoch,[],0)
}
A.open_account = fn(id,after){
    if H.busy {return}
    if H.ux.resourceJourney {H.ux.accountId=id A.save()}
    H.account_models=nil H.account_models_attempted=false
    H.page="provider_account" H.account_id=id H.account_resource_after=after H.account_detail=nil H.notice="" A.redraw()
    let args={id:id} if after!=nil {args.after=after}
    A.request("hagency.accounts.get",args,fn(data){
        if H.page!="provider_account" || H.account_id!=id || H.account_resource_after!=after {return}
        if data.protocol!="hagency-management-v1" || data.account==nil || data.account.id!=id {H.notice=A.t("The account changed or is no longer available to this profile.","账号已变更或当前身份无权查看。") return}
        H.account_detail=data
    })
}
A.load_providers = fn(){ A.request("hagency.providers.list", {}, fn(data){
    H.providers = data.providers
    if H.wizard.step == 2 && H.wizard.model != nil {
        let selected = H.wizard.model.id H.wizard.model = nil
        for provider in H.providers { if provider.runtime == H.wizard.runtime {
            for row in provider.models {if row.id == selected {H.wizard.model = row}}
        }}
    }
}) }
A.provider_selected = fn(runtime){
    if H.busy || H.command != nil { return }
    H.wizard.runtime = runtime H.wizard.model = nil H.wizard.reasoning = nil H.wizard.step = 2 A.save() A.redraw()
}
A.connect_provider = fn(runtime){
    A.request("hagency.providers.connect", {runtime: runtime}, fn(data){ A.load_providers() })
}
A.select_model = fn(row){
    if H.busy || H.command != nil { return }
    H.wizard.model = row H.wizard.reasoning = row.sharedDefaultReasoning A.save() A.redraw()
}
A.fields_changed = fn(name, value){
    if H.command != nil { return }
    if name == "tokens" { H.wizard.tokens = value }
    if name == "label" { H.wizard.label = value }
    A.save()
}
A.submit = fn(service, args){
    if H.busy || H.command != nil { return }
    H.ux.dashboard=nil
    A.request("hagency.intent.new", {}, fn(data){
        args.commandId = data.commandId
        H.command = {service: service args: args.to_json().parse_json()}
        if A.save() { A.retry_command() }
    })
}
A.acknowledge = fn(id){
    host.request("hagency.intent.acknowledge", {commandId:id}, fn(r){
        if r.is_ok {
            let remaining = []
            for row in H.saved_commands {if row.commandId != id {remaining.push(row)}}
            H.saved_commands = remaining
        } else {H.notice = A.t("The result remains saved. Refresh to recover it later.", "结果仍然保留，可刷新后恢复。")}
        A.redraw()
    })
}
A.recover_native = fn(row){
    if row.operation=="web_catalog"{A.open_saved_web(row) return}
    if A.personal_config_operation(row.operation){A.recover_personal_config(row.commandId,row.operation,"") return}
    if A.is_template_operation(row.operation){A.open_saved_template(row) return}
    if A.is_graph_operation(row.operation){A.open_saved_graph(row) return}
    if A.is_task_operation(row.operation){A.open_saved_task(row) return}
    A.request("hagency.intent.retry", {commandId:row.commandId}, fn(reply){
        let data = reply.data
        if row.operation=="revoke_tool_grant" && (reply.operation!=row.operation || !A.valid_tool_result(data,row.input)) {H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="review_stopped" && (reply.operation!=row.operation || !A.stopped_review_valid(data,row.input)){H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="resolve_stopped" && (reply.operation!=row.operation || !A.stopped_result_valid(data,row.input)){H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="clear_workspace_dirty" && (reply.operation!=row.operation || !A.valid_workspace_result(data,row.input)) {H.notice=A.error_text("management_outcome_unknown") return}
        if row.operation=="edit_execution_policy" && (reply.operation!=row.operation || !A.valid_policy_result(data,row.input)) {H.notice=A.error_text("management_outcome_unknown") return}
        H.command = nil
        if reply.operation == "enroll_resource" {H.wizard.resource=data H.wizard.step=3 H.page="wizard"}
        else if reply.operation == "enroll_account_resource" {H.enrollment_draft=nil H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil}
        else if reply.operation == "retire_account" {A.account_prepared(data)}
        else if reply.operation == "prepare_account" {A.account_prepared(data)}
        else if reply.operation == "login_account" {
            A.account_prepared(data)
            if data.state=="starting" || data.state=="awaiting_authorization" || data.state=="stopping" {H.command={service:"hagency.accounts.login" args:row.input} A.save() A.open_account(H.account_id,nil) return}
        }
        else if reply.operation == "revoke_tool_grant" {A.tool_grant_received(data)}
        else if reply.operation == "review_stopped" {A.stopped_review_received(data)}
        else if reply.operation == "resolve_stopped" {A.stopped_result_received(data)}
        else if reply.operation == "clear_workspace_dirty" {A.workspace_received(data)}
        else if reply.operation == "edit_execution_policy" {A.policy_received(data)}
        else if reply.operation == "retire_approval_binding" {A.binding_received(data)}
        else if reply.operation == "triage_resource_alert" {H.page="resource_alert" H.alert_resource=data.resourceId H.alert_id=data.id H.alert_detail=nil H.alert_draft=nil}
        else if reply.operation == "edit_local_resource" {H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil H.resource_edit_draft=nil}
        else if reply.operation == "create_resource_configuration" {H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil H.resource_create_draft=nil}
        else if reply.operation == "rename_resource" {H.page="resource_detail" H.resource_id=data.resourceId H.resource_detail=nil H.resource_name_mode="" H.resource_name_draft=nil}
        else if reply.operation == "personal_agent_policy" {A.personal_saved(data)}
        else if reply.operation == "personal_agent_observation" {A.personal_observation_received(data)}
        else if A.topup_operation(reply.operation) {A.topup_received(data)}
        else if reply.operation == "agent_settlement_request" {H.page="agent_removal" H.removal_id=data.requested.requestId H.removal=nil H.settlement=nil}
        else if reply.operation == "agent_run_control" {H.control_assignment=data.control.assignmentId H.agent_control=nil H.page="agent_control"}
        else if reply.operation == "configure_resource" || reply.operation == "publish_resource" {H.page="resources"}
        else if reply.operation=="pool_agent_request" || reply.operation=="pool_agent_decide" || reply.operation=="pool_agent_stop" {H.pool_detail=data.request H.pool_draft=nil H.pool_confirm="" H.page="pool_agent"}
        else if reply.operation == "project_request" || reply.operation == "project_decide" || reply.operation == "project_revoke" {
            H.project_selected=data.project H.page="project_action" H.confirm=""
            if reply.operation == "project_request" {A.clear_requested_draft(data.project)}
        }
        else if reply.operation == "allocation_decide" || reply.operation == "allocation_release" {H.allocation_id=data.allocation.id H.page="allocation_action" H.allocation_detail=nil H.allocation_confirmation=""}
        else if reply.operation == "agent_request" || reply.operation == "agent_decide" || reply.operation == "agent_cancel" || reply.operation == "agent_revoke" {
            A.agent_received(data.agentRequest)
            if reply.operation == "agent_request" {A.clear_agent_draft(data.agentRequest)}
            if A.cleanup_enabled() && (reply.operation == "agent_cancel" || reply.operation == "agent_revoke") {H.page="agent_removal" H.removal_id=data.agentRequest.id H.removal=nil}
        }
        else {H.selected=data.admission H.page="action" H.confirm="" if reply.operation=="reoffer" {H.reoffer_draft=nil}}
        if A.save() {A.acknowledge(row.commandId)}
        if H.page == "agent_topup" {A.open_topup(H.budget_topup_id)}
        if H.page == "agent_control" {A.open_agent_control(H.control_assignment,H.control_agent_name)}
        if H.page == "action" {A.open_connection(data.admission.contribution.id)}
        if H.page == "project_action" {A.open_project(data.project.id)}
        if H.page == "agent_action" {A.open_agent(data.agentRequest.id)}
        if H.page == "agent_removal" {A.open_removal(H.removal_id)}
        if H.page == "allocation_action" {A.open_allocation(data.allocation.id)}
        if H.page == "provider_account" {A.open_account(H.account_id,nil)}
        if H.page=="resource_alert" {A.open_alert(data.resourceId,data.id,0)}
        if H.page == "resource_detail" {A.open_resource(data.resourceId)}
        if H.page == "personal_agent" {A.open_personal_agent(data.agentId)}
        if H.page == "resources" {A.refresh()}
    })
}
A.saved_label = fn(operation){
    if operation=="web_catalog"{return A.t("Resource offers and defaults","资源报价与默认设置")}
    if A.personal_config_operation(operation){return A.t("Personal-agent model, workspace or tool rules","个人 Agent 模型、工作区或工具规则")}
    if A.is_template_operation(operation){return A.t("Saved agent template change","已保存的 Agent 模板更改")}
    if A.is_graph_operation(operation){return A.t("Saved graph change","已保存的任务图更改")}
    if A.is_task_operation(operation){return A.t("Saved task change", "已保存的任务更改")}
    if A.topup_operation(operation) {return A.t("Agent budget request", "Agent 额度申请")}
    if operation == "agent_settlement_request" {return A.t("Agent accounting recheck", "Agent 重新核算")}
    if operation == "agent_run_control" {return A.t("Automatic reply setting", "自动回复设置")}
    if operation == "login_account" {return A.t("Provider sign-in", "模型服务登录")}
    if operation == "retire_account" {return A.t("Retire account space","停用账号空间")}
    if operation == "prepare_account" {return A.t("Prepare provider account", "准备模型服务账号")}
    if operation == "revoke_tool_grant" {return A.t("Revoke tool permission","撤销工具权限")}
    if operation == "review_stopped" {return A.t("Interrupted task inspection","中断任务检查")}
    if operation == "resolve_stopped" {return A.t("Interrupted task decision","中断任务处理")}
    if operation == "clear_workspace_dirty" {return A.t("Workspace recovery","工作区恢复")}
    if operation == "edit_execution_policy" {return A.t("Agent execution permissions","Agent 执行权限")}
    if operation == "retire_approval_binding" {return A.t("Remove approval-room link","解除审批房间绑定")}
    if operation == "triage_resource_alert" {return A.t("Resource alert update","资源告警处理")}
    if operation == "edit_local_resource" {return A.t("Resource configuration", "资源配置")}
    if operation == "rename_resource" {return A.t("Local resource name", "资源本地名称")}
    if operation == "personal_agent_observation" {return A.t("Read current personal-agent settings", "读取个人 Agent 当前设置")}
    if operation == "personal_agent_policy" {return A.t("Personal-agent policy change", "个人 Agent 策略修改")}
    if operation == "allocation_decide" {return A.t("Project allocation decision", "项目分配决定")}
    if operation == "allocation_release" {return A.t("Project allocation release", "项目分配释放")}
    if operation == "agent_request" {return A.t("Agent request", "Agent 申请")}
    if operation == "agent_decide" {return A.t("Agent decision", "Agent 审批")}
    if operation == "agent_revoke" {return A.t("Agent revocation", "撤销 Agent")}
    if operation == "agent_cancel" {return A.t("Agent request cancellation", "取消 Agent 申请")}
    if operation == "project_request" {return A.t("Project request", "项目申请")}
    if operation == "project_decide" {return A.t("Project decision", "项目审批")}
    if operation == "project_revoke" {return A.t("Project withdrawal", "项目撤回")}
    if operation == "enroll_resource" || operation == "enroll_account_resource" {return A.t("Resource setup", "资源设置")}
    if operation == "reoffer" {return A.t("New admission request", "新准入申请")}
    if operation == "contribute" {return A.t("Admission request", "准入申请")}
    if operation == "decide" {return A.t("Admission decision", "准入决定")}
    if operation == "revoke" {return A.t("Connection revocation", "连接撤销")}
    if operation == "resume" {return A.t("Device reconnection", "设备重新连接")}
    if operation == "verify" {return A.t("Connection verification", "连接验证")}
    return A.t("Resource update", "资源更新")
}
A.retry_command = fn(){
    if H.busy || H.command == nil { return }
    let command = H.command
    if A.personal_config_service(command.service){
        if A.recipient_optional(command,"nativeRecover")==true{A.recover_personal_config(command.args.commandId,A.personal_config_op(command.service),command.args.agentId) return}
        command.nativeRecover=true
        if !A.save(){return}
    }
    H.busy = true H.notice = A.t("Submitting your saved request…", "正在提交已保存的请求…") A.redraw()
    host.request(command.service, command.args, fn(r){
        if A.web_connection_service(command.service){A.web_connection_reply(command,r) return}
        if A.personal_config_service(command.service){A.personal_config_reply(command,r) return}
        H.busy = false
        if command.service=="hagency.resources.publish" && !r.is_ok && r.error=="management_resource_in_use" {
            H.command=nil H.notice=A.t("This configuration has active allocations or another owner. Its saved definition must stay unchanged. Use standing offers to control new reservations.","此配置存在有效分配或其他所有者，必须保留已保存的定义。可通过长期报价控制新的预留。")
            if A.save(){A.acknowledge(command.args.commandId)} A.redraw() return
        }
        if command.service=="hagency.tool_grants.revoke" {A.tool_grant_reply(command,r) return}
        if command.service=="hagency.stopped.review" || command.service=="hagency.stopped.resolve" {A.stopped_reply(command,r) return}
        if command.service=="hagency.workspaces.clear_dirty" {A.workspace_reply(command,r) return}
        if command.service=="hagency.execution_policy.edit" {A.policy_reply(command,r) return}
        if command.service=="hagency.approval_bindings.retire" {A.binding_reply(command,r) return}
        if r.is_ok {
            H.command = nil H.notice = ""
            if A.topup_service(command.service) {A.topup_received(r.data)}
            if command.service == "hagency.accounts.prepare" || command.service == "hagency.accounts.login" || command.service == "hagency.accounts.retire" {A.account_prepared(r.data)}
            if command.service == "hagency.resources.edit" {H.resource_edit_draft=nil H.resource_detail=nil}
            if command.service == "hagency.resources.create" {H.resource_create_draft=nil H.resource_detail=nil}
            if command.service == "hagency.resources.rename" {H.resource_name_mode="" H.resource_name_draft=nil H.resource_detail=nil}
            if command.service == "hagency.personal_agents.policy.save" {A.personal_saved(r.data)}
            if command.service == "hagency.personal_agents.observe" {A.personal_observation_received(r.data)}
            if command.service=="hagency.accounts.enroll" {H.enrollment_draft=nil H.page="resource_detail" H.resource_id=r.data.resourceId H.resource_detail=nil}
            if command.service == "hagency.resources.enroll" {H.wizard.resource = r.data H.wizard.step = 3 H.page = "wizard"}
            if command.service == "hagency.connections.create" {H.wizard.admission = r.data.admission H.wizard.step = 4 H.page = "wizard"}
            if command.service=="hagency.connections.reoffer" {H.reoffer_draft=nil}
            if command.service == "hagency.inbox.decide" || command.service == "hagency.connections.revoke" || command.service=="hagency.connections.reoffer" {H.selected = r.data.admission H.confirm = "" H.page = "action"}
            if A.pool_mutation(command.service) {H.pool_detail=r.data.request H.pool_draft=nil H.pool_confirm="" H.page="pool_agent"}
            if command.service == "hagency.projects.request" || command.service == "hagency.projects.decide" || command.service == "hagency.projects.revoke" {
                H.project_selected = r.data.project H.page = "project_action" H.confirm = ""
                if command.service == "hagency.projects.request" {H.project_draft = {step:0 resource:nil name:"" purpose:"" tokens:"100000"}}
            }
            if command.service == "hagency.agents.request" || command.service == "hagency.agents.decide" || command.service == "hagency.agents.cancel" || command.service == "hagency.agents.revoke" {
                A.agent_received(r.data.agentRequest)
                if command.service == "hagency.agents.request" {A.clear_agent_draft(r.data.agentRequest)}
            }
            if command.service == "hagency.allocations.decide" || command.service == "hagency.allocations.release" {H.page="allocation_action" H.allocation_id=r.data.allocation.id H.allocation_detail=nil H.allocation_confirmation=""}
            if command.service == "hagency.agents.control.set" {H.control_assignment=r.data.control.assignmentId H.agent_control=nil H.page="agent_control"}
            if command.service == "hagency.agents.settlement.request" {H.page="agent_removal" H.removal_id=r.data.requested.requestId H.removal=nil H.settlement=nil}
            if A.save() && !(command.service=="hagency.accounts.login" && r.data.recorded==false) {A.acknowledge(command.args.commandId)}
            if command.service == "hagency.agents.settlement.request" {A.open_removal(H.removal_id)}
            if A.topup_service(command.service) {A.open_topup(H.budget_topup_id)}
            if command.service == "hagency.agents.control.set" {A.open_agent_control(H.control_assignment,H.control_agent_name)}
            if command.service == "hagency.accounts.prepare" || command.service == "hagency.accounts.login" || command.service == "hagency.accounts.retire" {A.open_account(H.account_id,nil)}
            if command.service=="hagency.accounts.enroll" {A.open_resource(r.data.resourceId)}
            if command.service == "hagency.alerts.triage" {A.open_alert(r.data.resourceId,r.data.id,0)}
            if command.service=="hagency.resources.publish" {A.open_resource(command.args.resourceId)}
            if command.service == "hagency.resources.rename" || command.service=="hagency.resources.edit" || command.service=="hagency.resources.create" {A.open_resource(r.data.resourceId)}
            if command.service == "hagency.personal_agents.policy.save" || command.service == "hagency.personal_agents.observe" {A.open_personal_agent(r.data.agentId)}
            if A.cleanup_enabled() && (command.service == "hagency.agents.cancel" || command.service == "hagency.agents.revoke") {A.open_removal(r.data.agentRequest.id)}
            if command.service == "hagency.allocations.decide" || command.service == "hagency.allocations.release" {A.open_allocation(r.data.allocation.id)}
            if command.service=="hagency.connections.reoffer" || command.service == "hagency.connections.create" || command.service == "hagency.inbox.decide" || command.service == "hagency.connections.revoke" || command.service == "hagency.connections.verify" || command.service == "hagency.connections.resume" { A.open_connection(r.data.admission.contribution.id) }
            if command.service == "hagency.projects.request" || command.service == "hagency.projects.decide" || command.service == "hagency.projects.revoke" {A.open_project(r.data.project.id)}
        } else {
            if A.pool_mutation(command.service) {
                H.notice=A.pool_reason(r.error)
                if command.service=="hagency.pools.agents.request" && H.pool_draft!=nil {H.pool_draft.failure=r.error A.save()}
                for code in ["invalid_pool_agent_room","invalid_managed_agent_definition","invalid_management_revision","management_revision_changed","pool_capacity_unavailable","pool_not_shared_with_account","pool_agent_resource_mismatch","pool_resource_owner_required","pool_agent_request_closed","pool_agent_authority_changed","pool_agent_request_capacity","management_receipt_capacity"] {
                    if r.error==code {
                        H.command=nil
                        if command.service=="hagency.pools.agents.request" && H.pool_draft!=nil {H.pool_draft.review=false H.pool_checked=false H.page="pool_apply"}
                        if A.save(){A.acknowledge(command.args.commandId)}
                    }
                }
                A.redraw() return
            }
            if command.service=="hagency.connections.reoffer" {
                H.notice=A.readmission_error(r.error)
                if A.reoffer_not_applied(r.error) {
                    H.command=nil
                    if H.reoffer_draft!=nil {H.reoffer_draft.review=false}
                    if A.save() {A.acknowledge(command.args.commandId)}
                }
                A.redraw() return
            }
            if command.service=="hagency.resources.edit" {
                if r.error=="resource_edit_cancelled" || r.error=="provider_confirmation_expired" {
                    H.command=nil H.notice=A.t("Configuration review closed. Existing saved requests remain available for recovery.","已关闭配置确认，已有的保存请求仍可恢复。") A.save()
                    host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                } else {
                    H.notice=A.resource_edit_error(r.error)
                    if A.resource_edit_not_applied(r.error) {H.command=nil if A.save(){A.acknowledge(command.args.commandId)}}
                }
                A.redraw() return
            }
            if command.service=="hagency.resources.create" {
                if r.error=="resource_create_cancelled" || r.error=="provider_confirmation_expired" {
                    H.command=nil H.notice=A.t("Creation review closed. Existing saved requests remain available for recovery.","已关闭创建确认，已有的保存请求仍可恢复。") A.save()
                    host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                } else {
                    H.notice=A.resource_create_error(r.error)
                    if A.resource_create_not_applied(r.error) {H.command=nil if A.save(){A.acknowledge(command.args.commandId)}}
                }
                A.redraw() return
            }
            if command.service=="hagency.accounts.retire" && (r.error=="account_retirement_cancelled" || r.error=="provider_confirmation_expired") {
                H.command=nil H.notice=A.t("Retirement review closed. Existing saved requests are unchanged.","已关闭停用确认，已有的保存请求保持不变。") A.save()
                host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                A.redraw() return
            }
            if command.service=="hagency.accounts.retire" && (r.error=="account_retirement_dependencies" || r.error=="account_retirement_revision_changed") {
                H.command=nil H.notice=A.retirement_error(r.error)
                if A.save(){A.acknowledge(command.args.commandId)} A.redraw() return
            }
            if command.service=="hagency.accounts.enroll" && (r.error=="resource_enrollment_cancelled" || r.error=="provider_confirmation_expired" || r.error=="resource_adoption_required") {
                H.command=nil H.notice=if r.error=="resource_enrollment_cancelled" {A.t("Resource review closed. Existing saved requests are unchanged.","已关闭资源确认，已有的保存请求保持不变。")}else if r.error=="resource_adoption_required" {A.t("Finish device setup before enrolling resources from this account.","请先完成设备设置，再从此账号登记资源。")}else{A.error_text(r.error)}
                A.save()
                host.request("hagency.intent.pending",{},fn(pending){if pending.is_ok {H.saved_commands=pending.data.commands} A.redraw()})
                A.redraw() return
            }
            if command.service=="hagency.accounts.enroll" && (r.error=="provider_identity_unavailable" || r.error=="provider_account_changed") {
                H.command=nil H.notice=A.enrollment_error(r.error)
                if A.save(){A.acknowledge(command.args.commandId)} A.redraw() return
            }
            if r.error == "native_resume_missing" || r.error == "native_resume_revoked" {H.needs_signin=true}
            let topup_service=A.topup_service(command.service)
            let name_service=command.service == "hagency.resources.rename"
            let agent_service=command.service == "hagency.agents.request" || command.service == "hagency.agents.decide" || command.service == "hagency.agents.cancel" || command.service == "hagency.agents.revoke"
            let personal_service=command.service == "hagency.personal_agents.policy.save" || command.service == "hagency.personal_agents.observe"
            let allocation_service=command.service == "hagency.allocations.decide" || command.service == "hagency.allocations.release"
            if command.service == "hagency.agents.control.set" {H.agent_control=nil}
            if command.service == "hagency.agents.settlement.request" {H.settlement=nil}
            if command.service=="hagency.alerts.triage" {H.alert_detail=nil H.alert_draft=nil}
            H.notice = if command.service=="hagency.alerts.triage" {A.alert_error(r.error)} else if command.service=="hagency.accounts.retire" {A.retirement_error(r.error)} else if command.service=="hagency.accounts.enroll" {A.enrollment_error(r.error)} else if command.service == "hagency.agents.settlement.request" {A.settlement_reason(r.error)} else if topup_service {A.budget_reason(r.error)} else if command.service == "hagency.agents.control.set" {A.control_reason(r.error)} else if name_service {A.name_error(r.error)} else if personal_service {A.personal_reason(r.error)} else if allocation_service {A.allocation_reason(r.error)} else if agent_service {A.agent_reason(r.error)} else {A.error_text(r.error)}
            if topup_service {H.agent_budget=nil H.budget_topup=nil H.budget_confirmation=nil H.budget_mode=""}
            if name_service {H.resource_detail=nil H.resource_name_mode="" H.resource_name_draft=nil}
            if personal_service {H.personal_detail=nil H.personal_draft=nil H.personal_mode="detail"}
            if allocation_service {H.allocation_detail=nil H.allocation_confirmation=""}
            if agent_service {H.removal=nil H.removal_confirmation="" H.agent_readiness=nil H.agent_selected=nil H.agent_confirmation="" H.agent_review=false}
            if (command.service=="hagency.accounts.prepare" && (r.error=="device_setup_required" || r.error=="onboarding_unavailable")) || (command.service == "hagency.agents.settlement.request" && (r.error == "agent_settlement_changed" || r.error == "agent_settlement_not_ready")) || (command.service=="hagency.alerts.triage" && (r.error=="management_not_found" || r.error=="management_revision_conflict" || r.error=="invalid_management_arguments")) || A.topup_not_applied(command.service,r.error) || A.name_not_applied(command.service,r.error) || (personal_service && A.personal_not_applied(command.service,r.error)) || ((command.service == "hagency.accounts.prepare" || command.service == "hagency.accounts.login") && r.error == "invalid_management_arguments") || (!topup_service && !name_service && !personal_service && command.service != "hagency.accounts.prepare" && command.service != "hagency.accounts.login" && (A.allocation_not_applied(command.service,r.error) || A.agent_not_applied(command.service,r.error) || A.project_not_applied(command.service, r.error) || r.error == "management_model_unqualified" || r.error == "invalid_management_arguments" || r.error == "invalid_resource_selection" || r.error == "provider_model_changed" || r.error == "provider_connection_required" || r.error == "invalid_management_user" || r.error == "invalid_resource_offer" || r.error == "management_revision_changed" || r.error == "management_revision_conflict" || r.error == "management_action_closed" || r.error == "contribution_already_exists" || r.error == "management_executor_changed" || r.error == "contribution_resource_changed" || r.error == "provider_account_verification_required" || r.error == "contribution_not_admitted" || r.error == "contribution_executor_required" || r.error == "contribution_executor_current" || r.error == "contribution_executor_changed")) {
                H.command = nil
                if command.service == "hagency.agents.settlement.request" {H.page="agent_removal" H.removal_id=r.data.requested.requestId H.removal=nil H.settlement=nil}
            if A.save() {A.acknowledge(command.args.commandId)}
            }
        }
        A.redraw()
    })
}
A.enroll = fn(){
    if H.wizard.model == nil { H.notice = A.t("Choose a model first.", "请先选择模型。") A.redraw() return }
    let qualified = false
    for effort in H.wizard.model.sharedReasoning { if effort == H.wizard.reasoning {qualified = true} }
    if !qualified {H.notice = A.error_text("management_model_unqualified") A.redraw() return}
    let tokens = H.wizard.tokens.trim().to_f64()
    if !(tokens >= 1 && tokens <= 9007199254740991) || floor(tokens) != tokens {H.notice = A.t("Enter a whole number of tokens greater than zero.", "请输入大于零的整数 token 数量。") A.redraw() return}
    A.submit("hagency.resources.enroll", {runtime: H.wizard.runtime modelId: H.wizard.model.id reasoning: H.wizard.reasoning monthlyTokens: tokens})
}
A.contribute = fn(){
    H.wizard.label = H.wizard.label.trim()
    if H.wizard.label == "" { H.notice = A.t("Enter a resource name.", "请输入资源名称。") A.redraw() return }
    A.submit("hagency.connections.create", {resourceId: H.wizard.resource.resourceId expectedRevision: H.wizard.resource.revision label: H.wizard.label coordinatorMxid: H.session.account})
}
A.resource_connection=fn(row){
    if H.busy || H.command!=nil{return}
    H.ux.resourceJourney=true A.save() A.find_resource_connection(row,nil,[])
}
A.find_resource_connection=fn(row,after,seen){
    A.request("hagency.connections.list",{after:after},fn(v){
        A.connections_received(v)
        for connection in v.items {if connection.resourceId==row.id && connection.ownerMxid==H.session.account && connection.executorDeviceId==H.session.device {A.open_connection(connection.id) return}}
        if v.nextAfter!=nil {
            let repeated=false for cursor in seen {if cursor==v.nextAfter{repeated=true}}
            if repeated || seen.len()>=32 {H.notice=A.t("Connection lookup is incomplete. Refresh before connecting this resource.","连接查询尚未完成，请刷新后再连接此资源。") return}
            seen.push(v.nextAfter) A.find_resource_connection(row,v.nextAfter,seen) return
        }
        A.connect_existing(row)
    })
}
A.connect_existing = fn(row){
    if H.busy || H.command != nil {return}
    for connection in H.connections {
        if connection.resourceId == row.id && connection.ownerMxid == H.session.account && connection.executorDeviceId == H.session.device { H.page = "action" A.open_connection(connection.id) return }
    }
    H.wizard = {step: 3 runtime: row.framework model: nil reasoning: row.reasoning tokens: "" label: "" coordinator: "" resource: {resourceId: row.id revision: row.revision} admission: nil}
    H.page = "wizard" A.save() A.redraw()
}
A.open_connection = fn(id){
    let origin = if H.page == "project_action" && H.project_selected != nil && H.project_selected.contributionId == id {H.project_selected.id} else if H.page == "action" && H.selected != nil && H.selected.contribution.id == id {H.connection_project} else {nil}
    if H.busy{return}
    H.ux.connectionId=id
    if H.page!="wizard"{H.selected=nil H.connection_project=origin H.page="action" H.confirm=""}
    A.request("hagency.connections.get", {id: id}, fn(data){
        if data.admission.contribution.id!=id{H.notice=A.t("Connection details changed. Refresh and open the resource again.","连接详情已变化，请刷新后重新打开资源。") return}
        let found = false
        for index in H.connections.len() {if H.connections[index].id == data.admission.contribution.id {H.connections[index] = data.admission.contribution found = true}}
        if !found && H.connections.len() < 32 {H.connections.push(data.admission.contribution)}
        if H.page == "wizard" {H.wizard.admission = data.admission A.save()}
        else {H.selected = data.admission H.connection_project = origin H.page = "action" H.confirm = ""}
        A.observe_verification(data.admission.contribution, data.observedAtMs)
    })
}
A.open_request = fn(id){
    if H.busy {return}
    if H.page=="inbox" {H.ux.origin="inbox"} else if H.page=="overview" {H.ux.origin="overview"}
    A.request("hagency.inbox.get", {id: id}, fn(data){
        if data.request.kind == "project_allocation" {H.allocation_from_inbox=true A.open_allocation(data.request.allocationId)}
        else if data.request.kind == "project_capacity" {A.open_project(data.request.projectId)}
        else {A.open_connection(data.request.contributionId)}
    })
}
A.decide = fn(approve){
    if H.selected == nil || !H.selected.request.canDecide {return}
    A.submit("hagency.inbox.decide", {requestId: H.selected.request.id expectedRevision: H.selected.request.revision approve: approve})
}
A.revoke = fn(){A.submit("hagency.connections.revoke", {contributionId: H.selected.contribution.id expectedRevision: H.selected.contribution.revision})}
A.verify = fn(connection){
    if !A.can_verify(connection) {return}
    A.submit("hagency.connections.verify", {contributionId: connection.id expectedRevision: connection.revision resourceId: connection.resourceId resourceRevision: connection.resourceRevision})
}
A.resume = fn(connection){
    if !A.can_resume(connection) {return}
    A.submit("hagency.connections.resume", {contributionId:connection.id expectedRevision:connection.revision resourceId:connection.resourceId resourceRevision:connection.resourceRevision})
}
A.more = fn(){
    if H.page == "resources" && H.resource_after != nil {
        H.ux.resourceCursor=H.resource_after
        let args = {after: H.resource_after limit: 16} if H.capability != "" {args.capability = H.capability}
        A.request("hagency.resources.list", args, fn(data){H.resources = data.resources H.resource_after = data.nextAfter})
    }
    if H.page == "connections" && H.connection_after != nil {A.request("hagency.connections.list", {after:H.connection_after}, A.connections_received)}
    if H.page == "inbox" && H.inbox_after != nil {H.ux.inboxCursor=H.inbox_after A.request("hagency.inbox.list", {after:H.inbox_after needsMyAction:H.needs_action includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()}, fn(data){H.inbox=data.items H.inbox_after=data.nextAfter})}
    if H.page == "projects" && H.project_after != nil {H.ux.projectCursor=H.project_after A.request("hagency.projects.list", {after:H.project_after}, fn(data){H.projects=data.items H.project_after=data.nextAfter})}
    if H.page == "project_wizard" && H.catalog_after != nil {
        let args = {after:H.catalog_after} if H.catalog_capability != "" {args.capability=H.catalog_capability}
        A.request("hagency.resources.catalog", args, fn(data){H.catalog=data.items H.catalog_after=data.nextAfter})
    }
}
A.progress_ratio=fn(used,total){if used==nil || total==nil || total<=0{return 0.0} return max(0.0,min(1.0,used/total))}
A.amount = fn(value){
    if value==nil{return A.t("Unknown","未知")}
    let text=""+value
    if value<1000 || floor(value)!=value{return text}
    let chars=text.to_chars() let result="".to_chars() let comma=",".to_chars()
    for i char in chars {if i>0 && (chars.len()-i)%3==0{result.push(comma[0])} result.push(char)}
    return result.to_string()
}

A.capability_label = fn(value){
    if value == "architect" {return A.t("Architecture", "架构")}
    if value == "review" {return A.t("Review", "评审")}
    if value == "coding" {return A.t("Coding", "编程")}
    if value == "testing" {return A.t("Testing", "测试")}
    if value == "integration" {return A.t("Integration", "集成")}
    if value == "documentation" {return A.t("Documentation", "文档")}
    return value
}
A.reasoning_label = fn(value){
    if value == nil {return A.t("Default", "默认")}
    if value == "none" {return A.t("None", "无")}
    if value == "low" {return A.t("Low", "低")}
    if value == "medium" {return A.t("Medium", "中")}
    if value == "high" {return A.t("High", "高")}
    if value == "xhigh" {return A.t("Extra high", "极高")}
    if value == "max" {return A.t("Maximum", "最大")}
    if value == "ultra" {return A.t("Ultra", "超高")}
    return value
}
A.route_identity=fn(){
    if H.page=="pool_agent" && H.pool_detail!=nil{return H.pool_detail.id}
    if H.page=="resource_detail" {return H.resource_id}
    if H.page=="project_action" && H.project_selected!=nil {return H.project_selected.id}
    if H.page=="action" {return H.ux.connectionId}
    if H.page=="inbox" {return ""+H.needs_action+"/"+H.ux.inboxCursor+"/"+H.ux.agentCursor}
    if H.page=="resources" {return H.capability+"/"+H.ux.resourceCursor}
    if H.page=="projects" {return ""+H.ux.projectCursor}
    if H.page=="provider_account" {return H.account_id}
    return ""
}
A.has_page=fn(pages){for page in pages {if H.page==page{return true}} return false}
A.entry_allowed=fn(role){
    if H.session==nil{return false}
    if role=="manager" || role=="owner"{return true}
    return role=="admin" && H.session.canAdmitResources
}
A.entry_label=fn(role){
    if role=="manager"{return A.t("Agent manager","Agent 管理者")}
    if role=="owner"{return A.t("Resource owner","资源 Owner")}
    if role=="admin"{return A.t("Server admin","服务器 Admin")}
    return A.t("Choose a workspace","选择工作台")
}
A.entry_choose=fn(role){
    if H.busy || !A.entry_allowed(role){return}
    if role!=H.entry_role{H.needs_action=true H.ux.inboxCursor=nil H.ux.agentCursor=nil}
    H.entry_role=role H.entry_choosing=false H.page="overview" H.notice=""
    A.save() A.redraw()
}
A.entry_switch=fn(){if H.busy{return} H.entry_choosing=true H.page="overview" H.notice="" A.redraw()}
A.entry_parent=fn(){
    if H.page=="overview"{return "overview"}
    if H.ux.origin=="inbox" || H.page=="inbox"{return "inbox"}
    if H.entry_role=="owner" && A.has_page(["pool_agents","pool_agent","agent_budget","agent_topup"]){return "inbox"}
    if A.has_page(["provider_accounts","provider_account","account_prepare","account_enrollment"]){return "accounts"}
    if H.page=="device_execution"{return "devices"}
    if A.has_page(["connections","connection_history","connection_reoffer","web_connections","web_connection","web_connection_new"]){return if H.entry_role=="admin"{"servers"}else{"resources"}}
    if A.has_page(["tools","operator_tasks","operator_task","operator_task_edit","operator_task_command","operator_board","operator_graphs","operator_graph","operator_graph_node","operator_graph_edit","operator_graph_edit_node","operator_graph_command","operator_graph_recipient","operator_graph_update","graph_archives","graph_history","history_graph","history_node","web_overview"]){return "work"}
    return A.nav_parent()
}
A.nav_parent=fn(){
    if H.page=="pools" || H.page=="pool_apply" {return "projects"}
    if H.page=="pool_agents" || H.page=="pool_agent" {return "agents"}
    if H.ux.origin=="inbox" && A.has_page(["project_action","action","agent_action","allocation_action","agent_topup"]) {return "inbox"}
    if H.page=="inbox" {return "inbox"}
    if A.has_page(["projects","project_wizard","project_action","project_setup","allocations","allocation_action"]) {return "projects"}
    if A.has_page(["agent_home","agents","agent_wizard","agent_action","agent_status","agent_control","agent_work","agent_work_list","agent_removals","agent_removal","personal_agents","personal_agent","agent_budget","agent_topup"]) {return "agents"}
    if A.has_page(["overview","tools","operator_tasks","operator_task","operator_task_command","operator_board","operator_graphs","operator_graph","operator_graph_node","operator_graph_command","operator_graph_recipient","graph_archives","graph_history","history_graph","history_node","web_overview"]) {return "overview"}
    return "resources"
}
A.return_list=fn(page){if H.busy{return} H.ux.origin="" H.page=page H.ux.restore=true A.refresh_page()}
A.native_open=fn(destination){A.request("hagency.navigation.open",{destination:destination},fn(v){})}
A.return_origin=fn(){
    if H.busy {return}
    let origin=H.ux.origin H.ux.origin="" H.confirm="" H.notice="" H.page=origin H.ux.restore=true
    if origin=="inbox" {if H.entry_role=="owner"{A.load_pool_agents(nil)}else{A.load_inbox()}} else {A.load_dashboard()}
}
A.must_reopen=fn(){return H.ux.errorCode=="management_permission_required" || H.ux.errorCode=="management_scope_changed" || H.ux.errorCode=="management_access_required"}
A.load_inbox=fn(){
    H.ux.inboxReady=false H.ux.inboxError=false H.inbox=[] H.agents=[] H.inbox_after=nil H.agent_after=nil
    A.request("hagency.inbox.list",{after:H.ux.inboxCursor needsMyAction:H.needs_action includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()},fn(v){
        H.inbox=v.items H.inbox_after=v.nextAfter
        if A.agents_enabled() && H.entry_role!="admin" {A.load_agents(H.ux.agentCursor)} else {H.agents=[] H.agent_after=nil H.ux.inboxReady=true}
    })
}
A.inbox_filter=fn(needs){if H.busy{return} H.needs_action=needs H.ux.inboxCursor=nil H.ux.agentCursor=nil if H.entry_role=="owner"{A.load_pool_agents(nil)}else{A.load_inbox()}}
A.load_dashboard=fn(){
    if H.busy{return}
    H.ux.dashboard=nil H.ux.dashboardError=false
    A.request("hagency.inbox.list",{needsMyAction:true includeProjects:H.entry_role!="admin" && A.projects_enabled() includeAllocations:H.entry_role!="admin" && A.allocations_enabled()},fn(v){
        H.ux.dashboard={requests:v.items requestAfter:v.nextAfter agents:[] agentAfter:nil projects:[] projectAfter:nil complete:false}
        A.dashboard_agents()
    })
}
A.dashboard_agents=fn(){
    if A.agents_enabled(){A.request("hagency.agents.list",{needsMyAction:true},fn(v){H.ux.dashboard.agents=v.items H.ux.dashboard.agentAfter=v.nextAfter A.dashboard_projects()})}
    else {A.dashboard_projects()}
}
A.dashboard_projects=fn(){
    if A.projects_enabled(){A.request("hagency.projects.list",{},fn(v){H.ux.dashboard.projects=v.items H.ux.dashboard.projectAfter=v.nextAfter A.dashboard_connections()})}
    else {A.dashboard_connections()}
}
A.dashboard_connections=fn(){A.request("hagency.connections.list",{},fn(v){A.connections_received(v) H.ux.dashboard.complete=true})}
A.queue_count=fn(){
    let d=H.ux.dashboard
    if d==nil{return ""}
    let n=d.requests.len()+d.agents.len()
    return ""+n+if d.requestAfter!=nil || d.agentAfter!=nil || !d.complete {"+"}else{""}
}
A.role_label=fn(){
    if H.session==nil{return ""}
    let manager=false let coordinator=false let owner=false
    let projects=H.projects let agents=H.agents
    if H.ux.dashboard!=nil{projects=H.ux.dashboard.projects agents=H.ux.dashboard.agents}
    for project in projects{if project.managerMxid==H.session.account{manager=true} if project.coordinatorMxid==H.session.account{coordinator=true}}
    for agent in agents{let {administratorMxid=nil}=agent let {canDecide=false}=agent if administratorMxid==H.session.account && canDecide{manager=true}}
    for row in H.connections{if row.ownerMxid==H.session.account{owner=true} if row.coordinatorMxid==H.session.account{coordinator=true}}
    let roles=[]
    if H.session.account==H.session.administrator{roles.push(A.t("Server administrator","服务器管理员"))}
    if manager{roles.push(A.t("Agent applicant","Agent 申请者"))}
    if owner || coordinator{roles.push(A.t("Resource owner","资源主人"))}
    let result="" for role in roles{if result!=""{result=result+" · "} result=result+role}
    return if result==""{A.t("Resources and Agent management","资源与 Agent 管理")}else{result}
}
A.project_capacity=fn(){
    if H.ux.projectProgress==nil{return false}
    return H.ux.projectProgress.readiness.capacityReady || A.recipient_optional(H.ux.projectProgress.readiness,"eligibleAllocation")!=nil
}
A.project_plan=fn(project){
    let plan={title:"" actor:project.managerMxid label:A.t("View progress","查看进度") target:""}
    if project.allocationStatus=="resource_unavailable" {plan.title=A.t("Choose another resource for a new request","选择其他资源，重新申请") return plan}
    if project.state=="pending_approval" || project.state=="pending" {plan.title=if project.request.canDecide{A.t("Your decision is needed","需要你审批")}else{A.t("Waiting for server administrator","等待服务器管理员")} plan.actor=project.request.approverMxid return plan}
    if project.state!="approved" {plan.title=A.t("This request is closed. Its history is retained.","此申请已结束，历史记录仍保留。") return plan}
    if H.ux.projectProgress==nil {plan.title=A.t("Check current project requirements","检查项目当前条件") plan.label=A.t("Review setup requirements","查看设置条件") plan.target=if A.setup_enabled(){"setup"}else if A.allocations_enabled(){"allocations"}else{""} return plan}
    if A.recipient_optional(H.ux.projectProgress,"pendingCommands")!=nil && H.ux.projectProgress.pendingCommands.len()>0 {plan.title=A.t("Recover the saved setup result","恢复已保存的设置结果") plan.label=A.t("Review saved setup","查看已保存的设置") plan.target="setup" return plan}
    let r=H.ux.projectProgress.readiness
    if !A.project_capacity(){
        plan.title=A.t("Review resource allocation","查看资源分配") plan.label=A.t("View allocation status","查看分配状态") plan.actor=project.coordinatorMxid plan.target=if A.allocations_enabled(){"allocations"}else{"setup"} return plan
    }
    if r.administrator==nil {plan.title=A.t("Check project manager authority","检查项目经理权限") plan.label=A.t("Review project requirements","查看项目条件") plan.actor=project.managerMxid plan.target="setup" return plan}
    if A.recipient_optional(r,"setup")!=nil && !r.capacityReady {plan.title=A.t("Review the updated allocation before continuing","继续前请核对已更新的资源分配") plan.label=A.t("Review setup requirements","查看设置条件") plan.target="setup" return plan}
    if !r.matrixReady {plan.title=A.t("Finish and verify the project workspace","完成并验证项目工作区") plan.label=if H.session.account==project.managerMxid{A.t("Continue workspace setup","继续工作区设置")}else{A.t("View workspace status","查看工作区状态")} plan.target="setup" return plan}
    plan.title=A.t("Workspace verification recorded · Check agents","已记录工作区验证 · 检查 Agent") plan.label=if A.agents_enabled(){A.t("View project agents","查看项目 Agent")}else{A.t("View workspace status","查看工作区状态")} plan.target=if A.agents_enabled(){"agents"}else{"setup"}
    return plan
}
A.project_next=fn(project){return A.project_plan(project).title}
A.project_actor=fn(project){return A.project_plan(project).actor}
A.project_continue=fn(){let p=H.project_selected if p==nil{return} let plan=A.project_plan(p)
    if plan.target=="allocations"{A.open_allocations(p.id,nil,1)}
    if plan.target=="setup"{A.open_project_setup(p.id)}
    if plan.target=="agents"{A.open_project_agents(p.id)}
}
A.load_agent_home=fn(){
    if A.agents_enabled(){A.request("hagency.agents.list",{after:nil needsMyAction:false},fn(v){H.agents=v.items H.agent_after=v.nextAfter})}
}
A.resource_stage=fn(){
    if H.page=="action" && H.selected!=nil {return if H.selected.contribution.state=="admitted"{3}else{2}}
    if H.page=="wizard" {return if H.wizard.admission!=nil && H.wizard.admission.contribution.state=="admitted"{3}else if H.wizard.step>=3{2}else{1}}
    if H.page=="account_enrollment" || H.page=="resource_detail" {return 1}
    return 0
}

A.pool_enabled=fn(){
    if H.session==nil{return false}
    for feature in H.session.features {if feature=="resource-pool-agents-v1"{return true}}
    return false
}
A.pool_mutation=fn(service){return service=="hagency.pools.agents.request" || service=="hagency.pools.agents.decide" || service=="hagency.pools.agents.stop"}
A.load_pools=fn(after){A.request("hagency.pools.list",{after:after},fn(v){H.pool_rows=v.items H.pool_after=v.nextAfter})}
A.load_pool_agents=fn(after){A.request("hagency.pools.agents.list",{after:after needsMyAction:H.page=="inbox" && H.entry_role=="owner" && H.needs_action},fn(v){H.pool_agents=v.items H.pool_agent_after=v.nextAfter})}
A.pool_agent_rows=fn(){
    let rows=[]
    for row in H.pool_agents {
        if H.entry_role=="owner" {if row.resourceOwnerMxid==H.session.account{rows.push(row)}}
        else {if row.managerMxid==H.session.account{rows.push(row)}}
    }
    return rows
}
A.open_pool_agent=fn(id){H.page="pool_agent" H.pool_confirm="" A.request("hagency.pools.agents.get",{id:id},fn(v){H.pool_detail=v.request})}
A.pool_state=fn(r){
    if r.state=="pending_approval"{return A.t("Waiting for resource owner approval","等待资源 owner 审批")}
    if r.state=="rejected"{return A.t("Declined by resource owner","资源 owner 已拒绝")}
    if r.state=="cancelled"{return A.t("Removed by applicant · cleanup continues","申请者已移除 · 清理仍在继续")}
    if r.state=="revoked"{return A.t("Resource supply stopped · cleanup continues","资源供给已停止 · 清理仍在继续")}
    if r.state=="expired"{return A.t("Request expired","申请已过期")}
    if r.reservationState=="refused"{return A.t("Capacity reservation declined", "容量预留被拒绝")}
    if r.blockingReason!=nil{return A.t("Resource authority changed · refresh required","资源授权已变化 · 请刷新检查")}
    if r.runtimeState=="qualified"{return A.t("Runtime qualification recorded","已记录运行时就绪结果")}
    if r.membershipState=="matrix_verified"{return A.t("Conversation verified · execution can be enabled","会话已验证 · 可启用执行")}
    if r.assignmentId!=nil{return A.t("Capacity reserved · verifying conversation","容量已预留 · 正在验证会话")}
    return A.t("Approved · waiting for resource device","已批准 · 等待资源设备确认")
}
A.pool_begin=fn(pool){
    if H.busy || H.command!=nil || !pool.canRequest{return}
    if H.pool_draft!=nil {A.navigate("pool_apply") return}
    H.pool_draft={pool:pool name:"" description:"" capability:"" tokens:"1000" roomCommand:"" roomId:"" review:false}
    H.pool_checked=true
    let limit=A.pool_limit(pool) if limit!=nil {H.pool_draft.tokens=""+min(1000,limit)}
    if pool.capabilities.len()>0{H.pool_draft.capability=pool.capabilities[0]}
    H.page="pool_apply" H.notice="" A.save() A.redraw()
}
A.pool_editable=fn(){
    if H.busy || H.command!=nil{return false}
    for row in H.saved_commands {if row.operation=="pool_agent_request" && row.reply==nil{return false}}
    return true
}
A.pool_limit=fn(pool){
    if pool==nil{return nil}
    let {publishedTokens=nil,nativeAvailableTokens=nil}=pool
    if publishedTokens==nil || !(publishedTokens>=1 && publishedTokens<=9007199254740991) || floor(publishedTokens)!=publishedTokens{return nil}
    if nativeAvailableTokens!=nil {
        if !(nativeAvailableTokens>=0 && nativeAvailableTokens<=9007199254740991) || floor(nativeAvailableTokens)!=nativeAvailableTokens{return nil}
        return min(publishedTokens,nativeAvailableTokens)
    }
    return publishedTokens
}
A.pool_reason=fn(code){
    if code=="pool_agent_resource_mismatch" || code=="management_receipt_capacity" {return A.t("Application not submitted. The amount or capability exceeds this pool's authorization. Refresh its limit and edit your request.","申请未提交：额度或能力超出资源池授权范围。请刷新限额后修改申请。")}
    if code=="management_revision_changed" || code=="pool_agent_authority_changed" {return A.t("Resource authorization changed. Refresh the limit and review your request again.","资源授权已变化，请刷新限额后重新核对申请。")}
    if code=="pool_capacity_unavailable" {return A.t("This pool has no active capacity authorization. Ask its owner to publish capacity.","此资源池暂无有效容量授权，请联系 owner 发布容量。")}
    if code=="pool_not_shared_with_account" {return A.t("This pool is not shared with your account. Contact its resource owner.","此资源池未授权给你的账号，请联系资源 owner。")}
    return A.agent_reason(code)
}
A.pool_amount_error=fn(d){
    if !H.pool_checked{return A.t("Refresh the pool limit before continuing.","请刷新资源池限额后继续。")}
    if !d.pool.canRequest{return A.pool_reason(d.pool.blockingReason)}
    let limit=A.pool_limit(d.pool)
    if limit==nil{return A.t("The request limit is unavailable. Refresh before submitting.","暂时无法确认申请上限，请刷新后再提交。")}
    if limit<1{return A.t("This pool has no available capacity for a new request.","此资源池暂无可用于新申请的额度。")}
    let amount=A.web_int(d.tokens,-1)
    if amount<1{return A.t("Enter a positive whole number of tokens.","请输入大于零的 token 整数。")}
    if amount>limit{return A.t("Requested ","申请 ")+A.amount(amount)+A.t(" tokens exceeds the limit of "," tokens，超过本次申请上限 ")+A.amount(limit)+A.t(" tokens. Reduce the amount before submitting."," tokens。请调低额度后提交。")}
    return ""
}
A.pool_valid=fn(d){
    if d==nil || d.name.trim()=="" || A.pool_amount_error(d)!=""{return false}
    for cap in d.pool.capabilities {if cap==d.capability{return true}}
    return false
}
A.pool_refresh=fn(){A.pool_lookup(fn(){if !A.pool_valid(H.pool_draft){H.pool_draft.review=false A.save()}})}
A.pool_lookup=fn(done){
    if H.pool_draft==nil || !A.pool_editable(){return}
    let d=H.pool_draft H.pool_checked=false
    let seen=[] let load=nil
    load=fn(after){A.request("hagency.pools.list",{after:after},fn(v){
        if H.pool_draft!=d{return}
        for pool in v.items {if pool.id==d.pool.id {d.pool=pool H.pool_checked=true if A.save() && done!=nil {done()} A.redraw() return}}
        if v.nextAfter!=nil && seen.len()<64 {
            for previous in seen {if previous==v.nextAfter {H.notice=A.t("Pool lookup is incomplete. Refresh to try again.","资源池查询不完整，请刷新重试。") return}}
            seen.push(v.nextAfter) load(v.nextAfter) return
        }
        H.notice=A.t("This resource pool is no longer available to this account.","当前账号无法再访问此资源池。")
    })}
    load(nil)
}
A.pool_tokens=fn(text){
    if H.pool_draft==nil || !A.pool_editable(){return}
    H.pool_draft.tokens=text H.pool_draft.failure=nil H.pool_draft.review=false A.save() A.pool_sync_amount()
}
A.pool_ratio=fn(ratio){
    if H.pool_draft==nil || !A.pool_editable() || !H.pool_checked{return}
    let limit=A.pool_limit(H.pool_draft.pool) if limit==nil || limit<1{return}
    A.pool_tokens(""+max(1,min(limit,floor(limit*max(0,min(1,ratio))+0.5))))
}
A.pool_edit=fn(){if H.pool_draft!=nil && A.pool_editable(){H.pool_draft.review=false A.save() A.redraw()}}
A.pool_review=fn(){
    let d=H.pool_draft
    if !A.pool_editable(){return}
    if !A.pool_valid(d){H.notice=A.t("Check the highlighted fields before continuing.","请修改表单中标出的内容后继续。") A.redraw() return}
    d.failure=nil d.review=true A.save() A.redraw()
}
A.pool_send=fn(){
    if !A.pool_editable() || H.pool_draft==nil{return}
    let d=H.pool_draft let original=d.pool
    if !d.review || !A.pool_valid(d){d.review=false A.save() A.redraw() return}
    A.pool_lookup(fn(){
        if H.pool_draft!=d{return}
        if original.revision!=d.pool.revision || original.grantRevision!=d.pool.grantRevision || A.pool_limit(original)!=A.pool_limit(d.pool) || !A.pool_valid(d){
            d.review=false d.failure="management_revision_changed" A.save() A.redraw() return
        }
        A.pool_send_verified()
    })
}
A.pool_send_verified=fn(){
    if !A.pool_editable() || H.pool_draft==nil{return}
    let d=H.pool_draft
    if !d.review || !A.pool_valid(d){d.review=false H.notice=A.t("Application not submitted. Check the amount and resource limit.","申请未提交，请核对额度和资源池限额。") A.save() A.redraw() return}
    if d.roomCommand==""{
        A.request("hagency.intent.new",{},fn(v){d.roomCommand=v.commandId if A.save(){A.pool_send()}}) return
    }
    if d.roomId==""{
        A.request("hagency.pools.agents.room",{commandId:d.roomCommand name:d.name},fn(v){
            if v.creation.phase=="complete" && v.creation.roomId!=nil{d.roomId=v.creation.roomId if A.save(){A.pool_send()}}
            else{H.notice=A.t("Conversation creation is pending. Continue to recover the same request.","会话创建结果尚待确认。请继续以恢复同一请求。") A.save()}
        }) return
    }
    A.submit("hagency.pools.agents.request",{poolId:d.pool.id request:{roomId:d.roomId expectedPoolRevision:d.pool.revision expectedGrantRevision:d.pool.grantRevision definition:{name:d.name.trim() description:d.description capability:d.capability toolMode:"none"} requestedTokens:d.tokens.trim().to_f64()}})
}
A.pool_decide=fn(){
    let r=H.pool_detail if r==nil{return}
    if H.pool_confirm=="stop"{A.submit("hagency.pools.agents.stop",{requestId:r.id expectedRevision:r.revision})}
    else{A.submit("hagency.pools.agents.decide",{requestId:r.id expectedRevision:r.revision approve:H.pool_confirm=="approve"})}
}

A.pool_sync_amount=fn(){
    let d=H.pool_draft let limit=A.pool_limit(d.pool) let amount=A.web_int(d.tokens,-1)
    let error=A.pool_amount_error(d)
    ui.pool_tokens.set_text(d.tokens)
    ui.pool_slider.set_value(if limit!=nil && limit>0{max(0,min(1,amount/limit))}else{0})
    ui.pool_amount_error.set_text(error) ui.pool_amount_error_box.set_visible(error!="")
    ui.pool_failure_box.set_visible(false)
    ui.pool_review.set_enabled(A.pool_valid(H.pool_draft))
}

A.render_page = fn(){
    loading := mod.widgets.HagencyStatus{visible:H.busy
        mod.widgets.LoadingSpinner{width:20 height:20}
        mod.widgets.HagencyCopy{text:A.t("Loading current data…","正在读取最新数据…")}
    }
    if H.ready && H.page=="overview" {
        if H.entry_role=="" || H.entry_choosing {
            entry_intro := mod.widgets.HagencySection{
                mod.widgets.HagencyEyebrow{text:A.t("YOUR WORKSPACE","你的工作台")}
                mod.widgets.HagencyTitle{text:A.t("What would you like to manage?","选择这次要做的事")}
                mod.widgets.HagencyCopy{text:A.t("Choose a workspace for this account. You can switch whenever your task changes.","为当前账号选择工作台，任务变化时可随时切换。")}
            }
            entry_manager_card := mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.person}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Agent manager","Agent 管理者")}
                        mod.widgets.HagencyHint{text:A.t("Use Agents to get work done","申请 Agent，使用资源完成工作")}
                    }
                    entry_manager := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && A.entry_allowed("manager") text:A.t("Open","进入") on_click:||A.entry_choose("manager")}
                }
                mod.widgets.HagencyCopy{text:A.t("Choose a resource pool, manage your Agents, and track their work and usage.","选择资源池、管理自己的 Agent，查看任务和用量。")}
            }
            entry_owner_card := mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.resources}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Resource owner","资源 Owner")}
                        mod.widgets.HagencyHint{text:A.t("Supply and coordinate resources","提供资源，协调容量与权限")}
                    }
                    entry_owner := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && A.entry_allowed("owner") text:A.t("Open","进入") on_click:||A.entry_choose("owner")}
                }
                mod.widgets.HagencyCopy{text:A.t("Connect accounts and resources, approve capacity requests, and control execution permissions.","接入账号与资源、审批容量申请、设置执行权限。")}
            }
            entry_admin_card := mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.inbox}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Server admin","服务器 Admin")}
                        mod.widgets.HagencyHint{text:A.t("Manage admission to your server","管理服务器准入与连接")}
                    }
                    entry_admin := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && A.entry_allowed("admin") text:A.t("Open","进入") on_click:||A.entry_choose("admin")}
                }
                mod.widgets.HagencyCopy{text:A.t("Review resource admission and inspect server connections and administrative records.","审核资源准入，查看服务器连接与管理记录。")}
                entry_admin_access := mod.widgets.HagencyHint{visible:!A.entry_allowed("admin") text:A.t("This account does not have server admission permission.","当前账号没有服务器准入管理权限。")}
            }
            entry_scope := mod.widgets.HagencyHint{text:A.t("One account can use multiple workspaces. Available actions follow its current permissions.","同一账号可使用多个工作台，操作范围以当前权限为准。")}
        } else {
            workspace_hero := mod.widgets.HagencyHero{
                mod.widgets.HagencyHeroTitle{text:A.entry_label(H.entry_role)}
                mod.widgets.HagencyHeroCopy{text:if H.entry_role=="manager"{A.t("Your Agents, their resources, and the work they do.","管理你的 Agent、使用的资源与完成的工作。")}else if H.entry_role=="owner"{A.t("Your resources, capacity decisions, and execution permissions.","管理你的资源、容量审批与执行权限。")}else{A.t("Your server's resource admission and management records.","管理服务器的资源准入与连接记录。")}}
                mod.widgets.HagencyActions{
                    workspace_primary := mod.widgets.HagencyHeroButton{text:if H.entry_role=="manager"{A.t("My Agents","我的 Agent")}else if H.entry_role=="owner"{A.t("My resources","我的资源")}else{A.t("Review admission","审核资源准入")} enabled:!H.busy on_click:||{if H.entry_role=="manager"{A.navigate("pool_agents")}else if H.entry_role=="owner"{A.navigate("resources")}else{A.navigate("inbox")}}}
                }
            }
            manager_shortcuts := mod.widgets.HagencyCard{visible:H.entry_role=="manager"
                mod.widgets.HagencySectionTitle{text:A.t("Start or continue your work","开始或继续工作")}
                mod.widgets.HagencyCopy{text:A.t("Request an Agent directly from a resource pool. The resource owner approves its capacity.","直接从资源池申请 Agent，由资源 owner 审批容量。")}
                mod.widgets.HagencyActions{
                    workspace_pools := mod.widgets.HagencyButton{text:A.t("Browse resource pools","浏览资源池") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.projects enabled:!H.busy on_click:||A.navigate("pools")}
                    workspace_work := mod.widgets.HagencyButton{text:A.t("Tasks and activity","任务与活动") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.tasks enabled:!H.busy on_click:||A.navigate("tools")}
                    pool_continue := mod.widgets.HagencyButton{visible:H.pool_draft!=nil text:A.t("Continue saved Agent request","继续已保存的 Agent 申请") enabled:!H.busy on_click:||A.navigate("pool_apply")}
                }
            }
            owner_shortcuts := mod.widgets.HagencyCard{visible:H.entry_role=="owner"
                mod.widgets.HagencySectionTitle{text:A.t("Supply and approvals","资源供给与审批")}
                mod.widgets.HagencyCopy{text:A.t("You coordinate your resources. Review applicants here, and configure permissions on the resource they use.","由你协调自己的资源。在这里审核申请，并在对应资源中设置执行权限。")}
                mod.widgets.HagencyActions{
                    workspace_supply := mod.widgets.HagencyButton{text:A.t("Connect a resource","接入资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add enabled:!H.busy on_click:||A.begin_setup()}
                    workspace_approvals := mod.widgets.HagencyButton{text:A.t("Resource requests","资源使用审批") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox enabled:!H.busy on_click:||{H.needs_action=true A.navigate("inbox")}}
                }
            }
            admin_shortcuts := mod.widgets.HagencyCard{visible:H.entry_role=="admin"
                mod.widgets.HagencySectionTitle{text:A.t("Server management","服务器管理")}
                mod.widgets.HagencyCopy{text:A.t("Admission lets a resource join this server. The resource owner controls its capacity and Agent permissions.","准入允许资源加入此服务器，容量与 Agent 执行权限由资源 owner 管理。")}
                mod.widgets.HagencyActions{
                    workspace_connections := mod.widgets.HagencyButton{text:A.t("Server connections","服务器连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection enabled:!H.busy on_click:||A.navigate("connections")}
                    workspace_console := mod.widgets.HagencyButton{text:A.t("Management console","管理控制台") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.activity enabled:!H.busy on_click:||A.navigate("tools")}
                }
            }
        }
    }

    if H.ready && (H.page=="pools" || H.page=="pool_apply" || H.page=="pool_agents" || H.page=="pool_agent" || (H.page=="inbox" && H.entry_role=="owner")) {

    if !A.pool_enabled(){mod.widgets.HagencyCard{
        mod.widgets.HagencyTitle{text:A.t("Resource pools","资源池")}
        mod.widgets.HagencyCopy{text:A.t("This server needs the resource-pool Agent update before accepting new requests.","此服务器需要更新资源池 Agent 流程后才能接受新申请。")}
    }} else {
    if H.page=="pools"{
        mod.widgets.HagencyTitle{text:A.t("Resource pools","资源池")}
        mod.widgets.HagencyCopy{text:A.t("Pools from different owners appear together. Each Agent uses the pool you select.","不同 owner 提供的资源池会显示在一起，每个 Agent 使用你选定的资源池。")}
        if H.pool_rows.len()==0{mod.widgets.HagencyHint{text:A.t("No admitted resource pools found.","暂无已准入的资源池。")}}
        for row in H.pool_rows {let pool=row mod.widgets.HagencyCard{
            mod.widgets.HagencySectionTitle{text:pool.label}
            mod.widgets.HagencyCopy{text:A.t("Resource owner: ","资源 owner：")+pool.ownerMxid}
            mod.widgets.HagencyHint{text:pool.runtime+" · "+A.t("Published capacity: ","已发布容量：")+A.amount(pool.publishedTokens)+" token"}
            for capability in pool.capabilities {mod.widgets.HagencyHint{text:A.capability_label(capability)}}
            mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil && pool.canRequest text:A.t("Request Agent","申请 Agent") on_click:||A.pool_begin(pool)}
            if !pool.canRequest {mod.widgets.HagencyHint{text:if pool.blockingReason=="pool_not_shared_with_account"{A.t("Ask the resource owner to include your Matrix account in its capacity grant.","请资源 owner 在容量授权中加入你的 Matrix 账号。")}else{A.t("The owner needs to verify and publish capacity first.","owner 需要先验证并发布容量。")}}}
        }}
        if H.pool_after!=nil{mod.widgets.HagencyButton{text:A.t("Next page","下一页") enabled:!H.busy on_click:||A.load_pools(H.pool_after)}}
    }
    if H.page=="pool_apply" && H.pool_draft!=nil{let d=H.pool_draft
        let editable=A.pool_editable()
        let limit=A.pool_limit(d.pool)
        let amount=A.web_int(d.tokens,-1)
        let amount_error=A.pool_amount_error(d)
        let failure=A.recipient_optional(d,"failure")
        pool_application := mod.widgets.HagencyCard{
            mod.widgets.HagencyCardHeading{
                mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.person}}
                View{width:Fill height:Fit flow:Down spacing:4
                    mod.widgets.HagencyTitle{text:A.t("Request Agent","申请 Agent")}
                    mod.widgets.HagencyHint{text:d.pool.label+" · "+d.pool.ownerMxid}
                }
            }
            pool_pending := mod.widgets.HagencyStatus{visible:H.command!=nil
                mod.widgets.HagencyCopy{text:A.t("The previous submission is unresolved. Recover that request before editing.","上次提交结果尚未确认，请先恢复原申请再修改。")}
            }
            pool_failure_box := mod.widgets.HagencyStatus{visible:failure!=nil && failure!="" flow:Down draw_bg.color:mod.widgets.RINX_DANGER_BG
                pool_failure := mod.widgets.HagencyCopy{draw_text.color:mod.widgets.RINX_DANGER_FG text:if failure!=nil && failure!=""{A.pool_reason(failure)}else{""}}
            }
            pool_editor := mod.widgets.HagencyFormGroup{visible:!d.review
                    mod.widgets.HagencyFieldLabel{text:A.t("Agent name","Agent 名称")}
                    pool_name := mod.widgets.HagencyInput{text:d.name is_read_only:!editable || d.roomCommand!="" on_change:|s|{if A.pool_editable() && d.roomCommand=="" {d.name=s A.save() ui.pool_review.set_enabled(A.pool_valid(H.pool_draft))}}}
                    mod.widgets.HagencyFieldLabel{text:A.t("Instructions","说明")}
                    pool_description := mod.widgets.HagencyInput{text:d.description is_read_only:!editable on_change:|s|{if A.pool_editable(){d.description=s A.save()}}}
                    mod.widgets.HagencyFieldLabel{text:A.t("Capability","能力")}
                    mod.widgets.HagencyActions{for value in d.pool.capabilities{let cap=value
                        mod.widgets.HagencyChoice{text:A.capability_label(cap) enabled:editable draw_bg.color:if d.capability==cap{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE}
                            draw_text.color:if d.capability==cap{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_INK}
                            on_click:||{if A.pool_editable(){d.capability=cap d.failure=nil A.save() A.redraw()}}}
                    }}
            }
            pool_summary := mod.widgets.HagencySection{visible:d.review
                mod.widgets.HagencySectionTitle{text:d.name+" · "+d.capability}
                mod.widgets.HagencyCopy{text:d.description}
            }
            pool_allowance := mod.widgets.HagencyCard{draw_bg +: {color:mod.widgets.RINX_SELECTED border_size:0} spacing:10
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.resources}
                    mod.widgets.HagencySectionTitle{text:A.t("Token allowance","Token 额度")}
                    pool_limit_refresh := mod.widgets.HagencyIconButton{enabled:editable draw_icon.svg:mod.rinx_icons.refresh on_click:||A.pool_refresh()}
                }
                pool_limit := mod.widgets.HagencyCopy{text:A.t("Request limit: ","本次申请上限：")+if H.pool_checked && limit!=nil{A.amount(limit)+" tokens"}else{A.t("Refresh to verify","待刷新确认")}}
                pool_amount_editor := mod.widgets.HagencyFormGroup{visible:!d.review
                    mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Requested tokens","申请 token")}
                    pool_tokens := mod.widgets.HagencyInput{width:Fill text:d.tokens is_read_only:!editable on_change:|s|A.pool_tokens(s)}
                    pool_slider := mod.widgets.RinxAmountSlider{enabled:editable && H.pool_checked && limit!=nil && limit>0
                        value:if limit!=nil && limit>0{max(0,min(1,amount/limit))}else{0}
                        on_change:|ratio|A.pool_ratio(ratio)}
                    pool_range := View{width:Fill height:Fit flow:Right
                        mod.widgets.HagencyHint{width:Fill text:"1 token"}
                        mod.widgets.HagencyHint{width:Fit text:if H.pool_checked && limit!=nil{A.amount(limit)+" tokens"}else{"—"}}
                    }
                    pool_presets := mod.widgets.HagencyActions{
                        pool_ten := mod.widgets.HagencyButton{text:"10%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(0.1)}
                        pool_quarter := mod.widgets.HagencyButton{text:"25%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(0.25)}
                        pool_half := mod.widgets.HagencyButton{text:"50%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(0.5)}
                        pool_max := mod.widgets.HagencyButton{text:"100%" enabled:editable && H.pool_checked && limit!=nil && limit>0 on_click:||A.pool_ratio(1)}
                    }
                }
                pool_requested := mod.widgets.HagencyTitle{visible:d.review text:A.amount(amount)+" tokens"}
                pool_amount_error_box := mod.widgets.HagencyStatus{visible:amount_error!="" flow:Down draw_bg.color:mod.widgets.RINX_DANGER_BG
                        pool_amount_error := mod.widgets.HagencyCopy{draw_text.color:mod.widgets.RINX_DANGER_FG text:amount_error}
                }
                mod.widgets.HagencyHint{text:A.t("This is the request ceiling, not a confirmed reservation. Actual available capacity is checked after owner approval.","这是申请上限，额度尚未预留；owner 批准后还需确认实际可用容量。")}
            }
            pool_room_hint := mod.widgets.HagencyHint{visible:d.roomId!="" text:A.t("The existing conversation will be reused for this application.","此申请将继续使用已创建的聊天房间。")}
            pool_actions := mod.widgets.HagencyActions{

                pool_review := mod.widgets.RinxKeyPrimaryButton{visible:!d.review text:A.t("Review request","核对申请") enabled:editable && A.pool_valid(d) on_click:||A.pool_review()}
                pool_edit := mod.widgets.HagencyButton{visible:d.review text:A.t("Edit","修改") enabled:editable on_click:||A.pool_edit()}
                pool_submit := mod.widgets.RinxKeyPrimaryButton{visible:d.review text:A.t("Submit to resource owner","提交给资源 owner") enabled:editable && A.pool_valid(d) on_click:||A.pool_send()}
                pool_discard := mod.widgets.HagencyButton{visible:d.roomCommand=="" text:A.t("Discard draft","放弃草稿") enabled:editable on_click:||{if A.pool_editable(){H.pool_draft=nil A.save() A.navigate("pools")}}}
            
            }
        }
    }
    if H.page=="pool_agents" || H.page=="inbox"{
        mod.widgets.HagencyTitle{text:if H.entry_role=="owner"{A.t("Resource requests","资源使用审批")}else{A.t("My Agents","我的 Agent")}}
        mod.widgets.HagencyHint{text:if H.entry_role=="owner"{A.t("Review capacity requests for resources you own.","审核使用你所拥有资源的容量申请。")}else{A.t("Agents you requested and manage.","查看你申请并管理的 Agent。")}}
        if H.entry_role=="manager" && H.pool_draft!=nil{mod.widgets.HagencyButton{text:A.t("Continue saved application","继续未完成的申请") enabled:!H.busy on_click:||A.navigate("pool_apply")}}
        if H.entry_role=="owner"{owner_inbox_filters := mod.widgets.HagencyActions{
            owner_pending := mod.widgets.HagencyChoice{text:A.t("Needs approval","待审批") enabled:!H.busy draw_bg.color:if H.needs_action{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||A.inbox_filter(true)}
            owner_history := mod.widgets.HagencyChoice{text:A.t("All requests","全部申请") enabled:!H.busy draw_bg.color:if !H.needs_action{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||A.inbox_filter(false)}
        }}
        if A.pool_agent_rows().len()==0{mod.widgets.HagencyHint{text:A.t("No matching Agent requests on this page.","此页暂无符合条件的 Agent 申请。")}}
        for item in A.pool_agent_rows(){let r=item mod.widgets.HagencyCard{
            mod.widgets.HagencySectionTitle{text:r.definition.name}
            mod.widgets.HagencyCopy{text:A.pool_state(r)}
            mod.widgets.HagencyHint{text:r.poolLabel+" · "+r.resourceOwnerMxid}
            mod.widgets.HagencyHint{text:A.t("Applicant: ","申请者：")+r.managerMxid}
            mod.widgets.HagencyButton{text:if H.entry_role=="owner" && r.canDecide{A.t("Review request","审批申请")}else{A.t("View Agent","查看 Agent")} enabled:!H.busy on_click:||A.open_pool_agent(r.id)}
        }}
        if H.pool_agent_after!=nil{mod.widgets.HagencyButton{text:A.t("Next page","下一页") enabled:!H.busy on_click:||A.load_pool_agents(H.pool_agent_after)}}
    }
    if H.page=="pool_agent" && H.pool_detail!=nil{let r=H.pool_detail mod.widgets.HagencyCard{
        mod.widgets.HagencyTitle{text:r.definition.name}
        mod.widgets.HagencyCopy{text:A.pool_state(r)}
        if r.reservationReason!=nil{mod.widgets.HagencyHint{text:if r.reservationReason=="insufficient_capacity"{A.t("The resource device has insufficient free capacity. Remove this request and apply with a lower amount or another pool.","资源设备的可用容量不足。可移除此申请，再减少额度或选择其他资源池。")}else{A.error_text(r.reservationReason)}}}
        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Managed by","管理者")} mod.widgets.HagencyCopy{text:r.managerMxid}}
        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Resource owner","资源 owner")} mod.widgets.HagencyCopy{text:r.resourceOwnerMxid}}
        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Resource pool","资源池")} mod.widgets.HagencyCopy{text:r.poolLabel}}
        mod.widgets.HagencyCopy{text:r.definition.capability+" · "+A.amount(r.requestedTokens)+" token"}
        mod.widgets.HagencyCopy{text:r.definition.description}
        if r.membershipState=="matrix_verified"{mod.widgets.HagencyHint{text:A.t("Open the Agent's named conversation from the chat list. Enable automatic replies to send work.","从聊天列表打开以 Agent 名称命名的会话，启用自动回复后可发送任务。")}}
        if r.assignmentId!=nil{mod.widgets.HagencyButton{text:A.t("Budget and top-ups","额度与追加") enabled:!H.busy on_click:||A.open_agent_budget(r.id,r.definition.name,nil,1)}}
        if r.assignmentId!=nil && r.managerMxid==H.session.account{mod.widgets.HagencyButton{text:A.t("Execution and automatic replies","执行与自动回复") enabled:!H.busy on_click:||A.open_agent_control(r.assignmentId,r.definition.name)}}
        if H.pool_confirm==""{mod.widgets.HagencyActions{
            if H.entry_role=="owner" && r.canDecide{mod.widgets.RinxKeyPrimaryButton{text:A.t("Approve capacity","批准容量") enabled:!H.busy on_click:||{H.pool_confirm="approve" A.redraw()}} mod.widgets.HagencyButton{text:A.t("Reject","拒绝") enabled:!H.busy on_click:||{H.pool_confirm="reject" A.redraw()}}}
            if (H.entry_role=="manager" && r.canCancel) || (H.entry_role=="owner" && r.canStopSupply){mod.widgets.HagencyButton{text:if H.entry_role=="manager"{A.t("Remove Agent","移除 Agent")}else{A.t("Stop resource supply","停止资源供给")} enabled:!H.busy on_click:||{H.pool_confirm="stop" A.redraw()}}}
        }}else{
            mod.widgets.HagencyHint{text:if H.pool_confirm=="approve"{A.t("Approve this Agent's requested capacity? The resource device confirms the actual reservation.","批准此 Agent 的申请额度？实际预留由资源设备确认。")}else if H.pool_confirm=="stop"{A.t("Stop new work for this Agent? Consumed and unresolved usage stays retained until cleanup is confirmed.","停止此 Agent 的新任务？已消耗和未明确用量会保留，直到清理得到确认。")}else{A.t("Reject this Agent request?","拒绝此 Agent 申请？")}}
            mod.widgets.HagencyActions{mod.widgets.HagencyButton{text:A.t("Cancel","取消") enabled:!H.busy on_click:||{H.pool_confirm="" A.redraw()}} mod.widgets.RinxKeyPrimaryButton{text:A.t("Confirm","确认") enabled:!H.busy && H.command==nil on_click:||A.pool_decide()}}
        }
    }}

    }
    }
    if H.needs_signin {mod.widgets.HagencyCard{
        mod.widgets.HagencyTitle{text:A.t("Restore Hagency access", "恢复 Hagency 访问")}
        mod.widgets.HagencyCopy{text:A.error_text("native_resume_missing")}
        mod.widgets.HagencyActions{signin_again := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Sign in again", "重新登录") on_click: || A.reauthenticate()}}
    }}
    if !H.ready {
        mod.widgets.HagencyCard{
            mod.widgets.HagencyTitle{text: A.t("Welcome to Hagency", "欢迎使用 Hagency")}
            mod.widgets.HagencyCopy{text: A.t("Connect this device's agent resources to your Matrix server. Use your current account for every step.", "将此设备的 Agent 资源连接到 Matrix 服务器，全程使用当前账号。")}
            mod.widgets.HagencyHint{text: A.t("Resource owners publish pools and approve Agent requests. Your server administrator reviews resource admission.", "资源 owner 发布资源池并审批 Agent 申请，服务器管理员审核资源准入。")}
            if !H.needs_signin {View{width:Fill height:Fit retry := mod.widgets.RinxKeyPrimaryButton{text: A.t("Connect with my account", "使用当前账号连接") on_click: || A.connect()}}}
        }
    } else {
        if H.ux.origin!="" && H.page!=H.ux.origin {mod.widgets.HagencyActions{
            origin_back := mod.widgets.HagencyButton{enabled:!H.busy text:if H.ux.origin=="inbox"{A.t("Back to Inbox","返回待办")}else{A.t("Back to overview","返回概览")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.return_origin()}
        }}
        if H.ux.resourceJourney && A.has_page(["provider_accounts","provider_account","account_prepare","account_enrollment","resource_detail","wizard","action"]) {mod.widgets.HagencySection{
    mod.widgets.HagencyEyebrow{text:A.t("CONNECT A RESOURCE","连接资源")}
    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
        for step in [{n:0 title:A.t("Account","账号")},{n:1 title:A.t("Resource","资源")},{n:2 title:A.t("Admission","准入")},{n:3 title:A.t("Verification","验证")}] {
            RoundedView{width:Fit height:Fit padding:Inset{left:10 right:10 top:6 bottom:6} draw_bg +: {color:if A.resource_stage()==step.n{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_PAGE} border_radius:theme.corner_radius}
                mod.widgets.HagencyHint{width:Fit text:""+(step.n+1)+"  "+step.title draw_text.color:if A.resource_stage()==step.n{mod.widgets.RINX_ACCENT}else{mod.widgets.RINX_MUTED}}
            }
        }
    }
    mod.widgets.HagencyHint{text:if A.resource_stage()==0{A.t("Choose a provider account, then sign in on the provider’s page.","选择模型服务账号，然后在服务商页面登录。")}else if A.resource_stage()==1{A.t("Choose what this device can contribute: model, capabilities and budget.","选择此设备提供的模型、能力与预算。")}else if A.resource_stage()==2{A.t("The server administrator reviews admission; you approve allocation of your capacity.","服务器管理员审核准入，由你批准自己的容量分配。")}else{A.t("The resource owner verifies the connection from this device.","资源主人在此设备验证连接。")}}
}}
        if H.command == nil && H.saved_commands.len() > 0 {mod.widgets.HagencyCard{
            mod.widgets.HagencyCopy{text:A.t("Saved requests", "已保存的请求")}
            mod.widgets.HagencyHint{text:A.t("Your unfinished request is saved. Resume it without submitting a duplicate.", "未完成的请求已保存，恢复时不会重复提交。")}
            for row in H.saved_commands {View{width:Fill height:Fit flow:Down spacing:8
                mod.widgets.HagencyCopy{text:A.saved_label(row.operation)}
                if row.operation=="web_catalog"{View{width:Fit height:Fit web_saved_review := mod.widgets.HagencyButton{text:A.t("Review saved resource change","核对已保存的资源更改") enabled:!H.busy on_click:||A.open_saved_web(row)}}} else if A.is_template_operation(row.operation){View{width:Fit height:Fit template_saved_review := mod.widgets.HagencyButton{text:A.t("Review saved template change","核对已保存的模板更改") enabled:!H.busy on_click:||A.open_saved_template(row)}}} else if A.is_graph_operation(row.operation) {View{width:Fit height:Fit graph_saved_review := mod.widgets.HagencyButton{text:A.t("Review saved graph change","核对已保存的任务图更改") enabled:!H.busy on_click:||A.open_saved_graph(row)}}} else if A.is_task_operation(row.operation) {View{width:Fit height:Fit task_saved_review := mod.widgets.HagencyButton{text:A.t("View saved task change","查看已保存的任务更改") enabled:!H.busy on_click:||A.open_saved_task(row)}}} else if row.error != nil {
                    mod.widgets.HagencyHint{text:A.error_text(row.error)}
                    dismiss_saved := mod.widgets.HagencyButton{text:A.t("Dismiss recorded result", "确认已查看结果") on_click: || A.acknowledge(row.commandId)}
                } else {
                    recover_native := mod.widgets.RinxKeyPrimaryButton{text:if row.hasReply {A.t("Recover recorded result", "恢复已记录的结果")} else {A.t("Retry original request", "重试原请求")} on_click: || A.recover_native(row)}
                }
            }}
        }}
        if H.command != nil {
            mod.widgets.HagencyCard{
                mod.widgets.HagencyCopy{text: A.t("A saved request needs its result", "有一条已保存的请求等待结果")}
                mod.widgets.HagencyHint{text: A.t("Resume this request to see its result. It cannot create a second resource or approve twice.", "恢复此请求以查看结果，不会重复创建资源或重复审批。")}
                if A.web_connection_service(H.command.service){View{width:Fit height:Fit web_connection_saved_check := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Check saved result","检查保存结果") on_click:||A.web_connection_check()}}}
                retry_saved := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text: A.t("Recover saved request", "恢复原请求") on_click: || A.retry_command()}
            }
        }
        if false && H.page=="overview" {
            mod.widgets.HagencySection{
                mod.widgets.HagencyTitle{text:A.t("Your workspace","你的工作台")}
                mod.widgets.HagencyHint{text:A.t("Your next steps, across projects and resources.","集中查看项目与资源的下一步。")}
            }
            if H.ux.dashboard==nil {mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:if H.busy{A.t("Checking your pending work…","正在检查待办…")}else{A.t("Could not load your workspace","暂时无法加载工作台")}}
                mod.widgets.HagencyHint{text:A.t("Refresh to check the latest requests. Saved work is retained.","刷新以查看最新请求，已保存的工作会保留。")}
            }}
            if H.ux.dashboard!=nil {mod.widgets.HagencyCard{
                let d=H.ux.dashboard
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.inbox}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:if d.requests.len()+d.agents.len()>0{A.t("Needs your action","需要你处理")}else if H.ux.dashboardError{A.t("Some updates could not be loaded","部分更新暂时无法加载")}else if d.complete{A.t("You’re up to date","暂无待处理事项")}else{A.t("Checking your pending work…","正在检查待办…")}}
                        mod.widgets.HagencyHint{text:if d.requests.len()+d.agents.len()>0{A.queue_count()+A.t(" pending requests found"," 条待办")}else{A.t("Requests stay in Inbox until a decision is recorded.","请求会保留在待办中，直到决定被记录。")}}
                    }
                    overview_inbox := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Open Inbox","打开待办") on_click:||{H.needs_action=true A.navigate("inbox")}}
                }
                for i in min(3,d.requests.len()) {mod.widgets.HagencyRow{
                    let row=d.requests[i] let {projectName=nil,resourceLabel=nil}=row
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:if projectName!=nil{projectName}else if resourceLabel!=nil{resourceLabel}else{A.t("Resource admission","资源准入")}}
                        mod.widgets.HagencyHint{text:if row.kind=="project_capacity"{A.t("Project approval","项目审批")}else if row.kind=="project_allocation"{A.t("Capacity allocation","容量分配")}else{A.t("Resource admission","资源准入")}}
                    }
                    overview_request := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Review","审核") on_click:||A.open_request(row.id)}
                }}
                for i in min(2,d.agents.len()) {mod.widgets.HagencyRow{
                    let row=d.agents[i]
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:row.definition.name}
                        mod.widgets.HagencyHint{text:A.t("Project agent approval","项目 Agent 审批")}
                    }
                    overview_agent := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Review","审核") on_click:||A.open_agent(row.id)}
                }}
            }}
            if H.ux.resourceJourney || H.project_draft.resource!=nil {mod.widgets.HagencyCard{
                mod.widgets.HagencySectionTitle{text:A.t("Continue where you left off","继续未完成的设置")}
                mod.widgets.HagencyActions{
                    if H.project_draft.resource!=nil {View{width:Fit height:Fit resume_project := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Continue project request","继续项目申请") on_click:||A.begin_project()}}}
                    if H.ux.resourceJourney {View{width:Fit height:Fit resume_resource := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Continue resource setup","继续资源设置") on_click:||A.begin_setup()}}}
                }
            }}
            if A.projects_enabled() {mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.projects}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Projects you can access","你可访问的项目")}
                        mod.widgets.HagencyHint{text:A.t("Decisions, capacity and agents.","审批、容量与 Agent。")}
                    }
                }
                mod.widgets.HagencyActions{begin_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Request a project","申请项目") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click:||A.begin_project()}}
                if H.ux.dashboard!=nil {View{width:Fill height:Fit flow:Down spacing:8
                    let d=H.ux.dashboard
                    if d.projects.len()==0 {mod.widgets.HagencyHint{text:A.t("Choose an available resource and describe the work. The server administrator reviews new projects.","选择可用资源并说明工作目标，新项目由服务器管理员审核。")}}
                    for i in min(3,d.projects.len()) {mod.widgets.HagencyRow{
                        let row=d.projects[i]
                        View{width:Fill height:Fit flow:Down spacing:4
                            mod.widgets.HagencySectionTitle{text:row.name}
                            mod.widgets.HagencyHint{text:A.project_state_text(row.state)}
                        }
                        overview_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View progress","查看进度") on_click:||{H.ux.origin="overview" A.open_project(row.id)}}
                    }}
                    if d.projects.len()>3 || d.projectAfter!=nil {View{width:Fit height:Fit overview_projects_all := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("All projects","全部项目") on_click:||A.navigate("projects")}}}
                }}
            }}
            mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{
                    mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.resources}}
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:A.t("Contribute this device’s capacity","贡献此设备的资源")}
                        mod.widgets.HagencyHint{text:A.t("Own a provider account? Connect it, choose a model, then request server admission.","如果你拥有模型服务账号，可连接账号、选择模型，再申请服务器准入。")}
                    }
                }
                mod.widgets.HagencyActions{
                    setup := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Connect a resource","连接资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.begin_setup()}
                    overview_connections := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Server connections","服务器连接") on_click:||A.navigate("connections")}
                }
                for i in min(2,H.connections.len()) {mod.widgets.HagencyRow{
                    let row=H.connections[i]
                    View{width:Fill height:Fit flow:Down spacing:4
                        mod.widgets.HagencySectionTitle{text:row.label}
                        mod.widgets.HagencyHint{text:A.connection_status(row)}
                    }
                    open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View connection","查看连接") on_click:||A.open_connection(row.id)}
                }}
            }
            mod.widgets.HagencyRow{
                mod.widgets.HagencyHint{text:A.t("Usage, activity, tasks and advanced management","用量、活动、任务与高级管理")}
                overview_tools := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Tools & activity","工具与活动") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.activity on_click:||{H.page="tools" A.redraw()}}
            }
        }
        if H.page=="tools" {
            mod.widgets.HagencyActions{tools_back := mod.widgets.HagencyButton{text:A.t("Back to overview","返回概览") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.navigate("overview")}}
            mod.widgets.HagencyTitle{text:if H.entry_role=="admin"{A.t("Management console","管理控制台")}else if H.entry_role=="owner"{A.t("Resource activity","资源活动")}else{A.t("Tasks and activity","任务与活动")}}
            console_capabilities := mod.widgets.HagencyCard{visible:H.entry_role!="manager"
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.activity}} mod.widgets.HagencyTitle{text:A.t("Management console","管理控制台")}}
                mod.widgets.HagencyCopy{text:A.t("See your team, available capabilities, account capacity and usage together.","集中查看 Agent 团队、可用能力、账号容量与用量。")}
                mod.widgets.HagencyActions{for kind in ["workforce","capability","usage","accounts","alerts"]{View{width:Fit height:Fit web_console_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.web_title(kind) icon_walk:Walk{width:16 height:16} draw_icon.svg:if kind=="workforce" {mod.rinx_icons.person} else {if kind=="usage" {mod.rinx_icons.activity} else {if kind=="alerts" {mod.rinx_icons.inbox} else {if kind=="accounts" {mod.rinx_icons.connection} else {mod.rinx_icons.resources}}}} on_click:||A.open_web(kind,nil)}}}}
            }


            if H.entry_role=="manager" && A.cleanup_enabled() {mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.inbox}} mod.widgets.HagencyTitle{text:A.t("Agent removal and cleanup","Agent 移除与清理")}}
                mod.widgets.HagencyCopy{text:A.t("Cancel or revoke requests within your project role and follow recorded cleanup progress.", "按你的项目角色取消或撤销申请，并查看已记录的清理进度。")}
                mod.widgets.HagencyActions{overview_cleanup := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View removal status", "查看移除状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_removals(nil,nil,1)}}
            }}
            if H.entry_role=="manager" && A.work_enabled() {mod.widgets.HagencyCard{
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.activity}} mod.widgets.HagencyTitle{text:A.t("Agent work history","Agent 任务历史")}}
                mod.widgets.HagencyCopy{text:A.t("Read recorded work and per-call usage for projects you manage or administer.", "查看你管理或负责审批的项目任务记录与每次调用的用量。")}
                mod.widgets.HagencyActions{overview_work := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View work history", "查看任务历史") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_work_list(nil,nil,1)}}
            }}
            manager_work_tools := mod.widgets.HagencyCard{visible:H.entry_role=="manager"
                mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.tasks}} mod.widgets.HagencyTitle{text:A.t("Tasks and board","任务与看板")}}
                mod.widgets.HagencyCopy{text:A.t("Track tasks, comments and workflow stages. Agent execution history is recorded separately.","查看任务、评论与流程阶段；Agent 执行历史单独记录。")}
                mod.widgets.HagencyActions{
                    operator_tasks_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View tasks","查看任务") on_click:||{H.task_from_board=false A.open_tasks(0)}}
                    operator_board_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Task board","任务看板") on_click:||A.open_board({})}
                    operator_graphs_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Task graphs","任务图") on_click:||A.open_flows(nil)}
                    operator_graph_history_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Task graph history","任务图历史") on_click:||A.open_graph_archives()}
                }
            }

            manager_personal := mod.widgets.HagencyCard{visible:H.entry_role=="manager"
                mod.widgets.HagencySectionTitle{text:A.t("Personal Agents","个人 Agent")}
                mod.widgets.HagencyCopy{text:A.t("Configure your own Agents and their execution-device settings.","配置你自己的 Agent 及其执行设备设置。")}
                personal_entry := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Personal-agent settings","个人 Agent 设置") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.person on_click:||A.open_personal_agents(nil,1)}
            }
            mod.widgets.HagencyHint{text:A.t("Workspace: ","当前工作台：")+A.entry_label(H.entry_role)}
        }
        if H.page == "resources" {
            mod.widgets.HagencyFormGroup{
                mod.widgets.HagencyTitle{text:A.t("Resources", "资源")}
                mod.widgets.HagencyHint{text:A.t("Native ledger snapshot; provider-side limits may differ. Open a resource for its full identity and budget details.", "这里显示本机账本，模型服务端的实际额度可能不同。打开资源可查看完整标识与预算详情。")}
                mod.widgets.HagencyActions{
                    all := mod.widgets.HagencyChoice{enabled:!H.busy draw_bg.color:if H.capability==""{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_FIELD} text:A.t("All capabilities", "全部能力") on_click: || {H.capability="" H.ux.resourceCursor=nil A.refresh()}}
                    coding := mod.widgets.HagencyChoice{enabled:!H.busy draw_bg.color:if H.capability=="coding"{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_FIELD} text:A.t("Coding", "编程") on_click: || {H.capability="coding" H.ux.resourceCursor=nil A.refresh()}}
                    docs := mod.widgets.HagencyChoice{enabled:!H.busy draw_bg.color:if H.capability=="documentation"{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_FIELD} text:A.t("Documentation", "文档") on_click: || {H.capability="documentation" H.ux.resourceCursor=nil A.refresh()}}
                    add := mod.widgets.HagencyIconButton{enabled:!H.busy draw_icon.svg:mod.rinx_icons.add on_click: || A.new_resource()}
                    connections := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Server connections","服务器连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.navigate("connections")}
                    provider_accounts := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Provider accounts", "模型服务账号") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.open_accounts(nil)}
                    device_execution := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Execution on this device", "此设备上的执行") on_click: || A.open_execution(nil)}
                    shared_capacity := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Shared capacity", "共享容量") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.open_onboarding()}
                }
            }
            if H.resources.len() == 0 {mod.widgets.HagencyCard{
                mod.widgets.HagencyTitle{text: A.t("No resources in this view", "当前视图暂无资源")}
                mod.widgets.HagencyHint{text: A.t("Add a model-backed resource on this device, or choose another capability filter.", "在此设备添加模型资源，或选择其他能力筛选。")}
                create := mod.widgets.RinxKeyPrimaryButton{text: A.t("Add a resource", "添加资源") on_click: || A.new_resource()}
            }}
            for row in H.resources {mod.widgets.HagencyDetailCard{
                mod.widgets.HagencySection{
                    mod.widgets.HagencyCardHeading{mod.widgets.HagencyBadge{mod.widgets.HagencyGlyph{draw_icon.svg:mod.rinx_icons.resources}} mod.widgets.HagencySectionTitle{text:A.resource_title(row)}}
                    mod.widgets.HagencyHint{text:if A.local_name(row) != nil && A.local_name(row).name != "" {row.model + " · " + row.framework + A.t(" · Local name", " · 本地名称")} else {row.framework}}
                    mod.widgets.HagencyHint{text:A.t("Resource ID · ", "资源标识 · ") + A.resource_label_id(row.id)}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Available / limit", "可用 / 上限")}
                        mod.widgets.HagencySectionTitle{text:A.amount(row.budget.remainingTokens) + " / " + A.amount(row.budget.pool.ceiling)}
                    }
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Budget period", "预算周期")}
                        mod.widgets.HagencyCopy{text:A.resource_period(row.budget.pool.period)}
                    }
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Reserved", "已预留")}
                        mod.widgets.HagencyCopy{text:A.amount(row.budget.reserved) + A.t(" tokens", " token")}
                    }
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Observed usage", "已观测使用量")}
                        mod.widgets.HagencyCopy{text:A.amount(row.usage.spent) + A.t(" tokens", " token")}
                    }
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Capabilities", "能力")}
                        View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                            for capability in row.capabilities {mod.widgets.RinxLabel{padding:0 text:A.capability_label(capability)}}
                        }
                    }
                }
                mod.widgets.HagencyActions{
                    resource_detail := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View resource", "查看资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_resource(row.id)}
                    let connected=false
                    for connection in H.connections {if connection.resourceId == row.id && connection.ownerMxid == H.session.account && connection.executorDeviceId == H.session.device {connected=true}}
                    offer := mod.widgets.HagencyButton{enabled:!H.busy text:if connected {A.t("View connection", "查看连接")} else {A.t("Connect to this server", "连接到此服务器")} on_click: || A.resource_connection(row)}
                }
            }}
            if H.resource_after != nil {mod.widgets.HagencyActions{more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page", "下一页") on_click: || A.more()}}}
        }
        if H.page=="web_connections"{mod.widgets.HagencyDetailCard{
            let c=H.webConnection
            mod.widgets.HagencyTitle{text:A.t("External Matrix configuration","外部 Matrix 配置")}
            mod.widgets.HagencyHint{text:A.t("Discover a server, import its approved configuration, or maintain a registration. Your signed-in server’s resource admission is managed from Connections.","发现服务器、导入获批配置或维护注册信息。当前登录服务器的资源准入在「连接」页面管理。")}
            mod.widgets.HagencyActions{
                web_connections_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Connections","连接") on_click:||A.navigate("connections")}
                web_connection_new := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Add server","添加服务器") draw_icon.svg:mod.rinx_icons.add icon_walk:Walk{width:16 height:16} on_click:||A.web_connection_new()}
            }
            if c.list!=nil{View{width:Fill height:Fit flow:Down spacing:16
                if c.list.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No external server configurations yet.","暂无外部服务器配置。")}}
                for row in c.list.items{mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.label}
                    mod.widgets.HagencyCopy{text:row.id}
                    mod.widgets.HagencyHint{text:row.apiBaseUrl}
                    web_connection_details := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Connection details","连接详情") on_click:||A.web_connection_open(row.id)}
                }}
                mod.widgets.HagencyActions{
                    if c.after!=nil{View{width:Fit height:Fit web_connections_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.web_connections_open(nil)}}}
                    if c.list.nextAfter!=nil{View{width:Fit height:Fit web_connections_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.web_connections_open(c.list.nextAfter)}}}
                }
            }}
        }}
        if H.page=="web_connection_new" && H.webConnection.draft!=nil{mod.widgets.HagencyDetailCard{
            let c=H.webConnection let d=c.draft
            mod.widgets.HagencyTitle{text:A.t("Connect an external Matrix server","连接外部 Matrix 服务器")}
            mod.widgets.HagencyHint{text:A.t("1  Identify server    2  Check connection    3  Review configuration","1  指定服务器    2  检查连接    3  核对配置")}
            mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Server name","服务器名称")}
            web_server_name := mod.widgets.HagencyInput{empty_text:A.t("matrix.example.org","matrix.example.org") text:d.id on_change:|s|{if H.command==nil{d.id=s c.probe=nil}}}
            mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Display name","显示名称")}
            web_server_label := mod.widgets.HagencyInput{empty_text:A.t("Team server","团队服务器") text:d.label on_change:|s|{if H.command==nil{d.label=s}}}
            mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Homeserver URL","Homeserver 地址")}
            web_server_origin := mod.widgets.HagencyInput{empty_text:A.t("https://matrix.example.org","https://matrix.example.org") text:d.origin on_change:|s|{if H.command==nil{d.origin=s c.probe=nil}}}
            web_server_probe := mod.widgets.HagencyButton{width:Fit enabled:!H.busy && H.command==nil text:A.t("Check server","检查服务器") on_click:||A.web_connection_probe()}
            if c.probe!=nil{mod.widgets.HagencySection{
                mod.widgets.HagencyCopy{text:if c.probe.reachable{A.t("Matrix server is reachable","Matrix 服务器可连接")}else{A.t("Server check failed","服务器检查失败")}}
                mod.widgets.HagencyHint{text:c.probe.origin}
                if !c.probe.reachable{mod.widgets.HagencyHint{text:A.t("Check the address and network connection before continuing.","请检查地址与网络连接后继续。")}}
            }}
            mod.widgets.HagencyActions{
                web_server_create := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Review new connection","核对新连接") on_click:||A.web_connection_create(false)}
                web_server_import := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Import approved configuration","导入获批配置") on_click:||A.web_connection_create(true)}
                web_server_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back","返回") on_click:||A.web_connections_open(nil)}
            }
        }}
        if H.page=="web_connection" && H.webConnection.detail!=nil{mod.widgets.HagencyDetailCard{
            let c=H.webConnection let d=c.detail
            mod.widgets.HagencyActions{web_connection_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("External servers","外部服务器") on_click:||A.web_connections_open(nil)}}
            mod.widgets.HagencyTitle{text:d.label}
            mod.widgets.HagencyCopy{text:d.id}
            mod.widgets.HagencyHint{text:d.apiBaseUrl}
            mod.widgets.HagencyStatus{
                mod.widgets.HagencyCopy{text:if d.awaitingInstall{A.t("Registration awaits server installation","注册信息等待在服务器安装")}else if d.accessState=="accepted"{A.t("Connection verified","连接已验证")}else if d.hasCredential{A.t("Credentials stored; verification required","凭据已保存，等待验证")}else{A.t("No active credential","暂无有效凭据")}}
            }
            mod.widgets.HagencyHint{text:A.t("Local configuration and server admission are separate. This page does not start an agent or reserve server capacity.","本地配置与服务器准入分别管理，此页面不会启动 Agent 或预留服务器容量。")}
            mod.widgets.HagencyFormGroup{
                mod.widgets.HagencySectionTitle{text:A.t("Legacy connection allowance","旧版连接额度")}
                mod.widgets.HagencyHint{text:A.t("Kept for legacy fleet configuration. Resource-pool projects use their approved allocations; this value does not limit them.","用于保留旧版资源集群配置。资源池项目使用已审批的分配额度，不受此值限制。")}
                mod.widgets.HagencyCopy{text:A.amount(d.allocatedTokens)+" token"}
                mod.widgets.HagencyFieldLabel{width:Fill text:A.t("New declared allowance; blank clears it","新的声明额度，留空可清除")}
                web_connection_allowance := mod.widgets.HagencyNumberInput{minimum:0 empty_text:A.t("No declared allowance","未声明额度") text:c.tokens on_change:|s|{if H.command==nil{c.tokens=s}}}
                mod.widgets.HagencyHint{text:A.t("− / + adjusts by 100,000 tokens; type any exact amount.","− / + 每次调整 10 万 token，也可输入精确数量。")}
                web_connection_allowance_review := mod.widgets.HagencyButton{width:Fit enabled:!H.busy && H.command==nil text:A.t("Review allowance","核对额度") on_click:||A.web_connection_edit("allowance")}
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Private credentials","私密凭据")}
                mod.widgets.HagencyHint{text:A.t("Select a JSON file in the native dialog. Its credentials stay outside this mini app.","请在原生对话框选择 JSON 文件，凭据不会进入此小程序。")}
                mod.widgets.HagencyHint{text:A.t("Imported credentials can verify the representative account. Project management uses your signed-in Matrix account; legacy fleet transport is not started here.","导入的凭据可验证代表账号。项目管理使用当前登录的 Matrix 账号，此处不会启动旧版资源集群传输。")}
                mod.widgets.HagencyActions{
                    web_connection_import := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Import approved configuration","导入获批配置") on_click:||A.web_connection_edit("import")}
                    web_connection_replace := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Replace credentials","替换凭据") on_click:||A.web_connection_edit("replace")}
                    web_connection_verify := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil && (d.hasCredential || d.awaitingInstall) text:A.t("Verify connection","验证连接") on_click:||A.web_connection_edit("verify")}
                    web_connection_withdraw := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil && (d.hasCredential || d.awaitingInstall) text:A.t("Withdraw credentials","撤回凭据") on_click:||A.web_connection_edit("withdraw")}
                }
            }
            mod.widgets.HagencyFormGroup{
                mod.widgets.HagencySectionTitle{text:A.t("Appservice registration","应用服务注册")}
                mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Appservice callback URL","应用服务回调地址")}
                web_registration_url := mod.widgets.HagencyInput{empty_text:A.t("https://agent.example.org","https://agent.example.org") text:c.registrationUrl on_change:|s|{if H.command==nil{c.registrationUrl=s}}}
                mod.widgets.HagencyActions{
                    web_registration_issue := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:if d.registrationAvailable{A.t("Review reissue","核对重新签发")}else{A.t("Review registration","核对注册信息")} on_click:||A.web_connection_edit("issue")}
                    if d.registrationAvailable{View{width:Fit height:Fit web_registration_download := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Save private registration","保存私密注册文件") on_click:||A.web_connection_download()}}}
                }
                mod.widgets.HagencyHint{text:A.t("Install the downloaded registration on the Matrix server, then verify the connection. Reissue retains the current credential until the replacement passes verification.","将下载的注册文件安装到 Matrix 服务器，再验证连接。重新签发后，替代凭据通过验证前会保留当前凭据。")}
            }
        }}

        if H.page=="operator_graphs" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                flow_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Overview","概览") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||{H.page="overview" A.redraw()}}
                flow_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_flows(H.flow_after)}
                flow_create := mod.widgets.RinxKeyPrimaryButton{enabled:A.flow_can_edit() text:A.t("New graph","新建任务图") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click:||A.flow_new()}
            }
            mod.widgets.HagencyTitle{text:A.t("Task graphs","任务图")}
            mod.widgets.HagencyHint{text:A.flow_notice()}
            mod.widgets.HagencyActions{for status in ["","active","complete","failed","cancelled"]{View{width:Fit height:Fit flow_filter := mod.widgets.HagencyButton{enabled:!H.busy text:if status==""{A.t("All","全部")}else{A.flow_status(status)} on_click:||{H.flow_filter=status A.open_flows(nil)}}}}}
            if H.flow_list==nil {mod.widgets.HagencyCopy{text:if H.busy{A.t("Reading graphs…","正在读取任务图…")}else{A.t("Graphs unavailable. Refresh to try again.","任务图暂不可用，请刷新重试。")}}}
            if H.flow_list!=nil {mod.widgets.HagencySection{
                let page=H.flow_list
                if page.graphs.len()==0{mod.widgets.HagencyCopy{text:A.t("No matching graphs on this page","本页没有匹配的任务图")}}
                for graph in page.graphs{mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:graph.label}
                    mod.widgets.HagencyCopy{text:A.flow_status(graph.status)+" · "+graph.completeCount+" / "+graph.nodeCount}
                    mod.widgets.HagencyHint{text:A.flow_delivery(graph.deliveryState)}
                    mod.widgets.HagencyActions{flow_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View nodes","查看节点") on_click:||A.open_flow(graph.id,nil)}}
                }}
                mod.widgets.HagencyActions{
                    if H.flow_after!=nil{View{width:Fit height:Fit flow_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.open_flows(nil)}}}
                    if page.nextAfter!=nil{View{width:Fit height:Fit flow_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.open_flows(page.nextAfter)}}}
                }
            }}

                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                mod.widgets.HagencyHeroName{text:A.t("Permission Taken Back","已撤销工具权限")}
                mod.widgets.HagencyHint{width:Fill align:Align{x:0.5} text:A.t("Matching requests will need approval again.","以后同类请求需要重新审批。")}
            }
            if H.tool_last!=nil && H.tool_last.id==H.tool_result.grantId {mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:A.tool_kind_icon(H.tool_last.kind) draw_icon.color:mod.widgets.RINX_MUTED}}
                View{width:Fill height:Fit flow:Down spacing:3
                    mod.widgets.HagencyListTitle{text:H.tool_last.agent+" · "+A.tool_kind(H.tool_last.kind)}
                    mod.widgets.HagencyWrapSubtitle{max_lines:3 text_overflow:Ellipsis text:A.tool_rule_text(H.tool_last.details)}
                }
            }}}
            View{width:Fill height:Fit padding:Inset{top:10}
                tool_result_refresh := mod.widgets.HagencyWideButton{text:A.t("Done","完成") enabled:!H.busy on_click: || A.open_tools(H.tool_resource,H.tool_engagement,"","rules")}
            }
        }}}
        if H.page=="approval_binding_review" && H.binding_draft!=nil {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let d=H.binding_draft
            let current=A.binding_row(d)
            let active=current!=nil && current.active
            let key="binding:"+d.engagementId
            View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.chat draw_icon.color:mod.widgets.RINX_INFO_FG}}
                mod.widgets.HagencyHeroName{text:d.agent}
                mod.widgets.HagencyPill{draw_bg.color:if active {mod.widgets.RINX_SUCCESS_BG} else {mod.widgets.RINX_WARNING_BG}
                    mod.widgets.HagencyPillDot{draw_bg.color:if active {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyPillText{text:if active {A.t("Approval room working","审批聊天工作正常")} else {A.t("Approval room not available","审批聊天暂时不可用")} draw_text.color:if active {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_WARNING_FG}}
                }
            }

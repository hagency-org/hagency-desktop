                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Back to First Page","回到第一页")}}
                    }}
                }}
                mod.widgets.HagencyListNote{text:A.t("After you take one back, matching requests need approval again. Tool actions already started aren’t cancelled.","撤销后，同类请求需要重新审批；已经开始的工具操作不会被取消。")}
            }}
        }}}
        if H.page=="tool_grant_result" && H.tool_result!=nil {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{

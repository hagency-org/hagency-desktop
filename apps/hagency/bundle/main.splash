                            if v.canBind && v.blockingReasons.len()==0{View{width:Fit height:Fit recipient_prepare := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("3 · Review saved binding","3 · 核对保存的绑定") on_click:||A.recipient_prepare()}}}
                        }
                    }}

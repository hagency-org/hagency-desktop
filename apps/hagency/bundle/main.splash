            flow_node_condition := mod.widgets.HagencyInput{height:80 is_multiline:true text:n.conditionJson empty_text:A.t("Leave empty for no condition","留空表示无条件") on_change:|text|A.flow_set_node("conditionJson",text)}
            mod.widgets.HagencyHint{text:"{\"dep\":\"research\",\"path\":\"approved\",\"eq\":true}"}

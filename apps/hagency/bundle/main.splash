                                    pool_max_unsaved := mod.widgets.HagencyListValue{visible:unsaved.max!="" text:unsaved.max draw_text +: {color:mod.widgets.RINX_WARNING_FG text_style:theme.font_bold{font_size:mod.widgets.RINX_META_SIZE}}}
                                }
                                if clearing {View{width:Fill height:Fit flow:Down spacing:6
                                    pool_max_clearing := mod.widgets.HagencyWrapSubtitle{text:A.t("Once saved, sharing pauses: Agents can’t request it. Set a monthly maximum again to resume.","保存后暂停共享：Agent 不能再申请；以后设一个每月上限就能恢复。") draw_text.color:mod.widgets.RINX_WARNING_FG}
                                    pool_max_error := mod.widgets.HagencyWrapSubtitle{visible:false text:""}
                                }}
                                if !clearing {View{width:Fill height:Fit flow:Down spacing:8
                                    View{width:Fill height:Fit pool_max_tokens := mod.widgets.HagencyPoolSlider{minimum:v.maxMin maximum:v.maxMax text:if e!=nil {e.max} else {""} empty_text:A.t("Not set","未设置") is_read_only:H.command!=nil || locked unit +: {margin:Inset{top:(if mod.widgets.RINX_TEXT_SCALE>1.2 {7} else {0})}} slider_wrap +: {width:Fill amount_slider +: {enabled:H.command==nil && !locked}} on_change:|text| A.pool_max_changed(text)}}
                                    pool_max_error := mod.widgets.HagencyWrapSubtitle{visible:save.maxError!="" text:save.maxError draw_text.color:mod.widgets.RINX_DANGER_FG}
                                    if mod.widgets.RINX_TEXT_SCALE<=1.2 {View{width:Fill height:Fit flow:Right spacing:8
                                        mod.widgets.HagencyListValue{text:A.pool_max_floor_text(v)}
                                        View{width:Fill height:1}
                                        mod.widgets.HagencyListValue{text:A.pool_max_top_text(v)}
                                    }}
                                    if mod.widgets.RINX_TEXT_SCALE>1.2 {View{width:Fill height:Fit flow:Down spacing:2
                                        mod.widgets.HagencyWrapSubtitle{text:A.pool_max_floor_text(v)}
                                        mod.widgets.HagencyWrapSubtitle{text:A.pool_max_top_text(v)}
                                    }}
                                    if v.presets.len()>0 {View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                                        for amount in v.presets {let value=amount let on=e!=nil && !e.unlimited && A.pool_whole(e.max)==value View{width:Fit height:Fit
                                            if on {pool_max_preset := mod.widgets.HagencyPresetOn{text:A.tokens(value) enabled:!H.busy && H.command==nil && !locked on_click:||A.pool_max_preset(value)}}
                                            if !on {pool_max_preset := mod.widgets.HagencyPreset{text:A.tokens(value) enabled:!H.busy && H.command==nil && !locked on_click:||A.pool_max_preset(value)}}
                                        }}
                                    }}
                                    if b.ceiling==nil {mod.widgets.HagencyWrapSubtitle{text:A.t("Agents can request once it’s set.","设置后 Agent 才能申请。")}}
                                }}

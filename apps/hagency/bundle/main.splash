            mod.widgets.HagencySectionTitle{text:A.t("Recorded status","记录的状态")}
            mod.widgets.HagencyCopy{text:if u.changeStatus{A.flow_status(u.status)}else{A.t("Keep current status","保持当前状态")}}
            mod.widgets.HagencyActions{flow_status_keep := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Keep status","保持状态") on_click:||{u.changeStatus=false A.redraw()}} for status in ["pending","dispatched","active","complete","failed","skipped","cancelled"]{View{width:Fit height:Fit flow_status_choice := mod.widgets.HagencyButton{enabled:!H.busy text:A.flow_status(status) on_click:||{u.changeStatus=true u.status=status A.redraw()}}}}}
            mod.widgets.HagencySectionTitle{text:A.t("Result","结果")}
            mod.widgets.HagencyActions{
                flow_result_keep := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Keep result","保持结果") on_click:||{u.resultMode="keep" A.redraw()}}
                flow_result_set := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Replace result with JSON","使用 JSON 替换结果") on_click:||{u.resultMode="set" A.redraw()}}
            }
            if u.resultMode=="set"{mod.widgets.HagencyFormGroup{
                flow_result_json := mod.widgets.HagencyInput{height:100 is_multiline:true text:u.resultJson empty_text:A.t("Any JSON value; null clears the result","任意 JSON 值；null 表示清空结果") on_change:|text|{if !H.busy{u.resultJson=text}}}
                mod.widgets.HagencyHint{text:A.t("Objects, arrays, strings, numbers, booleans and null are preserved.","保留对象、数组、字符串、数字、布尔值及 null。")}
            }}
            mod.widgets.HagencySectionTitle{text:A.t("Error","错误")}
            mod.widgets.HagencyActions{
                flow_error_keep := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Keep error","保持错误") on_click:||{u.errorMode="keep" A.redraw()}}
                flow_error_set := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Replace or clear error","替换或清空错误") on_click:||{u.errorMode="set" A.redraw()}}
            }
            if u.errorMode=="set"{mod.widgets.HagencyFormGroup{flow_error_input := mod.widgets.HagencyInput{height:60 is_multiline:true text:u.error empty_text:A.t("Leave empty to clear","留空表示清空") on_change:|text|{if !H.busy{u.error=text}}}}}
            if H.flow_error!=""{mod.widgets.HagencyCopy{text:H.flow_error}}
        }}
        if H.page=="operator_graph_command" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyTitle{text:if H.flow_phase=="recorded"{A.t("Graph change saved","任务图更改已保存")}else if H.flow_phase=="failed"{A.t("Saved change was refused","已保存的更改被拒绝")}else if H.flow_phase=="unknown"{A.t("Check the original request","检查原请求")}else if H.flow_phase=="saved"{A.t("Review saved graph change","核对已保存的任务图更改")}else{A.t("Reading saved request…","正在读取已保存的请求…")}}
            mod.widgets.HagencyHint{text:A.flow_notice()}
            if H.flow_pending!=nil{mod.widgets.HagencySection{
                let p=H.flow_pending let change=p.change
                mod.widgets.HagencyHint{text:A.t("Graph ID","任务图 ID")+" · "+p.graphId+" · "+A.t("Expected revision","预期版本")+" "+p.expectedRevision}
                mod.widgets.HagencyHint{text:A.t("Saved request","已保存请求")+" · "+p.commandId}
                mod.widgets.HagencyCopy{text:if change.operation=="bind_recipient"{A.recipient_saved_state(p)}else{A.flow_delivery(p.deliveryState)}}
                if change.operation=="create"{mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:change.label}
                    let nodes=A.flow_review_nodes()
                    mod.widgets.HagencyCopy{text:A.t("Nodes","节点")+" · "+nodes.len()}
                    for index row in nodes{if index>=H.flow_review_offset && index<H.flow_review_offset+16{mod.widgets.HagencySection{
                        let node=row.data
                        mod.widgets.HagencySectionTitle{text:row.id+" · "+node.assignee}
                        mod.widgets.HagencyCopy{text:node.description}
                        mod.widgets.HagencyCopy{text:A.t("Dependencies","依赖节点")+" · "+node.dependsOn.to_json()}
                        if node.condition!=nil{mod.widgets.HagencyHint{text:A.t("Condition recorded · Open exact saved JSON to inspect it.","已记录条件 · 可展开保存的完整 JSON 核对。")}}
                    }}}
                    mod.widgets.HagencyActions{
                        if H.flow_review_offset>0{View{width:Fit height:Fit flow_review_previous := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Previous nodes","前面的节点") on_click:||{H.flow_review_offset=max(0,H.flow_review_offset-16) A.redraw()}}}}
                        if H.flow_review_offset+16<nodes.len(){View{width:Fit height:Fit flow_review_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More nodes","更多节点") on_click:||{H.flow_review_offset=H.flow_review_offset+16 A.redraw()}}}}
                    }
                }}
                if change.operation=="update_node"{mod.widgets.HagencyFormGroup{
                    mod.widgets.HagencySectionTitle{text:change.patch.nodeId}
                    mod.widgets.HagencyCopy{text:A.t("Exact saved patch","已保存的完整更改")}
                    flow_patch_json := mod.widgets.HagencyInput{height:180 is_multiline:true is_read_only:true text:p.changeJson}
                }}
                if change.operation=="create"{mod.widgets.HagencySection{
                    mod.widgets.HagencyActions{flow_review_json := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.flow_review_json{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} enabled:!H.busy text:if H.flow_review_json{A.t("Hide exact JSON","收起完整 JSON")}else{A.t("Inspect exact saved JSON","查看保存的完整 JSON")} on_click:||{H.flow_review_json=!H.flow_review_json A.redraw()}}}
                    if H.flow_review_json{mod.widgets.HagencyFormGroup{flow_saved_json := mod.widgets.HagencyInput{height:220 is_multiline:true is_read_only:true text:p.changeJson}}}
                }}
                if change.operation=="bind_recipient"{mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Exact saved recipient binding","保存的确切接收方绑定")}
                    mod.widgets.HagencyHint{text:A.recipient_notice()}
                    if change.snapshot!=nil{mod.widgets.HagencySection{
                        let identity=change.snapshot
                        let recipientMxid=A.recipient_optional(identity,"recipientMxid")
                        let roomId=A.recipient_optional(identity,"roomId")
                        mod.widgets.HagencyCopy{text:A.t("Node","节点")+" · "+change.nodeId}
                        mod.widgets.HagencyCopy{text:A.recipient_kind(identity.target.kind)}
                        mod.widgets.HagencyCopy{text:A.t("Current account","当前账号")+" · "+identity.account}
                        mod.widgets.HagencyCopy{text:A.t("Server","服务器")+" · "+identity.server}
                        if recipientMxid!=nil{mod.widgets.HagencyCopy{text:A.t("Recipient Matrix ID","接收方 Matrix ID")+" · "+recipientMxid}}
                        if roomId!=nil{mod.widgets.HagencyCopy{text:A.t("Room","房间")+" · "+roomId}}
                    }}
                    mod.widgets.HagencyActions{recipient_saved_details := mod.widgets.HagencyButton{enabled:!H.busy text:if H.flow_review_json{A.t("Hide technical details","收起技术详情")}else{A.t("Technical details","技术详情")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.search on_click:||{if !H.busy{H.flow_review_json=!H.flow_review_json A.redraw()}}}}
                    if H.flow_review_json{mod.widgets.HagencyFormGroup{recipient_saved_json := mod.widgets.HagencyInput{height:220 is_multiline:true is_read_only:true text:p.changeJson}}}
                }}
                if change.operation=="cancel"{mod.widgets.HagencyCopy{text:A.t("Cancel this graph and suppress its held dispatches? Completed node records remain available.","取消此任务图并抑制暂缓的派发？已完成节点的记录仍会保留。")}}
                if H.flow_phase=="saved"{mod.widgets.HagencyHint{text:A.t("This request is saved for review. Apply it only after checking its exact nodes and changes.","此请求已保存供核对，请检查完整节点与更改后再应用。")}}
                if H.flow_phase=="unknown"{mod.widgets.HagencyHint{text:A.t("The original request may have been applied. Check its saved result; do not create a replacement.","原请求可能已应用，请检查其保存结果，不要重复创建。")}}
                if H.flow_phase=="recorded"{mod.widgets.HagencyHint{text:if change.operation=="bind_recipient"{A.t("Recipient saved. This task has not been sent.","接收方已保存，此任务尚未发送。")}else{A.t("Saved locally. No runtime delivery was authorized by this change.","已保存到本地，此更改未授权运行时投递。")}}}
                mod.widgets.HagencyActions{
                    flow_command_check := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Check saved request","检查保存请求") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.flow_check_saved()}
                    if H.flow_phase=="saved"{View{width:Fit height:Fit flow_command_apply := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:if change.operation=="cancel"{A.t("Apply cancellation","应用取消")}else if change.operation=="bind_recipient"{A.t("Apply saved binding","应用已保存的绑定")}else{A.t("Apply saved change","应用已保存的更改")} on_click:||A.flow_apply()}}}
                    if H.flow_phase=="recorded" || H.flow_phase=="failed"{View{width:Fit height:Fit flow_command_close := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Close receipt and view graph","关闭回执并查看任务图") on_click:||A.flow_close_result()}}}
                }
            }}else{mod.widgets.HagencySection{
                mod.widgets.HagencyCopy{text:A.t("If a reply was lost, find the original request under Saved requests. Preparing a replacement could create a second graph.","如果响应丢失，请在“已保存的请求”中查找原请求。重新准备可能创建第二个任务图。")}
                mod.widgets.HagencyActions{flow_command_find := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Find saved request","查找保存请求") on_click:||A.flow_check_saved()}}
            }}
            if H.flow_error!=""{mod.widgets.HagencyCopy{text:if H.flow_pending!=nil && H.flow_pending.operation=="graph_bind_recipient"{A.recipient_reason(H.flow_error)}else{A.flow_reason(H.flow_error)}}}
        }}
        if H.page=="graph_archives" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                graph_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Overview","概览") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.navigate("overview")}
                graph_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_graph_archives()}
            }
            mod.widgets.HagencyTitle{text:A.t("Task graph history","任务图历史")}
            mod.widgets.HagencyCopy{text:A.t("Browse saved task graphs, progress and dependencies.","查看已保存的任务图、进度和依赖关系。")}
            if H.graph_archives==nil {mod.widgets.HagencyHint{text:if H.busy{A.t("Reading history…","正在读取历史…")}else{A.t("History unavailable. Refresh to try again.","历史暂不可用，请刷新重试。")}}}
            if H.graph_archives!=nil {View{width:Fill height:Fit flow:Down spacing:mod.widgets.RINX_SPACING
                let page=H.graph_archives
                if !page.supported {mod.widgets.HagencyHint{text:A.t("Graph history has not been transferred to this device profile.","任务图历史尚未迁移至此设备档案。")}}
                if page.supported && page.archives.len()==0 {mod.widgets.HagencyHint{text:A.t("No graph archives in this account","此账号暂无任务图归档")}}
                for row in page.archives {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.graph_state(row.state)}
                    mod.widgets.HagencyCopy{text:row.history.graphs.to_string()+A.t(" graphs · "," 个任务图 · ")+row.history.nodes.to_string()+A.t(" nodes"," 个节点")}
                    mod.widgets.HagencyHint{text:A.t("Archive: ","归档：")+row.commandId}
                    if row.state=="archived" {mod.widgets.HagencyActions{graph_archive_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View graphs","查看任务图") on_click:||A.open_graph_history(row.commandId,nil)}}}
                    if row.state!="archived" {mod.widgets.HagencyHint{text:A.t("This copy is incomplete. Its graphs become available after the transfer finishes.","此副本尚未完成，传输完成后才能查看任务图。")}}
                }}
            }}
        }}
        if H.page=="graph_history" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                graph_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Archives","归档列表") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.open_graph_archives()}
                graph_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_graph_history(H.graph_archive,H.graph_after)}
            }
            mod.widgets.HagencyTitle{text:A.t("Saved task graphs","已保存的任务图")}
            mod.widgets.HagencyHint{text:A.t("Historical snapshot. Progress is recorded at transfer time; these graphs are not running here.","历史快照：进度为迁移时的记录，这些任务图并未在此运行。")}
            if H.graph_page==nil {mod.widgets.HagencyHint{text:if H.busy{A.t("Reading graphs…","正在读取任务图…")}else{A.t("Graphs unavailable. Refresh to try again.","任务图暂不可用，请刷新重试。")}}}
            if H.graph_page!=nil {View{width:Fill height:Fit flow:Down spacing:mod.widgets.RINX_SPACING
                let page=H.graph_page
                if page.graphs.len()==0 {mod.widgets.HagencyHint{text:A.t("No graphs on this page","本页暂无任务图")}}
                for row in page.graphs {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.label}
                    mod.widgets.HagencyCopy{text:A.graph_state(row.status)+" · "+row.completeCount.to_string()+" / "+row.nodeCount.to_string()+A.t(" nodes completed"," 个节点已完成")}
                    mod.widgets.HagencyHint{text:A.t("Recorded owner: ","原记录所有者：")+row.owner}
                    mod.widgets.HagencyActions{graph_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View nodes","查看节点") on_click:||A.open_history_graph(H.graph_archive,row.id,nil)}}
                }}
                mod.widgets.HagencyActions{
                    if H.graph_after!=nil {View{width:Fit height:Fit graph_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.open_graph_history(H.graph_archive,nil)}}}
                    if page.nextAfter!=nil {View{width:Fit height:Fit graph_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.open_graph_history(H.graph_archive,page.nextAfter)}}}
                }
            }}
        }}
        if H.page=="history_graph" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                graph_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Task graphs","任务图") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.open_graph_history(H.graph_archive,H.graph_after)}
                graph_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_history_graph(H.graph_archive,H.graph_id,H.graph_node_after)}
            }
            mod.widgets.HagencyTitle{text:if H.graph_detail!=nil{H.graph_detail.graph.label}else{A.t("Graph details","任务图详情")}}
            mod.widgets.HagencyHint{text:A.t("Historical snapshot · Recorded agent names are not linked to current project agents.","历史快照 · 原记录中的代理名称尚未关联当前项目代理。")}
            if H.graph_detail==nil {mod.widgets.HagencyHint{text:if H.busy{A.t("Reading nodes…","正在读取节点…")}else{A.t("Nodes unavailable. Refresh to try again.","节点暂不可用，请刷新重试。")}}}
            if H.graph_detail!=nil {View{width:Fill height:Fit flow:Down spacing:mod.widgets.RINX_SPACING
                let page=H.graph_detail
                mod.widgets.HagencyCopy{text:A.graph_state(page.graph.status)+" · "+page.graph.completeCount.to_string()+" / "+page.graph.nodeCount.to_string()+A.t(" nodes completed"," 个节点已完成")}
                for row in page.nodes {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.id}
                    mod.widgets.HagencyCopy{text:A.graph_state(row.status)+" · "+row.assignee}
                    mod.widgets.HagencyHint{text:row.dependencyCount.to_string()+A.t(" dependencies"," 项依赖")}
                    mod.widgets.HagencyActions{graph_node_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Node details","节点详情") on_click:||A.open_history_node(H.graph_archive,H.graph_id,row.id)}}
                }}
                mod.widgets.HagencyActions{
                    if H.graph_node_after!=nil {View{width:Fit height:Fit graph_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.open_history_graph(H.graph_archive,H.graph_id,nil)}}}
                    if page.nextAfter!=nil {View{width:Fit height:Fit graph_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next nodes","后续节点") on_click:||A.open_history_graph(H.graph_archive,H.graph_id,page.nextAfter)}}}
                }
            }}
        }}
        if H.page=="history_node" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                graph_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Graph nodes","任务图节点") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.open_history_graph(H.graph_archive,H.graph_id,H.graph_node_after)}
                graph_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_history_node(H.graph_archive,H.graph_id,H.graph_node_id)}
            }
            mod.widgets.HagencyTitle{text:if H.graph_node!=nil{H.graph_node.id}else{A.t("Node details","节点详情")}}
            mod.widgets.HagencyHint{text:A.t("Saved history · Read only","历史记录 · 仅供查看")}
            if H.graph_node==nil {mod.widgets.HagencyHint{text:if H.busy{A.t("Reading node…","正在读取节点…")}else{A.t("Node unavailable. Refresh to try again.","节点暂不可用，请刷新重试。")}}}
            if H.graph_node!=nil {View{width:Fill height:Fit flow:Down spacing:mod.widgets.RINX_SPACING
                let node=H.graph_node
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.graph_state(node.status)}
                    mod.widgets.HagencyCopy{text:node.description}
                    mod.widgets.HagencyHint{text:A.t("Recorded assignee: ","原记录执行者：")+node.assignee}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Dependencies","依赖节点")}
                    if node.dependsOn.len()==0 {mod.widgets.HagencyHint{text:A.t("No dependencies","无依赖")}}
                    for index dependency in node.dependsOn {if index>=H.graph_dep_offset && index<H.graph_dep_offset+16 {mod.widgets.HagencyActions{graph_dependency := mod.widgets.HagencyButton{enabled:!H.busy text:dependency on_click:||A.open_history_node(H.graph_archive,H.graph_id,dependency)}}}}
                    mod.widgets.HagencyActions{
                        if H.graph_dep_offset>0 {View{width:Fit height:Fit graph_dependencies_previous := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Previous dependencies","上一页依赖") on_click:||{if H.busy{return} H.graph_dep_offset=H.graph_dep_offset-16 A.redraw()}}}}
                        if H.graph_dep_offset+16<node.dependsOn.len() {View{width:Fit height:Fit graph_dependencies_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More dependencies","更多依赖") on_click:||{if H.busy{return} H.graph_dep_offset=H.graph_dep_offset+16 A.redraw()}}}}
                    }
                }
                if node.resultRecorded || node.conditionRecorded {mod.widgets.HagencyHint{text:A.t("The original archive retains additional result or condition data. This view shows progress and dependencies.","原归档保留了额外的结果或条件数据，此页面展示进度与依赖。")}}
            }}
        }}

        if H.page == "operator_tasks" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                task_board := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Project board","项目看板") on_click:||A.open_board(H.task_board_query)}
                task_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} on_click:||A.open_tasks(H.task_offset)}
            }
            mod.widgets.HagencyTitle{text:A.t("Local tasks","本地任务")}
            mod.widgets.HagencyHint{text:A.t("Tasks on this device. For shared Matrix projects, open Projects.","此设备上的任务。共享 Matrix 项目请在“项目”中查看。")}
            if H.task_page!=nil {mod.widgets.HagencySection{
                if !H.task_page.supported {mod.widgets.HagencySection{mod.widgets.HagencySectionTitle{text:A.t("Task history not migrated","任务历史尚未迁移")} mod.widgets.HagencyCopy{text:A.task_unavailable()}}}
                if H.task_page.supported {mod.widgets.HagencySection{
                    mod.widgets.HagencyActions{if A.task_can("create"){View{width:Fit height:Fit task_create := mod.widgets.RinxKeyPrimaryButton{text:A.t("Create task","创建任务") enabled:!H.busy && H.command==nil && !A.task_unresolved() on_click:||A.task_begin("create","")}}}
                    task_filters_toggle := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.task_filters_open{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} enabled:!H.busy text:if H.task_filters_open{A.t("Hide filters","收起筛选")}else{A.t("Filter tasks","筛选任务")} on_click:||{H.task_filters_open=!H.task_filters_open A.redraw()}}}
                    if H.task_filters_open{mod.widgets.HagencyFormGroup{
                    mod.widgets.HagencySectionTitle{text:A.t("Filter tasks","筛选任务")}
                    mod.widgets.HagencyFieldLabel{text:A.t("Assignee name","负责人名称")}
                    task_assignee := mod.widgets.HagencyInput{empty_text:A.t("Exact assignee name","填写完整负责人名称") text:H.task_filters.assignee on_change:|text|{H.task_filters.assignee=text}}
                    mod.widgets.HagencyFieldLabel{text:A.t("Label","标签")}
                    task_label := mod.widgets.HagencyInput{empty_text:A.t("Exact label","填写完整标签") text:H.task_filters.label on_change:|text|{H.task_filters.label=text}}
                    mod.widgets.HagencyActions{task_apply := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Apply filters","应用筛选") on_click:||A.open_tasks(0)} task_clear := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Clear filters","清除筛选") on_click:||{H.task_filters={assignee:"" status:"" priority:"" label:""} A.open_tasks(0)}}}
                    mod.widgets.HagencyActions{for state in ["","created","accepted","in_progress","blocked","done"] {View{width:Fit height:Fit task_status := mod.widgets.HagencyButton{enabled:!H.busy text:if state==""{A.t("All statuses","全部状态")}else{A.task_status(state)} on_click:||A.task_filter("status",state)}}}}
                    mod.widgets.HagencyActions{for priority in ["","p0","p1","p2","p3"] {View{width:Fit height:Fit task_priority := mod.widgets.HagencyButton{enabled:!H.busy text:if priority==""{A.t("All priorities","全部优先级")}else{priority} on_click:||A.task_filter("priority",priority)}}}}
                    mod.widgets.HagencyHint{text:A.t("Selected status / priority","当前状态 / 优先级")+" · "+A.task_text(H.task_filters.status)+" / "+A.task_text(H.task_filters.priority)}
                    }}
                    if H.task_page.tasks.len()==0{mod.widgets.HagencySection{task_empty := mod.widgets.HagencyCopy{text:if H.task_filters.assignee=="" && H.task_filters.status=="" && H.task_filters.priority=="" && H.task_filters.label==""{A.t("No tasks yet. Create your first task.","暂无任务，创建第一个任务吧。")}else{A.t("No tasks match these filters.","没有符合筛选条件的任务。")}}}}
                    for task in H.task_page.tasks {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:task.title}
                        mod.widgets.HagencyCopy{text:A.task_status(task.status)+" · "+task.priority+" · "+A.task_text(task.assignee)}
                        mod.widgets.HagencyHint{text:A.t("Updated","更新于")+" · "+task.updatedAt}
                        mod.widgets.HagencyActions{task_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View task","查看任务") on_click:||A.open_task(task.id,0)}}
                    }}
                    if H.task_offset>0 || H.task_page.nextOffset!=nil{mod.widgets.HagencyActions{
                        if H.task_offset>0{View{width:Fit height:Fit task_first := mod.widgets.HagencyButton{enabled:!H.busy && H.task_offset>0 text:A.t("First page","第一页") on_click:||A.open_tasks(0)}}}
                        if H.task_page.nextOffset!=nil{View{width:Fit height:Fit task_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.open_tasks(H.task_page.nextOffset)}}}
                    }}
                    if !A.task_write_supported(H.task_page){mod.widgets.HagencyHint{text:A.t("This task store is read-only in the current session.","当前会话仅可读取此任务存储。")}}
                }}
            }}
        }}
        if H.page == "operator_task" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{task_detail_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to tasks","返回任务") on_click:||A.open_tasks(H.task_offset)} task_detail_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} on_click:||A.open_task(H.task_id,H.task_comment_offset)}}
            if H.task_detail!=nil {mod.widgets.HagencySection{
                if !H.task_detail.supported{mod.widgets.HagencyCopy{text:A.task_unavailable()}}
                if H.task_detail.supported {mod.widgets.HagencySection{
                    let task=H.task_detail.task
                    mod.widgets.HagencyTitle{text:task.title}
                    mod.widgets.HagencyCopy{text:A.task_status(task.status)+" · "+task.priority+" · "+task.granularity}
                    mod.widgets.HagencyCopy{text:A.task_text(task.description)}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Assignee","负责人")} mod.widgets.HagencyCopy{text:A.task_text(task.assignee)}}
                    if A.task_can("edit") || A.task_can("delete") || A.task_can("accept") || A.task_can("transition") || A.task_can("comment"){mod.widgets.HagencySection{
                        mod.widgets.HagencyActions{
                            if A.task_can("edit"){View{width:Fit height:Fit task_edit := mod.widgets.HagencyButton{text:A.t("Edit task","编辑任务") enabled:!H.busy && H.command==nil && !A.task_unresolved() on_click:||A.task_begin("edit","")}}}
                            if A.task_can("comment"){View{width:Fit height:Fit task_comment := mod.widgets.HagencyButton{text:A.t("Add comment","添加评论") enabled:!H.busy && H.command==nil && !A.task_unresolved() on_click:||A.task_begin("comment","")}}}
                            for status in H.task_detail.next{View{width:Fit height:Fit
                                if (status=="accepted" && A.task_can("accept")) || (status!="accepted" && A.task_can("transition")){View{width:Fit height:Fit task_transition := mod.widgets.HagencyButton{text:if status=="accepted"{A.t("Accept","接受")}else if status=="in_progress"{A.t("Start task","开始任务")}else if status=="done"{A.t("Mark done","标为完成")}else{A.t("Mark blocked","标为受阻")} enabled:!H.busy && H.command==nil && !A.task_unresolved() on_click:||A.task_begin(if status=="accepted"{"accept"}else{"transition"},status)}}}
                            }}
                            if A.task_can("delete"){View{width:Fit height:Fit task_delete := mod.widgets.HagencyButton{text:A.t("Delete task","删除任务") enabled:!H.busy && H.command==nil && !A.task_unresolved() on_click:||A.task_begin("delete","")}}}
                        }
                    }}
                    mod.widgets.HagencyActions{task_details_toggle := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.task_details_open{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} enabled:!H.busy text:if H.task_details_open{A.t("Hide details","收起详情")}else{A.t("Details","详情")} on_click:||{H.task_details_open=!H.task_details_open A.redraw()}}}
                    if H.task_details_open{mod.widgets.HagencySection{
                    mod.widgets.HagencyHint{text:task.id}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Created by","创建者")} mod.widgets.HagencyCopy{text:A.task_text(task.created_by)}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Created / updated","创建 / 更新")} mod.widgets.HagencyCopy{text:task.created_at+" / "+task.updated_at}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Started / completed","开始 / 完成")} mod.widgets.HagencyCopy{text:A.task_text(task.started_at)+" / "+A.task_text(task.completed_at)}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Last heartbeat","最近心跳记录")} mod.widgets.HagencyCopy{text:A.task_text(task.heartbeat_at)}}
                    mod.widgets.HagencyHint{text:A.t("Edits and comments use your signed-in account. Task status does not start agent work.","更改与评论使用当前登录账号，任务状态不会启动 Agent 工作。")}
                    }}
                    if task.parent_id!=nil{mod.widgets.HagencySection{mod.widgets.HagencyHint{text:A.t("Parent task","父任务")+" · "+task.parent_id} task_parent := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View parent","查看父任务") on_click:||A.open_task(task.parent_id,0)}}}
                    if task.waiting_reason!=nil{mod.widgets.HagencySection{mod.widgets.HagencySectionTitle{text:A.t("Waiting","等待事项")} mod.widgets.HagencyCopy{text:task.waiting_reason} mod.widgets.HagencyHint{text:A.task_text(task.waiting_until)}}}
                    if task.labels.len()>0{mod.widgets.HagencyActions{for label in task.labels{View{width:Fit height:Fit task_label_filter := mod.widgets.HagencyButton{enabled:!H.busy text:label on_click:||A.task_filter("label",label)}}}}}
                    mod.widgets.HagencySectionTitle{text:A.t("Comments","评论")+" · "+H.task_detail.commentCount}
                    if H.task_detail.commentCount==0{mod.widgets.HagencyCopy{text:A.t("No recorded comments.","暂无已记录评论。")}}
                    for comment in task.comments{mod.widgets.HagencySection{mod.widgets.HagencyHint{text:comment.author+" · "+comment.ts} mod.widgets.HagencyCopy{text:comment.text}}}
                    if H.task_comment_offset>0 || H.task_detail.nextCommentOffset!=nil{mod.widgets.HagencyActions{
                        if H.task_comment_offset>0{View{width:Fit height:Fit task_comments_first := mod.widgets.HagencyButton{enabled:!H.busy && H.task_comment_offset>0 text:A.t("First comments","最早评论") on_click:||A.open_task(H.task_id,0)}}}
                        if H.task_detail.nextCommentOffset!=nil{View{width:Fit height:Fit task_comments_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More comments","更多评论") on_click:||A.open_task(H.task_id,H.task_detail.nextCommentOffset)}}}
                    }}


                }}
            }}
        }}
        if H.page == "operator_task_edit" && H.task_draft!=nil {mod.widgets.HagencyDetailCard{
            let d=H.task_draft let input=d.input
            mod.widgets.HagencyActions{task_edit_back := mod.widgets.HagencyButton{text:A.t("Cancel edit","取消编辑") enabled:!H.busy on_click:||A.task_cancel_edit()} task_prepare := mod.widgets.RinxKeyPrimaryButton{text:if d.operation=="create"{A.t("Create task","创建任务")}else if d.operation=="comment"{A.t("Post comment","发表评论")}else if d.operation=="delete"{A.t("Delete task","删除任务")}else{A.t("Save","保存")} enabled:!H.busy && H.task_phase=="editing" on_click:||A.task_prepare()}}
            mod.widgets.HagencyTitle{text:A.task_action_name(d.operation)}
            if d.operation!="create"{mod.widgets.HagencyCopy{text:d.title}}
            if d.operation=="create" || d.operation=="edit" {mod.widgets.HagencyFormGroup{
                mod.widgets.HagencyCopy{text:A.t("Title","标题")}
                task_title_input := mod.widgets.HagencyInput{empty_text:A.t("What needs to be done?","需要完成什么？") text:input.title on_change:|text|A.task_set("title",text)}
                mod.widgets.HagencyCopy{text:A.t("Description","描述")}
                task_description_input := mod.widgets.HagencyInput{empty_text:A.t("Context and expected result (optional)","背景与预期结果（可选）") height:60 is_multiline:true text:input.description on_change:|text|A.task_set("description",text)}
            }}
            if d.operation=="comment" {mod.widgets.HagencyFormGroup{mod.widgets.HagencyCopy{text:A.t("Comment","评论")} task_comment_input := mod.widgets.HagencyInput{empty_text:A.t("Write your comment","填写评论") height:120 is_multiline:true text:input.text on_change:|text|A.task_set("text",text)}}}
            if d.operation=="transition"{mod.widgets.HagencySection{
                mod.widgets.HagencyCopy{text:A.t("New status","新状态")+" · "+A.task_status(input.status)}
                if input.status=="blocked"{mod.widgets.HagencyFormGroup{
                    mod.widgets.HagencyCopy{text:A.t("Waiting reason","等待原因")} task_waiting_reason := mod.widgets.HagencyInput{empty_text:A.t("What is blocking this task?","什么阻碍了此任务？") text:input.waitingReason on_change:|text|A.task_set("waitingReason",text)}
                    mod.widgets.HagencyCopy{text:A.t("Waiting until","等待至")} task_waiting_until := mod.widgets.HagencyInput{empty_text:A.t("When or under what condition can work continue?","何时或满足什么条件后可继续？") text:input.waitingUntil on_change:|text|A.task_set("waitingUntil",text)}
                }}
            }}
            if d.operation=="delete"{mod.widgets.HagencyCopy{text:A.t("Deleting removes this task and its comments. Child tasks remain with their existing parent reference.","删除会移除此任务及其评论。子任务将保留原有父任务引用。")}}
            if d.operation=="create" || d.operation=="edit"{mod.widgets.HagencySection{
                mod.widgets.HagencyActions{task_options_toggle := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.task_options_open{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} enabled:!H.busy text:if H.task_options_open{A.t("Hide options","收起选项")}else{A.t("More options","更多选项")} on_click:||{H.task_options_open=!H.task_options_open A.redraw()}}}
                if H.task_options_open{mod.widgets.HagencyFormGroup{
                mod.widgets.HagencyCopy{text:A.t("Priority","优先级")+" · "+input.priority}
                mod.widgets.HagencyActions{for priority in ["p0","p1","p2","p3"]{View{width:Fit height:Fit task_edit_priority := mod.widgets.HagencyChoice{draw_bg.color:if input.priority==priority{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} text:priority enabled:!H.busy on_click:||{A.task_set("priority",priority) A.redraw()}}}}}
                mod.widgets.HagencyCopy{text:A.t("Granularity","粒度")+" · "+A.task_granularity(input.granularity)}
                mod.widgets.HagencyActions{for granularity in ["epic","task","subtask"]{View{width:Fit height:Fit task_edit_granularity := mod.widgets.HagencyChoice{draw_bg.color:if input.granularity==granularity{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} text:A.task_granularity(granularity) enabled:!H.busy on_click:||{A.task_set("granularity",granularity) A.redraw()}}}}}
                mod.widgets.HagencyCopy{text:A.t("Assignee name (optional)","负责人名称（可选）")}
                task_assignee_input := mod.widgets.HagencyInput{empty_text:A.t("Assignee name, or leave empty","负责人名称，可留空") text:input.assignee on_change:|text|A.task_set("assignee",text)}
                mod.widgets.HagencyCopy{text:A.t("Parent task ID (optional)","父任务 ID（可选）")}
                task_parent_input := mod.widgets.HagencyInput{empty_text:A.t("Existing local task ID, or leave empty","已有本地任务 ID，可留空") text:input.parentId on_change:|text|A.task_set("parentId",text)}
                mod.widgets.HagencyCopy{text:A.t("Labels","标签")}
                mod.widgets.HagencyActions{for label in input.labels{View{width:Fit height:Fit task_remove_label := mod.widgets.HagencyButton{text:A.t("Remove · ","移除 · ")+label enabled:!H.busy on_click:||A.task_remove_label(label)}}}}
                task_new_label := mod.widgets.HagencyInput{empty_text:A.t("Add a short label","添加简短标签") text:H.task_label_draft on_change:|text|{H.task_label_draft=text}}
                mod.widgets.HagencyActions{task_add_label := mod.widgets.HagencyButton{text:A.t("Add label","添加标签") enabled:!H.busy on_click:||A.task_add_label()}}
                mod.widgets.HagencyHint{text:A.t("Assignee names are records only; saving does not send work to an agent.","负责人名称仅作记录，保存不会向 Agent 派发工作。")}
                }}
            }}
        }}
        if H.page == "operator_task_command" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyTitle{text:if H.task_phase=="recorded"{A.t("Saved","已保存")}else if H.task_phase=="failed"{A.t("Could not save","未能保存")}else if H.task_phase=="unknown"{A.t("Save not confirmed","保存结果待确认")}else if H.task_phase=="saved"{A.t("Continue saving","继续保存")}else{A.t("Saving…","正在保存…")}}
            if H.task_pending!=nil{mod.widgets.HagencySection{
                let pending=H.task_pending let change=pending.change let input=change.input
                if change.operation=="create" || change.operation=="edit"{mod.widgets.HagencySectionTitle{text:A.task_review_value(input,"title")}}
                if change.operation=="comment"{mod.widgets.HagencyCopy{text:input.text}}
                if change.operation=="accept"{mod.widgets.HagencyCopy{text:A.task_status("accepted")}}
                if change.operation=="transition"{mod.widgets.HagencyCopy{text:A.task_status(input.status)}}
                if change.operation=="delete"{mod.widgets.HagencyCopy{text:if H.task_phase=="recorded"{A.t("Task deleted.","任务已删除。")}else{A.t("Delete this task and its comments? Child tasks will keep their parent reference.","删除此任务及其评论？子任务将保留父任务引用。")}}}
                if H.task_phase=="saved"{mod.widgets.HagencyCopy{text:A.t("Your change was saved as a request but has not been confirmed. Continue with this saved request.","更改请求已保存，但尚未确认生效。请继续完成此请求。")}}
                if H.task_phase=="unknown"{mod.widgets.HagencyCopy{text:A.t("Check this saved request before trying again. This avoids a duplicate task or comment.","请先检查此请求的结果，以免重复创建任务或评论。")}}
                if H.task_phase=="failed"{mod.widgets.HagencyCopy{text:A.t("No change was made. Check the current task before editing again.","未应用更改。请查看当前任务后再编辑。")}}
                mod.widgets.HagencyActions{
                    if H.task_phase=="saved" || H.task_phase=="unknown"{View{width:Fit height:Fit task_command_apply := mod.widgets.RinxKeyPrimaryButton{text:if H.task_phase=="unknown"{A.t("Check and finish save","检查并完成保存")}else if change.operation=="delete"{A.t("Delete task","删除任务")}else{A.t("Finish saving","完成保存")} enabled:!H.busy on_click:||A.task_apply()}}}
                    if H.task_phase=="recorded" || H.task_phase=="failed"{View{width:Fit height:Fit task_view_current := mod.widgets.RinxKeyPrimaryButton{text:if H.task_phase=="recorded" && change.operation=="delete"{A.t("Back to tasks","返回任务")}else{A.t("View task","查看任务")} enabled:!H.busy on_click:||A.task_current()}}}
                }
                mod.widgets.HagencyActions{task_result_details := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.task_result_details{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} text:if H.task_result_details{A.t("Hide details","收起详情")}else{A.t("Details","详情")} enabled:!H.busy on_click:||{H.task_result_details=!H.task_result_details A.redraw()}}}
                if H.task_result_details{mod.widgets.HagencySection{
                    mod.widgets.HagencyHint{text:A.t("Task ID","任务 ID")+" · "+pending.taskId}
                    if change.operation!="create"{mod.widgets.HagencyHint{text:A.t("Revision","版本")+" · "+input.expectedRevision}}
                    mod.widgets.HagencyHint{text:A.t("Saved request","已保存请求")+" · "+pending.commandId}
                    mod.widgets.HagencyHint{text:A.t("This receipt describes the saved change. Open the task for its current state.","此回执记录已保存的更改，任务当前状态请打开任务查看。")}
                    mod.widgets.HagencyActions{task_command_refresh := mod.widgets.HagencyButton{text:A.t("Check saved request","检查保存请求") enabled:!H.busy on_click:||A.task_saved_refresh()}}
                    if H.task_phase=="recorded" || H.task_phase=="failed"{mod.widgets.HagencyActions{task_result_dismiss := mod.widgets.HagencyButton{text:A.t("Dismiss receipt","关闭回执") enabled:!H.busy on_click:||{A.task_finish(fn(){A.open_tasks(H.task_offset)})}}}}
                }}
            }} else {mod.widgets.HagencySection{
                mod.widgets.HagencyCopy{text:A.t("The save may have reached this device. Check saved requests before creating a replacement.","保存请求可能已送达此设备。请先检查已保存的请求，不要重复提交。")}
                mod.widgets.HagencyActions{task_command_refresh := mod.widgets.RinxKeyPrimaryButton{text:A.t("Find saved request","查找保存请求") enabled:!H.busy on_click:||A.task_saved_refresh()}}
            }}
            if H.task_error!=""{mod.widgets.HagencyCopy{text:A.task_reason(H.task_error)}}
        }}
        if H.page == "operator_board" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{board_tasks := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View tasks","查看任务") on_click:||A.open_tasks(H.task_offset)} board_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} on_click:||A.open_board(H.task_board_query)}}
            mod.widgets.HagencyTitle{text:A.t("Local project board","本地项目看板")}
            mod.widgets.HagencyHint{text:A.t("Local projects and task counts. Shared Matrix projects are listed under Projects.","本地项目与任务数量。共享 Matrix 项目请在“项目”中查看。")}
            if H.task_board!=nil{mod.widgets.HagencySection{
                if !H.task_board.supported{mod.widgets.HagencyCopy{text:A.task_unavailable()}}
                if H.task_board.supported{mod.widgets.HagencySection{
                    mod.widgets.HagencyCopy{text:A.t("Projects / assigned agent names","项目 / 已分配 Agent 名称")+" · "+H.task_board.projectCount+" / "+H.task_board.agentCount}
                    mod.widgets.HagencyActions{for state in ["created","accepted","in_progress","blocked","done"]{View{width:Fit height:Fit board_counter := mod.widgets.HagencyCopy{width:Fit text:A.task_status(state)+" · "+H.task_board.taskTotals[state]}}}}
                    if H.task_board.projects.len()==0{mod.widgets.HagencyCopy{text:A.t("No local projects in this page.","此页没有本地项目。")}}
                    for project in H.task_board.projects{mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:project.name}
                        mod.widgets.HagencyActions{for state in ["created","accepted","in_progress","blocked","done"]{View{width:Fit height:Fit board_counter := mod.widgets.HagencyCopy{width:Fit text:A.task_status(state)+" · "+project.taskLanes[state]}}}}
                        mod.widgets.HagencyHint{text:A.t("Recorded assignees","已记录负责人")+" · "+project.agentCount}
                        mod.widgets.HagencyActions{for agent in project.agents{View{width:Fit height:Fit board_agent := mod.widgets.HagencyButton{enabled:!H.busy text:agent on_click:||A.agent_tasks(agent)}}}}
                        if project.nextAgentAfter!=nil{mod.widgets.HagencyActions{board_more_agents := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More assignees","更多负责人") on_click:||A.open_board({projectId:project.id agentAfter:project.nextAgentAfter})}}}
                    }}
                    if H.task_board_query.to_json()!="{}" || H.task_board.nextAfter!=nil{mod.widgets.HagencyActions{if H.task_board_query.to_json()!="{}"{View{width:Fit height:Fit board_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("All projects","全部项目") on_click:||A.open_board({})}}} if H.task_board.nextAfter!=nil{View{width:Fit height:Fit board_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next projects","后续项目") on_click:||A.open_board({after:H.task_board.nextAfter})}}}}}
                    mod.widgets.HagencyActions{board_details := mod.widgets.HagencyDisclosure{icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.board_details_open{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} enabled:!H.busy text:if H.board_details_open{A.t("Hide details","收起详情")}else{A.t("About this board","关于此看板")} on_click:||{H.board_details_open=!H.board_details_open A.redraw()}}}
                    if H.board_details_open{mod.widgets.HagencySection{
                    mod.widgets.HagencyHint{text:A.t("This source does not provide project creation time, binding health, repositories, worktrees, specifications, issues or activity. Missing observations are not zero.","该数据源不提供项目创建时间、绑定健康、代码库、工作树、规格、问题或活动记录。缺失观测不视为零。")}
                    }}
                }}
            }}
        }}
        if H.page == "device_execution" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                execution_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resources", "返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.navigate("resources")}
                execution_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh observations", "刷新观测") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_execution(H.execution_after)}
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencyTitle{text:A.t("Execution on this device", "此设备上的执行")}
                mod.widgets.HagencyCopy{text:A.t("Start another process for an already approved agent, or recover its original saved start. Your existing assignment and budget stay the same.", "为已获批的 Agent 启动另一进程，或恢复其原始启动请求。已有分配与预算保持不变。")}
                mod.widgets.HagencyHint{text:A.t("Only the resource owner's original execution device can use these controls. Closing this mini app does not stop an accepted native process.", "这些操作仅适用于资源主人的原执行设备。关闭此小程序不会停止已接受的原生进程。")}
            }
            if H.execution_result != nil {mod.widgets.HagencySection{mod.widgets.HagencyCopy{text:A.execution_result_text(H.execution_result)}}}
            if H.execution_page != nil {
                let page=H.execution_page
                if !page.supported {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Execution controls unavailable", "执行操作不可用")}
                    mod.widgets.HagencyCopy{text:A.execution_reason(page.reason)}
                }}
                if page.supported {
                    if page.items.len() == 0 {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("No recorded assignments in this view", "当前视图暂无已记录分配")}
                        mod.widgets.HagencyCopy{text:A.t("This list contains assignments already recorded by this owner and execution device. A project request alone does not create one.", "此列表仅显示已由当前资源主人和执行设备记录的分配。仅提交项目申请不会产生分配。")}
                    }}
                    for row in page.items {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:row.agentName}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project", "项目")} mod.widgets.HagencyCopy{text:row.projectId}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Assignment", "分配")} mod.widgets.HagencyCopy{text:row.assignmentId}}
                        mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Last process", "上次进程")} mod.widgets.HagencyCopy{text:A.execution_state(row.processState)+" · "+row.processAttempt}}
                        mod.widgets.HagencyHint{text:A.t("History is descriptive. Native review checks remaining budget; Start checks current server authority.", "历史记录仅供查看。原生核对会检查剩余预算，启动时会检查当前服务器权限。")}
                        mod.widgets.HagencyActions{
                            execution_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Review start", "核对启动") on_click: || A.execution_action(row.assignmentId,false)}
                            if row.savedStart {View{width:Fit height:Fit execution_resume := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Resume saved start", "恢复原启动请求") on_click: || A.execution_action(row.assignmentId,true)}}}
                        }
                    }}
                    if page.nextAfter != nil {mod.widgets.HagencyActions{execution_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next assignments", "下一页分配") on_click: || A.open_execution(page.nextAfter)}}}
                    if H.execution_after != nil {mod.widgets.HagencyActions{execution_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page", "第一页") on_click: || A.open_execution(nil)}}}
                }
            }
        }}
        if H.page == "onboarding" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                onboarding_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resources", "返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.navigate("resources")}
                onboarding_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh requirements", "刷新条件") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_onboarding()}
            }
            mod.widgets.HagencyTitle{text:A.t("Device setup and shared capacity", "设备设置与共享容量")}
            mod.widgets.HagencyCopy{text:if H.onboarding != nil && H.onboarding.state == "active" {A.t("Device setup is complete. Register resources, then review server admission and a separate capacity grant.", "设备设置已完成。请登记资源，再核对服务器准入与独立容量授权。")} else {A.t("Set up this device, add a provider account and register resources. Server admission and capacity sharing are separate steps.", "设置此设备、添加模型服务账号并登记资源。服务器准入与容量共享是后续的独立步骤。")}}
            if H.onboarding_result != nil {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Last native review", "上次原生核对")}
                mod.widgets.HagencyCopy{text:A.onboarding_result_text(H.onboarding_result)}
            }}
            if H.onboarding == nil {mod.widgets.HagencyCopy{text:if H.busy {A.t("Checking this device…", "正在检查此设备…")} else {A.t("Refresh to read the current native requirements.", "请刷新以读取当前原生条件。")}}}
            if H.onboarding != nil {mod.widgets.HagencySection{
                let p=H.onboarding let reason=A.onboarding_reason_code(p)
                mod.widgets.HagencyStatus{mod.widgets.HagencyCopy{text:A.onboarding_state(p.state)}}
                if reason != nil {mod.widgets.HagencyCopy{text:A.onboarding_reason(reason)}}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:if p.state == "active" {A.t("1 · Device resources", "1 · 设备资源")} else {A.t("1 · Review this device", "1 · 核对此设备")}}
                    mod.widgets.HagencyCopy{text:if p.state == "active" {A.t("The native resource inventory is readable. This does not mean capacity is granted to a server.", "原生资源清单已可读取，这不代表已向服务器授权容量。")} else if A.onboarding_empty(p) {A.t("Set up local management for your signed-in Matrix account. No provider account or shared quota is created in this step.", "为当前登录的 Matrix 账号设置本机管理。此步骤不会创建模型服务账号或共享额度。")} else {A.t("The native window verifies the signed-in owner, exact resources and shared monthly account limit before asking you to move resources.", "原生窗口会核对已登录的资源主人、具体资源与共享账号每月上限，再请你确认迁移资源。")}}
                    if p.state != "active" {mod.widgets.HagencyHint{text:if A.onboarding_empty(p) {A.t("Review your Matrix identity in the native window. Closing before confirmation changes nothing; interrupted setup resumes its original request.", "请在原生窗口核对 Matrix 身份。确认前关闭不会修改数据；设置中断后会继续原始请求。")} else {A.t("Confirming migration stops existing local workers and preserves original identities and history. Closing a new review does not start migration; closing recovery preserves earlier progress. Interrupted confirmation must recover its original result.", "确认迁移会停止原有本地工作进程，并保留原始标识与历史。关闭新核对不会开始迁移，关闭恢复核对会保留此前进度。确认中断后须恢复原始结果。")}}}
                    if p.canReview {mod.widgets.HagencyActions{
                        onboarding_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:if p.state == "recovery_required" {if A.onboarding_empty(p) {A.t("Resume device setup", "继续设备设置")} else {A.t("Recover native migration", "恢复原生迁移")}} else if A.onboarding_empty(p) {A.t("Set up this device", "设置此设备")} else {A.t("Open native review", "打开原生核对")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.review_onboarding()}
                    }}
                }
                if p.state=="active" {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Add an account and register a resource", "添加账号并登记资源")}
                    mod.widgets.HagencyCopy{text:A.t("Create an account space, authorize the provider, then choose a model and review its account limit.", "创建账号空间、授权模型服务，再选择模型并核对账号额度。")}
                    mod.widgets.HagencyActions{onboarding_accounts := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Continue to provider accounts", "继续前往模型服务账号") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.open_accounts(nil)}}
                }}
                mod.widgets.HagencyDivider{}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("2 · Check server admission", "2 · 检查服务器准入")}
                    mod.widgets.HagencyCopy{text:A.t("A resource owner offers the resource; the server administrator approves admission. An approved connection alone does not allocate tokens.", "资源主人提交资源，由服务器管理员批准准入。连接获准本身不会分配 token。")}
                    mod.widgets.HagencyActions{onboarding_connections := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View server connections", "查看服务器连接") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.navigate("connections")}}
                }
                mod.widgets.HagencyDivider{}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("3 · Review capacity and publication", "3 · 核对容量与发布")}
                    mod.widgets.HagencyCopy{text:A.t("The native review shows remaining / total capacity, the exact UTC accounting month, owner and Agent-applicant limits. Local reservation and server publication each need their own confirmation; neither starts an agent.", "原生核对会显示剩余 / 总容量、确切的 UTC 记账月份、资源 owner 与 Agent 申请者限制。本地预留和服务器发布分别需要确认，两者都不会启动 Agent。")}
                    if !p.grantReviewAvailable {mod.widgets.HagencyHint{text:A.t("Capacity review requires this resource owner's original device and qualified native history. Inventory access on another device does not grant permission to reserve capacity.", "容量核对需要资源主人的原始设备和符合条件的原生历史。在其他设备上查看清单不代表有权预留容量。")}}
                    if p.grantReviewAvailable {mod.widgets.HagencySection{
                        for intent in p.grantIntents {mod.widgets.HagencySection{
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Original grant", "原始授权")} mod.widgets.HagencyCopy{text:intent.intentId}}
                            mod.widgets.HagencyHint{text:A.t("Resource · ", "资源 · ")+intent.resourceId}
                            mod.widgets.HagencyActions{onboarding_grant_recover := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Review original grant", "核对原始授权") on_click: || A.review_grant({intentId:intent.intentId})}}
                        }}
                        for connection in H.onboarding_connections {if connection.ownerMxid == H.session.account && connection.state == "admitted" {mod.widgets.HagencySection{
                            mod.widgets.HagencyCopy{text:connection.label}
                            mod.widgets.HagencyHint{text:A.connection_status(connection)}
                            mod.widgets.HagencyActions{onboarding_grant_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Review capacity grant", "核对容量授权") on_click: || A.review_grant({contributionId:connection.id})}}
                        }}}
                        if H.onboarding_after != nil {mod.widgets.HagencyActions{onboarding_connections_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next connections", "下一页连接") on_click: || A.more_onboarding_connections()}}}
                        mod.widgets.HagencyHint{text:A.t("Only your admitted connections on the current page are shown. Use Next connections to continue or Refresh requirements to return to the first page. Previous grants reopen their original native intent.", "此处仅显示当前页中属于你的已获准连接。可继续查看下一页，或刷新条件返回首页。已有授权会重新打开原始原生意图。")}
                    }}
                }
            }}
        }}
        if H.page == "provider_accounts" || H.page == "provider_account" || H.page == "account_prepare" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                accounts_back := mod.widgets.HagencyButton{enabled:!H.busy text:if H.page=="provider_account" {A.t("Back to accounts","返回账号列表")}else{A.t("Back to resources","返回资源")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || {if H.page=="provider_account"{A.open_accounts(H.account_after)}else{A.navigate("resources")}}}
                accounts_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.refresh()}
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencyTitle{text:A.t("Provider logins & resources","模型服务登录与资源")}
                mod.widgets.HagencyHint{text:A.t("One account can serve multiple resources and Agents. Recorded identities are grouped; login status is shown separately for each login.","一个账号可供多个资源与 Agent 使用。按已记录的账号身份归组，每份登录分别显示当前状态。")}
            }
            if H.page=="account_prepare" {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Add your Codex account", "添加你的 Codex 账号")}
                mod.widgets.HagencyCopy{text:A.t("A separate login for this Matrix account", "为当前 Matrix 账号保存独立登录")}
                mod.widgets.HagencyHint{text:A.t("Hagency will keep this provider login separate from other people on this computer.","Hagency 会将此服务商登录与电脑上其他用户的登录分开保存。")}
                mod.widgets.HagencyCopy{text:A.t("Next: sign in on the provider’s page", "下一步：在服务商页面登录")}
                mod.widgets.HagencyHint{text:A.t("Prepare a login record, then choose Sign in to Codex. This does not create a new OpenAI account.","准备登录记录后，选择“登录 Codex”。此操作不会创建新的 OpenAI 账号。")}
                mod.widgets.HagencyHint{text:A.t("If interrupted, recover the saved request to keep the same account.", "若操作中断，请恢复已保存的请求，以保留同一账号。")}
                mod.widgets.HagencyActions{
                    account_prepare_cancel := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Cancel", "取消") on_click: || {if !H.busy && H.command==nil {A.open_accounts(nil)}}}
                    account_prepare_confirm := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Prepare private sign-in", "准备独立登录") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click: || A.submit_account_preparation()}
                }
            }}
            if H.page=="provider_accounts" {
                if H.account_inventory!=nil {mod.widgets.HagencyActions{
                    account_prepare_review := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Connect another Codex login", "接入另一个 Codex 登录") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click: || A.review_account_preparation()}
                }}
                if H.account_inventory==nil {mod.widgets.HagencySection{mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading accounts…","正在读取账号…")}else{A.t("Account list unavailable","账号列表暂不可用")}}}}
                if H.account_inventory!=nil {
                    if H.account_inventory.accounts.len()==0 {mod.widgets.HagencySection{mod.widgets.HagencyCopy{text:A.t("No recorded accounts in this profile","当前身份暂无账号记录")} mod.widgets.HagencyHint{text:A.t("Add a Codex account to begin. You’ll sign in on the provider’s page; Hagency keeps the login private to this Matrix profile.","添加 Codex 账号即可开始。你将在服务商页面登录，Hagency 会将登录信息独立保存在当前 Matrix 身份下。")}}}
                    let groups=A.account_groups()
                    View{width:Fill height:Fit flow:Down spacing:16
                    for index, group in groups.known {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:if group.runtime=="codex" {A.t("Codex account ","Codex 账号 ")+(index+1)}else{group.runtime+A.t(" account "," 账号 ")+(index+1)}}
                        mod.widgets.HagencyCopy{text:A.t("Associated resources: ","关联资源：")+group.resources}
                        if group.members.len()>1 {mod.widgets.HagencyHint{text:A.t("These login records share a recorded account identity. Actions apply to the selected login only.","这些登录记录关联同一账号身份。操作仅作用于所选登录记录。")}}
                        for member_index, row in group.members {View{width:Fill height:Fit flow:Down spacing:(6 * mod.widgets.RINX_SPACING)
                            if group.members.len()>1 {mod.widgets.HagencyCopy{text:A.account_kind(row)+" "+(member_index+1)}}
                            if row.state!="active" && row.kind=="managed_namespace" {mod.widgets.HagencyHint{text:A.account_state(row)}}
                            mod.widgets.HagencyHint{text:A.account_readiness(row)}
                            account_open := mod.widgets.HagencyButton{enabled:!H.busy text:if row.kind=="managed_namespace"{A.t("Login & resources","登录与资源")}else{A.t("View associated resources","查看关联资源")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.open_account(row.id,nil)}
                        }}
                    }}
                    }
                    if groups.unconfirmed.len()>0 {mod.widgets.HagencySection{
                        account_pending_toggle := mod.widgets.HagencyDisclosure{grab_key_focus:true enabled:!H.busy text:A.t("Unconfirmed login / resource records · ","身份待确认的登录／资源记录 · ")+groups.unconfirmed.len() icon_walk:Walk{width:16 height:16} draw_icon.svg:if H.account_pending_open{mod.rinx_icons.collapse}else{mod.rinx_icons.expand} on_click:||{H.account_pending_open=!H.account_pending_open A.redraw()}}
                        mod.widgets.HagencyHint{text:A.t("These records do not establish another provider account. Open a record to continue setup or inspect its resources.","这些记录尚不能证明是另一个服务商账号。展开后可继续登录设置或查看资源。")}
                        if H.account_pending_open {for row in groups.unconfirmed {View{width:Fill height:Fit flow:Down spacing:(6 * mod.widgets.RINX_SPACING)
                            mod.widgets.HagencyCopy{text:row.runtime+" · "+A.account_kind(row)+if row.ordinal!=nil{" #"+row.ordinal}else{""}}
                            mod.widgets.HagencyHint{text:A.account_state(row)+" · "+A.account_readiness(row)}
                            mod.widgets.HagencyHint{text:A.t("Associated resources: ","关联资源：")+row.resourceCount}
                            account_record_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View record","查看记录") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.open_account(row.id,nil)}
                        }}}
                    }}
                }
            }
            if H.page=="provider_account" {
                if H.account_detail==nil {mod.widgets.HagencySection{mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading account…","正在读取账号…")}else{A.t("Account details unavailable","账号详情暂不可用")}}}}
                if H.account_detail!=nil {
                    let row=H.account_detail.account
                    mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:row.runtime + " · " + A.account_kind(row)}
                        mod.widgets.HagencyCopy{text:A.account_state(row)}
                        mod.widgets.HagencyHint{text:A.account_readiness(row)}
                        if row.kind=="managed_namespace" && row.readiness=="unknown" && row.state!="retired" {mod.widgets.HagencyHint{text:if row.state=="active" {if row.resourceCount>0 {A.t("Current login has not been verified. Existing resource associations are retained.","当前登录尚未验证，已有资源关联仍保留。")}else{A.t("Sign in, then check models to continue resource setup.","登录后检查模型，即可继续接入资源。")}} else {A.t("This original preparation is not confirmed. Refresh reads its state; it does not repeat creation.", "此原始准备操作尚未确认。刷新只读取状态，不会再次创建。")}}}
                        if row.kind=="managed_namespace" && row.state=="active" && row.resourceCount==0 {mod.widgets.HagencyActions{
                            account_login := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && (H.command==nil || (H.command.service=="hagency.accounts.login" && H.command.args.accountId==row.id)) text:if H.command!=nil {A.t("Continue sign-in","继续登录")}else{A.t("Sign in to Codex","登录 Codex")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.login_account(row)}
                        }}
                        if row.state=="retired" {mod.widgets.HagencyHint{text:A.t("Hagency no longer uses this account space. Provider sign-out has not been verified; credentials are retained.","Hagency 已停用此账号空间。模型服务商的退出登录尚未验证；凭据仍保留。")}}
                        mod.widgets.HagencyHint{text:row.id}
                    }
                    if row.kind=="managed_namespace" && row.state=="active" {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Available models","可用模型")}
                        mod.widgets.HagencyHint{text:A.t("Check this account's model choices before resource setup.","接入资源前，先检查此账号可用的模型。")}
                        account_models_check := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Check available models","检查可用模型") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.load_account_models(row)}
                        if H.account_models_attempted && H.account_models==nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Checking this account…","正在检查此账号…")}else{A.t("No current model snapshot","暂无当前模型结果")}}}
                        let models=[] let can_enroll=A.account_can_enroll()
                        if H.account_models!=nil {models=H.account_models.provider.models}
                        if H.account_models!=nil && models.len()==0 {mod.widgets.HagencyCopy{text:A.t("This account returned no available models.","此账号未返回可用模型。")}}
                        for model in models {View{width:Fill height:Fit flow:Down spacing:(6 * mod.widgets.RINX_SPACING)
                            mod.widgets.HagencyCopy{text:model.label}
                            mod.widgets.HagencyHint{text:model.model}
                            mod.widgets.HagencyHint{text:if model.sharedReasoning.len()==0 {A.t("Not qualified for shared resources","尚不符合共享资源条件")}else{A.t("Eligible model choice; resource setup is still required","可选模型；仍需完成资源接入")}}
                            account_model_enroll := mod.widgets.HagencyButton{visible:can_enroll && model.sharedReasoning.len()>0 enabled:!H.busy && H.command==nil text:A.t("Set up this resource","设置此资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.choose_account_model(row,model)}
                        }}
                    }}
                    if H.account_models!=nil && !A.account_can_enroll() {mod.widgets.HagencySection{
                        mod.widgets.HagencyCopy{text:A.t("Finish device setup before enrolling resources from this account.","请先完成设备设置，再从此账号登记资源。")}
                        account_device_setup := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Review device setup","检查设备设置") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click: || A.open_onboarding()}
                    }}
                    if row.kind=="managed_namespace" && row.state=="active" && row.resourceCount==0 {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Stop using this account space","停止使用此账号空间")}
                        mod.widgets.HagencyHint{text:A.t("Hagency checks all resource associations before retirement. The provider login and credentials are retained.","停用前 Hagency 会检查全部资源关联。模型服务商的登录与凭据仍保留。")}
                        account_retire := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Retire account space","停用账号空间") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.close on_click: || A.retire_account(row)}
                    }}
                    mod.widgets.HagencySection{mod.widgets.HagencySectionTitle{text:A.t("Associated resources","关联资源")}
                        if row.resourceCount==0 {mod.widgets.HagencyCopy{text:A.t("No associated resources","暂无关联资源")}}
                        for resource in H.account_detail.resources {View{width:Fill height:Fit flow:Down spacing:(8 * mod.widgets.RINX_SPACING)
                            mod.widgets.HagencyCopy{text:resource.model}
                            mod.widgets.HagencyHint{text:resource.id}
                            account_resource := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View resource","查看资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_resource(resource.id)}
                        }}
                        if H.account_resource_after!=nil || H.account_detail.nextAfter!=nil {mod.widgets.HagencyActions{
                            account_resources_first := mod.widgets.HagencyButton{enabled:!H.busy && H.account_resource_after!=nil text:A.t("First page","首页") on_click: || {if H.account_resource_after!=nil {A.open_account(H.account_id,nil)}}}
                            account_resources_next := mod.widgets.HagencyButton{enabled:!H.busy && H.account_detail.nextAfter!=nil text:A.t("More resources","更多资源") on_click: || {if H.account_detail!=nil && H.account_detail.nextAfter!=nil {A.open_account(H.account_id,H.account_detail.nextAfter)}}}
                        }}
                    }
                }
            }
        }}
        let enrollment_efforts=[]
        if H.enrollment_draft!=nil {enrollment_efforts=H.enrollment_draft.model.sharedReasoning}
        if H.page=="account_enrollment" && H.enrollment_draft!=nil {mod.widgets.HagencyDetailCard{
            let d=H.enrollment_draft
            mod.widgets.HagencyActions{
                enrollment_back := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Back to account","返回账号") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_account(d.account.accountId,nil)}
            }
            mod.widgets.HagencySectionTitle{text:A.t("Set up an account resource","设置账号资源")}
            mod.widgets.HagencyHint{text:A.t("1  Account and model selected  ·  2  Set limit  ·  3  Native confirmation","1  已选择账号与模型  ·  2  设置上限  ·  3  原生确认")}
            mod.widgets.HagencyFormGroup{
                mod.widgets.HagencyCopy{text:d.model.label}
                mod.widgets.HagencyHint{text:d.model.model}
                mod.widgets.HagencyHint{text:d.account.accountId}
                mod.widgets.HagencyCopy{text:A.t("Reasoning level","推理强度")}
                mod.widgets.HagencyActions{
                    for effort in enrollment_efforts {mod.widgets.HagencyChoice{enabled:!H.busy && H.command==nil draw_bg.color:if d.reasoning==effort{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} text:A.reasoning_label(effort) on_click: || {d.reasoning=effort A.redraw()}}}
                }
                mod.widgets.HagencyCopy{text:A.t("Declared monthly token limit","声明的每月 token 上限")}
                enrollment_tokens := mod.widgets.HagencyNumberInput{minimum:1 text:d.tokens empty_text:A.t("Positive whole amount","大于零的整数") on_change:|text|A.enrollment_tokens_changed(text)}
                mod.widgets.HagencyHint{text:A.t("− / + adjusts by 100,000 tokens; type any exact amount.","− / + 每次调整 10 万 token，也可输入精确数量。")}
                mod.widgets.HagencyHint{text:A.t("Resources using the same provider account share one declared limit. This number is not the provider’s remaining balance.","使用同一模型服务账号的资源共享一个声明上限；此数值不是服务商的剩余额度。")}
            }
            mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("What happens next","下一步")}
                mod.widgets.HagencyCopy{text:A.t("Hagency verifies this account and model, then saves an unpublished resource. You can review it before requesting a connection to this Matrix server.","Hagency 将验证此账号与模型，并保存未发布的资源。你可以先检查资源，再申请连接到此 Matrix 服务器。")}
                enrollment_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Review in Hagency","在 Hagency 中确认") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.enroll_account()}
            }
        }}
        if H.page=="resource_alerts" || H.page=="resource_alert" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                alerts_back := mod.widgets.HagencyButton{enabled:!H.busy text:if H.page=="resource_alert" {A.t("Back to alerts","返回告警列表")}else{A.t("Back to resource","返回资源")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || {if H.page=="resource_alert"{A.open_alerts(H.alert_resource,H.alert_after,H.alert_status)}else{A.open_resource(H.alert_resource)}}}
                alerts_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.refresh()}
            }
            mod.widgets.HagencyTitle{text:A.t("Resource alerts","资源告警")}
            mod.widgets.HagencyHint{text:H.alert_resource}
            mod.widgets.HagencyCopy{text:A.t("Review observations and record who is handling them. Alert status does not change budgets, running work or agent permissions.","查看观测并记录处理进度。告警状态不改变预算、正在进行的任务或 Agent 权限。")}
            if H.page=="resource_alerts" {View{width:Fill height:Fit flow:Down spacing:12
                mod.widgets.HagencyActions{
                    alerts_all := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("All states","全部状态") on_click: || A.open_alerts(H.alert_resource,"",nil)}
                    alerts_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Open only","仅待处理") on_click: || A.open_alerts(H.alert_resource,"","open")}
                }
                mod.widgets.HagencyHint{text:if H.alert_status==nil{A.t("Showing all states","显示全部状态")}else{A.t("Showing open alerts","显示待处理告警")}}
                if H.alert_page==nil {mod.widgets.HagencyCopy{text:if H.busy{A.t("Reading alerts…","正在读取告警…")}else{A.t("Alert list unavailable","告警列表暂不可用")}}}
                if H.alert_page!=nil {View{width:Fill height:Fit flow:Down spacing:12
                    if H.alert_page.alerts.len()==0 {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("No recorded alerts in this view","当前视图暂无告警记录")}
                        mod.widgets.HagencyHint{text:A.t("This is recorded history, not a fresh provider health check.","此处展示已记录的历史，不代表刚刚完成服务商健康检查。")}
                    }}
                    for row in H.alert_page.alerts {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:row.summary}
                        mod.widgets.HagencyCopy{text:A.alert_state(row.status)+" · "+A.alert_severity(row.severity)}
                        mod.widgets.HagencyHint{text:A.t("Occurrences · ","发生次数 · ")+row.occurrences}
                        alert_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Review alert","查看告警") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_alert(row.resourceId,row.id,0)}
                    }}
                    if H.alert_page.nextAfter!=nil {View{width:Fit height:Fit alerts_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next alerts","下一页告警") on_click: || A.open_alerts(H.alert_resource,H.alert_page.nextAfter,H.alert_status)}}}
                }}
            }}
            if H.page=="resource_alert" {View{width:Fill height:Fit flow:Down spacing:16
                if H.alert_detail==nil {mod.widgets.HagencyCopy{text:if H.busy{A.t("Reading alert…","正在读取告警…")}else{A.t("No current alert observation","暂无当前告警观测")}}}
                if H.alert_detail!=nil {View{width:Fill height:Fit flow:Down spacing:16
                    let row=H.alert_detail.alert
                    let quota=A.alert_budget(row)
                    mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:row.summary}
                        mod.widgets.HagencyCopy{text:A.alert_state(row.status)+" · "+A.alert_severity(row.severity)}
                        mod.widgets.HagencyHint{text:A.t("Occurrences · ","发生次数 · ")+row.occurrences}
                        if row.assignee!=nil {mod.widgets.HagencyCopy{text:A.t("Handled by · ","处理人 · ")+row.assignee}}
                        if row.lastSeen!=nil {mod.widgets.HagencyHint{text:A.t("Last observed · ","最近观测 · ")+row.lastSeen}}
                        if row.suppressUntil!=nil {mod.widgets.HagencyHint{text:A.t("Suppression deadline · ","抑制截止 · ")+row.suppressUntil}}
                        if quota.drawn!=nil || quota.ceiling!=nil {mod.widgets.HagencyDetailRow{
                            mod.widgets.HagencyFieldLabel{text:A.t("Recorded draw / ceiling","已记录占用 / 上限")}
                            mod.widgets.HagencyCopy{text:A.amount(quota.drawn)+" / "+A.amount(quota.ceiling)}
                        }}
                        mod.widgets.HagencyFieldLabel{text:A.t("Impact","影响")}
                        mod.widgets.HagencyCopy{text:row.impact}
                        mod.widgets.HagencyFieldLabel{text:A.t("Suggested response","处理建议")}
                        mod.widgets.HagencyCopy{text:row.runbook}
                        mod.widgets.HagencyFieldLabel{text:A.t("Recovery condition","恢复条件")}
                        mod.widgets.HagencyCopy{text:row.recoveryCondition}
                    }
                    if H.alert_draft==nil && row.next.len()>0 {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Update handling","更新处理进度")}
                        mod.widgets.HagencyActions{for next in row.next {View{width:Fit height:Fit alert_choose := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.alert_action(next) icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.choose_alert_action(next)}}}}
                    }}
                    if H.alert_draft!=nil {mod.widgets.HagencyFormGroup{
                        let draft=H.alert_draft
                        mod.widgets.HagencySectionTitle{text:A.alert_action(draft.to)}
                        mod.widgets.HagencyHint{text:A.t("This records a handling decision. It does not verify that the underlying issue is fixed.","此操作仅记录处理决定，并不验证底层问题已修复。")}
                        mod.widgets.HagencyFieldLabel{text:A.t("Note (optional)","备注（可选）")}
                        alert_note := mod.widgets.HagencyInput{text:draft.note empty_text:A.t("What did you check?","你核对了什么？") on_change:|text|{draft.note=text}}
                        mod.widgets.HagencyActions{
                            alert_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel","取消") on_click: || {H.alert_draft=nil A.redraw()}}
                            alert_save := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Save handling decision","保存处理决定") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.submit_alert()}
                        }
                    }}
                    mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Handling notes","处理备注")}
                        if H.alert_detail.notes.len()==0 {mod.widgets.HagencyHint{text:A.t("No notes on this page","本页暂无备注")}}
                        for note in H.alert_detail.notes {mod.widgets.HagencySection{
                            mod.widgets.HagencyCopy{text:note.text}
                            mod.widgets.HagencyHint{text:note.author}
                            if note.at!=nil {mod.widgets.HagencyHint{text:note.at}}
                        }}
                        if H.alert_detail.nextNote!=nil {View{width:Fit height:Fit alert_notes_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next notes","下一页备注") on_click: || A.open_alert(H.alert_resource,H.alert_id,H.alert_detail.nextNote)}}}
                        if H.alert_note_after>0 {View{width:Fit height:Fit alert_notes_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First notes","最早备注") on_click: || A.open_alert(H.alert_resource,H.alert_id,0)}}}
                    }
                }}
            }}
        }}
        if H.page=="stopped_tasks" {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
            mod.widgets.HagencyActions{
                stopped_back_resource := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_resource(H.stopped_resource)}
                stopped_list_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,H.stopped_after)}
            }
            mod.widgets.HagencyTitle{text:A.t("Interrupted tasks","中断的任务")}
            mod.widgets.HagencyCopy{text:A.t("1 · Inspect what happened   2 · Choose a decision   3 · Confirm","1 · 检查执行情况   2 · 选择处理方式   3 · 确认")}
            if H.stopped_list==nil {mod.widgets.HagencyHint{text:if H.busy{A.t("Reading interrupted tasks…","正在读取中断任务…")}else{A.t("Task list unavailable. Refresh to try again.","任务列表暂不可用，请刷新重试。")}}}
            if H.stopped_list!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                if H.stopped_list.dispatches.len()==0 {mod.widgets.HagencyCopy{text:A.t("No unresolved tasks on this page","本页暂无未处理的任务")}}
                for row in H.stopped_list.dispatches {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.agent}
                    mod.widgets.HagencyCopy{text:A.t("Project: ","项目：")+row.projectId}
                    mod.widgets.HagencyHint{text:A.t("Attempt: ","执行：")+row.dispatchId}
                    if !row.sharedResourceAuthority {mod.widgets.HagencyCopy{text:A.t("This workspace is shared. Access to every associated resource is required.","此工作区被共享，需要所有关联资源的权限。")}}
                    if !row.inspectionAvailable {mod.widgets.HagencyCopy{text:A.t("Inspection evidence is not available yet.","检查证据尚不可用。")}}
                    stopped_list_open := mod.widgets.HagencyButton{enabled:!H.busy && row.sharedResourceAuthority && row.inspectionAvailable text:A.t("Inspect task","检查任务") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || {if row.sharedResourceAuthority && row.inspectionAvailable {A.open_stopped(row.resourceId,row.engagementId,row.dispatchId,0)}}}
                }}
                mod.widgets.HagencyActions{
                    if H.stopped_after!="" {View{width:Fit height:Fit stopped_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","首页") on_click: || A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,"")}}}
                    if H.stopped_list.nextAfter!=nil {View{width:Fit height:Fit stopped_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click: || A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,H.stopped_list.nextAfter)}}}
                }
            }}
        }}
        if H.page=="stopped_task" {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
            mod.widgets.HagencyActions{
                stopped_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to interrupted tasks","返回中断任务") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,"")}
                stopped_refresh := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Refresh inspection","刷新检查") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || {if H.command==nil {A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,0)}}}
            }
            mod.widgets.HagencyTitle{text:if H.stopped_mode=="result"{A.t("Decision recorded","处理决定已记录")}else if H.stopped_mode=="confirm"{A.t("3 · Confirm your decision","3 · 确认处理决定")}else if H.stopped_mode=="choose"{A.t("2 · Choose how to proceed","2 · 选择处理方式")}else{A.t("1 · Inspect interrupted work","1 · 检查中断工作")}}
            if H.stopped_mode!="result" && H.stopped_detail==nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading inspection…","正在读取检查结果…")}else{A.t("Refresh to inspect the latest execution attempt.","请刷新以检查最新执行情况。")}}}
            if H.stopped_detail!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                let d=H.stopped_detail
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:d.attempt.agent}
                    mod.widgets.HagencyCopy{text:if d.taskTitle!=nil {d.taskTitle}else{A.t("Task title unavailable","任务标题暂不可用")}}
                    mod.widgets.HagencyHint{text:A.t("Project: ","项目：")+d.attempt.projectId+" · "+d.attempt.dispatchId}
                    if !d.resolvable {mod.widgets.HagencyCopy{text:A.t("Historical inspection only. The current task cannot be resolved from this record.","仅显示历史检查记录，不能据此处理当前任务。")}}
                    if d.resolvable && !d.canContinue {mod.widgets.HagencyCopy{text:A.t("The host could not prove that execution stopped. Continuation is unavailable; verify the process and external effects before settling the task.","设备无法证明执行已停止，不能继续。处理任务前，请核实进程和外部影响。")}}
                }
                if H.stopped_mode=="inspect" {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Retained workspace inventory","保留的工作区文件清单")}
                    mod.widgets.HagencyHint{text:A.t("This is the recorded inventory, not a live file view. Check external effects before deciding.","这是已记录的文件清单，并非实时文件视图。决定前请核实外部影响。")}
                    if d.entryCount==0 {mod.widgets.HagencyCopy{text:A.t("No recorded file entries","暂无文件记录")}}
                    for entry in d.entries {View{width:Fill height:Fit flow:Down spacing:(4 * mod.widgets.RINX_SPACING)
                        mod.widgets.HagencyCopy{text:entry.relativePath}
                        mod.widgets.HagencyHint{text:if entry.kind=="file" {A.t("File · bytes: ","文件 · 字节数：")+entry.bytes}else if entry.kind=="directory"{A.t("Directory","目录")}else{A.t("Symbolic link · target hidden","符号链接 · 目标不显示")}}
                    }}
                    mod.widgets.HagencyActions{
                        if H.stopped_offset>0 {View{width:Fit height:Fit stopped_inventory_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First files","首批文件") on_click: || A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,0)}}}
                        if d.nextEntry!=nil {View{width:Fit height:Fit stopped_inventory_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More files","更多文件") on_click: || A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,d.nextEntry)}}}
                    }
                    if d.resolvable && d.attempt.sharedResourceAuthority {mod.widgets.HagencyActions{stopped_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Review a decision","核对处理决定") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.review_stopped()}}}
                }}
                if H.stopped_mode=="choose" {mod.widgets.HagencyFormGroup{
                    mod.widgets.HagencyHint{text:A.t("Reviews expire 15 minutes after creation. Reopening a saved review does not extend it; refresh if it has expired.","核对自创建起 15 分钟后过期，重新打开不会延长有效期；过期后请刷新重新核对。")}
                    mod.widgets.HagencyActions{
                        if d.canContinue {View{width:Fit height:Fit stopped_choose_continue := mod.widgets.HagencyChoice{enabled:A.stopped_can_decide() text:A.stopped_action_label("continue") draw_bg.color:if H.stopped_action=="continue" {mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.choose_stopped("continue")}}}
                        stopped_choose_completed := mod.widgets.HagencyChoice{enabled:A.stopped_can_decide() text:A.stopped_action_label("accept_completed") draw_bg.color:if H.stopped_action=="accept_completed" {mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.choose_stopped("accept_completed")}
                        stopped_choose_blocked := mod.widgets.HagencyChoice{enabled:A.stopped_can_decide() text:A.stopped_action_label("keep_blocked") draw_bg.color:if H.stopped_action=="keep_blocked" {mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.close on_click: || A.choose_stopped("keep_blocked")}
                    }
                    mod.widgets.HagencyCopy{text:A.t("What did you verify?","你核实了什么？")}
                    stopped_note := mod.widgets.HagencyInput{is_read_only:!A.stopped_can_decide() height:64 is_multiline:true text:H.stopped_note empty_text:A.t("Record your inspection of the files and external effects","记录对文件和外部影响的检查") on_change:|text|{if A.stopped_can_decide(){H.stopped_note=text}}}
                    if H.stopped_action=="continue" {View{width:Fill height:Fit flow:Down spacing:(8 * mod.widgets.RINX_SPACING)
                        mod.widgets.HagencyCopy{text:A.t("Instructions for the remaining work","剩余工作的指令")}
                        stopped_instruction := mod.widgets.HagencyInput{is_read_only:!A.stopped_can_decide() height:64 is_multiline:true text:H.stopped_instruction empty_text:A.t("Explain what remains; avoid repeating completed effects","说明剩余工作，避免重复已完成的操作") on_change:|text|{if A.stopped_can_decide(){H.stopped_instruction=text}}}
                    }}
                    stopped_confirm_review := mod.widgets.RinxKeyPrimaryButton{enabled:A.stopped_can_decide() text:A.t("Review confirmation","核对确认") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.confirm_stopped()}
                }}
                if H.stopped_mode=="confirm" {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.stopped_action_label(H.stopped_action)}
                    mod.widgets.HagencyCopy{text:H.stopped_note}
                    mod.widgets.HagencyCopy{text:if H.stopped_action=="continue"{A.t("A new run will be queued for this task using the same workspace and message context.","将使用同一工作区和消息上下文，为此任务排队一次新执行。")}else if H.stopped_action=="accept_completed"{A.t("The task will be marked completed. Verify its result before confirming.","任务将被标记为已完成，请先核实结果。")}else{A.t("The execution incident will be settled; the task will remain blocked.","本次执行异常将被处理，任务仍保持阻塞。")}}
                    if H.stopped_action=="continue" {mod.widgets.HagencyCopy{text:H.stopped_instruction}}
                    mod.widgets.HagencyHint{text:A.t("This records your decision. It cannot undo effects that already happened.","此操作记录你的决定，不能撤销已经产生的影响。")}
                    mod.widgets.HagencyActions{
                        stopped_cancel := mod.widgets.HagencyButton{enabled:A.stopped_can_decide() text:A.t("Back","返回") on_click: || {if A.stopped_can_decide(){H.stopped_mode="choose" A.redraw()}}}
                        stopped_commit := mod.widgets.RinxKeyPrimaryButton{enabled:A.stopped_can_decide() text:A.t("Confirm decision","确认决定") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.submit_stopped()}
                    }
                }}
            }}
            if H.stopped_mode=="result" && H.stopped_result!=nil {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.stopped_action_label(H.stopped_result.action)}
                mod.widgets.HagencyCopy{text:A.t("Task: ","任务：")+H.stopped_result.taskId}
                mod.widgets.HagencyHint{text:A.t("This is the saved result of your decision. Refresh to see later activity. Reopening it does not repeat the action.","这是处理决定的已保存结果。请刷新查看后续活动；重新打开不会重复执行此操作。")}
            }}
        }}
        if H.page=="workspaces" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                workspace_list_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_resource(H.workspace_resource)}
                workspace_list_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_workspaces(H.workspace_resource,H.workspace_after)}
            }
            mod.widgets.HagencyTitle{text:A.t("Workspace recovery","工作区恢复")}
            mod.widgets.HagencyCopy{text:A.t("Review workspaces used by this resource. Running tasks and unresolved execution outcomes must be handled before a workspace can be released.","核对此资源使用的工作区。解除标记前，需要先处理运行中的任务及尚未确认的执行结果。")}
            if H.workspace_list==nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading workspaces…","正在读取工作区…")}else{A.t("Workspace list unavailable","工作区列表暂不可用")}}}
            if H.workspace_list!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                if H.workspace_list.workspaces.len()==0 {mod.widgets.HagencyHint{text:A.t("No recorded workspaces on this page","本页暂无工作区记录")}}
                for row in H.workspace_list.workspaces {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.workspace_state(row)}
                    mod.widgets.HagencyHint{text:row.workspaceId}
                    mod.widgets.HagencyCopy{text:A.t("Active tasks: ","占用任务：")+row.activeLeases}
                    mod.widgets.HagencyActions{workspace_list_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View workspace","查看工作区") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_workspace(row.resourceId,row.workspaceId)}}
                }}
                mod.widgets.HagencyActions{
                    if H.workspace_after!="" {View{width:Fit height:Fit workspace_list_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","首页") on_click: || A.open_workspaces(H.workspace_resource,"")}}}
                    if H.workspace_list.nextAfter!=nil {View{width:Fit height:Fit workspace_list_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click: || A.open_workspaces(H.workspace_resource,H.workspace_list.nextAfter)}}}
                }
            }}
        }}
        if H.page=="workspace" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                workspace_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to workspaces","返回工作区列表") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_workspaces(H.workspace_resource,H.workspace_after)}
                workspace_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh status","刷新状态") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_workspace(H.workspace_resource,H.workspace_id)}
            }
            mod.widgets.HagencyTitle{text:if H.workspace_mode=="result" {A.t("Workspace marker cleared","已解除工作区标记")}else if H.workspace_mode=="review" {A.t("Review workspace release","核对工作区释放")}else{A.t("Workspace recovery","工作区恢复")}}
            if H.workspace_detail==nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading workspace status…","正在读取工作区状态…")}else{A.t("Refresh to read current workspace status.","请刷新以读取工作区当前状态。")}}}
            if H.workspace_detail!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                let row=H.workspace_detail
                mod.widgets.HagencyHint{text:row.workspaceId}
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.workspace_state(row)}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Active tasks","占用任务")} mod.widgets.HagencyCopy{text:""+row.activeLeases}}
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Associated resources","关联资源")} mod.widgets.HagencyCopy{text:""+row.sharedResourceCount}}
                    if row.releaseBlock=="shared_resource_authority" {mod.widgets.HagencyCopy{text:A.t("This workspace is shared. Access to every associated resource is required to clear its marker.","此工作区由多个资源共用。解除标记需要拥有全部关联资源的权限。")}}
                    if row.quarantined {mod.widgets.HagencyCopy{text:A.workspace_error("management_workspace_inspection_required")}}
                    if row.activeLeases>0 && !row.quarantined {mod.widgets.HagencyCopy{text:A.workspace_error("management_workspace_active")}}
                    if H.workspace_mode=="result" {mod.widgets.HagencyHint{text:A.t("This is the saved result of your request. Refresh to see later activity; recovering this request never clears a newer failure.","这是此请求已保存的结果。请刷新查看后续活动；恢复此请求不会解除新的故障标记。")}}
                    if H.workspace_mode=="detail" && !row.dirty && row.releaseBlock==nil {mod.widgets.HagencyHint{text:A.t("No recovery action is needed.","无需恢复操作。")}}
                }
                if row.quarantined {mod.widgets.HagencyActions{workspace_stopped := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Inspect interrupted tasks","检查中断任务") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_stopped_tasks(row.resourceId,row.workspaceId,"")}}}
                if A.workspace_can_clear() {mod.widgets.HagencyActions{workspace_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Review release","核对释放") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.review_workspace()}}}
                if H.workspace_mode=="review" && H.workspace_review!=nil {mod.widgets.HagencySection{
                    mod.widgets.HagencyCopy{text:A.t("Inspect the local workspace before confirming. This removes its dirty marker and permits future tasks; it does not undo file changes or restart a task.","确认前请检查本机工作区。此操作会解除故障标记并允许后续任务使用，不会撤销文件修改或重新启动任务。")}
                    mod.widgets.HagencyActions{
                        workspace_cancel := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Cancel","取消") on_click: || {if !H.busy && H.command==nil {H.workspace_mode="detail" H.workspace_review=nil A.redraw()}}}
                        workspace_confirm := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Inspected · clear marker","已检查 · 解除标记") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.submit_workspace()}
                    }
                }}
            }}
        }}

        if H.page=="shared_approvals" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                approval_back := mod.widgets.HagencyButton{text:A.t("Back to agents","返回 Agent 列表") enabled:!H.busy on_click: || A.open_policies(H.policy_resource,"")}
                approval_refresh := mod.widgets.HagencyButton{text:A.t("Refresh requests","刷新请求") enabled:!H.busy on_click: || A.open_shared_approvals()}
            }
            mod.widgets.HagencyTitle{text:A.t("Permission requests","权限请求")}
            mod.widgets.HagencyCopy{text:A.t("Managers can approve file access within the owner-authorized workspace. Broader access needs the resource owner. Session approval ends with the current Codex session.","管理者可批准所有者授权工作区内的文件访问。更大范围的权限需资源所有者批准。会话批准在当前 Codex 会话结束时失效。")}
            if H.shared_approvals.len()==0 {mod.widgets.HagencyHint{text:A.t("No pending requests. Refresh when an Agent asks for permission.","暂无待处理请求。Agent 请求权限后，请刷新。")}}
            for row in H.shared_approvals {mod.widgets.HagencySection{
                let a=row.approval
                mod.widgets.HagencySectionTitle{text:a.agentName}
                mod.widgets.HagencyCopy{text:a.requesterMxid+" · "+a.roomId}
                mod.widgets.HagencyHint{text:A.t("Source message: ","来源消息：")+a.eventId}
                mod.widgets.HagencyCopy{text:a.request.to_json()}
                if row.canDecide && row.decision==nil {View{width:Fill height:Fit flow:Down spacing:8
                    approval_once := mod.widgets.HagencyButton{width:Fill text:A.t("Approve once","仅批准一次") enabled:!H.busy on_click: || A.decide_shared_approval(row,"approve_once")}
                    if a.request.sessionAllowed {approval_session := mod.widgets.HagencyButton{width:Fill text:A.t("Always approve for this session","本次会话始终批准") enabled:!H.busy on_click: || A.decide_shared_approval(row,"approve_session")}}
                    approval_deny := mod.widgets.HagencyButton{width:Fill text:A.t("Deny","拒绝") enabled:!H.busy on_click: || A.decide_shared_approval(row,"deny")}
                }}
                if !row.canDecide {mod.widgets.HagencyHint{text:A.t("Waiting for resource owner: ","等待资源所有者：")+a.ownerMxid}}
                if row.decision!=nil {mod.widgets.HagencyHint{text:A.t("Decision sent","决定已发送")}}
            }}
        }}
        if H.page=="execution_policies" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                policy_list_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_resource(H.policy_resource)}
                policy_list_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_policies(H.policy_resource,H.policy_after)}
            }
            mod.widgets.HagencyActions{permission_inbox := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Pending permission requests","待处理权限请求") on_click: || A.open_shared_approvals()}}
            mod.widgets.HagencyTitle{text:A.t("Agent execution permissions","Agent 执行权限")}
            mod.widgets.HagencyCopy{text:A.t("Choose an agent on this resource. Changes take effect when its next task starts.","选择此资源上的 Agent。修改在下一个任务开始时生效。")}
            if H.policy_list==nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading agents…","正在读取 Agent…")}else{A.t("Agent list unavailable","Agent 列表暂不可用")}}}
            if H.policy_list!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                if H.policy_list.agents.len()==0 {mod.widgets.HagencyHint{text:A.t("No agents on this page","本页暂无 Agent")}}
                for row in H.policy_list.agents {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.agent}
                    if A.shared_mode(row)==nil {mod.widgets.HagencyCopy{text:A.tool_project(row)}}
                    mod.widgets.HagencyHint{text:A.policy_mode_label(row)}
                    mod.widgets.HagencyActions{policy_list_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View permissions","查看权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_policy(row.resourceId,row.engagementId)}}
                }}
                mod.widgets.HagencyActions{
                    if H.policy_after!="" {View{width:Fit height:Fit policy_list_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","首页") on_click: || A.open_policies(H.policy_resource,"")}}}
                    if H.policy_list.nextAfter!=nil {View{width:Fit height:Fit policy_list_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click: || A.open_policies(H.policy_resource,H.policy_list.nextAfter)}}}
                }
            }}
        }}
        if H.page=="execution_policy" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                policy_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to agents","返回 Agent 列表") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_policies(H.policy_resource,H.policy_after)}
                policy_refresh := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Refresh permissions","刷新权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_policy(H.policy_resource,H.policy_engagement)}
            }
            mod.widgets.HagencyTitle{text:if H.policy_mode=="result" {A.t("Permissions saved","权限已保存")}else if H.policy_mode=="review" {A.t("Review permissions","核对权限")}else{A.t("Execution permissions","执行权限")}}
            if H.policy_detail==nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading current permissions…","正在读取当前权限…")}else{A.t("Refresh to read current permissions.","请刷新以读取当前权限。")}}}
            if H.policy_detail!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                let row=H.policy_detail
                mod.widgets.HagencySectionTitle{text:row.agent}
                if A.shared_mode(row)==nil {mod.widgets.HagencyCopy{text:A.t("Project: ","项目：")+A.tool_project(row)}}
                mod.widgets.HagencySection{
                    mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:if H.policy_mode=="result" {A.t("Saved mode","已保存模式")}else{A.t("Current mode","当前模式")}} mod.widgets.HagencyCopy{text:A.policy_mode_label(row)}}
                    if H.policy_mode=="review" && H.policy_draft!=nil {mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("New mode","新模式")} mod.widgets.HagencyCopy{text:A.policy_label(H.policy_draft.executionPolicy.yolo)}}}
                    mod.widgets.HagencyHint{text:A.t("Applies to the next task. Running tasks keep their current permissions; read-only tasks remain read-only.","在下一个任务生效。运行中的任务保持当前权限，只读任务仍保持只读。")}
                    if H.policy_mode=="result" {mod.widgets.HagencyHint{text:A.t("This is the saved result of your request. Refresh to see any later changes.","这是此请求已保存的结果，刷新可查看后续修改。")}}
                }
                if H.policy_mode=="detail" || H.policy_mode=="result" {mod.widgets.HagencyActions{
                    policy_grants := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:if A.shared_mode(row)!=nil {A.t("Pending permission requests","待处理权限请求")}else{A.t("Saved tool permissions","已保存的工具权限")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_policy_grants()}
                }}
                if H.policy_mode=="detail" || H.policy_mode=="edit" {View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                    let selected=if H.policy_draft==nil {row.executionPolicy.yolo}else{H.policy_draft.executionPolicy.yolo}
                    mod.widgets.HagencyFormGroup{
                        policy_standard := mod.widgets.HagencyChoice{width:Fill enabled:!H.busy && H.command==nil text:A.t("Standard permissions","标准权限") draw_bg.color:if !selected && (A.shared_mode(row)!="chat" || H.policy_draft!=nil) {mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.choose_policy(false)}
                        mod.widgets.HagencyCopy{text:if row.framework=="codex" {A.t("Codex uses its workspace sandbox. Managers may approve workspace file access; broader access requires the resource owner.","Codex 使用工作区沙箱。管理者可批准工作区内的文件访问，更大范围的权限由资源所有者批准。")}else{A.t("This runtime keeps its normal tool approval rules.","此运行时保持常规的工具审批规则。")}}
                    }
                    if row.framework=="codex" {mod.widgets.HagencyFormGroup{
                        policy_unrestricted := mod.widgets.HagencyChoice{width:Fill enabled:!H.busy && H.command==nil text:A.t("YOLO — unrestricted","YOLO — 不受限") draw_bg.color:if selected {mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.choose_policy(true)}
                        mod.widgets.HagencyCopy{text:A.t("Can access files outside the workspace and the network without tool approval prompts.","可访问工作区以外的文件和网络，不再弹出工具审批请求。")}
                    }}
                    if row.framework!="codex" {mod.widgets.HagencyHint{text:A.t("Unrestricted mode is only available for Codex.","不受限模式仅支持 Codex。")}}
                    if H.policy_draft!=nil {mod.widgets.HagencyActions{
                        policy_cancel := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Cancel","取消") on_click: || {H.policy_draft=nil H.policy_mode="detail" A.redraw()}}
                        policy_review := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil && (H.policy_draft.executionPolicy.yolo!=row.executionPolicy.yolo || A.shared_mode(row)=="chat") text:A.t("Review change","核对修改") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.review_policy()}
                    }}
                }}
                if H.policy_mode=="review" && H.policy_draft!=nil {View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                    if H.policy_draft.executionPolicy.yolo {mod.widgets.HagencyCopy{text:A.t("This agent will be able to access files outside its workspace and the network without tool approval prompts.","此 Agent 将能访问工作区以外的文件和网络，无需工具审批。")}}
                    mod.widgets.HagencyActions{
                        policy_review_back := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Back","返回") on_click: || {H.policy_mode="edit" A.redraw()}}
                        policy_save := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Save permissions","保存权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.submit_policy()}
                    }
                }}
            }}
        }}
        if H.page=="tool_approvals" || H.page=="tool_grants" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                tools_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_resource(H.tool_resource)}
                tools_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_tools(H.tool_resource,H.tool_engagement,H.tool_after,H.tool_kind)}
            }
            mod.widgets.HagencyTitle{text:if H.tool_kind=="requests"{A.t("Tool approvals","工具审批")}else{A.t("Saved tool permissions","已保存的工具权限")}}
            if H.tool_kind=="requests" {mod.widgets.HagencyCopy{text:A.t("Statuses reflect the last refresh. Approve or deny from the agent's private approval room in Rinx.","状态以上次刷新为准。在 Rinx 中 Agent 的私密审批房间内批准或拒绝。")}}
            if H.tool_kind=="rules" {mod.widgets.HagencyCopy{text:A.t("Review permissions saved for this agent. You can revoke a permission when it is no longer needed.","核对为此 Agent 保存的权限，不再需要时可撤销。")}}
            if H.tool_page==nil {mod.widgets.HagencyHint{text:if H.busy{A.t("Reading tool permissions…","正在读取工具权限…")}else{A.t("Tool records unavailable","工具记录暂不可用")}}}
            if H.tool_page!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                if H.tool_kind=="requests" {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                    if H.tool_page.approvals.len()==0 {mod.widgets.HagencyHint{text:A.t("No tool requests on this page","本页暂无工具请求")}}
                    for row in H.tool_page.approvals {mod.widgets.HagencySection{
                        let subject=A.tool_subject(H.tool_page,row.engagementId)
                        mod.widgets.HagencySectionTitle{text:A.tool_agent(subject)}
                        mod.widgets.HagencyCopy{text:A.tool_request_status(row,H.tool_page.observedAtMs)}
                        mod.widgets.HagencyHint{text:A.tool_choice(row.choice)}
                        mod.widgets.HagencyCopy{text:A.t("Project: ","项目：")+A.tool_project(subject)}
                        mod.widgets.HagencyHint{text:row.id}
                        mod.widgets.HagencyActions{tool_request_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View request","查看请求") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_tool_request(row.id)}}
                    }}
                }}
                if H.tool_kind=="rules" {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                    if H.tool_page.grants.len()==0 {mod.widgets.HagencyHint{text:A.t("No saved tool permissions on this page","本页暂无已保存的工具权限")}}
                    for row in H.tool_page.grants {mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:row.agent+" · "+A.tool_kind(row.kind)}
                        mod.widgets.HagencyHint{text:if row.revoked{A.t("Revoked","已撤销")}else if !row.bindingCurrent{A.t("Approval-room link needs verification","审批房间绑定需要验证")}else{A.tool_choice(row.mode)}}
                        if row.details!=nil {View{width:Fill height:Fit flow:Down spacing:(8 * mod.widgets.RINX_SPACING)
                            mod.widgets.HagencyCopy{max_lines:3 text_overflow:Ellipsis text:row.details.description}
                            mod.widgets.HagencyHint{text:row.details.ownerMxid+" · "+row.details.projectId}
                        }}
                        if row.details==nil {mod.widgets.HagencyHint{text:A.t("Original rule description unavailable","原始权限说明不可用")}}
                        if row.taskId!=nil {mod.widgets.HagencyHint{text:A.t("Task: ","任务：")+row.taskId}}
                        if !row.revoked {mod.widgets.HagencyActions{tool_grant_review := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Review permission","查看权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.review_tool_grant(row)}}}
                    }}
                }}
                mod.widgets.HagencyActions{
                    if H.tool_after!="" {View{width:Fit height:Fit tools_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","首页") on_click: || A.open_tools(H.tool_resource,H.tool_engagement,"",H.tool_kind)}}}
                    if H.tool_page.nextAfter!=nil {View{width:Fit height:Fit tools_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click: || A.open_tools(H.tool_resource,H.tool_engagement,H.tool_page.nextAfter,H.tool_kind)}}}
                }
            }}
        }}
        if H.page=="tool_request" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                tool_request_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to requests","返回请求列表") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_tools(H.tool_resource,H.tool_engagement,H.tool_after,"requests")}
                tool_request_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_tool_request(H.tool_request_id)}
            }
            mod.widgets.HagencyTitle{text:A.t("Tool request","工具请求")}
            if H.tool_selected==nil {mod.widgets.HagencyHint{text:if H.busy{A.t("Reading current request…","正在读取请求最新状态…")}else{A.t("Request information unavailable","请求信息暂不可用")}}}
            if H.tool_selected!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                let selected=H.tool_selected let row=selected.approval
                mod.widgets.HagencySectionTitle{text:A.tool_agent(selected.subject)}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project","项目")} mod.widgets.HagencyCopy{text:A.tool_project(selected.subject)}}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Status","状态")} mod.widgets.HagencyCopy{text:A.tool_request_status(row,selected.observedAtMs)}}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Decision","决定")} mod.widgets.HagencyCopy{text:A.tool_choice(row.choice)}}
                mod.widgets.HagencyHint{text:A.tool_deadline(row,selected.observedAtMs)}
                mod.widgets.HagencyHint{text:row.id}
                mod.widgets.HagencyCopy{text:A.t("Open the private approval inbox to review the original tool details and latest decisions. Opening it does not approve or repeat an operation.","打开私密审批收件箱，查看原始工具详情和最新决定。打开收件箱不会批准或重复执行操作。")}
                if row.projectRoomId==nil {mod.widgets.HagencyHint{text:A.tool_error("tool_approval_room_unavailable")}}
                mod.widgets.HagencyActions{
                    tool_request_inbox := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && row.projectRoomId!=nil text:A.t("Open approval inbox","打开审批收件箱") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_tool_inbox()}
                    tools_agent_rules := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Agent's saved permissions","Agent 已保存权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_tools(H.tool_resource,row.engagementId,"","rules")}
                }
            }}
        }}
        if H.page=="tool_grant_review" && H.tool_draft!=nil {mod.widgets.HagencyDetailCard{
            let d=H.tool_draft
            mod.widgets.HagencyTitle{text:A.t("Revoke this tool permission?","撤销此工具权限？")}
            mod.widgets.HagencySectionTitle{text:d.agent+" · "+A.tool_kind(d.kind)}
            mod.widgets.HagencyHint{text:A.tool_choice(d.mode)}
            if d.details!=nil {View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                mod.widgets.HagencyCopy{text:d.details.description}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Owner","所有者")} mod.widgets.HagencyCopy{text:d.details.ownerMxid}}
                mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project","项目")} mod.widgets.HagencyCopy{text:d.details.projectId}}
            }}
            if d.details==nil {mod.widgets.HagencyHint{text:A.t("Original rule description unavailable","原始权限说明不可用")}}
            if d.taskId!=nil {mod.widgets.HagencyCopy{text:A.t("Task: ","任务：")+d.taskId}}
            mod.widgets.HagencyHint{text:d.id}
            mod.widgets.HagencyCopy{text:A.t("Future matching requests will no longer use this saved permission. This does not cancel a tool action that has already started.","之后匹配的请求将不再使用此权限。已开始的工具操作不会因此取消。")}
            mod.widgets.HagencyActions{
                tool_grant_cancel := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Cancel","取消") on_click: || {if !H.busy && H.command==nil {H.tool_draft=nil H.page="tool_grants" A.redraw()}}}
                tool_grant_revoke := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Revoke permission","撤销权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.close on_click: || A.submit_tool_grant()}
            }
        }}
        if H.page=="tool_grant_result" && H.tool_result!=nil {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyTitle{text:A.t("Tool permission revoked","工具权限已撤销")}
            mod.widgets.HagencyCopy{text:H.tool_result.grantId}
            mod.widgets.HagencyHint{text:A.t("This is the saved result of your request. Refresh to see current permissions.","这是该请求已保存的处理结果，刷新可查看当前权限。")}
            mod.widgets.HagencyActions{
                tool_result_refresh := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("View current permissions","查看当前权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_tools(H.tool_resource,H.tool_engagement,"","rules")}
                tool_result_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_resource(H.tool_resource)}
            }
        }}
        if H.page=="approval_bindings" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                bindings_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_resource(H.binding_resource)}
                bindings_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_bindings(H.binding_resource,H.binding_after)}
            }
            mod.widgets.HagencyTitle{text:A.t("Approval rooms","审批房间")}
            mod.widgets.HagencyCopy{text:A.t("Review which private room handles tool approvals for each agent on this resource.","查看此资源上各 Agent 用于工具审批的私密房间。")}
            mod.widgets.HagencyFormGroup{
                mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Agent name (optional)","Agent 名称（可选）")}
                binding_agent_filter := mod.widgets.HagencyInput{text:H.binding_filter_draft.agent empty_text:A.t("Exact agent name","完整 Agent 名称") on_change:|text|{if !H.busy {H.binding_filter_draft.agent=text}}}
                mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Project ID or project room (optional)","项目 ID 或项目房间（可选）")}
                binding_project_filter := mod.widgets.HagencyInput{text:H.binding_filter_draft.project empty_text:A.t("Project ID or !room:server","项目 ID 或 !room:server") on_change:|text|{if !H.busy {H.binding_filter_draft.project=text}}}
                mod.widgets.HagencyHint{text:A.t("The project room is separate from the private approval room shown below.","项目房间与下方显示的私密审批房间不同。")}
                mod.widgets.HagencyActions{
                    bindings_filter := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Apply filters","应用筛选") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.search on_click: || A.filter_bindings()}
                    bindings_clear := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Clear filters","清除筛选") on_click: || A.clear_binding_filters()}
                }
                if H.binding_filters.agent!="" {mod.widgets.HagencyHint{text:A.t("Agent filter: ","Agent 筛选：")+H.binding_filters.agent}}
                if H.binding_filters.project!="" {mod.widgets.HagencyHint{text:A.t("Project filter: ","项目筛选：")+H.binding_filters.project}}
            }
            if H.binding_page==nil {mod.widgets.HagencyHint{text:if H.busy {A.t("Reading approval rooms…","正在读取审批房间…")}else{A.t("Room list unavailable","房间列表暂不可用")}}}
            if H.binding_page!=nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                if H.binding_page.bindings.len()==0 {mod.widgets.HagencyHint{text:A.t("No recorded approval-room links on this page","本页暂无已记录的审批房间绑定")}}
                for row in H.binding_page.bindings {mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.agent}
                    mod.widgets.HagencyCopy{text:row.roomId}
                    mod.widgets.HagencyHint{text:row.ownerMxid}
                    mod.widgets.HagencyHint{text:if row.active {A.t("Active link","有效绑定")}else{A.t("Link needs verification","绑定需要验证")}}
                    mod.widgets.HagencyActions{binding_tool_rules := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Saved tool permissions","已保存的工具权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_tools(row.resourceId,row.engagementId,"","rules")}}
                    mod.widgets.HagencyActions{binding_review := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Review link","查看绑定") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.review_binding(row)}}
                }}
                mod.widgets.HagencyActions{
                    if H.binding_after!="" {View{width:Fit height:Fit bindings_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","首页") on_click: || A.open_bindings(H.binding_resource,"")}}}
                    if H.binding_page.nextAfter!=nil {View{width:Fit height:Fit bindings_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click: || A.open_bindings(H.binding_resource,H.binding_page.nextAfter)}}}
                }
            }}
        }}
        if H.page=="approval_binding_review" && H.binding_draft!=nil {mod.widgets.HagencyDetailCard{
            let d=H.binding_draft
            mod.widgets.HagencyTitle{text:A.t("Remove this approval-room link?","解除此审批房间绑定？")}
            mod.widgets.HagencySectionTitle{text:d.agent}
            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Room","房间")} mod.widgets.HagencyCopy{text:d.roomId}}
            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Approver","审批人")} mod.widgets.HagencyCopy{text:d.ownerMxid}}
            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Project","项目")} mod.widgets.HagencyCopy{text:d.projectId}}
            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Server","服务器")} mod.widgets.HagencyCopy{text:d.serverName}}
            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Agent engagement","Agent 关联")} mod.widgets.HagencyCopy{text:d.engagementId}}
            mod.widgets.HagencyCopy{text:A.t("Removing this link revokes its saved tool approvals. Pending approvals from this link can no longer authorize execution.","解除绑定将撤销其已保存的工具授权。此绑定下待处理的审批将无法再授权执行。")}
            mod.widgets.HagencyHint{text:A.t("A later verified room observation can create a new link. Revoked approvals stay revoked.","后续房间验证可能创建新的绑定，已撤销的授权仍然失效。")}
            mod.widgets.HagencyActions{
                binding_cancel := mod.widgets.HagencyButton{enabled:!H.busy && H.command==nil text:A.t("Cancel","取消") on_click: || {if !H.busy && H.command==nil {H.binding_draft=nil H.page="approval_bindings" A.redraw()}}}
                binding_remove := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Remove link","解除绑定") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.close on_click: || A.submit_binding()}
            }
        }}
        if H.page=="approval_binding_result" && H.binding_result!=nil {mod.widgets.HagencyDetailCard{
            let result=H.binding_result
            mod.widgets.HagencyTitle{text:A.t("Approval-room link removed","审批房间绑定已解除")}
            mod.widgets.HagencySectionTitle{text:result.binding.agent}
            mod.widgets.HagencyCopy{text:result.binding.roomId}
            mod.widgets.HagencyCopy{text:A.t("Saved tool approvals revoked: ","已撤销的工具授权：")+result.revokedGrants}
            mod.widgets.HagencyHint{text:A.t("This is the saved result of your request. Refresh to see the resource's current links.","这是该请求已保存的处理结果。刷新可查看资源当前的绑定。")}
            mod.widgets.HagencyActions{
                binding_result_refresh := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("View current links","查看当前绑定") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.open_bindings(H.binding_resource,"")}
                binding_result_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.open_resource(H.binding_resource)}
            }
        }}
        if H.page=="web_overview"{
            mod.widgets.HagencyDetailCard{
                let w=H.web
                mod.widgets.HagencyTitle{text:A.web_title(w.kind)}
                mod.widgets.HagencyActions{
                    for kind in ["workforce","capability","usage","accounts","alerts"]{View{width:Fit height:Fit web_section := mod.widgets.HagencyChoice{enabled:!H.busy text:A.web_title(kind) draw_bg.color:if w.kind==kind{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||A.open_web(kind,nil)}}}
                }
                if w.kind=="alerts"{mod.widgets.HagencyFormGroup{
                    mod.widgets.HagencyActions{for status in ["","open","acknowledged","investigating","resolved","suppressed"]{View{width:Fit height:Fit web_alert_status := mod.widgets.HagencyChoice{enabled:!H.busy text:if status==""{A.t("All statuses","全部状态")}else{A.alert_state(status)} draw_bg.color:if status==w.status{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||{w.status=status A.open_web("alerts",nil)}}}}}
                    mod.widgets.HagencyActions{for severity in ["","critical","warning","info"]{View{width:Fit height:Fit web_alert_severity := mod.widgets.HagencyChoice{enabled:!H.busy text:if severity==""{A.t("All severities","全部严重程度")}else{A.alert_severity(severity)} draw_bg.color:if severity==w.severity{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||{w.severity=severity A.open_web("alerts",nil)}}}}}
                    mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Agent/resource ID","Agent / 资源标识")}
                    web_alert_agent := mod.widgets.HagencyInput{empty_text:A.t("All agents and resources","全部 Agent 与资源") text:w.agent on_change:|s|{w.agent=s} on_return:|s|{w.agent=s A.open_web("alerts",nil)}}
                    web_alert_filter := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Apply filter","应用筛选") on_click:||A.open_web("alerts",nil)}
                }}
                if w.data!=nil{View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                    let data=w.data
                    if w.kind=="workforce"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        mod.widgets.HagencyHint{text:A.t("Agents, project access and capacity in one place. Open a row to manage its latest state.","集中查看 Agent、项目访问权与容量，打开记录管理最新状态。")}
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No agents in this view.","此视图暂无 Agent。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.name}
                            mod.widgets.HagencyCopy{text:(if row.projectName==nil{row.projectId}else{row.projectName})+" · "+A.agent_state_text(row.state)}
                            mod.widgets.HagencyHint{text:row.managerMxid+" · "+A.capability_label(row.capability)}
                            mod.widgets.HagencyCopy{text:A.t("Requested allocation","申请额度")+" · "+A.amount(row.requestedTokens)+" token · "+row.periodKey}
                            if row.account!=nil{mod.widgets.HagencyCopy{text:A.t("Provider account","模型服务账号")+" · "+row.account}}
                            if row.localBinding!=nil{mod.widgets.HagencySection{
                                let binding=row.localBinding
                                mod.widgets.HagencyCopy{text:A.t("Consumed / reserved / allocated","已用 / 已预留 / 已分配")+" · "+A.amount(binding.knownConsumedTokens)+" / "+A.amount(binding.retainedTokens)+" / "+A.amount(binding.allocatedTokens)}
                                mod.widgets.HagencyHint{text:A.t("Execution status","执行状态")+" · "+binding.processState}
                                if !binding.usageComplete{mod.widgets.HagencyHint{text:A.t("Usage is incomplete; pending accounting is retained.","用量尚不完整，待核算额度仍保留。")}}
                                web_workforce_resource := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Resource and account","资源与账号") on_click:||A.open_resource(binding.resourceId)}
                            }}else{mod.widgets.HagencyHint{text:A.t("No local execution binding is recorded for this request.","此申请尚无本地执行关联记录。")}}
                            mod.widgets.HagencyActions{
                                if A.recipient_optional(row,"canOpenAgent")==true{View{width:Fit height:Fit flow:Right spacing:(8 * mod.widgets.RINX_SPACING)
                                    web_agent_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Manage agent","管理 Agent") on_click:||A.open_agent(row.id)}
                                    web_agent_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Project","项目") on_click:||A.open_project(row.projectId)}
                                }}
                                web_agent_terminal := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Terminal","终端") on_click:||A.open_web_terminal(row.id)}
                            }
                            mod.widgets.HagencyDivider{}
                        }}
                    }}
                    if w.kind=="capability"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No resource configurations yet.","暂无资源配置。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.resource_title(row.resource)}
                            mod.widgets.HagencyCopy{text:row.resource.framework+" · "+row.resource.model+" · "+A.reasoning_label(row.resource.reasoning)}
                            mod.widgets.HagencyHint{text:A.t("Family / tier","系列 / 级别")+" · "+A.amount(A.recipient_optional(row,"family"))+" / "+A.amount(row.modelTier)}
                            for role in row.roles{View{width:Fill height:Fit flow:Down
                                mod.widgets.HagencyCopy{text:A.capability_label(role.role)+" · "+if role.qualified{A.t("Qualified","已合格")}else{A.t("Not qualified","不合格")}}
                                if A.recipient_optional(row,"offersEditable")==false{View{width:Fill height:Fit flow:Down
                                    mod.widgets.HagencyHint{text:if role.published{A.t("Saved offer: published","已保存的报价：已发布")}else{A.t("Saved offer: not published","已保存的报价：未发布")}}
                                    mod.widgets.HagencyHint{text:A.t("Count / tokens per engagement / daily tokens","数量 / 每次合作 token / 每日 token")+" · "+if role.count==nil{A.t("Not set","未设置")}else{""+role.count}+" / "+if role.budgetCapPerEngagement==nil{A.t("Not set","未设置")}else{""+role.budgetCapPerEngagement}+" / "+if role.rateCap==nil{A.t("Not set","未设置")}else{""+role.rateCap}}
                                }}
                            }}
                            if A.recipient_optional(row,"offersEditable")==false{
                                mod.widgets.HagencyHint{text:A.t("Retained offers are read-only in this older owner installation. Complete supported device setup to manage offers in the adopted resource catalogue.","旧版所有者安装中的已保存报价为只读。完成受支持的设备设置后，可在已接管的资源目录中管理报价。")}
                            }else{
                                mod.widgets.HagencyActions{web_capability_offer := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Edit standing offers","编辑长期报价") on_click:||A.open_web_catalog(row.resource.id,"offers",nil)}}
                            }
                            mod.widgets.HagencyDivider{}
                        }}
                    }}
                    if w.kind=="usage"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        mod.widgets.HagencyHint{text:A.t("Recorded token usage. Unknown measurements are shown explicitly; cache reads are separate from fresh tokens.","显示已记录的 token 用量，未知数据会明确标出，缓存读取与新 token 分别统计。")}
                        mod.widgets.HagencyCopy{text:A.t("Authorized resources","有权查看的资源")}
                        for period in data.totals.byPeriod{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.resource_period(period.period)}
                            mod.widgets.HagencyCopy{text:A.t("Fresh / total tokens","新 token / 总 token")+" · "+A.amount(period.knownFreshTokens)+" / "+A.amount(period.knownTotalTokens)}
                            mod.widgets.HagencyHint{text:A.t("Measured resources / resources","有测量记录的资源 / 资源数")+" · "+A.amount(period.measuredResourceCount)+" / "+A.amount(period.resourceCount)}
                        }}
                        if !data.totals.complete{mod.widgets.HagencyHint{text:A.t("The overview is bounded to 256 resources; totals cover the scanned resources only.","概览最多汇总 256 项资源，总量仅覆盖已扫描的资源。")}}
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No usage records in this view.","此视图暂无用量记录。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.label}
                            mod.widgets.HagencyHint{text:row.model+" · "+row.periodKey}
                            mod.widgets.HagencyCopy{text:A.t("Capacity used / limit","已占用容量 / 上限")+" · "+A.amount(row.drawnTokens)+" / "+A.amount(row.ceilingTokens)}
                            mod.widgets.HagencyHint{text:A.t("Includes reserved capacity; observed token usage is shown below.","包含已预留的容量；实际观测的 token 用量显示在下方。")}
                            if row.ceilingTokens!=nil && row.ceilingTokens>0 && row.drawnTokens!=nil{SolidView{width:240 height:8 draw_bg.color:mod.widgets.RINX_BORDER
                                SolidView{width:(240*min(1.0,max(0.0,row.drawnTokens/row.ceilingTokens))) height:8 draw_bg.color:mod.widgets.RINX_ACCENT}
                            }}
                            mod.widgets.HagencyCopy{text:A.t("Fresh / cache reads","新 token / 缓存读取")+" · "+A.amount(row.knownFreshTokens)+" / "+A.amount(row.cacheReadTokens)}
                            mod.widgets.HagencyCopy{text:A.t("Reserved","已预留")+" · "+A.amount(row.reservedTokens)}
                            mod.widgets.HagencyActions{web_usage_resource := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Resource details","资源详情") on_click:||A.open_resource(row.resourceId)}}
                        }}
                        if data.unavailable.len()>0{mod.widgets.HagencyHint{text:A.t("Activity duration, task counts or historical charts appear only when the runtime records them.","仅当运行环境记录相关数据时，才显示活动时长、任务次数与历史图表。")}}
                        let managed=A.recipient_optional(data,"managedUsage")
                        if managed!=nil{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.t("Project agent usage","项目 Agent 用量")}
                            mod.widgets.HagencyHint{text:A.t("Recorded agent calls are shown separately from resource measurements and are not added to the totals above. Unrecorded usage may still be pending.","Agent 已记录调用与资源测量分开显示，不叠加到上方总量。尚未记录的用量可能仍待核算。")}
                            if !managed.supported{mod.widgets.HagencyHint{text:A.t("Agent call accounting is unavailable for this connection.","此连接暂无 Agent 调用核算记录。")}}
                            if managed.supported{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                                let savedPage=A.recipient_optional(w,"managedPage")
                                let offset=if savedPage==nil || savedPage>=managed.items.len(){0}else{savedPage}
                                if !managed.complete{mod.widgets.HagencyHint{text:A.t("This view contains a bounded set of agent records; it is not a complete fleet total.","此视图包含数量受限的 Agent 记录，并非全部 Agent 的总量。")}}
                                if managed.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No recorded agent calls yet.","暂无已记录的 Agent 调用。")}}
                                for index row in managed.items{if index>=offset && index<offset+16{mod.widgets.HagencySection{
                                    mod.widgets.HagencySectionTitle{text:if A.recipient_optional(row,"name")==nil{row.agentId}else{row.name}}
                                    mod.widgets.HagencyHint{text:row.projectId+" · "+row.periodKey}
                                    mod.widgets.HagencyCopy{text:A.t("Recorded / reserved / allocated tokens","已记录 / 已预留 / 已分配 token")+" · "+A.amount(row.knownConsumedTokens)+" / "+A.amount(row.retainedTokens)+" / "+A.amount(row.allocatedTokens)}
                                    mod.widgets.HagencyCopy{text:A.t("Recorded calls","已记录调用次数")+" · "+A.amount(row.callCount)}
                                    if !row.usageComplete{mod.widgets.HagencyHint{text:A.t("Accounting is incomplete; the recorded amount is a lower bound.","核算尚未完成，已记录用量仅为当前下限。")}}
                                    web_managed_resource := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Resource details","资源详情") on_click:||A.open_resource(row.resourceId)}
                                }}}
                                mod.widgets.HagencyActions{
                                    if offset>0{View{width:Fit height:Fit web_managed_previous := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Previous agents","上一页 Agent") on_click:||{if !H.busy && w.data==data{w.managedPage=max(0,offset-16) A.redraw()}}}}}
                                    if offset+16<managed.items.len(){View{width:Fit height:Fit web_managed_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More agents","更多 Agent") on_click:||{if !H.busy && w.data==data{w.managedPage=offset+16 A.redraw()}}}}}
                                }
                            }}
                        }}
                    }}
                    if w.kind=="accounts"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No provider accounts yet.","暂无模型服务账号。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.account.runtime+" · "+row.account.id}
                            mod.widgets.HagencyCopy{text:A.t("Remaining / account quota","剩余 / 账号总额度")+" · "+if row.capacity==nil{A.t("Unknown","未知")}else{A.amount(row.capacity.remainingTokens)+" / "+A.amount(row.capacity.quotaTokens)}}
                            mod.widgets.HagencyCopy{text:A.t("Committed","已承诺")+" · "+if row.capacity==nil{A.t("Unknown","未知")}else{A.amount(row.capacity.committedTokens)}}
                            mod.widgets.HagencyHint{text:A.t("Account resources","账号资源")+" · "+A.amount(row.account.resourceCount)}
                            for index period amount in row.declaredByPeriod{mod.widgets.HagencyCopy{text:A.t("Declared resource limits","声明的资源上限")+" · "+period.to_string()+" · "+A.amount(amount)}}
                            mod.widgets.HagencyCopy{text:A.t("Oversubscribed tokens","超额声明 token")+" · "+A.amount(row.oversubscribedTokens)}
                            if !row.aggregateComplete{mod.widgets.HagencyHint{text:A.t("Declared totals cover this resource page; view the remaining resources for the complete account.","声明总量仅覆盖本页资源，请查看其余资源了解完整账号。")}}
                            for resource in row.resources{mod.widgets.HagencyCopy{text:resource.label+" · "+A.amount(resource.drawnTokens)+" / "+A.amount(resource.ceilingTokens)}}
                            mod.widgets.HagencyActions{
                                web_account_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Account details","账号详情") on_click:||A.open_account(row.account.id,nil)}
                                if row.nextResourceAfter!=nil{View{width:Fit height:Fit web_account_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More resources","更多资源") on_click:||A.open_web_account(row.account.id,row.nextResourceAfter)}}}
                            }
                            mod.widgets.HagencyDivider{}
                        }}
                    }}
                    if w.kind=="alerts"{
View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)                        mod.widgets.HagencyCopy{text:A.t("All alerts / matching","全部告警 / 筛选结果")+" · "+A.amount(data.counts.total)+" / "+A.amount(data.filteredCount)}
                        for index status count in data.counts.byStatus{mod.widgets.HagencyHint{text:A.alert_state(status.to_string())+" · "+A.amount(count)}}
                        if data.alerts.len()==0{mod.widgets.HagencyCopy{text:A.t("No matching alerts.","没有符合筛选条件的告警。")}}
                        for row in data.alerts{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.summary}
                            mod.widgets.HagencyCopy{text:A.alert_state(row.status)+" · "+A.alert_severity(row.severity)}
                            mod.widgets.HagencyHint{text:row.resourceId}
                            web_alert_open := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Review alert","查看告警") on_click:||A.open_alert(row.resourceId,row.id,0)}
                        }}
                    }}
                    if w.kind=="terminal"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        if data.supported{mod.widgets.HagencyCopy{text:data.text}}else{mod.widgets.HagencyCopy{text:A.t("This agent has no attached terminal pane. Its work records remain available from the agent page.","此 Agent 没有关联的终端窗格，可在 Agent 页面查看任务记录。")}}
                    }}else{mod.widgets.HagencyActions{
                        if w.after!=nil{View{width:Fit height:Fit web_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.open_web(w.kind,nil)}}}
                        if data.nextAfter!=nil{View{width:Fit height:Fit web_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.open_web(w.kind,data.nextAfter)}}}
                    }}
                }}
            }
        }
        if H.page=="web_catalog"{mod.widgets.HagencyDetailCard{
            let w=H.web let c=w.catalog
            mod.widgets.HagencyTitle{text:A.t("Resource offers and defaults","资源报价与默认设置")}
            mod.widgets.HagencyActions{
                web_catalog_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Resource details","资源详情") draw_icon.svg:mod.rinx_icons.back icon_walk:Walk{width:16 height:16} on_click:||A.open_resource(w.resourceId)}
                for section in ["settings","offers","trust"]{View{width:Fit height:Fit web_catalog_section := mod.widgets.HagencyChoice{enabled:!H.busy text:if section=="settings"{A.t("Configuration","配置")}else if section=="offers"{A.t("Standing offers","长期报价")}else{A.t("Trusted projects","信任项目")} draw_bg.color:if section==w.section{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||A.open_web_catalog(w.resourceId,section,nil)}}}
            }
            if c!=nil{
                if w.section=="settings"{
                    mod.widgets.HagencySectionTitle{text:c.resourceName}
                    mod.widgets.HagencyFormGroup{
                        mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Declared daily token rate","声明的每日 token 速率")}
                        web_daily_rate := mod.widgets.HagencyInput{empty_text:A.t("No declared daily rate","未声明每日速率") text:w.rate on_change:|s|{if A.web_can_edit(){w.rate=s}}}
                        mod.widgets.HagencyHint{text:A.t("Leave blank to clear. This is a declared offer term; the runtime does not enforce a daily quota.","留空可清除。这是声明的服务条款，运行环境不强制执行每日配额。")}
                        web_daily_review := mod.widgets.HagencyButton{width:Fit enabled:A.web_can_edit() text:A.t("Review daily rate","核对每日速率") on_click:||A.web_rate()}
                    }
                    mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Default permissions for future agents","未来 Agent 的默认权限")}
                        mod.widgets.HagencyCopy{text:A.policy_label(c.defaultYolo)}
                        mod.widgets.HagencyHint{text:A.t("Existing agents retain their own permissions. Only agents created later inherit this default.","现有 Agent 保留自身权限，仅之后创建的 Agent 继承此默认值。")}
                        mod.widgets.HagencyActions{
                            web_default_standard := mod.widgets.HagencyButton{enabled:A.web_can_edit() text:A.t("Use standard permissions","使用标准权限") on_click:||A.web_prepare({operation:"default_policy" yolo:false})}
                            web_default_unrestricted := mod.widgets.HagencyButton{enabled:A.web_can_edit() text:A.t("Review unrestricted default","核对不受限默认值") on_click:||A.web_prepare({operation:"default_policy" yolo:true})}
                        }
                    }
                    mod.widgets.HagencySection{
                        mod.widgets.HagencySectionTitle{text:A.t("Assign to an unconfigured agent","分配给未配置的 Agent")}
                        if c.agents.len()==0{mod.widgets.HagencyHint{text:A.t("No unconfigured agents on this page.","本页没有未配置的 Agent。")}}
                        for row in c.agents{mod.widgets.HagencyActions{
                            mod.widgets.HagencyCopy{text:row.name}
                            web_assign_preset := mod.widgets.HagencyButton{enabled:A.web_can_edit() text:A.t("Review assignment","核对分配") on_click:||A.web_prepare({operation:"assign_preset" engagementId:row.id})}
                        }}
                        if c.nextAfter!=nil{View{width:Fit height:Fit web_unconfigured_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More agents","更多 Agent") on_click:||A.open_web_catalog(w.resourceId,"settings",c.nextAfter)}}}
                    }
                    mod.widgets.HagencyDivider{}
                    if c.canRetire{View{width:Fit height:Fit web_resource_remove := mod.widgets.HagencyButton{enabled:A.web_can_edit() text:A.t("Review configuration removal","核对移除配置") draw_icon.svg:mod.rinx_icons.close icon_walk:Walk{width:16 height:16} on_click:||A.web_prepare({operation:"retire"})}}}else{mod.widgets.HagencyHint{text:A.t("Configuration removal is unavailable while this resource is in use.","资源使用期间无法移除配置。")}}
                }
                if w.section=="offers"{
                    mod.widgets.HagencyHint{text:A.t("Offer capacity by role. A published offer still requires resource admission and project approval.","按角色提供容量。发布报价后仍需完成资源准入与项目审批。")}
                    mod.widgets.HagencyHint{text:A.t("Changes apply to new reservations. Reoffer the resource to refresh the server catalogue. Existing agents keep their saved allocations.","更改对新预留生效。重新提交资源报价可更新服务器目录，现有 Agent 保留已保存的分配。")}
                    if w.draft==nil{View{width:Fill height:Fit flow:Down spacing:12
                        for row in c.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.capability_label(row.role)}
                            mod.widgets.HagencyCopy{text:if row.published || row.catalogPublished{A.t("Published","已发布")}else{A.t("Not published","未发布")}}
                            mod.widgets.HagencyCopy{text:A.t("Count / tokens per engagement / daily rate","数量 / 每项协作 token 上限 / 每日速率")+" · "+A.amount(row.count)+" / "+A.amount(row.budgetCapPerEngagement)+" / "+A.amount(row.rateCap)}
                            web_offer_edit := mod.widgets.HagencyButton{width:Fit enabled:A.web_can_edit() text:A.t("Edit offer","编辑报价") on_click:||A.web_offer_edit(row)}
                        }}
                    }}else{mod.widgets.HagencyFormGroup{
                        let d=w.draft
                        mod.widgets.HagencySectionTitle{text:A.capability_label(d.role)}
                        mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Available count","可提供数量")}
                        web_offer_count := mod.widgets.HagencyInput{empty_text:A.t("No declared count","未声明数量") text:d.count on_change:|s|{d.count=s}}
                        mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Token limit per engagement","每项协作 token 上限")}
                        web_offer_budget := mod.widgets.HagencyNumberInput{minimum:0 empty_text:A.t("No declared limit","未声明上限") text:d.budget on_change:|s|{d.budget=s}}
                        mod.widgets.HagencyHint{text:A.t("− / + adjusts by 100,000 tokens; type any exact amount.","− / + 每次调整 10 万 token，也可输入精确数量。")}
                        mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Daily token rate","每日 token 速率")}
                        web_offer_rate := mod.widgets.HagencyInput{empty_text:A.t("No declared daily rate","未声明每日速率") text:d.rate on_change:|s|{d.rate=s}}
                        mod.widgets.HagencyActions{
                            web_offer_publish := mod.widgets.HagencyToggle{draw_bg.selected:if d.published{1.0}else{0.0} enabled:!H.busy && d.qualified text:if d.published{A.t("Published — switch to withdrawn","已发布 · 点击撤回")}else{A.t("Withdrawn — switch to published","已撤回 · 点击发布")} on_click:||{d.published=!d.published A.redraw()}}
                            web_offer_review := mod.widgets.RinxKeyPrimaryButton{enabled:A.web_can_edit() text:A.t("Review offer","核对报价") on_click:||A.web_offer_save()}
                            web_offer_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel","取消") on_click:||{w.draft=nil A.redraw()}}
                        }
                    }}
                }
                if w.section=="trust"{View{width:Fill height:Fit flow:Down spacing:8
                    mod.widgets.HagencyHint{text:A.t("Remember projects trusted by this resource owner. Server admission, project administration and allocation checks still apply.","记录资源主人信任的项目，服务器准入、项目审批与分配检查仍然有效。")}
                    for row in c.items{mod.widgets.HagencySection{
                        mod.widgets.HagencyCopy{text:if row.displayName==nil{row.projectRoomId}else{row.displayName}}
                        mod.widgets.HagencyHint{text:row.projectRoomId}
                        web_trust_remove := mod.widgets.HagencyButton{width:Fit enabled:A.web_can_edit() text:A.t("Remove trust","移除信任") on_click:||A.web_prepare({operation:"trust_remove" projectRoomId:row.projectRoomId})}
                    }}
                    if c.nextAfter!=nil{View{width:Fit height:Fit web_trust_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More projects","更多项目") on_click:||A.open_web_catalog(w.resourceId,"trust",c.nextAfter)}}}
                    mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Project Matrix room ID","项目 Matrix 房间标识")}
                    web_trust_room := mod.widgets.HagencyInput{empty_text:A.t("!project:matrix.example.org","!project:matrix.example.org") text:w.trustRoom on_change:|s|{w.trustRoom=s}}
                    mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Display name (optional)","显示名称（可选）")}
                    web_trust_name := mod.widgets.HagencyInput{empty_text:A.t("Optional project name","项目名称（可选）") text:w.trustName on_change:|s|{w.trustName=s}}
                    web_trust_add := mod.widgets.RinxKeyPrimaryButton{width:Fit enabled:A.web_can_edit() text:A.t("Review trusted project","核对信任项目") on_click:||A.web_trust_add()}
                }}
            }
        }}
        if H.page=="web_catalog_command"{mod.widgets.HagencyDetailCard{
            let w=H.web let p=w.pending
            mod.widgets.HagencyTitle{text:A.t("Review resource change","核对资源更改")}
            if p!=nil{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                mod.widgets.HagencyCopy{text:A.web_change_label(p.change)}
                if p.change.operation=="offer"{mod.widgets.HagencyCopy{text:A.t("Count / engagement limit / daily rate","数量 / 协作上限 / 每日速率")+" · "+A.amount(p.change.count)+" / "+A.amount(p.change.budgetCapPerEngagement)+" / "+A.amount(p.change.rateCap)}}
                if p.change.operation=="default_policy" && p.change.yolo{mod.widgets.HagencyHint{text:A.t("New Codex agents will run without workspace sandboxing or tool-approval prompts.","新建 Codex Agent 将不使用工作区沙箱，也不提示工具审批。")}}
                if p.change.operation=="retire"{mod.widgets.HagencyHint{text:A.t("The configuration will leave the active list. Historical allocations and usage records are retained.","配置将从活动列表移除，历史分配与用量记录会保留。")}}
                if w.phase=="recorded"{mod.widgets.HagencyCopy{text:A.t("Change saved","更改已保存")}}
                mod.widgets.HagencyActions{
                    web_command_check := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Check saved result","检查保存结果") on_click:||A.open_saved_web({commandId:p.commandId})}
                    if w.phase=="saved"{View{width:Fit height:Fit web_command_apply := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Confirm change","确认更改") on_click:||A.web_apply()}}}
                    if w.phase=="saved"{View{width:Fit height:Fit web_command_cancel := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel change","取消更改") on_click:||A.web_cancel()}}}
                    if w.phase=="recorded" || w.phase=="failed"{View{width:Fit height:Fit web_command_finish := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Done","完成") on_click:||A.web_finish()}}}
                }
            }}else{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                mod.widgets.HagencyHint{text:A.t("Checking the saved request. Refresh to recover its original result.","正在检查保存的请求，刷新可恢复其原始结果。")}
                web_command_recover := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Find saved request","查找保存请求") on_click:||{if w.commandId!=""{A.open_saved_web({commandId:w.commandId})}else{A.refresh()}}}
            }}
        }}

        if H.page=="templates"{mod.widgets.HagencyDetailCard{
            let t=H.templates
            mod.widgets.HagencyActions{
                templates_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Back to resource","返回资源") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.open_resource(t.resourceId)}
                templates_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_templates(t.resourceId,t.after)}
                if t.list!=nil{View{width:Fit height:Fit template_new := mod.widgets.RinxKeyPrimaryButton{enabled:A.template_can_edit() && t.list.canCreate text:A.t("New template","新建模板") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.add on_click:||A.template_begin(true)}}}
            }
            mod.widgets.HagencyTitle{text:A.t("Agent templates","Agent 模板")}
            mod.widgets.HagencyHint{text:A.template_notice()}
            if t.list==nil{mod.widgets.HagencyCopy{text:if H.busy{A.t("Reading templates…","正在读取模板…")}else{A.t("Templates unavailable. Refresh to try again.","模板暂不可用，请刷新重试。")}}}
            if t.list!=nil{mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:t.list.resourceName}
                if !t.list.canCreate{mod.widgets.HagencyHint{text:A.t("New templates are unavailable for this resource. Check your access, its roles, capacity and template count (maximum 200).","此资源暂不能新增模板，请检查你的权限、支持的角色、容量和模板数量（最多 200 个）。")}}
                if t.list.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No templates on this page.","本页暂无模板。")}}
                for row in t.list.items{mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:row.name}
                    mod.widgets.HagencyCopy{text:A.capability_label(row.role)+" · "+A.template_status(row.status)}
                    mod.widgets.HagencyHint{text:A.template_enabled(row.enabled)}
                    mod.widgets.HagencyActions{template_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("View template","查看模板") on_click:||A.open_template(t.resourceId,row.id)}}
                }}
                mod.widgets.HagencyActions{
                    if t.after!=nil{View{width:Fit height:Fit templates_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.open_templates(t.resourceId,nil)}}}
                    if t.list.nextAfter!=nil{View{width:Fit height:Fit templates_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.open_templates(t.resourceId,t.list.nextAfter)}}}
                }
            }}
            if t.error!=""{mod.widgets.HagencyCopy{text:t.error}}
        }}
        if H.page=="template"{mod.widgets.HagencyDetailCard{
            let t=H.templates
            mod.widgets.HagencyActions{
                template_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Agent templates","Agent 模板") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||A.open_templates(t.resourceId,t.after)}
                template_refresh := mod.widgets.HagencyButton{enabled:!H.busy && !A.must_reopen() text:if H.busy{A.t("Updating…","正在更新…")}else{A.t("Refresh","刷新")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.open_template(t.resourceId,t.id)}
            }
            if t.detail==nil{mod.widgets.HagencyCopy{text:if H.busy{A.t("Reading template…","正在读取模板…")}else{A.t("Template unavailable. Refresh to try again.","模板暂不可用，请刷新重试。")}}}
            if t.detail!=nil{mod.widgets.HagencySection{
                let d=t.detail let row=d.definition
                mod.widgets.HagencyTitle{text:row.name}
                mod.widgets.HagencyCopy{text:A.capability_label(row.role)+" · "+A.template_status(row.status)}
                mod.widgets.HagencyCopy{text:A.template_enabled(row.enabled)}
                mod.widgets.HagencyHint{text:A.t("Active allocations","有效分配")+" · "+row.activeEngagements}
                mod.widgets.HagencyHint{text:A.template_notice()}
                if row.status=="reserved" || row.status=="provisioned"{mod.widgets.HagencyHint{text:A.t("Reserved or provisioned templates keep their name and role. Disabling future allocation leaves existing agents unchanged.","已预留或已创建实例的模板须保留名称与角色。禁用未来分配不会更改现有 Agent。")}}
                mod.widgets.HagencyActions{
                    template_edit := mod.widgets.RinxKeyPrimaryButton{enabled:A.template_can_edit() && (d.canEditIdentity || d.canToggle) text:A.t("Edit template","编辑模板") on_click:||A.template_begin(false)}
                    if d.canDelete{View{width:Fit height:Fit template_delete := mod.widgets.HagencyButton{enabled:A.template_can_edit() text:A.t("Review removal","核对移除") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.close on_click:||A.template_delete()}}}
                }
            }}
            if t.error!=""{mod.widgets.HagencyCopy{text:t.error}}
        }}
        if H.page=="template_edit" && H.templates.draft!=nil{mod.widgets.HagencyDetailCard{
            let t=H.templates let d=t.draft
            mod.widgets.HagencyActions{
                template_edit_back := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Cancel edit","取消编辑") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click:||{t.phase="" t.draft=nil if d.operation=="create"{A.open_templates(d.resourceId,t.after)}else{A.open_template(d.resourceId,d.id)}}}
                template_prepare := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("Review change","核对更改") on_click:||A.template_save_draft()}
            }
            mod.widgets.HagencyTitle{text:if d.operation=="create"{A.t("New agent template","新建 Agent 模板")}else{A.t("Edit agent template","编辑 Agent 模板")}}
            mod.widgets.HagencyHint{text:A.template_notice()}
            mod.widgets.HagencyFieldLabel{text:A.t("Agent name","Agent 名称")}
            template_name := mod.widgets.HagencyInput{is_read_only:!d.canEditIdentity text:d.name empty_text:A.t("For example: project-writer","例如：project-writer") on_change:|text|{if !H.busy && d.canEditIdentity{d.name=text}}}
            mod.widgets.HagencyHint{text:A.t("Start with a lowercase letter; use lowercase letters, numbers, _ or - (maximum 64).","以小写字母开头，只含小写字母、数字、_ 或 -（最多 64 个字符）。")}
            mod.widgets.HagencyFieldLabel{text:A.t("Role","角色")}
            mod.widgets.HagencyCopy{text:if d.role==""{A.t("Choose a supported role","请选择支持的角色")}else{A.capability_label(d.role)}}
            if d.canEditIdentity{mod.widgets.HagencyActions{for role in d.roles{View{width:Fit height:Fit template_role := mod.widgets.HagencyButton{enabled:!H.busy text:A.capability_label(role) icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.check on_click:||A.template_role(role)}}}}}
            if !d.canEditIdentity{mod.widgets.HagencyHint{text:A.t("This template is in use; its name and role are locked.","此模板正在使用，名称与角色已锁定。")}}
            mod.widgets.HagencyCopy{text:A.template_enabled(d.enabled)}
            mod.widgets.HagencyActions{template_enabled := mod.widgets.HagencyToggle{draw_bg.selected:if d.enabled{1.0}else{0.0} enabled:!H.busy && d.canToggle text:if d.enabled{A.t("Future allocation: on","未来分配：已启用")}else{A.t("Future allocation: off","未来分配：已关闭")} on_click:||{if !H.busy && d.canToggle{d.enabled=!d.enabled A.redraw()}}}}
            if t.error!=""{mod.widgets.HagencyCopy{text:t.error}}
        }}
        if H.page=="template_command"{mod.widgets.HagencyDetailCard{
            let t=H.templates
            mod.widgets.HagencyTitle{text:if t.phase=="recorded"{A.t("Template change saved","模板更改已保存")}else if t.phase=="failed"{A.t("Template change refused","模板更改被拒绝")}else if t.phase=="unknown"{A.t("Check the original request","检查原请求")}else{A.t("Review template change","核对模板更改")}}
            mod.widgets.HagencyHint{text:A.template_notice()}
            if t.pending!=nil{mod.widgets.HagencySection{
                let p=t.pending let change=p.change
                mod.widgets.HagencyHint{text:A.t("Resource · ","资源 · ")+if t.list!=nil && t.list.resourceId==p.resourceId{t.list.resourceName}else{p.resourceId}}
                mod.widgets.HagencySectionTitle{text:change.name}
                mod.widgets.HagencyCopy{text:A.capability_label(change.role)}
                mod.widgets.HagencyCopy{text:if change.operation=="delete"{A.t("Remove this unused template?","移除此未使用的模板？")}else{A.template_enabled(change.enabled)}}
                if t.phase=="unknown"{mod.widgets.HagencyHint{text:A.t("The change may already be saved. Check this original request; do not submit a replacement.","更改可能已经保存，请检查此原请求，不要重复提交。")}}
                mod.widgets.HagencyActions{
                    template_command_check := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Check saved request","检查保存请求") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click:||A.template_check()}
                    if t.phase=="saved"{View{width:Fit height:Fit template_command_apply := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:if change.operation=="delete"{A.t("Remove template","移除模板")}else{A.t("Apply saved change","应用保存的更改")} on_click:||A.template_apply()}}}
                    if t.phase=="recorded" || t.phase=="failed"{View{width:Fit height:Fit template_command_close := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy text:A.t("View current templates","查看当前模板") on_click:||A.template_finish()}}}
                }
            }}else{mod.widgets.HagencySection{
                mod.widgets.HagencyCopy{text:A.t("If a response was lost, find the original under Saved requests.","如果响应丢失，请在“已保存的请求”中查找原请求。")}
                mod.widgets.HagencyActions{template_command_find := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Find saved request","查找保存请求") on_click:||A.template_check()}}
            }}
            if t.error!=""{mod.widgets.HagencyCopy{text:t.error}}
        }}
        if H.page == "resource_detail" {mod.widgets.HagencyDetailCard{
            mod.widgets.HagencyActions{
                resource_back := mod.widgets.HagencyButton{text:A.t("Back to resources", "返回资源") enabled:!H.busy icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.back on_click: || A.return_list("resources")}
                resource_refresh := mod.widgets.HagencyButton{text:A.t("Refresh details", "刷新详情") enabled:!H.busy icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.refresh on_click: || A.refresh()}
            }
            if H.resource_detail == nil {mod.widgets.HagencySection{
                mod.widgets.HagencySectionTitle{text:A.t("Resource details", "资源详情")}
                mod.widgets.HagencyCopy{text:if H.busy {A.t("Reading this device’s resource…", "正在读取此设备上的资源…")} else {A.t("No current resource snapshot", "暂无当前资源快照")}}
            }}
            if H.resource_detail != nil {View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                let detail=H.resource_detail
                let row=detail.resource
                mod.widgets.HagencyTitle{text:A.resource_title(row)}
                mod.widgets.HagencyHint{text:if A.local_name(row) != nil && A.local_name(row).name != "" {row.model + " · " + row.framework + A.t(" · Local name", " · 本地名称")} else {row.framework + " · " + A.t("Resource on this device", "此设备上的资源")}}
                mod.widgets.HagencyStatus{flow:Down spacing:12
                    mod.widgets.HagencySectionTitle{text:A.t("Available capacity", "可用容量")}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Available / limit", "可用 / 上限")}
                        mod.widgets.HagencyCopy{text:A.amount(row.budget.remainingTokens) + " / " + A.amount(row.budget.pool.ceiling) + A.t(" tokens", " token")}
                    }
                    if row.budget.remainingTokens!=nil && row.budget.pool.ceiling!=nil && row.budget.pool.ceiling>0 {View{width:Fill height:6 flow:Right
                        if row.budget.remainingTokens<=0 {SolidView{width:Fill height:6 draw_bg.color:mod.widgets.RINX_BORDER}} else if row.budget.remainingTokens>=row.budget.pool.ceiling {SolidView{width:Fill height:6 draw_bg.color:mod.widgets.RINX_ACCENT}} else {
                            SolidView{width:Fill{weight:row.budget.remainingTokens/row.budget.pool.ceiling} height:6 draw_bg.color:mod.widgets.RINX_ACCENT}
                            SolidView{width:Fill{weight:1-row.budget.remainingTokens/row.budget.pool.ceiling} height:6 draw_bg.color:mod.widgets.RINX_BORDER}
                        }
                    }}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Budget period", "预算周期")}
                        mod.widgets.HagencyCopy{text:A.resource_period(row.budget.pool.period)}
                    }
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Committed", "已承诺额度")}
                        mod.widgets.HagencyCopy{text:A.amount(row.budget.pool.committed) + A.t(" tokens", " token")}
                    }
                    mod.widgets.HagencyHint{text:A.t("Availability also depends on the shared account limit. This is the native ledger, not a provider quota check.", "可用额度还受共享账号上限约束。这里显示原生账本，不是模型服务商的实时额度。")}
                }
                mod.widgets.HagencyActions{
                    resource_connections := mod.widgets.RinxKeyPrimaryButton{enabled:!H.busy && H.command==nil text:A.t("Continue server connection","继续连接服务器") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.connection on_click:||A.resource_connection(row)}
                    resource_details_toggle := mod.widgets.HagencyButton{enabled:!H.busy text:if H.ux.resourceTools{A.t("Hide configuration & tools","收起配置与工具")}else{A.t("Configuration & tools","配置与工具")} icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.activity on_click:||{H.ux.resourceTools=!H.ux.resourceTools A.redraw()}}
                }
                mod.widgets.HagencyHint{text:A.t("Capacity is from the device ledger. Server admission and a fresh connection check determine shared-resource readiness.","容量来自设备账本。共享资源是否就绪，须另行确认服务器准入与最新连接验证。")}
                if H.ux.resourceTools {mod.widgets.HagencySection{
                mod.widgets.HagencyActions{
                    resource_alerts_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Resource alerts","资源告警") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_alerts(row.id,"",nil)}
                    resource_bindings_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Approval rooms","审批房间") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_bindings(row.id,"")}
                    resource_tool_approvals := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Tool approvals","工具审批") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_tools(H.resource_id,"","","requests")}
                    resource_policies := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Agent execution permissions","Agent 执行权限") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_policies(row.id,"")}
                }
                mod.widgets.HagencyActions{
                    resource_stopped := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Interrupted tasks","中断的任务") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.inbox on_click: || A.open_stopped_tasks(row.id,"","")}
                    resource_templates := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Agent templates","Agent 模板") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.person on_click:||A.open_templates(row.id,nil)}
                    resource_workspaces := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Workspace recovery","工作区恢复") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.open_workspaces(row.id,"")}
                }
                mod.widgets.HagencyDetailRow{
                    mod.widgets.HagencyFieldLabel{text:A.t("Resource ID", "资源标识")}
                    mod.widgets.HagencyCopy{text:row.id}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Local display name", "本地显示名称")}
                    let local_name=A.local_name(row)
                    mod.widgets.HagencyCopy{text:if local_name != nil && local_name.name != "" {local_name.name} else {A.t("Using model name", "使用模型名称")}}
                    mod.widgets.HagencyHint{text:A.t("Only this device’s resource list and details use this name. Server connection and project labels stay unchanged.", "此名称仅用于本设备的资源列表与详情，服务器连接及项目中的名称保持不变。")}
                    if local_name == nil {mod.widgets.HagencyHint{text:A.t("Local naming is unavailable for this resource backing. Model, limits and capabilities cannot be edited here.", "此资源的存储暂不支持本地命名，此处也不能编辑模型、上限或能力。")}}
                    if local_name != nil && H.resource_name_mode == "" {mod.widgets.HagencyActions{
                        resource_name_edit := mod.widgets.HagencyButton{text:A.t("Edit local name", "编辑本地名称") enabled:!H.busy && H.command == nil on_click: || A.edit_resource_name()}
                    }}
                    if H.resource_name_draft != nil && H.resource_name_mode != "" {View{width:Fill height:Fit flow:Down spacing:12
                        let draft=H.resource_name_draft
                        if H.resource_name_mode == "edit" {View{width:Fill height:Fit flow:Down spacing:8
                            mod.widgets.HagencyFieldLabel{text:A.t("Name · up to 80 characters", "名称 · 最多 80 个字符")}
                            resource_name_input := mod.widgets.HagencyInput{text:draft.name empty_text:A.t("Leave empty to show the model name", "留空则显示模型名称") on_change:|text| {draft.name=text}}
                        }}
                        if H.resource_name_mode == "review" {mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.t("Review local name", "核对本地名称")}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("Current", "当前名称")} mod.widgets.HagencyCopy{text:if draft.originalName == "" {row.model} else {draft.originalName}}}
                            mod.widgets.HagencyDetailRow{mod.widgets.HagencyFieldLabel{text:A.t("New", "修改后")} mod.widgets.HagencyCopy{text:if draft.name == "" {row.model} else {draft.name}}}
                        }}
                        mod.widgets.HagencyActions{
                            resource_name_cancel := mod.widgets.HagencyButton{text:A.t("Cancel", "取消") enabled:!H.busy on_click: || {H.resource_name_mode="" H.resource_name_draft=nil A.redraw()}}
                            if H.resource_name_mode == "edit" {View{width:Fit height:Fit resource_name_review := mod.widgets.RinxKeyPrimaryButton{text:A.t("Save name", "保存名称") enabled:!H.busy && H.command == nil on_click: || {A.review_resource_name() if H.resource_name_mode=="review"{A.submit_resource_name()}}}}}
                            if H.resource_name_mode == "review" {View{width:Fit height:Fit resource_name_save := mod.widgets.RinxKeyPrimaryButton{text:A.t("Save local name", "保存本地名称") enabled:!H.busy && H.command == nil on_click: || A.submit_resource_name()}}}
                        }
                    }}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Model and capabilities", "模型与能力")}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Reasoning", "推理强度")}
                        mod.widgets.HagencyCopy{text:if row.reasoning == nil {A.t("Not specified", "未指定")} else {A.reasoning_label(row.reasoning)}}
                    }
                    View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:8
                        for capability in row.capabilities {mod.widgets.RinxHint{padding:0 text:A.capability_label(capability)}}
                    }
                    mod.widgets.HagencyHint{text:A.t("Capabilities describe model qualification, not verified execution readiness.", "能力表示模型资质，不代表已验证执行就绪。")}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Default permissions for new agents","新 Agent 的默认权限")}
                    mod.widgets.HagencyCopy{text:A.policy_label(A.resource_default_yolo(detail))}
                    mod.widgets.HagencyHint{text:A.t("Existing agents keep their current permissions.","现有 Agent 保持当前权限。")}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Observed usage", "已观测使用量")}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Fresh-token draw", "新增 token 消耗")}
                        mod.widgets.HagencyCopy{text:A.amount(row.usage.spent) + A.t(" tokens", " token")}
                    }
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Usage period", "用量周期")}
                        mod.widgets.HagencyCopy{text:if row.usage.spend_period_key == nil {A.t("No measurement yet", "暂无观测记录")} else {row.usage.spend_period_key}}
                    }
                    mod.widgets.HagencyHint{text:A.t("Unknown means no measurement is recorded. Observations can be incomplete and may differ from the provider’s totals.", "未知表示尚无观测记录。观测可能不完整，也可能与服务商的统计不同。")}
                }
                mod.widgets.HagencySection{
                    mod.widgets.HagencySectionTitle{text:A.t("Publication and configuration", "发布与配置")}
                    mod.widgets.HagencyDetailRow{
                        mod.widgets.HagencyFieldLabel{text:A.t("Local offer", "本地发布")}
                        mod.widgets.HagencyCopy{text:if row.published {A.t("Published locally", "已在本地发布")} else {A.t("Not published locally", "尚未在本地发布")}}
                    }
                    mod.widgets.HagencyHint{text:A.t("Local publication and server admission are separate. Open Connections to check server approval and verification.", "本地发布与服务器准入是独立状态。请在连接页面查看服务器审批与验证结果。")}
                    if !detail.editing.allowed {View{width:Fill height:Fit flow:Down spacing:8
                        mod.widgets.HagencyCopy{text:A.t("Configuration editing is not available", "暂不支持编辑配置")}
                        mod.widgets.HagencyHint{text:A.resource_edit_reason(detail.editing.reason)}
                    }}
                    if detail.editing.allowed {View{width:Fill height:Fit flow:Down spacing:8
                        mod.widgets.HagencyHint{text:A.t("This resource has never been offered. Review changes to its model, reasoning and resource limit in Hagency.","此资源从未贡献过，可在 Hagency 中核对模型、推理强度与资源上限的修改。")}
                        resource_config_edit := mod.widgets.HagencyButton{width:Fit enabled:!H.busy && H.command==nil text:A.t("Edit configuration","编辑配置") icon_walk:Walk{width:16 height:16} draw_icon.svg:mod.rinx_icons.resources on_click: || A.edit_resource_configuration()}
                    }}

        if H.page=="template_edit" && H.templates.draft!=nil {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let t=H.templates
            let d=t.draft
            mod.widgets.HagencyListLabel{text:A.t("NAME","名称")}
            if d.canEditIdentity {mod.widgets.HagencyList{View{width:Fill height:Fit padding:Inset{left:12 right:12 top:10 bottom:10}
                template_name := mod.widgets.HagencyInput{width:Fill text:d.name empty_text:A.t("For example: project-writer","例如：project-writer") on_change:|text|{if !H.busy && d.canEditIdentity{d.name=text}}}
            }}}
            if !d.canEditIdentity {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock draw_icon.color:mod.widgets.RINX_MUTED}}
                mod.widgets.HagencyListTitle{text:d.name}
                mod.widgets.HagencyListValue{text:A.t("Locked","已锁定")}
            }}}
            mod.widgets.HagencyListNote{text:if d.canEditIdentity {A.t("Lowercase letters, numbers, _ or -; start with a letter; up to 64.","以小写字母开头，只用小写字母、数字、_ 或 -，最多 64 个字符。")} else {A.t("It’s in use, so its name and role are locked.","模板正在使用，名称和角色已锁定。")}}
            mod.widgets.HagencyListLabel{text:A.t("ROLE","角色")}
            if d.canEditIdentity {mod.widgets.HagencyList{for index role in d.roles {View{width:Fill height:Fit flow:Down
                if index>0 {mod.widgets.HagencyListDivider{margin:Inset{left:14}}}
                mod.widgets.HagencyListRow{
                    template_role := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.template_role(role)}
                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyListTitle{text:A.capability_label(role)}
                        if d.role==role {mod.widgets.HagencyCheck{}}
                    }
                }
            }}}}
            if !d.canEditIdentity {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock draw_icon.color:mod.widgets.RINX_MUTED}}
                mod.widgets.HagencyListTitle{text:if d.role=="" {A.t("No role","未选择角色")} else {A.capability_label(d.role)}}
                mod.widgets.HagencyListValue{text:A.t("Locked","已锁定")}
            }}}
            mod.widgets.HagencyListLabel{text:A.t("NEW AGENTS","新 Agent")}
            mod.widgets.HagencyList{mod.widgets.HagencyFitRow{
                mod.widgets.HagencyRowBody{
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyListTitle{text:A.t("New Agents can use this template","新 Agent 可以使用此模板")}
                        mod.widgets.HagencyListSubtitle{text:if d.enabled {A.t("On: new Agents can be created from it","打开：新建 Agent 时可以用它")} else {A.t("Off: new Agents won’t use it; existing ones are unchanged","关闭：新的 Agent 不会用它，现有的不受影响")}}
                    }
                    mod.widgets.HagencySwitch{draw_bg.selected:if d.enabled {1.0} else {0.0} enabled:!H.busy && d.canToggle}
                }
                template_enabled := mod.widgets.HagencyRowCover{enabled:!H.busy && d.canToggle on_click: || {if !H.busy && d.canToggle {d.enabled=!d.enabled A.redraw()}}}
            }}
            mod.widgets.HagencyListNote{text:A.t("Tap Next to review. Nothing is saved until you confirm.","点「下一步」确认，确认之前不会保存。")}
            if t.error!="" {View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_DANGER_BG
                mod.widgets.HagencyCopy{text:t.error draw_text.color:mod.widgets.RINX_DANGER_FG}
            }}}
        }}}
        if H.page=="template_command" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let t=H.templates
            let done=t.phase=="recorded"
            let failed=t.phase=="failed"
            let withdrawn=failed && t.pending!=nil && A.recipient_optional(t.pending,"error")=="management_change_cancelled"
            let unknown=t.phase=="unknown"
            let review=t.phase=="review"
            View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                mod.widgets.HagencyAvatar{draw_bg.color:if done {mod.widgets.RINX_SUCCESS_BG} else if failed {mod.widgets.RINX_DANGER_BG} else if unknown {mod.widgets.RINX_WARNING_BG} else {mod.widgets.RINX_INFO_BG} mod.widgets.HagencyAvatarGlyph{draw_icon.svg:if done {mod.rinx_icons.check} else if failed {mod.rinx_icons.close} else if unknown {mod.rinx_icons.alert} else {mod.rinx_icons.robot} draw_icon.color:if done {mod.widgets.RINX_SUCCESS_FG} else if failed {mod.widgets.RINX_DANGER_FG} else if unknown {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_INFO_FG}}}
                mod.widgets.HagencyHeroName{text:if done {A.t("Template Saved","模板已保存")} else if withdrawn {A.t("Change Discarded","更改已放弃")} else if failed {A.t("Change Refused","更改被拒绝")} else if unknown {A.t("Check the Saved Change","请检查保存的更改")} else if t.phase=="cancelling" {A.t("Discarding…","正在放弃…")} else if t.phase=="saved" || review {A.t("Confirm This Change","确认这项更改")} else {A.t("Preparing…","正在准备…")}}
                mod.widgets.HagencyHint{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:if review {A.t("Nothing changes until you confirm.","确认之前，不会保存任何内容。")} else if done {A.t("Agents created from now on follow the new setting.","以后新建的 Agent 会按新设置。")} else if failed {A.t("Nothing was changed.","模板没有改变。")} else if unknown {A.t("It may already be saved. Check it; don’t submit it again.","它可能已经保存。请检查，不要重复提交。")} else if t.phase=="saved" {A.t("Nothing changes until you confirm.","确认之前不会有任何改变。")} else if t.phase=="cancelling" {A.t("Withdrawing the change; nothing will be saved.","正在撤回这项更改，不会保存任何内容。")} else {A.t("Saving your change for review.","正在保存你的更改，稍后请确认。")}}
            }
            if t.pending!=nil || (review && t.preview!=nil) {View{width:Fill height:Fit flow:Down spacing:6
                let p=if t.pending!=nil {t.pending} else {A.template_preview()}
                let change=p.change
                let removing=change.operation=="delete"
                let old=A.tpl_old(p)
                mod.widgets.HagencyListLabel{text:A.t("THE CHANGE","更改内容")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:if removing {mod.widgets.RINX_DANGER_BG} else {mod.widgets.RINX_INFO_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:if removing {mod.rinx_icons.trash} else {mod.rinx_icons.robot} draw_icon.color:if removing {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_INFO_FG}}}
                        mod.widgets.HagencyListTitle{text:change.name}
                        mod.widgets.HagencyListValue{text:if removing {A.t("Remove","移除")} else if change.operation=="create" {A.t("New","新建")} else {A.t("Update","修改")}}
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.people}}
                        mod.widgets.HagencyListTitle{text:A.t("Role","角色") draw_text.color:if old!=nil && old.role==change.role {mod.widgets.RINX_MUTED} else {mod.widgets.RINX_INK}}
                        mod.widgets.HagencyListValue{text:if old!=nil && old.role!=change.role {A.capability_label(old.role)+" → "+A.capability_label(change.role)} else {A.capability_label(change.role)}}
                    }
                    if !removing {View{width:Fill height:Fit flow:Down
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:if change.enabled {mod.rinx_icons.check} else {mod.rinx_icons.pause}}}
                            mod.widgets.HagencyListTitle{text:A.t("New Agents can use it","新 Agent 可以使用") draw_text.color:if old!=nil && old.enabled==change.enabled {mod.widgets.RINX_MUTED} else {mod.widgets.RINX_INK}}
                            mod.widgets.HagencyListValue{text:if old!=nil && old.enabled!=change.enabled {A.tpl_enabled_word(old.enabled)+" → "+A.tpl_enabled_word(change.enabled)} else {A.tpl_enabled_word(change.enabled)} draw_text.color:if old!=nil && old.enabled!=change.enabled {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}
                        }
                    }}
                }
                mod.widgets.HagencyListNote{text:A.t("Pool: ","资源池：")+if t.list!=nil && t.list.resourceId==p.resourceId {t.list.resourceName} else {A.sub_pool_name(p.resourceId)}}
                if review {View{width:Fill height:Fit flow:Down spacing:6
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{top:10}
                        template_command_discard := mod.widgets.HagencyWideTinted{text:A.t("Discard Change","放弃更改") enabled:!H.busy on_click: || A.template_discard()}
                        if removing {template_command_apply := mod.widgets.HagencyWideDanger{text:A.t("Remove","移除模板") enabled:!H.busy && H.command==nil on_click: || A.template_confirm()}}
                        if !removing {template_command_apply := mod.widgets.HagencyWideButton{text:A.t("Confirm","确认更改") enabled:!H.busy && H.command==nil on_click: || A.template_confirm()}}
                    }
                    mod.widgets.HagencyListNote{text:A.t("Nothing is saved until you confirm. Discarding leaves no record.","确认之后才会保存；放弃更改不会留下任何记录。")}
                }}
                if t.phase=="saved" || t.phase=="cancelling" {View{width:Fill height:Fit flow:Down spacing:6
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{top:10}
                        template_command_cancel := mod.widgets.HagencyWideTinted{text:A.t("Discard Change","放弃更改") enabled:!H.busy && t.phase=="saved" on_click: || A.template_cancel()}
                        if removing {template_command_apply := mod.widgets.HagencyWideDanger{text:A.t("Remove","移除模板") enabled:!H.busy && t.phase=="saved" on_click: || A.template_apply()}}
                        if !removing {template_command_apply := mod.widgets.HagencyWideButton{text:A.t("Confirm","确认更改") enabled:!H.busy && t.phase=="saved" on_click: || A.template_apply()}}
                    }
                    View{width:Fill height:Fit flow:Right align:Align{x:0.5}
                        template_command_later := mod.widgets.HagencyBarText{text:A.t("Decide Later","稍后再决定") enabled:!H.busy && t.phase=="saved" on_click: || A.open_templates(t.resourceId,t.after)}
                    }
                    mod.widgets.HagencyListNote{text:A.t("This change is waiting for you to confirm; discarding withdraws it. Until it’s settled, templates can’t be edited again.","这项更改在等你确认；放弃会撤回它。处理完之前，模板不能再编辑。")}
                }}
                if done && A.recipient_optional(t,"late")==true {View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_INFO_BG
                    template_command_late := mod.widgets.HagencyCopy{text:A.t("It had already been applied, so it couldn’t be discarded.","放弃之前，这项更改已经生效，所以没有撤回。") draw_text.color:mod.widgets.RINX_INFO_FG}
                }}}
                if done || failed {View{width:Fill height:Fit padding:Inset{top:10}
                    template_command_close := mod.widgets.HagencyWideButton{text:A.t("Done","完成") enabled:!H.busy on_click: || A.template_finish()}
                }}
                if unknown {View{width:Fill height:Fit padding:Inset{top:10} mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    template_command_check := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.template_check()}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Check Saved Change","检查保存的更改")}}
                }}}}
            }}
            if t.pending==nil && !H.busy && !review {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListNote{text:A.t("If the reply was lost, find your change under Saved requests.","如果响应丢失了，可以在「已保存的请求」中找到你的更改。")}
                mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    template_command_find := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.template_check()}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.search}} mod.widgets.HagencyAccentText{text:A.t("Find Saved Change","查找保存的更改")}}
                }}
            }}
            if t.error!="" {View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_DANGER_BG
                mod.widgets.HagencyCopy{text:t.error draw_text.color:mod.widgets.RINX_DANGER_FG}
            }}}
        }}}
        if H.page == "resource_detail" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:6 bottom:if A.pool_footer_state().show {150} else {28}} mod.widgets.HagencyColumn{
            if H.resource_detail == nil && H.busy {View{width:Fill height:Fit flow:Down spacing:6
                View{width:Fill height:Fit flow:Down spacing:12 align:Align{x:0.5} padding:Inset{top:6 bottom:14}
                    mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_FIELD}
                    mod.widgets.HagencySkeleton{width:160 height:24}
                    mod.widgets.HagencySkeleton{width:90 height:18}
                }
                for i in [0,1] {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:" "}
                    mod.widgets.HagencyList{for j in [0,1,2] {View{width:Fill height:Fit flow:Down
                        if j>0 {mod.widgets.HagencyListDivider{}}
                        mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:140 height:14}}
                    }}}
                }}
            }}
            if H.resource_detail == nil && !H.busy {mod.widgets.HagencyList{
                View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.5}
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyListTitle{text:A.t("Couldn’t load this pool","暂时无法读取此资源池")}
                        mod.widgets.HagencyListSubtitle{text:if H.notice!="" {H.notice} else {A.t("Check the connection, then try again.","请检查网络连接后重试。")}}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:14}}
                mod.widgets.HagencyListRow{
                    resource_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click:||A.open_resource(H.resource_id)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if H.resource_detail != nil {View{width:Fill height:Fit flow:Down spacing:6
                let detail=H.resource_detail
                let row=detail.resource
                let v=A.pool_view(detail)
                let b=v.b
                let e=H.pool_edit
                let save=A.pool_save_state()
                let unsaved=A.pool_unsaved()
                let alert=A.alert_kind()!=""
                let locked=alert || H.resource_name_mode!=""
                let local_name=A.local_name(row)
                let banner=A.pool_banner(v)
                View{width:Fill height:Fit flow:Down spacing:4 align:Align{x:0.5} padding:Inset{top:0 bottom:0}
                    mod.widgets.HagencyAvatar{width:56 height:56 draw_bg +: {color:mod.widgets.RINX_INFO_BG border_radius:28.0} mod.widgets.HagencyAvatarGlyph{width:28 height:28 icon_walk:Walk{width:28 height:28} draw_icon.svg:mod.rinx_icons.resources draw_icon.color:mod.widgets.RINX_INFO_FG}}
                    if H.resource_name_mode=="" {for line in A.pool_hero_lines(A.resource_title(row)) {mod.widgets.HagencyHeroWrap{text:line}}}
                    if H.resource_name_mode=="" {View{width:Fit height:Fit flow:Right spacing:10 align:Align{y:0.5}
                    mod.widgets.HagencyHint{width:Fit text:if A.resource_title(row)==row.model {A.pool_frame(row)} else {A.pool_tool_text(row)}}
                    View{width:Fit height:44 flow:Overlay align:Align{x:0.5 y:0.5}
                        mod.widgets.HagencyPill{draw_bg.color:A.local_tone_bg(v.status.tone)
                            mod.widgets.HagencyPillDot{draw_bg.color:A.local_tone_fg(v.status.tone)}
                            mod.widgets.HagencyPillText{text:A.pool_pill_text(v) draw_text.color:A.local_tone_fg(v.status.tone)}
                            mod.widgets.HagencyChevron{draw_bg.color:A.local_tone_fg(v.status.tone)}
                        }
                        resource_connections := mod.widgets.HagencyRowCover{enabled:!H.busy && H.command==nil && !locked draw_bg +: {border_radius:22.0} on_click:||A.resource_connection(row)}
                    }
                    }}
                }
                if H.resource_name_mode!="" && H.resource_name_draft!=nil {View{width:Fill height:Fit flow:Down spacing:6
                    let draft=H.resource_name_draft
                    mod.widgets.HagencyListLabel{text:A.t("NAME","名称")}
                    mod.widgets.HagencyList{View{width:Fill height:Fit padding:Inset{left:12 right:12 top:6 bottom:6}
                        resource_name_input := mod.widgets.HagencyInput{width:Fill text:draft.name empty_text:row.model on_change:|text| {draft.name=text}}
                    }}
                    mod.widgets.HagencyListNote{text:A.t("Only shown on this device. Leave it empty to show the model name.","名称只在本机显示。留空则显示模型名称。")}
                    if H.notice!="" && !H.busy {mod.widgets.HagencyListNote{text:A.notice_text() draw_text.color:mod.widgets.RINX_WARNING_FG}}
                }}
                if H.resource_name_mode=="" {View{width:Fill height:Fit flow:Down spacing:6
                    if H.notice!="" && !H.busy {View{width:Fill height:Fit padding:Inset{bottom:4} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_WARNING_BG
                        mod.widgets.HagencyCopy{text:A.notice_text() draw_text.color:mod.widgets.RINX_WARNING_FG}
                    }}}
                    if banner.kind!="" {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{bottom:4}
                        mod.widgets.HagencyList{
                            View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:12 bottom:12} align:Align{y:0.0}
                                mod.widgets.HagencyRowIcon{draw_bg.color:if banner.kind=="error" {mod.widgets.RINX_DANGER_BG} else {mod.widgets.RINX_WARNING_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:if banner.kind=="error" {mod.rinx_icons.alert} else if banner.kind=="device" {mod.rinx_icons.device} else {mod.rinx_icons.connection} draw_icon.color:if banner.kind=="error" {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_WARNING_FG}}}
                                View{width:Fill height:Fit flow:Down spacing:6
                                    mod.widgets.HagencyListTitle{text:banner.title}
                                    mod.widgets.HagencyListSubtitle{text:banner.text}
                                    if banner.step>0 {View{width:Fill height:Fit flow:Down spacing:5 padding:Inset{top:2}
                                        View{width:Fill height:4 flow:Right spacing:4
                                            for step in [1,2,3] {RoundedView{width:Fill height:4 show_bg:true draw_bg +: {color:if step<banner.step {mod.widgets.RINX_SUCCESS_FG} else if step==banner.step {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_BORDER} border_radius:2.0}}}
                                        }
                                        mod.widgets.HagencyListSubtitle{text:A.t("Step ","第 ")+banner.step+A.t(" of 3 · Connect › Approval › Publish"," 步，共 3 步 · 连接服务器 › 管理员批准 › 发布额度")}
                                    }}
                                }
                            }
                            if banner.action!="" {View{width:Fill height:Fit flow:Down
                                mod.widgets.HagencyListDivider{margin:Inset{left:57}}
                                mod.widgets.HagencyListRow{
                                    resource_banner_action := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil && !locked on_click:||A.pool_banner_action(banner.kind)}
                                    mod.widgets.HagencyListBody{padding:Inset{left:57 right:14} mod.widgets.HagencyAccentText{text:banner.action} mod.widgets.HagencyChevron{}}
                                }
                            }}
                        }
                    }}

                    mod.widgets.HagencyTiles{
                        mod.widgets.HagencyTile{
                            resource_requests_open := mod.widgets.HagencyTileTap{enabled:!H.busy && !locked && v.conn!=nil on_click:||A.open_pool_requests(v.conn)}
                            mod.widgets.HagencyTileBody{mod.widgets.HagencyTileGlyph{draw_icon.svg:mod.rinx_icons.inbox draw_icon.color:if v.conn!=nil {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_DISABLED}} mod.widgets.HagencyTileName{text:A.t("Requests","申请") draw_text.color:if v.conn!=nil {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_DISABLED}}}
                            if v.requests>0 {mod.widgets.HagencyTileBadge{mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:""+v.requests}}}}
                            if v.requests==-2 {mod.widgets.HagencyTileBadge{mod.widgets.HagencyMutedBadge{mod.widgets.HagencyMutedCount{text:"—"}}}}
                        }
                        mod.widgets.HagencyTile{
                            resource_alerts_open := mod.widgets.HagencyTileTap{enabled:!H.busy && !locked on_click:||A.open_health_hub(row.id)}
                            mod.widgets.HagencyTileBody{mod.widgets.HagencyTileGlyph{draw_icon.svg:mod.rinx_icons.activity} mod.widgets.HagencyTileName{text:A.t("Health & Recovery","健康与恢复")}}
                            if v.health>0 {mod.widgets.HagencyTileBadge{mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:""+v.health}}}}
                            if v.health==-2 {mod.widgets.HagencyTileBadge{mod.widgets.HagencyMutedBadge{mod.widgets.HagencyMutedCount{text:"—"}}}}
                        }
                        mod.widgets.HagencyTile{
                            resource_tool_approvals := mod.widgets.HagencyTileTap{enabled:!H.busy && !locked on_click:||A.open_tools(row.id,"","","requests")}
                            mod.widgets.HagencyTileBody{mod.widgets.HagencyTileGlyph{draw_icon.svg:mod.rinx_icons.lock} mod.widgets.HagencyTileName{text:A.t("Tools & Permissions","工具与权限")}}
                            if v.tools>0 {mod.widgets.HagencyTileBadge{mod.widgets.HagencyCountBadge{mod.widgets.HagencyCountText{text:""+v.tools}}}}
                            if v.tools==-2 {mod.widgets.HagencyTileBadge{mod.widgets.HagencyMutedBadge{mod.widgets.HagencyMutedCount{text:"—"}}}}
                        }
                    }
                    if A.pool_counts_unknown(v) {mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                        resource_counts_retry := mod.widgets.HagencyListTap{enabled:!H.busy && !locked on_click:||A.pool_info_retry()}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_MUTED}}
                            mod.widgets.HagencyListTitle{max_lines:1 text_overflow:TextOverflow.Ellipsis text:A.t("Some information couldn’t be read","部分信息暂时无法读取")}
                            mod.widgets.HagencyAccentText{width:Fit text:A.t("Try Again","重试")}
                        }
                    }}}

                    if H.pool_result!=nil && A.pool_result_at(v)=="top" {pool_result_top := View{width:Fill height:Fit padding:Inset{top:4 bottom:2}
                        pool_result_box := mod.widgets.HagencyStatus{draw_bg.color:A.local_tone_bg(H.pool_result.tone)
                            pool_result_text := mod.widgets.HagencyCopy{text:H.pool_result.text draw_text.color:A.local_tone_fg(H.pool_result.tone)}
                            pool_result_done := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || A.pool_result_dismiss()}
                        }
                    }}
                    mod.widgets.HagencyListLabel{text:A.t("CAPACITY","额度")}
                    mod.widgets.HagencyList{
                        View{width:Fill height:Fit flow:Down spacing:10 padding:Inset{left:16 right:10 top:8 bottom:14}
                            let unpublished=v.lapsed && b.ceiling!=nil
                            View{width:Fill height:Fit flow:Right spacing:6 align:Align{y:0.5}
                                if unpublished {pool_month_hero := mod.widgets.HagencyStatValue{text:A.pool_month_title(v.now) draw_text.color:mod.widgets.RINX_WARNING_FG}}
                                if !unpublished {mod.widgets.HagencyStatValue{text:if b.ceiling==nil {A.t("No maximum yet","未设置每月上限")} else {A.tokens(b.remaining)} draw_text.color:if b.low {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_INK}}}
                                if b.ceiling!=nil && !unpublished {mod.widgets.HagencyListValue{text:A.t("left","剩余")}}
                                View{width:Fill height:1}
                                if v.reset!="" && !unpublished {mod.widgets.HagencyListValue{text:v.reset}}
                                pool_capacity_info := mod.widgets.HagencyBarIcon{draw_icon.svg:mod.rinx_icons.info enabled:!H.busy on_click:||A.pool_tip("capacity")}
                            }
                            if unpublished {mod.widgets.HagencyWrapSubtitle{text:A.t("Once you publish, Agents can use ","发布后 Agent 可用 ")+A.tokens(b.remaining)+A.t(" this month. Until then they can’t request it.","。发布前，Agent 不能申请。")}}
                            if b.ceiling!=nil && b.ceiling>0 {View{width:Fill height:8 flow:Overlay margin:Inset{right:6}
                                let used=if b.spent==nil {0} else {max(0,min(1,b.spent/b.ceiling))}
                                let held=max(used,max(0,min(1,b.committed/b.ceiling)))
                                RoundedView{width:Fill height:8 show_bg:true draw_bg +: {color:mod.widgets.RINX_BORDER border_radius:4.0}}
                                if held>0 {View{width:Fill height:8 flow:Right
                                    RoundedView{width:Fill{weight:held} height:8 show_bg:true draw_bg +: {color:mod.widgets.RINX_WARNING_FG border_radius:4.0}}
                                    if held<1 {View{width:Fill{weight:1-held} height:8}}
                                }}
                                if used>0 {View{width:Fill height:8 flow:Right
                                    RoundedView{width:Fill{weight:used} height:8 show_bg:true draw_bg +: {color:if b.low {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_ACCENT} border_radius:4.0}}
                                    if used<1 {View{width:Fill{weight:1-used} height:8}}
                                }}
                            }}
                            if b.ceiling!=nil {View{width:Fill height:Fit flow:Flow.Right{wrap:true} spacing:14
                                View{width:Fit height:Fit flow:Right spacing:6 align:Align{y:0.5}
                                    mod.widgets.HagencyPillDot{draw_bg.color:if b.low {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_ACCENT}}
                                    mod.widgets.HagencyListValue{text:A.t("Used this month ","本月已用 ")+if b.key==nil {A.t("—","—")} else {A.tokens(b.spent)}}
                                }
                                View{width:Fit height:Fit flow:Right spacing:6 align:Align{y:0.5}
                                    mod.widgets.HagencyPillDot{draw_bg.color:mod.widgets.RINX_WARNING_FG}
                                    mod.widgets.HagencyListValue{text:A.t("Given to Agents, not used yet ","已分给 Agent，尚未用 ")+A.tokens(A.pool_held_unused(b))}
                                }
                                View{width:Fit height:Fit flow:Right spacing:6 align:Align{y:0.5}
                                    mod.widgets.HagencyPillDot{draw_bg.color:mod.widgets.RINX_BORDER}
                                    mod.widgets.HagencyListValue{text:if unpublished {A.t("Usable once published ","发布后可用 ")+A.tokens(b.remaining)+A.t(" of ","，共 ")+A.tokens(b.ceiling)} else {A.t("Left ","剩余 ")+A.tokens(b.remaining)+A.t(" of ","，共 ")+A.tokens(b.ceiling)}}
                                }
                            }}
                            if b.low {mod.widgets.HagencyWrapSubtitle{text:if v.maxMode!="locked" {A.t("Almost used up. You can raise the monthly maximum below.","快用完了，可在下方调高每月上限。")} else {A.t("Almost used up. New Agent requests may be refused until it resets.","额度快用完了，重置前新的申请可能被拒绝。")} draw_text.color:mod.widgets.RINX_DANGER_FG}}
                            if H.pool_tip=="capacity" {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{left:12 right:12 top:10 bottom:10} show_bg:true draw_bg +: {color:mod.widgets.RINX_FIELD}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Monthly maximum: the most this pool may use in a month.","每月上限：这个资源池一个月最多能用掉的额度。")}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Per-request limit: the most one Agent gets per request.","每次申请上限：每个 Agent 每次申请最多能拿到的额度。")}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Given to Agents, not used yet: capacity given to Agents that they haven’t used.","已分给 Agent，尚未用：分给了 Agent、它还没用掉的额度。")}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Committed: used plus given to Agents. The monthly maximum can’t go below it.","已承诺：已用 + 已分给 Agent。每月上限不能低于它。")}
                                if b.ceiling!=nil && b.committed>0 && !unpublished {pool_committed := mod.widgets.HagencyWrapSubtitle{text:A.pool_committed_line(b) draw_text +: {text_style:theme.font_bold{font_size:mod.widgets.RINX_META_SIZE}}}}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Amounts are Hagency’s records, not the provider’s balance. 1 M is one million tokens.","额度来自 Hagency 记录，不是服务商余额。1 M 即 100 万 token。")}
                            }}
                        }
                        mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                        pool_max_section := View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:16 right:16 top:10 bottom:12}
                            if v.maxMode!="locked" {View{width:Fill height:Fit flow:Down spacing:8
                                let clearing=e!=nil && e.unlimited && b.ceiling!=nil

                    if page.nextAfter!=nil{View{width:Fit height:Fit flow_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next nodes","后续节点") on_click:||A.open_flow(graph.id,page.nextAfter)}}}

                    View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Room · select to copy","房间 · 可选中复制")} mod.widgets.HagencyCopyText{text:d.roomId}}
                    View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Approver","审批人")} mod.widgets.HagencyCopyText{text:d.ownerMxid}}
                    View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Project","项目编号")} mod.widgets.HagencyCopyText{text:d.projectId}}
                    View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Agent link","Agent 关联")} mod.widgets.HagencyCopyText{text:d.engagementId}}
                }}
            }}
            View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:12}
                mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    binding_remove_ask := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || {H.binding_confirm=true A.redraw()}}
                    View{width:Fill height:Fill align:Align{x:0.5 y:0.5} mod.widgets.HagencyDangerText{text:A.t("Remove This Room…","移除这个审批聊天…")}}
                }}
                mod.widgets.HagencyListNote{text:A.t("Removing it takes back the tool permissions saved in it, and its pending approvals stop working.","移除后，这个审批聊天里保存的工具权限会被撤销，待处理的审批也会失效。")}
            }
        }}}
        if H.page=="approval_binding_result" && H.binding_result!=nil {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let result=H.binding_result
            View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                mod.widgets.HagencyHeroName{text:A.t("Room Removed","已移除审批聊天")}
                mod.widgets.HagencyHint{width:Fit text:result.binding.agent}
            }
            mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.lock}}
                    mod.widgets.HagencyListTitle{text:A.t("Permissions taken back","撤销的工具权限")}
                    mod.widgets.HagencyListValue{text:""+result.revokedGrants}
                }
            }
            mod.widgets.HagencyListNote{text:A.t("Permissions taken back stay taken back, even if the room is used again later.","即使以后再次使用这个审批聊天，已撤销的权限也不会恢复。")}
            View{width:Fill height:Fit padding:Inset{top:10}
                binding_result_refresh := mod.widgets.HagencyWideButton{text:A.t("Done","完成") enabled:!H.busy on_click: || A.open_bindings(H.binding_resource,"")}
            }
        }}}
        if H.page=="health_hub" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let h=H.health
            let pool=A.sub_pool_name(h.resource)
            let c=A.health_counts()
            mod.widgets.HagencyLargeTitle{text:A.t("Health & Recovery","健康与恢复")}
            if pool!="" {mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:pool}}
            mod.widgets.HagencyList{View{width:Fill height:Fit flow:Right spacing:14 padding:Inset{left:16 right:16 top:14 bottom:14} align:Align{y:0.5}
                if c.loading {View{width:38 height:38 align:Align{x:0.5 y:0.5} mod.widgets.HagencySpinner{width:22 height:22}}}
                if !c.loading && c.total>0 {mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}}
                if !c.loading && c.total==0 && c.failed {mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_SELECTED mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_MUTED}}}
                if !c.loading && c.total==0 && !c.failed {mod.widgets.HagencyAvatarSmall{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyAvatarSmallGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}}
                View{width:Fill height:Fit flow:Down spacing:3
                    mod.widgets.HagencyWrapTitle{draw_text.text_style:theme.font_bold{font_size:mod.widgets.RINX_BODY_SIZE} text:if c.loading {A.t("Checking this pool…","正在检查这个资源池…")} else if c.total>0 {A.t(""+c.total+(if c.more {"+"} else {""})+(if c.total==1 && !c.more {" item needs"} else {" items need"})+" your attention","有 "+c.total+(if c.more {"+"} else {""})+" 项需要你处理")} else if c.failed {A.t("Some information couldn’t be read","部分信息暂时无法读取")} else {A.t("Everything looks fine","一切正常")}}
                    mod.widgets.HagencyWrapSubtitle{text:if c.loading {A.t("Alerts, interrupted tasks and workspaces","告警、中断的任务和工作区")} else if c.total>0 {A.t("Alerts "+c.alerts+" · Tasks "+c.stopped+" · Workspaces "+c.workspaces,"告警 "+c.alerts+" · 中断任务 "+c.stopped+" · 工作区 "+c.workspaces)} else if c.failed {A.t("Try again in the section below.","请在下方对应部分重试。")} else {A.t("No open alerts, interrupted tasks or workspaces to clean up.","没有待处理的告警、中断的任务或需要清理的工作区。")}}
                }
            }}

            mod.widgets.HagencyListLabel{text:A.t("ALERTS","告警")}
            mod.widgets.HagencyList{
                View{width:Fill height:Fit padding:Inset{left:12 right:12 top:10 bottom:10}
                    mod.widgets.HagencySegments{
                        if h.alerts.filter=="all" {alerts_all := mod.widgets.HagencyTabOn{text:A.t("All","全部") enabled:!H.busy on_click: || A.health_filter("all")}}
                        if h.alerts.filter!="all" {alerts_all := mod.widgets.HagencyTab{text:A.t("All","全部") enabled:!H.busy on_click: || A.health_filter("all")}}
                        if h.alerts.filter=="open" {alerts_open := mod.widgets.HagencyTabOn{text:A.t("Open","待处理") enabled:!H.busy on_click: || A.health_filter("open")}}
                        if h.alerts.filter!="open" {alerts_open := mod.widgets.HagencyTab{text:A.t("Open","待处理") enabled:!H.busy on_click: || A.health_filter("open")}}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:0}}
                if h.alerts.state=="loading" && h.alerts.items.len()==0 {mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:200 height:14}}}
                if h.alerts.state=="ready" && A.health_alert_rows().len()==0 {mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    mod.widgets.HagencyWrapTitle{text:if h.alerts.filter=="open" {A.t("No open alerts","没有待处理的告警")} else {A.t("No alerts recorded","没有告警记录")}}
                }}
                for index row in A.health_alert_rows() {View{width:Fill height:Fit flow:Down
                    let tone=A.alert_tone(row)
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyRowGlyph{draw_icon.svg:if tone=="running" {mod.rinx_icons.check} else {mod.rinx_icons.alert} draw_icon.color:A.local_tone_fg(tone)}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{max_lines:1 text_overflow:Ellipsis text:A.alert_headline(row)}
                                mod.widgets.HagencyListSubtitle{text:A.alert_status_line(row)}
                                if A.alert_server_text(row)!="" {mod.widgets.HagencyWrapSubtitle{max_lines:2 text_overflow:Ellipsis text:A.t("Server’s words: ","服务器原文（英文）：")+A.alert_server_text(row)}}
                                mod.widgets.HagencyWrapSubtitle{text:A.alert_next(row) draw_text.color:if tone=="running" {mod.widgets.RINX_SUCCESS_FG} else if tone=="" {mod.widgets.RINX_MUTED} else {mod.widgets.RINX_ACCENT}}
                            }
                            mod.widgets.HagencyChevron{}
                        }
                        alert_open := mod.widgets.HagencyListFitTap{enabled:!H.busy on_click: || A.open_alert(row.resourceId,row.id,0)}
                    }
                }}
                if h.alerts.state=="error" {View{width:Fill height:Fit flow:Down
                    if h.alerts.items.len()>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load alerts","暂时无法读取告警")}
                            mod.widgets.HagencyWrapSubtitle{text:A.read_error(h.alerts.error)}
                        }
                    }
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        alerts_refresh := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.health_retry("alerts")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                    }
                }}
                if h.alerts.state=="ready" && h.alerts.next!=nil {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        alerts_next := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.health_more("alerts")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More Alerts","显示更多告警")}}
                    }
                }}
            }

            health_stopped := View{width:Fill height:Fit mod.widgets.HagencyListLabel{text:A.t("INTERRUPTED TASKS","中断的任务")}}
            mod.widgets.HagencyList{
                if h.workspace!="" {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListRow{
                        stopped_all_tasks := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.health_all_tasks()}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.folder}}
                            mod.widgets.HagencyListTitle{text:A.t("Only one workspace’s tasks","只显示一个工作区的任务")}
                            mod.widgets.HagencyAccentText{width:Fit text:A.t("Show All","显示全部")}
                        }
                    }
                    mod.widgets.HagencyListDivider{margin:Inset{left:0}}
                }}
                if h.stopped.state=="loading" && h.stopped.items.len()==0 {mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:180 height:14}}}
                if h.stopped.state=="ready" && h.stopped.items.len()==0 {mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    mod.widgets.HagencyWrapTitle{text:A.t("No interrupted tasks","没有中断的任务")}
                }}
                for index row in h.stopped.items {View{width:Fill height:Fit flow:Down
                    let ready=row.inspectionAvailable && row.sharedResourceAuthority
                    let tone=A.stopped_tone(row)
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.tasks draw_icon.color:A.local_tone_fg(tone)}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{max_lines:1 text_overflow:Ellipsis text:A.t(row.agent+"’s task stopped",A.sub_join(row.agent,"的任务中断了"))}
                                mod.widgets.HagencyListSubtitle{text:if ready {A.t("Waiting for your decision","等待你决定怎么处理")} else {A.t("Can’t be handled yet","暂时不能处理")}}
                                mod.widgets.HagencyWrapSubtitle{text:A.stopped_next(row) draw_text.color:if ready {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}
                            }
                            if ready {mod.widgets.HagencyChevron{}}
                        }
                        stopped_list_open := mod.widgets.HagencyListFitTap{enabled:!H.busy && ready on_click: || {if row.sharedResourceAuthority && row.inspectionAvailable {A.open_stopped(row.resourceId,row.engagementId,row.dispatchId,0)}}}
                        if !row.inspectionAvailable && row.sharedResourceAuthority {View{width:Fill height:Fill align:Align{x:1.0 y:0.5} padding:Inset{right:10}
                            stopped_row_refresh := mod.widgets.HagencyBarText{text:A.t("Refresh","刷新") enabled:!H.busy on_click: || A.health_retry("stopped")}
                        }}
                    }
                }}
                if h.stopped.state=="error" {View{width:Fill height:Fit flow:Down
                    if h.stopped.items.len()>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load interrupted tasks","暂时无法读取中断的任务")}
                            mod.widgets.HagencyWrapSubtitle{text:A.read_error(h.stopped.error)}
                        }
                    }
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        stopped_list_refresh := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.health_retry("stopped")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                    }
                }}
                if h.stopped.state=="ready" && h.stopped.next!=nil {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        stopped_next := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.health_more("stopped")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More Tasks","显示更多任务")}}
                    }
                }}
            }
            mod.widgets.HagencyListNote{text:A.t("See where a task stopped, then let it finish, accept it as done, or pause it.","看看任务停在哪里，再决定继续、确认完成或先暂停。")}

            health_workspaces := View{width:Fill height:Fit mod.widgets.HagencyListLabel{text:A.t("WORKSPACES","工作区")}}
            mod.widgets.HagencyList{
                if h.workspaces.state=="loading" && h.workspaces.items.len()==0 {mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:160 height:14}}}
                if h.workspaces.state=="ready" && h.workspaces.items.len()==0 {mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    mod.widgets.HagencyWrapTitle{text:A.t("No workspaces recorded","没有工作区记录")}
                }}
                for index row in h.workspaces.items {View{width:Fill height:Fit flow:Down
                    let tone=A.workspace_tone(row)
                    let todo=A.workspace_actionable(row)
                    if index>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.folder draw_icon.color:A.local_tone_fg(tone)}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyWrapTitle{max_lines:1 text_overflow:Ellipsis text:A.workspace_state(row)}
                                mod.widgets.HagencyListSubtitle{text:A.workspace_usage(row)}
                                mod.widgets.HagencyWrapSubtitle{text:A.workspace_next(row) draw_text.color:if todo {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_MUTED}}
                            }
                            if todo {mod.widgets.HagencyChevron{}}
                        }
                        workspace_list_open := mod.widgets.HagencyListFitTap{enabled:!H.busy && todo on_click: || {if A.workspace_actionable(row) {A.open_workspace(row.resourceId,row.workspaceId)}}}
                    }
                }}
                if h.workspaces.state=="error" {View{width:Fill height:Fit flow:Down
                    if h.workspaces.items.len()>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load workspaces","暂时无法读取工作区")}
                            mod.widgets.HagencyWrapSubtitle{text:A.read_error(h.workspaces.error)}
                        }
                    }
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        workspace_list_refresh := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.health_retry("workspaces")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                    }
                }}
                if h.workspaces.state=="ready" && h.workspaces.next!=nil {View{width:Fill height:Fit flow:Down
                    mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                    mod.widgets.HagencyListRow{
                        workspace_list_next := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.health_more("workspaces")}
                        mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More Workspaces","显示更多工作区")}}
                    }
                }}
            }
            mod.widgets.HagencyListNote{text:A.t("A workspace is marked when a task stops unexpectedly; check it before it’s used again.","任务意外停止后工作区会被标记，检查后才能再用。")}
        }}}
        if H.page=="resource_alert" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            if H.alert_detail==nil && H.busy {View{width:Fill height:Fit flow:Down spacing:12 align:Align{x:0.5} padding:Inset{top:6 bottom:14}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_FIELD}
                mod.widgets.HagencySkeleton{width:200 height:24}
                mod.widgets.HagencySkeleton{width:120 height:18}
            }}
            if H.alert_detail==nil && !H.busy {mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load this alert","暂时无法读取这条告警")}
                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(H.ux.errorCode)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    alert_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_alert(H.alert_resource,H.alert_id,H.alert_note_after)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if H.alert_detail!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let row=H.alert_detail.alert
                let quota=A.alert_params(row)
                let tone=A.alert_tone(row)
                let {assignee=nil,lastSeen=nil,suppressUntil=nil,next=[]}=row
                let about=A.alert_texts(row)
                let impact=about.impact let runbook=about.runbook let recoveryCondition=about.recovery
                let live=A.alert_live_left(row.resourceId)
                let ceiling=A.alert_kind_of(row)=="ceiling"
                let raise=A.alert_can_raise(row.resourceId)
                let over=quota.drawn!=nil && quota.ceiling!=nil && quota.drawn>quota.ceiling
                let server=A.alert_server_text(row)
                let key="alert:"+row.id
                let recovered=A.alert_recovered(row)
                let quick=A.alert_quick_states(row)
                View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                    mod.widgets.HagencyAvatar{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyAvatarGlyph{draw_icon.svg:if recovered {mod.rinx_icons.check} else {mod.rinx_icons.alert} draw_icon.color:A.local_tone_fg(tone)}}
                    alert_headline := mod.widgets.HagencyHeroName{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:A.alert_headline(row)}
                    if server!="" {mod.widgets.HagencyHint{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:A.t("Server’s words: ","服务器原文（英文）：")+server}}
                    mod.widgets.HagencyPill{draw_bg.color:A.local_tone_bg(tone)
                        mod.widgets.HagencyPillDot{draw_bg.color:A.local_tone_fg(tone)}
                        alert_pill := mod.widgets.HagencyPillText{text:A.alert_pill_text(row) draw_text.color:A.local_tone_fg(tone)}
                    }
                    alert_seen := mod.widgets.HagencyHint{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:A.alert_seen_line(row)}
                }
                if H.alert_saved!=nil && H.alert_saved.id==row.id {View{width:Fill height:Fit padding:Inset{bottom:6} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_SUCCESS_BG
                    mod.widgets.HagencyCopy{text:A.alert_saved_text(H.alert_saved.to) draw_text.color:mod.widgets.RINX_SUCCESS_FG}
                    alert_saved_done := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || A.health_open(H.alert_resource,nil,nil)}
                }}}
                if ceiling && recovered && live!=nil && live.ceiling!=nil {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("NOW","现在")}
                    mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:10 padding:Inset{left:16 right:16 top:14 bottom:14}
                        View{width:Fill height:Fit flow:Right spacing:6 align:Align{y:1.0}
                            mod.widgets.HagencyStatValue{text:A.tokens(live.remaining) draw_text.color:mod.widgets.RINX_SUCCESS_FG}
                            mod.widgets.HagencyListValue{padding:Inset{bottom:3} text:A.t("left of "+A.tokens(live.ceiling),"剩余，每月上限 "+A.tokens(live.ceiling))}
                        }
                        if live.ceiling>0 {View{width:Fill height:8 flow:Overlay
                            let used=if live.spent==nil {0} else {max(0,min(1,live.spent/live.ceiling))}
                            let held=max(used,max(0,min(1,live.committed/live.ceiling)))
                            RoundedView{width:Fill height:8 show_bg:true draw_bg +: {color:mod.widgets.RINX_BORDER border_radius:4.0}}
                            if held>0 {View{width:Fill height:8 flow:Right
                                RoundedView{width:Fill{weight:held} height:8 show_bg:true draw_bg +: {color:mod.widgets.RINX_WARNING_FG border_radius:4.0}}
                                if held<1 {View{width:Fill{weight:1-held} height:8}}
                            }}
                            if used>0 {View{width:Fill height:8 flow:Right
                                RoundedView{width:Fill{weight:used} height:8 show_bg:true draw_bg +: {color:mod.widgets.RINX_ACCENT border_radius:4.0}}
                                if used<1 {View{width:Fill{weight:1-used} height:8}}
                            }}
                        }}
                        alert_recovered_note := mod.widgets.HagencyWrapSubtitle{text:A.t("Use is back under the maximum. This alert clears by itself; there’s nothing you need to do.","用量已回到上限以内。这条告警会自动解除，不用你处理。") draw_text.color:mod.widgets.RINX_SUCCESS_FG}
                    }}
                    mod.widgets.HagencyListLabel{text:A.t("TO KEEP IT FROM HAPPENING AGAIN","以后防止再超出")}
                    mod.widgets.HagencyList{
                        mod.widgets.HagencyListRow{
                            alert_pool_open := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || A.alert_open_max(row.resourceId)}
                            mod.widgets.HagencyListBody{
                                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.gauge}}
                                mod.widgets.HagencyListTitle{text:if raise {A.t("Raise the Monthly Maximum","调高每月上限")} else {A.t("See the Monthly Maximum","查看每月上限")}}
                                mod.widgets.HagencyChevron{}
                            }
                        }
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencyListRow{
                            alert_agents_open := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || A.alert_open_agents(row.resourceId)}
                            mod.widgets.HagencyListBody{
                                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot}}
                                mod.widgets.HagencyListTitle{text:A.t("Stop Some Agents","停止部分 Agent")}
                                mod.widgets.HagencyChevron{}
                            }
                        }
                    }
                }}
                if ceiling && !recovered {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("WHAT YOU CAN DO","你可以这样处理")}
                    View{width:Fill height:Fit flow:Right spacing:8 padding:Inset{top:2 bottom:2}
                        mod.widgets.HagencyActionTile{
                            alert_pool_open := mod.widgets.HagencyTileTap{enabled:!H.busy && H.command==nil on_click: || A.alert_open_max(row.resourceId)}
                            mod.widgets.HagencyActionTileBody{
                                mod.widgets.HagencyTileGlyph{draw_icon.svg:mod.rinx_icons.gauge}
                                mod.widgets.HagencyTileLabel{text:if raise {A.t("Raise the Maximum","调高每月上限")} else {A.t("See the Maximum","查看每月上限")}}
                            }
                        }
                        mod.widgets.HagencyActionTile{
                            alert_agents_open := mod.widgets.HagencyTileTap{enabled:!H.busy && H.command==nil on_click: || A.alert_open_agents(row.resourceId)}
                            mod.widgets.HagencyActionTileBody{
                                mod.widgets.HagencyTileGlyph{draw_icon.svg:mod.rinx_icons.robot}
                                mod.widgets.HagencyTileLabel{text:A.t("Stop Some Agents","停止部分 Agent")}
                            }
                        }
                    }
                    mod.widgets.HagencyListNote{text:if raise {A.t("Either one clears this alert once use is back under the maximum.","任选一个；用量回到上限以内后，告警自动解除。")} else {A.t("The maximum can’t change here now; stopping Agents until use is back under it clears this alert.","每月上限现在不能在这里调整；停止部分 Agent，用量回到上限以内后，这条告警会解除。")}}
                }}
                if quota.drawn!=nil || quota.ceiling!=nil {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("WHEN THE ALERT WAS RAISED","告警时的用量")+(if A.alert_period(quota)!="" {A.t(" · "," · ")+A.alert_period(quota)} else {""})}
                    mod.widgets.HagencyList{
                        View{width:Fill height:Fit flow:Down spacing:10 padding:Inset{left:16 right:16 top:14 bottom:14}
                            View{width:Fill height:Fit flow:Right spacing:6 align:Align{y:1.0}
                                mod.widgets.HagencyStatValue{text:A.tokens(quota.drawn) draw_text.color:if over && !recovered {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_INK}}
                                mod.widgets.HagencyListValue{padding:Inset{bottom:3} text:A.t("committed, of a "+A.tokens(quota.ceiling)+" maximum","已承诺，每月上限 "+A.tokens(quota.ceiling))}
                            }
                            if quota.drawn!=nil && quota.ceiling!=nil && quota.ceiling>0 {View{width:Fill height:8 flow:Overlay
                                RoundedView{width:Fill height:8 show_bg:true draw_bg +: {color:mod.widgets.RINX_BORDER border_radius:4.0}}
                                View{width:Fill height:8 flow:Right
                                    RoundedView{width:Fill{weight:min(1,quota.drawn/quota.ceiling)} height:8 show_bg:true draw_bg +: {color:if over && !recovered {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_MUTED} border_radius:4.0}}
                                    if quota.drawn<quota.ceiling {View{width:Fill{weight:1-quota.drawn/quota.ceiling} height:8}}
                                }
                            }}
                            if quota.over!=nil && quota.over>0 {mod.widgets.HagencyListSubtitle{text:A.t("Over by ","超出 ")+A.tokens(quota.over) draw_text.color:if recovered {mod.widgets.RINX_MUTED} else {mod.widgets.RINX_DANGER_FG}}}
                            if quota.committed!=nil || quota.measured!=nil {mod.widgets.HagencyWrapSubtitle{text:A.alert_split(quota)}}
                        }
                        if !recovered && live!=nil && live.ceiling!=nil {View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                            mod.widgets.HagencySwitchRow{
                                mod.widgets.HagencyRowIcon{draw_bg.color:if live.low {mod.widgets.RINX_DANGER_BG} else {mod.widgets.RINX_SUCCESS_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.gauge draw_icon.color:if live.low {mod.widgets.RINX_DANGER_FG} else {mod.widgets.RINX_SUCCESS_FG}}}
                                mod.widgets.HagencyListTitle{text:A.t("Left now","现在剩余")}
                                mod.widgets.HagencyListValue{text:A.tokens(live.remaining)+A.t(" of ","，共 ")+A.tokens(live.ceiling)}
                            }
                        }}
                    }
                    alert_figures_note := mod.widgets.HagencyListNote{text:if recovered {A.alert_when_line(row)} else {A.alert_now_line(row,quota,live)}}
                }}
                if !recovered && (impact!="" || recoveryCondition!="" || (!ceiling && runbook!="")) {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:if about.local {A.t("ABOUT THIS ALERT","说明")} else {A.t("FROM THE SERVER","服务器的说明")}}
                    mod.widgets.HagencyList{
                        if impact!="" {View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:16 top:11 bottom:11} align:Align{y:0.0}
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                            View{width:Fill height:Fit flow:Down spacing:3 padding:Inset{top:3}
                                mod.widgets.HagencyListSubtitle{text:A.t("What it affects","影响")}
                                mod.widgets.HagencyWrapTitle{text:impact}
                            }
                        }}
                        if impact!="" && !ceiling && runbook!="" {mod.widgets.HagencyListDivider{}}
                        if !ceiling && runbook!="" {View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:16 top:11 bottom:11} align:Align{y:0.0}
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.bulb draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            View{width:Fill height:Fit flow:Down spacing:3 padding:Inset{top:3}
                                mod.widgets.HagencyListSubtitle{text:A.t("What to do","建议的处理")}
                                mod.widgets.HagencyWrapTitle{text:runbook}
                            }
                        }}
                        if (impact!="" || (!ceiling && runbook!="")) && recoveryCondition!="" {mod.widgets.HagencyListDivider{}}
                        if recoveryCondition!="" {View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:16 top:11 bottom:11} align:Align{y:0.0}
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            View{width:Fill height:Fit flow:Down spacing:3 padding:Inset{top:3}
                                mod.widgets.HagencyListSubtitle{text:A.t("When it clears","恢复条件")}
                                mod.widgets.HagencyWrapTitle{text:recoveryCondition}
                            }
                        }}
                    }
                }}
                if !ceiling {View{width:Fill height:Fit padding:Inset{top:6} mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    alert_pool_open := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_resource(row.resourceId)}
                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.gauge draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                        mod.widgets.HagencyListTitle{text:A.t("Open the Pool","打开资源池")}
                        mod.widgets.HagencyChevron{}
                    }
                }}}}
                if H.alert_draft==nil && quick.len()>0 {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("MARK THIS ALERT","标记这条告警")}
                    View{width:Fill height:Fit flow:Right spacing:8 padding:Inset{top:2 bottom:2}
                        for state in quick {mod.widgets.HagencyActionTile{
                            alert_choose := mod.widgets.HagencyTileTap{enabled:!H.busy && H.command==nil on_click: || A.alert_quick(state)}
                            mod.widgets.HagencyActionTileBody{
                                mod.widgets.HagencyTileGlyph{draw_icon.svg:A.alert_action_icon(state) draw_icon.color:if state=="resolved" {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_ACCENT}}
                                mod.widgets.HagencyTileLabel{text:A.alert_tile_label(state) draw_text.color:if state=="resolved" {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_ACCENT}}
                            }
                        }}
                    }
                    if quick.len()>0 && quick[0]=="acknowledged" {View{width:Fill height:Fit flow:Right spacing:8 align:Align{y:0.5}
                        mod.widgets.HagencyListNote{width:Fill text:A.t("One tap; it only records it and changes no limits.","点一下就记下，不会改动用量或上限。")}
                        alert_note_open := mod.widgets.HagencyBarText{text:A.t("Add a Note…","加备注…") enabled:!H.busy && H.command==nil on_click: || A.choose_alert_action("acknowledged")}
                    }}
                    if quick.len()==0 || quick[0]!="acknowledged" {mod.widgets.HagencyListNote{text:A.t("One tap; it only records it and changes no limits.","点一下就记下，不会改动用量或上限。")}}
                }}
                if H.alert_draft!=nil && !H.alert_draft.quick {View{width:Fill height:Fit flow:Down spacing:6
                    let draft=H.alert_draft
                    mod.widgets.HagencyListLabel{text:A.alert_action(draft.to)}
                    mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:12 bottom:14}
                        View{width:Fill height:Fit flow:Right spacing:12 align:Align{y:0.5}
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:A.alert_action_icon(draft.to)}}
                            mod.widgets.HagencyWrapSubtitle{text:A.alert_action_hint(draft.to)}
                        }
                        alert_note := mod.widgets.HagencyInput{width:Fill text:draft.note empty_text:A.t("Note (optional)","备注（可选）") on_change:|text|{draft.note=text}}
                    }}
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{top:6}
                        alert_cancel := mod.widgets.HagencyWideTinted{text:A.t("Cancel","取消") enabled:!H.busy on_click: || {H.alert_draft=nil A.redraw()}}
                        alert_save := mod.widgets.HagencyWideButton{text:A.t("Save","保存") enabled:!H.busy && H.command==nil on_click: || A.submit_alert()}
                    }
                }}
                View{width:Fill height:Fit padding:Inset{top:12} mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        alert_details := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle(key)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyListSubtitle{text:A.t("Notes and details","处理记录和详细信息")+(if H.alert_detail.notes.len()>0 {" · "+H.alert_detail.notes.len()} else {""})}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.details_open==key {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if H.details_open==key {View{width:Fill height:Fit flow:Down
                        if H.alert_detail.notes.len()==0 {mod.widgets.HagencySwitchRow{mod.widgets.HagencyListSubtitle{text:A.t("No notes yet","还没有处理记录")}}}
                        for index note in H.alert_detail.notes {View{width:Fill height:Fit flow:Down
                            let {at=nil}=note
                            mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                            View{width:Fill height:Fit flow:Down spacing:4 padding:Inset{left:16 right:16 top:11 bottom:11}
                                mod.widgets.HagencyWrapTitle{text:note.text}
                                mod.widgets.HagencyListSubtitle{text:A.sub_person(note.author)+if at!=nil {" · "+A.alert_when(note,"at")} else {""}}
                            }
                        }}
                        if H.alert_detail.nextNote!=nil {View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                            mod.widgets.HagencyListRow{
                                alert_notes_next := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_alert(H.alert_resource,H.alert_id,H.alert_detail.nextNote)}
                                mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More Notes","显示更多记录")}}
                            }
                        }}
                        if H.alert_note_after>0 {View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                            mod.widgets.HagencyListRow{
                                alert_notes_first := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_alert(H.alert_resource,H.alert_id,0)}
                                mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Back to First Notes","回到最早的记录")}}
                            }
                        }}
                        mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                        View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:10 bottom:12}
                            mod.widgets.HagencyListSubtitle{text:A.t("Alert ID · select to copy","告警编号 · 可选中复制")}
                            alert_id_copy := mod.widgets.HagencyCopyText{text:row.id}
                            if assignee!=nil {View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Handled by","处理人")} mod.widgets.HagencyCopyText{text:assignee}}}
                            if ceiling {View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Server text","服务器原文")} mod.widgets.HagencyCopyText{text:""+row.summary}}}
                        }
                    }}
                }}
            }}
        }}}
        if H.page=="stopped_task" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let step=if H.stopped_mode=="choose" {2} else if H.stopped_mode=="confirm" {3} else {1}
            if H.stopped_mode!="result" && H.stopped_detail==nil && H.busy {View{width:Fill height:Fit flow:Down spacing:12 align:Align{x:0.5} padding:Inset{top:6 bottom:14}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_FIELD}
                mod.widgets.HagencySkeleton{width:160 height:24}
                mod.widgets.HagencySkeleton{width:120 height:18}
            }}
            if H.stopped_mode!="result" && H.stopped_detail==nil && !H.busy {mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load this task’s record","暂时无法读取这个任务的检查记录")}
                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(H.ux.errorCode)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    stopped_refresh := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || {if H.command==nil {A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,0)}}}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if H.stopped_detail!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let d=H.stopped_detail
                let key="stopped:"+d.attempt.dispatchId
                View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                    mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.tasks draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyHeroName{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:if d.taskTitle!=nil {d.taskTitle} else {A.t("Untitled task","未命名任务")}}
                    mod.widgets.HagencyPill{draw_bg.color:mod.widgets.RINX_WARNING_BG
                        mod.widgets.HagencyPillDot{draw_bg.color:mod.widgets.RINX_WARNING_FG}
                        mod.widgets.HagencyPillText{text:A.t(d.attempt.agent+" · interrupted",d.attempt.agent+" · 已中断") draw_text.color:mod.widgets.RINX_WARNING_FG}
                    }
                }
                View{width:Fill height:Fit flow:Right spacing:6 align:Align{x:0.5} padding:Inset{bottom:6}
                    for n label in [A.t("Look","看看"),A.t("Choose","选择"),A.t("Confirm","确认")] {mod.widgets.HagencyPill{padding:Inset{left:10 right:10 top:3 bottom:3} draw_bg.color:if n+1==step {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_SELECTED}
                        mod.widgets.HagencyPillText{text:""+(n+1)+" "+label draw_text.color:if n+1==step {mod.widgets.RINX_ON_ACCENT} else {mod.widgets.RINX_MUTED}}
                    }}
                }
                if !d.resolvable {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyWrapTitle{text:A.t("This is an old record. It can’t be used to settle the task now.","这是历史检查记录，不能用来处理当前任务。")}
                }}}
                if d.resolvable && !d.canContinue {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyWrapTitle{text:A.t("The device couldn’t confirm the task stopped, so it can’t continue. Check the process and any outside effects first.","这台电脑无法确认任务已经停止，所以不能继续。请先确认它确实停了，以及它是否动过别处。")}
                }}}
                if H.stopped_mode=="inspect" {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("WHERE IT STOPPED","看看任务停在哪里")}
                    mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.folder draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyWrapTitle{text:A.t("In its project’s workspace on this computer","在这台电脑上它所在项目的工作区里")}
                            stopped_location := mod.widgets.HagencyWrapSubtitle{text:A.stopped_where(d.attempt)}
                        }
                    }}
                    mod.widgets.HagencyListLabel{text:A.t("FILES IT LEFT ("+d.entryCount+")","它留下的文件（"+d.entryCount+"）")}
                    mod.widgets.HagencyList{
                        if d.entryCount==0 {mod.widgets.HagencySwitchRow{mod.widgets.HagencyListSubtitle{text:A.t("No files were recorded","没有文件记录")}}}
                        for index entry in d.entries {View{width:Fill height:Fit flow:Down
                            if index>0 {mod.widgets.HagencyListDivider{}}
                            mod.widgets.HagencySwitchRow{
                                mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:if entry.kind=="directory" {mod.rinx_icons.folder} else if entry.kind=="symlink" {mod.rinx_icons.connection} else {mod.rinx_icons.file}}}
                                mod.widgets.HagencyWrapTitle{text:entry.relativePath}
                                mod.widgets.HagencyListValue{text:A.stopped_entry_size(entry)}
                            }
                        }}
                        if d.nextEntry!=nil {View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                            mod.widgets.HagencyListRow{
                                stopped_inventory_next := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,d.nextEntry)}
                                mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Show More Files","显示更多文件")}}
                            }
                        }}
                        if H.stopped_offset>0 {View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                            mod.widgets.HagencyListRow{
                                stopped_inventory_first := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_stopped(H.stopped_resource,H.stopped_engagement,H.stopped_dispatch,0)}
                                mod.widgets.HagencyListBody{mod.widgets.HagencyAccentText{text:A.t("Back to First Files","回到前面的文件")}}
                            }
                        }}
                    }
                    mod.widgets.HagencyListNote{text:A.t("Paths start in that workspace. It’s the list recorded when it stopped, not a live view.","路径从那个工作区算起；这是它停下时记下的清单，不是实时内容。")}
                    if d.resolvable && d.attempt.sharedResourceAuthority {View{width:Fill height:Fit padding:Inset{top:10}
                        stopped_review := mod.widgets.HagencyWideButton{text:A.t("Next: Choose What to Do","下一步：选择处理方式") enabled:!H.busy && H.command==nil on_click: || A.review_stopped()}
                    }}
                }}
                if H.stopped_mode=="choose" {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("WHAT SHOULD HAPPEN","选择处理方式")}
                    mod.widgets.HagencyList{
                        if d.canContinue {View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListFit{
                                mod.widgets.HagencyListFitBody{
                                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.sync draw_icon.color:mod.widgets.RINX_INFO_FG}}
                                    mod.widgets.HagencyListText{
                                        mod.widgets.HagencyListTitle{text:A.stopped_action_label("continue")}
                                        mod.widgets.HagencyWrapSubtitle{text:A.stopped_action_hint("continue")}
                                    }
                                    if H.stopped_action=="continue" {mod.widgets.HagencyCheck{}}
                                }
                                stopped_choose_continue := mod.widgets.HagencyListFitTap{enabled:A.stopped_can_decide() on_click: || A.choose_stopped("continue")}
                            }
                            mod.widgets.HagencyListDivider{}
                        }}
                        mod.widgets.HagencyListFit{
                            mod.widgets.HagencyListFitBody{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                                mod.widgets.HagencyListText{
                                    mod.widgets.HagencyListTitle{text:A.stopped_action_label("accept_completed")}
                                    mod.widgets.HagencyWrapSubtitle{text:A.stopped_action_hint("accept_completed")}
                                }
                                if H.stopped_action=="accept_completed" {mod.widgets.HagencyCheck{}}
                            }
                            stopped_choose_completed := mod.widgets.HagencyListFitTap{enabled:A.stopped_can_decide() on_click: || A.choose_stopped("accept_completed")}
                        }
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencyListFit{
                            mod.widgets.HagencyListFitBody{
                                mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.pause draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                                mod.widgets.HagencyListText{
                                    mod.widgets.HagencyListTitle{text:A.stopped_action_label("keep_blocked")}
                                    mod.widgets.HagencyWrapSubtitle{text:A.stopped_action_hint("keep_blocked")}
                                }
                                if H.stopped_action=="keep_blocked" {mod.widgets.HagencyCheck{}}
                            }
                            stopped_choose_blocked := mod.widgets.HagencyListFitTap{enabled:A.stopped_can_decide() on_click: || A.choose_stopped("keep_blocked")}
                        }
                    }
                    if H.stopped_action!="" {View{width:Fill height:Fit flow:Down spacing:6
                        mod.widgets.HagencyListLabel{text:if H.stopped_action=="keep_blocked" {A.t("WHY PAUSE IT?","为什么先暂停？")} else {A.t("CHECK WHAT IT LEFT FIRST?","要先核对它留下的文件吗？")}}
                        mod.widgets.HagencyList{for index c in A.stopped_checks(H.stopped_action) {let check=c View{width:Fill height:Fit flow:Down
                            if index>0 {mod.widgets.HagencyListDivider{}}
                            mod.widgets.HagencyListFit{
                                mod.widgets.HagencyListFitBody{padding:Inset{left:14 right:14 top:13 bottom:13}
                                    mod.widgets.HagencyListTitle{text:check.text}
                                    if H.stopped_check==check.key {mod.widgets.HagencyCheck{}}
                                }
                                stopped_check_pick := mod.widgets.HagencyListFitTap{enabled:A.stopped_can_decide() on_click: || A.stopped_pick_check(check.key)}
                            }
                        }}}
                        if H.stopped_action=="continue" {View{width:Fill height:Fit flow:Down spacing:6
                            mod.widgets.HagencyListLabel{text:A.t("WHAT THE AGENT DOES NEXT","Agent 接下来做什么")}
                            mod.widgets.HagencyList{View{width:Fill height:Fit padding:Inset{left:12 right:12 top:10 bottom:10}
                                stopped_instruction := mod.widgets.HagencyInput{is_read_only:!A.stopped_can_decide() height:64 is_multiline:true width:Fill text:H.stopped_instruction empty_text:A.t("What’s left to do","还剩哪些工作") on_change:|text|{if A.stopped_can_decide(){H.stopped_instruction=text A.stopped_form_refresh()}}}
                            }}
                            mod.widgets.HagencyListNote{text:A.t("Filled in from the task; change it if you like.","已按任务填好，需要时可以改。")}
                        }}
                        mod.widgets.HagencyListLabel{text:A.t("NOTE (OPTIONAL)","补充一句（可选）")}
                        mod.widgets.HagencyList{View{width:Fill height:Fit padding:Inset{left:12 right:12 top:8 bottom:8}
                            stopped_note := mod.widgets.HagencyInput{is_read_only:!A.stopped_can_decide() width:Fill text:H.stopped_extra empty_text:A.t("Anything to remember about it","想记下的话") on_change:|text|{if A.stopped_can_decide(){H.stopped_extra=text A.stopped_form_refresh()}}}
                        }}
                    }}
                    View{width:Fill height:Fit padding:Inset{top:8}
                        stopped_confirm_review := mod.widgets.HagencyWideButton{enabled:A.stopped_can_decide() && A.stopped_missing()=="" text:A.t("Next: Review","下一步：确认") draw_bg +: {color_disabled:mod.widgets.RINX_FIELD color_2_disabled:mod.widgets.RINX_FIELD} on_click: || A.confirm_stopped()}
                    }
                    stopped_missing := mod.widgets.HagencyListNote{align:Align{x:0.5} visible:A.stopped_missing()!="" text:A.stopped_missing()}
                }}
                if H.stopped_mode=="confirm" {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("YOUR DECISION","确认处理决定")}
                    mod.widgets.HagencyList{
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.stopped_action=="continue" {mod.rinx_icons.sync} else if H.stopped_action=="accept_completed" {mod.rinx_icons.check} else {mod.rinx_icons.pause} draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            mod.widgets.HagencyListTitle{text:A.stopped_action_label(H.stopped_action)}
                        }
                        mod.widgets.HagencyListDivider{}
                        View{width:Fill height:Fit flow:Down spacing:3 padding:Inset{left:57 right:16 top:10 bottom:10}
                            mod.widgets.HagencyListSubtitle{text:A.t("Your answer","你的说明")}
                            mod.widgets.HagencyWrapTitle{text:A.stopped_full_note()}
                        }
                        if H.stopped_action=="continue" {View{width:Fill height:Fit flow:Down
                            mod.widgets.HagencyListDivider{}
                            View{width:Fill height:Fit flow:Down spacing:3 padding:Inset{left:57 right:16 top:10 bottom:10}
                                mod.widgets.HagencyListSubtitle{text:A.t("What the Agent does next","Agent 接下来做什么")}
                                mod.widgets.HagencyWrapTitle{text:H.stopped_instruction}
                            }
                        }}
                    }
                    mod.widgets.HagencyListNote{text:if H.stopped_action=="continue" {A.t("The Agent starts again in the same workspace with your instructions.","Agent 会按你的说明，在同一工作区重新开始剩下的工作。")} else if H.stopped_action=="accept_completed" {A.t("The task will be marked done. Make sure its result is right.","任务将被标记为已完成，请确认结果无误。")} else {A.t("Nothing runs; the task stays paused until someone picks it up.","任务会暂停，不再运行，直到有人继续处理。")}}
                    mod.widgets.HagencyListNote{text:A.t("This records your decision. It can’t undo anything that already happened.","这只记录你的决定，不能撤销已经发生的影响。")}
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{top:8}
                        stopped_cancel := mod.widgets.HagencyWideTinted{enabled:A.stopped_can_decide() text:A.t("Back","返回修改") on_click: || {if A.stopped_can_decide(){H.stopped_mode="choose" A.redraw()}}}
                        stopped_commit := mod.widgets.HagencyWideButton{enabled:A.stopped_can_decide() text:A.t("Confirm","确认") on_click: || A.submit_stopped()}
                    }
                }}
                View{width:Fill height:Fit padding:Inset{top:12} mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        stopped_details := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle(key)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyListSubtitle{text:A.t("IDs for your administrator","给管理员看的编号")}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.details_open==key {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if H.details_open==key {View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:2 bottom:12}
                        View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Project · select to copy","项目编号 · 可选中复制")} mod.widgets.HagencyCopyText{text:d.attempt.projectId}}
                        View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Run","执行编号")} mod.widgets.HagencyCopyText{text:d.attempt.dispatchId}}
                    }}
                }}
            }}
            if H.stopped_mode=="result" && H.stopped_result!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let result=H.stopped_result
                View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                    mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.check draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    mod.widgets.HagencyHeroName{text:A.stopped_done_title(result.action)}
                    mod.widgets.HagencyHint{width:Fit text:A.stopped_action_label(result.action)}
                }
                mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.tasks draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                    mod.widgets.HagencyListTitle{text:A.t("Task status","任务状态")}
                    mod.widgets.HagencyListValue{text:A.task_status(result.taskStatus)}
                }}
                View{width:Fill height:Fit padding:Inset{top:10}
                    stopped_result_done := mod.widgets.HagencyWideButton{text:A.t("Done","完成") enabled:!H.busy on_click: || A.open_stopped_tasks(H.stopped_resource,H.stopped_workspace,"")}
                }
                View{width:Fill height:Fit padding:Inset{top:12} mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        stopped_result_details := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle("stopped_result")}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyListSubtitle{text:A.t("IDs for your administrator","给管理员看的编号")}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.details_open=="stopped_result" {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if H.details_open=="stopped_result" {View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:2 bottom:12}
                        mod.widgets.HagencyWrapSubtitle{text:A.t("Task ","任务编号 ")+result.taskId}
                        mod.widgets.HagencyWrapSubtitle{text:A.t("Run ","执行编号 ")+result.dispatchId}
                    }}
                }}
            }}
        }}}
        if H.page=="workspace" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            if H.workspace_detail==nil && H.busy {View{width:Fill height:Fit flow:Down spacing:12 align:Align{x:0.5} padding:Inset{top:6 bottom:14}
                mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_FIELD}
                mod.widgets.HagencySkeleton{width:160 height:24}
            }}
            if H.workspace_detail==nil && !H.busy {mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load this workspace","暂时无法读取这个工作区")}
                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(H.ux.errorCode)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    workspace_refresh := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_workspace(H.workspace_resource,H.workspace_id)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if H.workspace_detail!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let row=H.workspace_detail
                let tone=if H.workspace_mode=="result" {"running"} else {A.workspace_tone(row)}
                let key="workspace:"+row.workspaceId
                View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                    mod.widgets.HagencyAvatar{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.folder draw_icon.color:A.local_tone_fg(tone)}}
                    mod.widgets.HagencyHeroName{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:if H.workspace_mode=="result" {A.t("Ready to Use Again","工作区可以再次使用")} else {A.workspace_state(row)}}
                    mod.widgets.HagencyHint{width:Fit text:A.workspace_label(row)}
                }
                if row.quarantined {mod.widgets.HagencyList{
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyListTitle{text:A.t("Next step","下一步")}
                            mod.widgets.HagencyWrapSubtitle{text:A.workspace_error("management_workspace_inspection_required")}
                        }
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencyListRow{
                        workspace_stopped := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_stopped_tasks(row.resourceId,row.workspaceId,"")}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.tasks draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                            mod.widgets.HagencyListTitle{text:A.t("Check Interrupted Tasks","检查中断的任务")}
                            mod.widgets.HagencyChevron{}
                        }
                    }
                }}
                if row.activeLeases>0 && !row.quarantined {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_INFO_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyListTitle{text:A.t("Next step","下一步")}
                        mod.widgets.HagencyWrapSubtitle{text:A.workspace_error("management_workspace_active")}
                    }
                }}}
                if row.releaseBlock=="shared_resource_authority" {mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.people}}
                    mod.widgets.HagencyWrapTitle{text:A.t("Other pools share this workspace. Clearing its marker needs access to all of them.","此工作区由多个资源池共用，要拥有全部这些资源池，才能允许再次使用。")}
                }}}
                mod.widgets.HagencyListLabel{text:A.t("STATUS","状态")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.tasks draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListTitle{text:A.t("Tasks using it","正在使用的任务")}
                        mod.widgets.HagencyListValue{text:""+row.activeLeases}
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.projects}}
                        mod.widgets.HagencyListTitle{text:A.t("Used by","使用范围")}
                        mod.widgets.HagencyListValue{text:if row.sharedResourceCount>1 {A.t("Shared with "+row.sharedResourceCount+" pools","与 "+row.sharedResourceCount+" 个资源池共用")} else {A.t("This pool only","只有此资源池")}}
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:if row.dirty {mod.widgets.RINX_WARNING_BG} else {mod.widgets.RINX_SUCCESS_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:if row.dirty {mod.rinx_icons.alert} else {mod.rinx_icons.check} draw_icon.color:if row.dirty {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_SUCCESS_FG}}}
                        mod.widgets.HagencyListTitle{text:A.t("Check","检查")}
                        mod.widgets.HagencyListValue{text:if row.dirty {A.t("Take a look first","需要你先看一下")} else {A.t("Nothing to do","不用处理")} draw_text.color:if row.dirty {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_MUTED}}
                    }
                }
                if H.workspace_mode=="result" {View{width:Fill height:Fit padding:Inset{top:10}
                    workspace_result_done := mod.widgets.HagencyWideButton{text:A.t("Done","完成") enabled:!H.busy on_click: || A.health_open(H.workspace_resource,nil,nil)}
                }}
                if H.workspace_mode=="detail" && !row.dirty && row.releaseBlock==nil {mod.widgets.HagencyListNote{text:A.t("Nothing to do. New tasks can use it.","无需操作，新的任务可以使用它。")}}
                if A.workspace_can_clear() {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:8}
                    mod.widgets.HagencyListNote{text:A.t("It’s a folder on this computer that Hagency can’t open for you yet. If you’re not sure about its files, see the interrupted task first; otherwise let new tasks use it.","它是这台电脑上的一个文件夹，Hagency 还不能替你打开。拿不准里面的文件时，先看看中断的任务；没问题就允许再次使用。")}
                    mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                        workspace_tasks_open := mod.widgets.HagencyListTap{enabled:!H.busy && H.command==nil on_click: || A.open_stopped_tasks(H.workspace_resource,row.workspaceId,"")}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.tasks}}
                            mod.widgets.HagencyListTitle{text:A.t("See the Interrupted Task","看看中断的任务")}
                            mod.widgets.HagencyChevron{}
                        }
                    }}
                    workspace_review := mod.widgets.HagencyWideButton{text:A.t("Clear Marker…","允许再次使用…") enabled:!H.busy && H.command==nil on_click: || A.review_workspace()}
                }}
                if H.workspace_mode=="review" && H.workspace_review!=nil {View{width:Fill height:Fit flow:Down spacing:6 padding:Inset{top:8}
                    mod.widgets.HagencyList{mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.info draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                        mod.widgets.HagencyWrapTitle{text:A.t("New tasks can use it again. This doesn’t undo file changes or restart a task.","新的任务可以再次使用它；这不会撤销文件修改，也不会重新启动任务。")}
                    }}
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{top:6}
                        workspace_cancel := mod.widgets.HagencyWideTinted{text:A.t("Cancel","取消") enabled:!H.busy && H.command==nil on_click: || {if !H.busy && H.command==nil {H.workspace_mode="detail" H.workspace_review=nil A.redraw()}}}
                        workspace_confirm := mod.widgets.HagencyWideButton{text:A.t("Allow Use","允许使用") enabled:!H.busy && H.command==nil on_click: || A.submit_workspace()}
                    }
                }}
                View{width:Fill height:Fit padding:Inset{top:12} mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        workspace_details := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle(key)}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyListSubtitle{text:A.t("IDs for your administrator","给管理员看的编号")}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.details_open==key {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if H.details_open==key {View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:2 bottom:12}
                        View{width:Fill height:Fit flow:Down mod.widgets.HagencyListSubtitle{text:A.t("Workspace · select to copy","工作区编号 · 可选中复制")} mod.widgets.HagencyCopyText{text:row.workspaceId}}
                    }}
                }}
            }}
        }}}
        if H.page=="web_overview"{
            mod.widgets.HagencyDetailCard{
                let w=H.web
                mod.widgets.HagencyTitle{text:A.web_title(w.kind)}
                mod.widgets.HagencyActions{
                    for kind in ["workforce","capability","usage","accounts","alerts"]{View{width:Fit height:Fit web_section := mod.widgets.HagencyChoice{enabled:!H.busy text:A.web_title(kind) draw_bg.color:if w.kind==kind{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||A.open_web(kind,nil)}}}
                }
                if w.kind=="alerts"{mod.widgets.HagencyFormGroup{
                    mod.widgets.HagencyActions{for status in ["","open","acknowledged","investigating","resolved","suppressed"]{View{width:Fit height:Fit web_alert_status := mod.widgets.HagencyChoice{enabled:!H.busy text:if status==""{A.t("All statuses","全部状态")}else{A.alert_state(status)} draw_bg.color:if status==w.status{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||{w.status=status A.open_web("alerts",nil)}}}}}
                    mod.widgets.HagencyActions{for severity in ["","critical","warning","info"]{View{width:Fit height:Fit web_alert_severity := mod.widgets.HagencyChoice{enabled:!H.busy text:if severity==""{A.t("All severities","全部严重程度")}else{A.alert_severity(severity)} draw_bg.color:if severity==w.severity{mod.widgets.RINX_SELECTED}else{mod.widgets.RINX_SURFACE} on_click:||{w.severity=severity A.open_web("alerts",nil)}}}}}
                    mod.widgets.HagencyFieldLabel{width:Fill text:A.t("Agent/resource ID","Agent / 资源标识")}
                    web_alert_agent := mod.widgets.HagencyInput{empty_text:A.t("All agents and resources","全部 Agent 与资源") text:w.agent on_change:|s|{w.agent=s} on_return:|s|{w.agent=s A.open_web("alerts",nil)}}
                    web_alert_filter := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Apply filter","应用筛选") on_click:||A.open_web("alerts",nil)}
                }}
                if w.data!=nil{View{width:Fill height:Fit flow:Down spacing:(16 * mod.widgets.RINX_SPACING)
                    let data=w.data
                    if w.kind=="workforce"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        mod.widgets.HagencyHint{text:A.t("Agents, project access and capacity in one place. Open a row to manage its latest state.","集中查看 Agent、项目访问权与容量，打开记录管理最新状态。")}
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No agents in this view.","此视图暂无 Agent。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.name}
                            mod.widgets.HagencyCopy{text:(if row.projectName==nil{row.projectId}else{row.projectName})+" · "+A.agent_state_text(row.state)}
                            mod.widgets.HagencyHint{text:row.managerMxid+" · "+A.capability_label(row.capability)}
                            mod.widgets.HagencyCopy{text:A.t("Requested allocation","申请额度")+" · "+A.tokens(row.requestedTokens)+" token · "+row.periodKey}
                            if row.account!=nil{mod.widgets.HagencyCopy{text:A.t("Provider account","模型服务账号")+" · "+row.account}}
                            if row.localBinding!=nil{mod.widgets.HagencySection{
                                let binding=row.localBinding
                                mod.widgets.HagencyCopy{text:A.t("Consumed / reserved / allocated","已用 / 已预留 / 已分配")+" · "+A.tokens(binding.knownConsumedTokens)+" / "+A.tokens(binding.retainedTokens)+" / "+A.tokens(binding.allocatedTokens)}
                                mod.widgets.HagencyHint{text:A.t("Execution status","执行状态")+" · "+binding.processState}
                                if !binding.usageComplete{mod.widgets.HagencyHint{text:A.t("Usage is incomplete; pending accounting is retained.","用量尚不完整，待核算额度仍保留。")}}
                                web_workforce_resource := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Resource and account","资源与账号") on_click:||A.open_resource(binding.resourceId)}
                            }}else{mod.widgets.HagencyHint{text:A.t("No local execution binding is recorded for this request.","此申请尚无本地执行关联记录。")}}
                            mod.widgets.HagencyActions{
                                if A.recipient_optional(row,"canOpenAgent")==true{View{width:Fit height:Fit flow:Right spacing:(8 * mod.widgets.RINX_SPACING)
                                    web_agent_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Manage agent","管理 Agent") on_click:||A.open_agent(row.id)}
                                    web_agent_project := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Project","项目") on_click:||A.open_project(row.projectId)}
                                }}
                                web_agent_terminal := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Terminal","终端") on_click:||A.open_web_terminal(row.id)}
                            }
                            mod.widgets.HagencyDivider{}
                        }}
                    }}
                    if w.kind=="capability"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No resource configurations yet.","暂无资源配置。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.resource_title(row.resource)}
                            mod.widgets.HagencyCopy{text:row.resource.framework+" · "+row.resource.model+" · "+A.reasoning_label(row.resource.reasoning)}
                            mod.widgets.HagencyHint{text:A.t("Family / tier","系列 / 级别")+" · "+A.amount(A.recipient_optional(row,"family"))+" / "+A.amount(row.modelTier)}
                            for role in row.roles{View{width:Fill height:Fit flow:Down
                                mod.widgets.HagencyCopy{text:A.capability_label(role.role)+" · "+if role.qualified{A.t("Qualified","已合格")}else{A.t("Not qualified","不合格")}}
                                if A.recipient_optional(row,"offersEditable")==false{View{width:Fill height:Fit flow:Down
                                    mod.widgets.HagencyHint{text:if role.published{A.t("Saved offer: published","已保存的报价：已发布")}else{A.t("Saved offer: not published","已保存的报价：未发布")}}
                                    mod.widgets.HagencyHint{text:A.t("Count / tokens per engagement / daily tokens","数量 / 每次合作 token / 每日 token")+" · "+if role.count==nil{A.t("Not set","未设置")}else{""+role.count}+" / "+if role.budgetCapPerEngagement==nil{A.t("Not set","未设置")}else{""+role.budgetCapPerEngagement}+" / "+if role.rateCap==nil{A.t("Not set","未设置")}else{""+role.rateCap}}
                                }}
                            }}
                            if A.recipient_optional(row,"offersEditable")==false{
                                mod.widgets.HagencyHint{text:A.t("Retained offers are read-only in this older owner installation. Complete supported device setup to manage offers in the adopted resource catalogue.","旧版所有者安装中的已保存报价为只读。完成受支持的设备设置后，可在已接管的资源目录中管理报价。")}
                            }else{
                                mod.widgets.HagencyActions{web_capability_offer := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Edit standing offers","编辑长期报价") on_click:||A.open_web_catalog(row.resource.id,"offers",nil)}}
                            }
                            mod.widgets.HagencyDivider{}
                        }}
                    }}
                    if w.kind=="usage"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        mod.widgets.HagencyHint{text:A.t("Recorded token usage. Unknown measurements are shown explicitly; cache reads are separate from fresh tokens.","显示已记录的 token 用量，未知数据会明确标出，缓存读取与新 token 分别统计。")}
                        mod.widgets.HagencyCopy{text:A.t("Authorized resources","有权查看的资源")}
                        for period in data.totals.byPeriod{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.resource_period(period.period)}
                            mod.widgets.HagencyCopy{text:A.t("Fresh / total tokens","新 token / 总 token")+" · "+A.tokens(period.knownFreshTokens)+" / "+A.tokens(period.knownTotalTokens)}
                            mod.widgets.HagencyHint{text:A.t("Measured resources / resources","有测量记录的资源 / 资源数")+" · "+A.amount(period.measuredResourceCount)+" / "+A.amount(period.resourceCount)}
                        }}
                        if !data.totals.complete{mod.widgets.HagencyHint{text:A.t("The overview is bounded to 256 resources; totals cover the scanned resources only.","概览最多汇总 256 项资源，总量仅覆盖已扫描的资源。")}}
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No usage records in this view.","此视图暂无用量记录。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.label}
                            mod.widgets.HagencyHint{text:row.model+" · "+row.periodKey}
                            mod.widgets.HagencyCopy{text:A.t("Committed / limit","已承诺 / 上限")+" · "+A.tokens(row.drawnTokens)+" / "+A.tokens(row.ceilingTokens)}
                            mod.widgets.HagencyHint{text:A.t("Includes reserved capacity; observed token usage is shown below.","包含已预留的容量；实际的 token 用量显示在下方。")}
                            if row.ceilingTokens!=nil && row.ceilingTokens>0 && row.drawnTokens!=nil{SolidView{width:240 height:8 draw_bg.color:mod.widgets.RINX_BORDER
                                SolidView{width:(240*min(1.0,max(0.0,row.drawnTokens/row.ceilingTokens))) height:8 draw_bg.color:mod.widgets.RINX_ACCENT}
                            }}
                            mod.widgets.HagencyCopy{text:A.t("Fresh / cache reads","新 token / 缓存读取")+" · "+A.tokens(row.knownFreshTokens)+" / "+A.tokens(row.cacheReadTokens)}
                            mod.widgets.HagencyCopy{text:A.t("Reserved","已预留")+" · "+A.tokens(row.reservedTokens)}
                            mod.widgets.HagencyActions{web_usage_resource := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Resource details","资源详情") on_click:||A.open_resource(row.resourceId)}}
                        }}
                        if data.unavailable.len()>0{mod.widgets.HagencyHint{text:A.t("Activity duration, task counts or historical charts appear only when the runtime records them.","仅当运行环境记录相关数据时，才显示活动时长、任务次数与历史图表。")}}
                        let managed=A.recipient_optional(data,"managedUsage")
                        if managed!=nil{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:A.t("Project agent usage","项目 Agent 用量")}
                            mod.widgets.HagencyHint{text:A.t("Recorded agent calls are shown separately from resource measurements and are not added to the totals above. Unrecorded usage may still be pending.","Agent 已记录调用与资源测量分开显示，不叠加到上方总量。尚未记录的用量可能仍待核算。")}
                            if !managed.supported{mod.widgets.HagencyHint{text:A.t("Agent call accounting is unavailable for this connection.","此连接暂无 Agent 调用核算记录。")}}
                            if managed.supported{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                                let savedPage=A.recipient_optional(w,"managedPage")
                                let offset=if savedPage==nil || savedPage>=managed.items.len(){0}else{savedPage}
                                if !managed.complete{mod.widgets.HagencyHint{text:A.t("This view contains a bounded set of agent records; it is not a complete fleet total.","此视图包含数量受限的 Agent 记录，并非全部 Agent 的总量。")}}
                                if managed.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No recorded agent calls yet.","暂无已记录的 Agent 调用。")}}
                                for index row in managed.items{if index>=offset && index<offset+16{mod.widgets.HagencySection{
                                    mod.widgets.HagencySectionTitle{text:if A.recipient_optional(row,"name")==nil{row.agentId}else{row.name}}
                                    mod.widgets.HagencyHint{text:row.projectId+" · "+row.periodKey}
                                    mod.widgets.HagencyCopy{text:A.t("Recorded / reserved / allocated tokens","已记录 / 已预留 / 已分配 token")+" · "+A.tokens(row.knownConsumedTokens)+" / "+A.tokens(row.retainedTokens)+" / "+A.tokens(row.allocatedTokens)}
                                    mod.widgets.HagencyCopy{text:A.t("Recorded calls","已记录调用次数")+" · "+A.amount(row.callCount)}
                                    if !row.usageComplete{mod.widgets.HagencyHint{text:A.t("Accounting is incomplete; the recorded amount is a lower bound.","核算尚未完成，已记录用量仅为当前下限。")}}
                                    web_managed_resource := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Resource details","资源详情") on_click:||A.open_resource(row.resourceId)}
                                }}}
                                mod.widgets.HagencyActions{
                                    if offset>0{View{width:Fit height:Fit web_managed_previous := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Previous agents","上一页 Agent") on_click:||{if !H.busy && w.data==data{w.managedPage=max(0,offset-16) A.redraw()}}}}}
                                    if offset+16<managed.items.len(){View{width:Fit height:Fit web_managed_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More agents","更多 Agent") on_click:||{if !H.busy && w.data==data{w.managedPage=offset+16 A.redraw()}}}}}
                                }
                            }}
                        }}
                    }}
                    if w.kind=="accounts"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        if data.items.len()==0{mod.widgets.HagencyCopy{text:A.t("No provider accounts yet.","暂无模型服务账号。")}}
                        for row in data.items{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.account.runtime+" · "+row.account.id}
                            mod.widgets.HagencyCopy{text:A.t("Remaining / account quota","剩余 / 账号总额度")+" · "+if row.capacity==nil{A.t("Unknown","未知")}else{A.tokens(row.capacity.remainingTokens)+" / "+A.tokens(row.capacity.quotaTokens)}}
                            mod.widgets.HagencyCopy{text:A.t("Committed","已承诺")+" · "+if row.capacity==nil{A.t("Unknown","未知")}else{A.tokens(row.capacity.committedTokens)}}
                            mod.widgets.HagencyHint{text:A.t("Account resources","账号资源")+" · "+A.amount(row.account.resourceCount)}
                            for index period amount in row.declaredByPeriod{mod.widgets.HagencyCopy{text:A.t("Declared resource limits","声明的资源上限")+" · "+period.to_string()+" · "+A.tokens(amount)}}
                            mod.widgets.HagencyCopy{text:A.t("Oversubscribed tokens","超额声明 token")+" · "+A.tokens(row.oversubscribedTokens)}
                            if !row.aggregateComplete{mod.widgets.HagencyHint{text:A.t("Declared totals cover this resource page; view the remaining resources for the complete account.","声明总量仅覆盖本页资源，请查看其余资源了解完整账号。")}}
                            for resource in row.resources{mod.widgets.HagencyCopy{text:resource.label+" · "+A.tokens(resource.drawnTokens)+" / "+A.tokens(resource.ceilingTokens)}}
                            mod.widgets.HagencyActions{
                                web_account_open := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Account details","账号详情") on_click:||A.open_account(row.account.id,nil)}
                                if row.nextResourceAfter!=nil{View{width:Fit height:Fit web_account_more := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("More resources","更多资源") on_click:||A.open_web_account(row.account.id,row.nextResourceAfter)}}}
                            }
                            mod.widgets.HagencyDivider{}
                        }}
                    }}
                    if w.kind=="alerts"{
View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)                        mod.widgets.HagencyCopy{text:A.t("All alerts / matching","全部告警 / 筛选结果")+" · "+A.amount(data.counts.total)+" / "+A.amount(data.filteredCount)}
                        for index status count in data.counts.byStatus{mod.widgets.HagencyHint{text:A.alert_state(status.to_string())+" · "+A.amount(count)}}
                        if data.alerts.len()==0{mod.widgets.HagencyCopy{text:A.t("No matching alerts.","没有符合筛选条件的告警。")}}
                        for row in data.alerts{mod.widgets.HagencySection{
                            mod.widgets.HagencySectionTitle{text:row.summary}
                            mod.widgets.HagencyCopy{text:A.alert_state(row.status)+" · "+A.alert_severity(row.severity)}
                            mod.widgets.HagencyHint{text:row.resourceId}
                            web_alert_open := mod.widgets.HagencyButton{width:Fit enabled:!H.busy text:A.t("Review alert","查看告警") on_click:||A.open_alert(row.resourceId,row.id,0)}
                        }}
                    }}
                    if w.kind=="terminal"{View{width:Fill height:Fit flow:Down spacing:(12 * mod.widgets.RINX_SPACING)
                        if data.supported{mod.widgets.HagencyCopy{text:data.text}}else{mod.widgets.HagencyCopy{text:A.t("This agent has no attached terminal pane. Its work records remain available from the agent page.","此 Agent 没有关联的终端窗格，可在 Agent 页面查看任务记录。")}}
                    }}else{mod.widgets.HagencyActions{
                        if w.after!=nil{View{width:Fit height:Fit web_first := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("First page","第一页") on_click:||A.open_web(w.kind,nil)}}}
                        if data.nextAfter!=nil{View{width:Fit height:Fit web_next := mod.widgets.HagencyButton{enabled:!H.busy text:A.t("Next page","下一页") on_click:||A.open_web(w.kind,data.nextAfter)}}}
                    }}
                }}
            }
        }
        if H.page=="default_policy" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let d=H.dpol
            let pool=A.sub_pool_name(d.resource)
            let can=A.dpol_can() && A.alert_kind()==""
            let codex=A.dpol_codex()
            let full=d.yolo
            mod.widgets.HagencyLargeTitle{text:A.t("New Agent Permissions","新 Agent 默认权限")}
            if pool!="" {mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:2} text:pool}}
            if d.saved!=nil && d.state=="ready" {View{width:Fill height:Fit padding:Inset{top:4 bottom:2} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_SUCCESS_BG
                mod.widgets.HagencyCopy{text:if d.saved {A.t("Saved. New Agents will be fully trusted.","已保存。以后新建的 Agent 默认完全信任。")} else {A.t("Saved. New Agents get standard permissions.","已保存。以后新建的 Agent 默认使用标准权限。")} draw_text.color:mod.widgets.RINX_SUCCESS_FG}
                default_policy_done := mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || {H.dpol.saved=nil A.redraw()}}
            }}}
            if d.error!="" && d.state=="ready" {View{width:Fill height:Fit padding:Inset{top:4 bottom:2} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_WARNING_BG
                mod.widgets.HagencyCopy{text:A.dpol_error(d.error) draw_text.color:mod.widgets.RINX_WARNING_FG}
            }}}
            if d.state=="loading" {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:" "}
                mod.widgets.HagencyList{for j in [0,1] {View{width:Fill height:Fit flow:Down
                    if j>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:180 height:14}}
                }}}
            }}
            if d.state=="error" {mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load this setting","暂时无法读取这项设置")}
                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(d.error)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    default_policy_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.dpol_open(d.resource)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if d.state=="ready" {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:A.t("AGENTS CREATED FROM NOW ON","以后新建的 Agent")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.shield draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.t("Standard permissions","标准权限")}
                                mod.widgets.HagencyWrapSubtitle{text:A.t("Works inside its workspace; asks before doing more","在工作区内工作，超出范围前会先请求批准")}
                            }
                            if !full {mod.widgets.HagencyCheck{}}
                        }
                        default_policy_standard := mod.widgets.HagencyListFitTap{enabled:can && full on_click: || A.dpol_choose(false)}
                    }
                    mod.widgets.HagencyListDivider{}
                    mod.widgets.HagencyListFit{
                        mod.widgets.HagencyListFitBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.t("Full trust (unrestricted)","完全信任（不受限）") draw_text.color:if codex {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_MUTED}}
                                mod.widgets.HagencyWrapSubtitle{text:if codex {A.t("Can use files outside its workspace and the network without asking","可使用工作区以外的文件和网络，且不再请求批准")} else {A.t("Only available for Codex pools","仅 Codex 资源池可以使用")}}
                            }
                            if full {mod.widgets.HagencyCheck{draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                        }
                        default_policy_unrestricted := mod.widgets.HagencyListFitTap{enabled:can && codex && !full on_click: || A.dpol_choose(true)}
                    }
                }
                mod.widgets.HagencyListNote{text:A.t("Agents that already exist keep their own permissions; change them one by one below.","现有的 Agent 保持各自的权限，可以在下方逐个调整。")}
                if d.mode=="catalog" && d.catalog!=nil {View{width:Fill height:Fit flow:Down spacing:6
                    let {agents=[]}=d.catalog
                    if agents.len()>0 {mod.widgets.HagencyListLabel{text:A.t("AGENTS NOT ON THE POOL’S DEFAULTS","还没用默认设置的 Agent")}}
                    if agents.len()>0 {mod.widgets.HagencyList{for index row in agents {View{width:Fill height:Fit flow:Down
                        if index>0 {mod.widgets.HagencyListDivider{}}
                        View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:8 bottom:8} align:Align{y:0.5}
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            mod.widgets.HagencyListTitle{text:row.name}
                            web_assign_preset := mod.widgets.HagencyGetButton{text:A.t("Use Defaults","改用默认") enabled:can on_click: || A.dpol_assign(row.id)}
                        }
                    }}}}
                    if agents.len()>0 {mod.widgets.HagencyListNote{text:A.t("This gives that Agent the pool’s defaults, such as the permissions above.","改用后，这个 Agent 会按资源池的默认设置，例如上面的权限。")}}
                }}
                View{width:Fill height:Fit padding:Inset{top:8} mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    default_policy_agents := mod.widgets.HagencyListTap{enabled:can on_click: || A.open_tools_hub_tab(d.resource,"agents")}
                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListTitle{text:A.t("Existing Agents’ Permissions","现有 Agent 的权限")}
                        mod.widgets.HagencyChevron{}
                    }
                }}}
            }}
        }}}
        if H.page=="web_catalog" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let w=H.web
            let c=w.catalog
            let pool=if c!=nil && w.section=="settings" {c.resourceName} else {A.sub_pool_name(w.resourceId)}
            if w.draft==nil {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyLargeTitle{text:A.t("Public Listing","对外展示")}
                if pool!="" {mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:2} text:pool}}
                View{width:Fill height:Fit padding:Inset{top:6 bottom:6}
                    mod.widgets.HagencySegments{for section in ["settings","offers"] {View{width:Fill height:Fit
                        if section==w.section {web_catalog_section := mod.widgets.HagencyTabOn{text:A.web_section_label(section) enabled:!H.busy on_click: || A.open_web_catalog(w.resourceId,section,nil)}}
                        if section!=w.section {web_catalog_section := mod.widgets.HagencyTab{text:A.web_section_label(section) enabled:!H.busy on_click: || A.open_web_catalog(w.resourceId,section,nil)}}
                    }}}
                }
            }}
            if w.pending!=nil {View{width:Fill height:Fit padding:Inset{bottom:6} mod.widgets.HagencyList{mod.widgets.HagencyListTall{
                web_pending_open := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_saved_web({commandId:w.pending.commandId})}
                mod.widgets.HagencyListBody{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_WARNING_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_WARNING_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyListTitle{text:A.t("A change is waiting for you","有一项更改等你确认")}
                        mod.widgets.HagencyListSubtitle{text:A.t("Confirm or cancel it before changing anything else","确认或取消后才能修改其他设置")}
                    }
                    mod.widgets.HagencyChevron{}
                }
            }}}}
            if c==nil && H.busy {View{width:Fill height:Fit flow:Down spacing:6
                mod.widgets.HagencyListLabel{text:" "}
                mod.widgets.HagencyList{for j in [0,1,2] {View{width:Fill height:Fit flow:Down
                    if j>0 {mod.widgets.HagencyListDivider{}}
                    mod.widgets.HagencySwitchRow{mod.widgets.HagencySkeleton{width:29 height:29} mod.widgets.HagencySkeleton{width:170 height:14}}
                }}}
            }}
            if c==nil && !H.busy {mod.widgets.HagencyList{
                mod.widgets.HagencySwitchRow{
                    mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.alert draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                    mod.widgets.HagencyListText{
                        mod.widgets.HagencyWrapTitle{text:A.t("Couldn’t load the public listing","暂时无法读取对外展示")}
                        mod.widgets.HagencyWrapSubtitle{text:A.read_error(H.ux.errorCode)}
                    }
                }
                mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                mod.widgets.HagencyListRow{
                    web_catalog_retry := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_web_catalog(w.resourceId,w.section,w.after)}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}} mod.widgets.HagencyAccentText{text:A.t("Try Again","重试")}}
                }
            }}
            if c!=nil && w.section=="settings" {View{width:Fill height:Fit flow:Down spacing:6
                let {defaultYolo=false,agents=[],canRetire=false}=c
                mod.widgets.HagencyListLabel{text:A.t("FOR APPLICANTS TO READ","给申请者看的说明")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyListRow{
                        web_daily_toggle := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.sub_toggle("daily_rate")}
                        mod.widgets.HagencyListBody{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.usage draw_icon.color:mod.widgets.RINX_MUTED}}
                            mod.widgets.HagencyListTitle{text:A.t("Daily use","每天用量")}
                            mod.widgets.HagencyListValue{text:if c.rateCapPerDay==nil {A.t("None","没有说明")} else {A.tokens(c.rateCapPerDay)}}
                            mod.widgets.HagencyRowGlyph{draw_icon.svg:if H.details_open=="daily_rate" {mod.rinx_icons.collapse} else {mod.rinx_icons.expand} draw_icon.color:mod.widgets.RINX_MUTED}
                        }
                    }
                    if H.details_open=="daily_rate" {View{width:Fill height:Fit flow:Right spacing:8 padding:Inset{left:14 right:14 top:2 bottom:12} align:Align{y:0.5}
                        web_daily_rate := mod.widgets.HagencyInput{width:Fill empty_text:A.t("Tokens per day","每天 token 数") text:w.rate on_change:|s|{if A.web_can_edit(){w.rate=s}}}
                        web_daily_review := mod.widgets.HagencyGetButton{text:A.t("Next","下一步") enabled:A.web_can_edit() on_click: || A.web_rate()}
                    }}
                }
                mod.widgets.HagencyListNote{text:A.t("Only a note for applicants; nothing limits daily use by it.","这只是给申请者看的说明，运行时不会按它限制每天的用量。")}
            }}
            if c!=nil && w.section=="offers" && w.draft==nil {View{width:Fill height:Fit flow:Down spacing:6
                let {items=[]}=c
                mod.widgets.HagencyListLabel{text:A.t("ROLES SHOWN TO APPLICANTS","展示给申请者的角色")}
                mod.widgets.HagencyList{
                    if items.len()==0 {mod.widgets.HagencySwitchRow{mod.widgets.HagencyListSubtitle{text:A.t("This pool has no roles to show yet.","此资源池还没有可以展示的角色。")}}}
                    for index row in items {View{width:Fill height:Fit flow:Down
                        let live=row.published || row.catalogPublished
                        if index>0 {mod.widgets.HagencyListDivider{}}
                        mod.widgets.HagencyListFit{
                            mod.widgets.HagencyListFitBody{
                                mod.widgets.HagencyRowIcon{draw_bg.color:if live {mod.widgets.RINX_SUCCESS_BG} else {mod.widgets.RINX_SELECTED} mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:if live {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_MUTED}}}
                                mod.widgets.HagencyListText{
                                    mod.widgets.HagencyListTitle{text:A.capability_label(row.role)}
                                    mod.widgets.HagencyListSubtitle{text:if !row.qualified {A.t("This model doesn’t qualify for the role","此模型不满足该角色的要求")} else if row.count==nil {A.t("No count stated","未填写数量")} else {A.t("Offers "+row.count,"可提供 "+row.count+" 个")}}
                                }
                                mod.widgets.HagencyPill{padding:Inset{left:8 right:8 top:2 bottom:2} draw_bg.color:if live {mod.widgets.RINX_SUCCESS_BG} else {mod.widgets.RINX_SELECTED} mod.widgets.HagencyPillText{text:if live {A.t("Shown","展示中")} else {A.t("Hidden","未展示")} draw_text.color:if live {mod.widgets.RINX_SUCCESS_FG} else {mod.widgets.RINX_MUTED}}}
                                mod.widgets.HagencyChevron{}
                            }
                            web_offer_edit := mod.widgets.HagencyListFitTap{enabled:A.web_can_edit() on_click: || A.web_offer_edit(row)}
                        }
                    }}
                }
                mod.widgets.HagencyListNote{text:A.t("Applicants still need the server’s and the project’s approval. Changes affect later requests; Agents already working aren’t affected.","申请者仍需服务器批准和项目审批。更改只影响以后的申请，已在工作的 Agent 不受影响。")}
            }}
            if c!=nil && w.section=="offers" && w.draft!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let d=w.draft
                mod.widgets.HagencyLargeTitle{text:A.capability_label(d.role)}
                mod.widgets.HagencyListNote{padding:Inset{left:2 right:7 top:0 bottom:6} text:A.t("How this role is shown to applicants","这个角色如何展示给申请者")}
                mod.widgets.HagencyList{
                    mod.widgets.HagencyFitRow{
                        mod.widgets.HagencyRowBody{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_SUCCESS_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.globe draw_icon.color:mod.widgets.RINX_SUCCESS_FG}}
                            mod.widgets.HagencyListText{
                                mod.widgets.HagencyListTitle{text:A.t("Show to applicants","对外展示")}
                                mod.widgets.HagencyListSubtitle{text:if !d.qualified {A.t("This model doesn’t qualify","此模型不满足要求")} else if d.published {A.t("Applicants can see it","申请者可以看到")} else {A.t("Applicants can’t see it","申请者看不到")}}
                            }
                            mod.widgets.HagencySwitch{draw_bg.selected:if d.published {1.0} else {0.0} enabled:!H.busy && d.qualified}
                        }
                        web_offer_publish := mod.widgets.HagencyRowCover{enabled:!H.busy && d.qualified on_click: || {d.published=!d.published A.redraw()}}
                    }
                    mod.widgets.HagencyListDivider{}
                    View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{left:14 right:14 top:8 bottom:8} align:Align{y:0.5}
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.people}}
                        mod.widgets.HagencyListTitle{width:Fit text:A.t("How many Agents","最多几个 Agent")}
                        web_offer_count := mod.widgets.HagencyInput{width:Fill empty_text:A.t("Not stated","未填写") text:d.count on_change:|s|{d.count=s}}
                    }
                }
                mod.widgets.HagencyListNote{text:A.t("How many Agents with this role the pool can serve at once.","此资源池同时能为多少个该角色的 Agent 提供服务。")}
                mod.widgets.HagencyListLabel{text:A.t("FOR APPLICANTS TO READ","给申请者看的说明")}
                mod.widgets.HagencyList{View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:14 right:14 top:12 bottom:12}
                    web_offer_budget := mod.widgets.HagencyWrapTitle{text:A.t("Each request: ","每次申请 ")+(if d.budget=="" {A.t("not stated","未填写")} else {A.tokens(d.budget.to_f64())})}
                    mod.widgets.HagencyWrapSubtitle{text:A.t("What Agents actually get is the per-request limit on the pool’s page.","Agent 实际拿到多少，看资源池页面上的每次申请上限。")}
                    mod.widgets.HagencyListDivider{margin:Inset{left:0 top:4 bottom:4}}
                    mod.widgets.HagencyListTitle{text:A.t("Daily use","每天用量")}
                    web_offer_rate := mod.widgets.HagencyInput{width:Fill empty_text:A.t("Not stated","未填写") text:d.rate on_change:|s|{d.rate=s}}
                }}
                mod.widgets.HagencyListNote{text:A.t("Applicants read these; they don’t limit use. The pool’s monthly maximum does.","这两项只给申请者看，不会限制用量；真正限制用量的是每月上限。")}
                mod.widgets.HagencyListNote{padding:Inset{left:7 right:7 top:6 bottom:2} text:A.t("Tap Next to check the change before it’s saved.","点右上角「下一步」，保存前会先让你确认。")}
            }}
        }}}
        if H.page=="web_catalog_command" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let w=H.web
            let p=w.pending
            if p==nil {View{width:Fill height:Fit flow:Down spacing:6
                View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                    mod.widgets.HagencyAvatar{draw_bg.color:mod.widgets.RINX_SELECTED mod.widgets.HagencyAvatarGlyph{draw_icon.svg:mod.rinx_icons.sync draw_icon.color:mod.widgets.RINX_MUTED}}
                    mod.widgets.HagencyHeroName{text:if H.busy {A.t("Checking…","正在检查…")} else {A.t("Find Your Change","查找你的更改")}}
                    mod.widgets.HagencyHint{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:if H.busy {A.t("Getting your saved change.","正在读取你保存的更改。")} else {A.t("Your change was saved. Find it to see whether it went through.","你的更改已保存，查找后可以看到它是否完成。")}}
                }
                if !H.busy {mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    web_command_recover := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || {if w.commandId!="" {A.open_saved_web({commandId:w.commandId})} else {A.refresh()}}}
                    mod.widgets.HagencyListBody{mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.search}} mod.widgets.HagencyAccentText{text:A.t("Find Saved Change","查找保存的更改")}}
                }}}
            }}
            if p!=nil {View{width:Fill height:Fit flow:Down spacing:6
                let change=p.change
                let op=change.operation
                let done=w.phase=="recorded"
                let failed=w.phase=="failed"
                let warn=(op=="default_policy" && A.recipient_optional(change,"yolo")==true) || op=="retire"
                View{width:Fill height:Fit flow:Down spacing:10 align:Align{x:0.5} padding:Inset{top:6 bottom:8}
                    mod.widgets.HagencyAvatar{draw_bg.color:if done {mod.widgets.RINX_SUCCESS_BG} else if failed {mod.widgets.RINX_DANGER_BG} else if warn {mod.widgets.RINX_WARNING_BG} else {mod.widgets.RINX_INFO_BG} mod.widgets.HagencyAvatarGlyph{draw_icon.svg:if done {mod.rinx_icons.check} else if failed {mod.rinx_icons.close} else if warn {mod.rinx_icons.alert} else {mod.rinx_icons.adjust} draw_icon.color:if done {mod.widgets.RINX_SUCCESS_FG} else if failed {mod.widgets.RINX_DANGER_FG} else if warn {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_INFO_FG}}}
                    mod.widgets.HagencyHeroName{text:if done {A.t("Change Saved","更改已保存")} else if failed {A.t("Change Not Made","更改没有完成")} else if w.phase=="saved" && op=="retire" {A.t("Delete This Pool?","删除这个资源池？")} else if w.phase=="saved" {A.t("Confirm This Change","确认这项更改")} else {A.t("Checking…","正在检查…")}}
                    mod.widgets.HagencyHint{width:Fill align:Align{x:0.5} flow:Flow.Right{wrap:true} text:if done {A.t("Later requests follow the new setting.","以后的申请会按新的设置处理。")} else if failed {A.t("Nothing was changed.","设置没有改变。")} else if w.phase=="saved" {A.t("Nothing changes until you confirm.","确认之前不会有任何改变。")} else {A.t("Checking whether this change went through.","正在检查这项更改是否完成。")}}
                }
                mod.widgets.HagencyListLabel{text:A.t("THE CHANGE","更改内容")}
                mod.widgets.HagencyList{
                    if op=="default_policy" {mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:if change.yolo {mod.widgets.RINX_WARNING_BG} else {mod.widgets.RINX_SUCCESS_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:if change.yolo {mod.rinx_icons.alert} else {mod.rinx_icons.shield} draw_icon.color:if change.yolo {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_SUCCESS_FG}}}
                        mod.widgets.HagencyListTitle{text:A.t("New Agent permissions","新 Agent 默认权限")}
                        mod.widgets.HagencyListValue{text:if change.yolo {A.t("Full trust (unrestricted)","完全信任（不受限）")} else {A.t("Standard permissions","标准权限")} draw_text.color:if change.yolo {mod.widgets.RINX_WARNING_FG} else {mod.widgets.RINX_MUTED}}
                    }}
                    if op=="assign_preset" {mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:mod.widgets.RINX_INFO_FG}}
                        mod.widgets.HagencyListTitle{text:A.t("Use the pool’s defaults for","改用资源池默认设置的 Agent")}
                        mod.widgets.HagencyListValue{text:A.web_agent_name(change.engagementId)}
                    }}
                    if op=="trust_add" || op=="trust_remove" {mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:if op=="trust_add" {mod.widgets.RINX_INFO_BG} else {mod.widgets.RINX_DANGER_BG} mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.projects draw_icon.color:if op=="trust_add" {mod.widgets.RINX_INFO_FG} else {mod.widgets.RINX_DANGER_FG}}}
                        mod.widgets.HagencyListText{
                            mod.widgets.HagencyListTitle{text:if op=="trust_add" {A.t("Trust this project","信任这个项目")} else {A.t("Stop trusting this project","不再信任这个项目")}}
                            mod.widgets.HagencyWrapSubtitle{text:if A.recipient_optional(change,"displayName")!=nil {change.displayName+" · "+change.projectRoomId} else {change.projectRoomId}}
                        }
                    }}
                    if op=="retire" {mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_DANGER_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.trash draw_icon.color:mod.widgets.RINX_DANGER_FG}}
                        mod.widgets.HagencyWrapTitle{text:A.t("Delete this pool","删除这个资源池")}
                    }}
                    if op=="offer" {View{width:Fill height:Fit flow:Down
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{draw_bg.color:mod.widgets.RINX_INFO_BG mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.robot draw_icon.color:mod.widgets.RINX_INFO_FG}}
                            mod.widgets.HagencyListTitle{text:A.capability_label(change.role)}
                            mod.widgets.HagencyListValue{text:A.web_offer_before(change.role,"published",fn(v){return if v==true {A.t("Shown","已展示")} else {A.t("Not shown","未展示")}})+(if change.published {A.t("Show to applicants","对外展示")} else {A.t("Stop showing","不再展示")})}
                        }
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.people}}
                            mod.widgets.HagencyListTitle{text:A.t("How many Agents","最多几个 Agent")}
                            mod.widgets.HagencyListValue{text:A.web_offer_before(change.role,"count",fn(v){return A.web_count(v)})+A.web_count(change.count)}
                        }
                    }}
                    if op=="rate_cap" {mod.widgets.HagencySwitchRow{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.usage draw_icon.color:mod.widgets.RINX_MUTED}}
                        mod.widgets.HagencyListTitle{text:A.t("Daily use (a note only)","每天用量（仅作说明）")}
                        mod.widgets.HagencyListValue{text:A.web_amount(change.rateCapPerDay)}
                    }}
                }
                if op=="offer" {View{width:Fill height:Fit flow:Down spacing:6
                    mod.widgets.HagencyListLabel{text:A.t("FOR APPLICANTS TO READ","给申请者看的说明")}
                    mod.widgets.HagencyList{
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.gauge draw_icon.color:mod.widgets.RINX_MUTED}}
                            mod.widgets.HagencyListTitle{text:A.t("Each request","每次申请")}
                            mod.widgets.HagencyListValue{text:A.web_offer_before(change.role,"budgetCapPerEngagement",fn(v){return A.web_amount(v)})+A.web_amount(change.budgetCapPerEngagement)}
                        }
                        mod.widgets.HagencyListDivider{}
                        mod.widgets.HagencySwitchRow{
                            mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.usage draw_icon.color:mod.widgets.RINX_MUTED}}
                            mod.widgets.HagencyListTitle{text:A.t("Daily use","每天用量")}
                            mod.widgets.HagencyListValue{text:A.web_amount(change.rateCap)}
                        }
                    }
                }}
                if op=="default_policy" && change.yolo {mod.widgets.HagencyListNote{text:A.t("Agents created later can use files outside their workspace and the network without asking you first.","以后新建的 Agent 能读写工作区以外的文件、访问网络，而且不会先请求你批准。") draw_text.color:mod.widgets.RINX_WARNING_FG}}
                if op=="retire" {mod.widgets.HagencyListNote{text:A.t("It leaves your pools. Past use records are kept.","资源池会从列表中移除，过去的使用记录会保留。")}}
                if w.phase=="saved" {View{width:Fill height:Fit flow:Right spacing:12 padding:Inset{top:10}
                    web_command_cancel := mod.widgets.HagencyWideTinted{text:if op=="retire" {A.t("Cancel","取消")} else {A.t("Discard Change","放弃更改")} enabled:!H.busy on_click: || A.web_cancel()}
                    if warn {web_command_apply := mod.widgets.HagencyWideDanger{text:if op=="retire" {A.t("Delete Pool","删除资源池")} else {A.t("Confirm","确认更改")} enabled:!H.busy on_click: || A.web_apply()}}
                    if !warn {web_command_apply := mod.widgets.HagencyWideButton{text:A.t("Confirm","确认更改") enabled:!H.busy on_click: || A.web_apply()}}
                }}
                if done || failed {View{width:Fill height:Fit padding:Inset{top:10}
                    web_command_finish := mod.widgets.HagencyWideButton{text:A.t("Done","完成") enabled:!H.busy on_click: || A.web_finish()}
                }}
                if w.phase=="unknown" {mod.widgets.HagencyListNote{text:A.t("The reply was interrupted. Check the saved result before changing anything else.","响应中断了。修改其他设置前，请先检查保存的结果。")}}
                if w.phase=="unknown" || failed {View{width:Fill height:Fit padding:Inset{top:10} mod.widgets.HagencyList{mod.widgets.HagencyListRow{
                    web_command_check := mod.widgets.HagencyListTap{enabled:!H.busy on_click: || A.open_saved_web({commandId:p.commandId})}
                    mod.widgets.HagencyListBody{
                        mod.widgets.HagencyRowIcon{mod.widgets.HagencyRowGlyph{draw_icon.svg:mod.rinx_icons.refresh}}
                        mod.widgets.HagencyAccentText{text:A.t("Check Saved Result","检查保存的结果")}
                    }
                }}}}
            }}
        }}}

        if H.page=="templates" {View{width:Fill height:Fit align:Align{x:0.5} padding:Inset{top:18 bottom:28} mod.widgets.HagencyColumn{
            let t=H.templates
            if A.recipient_optional(t,"discarded")==H.page {View{width:Fill height:Fit padding:Inset{bottom:4} mod.widgets.HagencyStatus{draw_bg.color:mod.widgets.RINX_SELECTED
                template_discarded := mod.widgets.HagencyCopy{text:if A.recipient_optional(t,"discardedHow")=="elsewhere" {A.t("This change was withdrawn elsewhere before it was saved; nothing changed. You can make it again.","这项更改在保存前已在别处撤回，什么都没有改。可以重新修改。")} else {A.t("Change discarded; nothing was saved.","已放弃更改，没有保存任何东西。")}}
                mod.widgets.HagencyBarDone{padding:Inset{left:12 right:12} text:A.t("OK","好") enabled:!H.busy on_click: || {H.templates.discarded="" A.redraw()}}
            }}}

                    mod.widgets.HagencyAvatar{draw_bg.color:A.local_tone_bg(tone) mod.widgets.HagencyAvatarGlyph{draw_icon.color:if tone=="" {mod.widgets.RINX_ACCENT} else {A.local_tone_fg(tone)}}}
                    mod.widgets.HagencyHeroName{text:row.name}

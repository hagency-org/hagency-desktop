                if !list.canCreate {mod.widgets.HagencyListNote{text:A.t("You can’t add one right now. Check your access, the roles this pool supports, its capacity, and the 200-template limit.","暂时不能新建模板。请检查你的权限、此资源池支持的角色、容量，以及最多 200 个模板的限制。")}}
                mod.widgets.HagencyListLabel{text:A.t("TEMPLATES","模板")}

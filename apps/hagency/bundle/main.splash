                        mod.widgets.HagencyListDivider{margin:Inset{left:16}}
                        pool_quota_section := View{width:Fill height:Fit flow:Down spacing:8 padding:Inset{left:16 right:16 top:12 bottom:12}
                            View{width:Fill height:Fit flow:Right spacing:8 align:Align{y:0.5}
                                mod.widgets.HagencyListTitle{width:Fill text:A.t("Per-request limit","每次申请上限")}
                                pool_quota_value := mod.widgets.HagencyListValue{visible:unsaved.quota=="" text:if v.publishedTokens!=nil {A.t("Now ","现在 ")+A.tokens(v.publishedTokens)} else {""}}
                                pool_quota_unsaved := mod.widgets.HagencyListValue{visible:unsaved.quota!="" text:unsaved.quota draw_text +: {color:mod.widgets.RINX_WARNING_FG text_style:theme.font_bold{font_size:mod.widgets.RINX_META_SIZE}}}
                            }
                            mod.widgets.HagencyWrapSubtitle{text:A.t("The most one Agent can get per request.","每个 Agent 每次申请最多可得的额度。")}
                            View{width:Fill height:Fit pool_quota_tokens := mod.widgets.HagencyPoolSlider{minimum:1 maximum:v.quotaMax text:if e!=nil {e.quota} else {""} empty_text:A.t("Not set","未设置") is_read_only:H.command!=nil || locked || v.quotaMode=="scheduled" unit +: {margin:Inset{top:(if mod.widgets.RINX_TEXT_SCALE>1.2 {7} else {0})}} slider_wrap +: {width:Fill amount_slider +: {enabled:H.command==nil && !locked && v.quotaMode!="scheduled"}} on_change:|text| A.pool_quota_changed(text)}}
                            pool_quota_error := mod.widgets.HagencyWrapSubtitle{visible:save.quotaError!="" text:save.quotaError draw_text.color:mod.widgets.RINX_DANGER_FG}
                            View{width:Fill height:Fit flow:Down spacing:8
                                View{width:Fill height:Fit flow:Right spacing:8 align:Align{y:0.5}
                                    if v.when!="" {mod.widgets.HagencyPillDot{draw_bg.color:if v.quotaEditable || v.quotaMode=="amend" {mod.widgets.RINX_ACCENT} else {mod.widgets.RINX_WARNING_FG}}}
                                    pool_quota_when := mod.widgets.HagencyWrapSubtitle{text:v.when}
                                }
